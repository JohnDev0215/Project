        android:selectable="false"
        android:summary="@string/privacy_sandbox_remove_interest_description"
        app:allowDividerBelow="false"/>
    <PreferenceCategory
        android:title="@string/privacy_sandbox_topic_interests_subtitle"
        android:key="topic_interests"/>
    <Preference
        android:selectable="false"
        android:key="empty_topics"
        android:summary="@string/privacy_sandbox_removed_topics_empty_state"
        app:allowDividerBelow="false"/>
    <PreferenceCategory
        android:title="@string/privacy_sandbox_fledge_subtitle"
        android:key="fledge_interests"/>
    <Preference
        android:selectable="false"
        android:key="empty_fledge"
        android:summary="@string/privacy_sandbox_removed_sites_empty_state"
        app:allowDividerBelow="false"/>
