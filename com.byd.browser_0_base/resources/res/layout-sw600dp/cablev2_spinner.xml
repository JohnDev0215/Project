<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:a="http://schemas.android.com/apk/res/android"
    a:scrollbars="0x0"
    a:layout_width="-1"
    a:layout_height="-1"
    a:fillViewport="true">
    <LinearLayout
        a:gravity="0x11"
        a:orientation="vertical"
        a:layout_width="-1"
        a:layout_height="-2">
        <TextView
            a:textSize="36sp"
            a:gravity="0x1"
            a:layout_width="-1"
            a:layout_height="-2"
            a:layout_marginLeft="24dp"
            a:layout_marginTop="-104dp"
            a:layout_marginRight="24dp"
            a:text="@string/cablev2_serverlink_connecting_to_your_device"/>
        <RelativeLayout
            a:layout_gravity="center_horizontal"
            a:layout_width="-2"
            a:layout_height="-2"
            a:layout_marginLeft="24dp"
            a:layout_marginTop="52dp"
            a:layout_marginRight="24dp"
            a:layoutDirection="0">
            <ImageView
                a:layout_gravity="center"
                a:id="@+id/spinner"
                a:layout_width="-2"
                a:layout_height="-2"
                a:layout_centerInParent="true"
                a:layout_centerVertical="true"
                a:contentDescription="@null"/>
            <ImageView
                a:layout_width="-2"
                a:layout_height="-2"
                a:src="@drawable/ic_lock_googblue_48dp"
                a:layout_centerInParent="true"
                a:layout_centerVertical="true"
                a:contentDescription="@null"/>
        </RelativeLayout>
        <TextView
            a:textSize="24sp"
            a:layout_gravity="center_horizontal"
            a:id="@+id/status_text"
            a:padding="0px"
            a:layout_width="-2"
            a:layout_height="-2"
            a:layout_marginTop="4dp"
            a:layout_marginBottom="16dp"/>
    </LinearLayout>
</ScrollView>
