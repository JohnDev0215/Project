<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:a="http://schemas.android.com/apk/res/android"
    a:scrollbars="0x0"
    a:layout_width="-1"
    a:layout_height="-1"
    a:fillViewport="true">
    <LinearLayout
        a:orientation="vertical"
        a:layout_width="-1"
        a:layout_height="-2">
        <TextView
            a:textSize="24sp"
            a:gravity="0x1"
            a:layout_width="-1"
            a:layout_height="-2"
            a:layout_marginLeft="24dp"
            a:layout_marginTop="104dp"
            a:layout_marginRight="24dp"
            a:text="@string/cablev2_qr_title"/>
        <ImageView
            a:gravity="0x1"
            a:layout_width="-1"
            a:layout_height="212dp"
            a:layout_marginLeft="40dp"
            a:layout_marginTop="52dp"
            a:layout_marginBottom="35dp"
            a:src="@drawable/cable_qr_code"
            a:contentDescription="@null"/>
        <TextView
            a:textSize="14sp"
            a:layout_gravity="center_horizontal"
            a:padding="0px"
            a:layout_width="-2"
            a:layout_height="-2"
            a:layout_marginLeft="24dp"
            a:layout_marginTop="52dp"
            a:layout_marginRight="24dp"
            a:text="@string/cablev2_qr_body_tablet"
            style="@style/TextAppearance.TextMedium.Primary"/>
        <LinearLayout
            a:gravity="0x10"
            a:orientation="horizontal"
            a:padding="24dp"
            a:layout_width="-1"
            a:layout_height="-2">
            <CheckBox
                a:id="@+id/qr_link"
                a:layout_width="-2"
                a:layout_height="-2"
                a:checked="true"
                a:contentDescription="@string/cablev2_qr_remember"/>
            <TextView
                a:layout_width="-2"
                a:layout_height="-2"
                a:text="@string/cablev2_qr_remember"
                a:importantForAccessibility="2"
                style="@style/TextAppearance.TextMedium.Primary"/>
        </LinearLayout>
        <View
            a:visibility="1"
            a:layout_width="0dp"
            a:layout_height="0dp"
            a:layout_weight="1"/>
        <LinearLayout
            a:gravity="0x800005"
            a:orientation="horizontal"
            a:paddingLeft="24dp"
            a:paddingRight="24dp"
            a:paddingBottom="16dp"
            a:layout_width="-1"
            a:layout_height="-2">
            <org.chromium.ui.widget.ButtonCompat
                a:id="@+id/qr_reject"
                a:layout_width="-2"
                a:layout_height="-2"
                a:text="@string/cablev2_qr_dont_allow"
                a:paddingEnd="36dp"
                style="@style/TextButton"/>
            <org.chromium.ui.widget.ButtonCompat
                a:id="@+id/qr_connect"
                a:layout_width="-2"
                a:layout_height="-2"
                a:text="@string/cablev2_qr_allow"
                style="@style/FilledButton.Flat"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
