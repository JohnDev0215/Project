<?xml version="1.0" encoding="utf-8"?>
<org.chromium.chrome.browser.toolbar.top.ToolbarTablet xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/toolbar"
    android:background="?attr/colorSurface"
    android:layout_width="match_parent"
    android:layout_height="@dimen/toolbar_height_no_shadow"
    android:layout_marginTop="@dimen/tab_strip_height">
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/toolbar_tablet_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <org.chromium.chrome.browser.toolbar.top.ToggleTabStackButton
            android:layout_gravity="center_vertical"
            android:id="@+id/tab_switcher_button"
            android:visibility="visible"
            android:tint="@color/default_icon_color_tint_list"
            android:contentDescription="@string/accessibility_toolbar_btn_tabswitcher_toggle_default"
            android:layout_marginStart="@dimen/toolbar_button_margin2"
            android:layout_marginEnd="@dimen/toolbar_button_margin"
            style="@style/ToolbarButton"/>
        <org.chromium.chrome.browser.ui.widget.SkinChromeImageButton
            android:id="@+id/bt_tab_add"
            android:src="@drawable/tab_add"
            android:contentDescription="add_tab"
            android:layout_marginStart="@dimen/toolbar_button_margin"
            android:layout_marginEnd="@dimen/toolbar_button_margin"
            android:layout_marginHorizontal="1dp"
            app:tint="@color/default_icon_color_tint_list"
            style="@style/ToolbarButton"/>
        <org.chromium.chrome.browser.toolbar.HomeButton
            android:id="@+id/home_button"
            android:visibility="gone"
            android:src="@drawable/btn_toolbar_home"
            android:contentDescription="@string/accessibility_toolbar_btn_home"
            app:menuMaxWidth="@dimen/home_button_list_menu_width"
            app:menuPositionedAtEnd="false"
            app:menuVerticalOverlapAnchor="false"
            app:tint="@color/default_icon_color_tint_list"
            style="@style/ToolbarButton"/>
        <org.chromium.chrome.browser.ui.widget.SkinChromeImageButton
            android:id="@+id/back_button"
            android:src="@drawable/icon_arrow_back"
            android:contentDescription="@string/accessibility_toolbar_btn_back"
            android:layout_marginStart="@dimen/toolbar_button_margin"
            android:layout_marginEnd="@dimen/toolbar_button_margin"
            app:tint="@color/default_icon_color_tint_list"
            style="@style/ToolbarButton"/>
        <org.chromium.chrome.browser.ui.widget.SkinChromeImageButton
            android:id="@+id/forward_button"
            android:src="@drawable/icon_arrow_forward"
            android:contentDescription="@string/accessibility_toolbar_btn_forward"
            android:layout_marginStart="@dimen/toolbar_button_margin"
            android:layout_marginEnd="@dimen/toolbar_button_margin"
            android:layout_marginHorizontal="1dp"
            app:tint="@color/default_icon_color_tint_list"
            style="@style/ToolbarButton"/>
        <org.chromium.chrome.browser.ui.widget.SkinChromeImageButton
            android:id="@+id/refresh_button"
            android:src="@drawable/btn_reload_stop"
            android:contentDescription="@string/accessibility_btn_refresh"
            android:layout_marginStart="@dimen/toolbar_button_margin"
            android:layout_marginEnd="@dimen/toolbar_button_margin3"
            app:tint="@color/default_icon_color_tint_list"
            style="@style/ToolbarButton"/>
        <TextView
            android:textColor="@color/color_text_title"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_cancel"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="18dp"
            style="?android:attr/textAppearanceMedium"/>
        <RelativeLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/view_url_bar"
            android:layout_width="0dp"
            android:layout_height="@dimen/modern_toolbar_tablet_background_size"
            android:layout_weight="1">
            <org.chromium.chrome.browser.omnibox.LocationBarTablet
                android:gravity="center_vertical"
                android:id="@+id/location_bar"
                android:background="@drawable/bg_url_byd"
                android:layout_width="match_parent"
                android:layout_height="@dimen/modern_toolbar_tablet_background_size"/>
        </RelativeLayout>
        <ViewStub
            android:id="@+id/optional_button_stub"
            android:visibility="gone"
            android:layout="@layout/optional_toolbar_button"
            android:inflatedId="@+id/optional_toolbar_button"
            android:paddingStart="8dp"
            style="@style/ToolbarButton"/>
        <org.chromium.chrome.browser.ui.widget.SkinChromeImageButton
            android:id="@+id/folder_button"
            android:src="@drawable/folder_cog"
            android:layout_marginStart="@dimen/toolbar_button_margin3"
            android:layout_marginEnd="@dimen/toolbar_button_margin"
            app:tint="@color/default_icon_color_tint_list"
            style="@style/ToolbarButton"/>
        <org.chromium.chrome.browser.ui.widget.SkinChromeImageButton
            android:layout_gravity="center"
            android:id="@+id/menu_button_setting"
            android:src="@drawable/setting_menu"
            android:contentDescription="@string/accessibility_toolbar_btn_menu"
            android:layout_marginStart="@dimen/toolbar_button_margin"
            android:layout_marginEnd="@dimen/toolbar_button_margin2"
            app:tint="@color/default_icon_color_tint_list"
            style="@style/ToolbarButton"/>
        <include layout="@layout/menu_button"/>
    </LinearLayout>
</org.chromium.chrome.browser.toolbar.top.ToolbarTablet>
