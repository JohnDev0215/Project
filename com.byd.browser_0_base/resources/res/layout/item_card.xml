<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/card_rl"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/item_all_margin">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/img_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true">
        <ImageView
            android:id="@+id/web_img"
            android:layout_width="@dimen/item_img_size"
            android:layout_height="@dimen/item_img_size"
            android:scaleType="fitXY"/>
        <skin.support.widget.SkinCompatImageView
            android:id="@+id/img"
            android:background="@drawable/card_back"
            android:layout_width="@dimen/item_img_size"
            android:layout_height="@dimen/item_img_size"
            android:scaleType="fitXY"/>
        <skin.support.widget.SkinCompatImageView
            android:id="@+id/add_img"
            android:background="@drawable/card_back"
            android:layout_width="@dimen/item_img_size"
            android:layout_height="@dimen/item_img_size"
            android:src="@drawable/icon_add"
            android:scaleType="fitXY"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textColor="@color/color_card_item"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/tv_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_marg_size"
        android:maxLines="1"
        android:layout_below="@+id/img_layout"/>
</RelativeLayout>
