<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="30dp"
    android:layout_marginEnd="10dp">
    <org.chromium.ui.widget.ChromeImageView
        android:id="@+id/bookmark_add"
        android:visibility="visible"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:src="@drawable/btn_star_filled"
        android:contentDescription="@string/card_add_msg"
        android:layout_marginEnd="@dimen/dimen_30_dp"/>
    <skin.support.widget.SkinCompatImageView
        android:id="@+id/more"
        android:background="@null"
        android:clickable="false"
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:src="@drawable/bookmark_delete_history"
        android:scaleType="centerInside"
        app:tint="@color/default_icon_color_tint_list"/>
</LinearLayout>
