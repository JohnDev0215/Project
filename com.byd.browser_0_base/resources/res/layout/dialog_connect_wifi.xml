<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/dialog_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/dialog_title_text_size"
        android:textColor="@color/dialog_color_text_title"
        android:gravity="center"
        android:id="@+id/tv_message"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:text="@string/wifi_title"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        app:layout_constraintBottom_toTopOf="@+id/ll_sure_cancel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_sure_cancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_message">
        <LinearLayout
            android:gravity="end"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <Button
                android:textSize="@dimen/text_size_18sp"
                android:textColor="@color/dialog_button_true_text_color"
                android:gravity="center"
                android:layout_gravity="end"
                android:id="@+id/btn_sure"
                android:background="@drawable/button_bg_true_dialog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wifi_connect"
                android:textAllCaps="false"
                android:layout_marginEnd="@dimen/dimen_24_dp"
                style="@style/DialogButtonTrue"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="start"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <Button
                android:textSize="@dimen/text_size_18sp"
                android:textColor="@color/dialog_button_cancel_text_color"
                android:gravity="center"
                android:layout_gravity="start"
                android:id="@+id/btn_cancel"
                android:background="@drawable/button_bg_cancel_dialog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wifi_exit"
                android:textAllCaps="false"
                android:layout_marginStart="@dimen/dimen_24_dp"
                style="@style/DialogButtonCancel"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
