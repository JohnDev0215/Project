<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/safe_browsing_no_protection_confirmation_dialog_title"
        style="@style/Dialog.Style.Title"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_height"
        style="@style/HorizontalDivider.Dialog"/>
    <TextView
        android:gravity="start|center_vertical"
        android:id="@+id/tv_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_40_dp"
        android:text="@string/safe_browsing_no_protection_confirmation_dialog_message"
        style="@style/Dialog.Style.Message"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_sure_cancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_44_dp"
        android:layout_marginBottom="@dimen/dimen_30_dp">
        <LinearLayout
            android:gravity="end|center_vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <Button
                android:textColor="@color/dialog_button_true_text_color"
                android:gravity="center"
                android:id="@+id/btn_sure"
                android:background="@drawable/button_bg_true_dialog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/safe_browsing_no_protection_confirmation_dialog_confirm"
                android:textAllCaps="false"
                android:layout_marginEnd="@dimen/dimen_24_dp"
                style="@style/DialogButtonTrue"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="start|center_vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <Button
                android:textColor="@color/dialog_button_cancel_text_color"
                android:gravity="center"
                android:id="@+id/btn_cancel"
                android:background="@drawable/button_bg_cancel_dialog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel"
                android:textAllCaps="false"
                android:layout_marginStart="@dimen/dimen_24_dp"
                style="@style/DialogButtonCancel"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
