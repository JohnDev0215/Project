<?xml version="1.0" encoding="utf-8"?>
<org.chromium.chrome.browser.tasks.tab_management.TabGridIphDialogView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:id="@+id/iph_dialog"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/animation_drawable"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="@string/iph_drag_and_drop_content"
        app:srcCompat="@drawable/iph_drag_and_drop_animated_drawable"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Headline.Primary"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:text="@string/iph_drag_and_drop_title"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"/>
    <TextView
        android:textAppearance="@style/TextAppearance.TextMedium.Primary"
        android:gravity="start"
        android:id="@+id/description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/iph_drag_and_drop_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"/>
</org.chromium.chrome.browser.tasks.tab_management.TabGridIphDialogView>
