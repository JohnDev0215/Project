<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/dialog_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/rl_page_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_12_dp">
        <LinearLayout
            android:gravity="center"
            android:id="@+id/page_info_url_wrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_weight="1"
            android:layout_alignTop="@+id/page_info_close"
            android:layout_marginHorizontal="68dp">
            <org.chromium.components.browser_ui.widget.text.TextViewWithCompoundDrawables
                android:textAppearance="@style/TextAppearance.TextLarge.Primary"
                android:textSize="@dimen/dialog_title_text_size"
                android:textColor="@color/dialog_color_text_title"
                android:ellipsize="end"
                android:id="@+id/page_info_truncated_url"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:includeFontPadding="false"
                android:drawablePadding="@dimen/page_info_popup_button_padding_sides"
                android:lineSpacingExtra="6dp"
                android:paddingVertical="@dimen/page_info_popup_padding_vertical"
                app:drawableHeight="@dimen/page_info_favicon_size"
                app:drawableWidth="@dimen/page_info_favicon_size"/>
            <view
                android:textAppearance="@style/TextAppearance.TextLarge.Primary"
                android:textSize="@dimen/dialog_title_text_size"
                android:textColor="@color/dialog_color_text_title"
                android:ellipsize="end"
                android:id="@+id/page_info_url"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:includeFontPadding="false"
                android:lineSpacingExtra="6dp"
                android:textAlignment="center"
                android:paddingVertical="@dimen/page_info_popup_padding_vertical"
                class="org.chromium.ui.ElidedUrlTextView"/>
        </LinearLayout>
        <skin.support.widget.SkinCompatImageButton
            android:id="@+id/page_info_close"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone"
            android:layout_width="@dimen/dimen_48_dp"
            android:layout_height="@dimen/dimen_48_dp"
            android:src="@drawable/btn_close"
            android:contentDescription="@string/close"
            android:layout_marginStart="@dimen/dimen_16_dp"
            app:tint="@color/default_icon_color_tint_list"/>
    </RelativeLayout>
    <View
        android:background="@color/bookmark_edit_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_1_dp"
        android:layout_marginTop="11dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/page_info_wrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/dimen_30_dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/page_info_subpage_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/dimen_30_dp"
            android:paddingEnd="@dimen/dimen_30_dp">
            <skin.support.widget.SkinCompatImageButton
                android:id="@+id/subpage_back_button"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/baseline_arrow_back"
                android:minWidth="@dimen/min_touch_target_size"
                android:minHeight="@dimen/min_touch_target_size"
                android:contentDescription="@string/back"
                android:layout_marginEnd="@dimen/dimen_20_dp"
                app:tint="@color/default_icon_color_tint_list"/>
            <TextView
                android:textAppearance="@style/TextAppearance.TextLarge.Primary"
                android:textSize="@dimen/dialog_message_text_size"
                android:textColor="@color/dialog_color_text_message_hint"
                android:gravity="center_vertical"
                android:id="@+id/page_info_subpage_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/page_info_popup_padding_vertical"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/page_info_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingEnd="@dimen/dimen_40_dp"
            android:paddingHorizontal="@dimen/dimen_40_dp"/>
    </LinearLayout>
</LinearLayout>
