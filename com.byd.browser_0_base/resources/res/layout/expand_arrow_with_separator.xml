<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <org.chromium.ui.widget.ChromeImageButton
        android:id="@+id/expand_arrow"
        android:background="?android:attr/selectableItemBackground"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:src="@drawable/ic_expand_more_horizontal_black_24dp"
        android:contentDescription="@string/accessibility_expand_button"
        android:paddingStart="@dimen/radio_button_with_description_and_aux_button_padding"
        android:paddingEnd="@dimen/radio_button_with_description_and_aux_button_padding"
        app:tint="@color/default_icon_color_tint_list"/>
</LinearLayout>
