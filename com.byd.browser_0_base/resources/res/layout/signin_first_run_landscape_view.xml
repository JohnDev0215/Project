<?xml version="1.0" encoding="utf-8"?>
<org.chromium.chrome.browser.ui.signin.fre.SigninFirstRunView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_surface"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/fre_logo"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:src="@drawable/fre_product_logo"
        android:layout_centerVertical="true"
        android:importantForAccessibility="no"
        android:layout_marginStart="90dp"
        android:layout_marginEnd="70dp"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/color_text_title"
        android:gravity="start"
        android:id="@+id/title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="@string/statement"
        android:layout_below="@+id/fre_logo"
        android:lineSpacingMultiplier="1.2"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/color_text_title"
        android:id="@+id/message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/statement_message"
        android:layout_below="@+id/title"
        android:lineSpacingMultiplier="1"
        android:layout_marginHorizontal="20dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/message"
        android:layout_centerVertical="true"
        android:layout_marginEnd="60dp">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="24dp">
            <org.chromium.ui.widget.TextViewWithLeading
                android:textAppearance="@style/TextAppearance.TextMedium.Secondary"
                android:gravity="start"
                android:id="@+id/subtitle"
                android:paddingTop="8dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:leading="@dimen/text_size_medium_leading"/>
            <FrameLayout
                android:id="@+id/fre_browser_managed_by"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">
                <include
                    android:gravity="start"
                    android:id="@+id/privacy_disclaimer"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    layout="@layout/fre_tos_privacy_disclaimer"/>
            </FrameLayout>
        </LinearLayout>
        <org.chromium.ui.widget.ButtonCompat
            android:textSize="18sp"
            android:ellipsize="end"
            android:id="@+id/signin_fre_continue_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="60dp"
            android:minWidth="140dp"
            android:minHeight="48dp"
            android:text="@string/statement_enter"
            android:singleLine="true"
            android:paddingHorizontal="100dp"
            android:paddingVertical="16dp"
            app:buttonColor="@color/color_btn_yes_select_bg"
            app:buttonTextColor="@color/color_btn_yes_select_text"
            app:rippleCornerRadiusBottomEnd="4dp"
            app:rippleCornerRadiusBottomStart="4dp"
            app:rippleCornerRadiusTopEnd="4dp"
            app:rippleCornerRadiusTopStart="4dp"
            style="@style/FilledButton.Flat"/>
        <ProgressBar
            android:layout_gravity="center_horizontal"
            android:id="@+id/fre_native_and_policy_load_progress_spinner"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="95dp"
            android:alpha="0"
            android:layout_marginEnd="24dp"
            style="@style/Widget.AppCompat.ProgressBar"/>
        <org.chromium.ui.widget.TextViewWithClickableSpans
            android:textAppearance="@style/TextAppearance.TextSmall.Secondary"
            android:gravity="start"
            android:id="@+id/signin_fre_footer"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:text="@string/signin_fre_footer"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:leading="@dimen/text_size_small_leading"/>
    </LinearLayout>
    <FrameLayout
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="120dp"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="60dp"
        android:layout_toEndOf="@+id/fre_logo">
        <ProgressBar
            android:layout_gravity="center_horizontal"
            android:id="@+id/fre_signin_progress_spinner"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="32dp"
            style="@style/Widget.AppCompat.ProgressBar"/>
        <TextView
            android:layout_gravity="center_horizontal"
            android:id="@+id/fre_signin_progress_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:text="@string/fre_signing_in"
            style="@style/TextAppearance.TextMedium.Secondary"/>
    </FrameLayout>
</org.chromium.chrome.browser.ui.signin.fre.SigninFirstRunView>
