<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="?attr/listPreferredItemHeightSmall"
    android:paddingStart="@dimen/dimen_36_dp"
    android:paddingEnd="@dimen/dimen_48_dp">
    <CheckBox
        android:textSize="14sp"
        android:ellipsize="end"
        android:id="@+id/icon_row_checkbox"
        android:padding="2dp"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true"
        style="@style/Clear.Data.CheckBox"/>
    <TextView
        android:id="@+id/tv_url"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        android:layout_toEndOf="@+id/icon_row_checkbox"
        style="@style/Dialog.Style.Message"/>
    <ImageView
        android:id="@+id/icon_row_image"
        android:padding="2dp"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:scaleType="center"
        android:minWidth="@dimen/dimen_30_dp"
        android:minHeight="@dimen/dimen_30_dp"
        android:layout_centerVertical="true"
        android:importantForAccessibility="no"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
