<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/dialog_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/website_reset_confirmation_title"
        style="@style/Dialog.Style.Title"/>
    <View
        android:id="@+id/divider_view"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_height"
        android:layout_below="@+id/tv_title"
        style="@style/HorizontalDivider"/>
    <TextView
        android:id="@+id/main_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_40_dp"
        style="@style/Dialog.Style.Message"/>
    <TextView
        android:id="@+id/signed_out_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:drawablePadding="12dp"
        android:layout_marginStart="@dimen/dimen_48_dp"
        android:layout_marginEnd="@dimen/dimen_48_dp"
        app:drawableStartCompat="@drawable/ic_person_24dp"
        style="@style/Dialog.Style.Message"/>
    <TextView
        android:id="@+id/offline_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:drawablePadding="12dp"
        android:layout_marginStart="@dimen/dimen_48_dp"
        android:layout_marginEnd="@dimen/dimen_48_dp"
        app:drawableStartCompat="@drawable/ic_offline_pin_24dp"
        style="@style/Dialog.Style.Message"/>
    <TextView
        android:id="@+id/ad_personalization_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="@string/webstorage_clear_data_dialog_site_settings_remove_site_ad_personalization"
        android:drawablePadding="16dp"
        android:layout_marginStart="@dimen/dimen_48_dp"
        android:layout_marginEnd="@dimen/dimen_48_dp"
        app:drawableStartCompat="@drawable/ic_data_personalization_20dp"
        style="@style/Dialog.Style.Message"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_sure_cancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_44_dp"
        android:layout_marginBottom="30dp"
        android:layout_below="@+id/ad_personalization">
        <LinearLayout
            android:gravity="end|center_vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <Button
                android:textColor="@color/dialog_button_true_text_color"
                android:gravity="center"
                android:id="@+id/btn_sure"
                android:background="@drawable/button_bg_true_dialog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/website_reset"
                android:textAllCaps="false"
                android:layout_marginEnd="24dp"
                style="@style/DialogButtonTrue"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="start|center_vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <Button
                android:textColor="@color/dialog_button_cancel_text_color"
                android:gravity="center"
                android:id="@+id/btn_cancel"
                android:background="@drawable/button_bg_cancel_dialog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel"
                android:textAllCaps="false"
                android:layout_marginStart="24dp"
                style="@style/DialogButtonCancel"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
