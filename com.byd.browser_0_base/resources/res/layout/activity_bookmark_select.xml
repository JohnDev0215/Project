<?xml version="1.0" encoding="utf-8"?>
<skin.support.constraint.SkinCompatConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:background="@drawable/bookmark_edit_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <skin.support.widget.SkinCompatTextView
        android:textSize="@dimen/dimen_20_sp"
        android:textColor="@color/dialog_color_text_title"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_22_dp"
        android:text="@string/bookmark_move_folder"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:background="@color/bookmark_edit_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_1_dp"
        android:layout_marginTop="@dimen/dimen_20_dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <skin.support.widget.SkinCompatTextView
        android:textSize="@dimen/dimen_20_sp"
        android:textColor="@color/dialog_color_text_message_hint"
        android:id="@+id/tv_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_40_dp"
        android:text="@string/bookmark_select_folder"
        android:layout_marginStart="@dimen/dimen_48_dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <ListView
        android:id="@+id/bookmark_folder_list"
        android:background="@drawable/shape_bookmark_select_bg"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="18dp"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:layout_marginHorizontal="@dimen/dimen_48_dp"
        android:paddingVertical="7dp"
        app:layout_constraintBottom_toTopOf="@+id/ll_sure_cancel"
        app:layout_constraintTop_toBottomOf="@+id/tv_message"
        app:layout_constraintVertical_bias="1"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_sure_cancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_28_dp"
        android:layout_marginBottom="@dimen/dimen_28_dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="0">
        <LinearLayout
            android:gravity="end"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <Button
                android:textSize="@dimen/text_size_18sp"
                android:textColor="@color/dialog_button_true_text_color"
                android:gravity="center"
                android:layout_gravity="end"
                android:id="@+id/btn_sure"
                android:background="@drawable/button_bg_true_dialog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/save"
                android:textAllCaps="false"
                android:layout_marginEnd="@dimen/dimen_24_dp"
                style="@style/DialogButtonTrue"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="start"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <Button
                android:textSize="@dimen/text_size_18sp"
                android:textColor="@color/dialog_button_cancel_text_color"
                android:gravity="center"
                android:layout_gravity="start"
                android:id="@+id/btn_cancel"
                android:background="@drawable/button_bg_cancel_dialog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel"
                android:textAllCaps="false"
                android:layout_marginStart="@dimen/dimen_24_dp"
                style="@style/DialogButtonCancel"/>
        </LinearLayout>
    </LinearLayout>
</skin.support.constraint.SkinCompatConstraintLayout>
