<?xml version="1.0" encoding="utf-8"?>
<skin.support.widget.SkinCompatFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/custom_grid_tab_switcher_view_holder"
    android:background="@color/tab_switcher_back_color"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ViewStub
        android:id="@+id/fullscreen_tab_switcher_toolbar_stub"
        android:layout="@layout/custom_tab_switcher_toolbar"
        android:inflatedId="@+id/custom_tab_switcher_toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height_no_shadow"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/linear_layout_landscape"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/ll_add_site_landscape"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/landscape_bottom_margin">
            <skin.support.widget.SkinCompatImageView
                android:id="@+id/btn_add_site_landscape"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_add_site_button"
                app:tint="@color/tab_page_add_del_tin"/>
            <skin.support.widget.SkinCompatTextView
                android:textSize="@dimen/tab_page_add_del_text_size"
                android:textColor="@color/tab_page_text_color"
                android:id="@+id/tv_add_site_landscape"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tabs_page_tv_top"
                android:text="@string/btn_add_site"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/ll_delete_page_landscape"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/landscape_top_margin">
            <skin.support.widget.SkinCompatImageView
                android:id="@+id/btn_delete_page_landscape"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_delete_page_button"
                app:tint="@color/tab_page_add_del_tin"/>
            <skin.support.widget.SkinCompatTextView
                android:textSize="@dimen/tab_page_add_del_text_size"
                android:textColor="@color/tab_page_text_color"
                android:id="@+id/tv_delete_page_landscape"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tabs_page_tv_top"
                android:text="@string/btn_delete_page"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/linear_layout_vertical"
        android:paddingBottom="@dimen/vertical_margin_bottom"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vertical_height">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_add_site_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/vertical_bottom_margin">
            <skin.support.widget.SkinCompatImageView
                android:id="@+id/btn_add_site_vertical"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_add_site_button"
                app:tint="@color/default_icon_color_tint_list"/>
            <skin.support.widget.SkinCompatTextView
                android:textSize="@dimen/tab_page_add_del_text_size"
                android:textColor="@color/tab_page_text_color"
                android:id="@+id/tv_add_site_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tabs_page_tv_top"
                android:text="@string/btn_add_site"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_delete_page_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/vertical_bottom_margin">
            <skin.support.widget.SkinCompatImageView
                android:id="@+id/btn_delete_page_vertical"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_delete_page_button"
                app:tint="@color/default_icon_color_tint_list"/>
            <skin.support.widget.SkinCompatTextView
                android:textSize="@dimen/tab_page_add_del_text_size"
                android:textColor="@color/tab_page_text_color"
                android:id="@+id/tv_delete_page_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tabs_page_tv_top"
                android:text="@string/btn_delete_page"/>
        </LinearLayout>
    </LinearLayout>
</skin.support.widget.SkinCompatFrameLayout>
