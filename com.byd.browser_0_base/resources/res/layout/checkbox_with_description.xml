<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/checkbox_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/min_touch_target_size"
        android:layout_alignParentStart="true">
        <CheckBox
            android:id="@+id/checkbox"
            android:background="@null"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/dimen_48_dp"
            android:minHeight="@dimen/dimen_48_dp"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="@dimen/check_box_with_description_text_title_size"
            android:textColor="@color/settings_title_color"
            android:id="@+id/primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/checkbox"/>
        <TextView
            android:textSize="@dimen/check_box_with_description_text_message_size"
            android:textColor="@color/settings_preference_summary_text_color"
            android:id="@+id/description"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_8_dp"
            android:layout_below="@+id/primary"
            android:layout_alignStart="@+id/primary"/>
    </RelativeLayout>
</merge>
