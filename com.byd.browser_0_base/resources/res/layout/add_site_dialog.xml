<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/dialog_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/website_settings_add_site_dialog_title"
        style="@style/Dialog.Style.Title"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_height"
        style="@style/HorizontalDivider"/>
    <TextView
        android:gravity="start|center_vertical"
        android:id="@+id/tv_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        style="@style/Dialog.Style.Message"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/dialog_color_text_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_16_dp"
        android:text="@string/website_settings_add_site_site_url"
        android:layout_marginStart="@dimen/dimen_48_dp"
        android:layout_marginEnd="@dimen/dimen_48_dp"/>
    <org.chromium.components.browser_ui.widget.text.AlertDialogEditText
        android:theme="@style/EditText.Style"
        android:id="@+id/site"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/enter_web_address"
        android:inputType="textNoSuggestions"
        android:textAlignment="viewStart"
        android:layout_marginStart="@dimen/dimen_44_dp"
        android:layout_marginEnd="@dimen/dimen_44_dp"/>
    <org.chromium.components.browser_ui.site_settings.ChromeCheckBoxWithDescription
        android:id="@+id/add_site_dialog_checkbox"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_16_dp"
        android:layout_marginStart="@dimen/dimen_48_dp"
        android:layout_marginEnd="@dimen/dimen_48_dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_sure_cancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_44_dp"
        android:layout_marginBottom="30dp">
        <LinearLayout
            android:gravity="end|center_vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <Button
                android:textColor="@color/dialog_button_true_text_color"
                android:gravity="center"
                android:id="@+id/btn_sure"
                android:background="@drawable/button_bg_true_dialog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/website_settings_add_site_add_button"
                android:textAllCaps="false"
                android:layout_marginEnd="24dp"
                style="@style/DialogButtonTrue"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="start|center_vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <Button
                android:textColor="@color/dialog_button_cancel_text_color"
                android:gravity="center"
                android:id="@+id/btn_cancel"
                android:background="@drawable/button_bg_cancel_dialog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel"
                android:textAllCaps="false"
                android:layout_marginStart="24dp"
                style="@style/DialogButtonCancel"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
