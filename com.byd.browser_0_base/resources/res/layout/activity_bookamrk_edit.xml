<?xml version="1.0" encoding="utf-8"?>
<skin.support.constraint.SkinCompatConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:background="@drawable/bookmark_edit_background"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <skin.support.widget.SkinCompatTextView
        android:textSize="@dimen/dimen_20_sp"
        android:textColor="@color/dialog_color_text_title"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_22_dp"
        android:text="@string/bookmark_edit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:background="@color/bookmark_edit_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_1_dp"
        android:layout_marginTop="@dimen/dimen_20_dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <RelativeLayout
        android:id="@+id/view_title"
        android:background="@drawable/shape_edit_bookmark"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="@dimen/dimen_60_dp"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title">
        <com.google.android.material.textfield.TextInputEditText
            android:textSize="@dimen/dimen_18_sp"
            android:textColor="@color/text_color_bookmark_edit"
            android:textColorHint="@color/color_edit_hint"
            android:id="@+id/edit_title"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="@string/bookmark_title_edit_hint"
            android:inputType="textAutoCorrect"
            android:imeOptions="flagNoExtractUi"
            android:textAlignment="viewStart"
            android:paddingStart="@dimen/dimen_16_dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="60dp"/>
        <skin.support.widget.SkinCompatImageView
            android:id="@+id/edit_cancel_title"
            android:visibility="gone"
            android:layout_width="@dimen/dimen_48_dp"
            android:layout_height="@dimen/dimen_48_dp"
            android:src="@drawable/edit_clear"
            android:scaleType="centerInside"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dimen_8_dp"
            android:layout_alignParentEnd="true"
            app:tint="@color/default_icon_color_tint_list"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/view_url"
        android:background="@drawable/shape_edit_bookmark"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="@dimen/dimen_6_dp"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_title">
        <com.google.android.material.textfield.TextInputEditText
            android:textSize="@dimen/dimen_18_sp"
            android:textColor="@color/text_color_bookmark_edit"
            android:textColorHint="@color/color_edit_hint"
            android:id="@+id/edit_url"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="@string/bookmark_url_edit_hint"
            android:inputType="textAutoCorrect"
            android:imeOptions="flagNoExtractUi"
            android:textAlignment="viewStart"
            android:paddingStart="@dimen/dimen_16_dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="60dp"/>
        <skin.support.widget.SkinCompatImageView
            android:id="@+id/edit_cancel_url"
            android:visibility="gone"
            android:layout_width="@dimen/dimen_48_dp"
            android:layout_height="@dimen/dimen_48_dp"
            android:src="@drawable/edit_clear"
            android:scaleType="centerInside"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dimen_8_dp"
            android:layout_alignParentEnd="true"
            app:tint="@color/default_icon_color_tint_list"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_sure_cancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="@dimen/dimen_30_dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_url"
        app:layout_constraintVertical_bias="0">
        <LinearLayout
            android:gravity="end"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <Button
                android:textSize="@dimen/text_size_18sp"
                android:textColor="@color/dialog_button_true_text_color"
                android:gravity="center"
                android:layout_gravity="end"
                android:id="@+id/btn_sure"
                android:background="@drawable/button_bg_true_dialog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/card_save"
                android:textAllCaps="false"
                android:layout_marginEnd="@dimen/dimen_24_dp"
                style="@style/DialogButtonTrue"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="start"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <Button
                android:textSize="@dimen/text_size_18sp"
                android:textColor="@color/dialog_button_cancel_text_color"
                android:gravity="center"
                android:layout_gravity="start"
                android:id="@+id/btn_cancel"
                android:background="@drawable/button_bg_cancel_dialog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel"
                android:textAllCaps="false"
                android:layout_marginStart="@dimen/dimen_24_dp"
                style="@style/DialogButtonCancel"/>
        </LinearLayout>
    </LinearLayout>
</skin.support.constraint.SkinCompatConstraintLayout>
