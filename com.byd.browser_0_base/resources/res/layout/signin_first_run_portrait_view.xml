<?xml version="1.0" encoding="utf-8"?>
<org.chromium.chrome.browser.ui.signin.fre.SigninFirstRunView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_surface"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/color_text_title"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="@string/statement"
        android:lineSpacingMultiplier="1.2"
        android:paddingHorizontal="24dp"/>
    <skin.support.widget.SkinCompatScrollView
        android:scrollbarThumbVertical="@drawable/shape_scrollbar_thumb"
        android:scrollbarTrackVertical="@drawable/shape_scrollbar_track"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="20dp"
        android:fillViewport="true"
        android:layout_weight="1"
        android:layout_above="@+id/signin_fre_continue_button"
        android:layout_below="@+id/title"
        android:requiresFadingEdge="vertical"
        android:layout_marginStart="56dp"
        android:layout_marginEnd="19dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <TextView
            android:textSize="@dimen/dimen_20_sp"
            android:textColor="@color/color_text_title"
            android:id="@+id/message"
            android:paddingBottom="@dimen/dimen_10_dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/statement_message"
            android:lineSpacingMultiplier="1"
            android:paddingEnd="@dimen/dimen_20_dp"/>
    </skin.support.widget.SkinCompatScrollView>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:id="@+id/fre_space_above_logo"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="3"/>
            <ImageView
                android:id="@+id/fre_logo"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="24dp"
                android:src="@drawable/fre_product_logo"
                android:importantForAccessibility="no"/>
            <org.chromium.ui.widget.TextViewWithLeading
                android:textAppearance="@style/TextAppearance.TextMedium.Secondary"
                android:gravity="center"
                android:id="@+id/subtitle"
                android:paddingTop="8dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="60dp"
                app:leading="@dimen/text_size_medium_leading"/>
            <FrameLayout
                android:id="@+id/fre_browser_managed_by"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">
                <include
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/privacy_disclaimer"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    layout="@layout/fre_tos_privacy_disclaimer"/>
            </FrameLayout>
            <View
                android:id="@+id/fre_space_between_header_and_bottom_group"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_weight="5"/>
        </LinearLayout>
    </ScrollView>
    <org.chromium.chrome.browser.ui.widget.SKinCustomButton
        android:textSize="18sp"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/signin_fre_continue_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:layout_marginBottom="50dp"
        android:minWidth="160dp"
        android:minHeight="48dp"
        android:text="@string/statement_enter"
        android:singleLine="true"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:paddingHorizontal="@dimen/dimen_5_dp"
        app:buttonColor="@color/color_btn_yes_select_bg"
        app:buttonTextColor="@color/color_btn_yes_select_text"
        app:rippleCornerRadiusBottomEnd="@dimen/btn_cornerRadius"
        app:rippleCornerRadiusBottomStart="@dimen/btn_cornerRadius"
        app:rippleCornerRadiusTopEnd="@dimen/btn_cornerRadius"
        app:rippleCornerRadiusTopStart="@dimen/btn_cornerRadius"
        app:verticalInset="@dimen/dp_0_dp"
        style="@style/FilledButton.Flat"/>
    <ProgressBar
        android:id="@+id/fre_native_and_policy_load_progress_spinner"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="26dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:alpha="0"
        style="@style/Widget.AppCompat.ProgressBar"/>
    <FrameLayout
        android:id="@+id/fre_footer_viewgroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <org.chromium.ui.widget.TextViewWithClickableSpans
            android:textAppearance="@style/TextAppearance.TextSmall.Secondary"
            android:gravity="center_horizontal"
            android:id="@+id/signin_fre_footer"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:text="@string/signin_fre_footer"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:leading="@dimen/text_size_small_leading"/>
    </FrameLayout>
    <ProgressBar
        android:id="@+id/fre_signin_progress_spinner"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginBottom="128dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        style="@style/Widget.AppCompat.ProgressBar"/>
    <TextView
        android:gravity="center"
        android:id="@+id/fre_signin_progress_text"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="80dp"
        android:text="@string/fre_signing_in"
        android:layout_alignParentBottom="true"
        style="@style/TextAppearance.TextMedium.Secondary"/>
</org.chromium.chrome.browser.ui.signin.fre.SigninFirstRunView>
