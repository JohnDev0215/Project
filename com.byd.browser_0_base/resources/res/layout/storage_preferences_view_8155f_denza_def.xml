<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <TextView
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:gravity="center"
        android:id="@+id/empty_storage"
        android:padding="8dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="@string/no_saved_website_settings"/>
    <Button
        android:textColor="@color/page_button_true_text_color_8155f_denza_def"
        android:layout_gravity="center_horizontal"
        android:id="@+id/clear_button"
        android:background="@drawable/page_button_bg_true_8155f_denza_def"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_30_dp"
        android:text="@string/storage_clear_button_title"
        app:verticalInset="0dp"
        style="@style/ButtonTrue"/>
</merge>
