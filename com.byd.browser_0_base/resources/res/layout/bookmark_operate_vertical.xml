<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/view_left_operate"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="8dp"
    android:layout_centerHorizontal="true"
    android:layout_marginStart="100dp"
    android:layout_marginEnd="100dp">
    <skin.support.widget.SkinCompatTextView
        android:textSize="18sp"
        android:textColor="@color/color_bookmark_operate"
        android:id="@+id/tv_create_folder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/bookmark_create_folder"
        android:drawableTop="@drawable/bookmark_create"
        android:layout_alignParentLeft="true"
        android:drawableTint="@color/default_icon_color_tint_list"/>
    <skin.support.widget.SkinCompatTextView
        android:textSize="18sp"
        android:textColor="@color/color_bookmark_operate"
        android:id="@+id/tv_move_folder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/bookmark_move_folder"
        android:drawableTop="@drawable/bookmark_move"
        android:layout_centerHorizontal="true"
        android:drawableTint="@color/default_icon_color_tint_list"/>
    <skin.support.widget.SkinCompatTextView
        android:textSize="18sp"
        android:textColor="@color/color_bookmark_operate"
        android:id="@+id/tv_delete_page"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/delete"
        android:drawableTop="@drawable/bookmark_delete"
        android:layout_alignParentRight="true"
        android:drawableTint="@color/default_icon_color_tint_list"/>
</RelativeLayout>
