<?xml version="1.0" encoding="utf-8"?>
<org.chromium.chrome.browser.toolbar.optional_button.OptionalButtonView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="52dp"
    android:layout_height="match_parent">
    <org.chromium.ui.widget.ChromeImageView
        android:layout_gravity="center"
        android:id="@+id/swappable_icon_secondary_background"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        android:importantForAccessibility="no"
        android:paddingStart="@dimen/toolbar_phone_optional_button_background_start_padding"
        android:paddingVertical="@dimen/toolbar_phone_optional_button_background_vertical_padding"
        style="@style/ToolbarButton"/>
    <org.chromium.components.browser_ui.widget.listmenu.ListMenuButton
        android:layout_gravity="start|center_vertical"
        android:id="@+id/optional_toolbar_button"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:scaleType="fitStart"
        android:paddingStart="@dimen/toolbar_phone_optional_button_foreground_start_padding"
        android:paddingVertical="@dimen/toolbar_phone_optional_button_foreground_vertical_padding"
        style="@style/ToolbarButton"/>
    <TextView
        android:textAppearance="@style/TextAppearance.TextLarge.Primary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/action_chip_label"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:maxLines="1"
        android:layout_marginStart="48dp"/>
    <org.chromium.ui.widget.ChromeImageView
        android:layout_gravity="start|center_vertical"
        android:id="@+id/swappable_icon_animation_image"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="fitStart"
        android:importantForAccessibility="no"
        android:paddingStart="@dimen/toolbar_phone_optional_button_foreground_start_padding"
        android:paddingVertical="@dimen/toolbar_phone_optional_button_foreground_vertical_padding"
        style="@style/ToolbarButton"/>
</org.chromium.chrome.browser.toolbar.optional_button.OptionalButtonView>
