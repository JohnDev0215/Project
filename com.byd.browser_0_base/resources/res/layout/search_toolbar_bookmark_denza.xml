<?xml version="1.0" encoding="utf-8"?>
<skin.support.widget.SkinCompatLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:layout_gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/search_view"
    android:background="@drawable/shape_bg_search_denza"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="48dp">
    <skin.support.widget.SkinCompatImageView
        android:background="@null"
        android:visibility="visible"
        android:layout_width="@dimen/dimen_40_dp"
        android:layout_height="@dimen/dimen_40_dp"
        android:src="@drawable/search_url_bar"
        android:scaleType="center"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        app:tint="@color/color_bookmark_search_text_icon"/>
    <skin.support.widget.SkinCompatEditText
        android:textAppearance="@style/TextAppearance.TextLarge.Primary"
        android:textColor="@color/color_bookmark_search_result"
        android:textColorHint="@color/color_bookmark_search_text_icon"
        android:id="@+id/search_text"
        android:background="@null"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="2dp"
        android:hint="@string/bookmark_search_hint"
        android:singleLine="true"
        android:layout_weight="1"
        android:inputType="text"
        android:imeOptions="flagNoExtractUi|actionSearch"
        android:textAlignment="viewStart"/>
    <skin.support.widget.SkinCompatImageButton
        android:id="@+id/clear_text_button"
        android:background="@null"
        android:visibility="invisible"
        android:layout_width="@dimen/dimen_48_dp"
        android:layout_height="@dimen/dimen_48_dp"
        android:src="@drawable/edit_clear"
        android:scaleType="center"
        android:contentDescription="@string/accessibility_toolbar_btn_delete_url"
        android:paddingEnd="@dimen/clear_text_button_end_padding"
        android:layout_marginStart="@dimen/dimen_10_dp"
        app:tint="@color/default_icon_color_tint_list"/>
</skin.support.widget.SkinCompatLinearLayout>
