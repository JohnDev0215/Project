<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/view_left_operate"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="39dp">
    <RelativeLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/view_center"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_centerHorizontal="true"
        android:layout_marginVertical="80dp">
        <skin.support.widget.SkinCompatTextView
            android:textSize="18sp"
            android:textColor="@color/color_bookmark_operate"
            android:id="@+id/tv_create_folder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bookmark_create_folder"
            android:drawableTop="@drawable/bookmark_create"
            android:drawablePadding="@dimen/dimen_6_dp"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:drawableTint="@color/default_icon_color_tint_list"/>
        <skin.support.widget.SkinCompatTextView
            android:textSize="18sp"
            android:textColor="@color/color_bookmark_operate"
            android:id="@+id/tv_move_folder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bookmark_move_folder"
            android:drawableTop="@drawable/bookmark_move"
            android:drawablePadding="@dimen/dimen_6_dp"
            android:layout_centerInParent="true"
            android:layout_centerHorizontal="true"
            android:drawableTint="@color/default_icon_color_tint_list"/>
        <skin.support.widget.SkinCompatTextView
            android:textSize="18sp"
            android:textColor="@color/color_bookmark_operate"
            android:id="@+id/tv_delete_page"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/delete"
            android:drawableTop="@drawable/bookmark_delete"
            android:drawablePadding="@dimen/dimen_6_dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:drawableTint="@color/default_icon_color_tint_list"/>
    </RelativeLayout>
    <View
        android:id="@+id/divider_start"
        android:background="@color/color_divider"
        android:visibility="gone"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:layout_marginVertical="10dp"/>
    <View
        android:id="@+id/divider_end"
        android:background="@color/color_divider"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_alignParentEnd="true"
        android:layout_marginVertical="10dp"/>
</RelativeLayout>
