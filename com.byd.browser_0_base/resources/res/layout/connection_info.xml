<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/dimen_48_dp"
    android:layout_marginStart="-10dp"
    android:layout_marginEnd="@dimen/dimen_48_dp"
    android:layout_marginVertical="@dimen/dimen_5_dp">
    <org.chromium.ui.widget.ChromeImageView
        android:gravity="center_horizontal"
        android:id="@+id/connection_info_icon"
        android:layout_width="@dimen/dimen_24_dp"
        android:layout_height="@dimen/dimen_24_dp"
        android:layout_marginEnd="@dimen/dimen_24_dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/connection_info_text_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textAppearance="@style/TextAppearance.TextSmall.Secondary"
            android:textSize="@dimen/dimen_20_sp"
            android:textColor="@color/dialog_color_text_message_info_hint"
            android:id="@+id/connection_info_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="6dp"/>
    </LinearLayout>
</LinearLayout>
