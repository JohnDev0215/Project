<?xml version="1.0" encoding="utf-8"?>
<org.chromium.chrome.browser.toolbar.top.CustomTabSwitcherModeTopToolbar xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/custom_tab_switcher_toolbar"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="@dimen/toolbar_height_no_shadow"
    android:layoutDirection="locale">
    <org.chromium.chrome.browser.ui.widget.SkinChromeImageButton
        android:layout_gravity="start|center_vertical"
        android:id="@+id/btn_back"
        android:background="?attr/selectableItemBackground"
        android:padding="@dimen/status_indicator_icon_padding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_back"
        android:layout_marginStart="@dimen/tab_grid_iph_item_description_margin"
        app:tint="@color/default_icon_color_tint_list"/>
    <ViewStub
        android:layout_gravity="center"
        android:id="@+id/incognito_tabs_stub"
        android:layout="@layout/incognito_toggle_tabs"
        android:inflatedId="@+id/incognito_toggle_tabs"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginBottom="4dp"/>
    <LinearLayout
        android:layout_gravity="end|center_vertical"
        android:orientation="horizontal"
        android:id="@+id/tab_switcher_switches_and_menu"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <org.chromium.chrome.browser.toolbar.top.ToggleTabStackButton
            android:layout_gravity="top"
            android:id="@+id/tab_switcher_mode_tab_switcher_button"
            android:background="@android:color/transparent"
            android:contentDescription="@string/accessibility_toolbar_btn_tabswitcher_toggle_default"
            android:paddingStart="8dp"
            style="@style/ToolbarButton"/>
        <Switch
            android:layout_gravity="center"
            android:id="@+id/incognito_switch"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:thumb="@drawable/incognito_switch"
            android:track="@drawable/incognito_switch_track"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/tab_count_text_size"
        android:textColor="@color/tab_count_text_color"
        android:layout_gravity="center"
        android:id="@+id/tv_tab_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tv_tabs_total"/>
</org.chromium.chrome.browser.toolbar.top.CustomTabSwitcherModeTopToolbar>
