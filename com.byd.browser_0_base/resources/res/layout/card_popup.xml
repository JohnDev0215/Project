<?xml version="1.0" encoding="utf-8"?>
<skin.support.widget.SkinCompatLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/card_pop_back"
    android:layout_width="@dimen/pop_w"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/text_size_18sp"
        android:textColor="@color/black_1f"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/edit"
        android:paddingTop="@dimen/dimen_18_dp"
        android:paddingBottom="@dimen/dimen_12_dp"
        android:layout_width="@dimen/item_text_w"
        android:layout_height="0dp"
        android:text="@string/card_edit"
        android:layout_weight="1"/>
    <TextView
        android:background="@color/card_stroke_color"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/card_stroke_color_margin"
        android:layout_marginEnd="@dimen/card_stroke_color_margin"/>
    <TextView
        android:textSize="@dimen/text_size_18sp"
        android:textColor="@color/black_1f"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/del"
        android:paddingTop="@dimen/dimen_18_dp"
        android:paddingBottom="@dimen/dimen_12_dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:text="@string/card_edl"
        android:layout_weight="1"/>
</skin.support.widget.SkinCompatLinearLayout>
