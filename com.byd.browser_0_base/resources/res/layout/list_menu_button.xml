<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="30dp"
    android:layout_marginEnd="10dp">
    <skin.support.widget.SkinCompatImageView
        android:id="@+id/img_card"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/tab_add"
        android:contentDescription="@string/card_add_msg"
        app:tint="@color/default_text_color_hint_list"/>
    <skin.support.widget.SkinCompatImageButton
        android:id="@+id/bt_drag"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/bookmark_drag"
        android:scaleType="fitXY"
        android:layout_marginStart="@dimen/dimen_30_dp"
        app:tint="@color/default_icon_color_tint_list"
        style="@style/ListItemEndIcon"/>
    <skin.support.widget.SkinCompatImageButton
        android:id="@+id/bookmark_edit"
        android:background="@null"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/bookmark_edit"
        android:scaleType="fitXY"
        android:layout_marginStart="@dimen/dimen_30_dp"
        app:tint="@color/default_icon_color_tint_list"/>
    <org.chromium.components.browser_ui.widget.listmenu.ListMenuButton
        android:id="@+id/more"
        android:background="@null"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="30dp"
        android:layout_height="wrap_content"
        android:src="@drawable/btn_right"
        android:scaleType="centerInside"
        app:tint="@color/default_text_color_hint_list"/>
</LinearLayout>
