<?xml version="1.0" encoding="utf-8"?>
<org.chromium.chrome.browser.share.screenshot.ScreenshotShareSheetView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <org.chromium.ui.widget.ChromeImageView
                    android:gravity="center_horizontal"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/screenshot"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"/>
            </FrameLayout>
            <LinearLayout
                android:gravity="bottom"
                android:layout_gravity="start|bottom"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:weightSum="4"
                android:layout_marginStart="36dp"
                android:layout_marginEnd="36dp">
                <TextView
                    android:gravity="center"
                    android:layout_gravity="end|bottom"
                    android:id="@+id/edit"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:text="@string/screenshot_edit_title"
                    android:drawableTop="@drawable/edit_icon"
                    android:layout_weight="1"
                    android:drawableTint="@color/default_icon_color_tint_list"
                    style="@style/SplitToolbarButton"/>
                <TextView
                    android:gravity="center"
                    android:layout_gravity="bottom|center_horizontal"
                    android:id="@+id/delete"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:text="@string/screenshot_delete_title"
                    android:drawableTop="@drawable/delete_icon"
                    android:layout_weight="1"
                    android:drawableTint="@color/default_icon_color_tint_list"
                    style="@style/SplitToolbarButton"/>
                <TextView
                    android:gravity="center"
                    android:layout_gravity="bottom|center_horizontal"
                    android:id="@+id/save"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:text="@string/screenshot_save_title"
                    android:drawableTop="@drawable/save_icon"
                    android:layout_weight="1"
                    android:drawableTint="@color/default_icon_color_tint_list"
                    style="@style/SplitToolbarButton"/>
                <TextView
                    android:gravity="center"
                    android:layout_gravity="start|bottom"
                    android:id="@+id/share"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:text="@string/screenshot_share_title"
                    android:drawableTop="@drawable/share_icon"
                    android:layout_weight="1"
                    android:drawableTint="@color/default_icon_color_tint_list"
                    style="@style/SplitToolbarButton"/>
            </LinearLayout>
        </LinearLayout>
        <org.chromium.ui.widget.ChromeImageButton
            android:id="@+id/close_button"
            android:src="@drawable/btn_close"
            android:contentDescription="@string/close"
            app:tint="@color/default_icon_color_tint_list"
            style="@style/ToolbarButton"/>
    </RelativeLayout>
</org.chromium.chrome.browser.share.screenshot.ScreenshotShareSheetView>
