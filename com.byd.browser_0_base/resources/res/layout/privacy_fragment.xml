<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/color_surface"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/color_text_title"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="@string/privacy_policy"
        android:lineSpacingMultiplier="1.2"
        android:paddingHorizontal="24dp"/>
    <skin.support.widget.SkinCompatScrollView
        android:scrollbarThumbVertical="@drawable/shape_scrollbar_thumb"
        android:scrollbarTrackVertical="@drawable/shape_scrollbar_track"
        android:id="@+id/scrollView"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:fillViewport="true"
        android:layout_weight="1"
        android:requiresFadingEdge="vertical"
        android:layout_marginStart="56dp"
        android:layout_marginEnd="19dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    <LinearLayout
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/ll_agree_cancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="50dp">
        <org.chromium.chrome.browser.ui.widget.SKinCustomButton
            android:enabled="false"
            android:textSize="18sp"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/bt_privacy_agree"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dimen_48_dp"
            android:minWidth="160dp"
            android:minHeight="48dp"
            android:text="@string/agree"
            android:singleLine="true"
            android:paddingHorizontal="@dimen/dimen_5_dp"
            app:buttonColor="@color/color_btn_yes_select_bg"
            app:buttonTextColor="@color/color_btn_yes_select_text"
            app:rippleCornerRadiusBottomEnd="@dimen/btn_cornerRadius"
            app:rippleCornerRadiusBottomStart="@dimen/btn_cornerRadius"
            app:rippleCornerRadiusTopEnd="@dimen/btn_cornerRadius"
            app:rippleCornerRadiusTopStart="@dimen/btn_cornerRadius"
            app:verticalInset="@dimen/dp_0_dp"
            style="@style/FilledButton.Flat"/>
        <View
            android:layout_width="@dimen/dimen_48_dp"
            android:layout_height="1dp"/>
        <org.chromium.chrome.browser.ui.widget.SKinCustomButton
            android:enabled="false"
            android:textSize="18sp"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/bt_privacy_disagree"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dimen_48_dp"
            android:minWidth="160dp"
            android:minHeight="48dp"
            android:text="@string/disagree"
            android:singleLine="true"
            android:paddingHorizontal="@dimen/dimen_5_dp"
            app:buttonColor="@color/color_btn_no_select_bg"
            app:buttonTextColor="@color/color_btn_no_select_text"
            app:rippleCornerRadiusBottomEnd="@dimen/btn_cornerRadius"
            app:rippleCornerRadiusBottomStart="@dimen/btn_cornerRadius"
            app:rippleCornerRadiusTopEnd="@dimen/btn_cornerRadius"
            app:rippleCornerRadiusTopStart="@dimen/btn_cornerRadius"
            app:verticalInset="@dimen/dp_0_dp"
            style="@style/FilledButton.Flat"/>
    </LinearLayout>
</LinearLayout>
