<?xml version="1.0" encoding="utf-8"?>
<level-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:drawable="@drawable/default_list_item_bg_rect"
        android:maxLevel="@integer/list_item_level_default"/>
    <item android:maxLevel="@integer/list_item_level_selected">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/list_item_v2_start_icon_corner_radius"/>
            <solid android:color="?attr/colorPrimary"/>
        </shape>
    </item>
    <item android:maxLevel="@integer/list_item_level_incognito">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/list_item_v2_start_icon_corner_radius"/>
            <solid android:color="@color/white_alpha_70"/>
        </shape>
    </item>
</level-list>
