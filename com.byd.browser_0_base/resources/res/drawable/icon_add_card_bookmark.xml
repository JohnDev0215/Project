<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="8dp"
        android:right="8dp">
        <shape android:shape="line">
            <stroke
                android:width="2dp"
                android:color="#ffffff"/>
        </shape>
    </item>
    <item
        android:left="8dp"
        android:right="8dp">
        <rotate
            android:fromDegrees="90"
            android:toDegrees="90">
            <shape android:shape="line">
                <stroke
                    android:width="2dp"
                    android:color="#ffffff"/>
            </shape>
        </rotate>
    </item>
</layer-list>
