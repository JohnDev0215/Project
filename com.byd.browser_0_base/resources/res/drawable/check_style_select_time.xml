<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item
                android:height="@dimen/dimen_40_dp"
                android:width="@dimen/dimen_40_dp"
                android:drawable="@drawable/check_circle_select"/>
        </layer-list>
    </item>
    <item android:state_checked="false">
        <layer-list>
            <item
                android:height="@dimen/dimen_36_dp"
                android:width="@dimen/dimen_36_dp"
                android:drawable="@drawable/check_circle_no_select"/>
        </layer-list>
    </item>
    <item android:state_pressed="false">
        <layer-list>
            <item
                android:height="@dimen/dimen_36_dp"
                android:width="@dimen/dimen_36_dp"
                android:drawable="@drawable/check_circle_no_select"/>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item
                android:height="@dimen/dimen_40_dp"
                android:width="@dimen/dimen_40_dp"
                android:drawable="@drawable/check_circle_no_select"/>
        </layer-list>
    </item>
</selector>
