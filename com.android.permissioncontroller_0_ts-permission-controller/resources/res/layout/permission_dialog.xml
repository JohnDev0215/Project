<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/shape_8px_corners"
    android:layout_width="@dimen/shape_8px_corners_width"
    android:layout_height="@dimen/shape_8px_corners_height">
    <TextView
        android:textSize="@dimen/permission_dialog_title_text_size"
        android:textColor="@color/permission_dialog_text_title"
        android:layout_gravity="center_horizontal"
        android:id="@+id/permission_dialog_title"
        android:background="@drawable/shape_8px_corners_top"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/permission_dialog_title_width"
        android:layout_marginTop="@dimen/permission_dialog_title_margin_top"/>
    <View
        android:background="@color/view_color"
        android:layout_width="match_parent"
        android:layout_height="@dimen/view_height"
        android:layout_marginTop="@dimen/view_margin_top"/>
    <ListView
        android:layout_gravity="center_horizontal"
        android:id="@+id/permission_dialog_content"
        android:layout_width="match_parent"
        android:layout_height="@dimen/permission_dialog_content_height"
        android:layout_marginTop="@dimen/permission_dialog_content_margin_top"
        android:listSelector="@android:color/transparent"
        android:divider="@null"
        style="@style/ListViewScrollBar"/>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:background="@drawable/shape_8px_corners_bottom"
        android:layout_width="match_parent"
        android:layout_height="@dimen/linearlayout_bottom_height"
        android:layout_marginTop="@dimen/permission_dialog_btn_margin_top">
        <Space
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <Button
            android:textSize="@dimen/btn_text_size"
            android:textColor="@color/text_ok"
            android:id="@+id/btn_ok"
            android:background="@drawable/shape_btn_ok"
            android:layout_width="@dimen/btn_width"
            android:layout_height="@dimen/btn_height"
            android:layout_marginTop="@dimen/btn_margin_top"
            android:text="@string/btn_ok"
            android:stateListAnimator="@null"/>
        <Button
            android:textSize="@dimen/btn_text_size"
            android:textColor="@color/text_cancel"
            android:id="@+id/btn_cancel"
            android:background="@drawable/shape_btn_cancel"
            android:layout_width="@dimen/btn_width"
            android:layout_height="@dimen/btn_height"
            android:layout_marginTop="@dimen/btn_margin_top"
            android:text="@string/btn_cancel"
            android:layout_marginStart="@dimen/btn_cancel_margin_left"
            android:stateListAnimator="@null"/>
        <Space
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
