<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/rl_bg_main"
    android:paddingTop="@dimen/dp_56"
    android:paddingBottom="@dimen/dp_60"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bydux.api.common.views.window.DampingScrollView
        android:id="@+id/mDampingScrollView"
        android:scrollbars="none"
        android:layout_width="@dimen/dp_249"
        android:layout_height="match_parent"
        android:layout_alignParentLeft="true">
        <LinearLayout
            android:gravity="left"
            android:orientation="vertical"
            android:id="@+id/ll_rg_main"
            android:paddingTop="@dimen/dp_20"
            android:layout_width="@dimen/dp_249"
            android:layout_height="@dimen/dp_591">
            <LinearLayout
                android:gravity="center_vertical"
                android:id="@+id/ll_search_main"
                android:background="@drawable/bg_frame_gray_search"
                android:layout_width="@dimen/dp_176"
                android:layout_height="@dimen/dp_48"
                android:layout_marginLeft="@dimen/dp_24"
                android:layout_marginTop="@dimen/dp_16">
                <ImageView
                    android:background="@drawable/icon_public_search_48"
                    android:layout_width="@dimen/dp_48"
                    android:layout_height="@dimen/dp_48"
                    android:layout_marginStart="@dimen/dp_4"/>
                <TextView
                    android:textSize="@dimen/sp_18"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp_26"
                    android:hint="@string/search_function"
                    android:layout_marginStart="@dimen/dp_3"/>
            </LinearLayout>
            <RelativeLayout
                android:orientation="horizontal"
                android:id="@+id/rl_menu_0"
                android:visibility="gone"
                android:layout_width="@dimen/dp_208"
                android:layout_height="@dimen/dp_64">
                <ImageView
                    android:id="@+id/iv_menu_bg_0"
                    android:layout_width="@dimen/dp_208"
                    android:layout_height="@dimen/dp_64"/>
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/iv_menu_icon_0"
                    android:layout_width="@dimen/dp_48"
                    android:layout_height="@dimen/dp_48"
                    android:src="@drawable/icon_carsetting_collect_48"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/dp_28"/>
                <TextView
                    android:textSize="@dimen/sp_20"
                    android:textColor="@drawable/selector_rbtn_text_color_checked_blue"
                    android:id="@+id/tv_menu_0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/common_main"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@+id/iv_menu_icon_0"/>
                <ImageView
                    android:id="@+id/iv_menu_msg_0"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:src="@drawable/shape_circle_red_msg"
                    android:layout_marginStart="@dimen/dp_64"/>
            </RelativeLayout>
            <RelativeLayout
                android:orientation="horizontal"
                android:id="@+id/rl_menu_1"
                android:layout_width="@dimen/dp_208"
                android:layout_height="@dimen/dp_64"
                android:layout_marginTop="@dimen/dp_8">
                <ImageView
                    android:id="@+id/iv_menu_bg_1"
                    android:layout_width="@dimen/dp_208"
                    android:layout_height="@dimen/dp_64"/>
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/iv_menu_icon_1"
                    android:layout_width="@dimen/dp_48"
                    android:layout_height="@dimen/dp_48"
                    android:layout_marginLeft="@dimen/dp_28"
                    android:layout_centerVertical="true"
                    app:lottie_colorFilter="@color/left_bar_btn_text_color_s"
                    app:lottie_rawRes="@raw/dilink"/>
                <TextView
                    android:textSize="@dimen/sp_20"
                    android:textColor="@drawable/selector_rbtn_text_color_checked_blue"
                    android:id="@+id/tv_menu_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="?attr/text_dilink"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@+id/iv_menu_icon_1"/>
                <ImageView
                    android:id="@+id/iv_menu_msg_1"
                    android:visibility="gone"
                    android:layout_width="@dimen/dp_8"
                    android:layout_height="@dimen/dp_8"
                    android:layout_marginTop="@dimen/dp_15"
                    android:src="@drawable/shape_circle_red_msg"
                    android:layout_marginStart="@dimen/dp_61"/>
            </RelativeLayout>
            <RelativeLayout
                android:orientation="horizontal"
                android:id="@+id/rl_menu_2"
                android:layout_width="@dimen/dp_208"
                android:layout_height="@dimen/dp_64"
                android:layout_marginTop="@dimen/dp_4">
                <ImageView
                    android:id="@+id/iv_menu_bg_2"
                    android:layout_width="@dimen/dp_208"
                    android:layout_height="@dimen/dp_64"/>
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/iv_menu_icon_2"
                    android:layout_width="@dimen/dp_48"
                    android:layout_height="@dimen/dp_48"
                    android:layout_marginLeft="@dimen/dp_28"
                    android:layout_centerVertical="true"
                    app:lottie_colorFilter="@color/left_bar_btn_text_color_n"
                    app:lottie_rawRes="@raw/dipilot"/>
                <TextView
                    android:textSize="@dimen/sp_20"
                    android:textColor="@drawable/selector_rbtn_text_color_checked_blue"
                    android:id="@+id/tv_menu_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="?attr/text_dipilot"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@+id/iv_menu_icon_2"/>
                <ImageView
                    android:id="@+id/iv_menu_msg_2"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:src="@drawable/shape_circle_red_msg"
                    android:layout_marginStart="@dimen/dp_64"/>
            </RelativeLayout>
            <RelativeLayout
                android:orientation="horizontal"
                android:id="@+id/rl_menu_3"
                android:layout_width="@dimen/dp_208"
                android:layout_height="@dimen/dp_64"
                android:layout_marginTop="@dimen/dp_4">
                <ImageView
                    android:id="@+id/iv_menu_bg_3"
                    android:layout_width="@dimen/dp_208"
                    android:layout_height="@dimen/dp_64"/>
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/iv_menu_icon_3"
                    android:layout_width="@dimen/dp_48"
                    android:layout_height="@dimen/dp_48"
                    android:layout_marginLeft="@dimen/dp_28"
                    android:layout_centerVertical="true"
                    app:lottie_colorFilter="@color/left_bar_btn_text_color_n"
                    app:lottie_rawRes="@raw/new_energy"/>
                <TextView
                    android:textSize="@dimen/sp_20"
                    android:textColor="@drawable/selector_rbtn_text_color_checked_blue"
                    android:id="@+id/tv_menu_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/new_energy_main_v2"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@+id/iv_menu_icon_3"/>
                <ImageView
                    android:id="@+id/iv_menu_msg_3"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:src="@drawable/shape_circle_red_msg"
                    android:layout_marginStart="@dimen/dp_64"/>
            </RelativeLayout>
            <RelativeLayout
                android:orientation="horizontal"
                android:id="@+id/rl_menu_4"
                android:layout_width="@dimen/dp_208"
                android:layout_height="@dimen/dp_64"
                android:layout_marginTop="@dimen/dp_4">
                <ImageView
                    android:id="@+id/iv_menu_bg_4"
                    android:layout_width="@dimen/dp_208"
                    android:layout_height="@dimen/dp_64"/>
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/iv_menu_icon_4"
                    android:layout_width="@dimen/dp_48"
                    android:layout_height="@dimen/dp_48"
                    android:layout_marginLeft="@dimen/dp_28"
                    android:layout_centerVertical="true"
                    app:lottie_colorFilter="@color/left_bar_btn_text_color_n"
                    app:lottie_rawRes="@raw/car_setting"/>
                <TextView
                    android:textSize="@dimen/sp_20"
                    android:textColor="@drawable/selector_rbtn_text_color_checked_blue"
                    android:id="@+id/tv_menu_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/car_setting_main_v2"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@+id/iv_menu_icon_4"/>
                <ImageView
                    android:id="@+id/iv_menu_msg_4"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:src="@drawable/shape_circle_red_msg"
                    android:layout_marginStart="@dimen/dp_64"/>
            </RelativeLayout>
            <RelativeLayout
                android:orientation="horizontal"
                android:id="@+id/rl_menu_5"
                android:layout_width="@dimen/dp_208"
                android:layout_height="@dimen/dp_64"
                android:layout_marginTop="@dimen/dp_4">
                <ImageView
                    android:id="@+id/iv_menu_bg_5"
                    android:layout_width="@dimen/dp_208"
                    android:layout_height="@dimen/dp_64"/>
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/iv_menu_icon_5"
                    android:layout_width="@dimen/dp_48"
                    android:layout_height="@dimen/dp_48"
                    android:layout_marginLeft="@dimen/dp_28"
                    android:layout_centerVertical="true"
                    app:lottie_colorFilter="@color/left_bar_btn_text_color_n"
                    app:lottie_rawRes="@raw/car_healthy"/>
                <TextView
                    android:textSize="@dimen/sp_20"
                    android:textColor="@drawable/selector_rbtn_text_color_checked_blue"
                    android:id="@+id/tv_menu_5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/car_healthy_main_v2"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@+id/iv_menu_icon_5"/>
                <ImageView
                    android:id="@+id/iv_menu_msg_5"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:src="@drawable/shape_circle_red_msg"
                    android:layout_marginStart="@dimen/dp_64"/>
            </RelativeLayout>
        </LinearLayout>
    </com.bydux.api.common.views.window.DampingScrollView>
    <FrameLayout
        android:id="@+id/cc_right_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/dp_220"/>
</RelativeLayout>
