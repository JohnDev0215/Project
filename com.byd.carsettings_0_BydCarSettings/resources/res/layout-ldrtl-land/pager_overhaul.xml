<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bydux.api.common.views.window.DampingScrollView
        android:scrollbars="none"
        android:fadingEdge="vertical"
        android:fadingEdgeLength="@dimen/dp_24"
        android:layout_width="@dimen/dp_468"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dp_6"
        android:layout_alignParentLeft="true"
        android:requiresFadingEdge="vertical">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_wiper"
                android:background="@drawable/carlights_background"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:paddingStart="@dimen/dp_24"
                android:paddingEnd="@dimen/dp_24">
                <LinearLayout
                    android:gravity="start|center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/ll_front_wiper"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_20"
                    android:layout_marginBottom="@dimen/dp_20"
                    android:layoutDirection="ltr">
                    <com.byd.base.view.BydSwitch
                        android:id="@+id/sw_front_wiper"
                        app:splitTrack="true"
                        app:switchMinWidth="@dimen/dp_56"
                        app:thumbTintMode="src_over"
                        app:track="?attr/transparent_00"
                        app:trackTint="?attr/transparent_00"
                        style="@style/bydswitch_style"/>
                    <TextView
                        android:textSize="@dimen/sp_20"
                        android:textColor="?attr/text_color_main"
                        android:gravity="right"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/vehiclehealth_front_wiper"
                        android:layout_marginStart="@dimen/dp_16"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="start|center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/ll_rear_wiper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_20"
                    android:layout_marginBottom="@dimen/dp_20"
                    android:layoutDirection="ltr">
                    <com.byd.base.view.BydSwitch
                        android:id="@+id/sw_rear_wiper"
                        app:splitTrack="true"
                        app:switchMinWidth="@dimen/dp_56"
                        app:thumbTintMode="src_over"
                        app:track="?attr/transparent_00"
                        app:trackTint="?attr/transparent_00"
                        style="@style/bydswitch_style"/>
                    <TextView
                        android:textSize="@dimen/sp_20"
                        android:textColor="?attr/text_color_main"
                        android:gravity="right"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/vehiclehealth_rear_wiper"
                        android:layout_marginStart="@dimen/dp_16"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/ll_tpms"
                android:background="@drawable/carlights_background"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_88"
                android:layout_marginTop="@dimen/dp_16"
                android:paddingStart="@dimen/dp_24">
                <TextView
                    android:textSize="@dimen/sp_20"
                    android:textColor="?attr/text_color_main"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/carhealthy_tpms"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/dp_16"/>
                <TextView
                    android:textSize="@dimen/sp_18"
                    android:textColor="@color/dialog_btn_text_tyre_selector"
                    android:gravity="center"
                    android:id="@+id/tv_reset"
                    android:background="@drawable/selector_dialog_white"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp_48"
                    android:minWidth="@dimen/dp_160"
                    android:text="@string/vehiclehealth_restore"
                    android:textAllCaps="false"
                    android:paddingStart="@dimen/dp_24"
                    android:paddingEnd="@dimen/dp_24"
                    android:layout_marginEnd="@dimen/dp_24"
                    android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_epb"
                android:background="@drawable/carlights_background"
                android:paddingTop="@dimen/dp_20"
                android:paddingBottom="@dimen/dp_20"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:layoutDirection="ltr"
                android:paddingStart="@dimen/dp_24"
                android:paddingEnd="@dimen/dp_24">
                <com.byd.base.view.BydSwitch
                    android:id="@+id/sw_epb"
                    app:splitTrack="true"
                    app:switchMinWidth="@dimen/dp_56"
                    app:thumbTintMode="src_over"
                    app:track="?attr/transparent_00"
                    app:trackTint="?attr/transparent_00"
                    style="@style/bydswitch_style"/>
                <TextView
                    android:textSize="@dimen/sp_20"
                    android:textColor="?attr/text_color_main"
                    android:gravity="right"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/carhealthy_epb"
                    android:layout_marginStart="@dimen/dp_16"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_user_manual"
                android:background="@drawable/carlights_background"
                android:paddingTop="@dimen/dp_20"
                android:paddingBottom="@dimen/dp_20"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:paddingStart="@dimen/dp_24"
                android:paddingEnd="@dimen/dp_24">
                <TextView
                    android:textSize="@dimen/sp_20"
                    android:textColor="?attr/text_color_main"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/carhealthy_user_manual"
                    android:layout_marginEnd="@dimen/dp_16"/>
                <View
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/iv_user_manual"
                    android:layout_width="@dimen/dp_48"
                    android:layout_height="@dimen/dp_48"
                    android:src="@drawable/icon_dark_public_rightarrow_48"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_jack"
                android:background="@drawable/carlights_background"
                android:paddingTop="@dimen/dp_20"
                android:paddingBottom="@dimen/dp_20"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:layoutDirection="ltr"
                android:paddingStart="@dimen/dp_24"
                android:paddingEnd="@dimen/dp_24">
                <com.byd.base.view.BydSwitch
                    android:id="@+id/sw_jack"
                    app:splitTrack="true"
                    app:switchMinWidth="@dimen/dp_56"
                    app:thumbTintMode="src_over"
                    app:track="?attr/transparent_00"
                    app:trackTint="?attr/transparent_00"
                    style="@style/bydswitch_style"/>
                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/iv_jack"
                    android:layout_width="@dimen/dp_48"
                    android:layout_height="@dimen/dp_48"
                    android:src="@drawable/icon_light_public_details_48"/>
                <TextView
                    android:textSize="@dimen/sp_20"
                    android:textColor="?attr/text_color_main"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/carhealthy_jack"/>
            </LinearLayout>
        </LinearLayout>
    </com.bydux.api.common.views.window.DampingScrollView>
    <ImageView
        android:id="@+id/iv_oil_result"
        android:layout_width="@dimen/dp_556"
        android:layout_height="@dimen/dp_468"
        android:layout_marginLeft="@dimen/dp_4"
        android:layout_marginTop="@dimen/dp_34"
        android:layout_alignParentRight="true"/>
</RelativeLayout>
