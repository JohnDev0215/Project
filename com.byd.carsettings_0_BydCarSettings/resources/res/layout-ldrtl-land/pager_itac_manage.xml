<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bydux.api.common.views.window.DampingScrollView
        android:scrollbars="none"
        android:fadingEdge="vertical"
        android:fadingEdgeLength="@dimen/dp_24"
        android:layout_width="@dimen/dp_468"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dp_6"
        android:layout_alignParentLeft="true"
        android:requiresFadingEdge="vertical">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_itac"
                android:background="@drawable/carlights_background"
                android:paddingTop="@dimen/dp_20"
                android:paddingBottom="@dimen/dp_20"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:paddingStart="@dimen/dp_24"
                android:paddingEnd="@dimen/dp_24">
                <TextView
                    android:textSize="@dimen/sp_20"
                    android:textColor="?attr/attr_text_color_main"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="@dimen/dp_292"
                    android:text="@string/itac_switch_title"/>
                <ImageView
                    android:id="@+id/iv_itac_hint"
                    android:layout_width="@dimen/dp_48"
                    android:layout_height="@dimen/dp_48"
                    android:src="@drawable/icon_light_public_details_48"
                    android:layout_marginEnd="@dimen/dp_16"/>
                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"/>
                <com.byd.base.view.BydSwitch
                    android:id="@+id/switch_itac"
                    app:splitTrack="true"
                    app:switchMinWidth="@dimen/dp_56"
                    app:thumbTintMode="src_over"
                    app:track="@color/transparent_00"
                    app:trackTint="@color/transparent_00"
                    style="@style/bydswitch_style"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_itac_mode"
                android:background="@drawable/carlights_background"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:paddingStart="@dimen/dp_24"
                android:paddingEnd="@dimen/dp_24">
                <LinearLayout
                    android:gravity="start|center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/ll_itac_title"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_26">
                    <TextView
                        android:textSize="@dimen/sp_20"
                        android:textColor="?attr/text_color_main"
                        android:gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/itac_mode_title"/>
                    <ImageView
                        android:id="@+id/iv_itac_mode"
                        android:visibility="gone"
                        android:layout_width="@dimen/dp_48"
                        android:layout_height="@dimen/dp_48"
                        android:src="@drawable/icon_light_public_details_48"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:layout_marginBottom="@dimen/dp_8">
                    <TextView
                        android:textSize="@dimen/sp_18"
                        android:textColor="@color/mode_btn_text_selector"
                        android:gravity="center"
                        android:id="@+id/tv_mode_terrain"
                        android:background="@drawable/selector_mode"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/dp_48"
                        android:text="@string/itac_mode_terrain"
                        android:layout_weight="1"
                        android:textAllCaps="false"
                        android:layout_marginEnd="@dimen/dp_12"
                        android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"/>
                    <TextView
                        android:textSize="@dimen/sp_18"
                        android:textColor="@color/mode_btn_text_selector"
                        android:gravity="center"
                        android:id="@+id/tv_mode_rescue"
                        android:background="@drawable/selector_mode"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:button="@drawable/selector_mode"
                        android:minHeight="@dimen/dp_48"
                        android:text="@string/itac_mode_rescue"
                        android:layout_weight="1"
                        android:textAllCaps="false"
                        android:layout_marginStart="@dimen/dp_12"
                        android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:layout_marginBottom="@dimen/dp_26">
                    <TextView
                        android:textSize="@dimen/sp_18"
                        android:textColor="@color/mode_btn_text_selector"
                        android:gravity="center"
                        android:id="@+id/tv_mode_drift"
                        android:background="@drawable/selector_mode"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/dp_48"
                        android:text="@string/itac_mode_drift"
                        android:layout_weight="1"
                        android:textAllCaps="false"
                        android:layout_marginEnd="@dimen/dp_24"
                        android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"/>
                    <TextView
                        android:textSize="@dimen/sp_18"
                        android:textColor="@color/mode_btn_text_selector"
                        android:gravity="center"
                        android:id="@+id/tv_mode_off"
                        android:background="@drawable/selector_mode"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:minHeight="@dimen/dp_48"
                        android:text="@string/itac_mode_off"
                        android:layout_weight="1"
                        android:textAllCaps="false"
                        android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"/>
                    <TextView
                        android:textSize="@dimen/sp_18"
                        android:textColor="@color/mode_btn_text_selector"
                        android:gravity="center"
                        android:id="@+id/tv_mode_space"
                        android:background="@drawable/selector_mode"
                        android:visibility="invisible"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:minHeight="@dimen/dp_48"
                        android:layout_weight="1"
                        android:textAllCaps="false"
                        android:layout_marginStart="@dimen/dp_24"
                        android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.bydux.api.common.views.window.DampingScrollView>
    <ImageView
        android:id="@+id/iv_itac_result"
        android:layout_width="@dimen/dp_556"
        android:layout_height="@dimen/dp_468"
        android:layout_marginLeft="@dimen/dp_4"
        android:layout_marginTop="@dimen/dp_34"
        android:src="@drawable/common_newenergy_itac_car_img_uke"
        android:layout_alignParentRight="true"/>
</RelativeLayout>
