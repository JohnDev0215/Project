<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:clipChildren="false"
    android:layout_width="@dimen/dp_556"
    android:layout_height="@dimen/dp_468"
    android:layoutDirection="ltr">
    <ImageView
        android:id="@+id/iv_car_bg"
        android:layout_width="@dimen/dp_556"
        android:layout_height="@dimen/dp_468"/>
    <ImageView
        android:id="@+id/iv_battery_progress"
        android:layout_width="@dimen/dp_204.5"
        android:layout_height="@dimen/dp_89"
        android:layout_marginTop="@dimen/dp_190"
        android:layout_marginStart="@dimen/dp_170"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="?attr/consumption_data_clear_text"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_battery_progress"
        android:background="@drawable/bg_battery_progress"
        android:paddingLeft="@dimen/dp_5"
        android:paddingTop="@dimen/dp_2"
        android:paddingRight="@dimen/dp_5"
        android:paddingBottom="@dimen/dp_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_160"
        android:layout_marginRight="@dimen/dp_6"/>
    <FrameLayout
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:background="@color/bg_red"
            android:layout_width="@dimen/dp_5"
            android:layout_height="@dimen/dp_5"
            android:layout_marginTop="@dimen/dp_192"
            android:layout_marginStart="@dimen/dp_180"/>
        <View
            android:background="@color/bg_red"
            android:layout_width="@dimen/dp_5"
            android:layout_height="@dimen/dp_5"
            android:layout_marginTop="@dimen/dp_192"
            android:layout_marginStart="@dimen/dp_360"/>
        <View
            android:background="@color/bg_red"
            android:layout_width="@dimen/dp_5"
            android:layout_height="@dimen/dp_5"
            android:layout_marginTop="@dimen/dp_262"
            android:layout_marginStart="@dimen/dp_172"/>
        <View
            android:background="@color/bg_red"
            android:layout_width="@dimen/dp_5"
            android:layout_height="@dimen/dp_5"
            android:layout_marginTop="@dimen/dp_262"
            android:layout_marginStart="@dimen/dp_368"/>
    </FrameLayout>
    <ImageView
        android:id="@+id/iv_scan"
        android:layout_width="@dimen/dp_204.5"
        android:layout_height="@dimen/dp_89"
        android:layout_marginTop="@dimen/dp_190"
        android:layout_marginStart="@dimen/dp_170"/>
    <com.byd.carsettings.ui.widget.LineTipsView
        android:id="@+id/lineTipsView"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/iv_car"
        android:layout_width="@dimen/dp_556"
        android:layout_height="@dimen/dp_468"
        android:src="@drawable/electricity_suv"/>
</FrameLayout>
