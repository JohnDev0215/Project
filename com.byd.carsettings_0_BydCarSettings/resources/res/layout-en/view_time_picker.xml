<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/dp_40"
    android:paddingEnd="@dimen/dp_40">
    <NumberPicker
        android:id="@+id/np_month_view_time_picker"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
    <NumberPicker
        android:id="@+id/np_day_view_time_picker"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
    <NumberPicker
        android:id="@+id/np_year_view_time_picker"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
    <NumberPicker
        android:id="@+id/np_hour_view_time_picker"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
    <NumberPicker
        android:id="@+id/np_minute_view_time_picker"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
    <NumberPicker
        android:id="@+id/np_ampm_view_time_picker"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
</LinearLayout>
