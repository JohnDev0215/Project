<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/ll_bg_dialo_sound_focus"
    android:background="@drawable/bg_dyna_sound_focus_rows_2"
    android:layout_width="@dimen/dp_560"
    android:layout_height="@dimen/dp_544">
    <include
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_72"
        layout="@layout/dialog_common_title"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <RadioGroup
            android:id="@+id/rg_harman_sound_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_54"
            android:layout_alignParentTop="true"
            android:layout_marginStart="@dimen/dp_40"
            android:layout_alignParentStart="true">
            <com.byd.mvp.ui.widget.TintRadioButton
                android:id="@+id/rbtn_all_harman_sound_balance"
                android:text="@string/whole_car_sound_balance_harman_sound"
                style="@style/rbtn_dyna_sound_charact"/>
            <com.byd.mvp.ui.widget.TintRadioButton
                android:id="@+id/rbtn_row_1st_harman_sound_balance"
                android:layout_marginTop="@dimen/dp_48"
                android:text="@string/row_1st_sound_balance_harman_sound"
                style="@style/rbtn_dyna_sound_charact"/>
            <com.byd.mvp.ui.widget.TintRadioButton
                android:id="@+id/rbtn_row_last_harman_sound_balance"
                android:layout_marginTop="@dimen/dp_48"
                android:text="@string/row_last_sound_balance_harman_sound"
                style="@style/rbtn_dyna_sound_charact"/>
        </RadioGroup>
        <com.byd.mvp.ui.widget.TintImageView
            android:id="@+id/iv_focus_harman_sound_balance"
            android:layout_width="@dimen/dp_230"
            android:layout_height="@dimen/dp_380"
            android:layout_marginBottom="@dimen/dp_36"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="@dimen/dp_32"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</LinearLayout>
