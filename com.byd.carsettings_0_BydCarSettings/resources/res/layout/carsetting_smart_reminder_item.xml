<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/dp_74"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent">
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="@color/carsetting_text_color_white"
        android:id="@+id/item_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_32"
        android:layout_toEndOf="@+id/item_switch"/>
    <com.byd.base.view.BydSwitch
        android:id="@+id/item_switch"
        android:layout_marginTop="@dimen/dp_13"
        android:layout_marginBottom="@dimen/dp_13"
        android:checked="false"
        android:layout_centerVertical="true"
        app:splitTrack="true"
        app:switchMinWidth="@dimen/dp_56"
        app:thumbTintMode="src_over"
        app:track="@color/transparent_00"
        app:trackTint="@color/transparent_00"
        style="@style/carsetting_smart_reminder_bydswitch_style"/>
</RelativeLayout>
