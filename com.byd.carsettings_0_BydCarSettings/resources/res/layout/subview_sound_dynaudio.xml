<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_frame_gray_a"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.byd.carsettings.ui.widget.LinearItem
            android:id="@+id/item_sound_field_focusing_sound_dynaudio"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_88"
            app:textLeft="@string/sound_field_focusing_dynaudio_sound"
            app:textRight="@string/all_sound_focus_dynaudio_sound"/>
        <com.byd.carsettings.ui.widget.LinearItem
            android:id="@+id/item_sound_charact_sound_dynaudio"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_88"
            app:textLeft="@string/sound_charact_dynaudio_sound"
            app:textRight="@string/original_charact_dynaudio_sound"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_sound_regulate_sound_dynaudio"
        android:background="@drawable/bg_frame_gray_a"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16">
        <RelativeLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_26"
            android:paddingStart="@dimen/dp_24"
            android:paddingEnd="@dimen/dp_24">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_main"
                android:id="@+id/tv_title_sound_regulate_sound_dynaudio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/dp_520"
                android:text="@string/title_dialog_sound_regulate_dynaudio_sound"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>
            <ImageView
                android:id="@+id/iv_sound_regulate_detail_sound_dynaudio"
                android:background="@drawable/icon_public_details_48"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@+id/tv_title_sound_regulate_sound_dynaudio"/>
            <TextView
                android:id="@+id/tv_progress_sound_dynaudio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/progress_value_text"/>
        </RelativeLayout>
        <com.byd.carsettings.ui.widget.AreaableSeekbar
            android:id="@+id/sbar_sound_regulate_sound_dynaudio"
            android:paddingTop="@dimen/dp_16"
            android:paddingBottom="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_23"
            android:layout_marginBottom="@dimen/dp_23"
            android:max="7"
            android:layout_marginStart="@dimen/dp_10"
            android:layout_marginEnd="@dimen/dp_10"
            style="@style/carsetting_seekbar_style"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/item_simulate_sound_of_wave_sound_dynaudio"
        android:background="@drawable/bg_frame_gray_a"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_88"
            android:paddingStart="@dimen/dp_24">
            <com.byd.base.view.BydSwitch
                android:id="@+id/switch_simulate_sound_of_wave_sound_dynaudio"
                style="@style/byd_switch"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_item_left_dilink_link"
                android:id="@+id/tv_title_simulate_sound_of_wave_sound_dynaudio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_simulate_sound_of_wave_dynaudio_sound"
                android:layout_marginStart="@dimen/dp_16"/>
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcv_sound_simulate_sound_of_wave_sound_dynaudio"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_8"
            android:minHeight="@dimen/dp_56"
            android:paddingStart="@dimen/dp_24"
            android:paddingEnd="@dimen/dp_24"/>
    </LinearLayout>
</LinearLayout>
