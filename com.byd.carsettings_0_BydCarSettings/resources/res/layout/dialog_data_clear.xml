<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingTop="@dimen/dp_18"
    android:paddingBottom="@dimen/dp_18"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/dp_48"
    android:paddingEnd="@dimen/dp_48">
    <CheckBox
        android:textSize="@dimen/sp_18"
        android:textColor="?attr/dialog_text_color_main"
        android:id="@+id/cb_total_fuel"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_4"
        android:layout_marginBottom="@dimen/dp_4"
        android:button="@drawable/checkbox_bg_selector"
        android:text="@string/newenergy_consumption_list_total_fuel_consumption"/>
    <CheckBox
        android:textSize="@dimen/sp_18"
        android:textColor="?attr/dialog_text_color_main"
        android:id="@+id/cb_external_charging"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_4"
        android:layout_marginBottom="@dimen/dp_4"
        android:button="@drawable/checkbox_bg_selector"
        android:text="@string/newenergy_consumption_list_charge_elec"/>
    <CheckBox
        android:textSize="@dimen/sp_18"
        android:textColor="?attr/dialog_text_color_main"
        android:id="@+id/cb_travel_time"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_4"
        android:layout_marginBottom="@dimen/dp_4"
        android:button="@drawable/checkbox_bg_selector"
        android:text="@string/newenergy_consumption_list_drive_time"/>
    <CheckBox
        android:textSize="@dimen/sp_18"
        android:textColor="?attr/dialog_text_color_main"
        android:id="@+id/cb_average_speed"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_4"
        android:layout_marginBottom="@dimen/dp_4"
        android:button="@drawable/checkbox_bg_selector"
        android:text="@string/consumption_average_speed"/>
</LinearLayout>
