<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/ll_dialog_masks"
    android:background="?attr/dialog_masks"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:alpha="0">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/ll_dialog_content"
        android:background="@drawable/common_dialog_background"
        android:layout_width="@dimen/dp_560"
        android:layout_height="wrap_content"
        android:alpha="0"
        android:scaleX="0.9"
        android:scaleY="0.9"
        android:elevation="@dimen/dp_3">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="@dimen/dp_72"
            android:layout_height="@dimen/dp_72"
            android:layout_marginTop="@dimen/dp_48"
            android:src="@drawable/icon_dark_carsetting_battery_72"/>
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="?attr/dialog_text_color_main"
            android:gravity="center"
            android:id="@+id/tv_message"
            android:paddingTop="@dimen/dp_32"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="@dimen/dp_290"
            android:minHeight="@dimen/dp_90"
            android:text="@string/newenergy_discharge_mps_low_power"
            android:layout_marginStart="@dimen/dp_48"
            android:layout_marginEnd="@dimen/dp_48"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_104">
            <Button
                android:textSize="@dimen/sp_18"
                android:textColor="@color/dialog_btn_text_white_selector"
                android:id="@+id/btn_ok"
                android:background="@drawable/selector_dialog_blue"
                android:layout_width="@dimen/dp_176"
                android:layout_height="@dimen/dp_48"
                android:text="@string/dialog_btn_ok"
                android:textAllCaps="false"
                android:layout_marginStart="@dimen/dp_24"
                android:layout_marginEnd="@dimen/dp_24"
                android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
