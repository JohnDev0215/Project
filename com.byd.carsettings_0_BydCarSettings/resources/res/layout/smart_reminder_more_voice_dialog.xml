<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="@dimen/dp_560"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/dp_80"
    android:layout_marginEnd="@dimen/dp_80"
    style="@style/vehicle_setting_dialog_background_container">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_71">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textStyle="bold"
            android:textColor="@color/carsetting_text_color_white"
            android:id="@+id/smart_reminder_dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/smart_reminder_close"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:src="@drawable/icon_set_public_close_48"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/dp_16"/>
    </RelativeLayout>
    <View
        android:id="@+id/smart_reminder_dialog_line"
        android:background="@color/ambient_dialog_line_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/smart_reminder_close"/>
    <ScrollView
        android:scrollbarThumbVertical="@drawable/smartreminder_scrollview_thumb"
        android:scrollbarTrackVertical="@drawable/smartreminder_scrollview_track"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/smart_reminder_dialog_line">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:background="@drawable/carlights_background"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_74"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/uphead_display_image">
                <com.byd.base.view.BydSwitch
                    android:id="@+id/aircondition_roll_voice_sw"
                    android:background="@drawable/img_switch_bg_normal"
                    android:checked="false"
                    android:thumb="@drawable/shape_circle_switch_thumb"
                    app:splitTrack="true"
                    app:switchMinWidth="@dimen/dp_56"
                    app:thumbTintMode="src_over"
                    app:track="@color/transparent_00"
                    app:trackTint="@color/transparent_00"
                    style="@style/carsetting_reminder_voice_style"/>
                <TextView
                    android:textSize="@dimen/sp_18"
                    android:textColor="@color/carsetting_text_color_white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/aircondition_roll_voice_sw"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/dp_16"/>
            </RelativeLayout>
            <RelativeLayout
                android:background="@drawable/carlights_background"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_74"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/uphead_display_image">
                <com.byd.base.view.BydSwitch
                    android:id="@+id/bluetooth_dial_voice_sw"
                    android:background="@drawable/img_switch_bg_normal"
                    android:checked="false"
                    android:thumb="@drawable/shape_circle_switch_thumb"
                    app:splitTrack="true"
                    app:switchMinWidth="@dimen/dp_56"
                    app:thumbTintMode="src_over"
                    app:track="@color/transparent_00"
                    app:trackTint="@color/transparent_00"
                    style="@style/carsetting_reminder_voice_style"/>
                <TextView
                    android:textSize="@dimen/sp_18"
                    android:textColor="@color/carsetting_text_color_white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/bluetooth_dial_voice_sw"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/dp_16"/>
            </RelativeLayout>
            <RelativeLayout
                android:background="@drawable/carlights_background"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_74"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/uphead_display_image">
                <com.byd.base.view.BydSwitch
                    android:id="@+id/screenshoot_voice_sw"
                    android:background="@drawable/img_switch_bg_normal"
                    android:checked="false"
                    android:thumb="@drawable/shape_circle_switch_thumb"
                    app:splitTrack="true"
                    app:switchMinWidth="@dimen/dp_56"
                    app:thumbTintMode="src_over"
                    app:track="@color/transparent_00"
                    app:trackTint="@color/transparent_00"
                    style="@style/carsetting_reminder_voice_style"/>
                <TextView
                    android:textSize="@dimen/sp_18"
                    android:textColor="@color/carsetting_text_color_white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/screenshoot_voice_sw"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/dp_16"/>
            </RelativeLayout>
            <RelativeLayout
                android:background="@drawable/carlights_background"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_74"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/uphead_display_image">
                <com.byd.base.view.BydSwitch
                    android:id="@+id/take_photo_voice_sw"
                    android:background="@drawable/img_switch_bg_normal"
                    android:checked="false"
                    android:thumb="@drawable/shape_circle_switch_thumb"
                    app:splitTrack="true"
                    app:switchMinWidth="@dimen/dp_56"
                    app:thumbTintMode="src_over"
                    app:track="@color/transparent_00"
                    app:trackTint="@color/transparent_00"
                    style="@style/carsetting_reminder_voice_style"/>
                <TextView
                    android:textSize="@dimen/sp_18"
                    android:textColor="@color/carsetting_text_color_white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/take_photo_voice_sw"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/dp_16"/>
            </RelativeLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
