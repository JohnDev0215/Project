<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="@dimen/dp_50"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:gravity="center"
        android:id="@+id/tv_config_ti"
        android:paddingRight="@dimen/dp_40"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_60"
        android:text="NFC Config"/>
    <RadioGroup
        android:orientation="horizontal"
        android:id="@+id/radio_nfc_confg"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_60"
        app:layout_constraintTop_toBottomOf="@+id/tv_config_ti">
        <RadioButton
            android:enabled="false"
            android:textColor="@color/black"
            android:id="@+id/radio_dan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="车外单模块"/>
        <RadioButton
            android:enabled="false"
            android:textColor="@color/black"
            android:id="@+id/radio_shuan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="50dp"
            android:text="车外车外双模块"/>
    </RadioGroup>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_query_owner_key_ti"
        android:paddingRight="@dimen/dp_40"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_60"
        android:layout_marginTop="@dimen/dp_10"
        android:text="查询车主钥匙"
        app:layout_constraintTop_toBottomOf="@+id/radio_nfc_confg"/>
    <RadioGroup
        android:orientation="horizontal"
        android:id="@+id/radio_query_owner_key_confg"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_60"
        app:layout_constraintTop_toBottomOf="@+id/tv_query_owner_key_ti">
        <RadioButton
            android:textColor="@color/black"
            android:id="@+id/radio_query_owner_key"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="查询车主钥匙"/>
        <RadioButton
            android:textColor="@color/black"
            android:id="@+id/radio_find_key"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="50dp"
            android:text="请求寻钥匙"/>
    </RadioGroup>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_offline_cmd_ti"
        android:paddingRight="@dimen/dp_40"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_60"
        android:layout_marginTop="@dimen/dp_10"
        android:text="离线操作命令"
        app:layout_constraintTop_toBottomOf="@+id/radio_query_owner_key_confg"/>
    <RadioGroup
        android:orientation="horizontal"
        android:id="@+id/radio_offline_confg"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_60"
        app:layout_constraintTop_toBottomOf="@+id/tv_offline_cmd_ti">
        <RadioButton
            android:textColor="@color/black"
            android:id="@+id/radio_start_paring"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="开卡，发起配对"/>
        <RadioButton
            android:textColor="@color/black"
            android:id="@+id/radio_cancel_paring"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="50dp"
            android:text="取消开卡配对"/>
    </RadioGroup>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_set_time_ti"
        android:paddingRight="@dimen/dp_40"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_60"
        android:layout_marginTop="@dimen/dp_10"
        android:text="设置NFC 钥匙解锁后允许的启动时间"
        app:layout_constraintTop_toBottomOf="@+id/radio_offline_confg"/>
    <RadioGroup
        android:orientation="horizontal"
        android:id="@+id/radio_set_time_confg"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_60"
        app:layout_constraintTop_toBottomOf="@+id/tv_set_time_ti">
        <RadioButton
            android:textColor="@color/black"
            android:id="@+id/radio_30_s"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="30S"/>
        <RadioButton
            android:textColor="@color/black"
            android:id="@+id/radio_10_min"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="50dp"
            android:text="10min"/>
    </RadioGroup>
    <Button
        android:gravity="center"
        android:id="@+id/btn_get_time_ti"
        android:paddingLeft="@dimen/dp_40"
        android:paddingRight="@dimen/dp_40"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_60"
        android:layout_marginTop="@dimen/dp_10"
        android:text="获取NFC钥匙解锁后允许的启动时间"
        app:layout_constraintTop_toBottomOf="@+id/radio_set_time_confg"/>
</androidx.constraintlayout.widget.ConstraintLayout>
