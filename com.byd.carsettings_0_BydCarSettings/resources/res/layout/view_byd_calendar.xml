<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/ev_calendar_view"
    android:background="@color/bg_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@+id/rl_title_def_ev_calendar"
        android:layout_width="match_parent"
        android:layout_height="40dp">
        <ImageButton
            android:id="@+id/ib_pre_year_ev_calendar"
            android:background="@color/bg_white"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@mipmap/ic_2_arrows_left"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_alignParentStart="true"/>
        <RelativeLayout
            android:gravity="center_vertical"
            android:layout_width="240dp"
            android:layout_height="match_parent"
            android:layout_centerInParent="true">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/bg_black"
                android:gravity="center"
                android:id="@+id/tv_pre_month_ev_calendar"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/pre_month"
                android:drawableStart="@mipmap/ic_arrow_left"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/bg_black"
                android:gravity="center"
                android:id="@+id/tv_title_ev_calendar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/bg_black"
                android:gravity="center"
                android:id="@+id/tv_next_month_ev_calendar"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/next_month"
                android:drawableEnd="@mipmap/ic_arrow_right"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <ImageButton
            android:id="@+id/ib_next_year_ev_calendar"
            android:background="@color/bg_white"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@mipmap/ic_2_arrows_right"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/fl_title_customize_ev_calendar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="40dp"/>
    <com.byd.mvp.ui.widget.calendarview.CalendarViewPager
        android:id="@+id/cdv_ev_calendar"
        android:layout_width="match_parent"
        android:layout_height="320dp"/>
</LinearLayout>
