<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="@dimen/dp_56"
    android:paddingBottom="@dimen/dp_60"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_return"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_60">
        <ImageView
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:layout_marginTop="@dimen/dp_12"
            android:src="@drawable/icon_public_leftarrow_48"
            android:layout_marginStart="@dimen/dp_28"/>
        <TextView
            android:textSize="@dimen/sp_20"
            android:textStyle="bold"
            android:textColor="?attr/text_color_main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:text="@string/newenergy_discharge_mps_setting"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="?attr/text_color_main"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_54"
        android:text="@string/newenergy_discharge_mps_setting"/>
    <com.byd.base.view.segmentedbutton.SegmentedButtonGroup
        android:layout_gravity="center_horizontal"
        android:id="@+id/switch_move_station"
        android:layout_width="@dimen/dp_300"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_26"
        app:sbg_animateSelector="fastOutSlowIn"
        app:sbg_animateSelectorDuration="1000"
        app:sbg_backgroundColor="?attr/carlights_segcontrolbutton_background"
        app:sbg_dividerPadding="@dimen/dp_10"
        app:sbg_dividerRadius="@dimen/dp_10"
        app:sbg_position="0"
        app:sbg_radius="@dimen/dp_24"
        app:sbg_ripple="true"
        app:sbg_selectorGradient_endColor="?attr/carsetting_text_color_blue"
        app:sbg_selectorGradient_startColor="?attr/carsetting_text_color_blue2">
        <com.byd.base.view.segmentedbutton.SegmentedButton
            android:paddingTop="@dimen/dp_3"
            android:paddingBottom="@dimen/dp_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:minHeight="@dimen/dp_40"
            android:layout_weight="1"
            app:sb_text="@string/newenergy_discharge_mps_open"
            app:sb_textColor="?attr/carlights_guest_color"
            app:sb_textColor_onSelection="?attr/byd_button_selected_text_color"
            app:sb_textSize="@dimen/sp_20"/>
        <com.byd.base.view.segmentedbutton.SegmentedButton
            android:paddingTop="@dimen/dp_3"
            android:paddingBottom="@dimen/dp_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:sb_text="@string/newenergy_discharge_mps_close"
            app:sb_textColor="?attr/carlights_guest_color"
            app:sb_textColor_onSelection="?attr/byd_button_selected_text_color"
            app:sb_textSize="@dimen/sp_20"/>
    </com.byd.base.view.segmentedbutton.SegmentedButtonGroup>
    <ViewStub
        android:id="@+id/rl_gun_status"
        android:layout="@layout/layout_discharge_gun_not_connect"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:id="@+id/rl_move_station"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ViewStub
            android:id="@+id/rl_remain_time"
            android:layout="@layout/layout_discharge_remain_time"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <RelativeLayout
            android:id="@+id/ll_car"
            android:background="@drawable/img_dark_carsetting_newenergy_charge_power_station_transmission"
            android:layout_width="@dimen/dp_624"
            android:layout_height="@dimen/dp_296"
            android:layout_marginTop="@dimen/dp_270"
            android:layout_centerHorizontal="true">
            <ImageView
                android:layout_width="@dimen/dp_272"
                android:layout_height="@dimen/dp_208"
                android:src="@drawable/img_dark_carsetting_newenergy_charge_power_station_transmission_car"/>
            <ImageView
                android:layout_width="@dimen/dp_272"
                android:layout_height="@dimen/dp_208"
                android:src="@drawable/img_dark_carsetting_newenergy_charge_power_station_transmission_car"
                android:layout_alignParentEnd="true"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="?attr/text_color_main_gray_85"
                android:id="@+id/tv_discharge_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_18"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="@dimen/sp_30"
                android:textStyle="bold"
                android:textColor="?attr/text_color_main"
                android:id="@+id/tv_discharge_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_53"
                android:text="--"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="?attr/text_color_main"
                android:id="@+id/tv_discharge_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_88"
                android:text="@string/newenergy_discharge_mps_value_unit"
                android:layout_centerHorizontal="true"/>
            <ImageView
                android:id="@+id/iv_transmission_state"
                android:background="@drawable/img_dark_carsetting_newenergy_charge_power_station_transmission_animation_off"
                android:layout_width="@dimen/dp_280"
                android:layout_height="@dimen/dp_240"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <ViewStub
            android:id="@+id/rl_switch_on"
            android:layout="@layout/layout_discharge_switch_on"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ViewStub
            android:id="@+id/rl_switch_off"
            android:layout="@layout/layout_discharge_switch_off"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ViewStub
            android:id="@+id/rl_seekbar"
            android:layout="@layout/layout_discharge_seekbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </RelativeLayout>
</LinearLayout>
