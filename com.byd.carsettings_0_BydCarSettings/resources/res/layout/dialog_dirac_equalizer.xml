<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_equalizer"
    android:layout_width="@dimen/dp_640"
    android:layout_height="@dimen/dp_544">
    <include
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_72"
        layout="@layout/dialog_common_title"/>
    <com.byd.carsettings.ui.widget.EqualizerView
        android:id="@+id/ev_dirac_equalizer"
        android:paddingTop="@dimen/dp_42"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="@dimen/dp_50"
        android:paddingEnd="@dimen/dp_50"
        app:key_arr_seek_bar="@array/non_brand_eq_freq_band_key_array"
        app:range_max_array="@array/non_brand_eq_freq_band_range_max_array"
        app:range_min_array="@array/non_brand_eq_freq_band_range_min_array"
        app:seekbar_id="@+id/sbar_view_equalizer_seekbar"
        app:seekbar_layout_item_id="@layout/view_equalizer_seekbar"
        app:seekbar_margin_end="@dimen/dp_24"
        app:seekbar_title_layout_id="@layout/view_sound_freq_band_title"
        app:title_arr_seek_bar="@array/freq_band_list"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcv_dirac_equalizer_effect"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_120"
        android:layout_marginTop="@dimen/dp_30"
        android:paddingStart="@dimen/dp_12"
        android:paddingEnd="@dimen/dp_12"/>
</LinearLayout>
