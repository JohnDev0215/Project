<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="?attr/text_color_main_gray_85"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_485"
        android:text="@string/newenergy_discharge_mps_close_switch_hint"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="@dimen/dp_72"
        android:layout_marginEnd="@dimen/dp_72"/>
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="?attr/text_color_main"
        android:id="@+id/tv_content"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_537"
        android:text="@string/newenergy_discharge_mps_open_switch_reminder_info"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="@dimen/dp_72"
        android:layout_marginEnd="@dimen/dp_72"/>
</RelativeLayout>
