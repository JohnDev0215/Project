<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:paddingStart="@dimen/dp_14">
        <RelativeLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_56"
            android:paddingStart="@dimen/dp_24">
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/text_color_main"
                android:id="@+id/tv_freq_band_hotspot_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/freq_band_hotspot"/>
        </RelativeLayout>
        <RadioGroup
            android:orientation="vertical"
            android:id="@+id/rg_freq_band_hotspot_right"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_14"
            android:paddingStart="@dimen/dp_24"
            android:paddingEnd="@dimen/dp_24">
            <com.byd.carsettings.ui.widget.TintRadioButton
                android:textSize="@dimen/sp_18"
                android:id="@+id/rbtn_g5_freq_band_hotspot_right"
                android:text="@string/g5_freq_band_hotspot_right"
                style="@style/rbtn_hotspot"/>
            <com.byd.carsettings.ui.widget.TintRadioButton
                android:id="@+id/rbtn_g2_4_freq_band_hotspot_right"
                android:layout_marginTop="@dimen/dp_16"
                android:text="@string/g2_4_freq_band_hotspot_right"
                style="@style/rbtn_hotspot"/>
        </RadioGroup>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="@dimen/dp_10">
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/text_color_main_gray"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_10"
            android:text="@string/hotspot_not_support_share"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_bottom_operation_freq_band_hotspot_right"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_104">
            <com.byd.carsettings.ui.widget.BydInvalidButton
                android:id="@+id/btn_ok_freq_band_hotspot_right"
                android:text="@string/dialog_btn_ok"
                style="@style/dialog_btn_ok_dilink_bt"/>
            <com.byd.carsettings.ui.widget.BydInvalidButton
                android:id="@+id/btn_cancel_freq_band_hotspot_right"
                android:text="@string/dialog_btn_cancel"
                android:layout_marginStart="@dimen/dp_40"
                style="@style/dialog_btn_cancel_dilink_bt"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
