<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_bg_dialog_dyna_sound_field"
    android:layout_width="@dimen/dp_560"
    android:layout_height="@dimen/dp_544">
    <include
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_72"
        layout="@layout/dialog_common_title"/>
    <RelativeLayout
        android:id="@+id/rl_parent_dyna_sound_field"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <com.byd.carsettings.ui.widget.UserRadioGroup
            android:id="@+id/rg_dyna_sound_field"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_52"
            android:layout_alignParentTop="true"
            android:layout_marginStart="@dimen/dp_40"
            android:layout_alignParentStart="true">
            <com.byd.mvp.ui.widget.TintRadioButton
                android:id="@+id/rbtn_all_dyna_sound_field"
                android:text="@string/all_sound_focus_dynaudio_sound"
                style="@style/rbtn_dyna_sound_charact"/>
            <com.byd.mvp.ui.widget.TintRadioButton
                android:id="@+id/rbtn_left_1st_dyna_sound_field"
                android:layout_marginTop="@dimen/dp_24"
                android:text="@string/left_1st_sound_focus_dynaudio_sound"
                style="@style/rbtn_dyna_sound_charact"/>
            <com.byd.mvp.ui.widget.TintRadioButton
                android:id="@+id/rbtn_right_1st_dyna_sound_field"
                android:layout_marginTop="@dimen/dp_24"
                android:text="@string/right_1st_sound_focus_dynaudio_sound"
                style="@style/rbtn_dyna_sound_charact"/>
            <com.byd.mvp.ui.widget.TintRadioButton
                android:id="@+id/rbtn_last_row_dyna_sound_field"
                android:layout_marginTop="@dimen/dp_24"
                android:text="@string/last_row_sound_focus_dynaudio_sound"
                style="@style/rbtn_dyna_sound_charact"/>
            <com.byd.mvp.ui.widget.TintRadioButton
                android:id="@+id/rbtn_surround_dyna_sound_field"
                android:layout_marginTop="@dimen/dp_24"
                android:text="@string/surround_sound_focus_dynaudio_sound"
                style="@style/rbtn_dyna_sound_charact"/>
            <com.byd.mvp.ui.widget.TintRadioButton
                android:id="@+id/rbtn_custom_dyna_sound_field"
                android:layout_marginTop="@dimen/dp_24"
                android:text="@string/custom_sound_focus_dynaudio_sound"
                style="@style/rbtn_dyna_sound_charact"/>
        </com.byd.carsettings.ui.widget.UserRadioGroup>
        <com.byd.mvp.ui.widget.TintImageView
            android:id="@+id/iv_focus_dyna_sound_field"
            android:layout_width="@dimen/dp_230"
            android:layout_height="@dimen/dp_380"
            android:layout_marginBottom="@dimen/dp_36"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="@dimen/dp_35"
            android:layout_alignParentEnd="true"/>
        <com.byd.carsettings.ui.widget.SoundFieldView
            android:id="@+id/sfv_dyna_sound_field"
            android:visibility="gone"
            android:layout_width="@dimen/dp_246"
            android:layout_height="@dimen/dp_324"
            android:layout_marginBottom="@dimen/dp_48"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="@dimen/dp_28"
            android:layout_alignParentEnd="true"
            app:axis_x_width="@dimen/dp_162"
            app:axis_y_height="@dimen/dp_240"
            app:drawable_axis_x="@drawable/img_axis_x_pa"
            app:drawable_axis_y="@drawable/img_axis_y_pa"
            app:drawable_bottom="@drawable/icon_arrow_down"
            app:drawable_height="@dimen/dp_42"
            app:drawable_left="@drawable/icon_arrow_left"
            app:drawable_right="@drawable/icon_arrow_right"
            app:drawable_top="@drawable/icon_arrow_up"
            app:drawable_width="@dimen/dp_42"
            app:field_padding_bottom="@dimen/dp_42"
            app:field_padding_left="@dimen/dp_42"
            app:field_padding_right="@dimen/dp_42"
            app:field_padding_top="@dimen/dp_42"
            app:thumb_height="@dimen/dp_24"
            app:thumb_seekbar="@drawable/seekbar_thumb_point"
            app:thumb_width="@dimen/dp_24"/>
    </RelativeLayout>
</LinearLayout>
