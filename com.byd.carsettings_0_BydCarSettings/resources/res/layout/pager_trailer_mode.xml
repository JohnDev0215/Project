<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/trailer_lottie_view"
        style="@style/vehicle_setting_car_image_port_style"/>
    <com.bydux.api.common.views.window.DampingScrollView
        android:id="@+id/nsw"
        android:layout_below="@+id/trailer_lottie_view"
        style="@style/vehicle_setting_module_damping_scrollView_port_style">
        <LinearLayout style="@style/vehicle_setting_module_damping_scrollView_child_port_style">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/trailer_setting_up_container"
                android:visibility="visible"
                style="@style/vehicle_setting_un_background_container">
                <RelativeLayout
                    android:id="@+id/trailer_light_signal"
                    android:visibility="visible"
                    style="@style/vehicle_setting_tv_sw_icon_container_style">
                    <ImageView
                        android:id="@+id/trailer_signal_iv"
                        android:layout_toRightOf="@+id/trailer_signal_tv"
                        style="@style/vehicle_setting_tv_sw_icon_icon_style"/>
                    <com.byd.base.view.BydFlexTextView
                        android:id="@+id/trailer_signal_tv"
                        android:text="@string/vehiclesettings_trailer_drive_mode_with_trailer_signal"
                        android:layout_toRightOf="@+id/trailer_signal_sw"
                        style="@style/vehicle_setting_tv_sw_icon_tv_port_style"/>
                    <com.byd.base.view.BydSwitch
                        android:id="@+id/trailer_signal_sw"
                        style="@style/vehicle_setting_tv_sw_icon_sw_style"/>
                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>
    </com.bydux.api.common.views.window.DampingScrollView>
</RelativeLayout>
