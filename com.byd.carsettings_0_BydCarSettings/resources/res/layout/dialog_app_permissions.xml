<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="@dimen/dp_560"
    android:layout_height="@dimen/dp_312"
    style="@style/vehicle_setting_dialog_background_container">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_71">
        <ImageView
            android:id="@+id/iv_back_dialog_app_permissions"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:src="@drawable/icon_public_leftarrow_48"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="@dimen/sp_20"
            android:textStyle="bold"
            android:textColor="@color/text_color_main_dilink_pagers"
            android:gravity="center"
            android:id="@+id/tv_title_dialog_app_permissions"
            android:layout_width="@dimen/dp_512"
            android:layout_height="@dimen/dp_29"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <View
        android:background="@color/bg_color_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/dp_24">
        <RelativeLayout
            android:layout_width="@dimen/dp_512"
            android:layout_height="@dimen/dp_88"
            android:layout_marginTop="@dimen/dp_24"
            android:paddingStart="@dimen/dp_24">
            <ImageView
                android:id="@+id/iv_icon_dialog_app_permissions"
                android:layout_width="@dimen/dp_56"
                android:layout_height="@dimen/dp_56"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_main_dilink_pagers"
                android:id="@+id/tv_app_name_dialog_app_permissions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/dp_16"
                android:layout_toEndOf="@+id/iv_icon_dialog_app_permissions"/>
        </RelativeLayout>
        <View
            android:background="@color/bg_color_line"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:layout_marginStart="@dimen/dp_24"
            android:layout_marginEnd="@dimen/dp_48"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_320">
            <androidx.recyclerview.widget.RecyclerView
                android:scrollbarSize="@dimen/dp_4"
                android:scrollbarThumbVertical="@drawable/bar_thumb"
                android:scrollbarTrackVertical="@drawable/bar_track"
                android:id="@+id/rcv_permission_list_app_permissions"
                android:scrollbars="vertical"
                android:fadingEdgeLength="@dimen/dp_20"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="always"
                android:requiresFadingEdge="vertical"
                android:paddingEnd="@dimen/dp_8"/>
            <include
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                layout="@layout/view_status_in_loading"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
