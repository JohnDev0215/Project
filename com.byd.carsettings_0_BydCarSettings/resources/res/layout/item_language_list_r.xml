<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_check_state_language_list"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_40"
        android:src="@drawable/radio_normal_regular"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/dp_48"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:id="@+id/tv_text_language_list"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_below="@+id/tv_text_language_list"
        android:layout_toStartOf="@+id/iv_check_state_language_list"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:id="@+id/tv_text_description_language_list"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_below="@+id/tv_text_language_list"
        android:layout_toStartOf="@+id/iv_check_state_language_list"/>
</RelativeLayout>
