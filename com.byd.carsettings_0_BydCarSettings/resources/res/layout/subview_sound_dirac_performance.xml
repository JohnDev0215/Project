<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_frame_gray_a"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_129"
            android:layout_marginStart="@dimen/dp_26">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_item_left_dilink_link"
                android:id="@+id/tv_manufactor_name_subview_sound_dirac_performance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_26"
                android:text="@string/manufactor_name_dirac_performance_sound"/>
            <com.byd.base.view.segmentedbutton.SegmentedButtonGroup
                android:layout_gravity="center_vertical"
                android:id="@+id/srg_sound_mode_subview_sound_dirac_performance"
                android:background="@drawable/shape_bg_gray_radio_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_26"
                style="@style/carsetting_segment_button_group_style">
                <com.byd.base.view.segmentedbutton.SegmentedButton
                    android:id="@+id/rbtn_mode_dynamic_subview_sound_dirac_performance"
                    app:sb_text="@string/mode_dynamic_dirac_performance_sound"
                    app:sb_textColor="@color/carlights_guest_color"
                    app:sb_textColor_onSelection="@color/white"
                    app:sb_textSize="@dimen/sp_20"
                    style="@style/sbtn_w128_display_pager"/>
                <com.byd.base.view.segmentedbutton.SegmentedButton
                    android:id="@+id/rbtn_mode_nicam_subview_sound_dirac_performance"
                    app:sb_text="@string/mode_nicam_dirac_performance_sound"
                    app:sb_textColor="@color/carlights_guest_color"
                    app:sb_textColor_onSelection="@color/white"
                    app:sb_textSize="@dimen/sp_20"
                    style="@style/sbtn_w128_display_pager"/>
                <com.byd.base.view.segmentedbutton.SegmentedButton
                    android:id="@+id/rbtn_close_subview_sound_dirac_performance"
                    app:sb_text="@string/close_dirac_performance_sound"
                    app:sb_textColor="@color/carlights_guest_color"
                    app:sb_textColor_onSelection="@color/white"
                    app:sb_textSize="@dimen/sp_20"
                    style="@style/sbtn_w128_display_pager"/>
            </com.byd.base.view.segmentedbutton.SegmentedButtonGroup>
        </LinearLayout>
        <include
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_88"
            android:layout_marginTop="@dimen/dp_10"
            layout="@layout/subview_dirac_loudness_settings"/>
    </LinearLayout>
    <include
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_176"
        android:layout_marginTop="@dimen/dp_16"
        layout="@layout/subview_dirac_equalizer_settings"/>
</LinearLayout>
