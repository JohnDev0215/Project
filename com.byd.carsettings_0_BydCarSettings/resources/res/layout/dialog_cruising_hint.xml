<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="150dp">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_30"
        android:paddingStart="@dimen/dp_48"
        android:paddingEnd="@dimen/dp_48">
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="?attr/dialog_text_color_main"
            android:id="@+id/tv_nedc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/newenergy_ev_mileage_display_standard_nedc_standard_title"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="?attr/dialog_text_color_main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/newenergy_ev_mileage_display_standard_nedc_content"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="?attr/dialog_text_color_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:gravity="top"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_16"
        android:paddingStart="@dimen/dp_48"
        android:paddingEnd="@dimen/dp_48">
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="?attr/dialog_text_color_main"
            android:id="@+id/tv_cltc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/newenergy_ev_mileage_display_standard_cltc_standard_title"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="?attr/dialog_text_color_main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/newenergy_ev_mileage_display_standard_cltc_content"/>
    </LinearLayout>
</LinearLayout>
