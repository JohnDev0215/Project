<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="@dimen/dp_560"
    android:layout_height="@dimen/dp_544"
    android:splitMotionEvents="false"
    android:windowEnableSplitTouch="false"
    style="@style/vehicle_setting_dialog_background_container">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_71">
        <ImageView
            android:id="@+id/iv_back_dialog_app_storage"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:src="@drawable/icon_public_leftarrow_48"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="@dimen/sp_20"
            android:textStyle="bold"
            android:textColor="@color/text_color_main_dilink_pagers"
            android:gravity="center"
            android:id="@+id/tv_title_dialog_app_storage"
            android:layout_width="@dimen/dp_512"
            android:layout_height="@dimen/dp_29"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <View
        android:background="@color/bg_color_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_74"
        android:layout_marginTop="@dimen/dp_62"
        android:paddingStart="@dimen/dp_16"
        android:layout_marginStart="@dimen/dp_32"
        android:layout_marginEnd="@dimen/dp_32">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/text_color_item_right_dilink_link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/total_storage_app_details"/>
        <TextView
            android:textSize="@dimen/sp_30"
            android:textColor="@color/text_color_progress"
            android:id="@+id/tv_total_storage_dialog_app_storage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_4"/>
    </LinearLayout>
    <View
        android:background="@color/bg_color_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_marginStart="@dimen/dp_48"
        android:layout_marginEnd="@dimen/dp_48"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="@dimen/dp_512"
        android:layout_height="@dimen/dp_74"
        android:paddingStart="@dimen/dp_24">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/text_color_item_right_dilink_link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dilink_application"/>
        <TextView
            android:textSize="@dimen/sp_22"
            android:textColor="@color/text_color_main"
            android:id="@+id/tv_code_storage_dialog_app_storage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_4"/>
    </LinearLayout>
    <View
        android:background="@color/bg_color_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_marginStart="@dimen/dp_48"
        android:layout_marginEnd="@dimen/dp_48"/>
    <RelativeLayout
        android:layout_width="@dimen/dp_512"
        android:layout_height="@dimen/dp_74"
        android:paddingStart="@dimen/dp_24">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_item_right_dilink_link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/data_storage_app_details"/>
            <TextView
                android:textSize="@dimen/sp_22"
                android:textColor="@color/text_color_main"
                android:id="@+id/tv_data_storage_dialog_app_storage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_4"/>
        </LinearLayout>
        <TextView
            android:id="@+id/btn_clear_app_data_dialog_app_storage"
            android:text="@string/clear_data_storage_app_details"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp_24"
            android:layout_alignParentEnd="true"
            android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"
            style="@style/dialog_btn_clear_dilink"/>
    </RelativeLayout>
    <View
        android:background="@color/bg_color_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_marginStart="@dimen/dp_48"
        android:layout_marginEnd="@dimen/dp_48"/>
    <RelativeLayout
        android:layout_width="@dimen/dp_512"
        android:layout_height="@dimen/dp_74"
        android:layout_marginBottom="@dimen/dp_141"
        android:paddingStart="@dimen/dp_24">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_item_right_dilink_link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cache_storage_app_details"/>
            <TextView
                android:textSize="@dimen/sp_22"
                android:textColor="@color/text_color_main"
                android:id="@+id/tv_cache_storage_dialog_app_storage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_4"/>
        </LinearLayout>
        <TextView
            android:id="@+id/btn_clear_app_cache_dialog_app_storage"
            android:text="@string/clear_cache_storage_app_details"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp_24"
            android:layout_alignParentEnd="true"
            android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"
            style="@style/dialog_btn_clear_dilink"/>
    </RelativeLayout>
</LinearLayout>
