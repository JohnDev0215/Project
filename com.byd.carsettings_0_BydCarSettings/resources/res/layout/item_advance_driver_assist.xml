<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_frame_gray_a"
    android:paddingTop="@dimen/dp_24"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_200"
    android:paddingStart="@dimen/dp_24">
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="@color/dialog_text_color_main"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_assist_title"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_48"
        android:maxWidth="@dimen/dp_220"
        android:text="@string/dipilot_highway_navigation_title"
        android:maxLines="1"
        android:lines="1"/>
    <ImageView
        android:id="@+id/iv_assist_notice"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        android:src="@drawable/icon_light_public_details_48"
        app:layout_constraintBottom_toBottomOf="@+id/tv_assist_title"
        app:layout_constraintLeft_toRightOf="@+id/tv_assist_title"
        app:layout_constraintTop_toTopOf="@+id/tv_assist_title"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/dialog_text_color_tips"
        android:ellipsize="end"
        android:id="@+id/tv_assist_des"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dipilot_highway_navigation_desc"
        android:lines="1"
        android:singleLine="true"
        app:layout_constraintTop_toBottomOf="@+id/tv_assist_title"/>
    <com.byd.base.view.BydSwitch
        android:id="@+id/switch_recognition_intelligent_speed_control"
        android:background="@drawable/img_switch_bg_normal"
        android:layout_width="@dimen/dp_64"
        android:layout_height="@dimen/dp_48"
        android:checked="false"
        android:thumb="@drawable/shape_circle_switch_thumb"
        android:paddingEnd="@dimen/dp_3"
        app:layout_constraintTop_toBottomOf="@+id/tv_assist_des"
        app:splitTrack="true"
        app:switchMinWidth="@dimen/dp_56"
        app:thumbTintMode="src_over"
        app:track="@color/transparent_00"
        app:trackTint="@color/transparent_00"/>
    <ImageView
        android:layout_width="@dimen/dp_320"
        android:layout_height="@dimen/dp_108"
        android:src="@drawable/img_light_carsetting_city"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
