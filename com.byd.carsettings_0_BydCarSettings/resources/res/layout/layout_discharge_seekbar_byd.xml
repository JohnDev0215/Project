<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rl_seekbar"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="?attr/text_color_main"
        android:id="@+id/tv_limit_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_522"
        android:text="@string/newenergy_discharge_mps_limit"
        android:layout_marginStart="@dimen/dp_40"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="?attr/text_color_main_gray_85"
        android:gravity="center"
        android:id="@+id/tv_reminder_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_672"
        android:text="@string/newenergy_discharge_mps_reminder_info"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="@dimen/dp_40"
        android:layout_marginEnd="@dimen/dp_40"/>
    <com.byd.carsettings.ui.view.seekbar.SubLevelSeekbar
        android:id="@+id/subLevelSeekbar"
        android:layout_width="@dimen/dp_678"
        android:layout_height="@dimen/dp_68"
        android:layout_marginTop="@dimen/dp_554"
        android:layout_marginStart="@dimen/dp_11"
        android:layout_marginEnd="@dimen/dp_31"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="?attr/text_color_main_gray"
        android:gravity="center"
        android:id="@+id/tv_seekbar_start"
        android:layout_width="@dimen/dp_33"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_622"
        android:text="0%"
        android:layout_marginStart="@dimen/dp_63"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="?attr/text_color_main_gray"
        android:gravity="center"
        android:id="@+id/tv_seekbar_end"
        android:layout_width="@dimen/dp_46"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_622"
        android:text="100%"
        android:layout_marginEnd="@dimen/dp_74"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
