<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_frame_gray_a"
    android:paddingTop="@dimen/dp_24"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_200"
    android:paddingStart="@dimen/dp_24">
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="@color/dialog_text_color_main"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_assist_title"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_48"
        android:maxWidth="@dimen/dp_220"
        android:text="@string/dipilot_highway_navigation_title"
        android:maxLines="1"
        android:lines="1"/>
    <ImageView
        android:id="@+id/iv_assist_notice"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        android:src="@drawable/icon_light_public_details_48"
        app:layout_constraintBottom_toBottomOf="@+id/tv_assist_title"
        app:layout_constraintLeft_toRightOf="@+id/tv_assist_title"
        app:layout_constraintTop_toTopOf="@+id/tv_assist_title"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="@color/dialog_text_color_tips"
        android:id="@+id/tv_assist_select"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dipilot_departure_warning"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="@+id/iv_assist_more"
        app:layout_constraintEnd_toStartOf="@+id/iv_assist_more"
        app:layout_constraintTop_toTopOf="@+id/iv_assist_more"/>
    <ImageView
        android:id="@+id/iv_assist_more"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        android:src="@drawable/icon_public_rightarrow_48"
        app:layout_constraintBottom_toBottomOf="@+id/iv_assist_notice"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_assist_notice"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/text_color_item_left_dilink_link"
        android:ellipsize="end"
        android:id="@+id/tv_assist_des"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dipilot_tips_high_speed_intelligent_assistance"
        android:lines="1"
        android:singleLine="true"
        app:layout_constraintTop_toBottomOf="@+id/tv_assist_title"/>
    <ImageView
        android:layout_width="@dimen/dp_320"
        android:layout_height="@dimen/dp_108"
        android:src="@drawable/img_light_carsetting_city"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
