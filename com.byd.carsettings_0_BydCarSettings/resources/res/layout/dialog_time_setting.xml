<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_bg_dialo_sound_focus"
    android:layout_width="@dimen/dp_560"
    android:layout_height="@dimen/dp_465"
    style="@style/vehicle_setting_dialog_background_container">
    <include
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_72"
        layout="@layout/dialog_common_title"/>
    <com.byd.carsettings.ui.widget.BydTimePicker
        android:id="@+id/tp_dialog_time_setting"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:divider_color="@color/text_color_btn_blue"
        app:divider_height="@dimen/dp_1"
        app:selected_text_color="@color/text_color_btn_blue"
        app:selected_text_size="@dimen/sp_24"
        app:wheel_text_color="@color/text_color_main_gray"
        app:wheel_text_size="@dimen/sp_20"/>
    <include
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_104"
        layout="@layout/dialog_bottom_2btn_left_hight_light"/>
</LinearLayout>
