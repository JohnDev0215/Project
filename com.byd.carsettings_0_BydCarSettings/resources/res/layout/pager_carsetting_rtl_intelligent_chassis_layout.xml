<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">
    <ImageView
        android:id="@+id/intelligent_chassis_image"
        style="@style/vehicle_setting_rtl_car_image_port_style"/>
    <com.bydux.api.common.views.window.DampingScrollView
        android:id="@+id/nsw"
        android:layout_below="@+id/intelligent_chassis_image"
        style="@style/vehicle_setting_rtl_module_damping_scrollView_port_style">
        <LinearLayout style="@style/vehicle_setting_rtl_module_damping_scrollView_child_port_style">
            <RelativeLayout
                android:id="@+id/comfortable_selfup_out_container"
                android:paddingBottom="@dimen/dp_26"
                android:layout_marginBottom="@dimen/dp_16"
                style="@style/vehicle_setting_background_container">
                <RelativeLayout
                    android:id="@+id/comfortable_selfup_container"
                    style="@style/vehicle_setting_tv_seg_container_un_single_style">
                    <TextView
                        android:id="@+id/comfortable_selfup_tv"
                        android:text="@string/vehiclesettings_dynamic_suspension"
                        style="@style/vehicle_setting_rtl_tv_seg_tv_style"/>
                    <com.byd.base.view.segmentedbutton.SegmentedButtonGroup
                        android:id="@+id/comfortable_selfup_segmentedbtn"
                        android:layout_below="@+id/comfortable_selfup_tv"
                        style="@style/vehicle_setting_rtl_tv_seg_seg_style">
                        <com.byd.base.view.segmentedbutton.SegmentedButton
                            app:sb_text="@string/vehiclesettings_comfort"
                            style="@style/vehicle_setting_rtl_tv_seg_seg_btn_style"/>
                        <com.byd.base.view.segmentedbutton.SegmentedButton
                            app:sb_text="@string/vehiclesettings_sport"
                            style="@style/vehicle_setting_rtl_tv_seg_seg_btn_style"/>
                    </com.byd.base.view.segmentedbutton.SegmentedButtonGroup>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/intelligent_chassis_speeddown_container"
                    android:layout_below="@+id/comfortable_selfup_container"
                    style="@style/vehicle_setting_tv_seg_container_un_single_style">
                    <RelativeLayout
                        android:id="@+id/intelligent_chassis_speeddown_tv_container"
                        style="@style/vehicle_setting_tv_seg_icon_tv_container">
                        <com.byd.base.view.BydFlexTextView
                            android:id="@+id/intelligent_chassis_speeddown_tv"
                            android:text="@string/vehiclesettings_comfortable_control"
                            android:layout_marginStart="@dimen/dp_0"
                            style="@style/vehicle_setting_rtl_tv_seg_tv_port_style"/>
                        <ImageView
                            android:id="@+id/intelligent_chassis_speeddown_icon"
                            android:layout_toStartOf="@+id/intelligent_chassis_speeddown_tv"
                            style="@style/vehicle_setting_rtl_tv_sw_icon_icon_style"/>
                    </RelativeLayout>
                    <com.byd.base.view.segmentedbutton.SegmentedButtonGroup
                        android:id="@+id/intelligent_chassis_speeddown_segmentedbtn"
                        android:layout_below="@+id/intelligent_chassis_speeddown_tv_container"
                        style="@style/vehicle_setting_rtl_tv_seg_seg_style_icon_up">
                        <com.byd.base.view.segmentedbutton.SegmentedButton
                            app:sb_text="@string/vehiclesettings_dynamic_suspension_mode_strong"
                            style="@style/vehicle_setting_rtl_tv_seg_seg_btn_style"/>
                        <com.byd.base.view.segmentedbutton.SegmentedButton
                            app:sb_text="@string/vehiclesettings_dynamic_suspension_mode_middle"
                            style="@style/vehicle_setting_rtl_tv_seg_seg_btn_style"/>
                        <com.byd.base.view.segmentedbutton.SegmentedButton
                            app:sb_text="@string/vehiclesettings_dynamic_suspension_mode_weak"
                            style="@style/vehicle_setting_rtl_tv_seg_seg_btn_style"/>
                    </com.byd.base.view.segmentedbutton.SegmentedButtonGroup>
                </RelativeLayout>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/comfortable_turn_help_container"
                style="@style/vehicle_setting_rtl_tv_seg_container_style">
                <TextView
                    android:id="@+id/comfortable_turn_help_tv"
                    android:text="@string/vehiclesettings_steering_assist"
                    style="@style/vehicle_setting_rtl_tv_seg_tv_style"/>
                <com.byd.base.view.segmentedbutton.SegmentedButtonGroup
                    android:id="@+id/comfortable_turn_help"
                    android:layout_below="@+id/comfortable_turn_help_tv"
                    style="@style/vehicle_setting_rtl_tv_seg_seg_style">
                    <com.byd.base.view.segmentedbutton.SegmentedButton
                        app:sb_text="@string/vehiclesettings_comfort"
                        style="@style/carsetting_segment_button"/>
                    <com.byd.base.view.segmentedbutton.SegmentedButton
                        app:sb_text="@string/vehiclesettings_sport"
                        style="@style/carsetting_segment_button"/>
                </com.byd.base.view.segmentedbutton.SegmentedButtonGroup>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/comfortable_stop_container"
                style="@style/vehicle_setting_rtl_tv_seg_container_style">
                <TextView
                    android:id="@+id/comfortable_stop_tv"
                    android:text="@string/vehiclesettings_brake_assist_mode"
                    style="@style/vehicle_setting_rtl_tv_seg_tv_style"/>
                <com.byd.base.view.segmentedbutton.SegmentedButtonGroup
                    android:id="@+id/comfortable_stop_segmentedButtonGroup"
                    android:layout_below="@+id/comfortable_stop_tv"
                    style="@style/vehicle_setting_rtl_tv_seg_seg_style">
                    <com.byd.base.view.segmentedbutton.SegmentedButton
                        app:sb_text="@string/vehiclesettings_comfort"
                        style="@style/vehicle_setting_rtl_tv_seg_seg_btn_style"/>
                    <com.byd.base.view.segmentedbutton.SegmentedButton
                        app:sb_text="@string/vehiclesettings_sport"
                        style="@style/vehicle_setting_rtl_tv_seg_seg_btn_style"/>
                </com.byd.base.view.segmentedbutton.SegmentedButtonGroup>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/comfortable_stop_car_sw_container"
                style="@style/vehicle_setting_rtl_tv_sw_icon_container_style">
                <com.byd.base.view.BydFlexTextView
                    android:id="@+id/intelligent_comfortable_stop_tv"
                    android:text="@string/vehiclesettings_comfortable_parking"
                    style="@style/vehicle_setting_rtl_tv_sw_icon_tv_port_style"/>
                <com.byd.base.view.BydSwitch
                    android:id="@+id/comfortable_stop_car_sw"
                    style="@style/vehicle_setting_rtl_tv_sw_icon_sw_style"/>
                <ImageView
                    android:id="@+id/intelligent_comfortable_stop_icon"
                    android:layout_toStartOf="@+id/intelligent_comfortable_stop_tv"
                    style="@style/vehicle_setting_rtl_tv_sw_icon_icon_style"/>
            </RelativeLayout>
        </LinearLayout>
    </com.bydux.api.common.views.window.DampingScrollView>
</RelativeLayout>
