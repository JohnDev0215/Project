        android:layout_marginStart="@dimen/dp_39"
        android:layout_marginEnd="@dimen/dp_39"/>
    <com.byd.carsettings.ui.widget.MaxHeightRecyclerView
        android:id="@+id/rv_oil_reset"
        android:layout_width="@dimen/dp_542"
