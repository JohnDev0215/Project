<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_vertical"
    android:layout_width="@dimen/dp_560"
    android:layout_height="@dimen/dp_400"
    android:layout_marginStart="@dimen/dp_80"
    android:layout_marginEnd="@dimen/dp_80"
    style="@style/vehicle_setting_dialog_background_container">
    <RelativeLayout
        android:id="@+id/carsetting_dialog_head"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_72"
        android:layout_alignParentTop="true">
        <TextView
            android:id="@+id/carsetting_dialog_title"
            android:text="@string/vehiclesettings_compression_refrigerator_work_delay_power_off_set"
            style="@style/byd_vehicle_setting_dialog_title_style"/>
        <View
            android:id="@+id/carsetting_dialog_line"
            android:background="@color/ambient_dialog_line_bg"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/carsetting_dialog_bottom"
        android:layout_below="@+id/carsetting_dialog_head">
        <com.byd.carsettings.ui.view.pickview.BydPickerView
            android:id="@+id/instrument_wheelView_h"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:textDirection="locale"
            android:layout_marginStart="@dimen/dp_48"
            android:layout_marginEnd="@dimen/dp_48"
            app:isCyclic="true"
            app:itemCounts="3"
            app:itemHeight="@dimen/dp_64"
            app:lineStartColor="@color/dialog_divider_common"
            app:selectedColor="@color/instrument_speed_remind_selected"
            app:textSize="@dimen/sp_24"
            app:unSelectedColor="@color/instrument_speed_remind_unSelectedColor"
            app:unitText="@string/vehiclesettings_compression_refrigerator_work_delay_power_off_set_unit"
            app:unitTextColor="@color/instrument_speed_remind_unitTextColor"/>
    </RelativeLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/carsetting_dialog_bottom"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_104"
        android:layout_alignParentBottom="true">
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <Button
                android:textSize="@dimen/sp_18"
                android:textColor="@color/white"
                android:id="@+id/carsetting_dialog_btn_confirm"
                android:background="@drawable/selector_dialog_blue"
                android:layout_width="@dimen/dp_176"
                android:layout_height="@dimen/dp_48"
                android:layout_marginTop="@dimen/dp_28"
                android:layout_marginBottom="@dimen/dp_28"
                android:text="@string/vehiclesettings_button_confirm"
                android:textAllCaps="false"
                android:textDirection="locale"
                android:layout_marginStart="@dimen/dp_48"
                android:layout_toEndOf="@+id/carsetting_dialog_btn_cancel"
                android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"/>
            <Button
                android:textSize="@dimen/sp_18"
                android:textColor="@color/ambient_btn_cancel"
                android:id="@+id/carsetting_dialog_btn_cancel"
                android:background="@drawable/selector_dialog_white"
                android:layout_width="@dimen/dp_176"
                android:layout_height="@dimen/dp_48"
                android:layout_marginTop="@dimen/dp_28"
                android:layout_marginBottom="@dimen/dp_28"
                android:text="@string/vehiclesettings_button_cancel"
                android:textAllCaps="false"
                android:textDirection="locale"
                android:stateListAnimator="@drawable/anim_btn_scale"/>
        </RelativeLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>
