<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="@dimen/dp_612"
    android:layout_height="@dimen/dp_560"
    style="@style/vehicle_setting_dialog_background_container">
    <FrameLayout
        android:id="@+id/fl_title_hotspot"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_71"/>
    <View
        android:id="@+id/v_title_line_hotspot"
        android:background="@color/bg_color_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_hotspot_state_open_hotspot"
            android:paddingBottom="@dimen/dp_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:id="@+id/rl_left_hotspot"
                android:background="@drawable/bg_dialog_bt_left_portrait"
                android:layout_width="@dimen/dp_262"
                android:layout_height="match_parent">
                <include layout="@layout/subview_hotspot_left"/>
            </RelativeLayout>
            <FrameLayout
                android:id="@+id/fl_right_hotspot"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_hotspot_state_close_hotspot"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <ImageView
                android:background="@drawable/img_empty_catting_hotspot_none"
                android:layout_width="@dimen/dp_312"
                android:layout_height="@dimen/dp_208"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/text_color_main_gray"
                android:gravity="center"
                android:id="@+id/tv_hotspot_state_close_hotspot"
                android:layout_width="@dimen/dp_272"
                android:layout_height="@dimen/dp_24"
                android:text="@string/state_close_hotspot"/>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
