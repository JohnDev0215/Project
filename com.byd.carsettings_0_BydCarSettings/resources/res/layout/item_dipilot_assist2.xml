<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_assist_container"
    android:background="@drawable/bg_frame_gray_a"
    android:paddingTop="@dimen/dp_17"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_200"
    android:paddingStart="@dimen/dp_24">
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="@color/dialog_text_color_main"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_assist_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="@dimen/dp_220"
        android:text="@string/dipilot_highway_navigation_title"
        android:maxLines="1"
        android:lines="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_assist_notice"
        app:layout_constraintBottom_toBottomOf="@+id/tv_assist_title"
        app:layout_constraintStart_toEndOf="@+id/tv_assist_title"
        app:layout_constraintTop_toTopOf="@+id/tv_assist_title"
        style="@style/dipilot_notice_style"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/iv_assist"
        android:layout_width="@dimen/dp_284"
        android:layout_height="@dimen/dp_110"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
