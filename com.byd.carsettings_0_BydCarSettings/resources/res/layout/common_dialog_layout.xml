<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/ll_dialog_masks"
    android:background="?attr/dialog_masks"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:alpha="0">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/ll_dialog_content"
        android:background="@drawable/common_dialog_background"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="@dimen/dp_560"
        android:layout_height="wrap_content"
        android:alpha="0"
        android:scaleX="0.9"
        android:scaleY="0.9"
        android:elevation="@dimen/dp_3">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textStyle="bold"
            android:textColor="?attr/dialog_title"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_69"
            android:layout_marginTop="@dimen/dp_2"
            android:text="@string/dipilot_title_dialog_hint"
            android:maxLines="2"
            android:layout_marginStart="@dimen/dp_24"
            android:layout_marginEnd="@dimen/dp_24"/>
        <View
            android:background="?attr/dialog_divider_common"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"/>
        <com.bydux.api.common.views.window.DampingScrollView
            android:scrollbarSize="@dimen/dp_4"
            android:scrollbarThumbVertical="@drawable/bar_thumb"
            android:scrollbarTrackVertical="@drawable/bar_track"
            android:id="@+id/dampingScrollView_dialog"
            android:visibility="gone"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:requiresFadingEdge="vertical"
            android:paddingStart="@dimen/dp_9"
            android:paddingEnd="@dimen/dp_9"
            app:maxHeight="@dimen/dp_368">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/dp_136"/>
        </com.bydux.api.common.views.window.DampingScrollView>
        <com.bydux.api.common.views.window.DampingScrollView
            android:scrollbarSize="@dimen/dp_4"
            android:scrollbarThumbVertical="@drawable/bar_thumb"
            android:scrollbarTrackVertical="@drawable/bar_track"
            android:scrollbarStyle="outsideInset"
            android:id="@+id/dampingScrollView_dialog_text"
            android:visibility="visible"
            android:scrollbars="vertical"
            android:fadingEdge="vertical"
            android:fadingEdgeLength="@dimen/dp_24"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_24"
            android:requiresFadingEdge="vertical"
            android:paddingStart="@dimen/dp_39"
            android:paddingEnd="@dimen/dp_35"
            android:layout_marginStart="@dimen/dp_9"
            android:layout_marginEnd="@dimen/dp_9"
            app:maxHeight="@dimen/dp_270">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/dp_112">
                <TextView
                    android:textSize="@dimen/sp_20"
                    android:textColor="?attr/dialog_text_color_main"
                    android:id="@+id/tv_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </com.bydux.api.common.views.window.DampingScrollView>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_foot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_104"
            android:layoutDirection="ltr">
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/dialog_btn_text_white_selector"
                android:gravity="center"
                android:id="@+id/btn_ok"
                android:background="@drawable/selector_dialog_blue"
                android:layout_width="@dimen/dp_176"
                android:layout_height="@dimen/dp_48"
                android:text="@string/dialog_btn_ok"
                android:textAllCaps="false"
                android:layout_marginStart="@dimen/dp_24"
                android:layout_marginEnd="@dimen/dp_24"
                android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/dialog_btn_text_gray_selector"
                android:gravity="center"
                android:id="@+id/btn_cancel"
                android:background="@drawable/selector_dialog_white"
                android:layout_width="@dimen/dp_176"
                android:layout_height="@dimen/dp_48"
                android:text="@string/dialog_btn_cancel"
                android:textAllCaps="false"
                android:layout_marginStart="@dimen/dp_24"
                android:layout_marginEnd="@dimen/dp_24"
                android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
