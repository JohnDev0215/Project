<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_74"
    android:minHeight="@dimen/dp_74">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/text_color_main_dilink_pagers"
            android:id="@+id/tv_app_name_copyright_notice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/dp_16"/>
        <ImageView
            android:id="@+id/iv_copyright_goto"
            android:background="@drawable/icon_public_rightarrow_48"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp_22"
            android:layout_alignParentEnd="true"/>
        <View
            android:id="@+id/v_line_app_list"
            android:background="@color/bg_color_line"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_40"/>
    </RelativeLayout>
</LinearLayout>
