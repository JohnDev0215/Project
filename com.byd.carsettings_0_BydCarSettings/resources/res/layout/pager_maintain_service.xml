<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="@dimen/dp_556"
        android:layout_height="@dimen/dp_468"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="@dimen/sp_18"
            android:gravity="start|center_vertical"
            android:id="@+id/tv_oil_result"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_35"
            android:layout_marginStart="@dimen/dp_252"/>
        <ImageView
            android:id="@+id/iv_result"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:layout_marginTop="@dimen/dp_26"
            android:layout_marginStart="@dimen/dp_204"/>
        <ImageView
            android:id="@+id/iv_oil_result"
            android:layout_width="@dimen/dp_556"
            android:layout_height="@dimen/dp_468"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <com.bydux.api.common.views.window.DampingScrollView
        android:id="@+id/scrollView"
        android:scrollbars="none"
        android:fadingEdge="vertical"
        android:fadingEdgeLength="@dimen/dp_24"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dp_468"
        android:requiresFadingEdge="vertical">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="@dimen/dp_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_40"
            android:layout_marginEnd="@dimen/dp_40">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_oil"
                android:background="@drawable/carlights_background"
                android:paddingTop="@dimen/dp_20"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_16">
                <RelativeLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dp_22"
                    android:layout_marginStart="@dimen/dp_24">
                    <TextView
                        android:textSize="@dimen/sp_20"
                        android:textColor="?attr/text_color_main"
                        android:id="@+id/tv_oil_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="@dimen/dp_330"
                        android:text="@string/carhealthy_oil_life"
                        android:layout_centerVertical="true"/>
                    <ImageView
                        android:id="@+id/iv_oil_life"
                        android:layout_width="@dimen/dp_48"
                        android:layout_height="@dimen/dp_48"
                        android:src="@drawable/icon_light_public_details_48"
                        android:layout_centerVertical="true"
                        android:layout_toEndOf="@+id/tv_oil_title"/>
                    <TextView
                        android:textSize="@dimen/sp_18"
                        android:textColor="@color/dialog_btn_text_detect_selector"
                        android:gravity="center"
                        android:id="@+id/tv_oil_reset"
                        android:background="@drawable/selector_dialog_white"
                        android:paddingTop="@dimen/dp_3"
                        android:paddingBottom="@dimen/dp_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="@dimen/dp_220"
                        android:minWidth="@dimen/dp_128"
                        android:minHeight="@dimen/dp_40"
                        android:text="@string/carhealthy_oil_reset"
                        android:layout_centerVertical="true"
                        android:textAllCaps="false"
                        android:paddingStart="@dimen/dp_24"
                        android:paddingEnd="@dimen/dp_24"
                        android:layout_marginEnd="@dimen/dp_24"
                        android:layout_alignParentEnd="true"
                        android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"/>
                </RelativeLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_oil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_24"
                    android:layout_marginEnd="@dimen/dp_24"/>
                <TextView
                    android:textSize="@dimen/sp_18"
                    android:textColor="@color/btn_only_selected"
                    android:gravity="center"
                    android:id="@+id/tv_oil_record"
                    android:background="@drawable/vehicle_selector_dialog_blue"
                    android:paddingTop="@dimen/dp_3"
                    android:paddingBottom="@dimen/dp_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:layout_marginBottom="@dimen/dp_22"
                    android:minWidth="@dimen/dp_128"
                    android:minHeight="@dimen/dp_40"
                    android:text="@string/carhealthy_maintain_record"
                    android:textAllCaps="false"
                    android:paddingStart="@dimen/dp_24"
                    android:paddingEnd="@dimen/dp_24"
                    android:layout_marginStart="@dimen/dp_24"
                    android:layout_marginEnd="@dimen/dp_24"
                    android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="start|center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_detect"
                android:background="@drawable/carlights_background"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_88"
                android:layout_marginBottom="@dimen/dp_16"
                android:paddingStart="@dimen/dp_24">
                <TextView
                    android:textSize="@dimen/sp_20"
                    android:textColor="?attr/dialog_text_gray"
                    android:id="@+id/tv_detect_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/vehiclehealth_oil_detect"
                    android:paddingEnd="@dimen/dp_24"/>
                <View
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="@dimen/sp_18"
                    android:textColor="@color/dialog_btn_text_tyre_selector"
                    android:gravity="center"
                    android:id="@+id/tv_detect"
                    android:background="@drawable/selector_dialog_white"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp_48"
                    android:minWidth="@dimen/dp_160"
                    android:text="@string/vehiclehealth_detect"
                    android:textAllCaps="false"
                    android:paddingStart="@dimen/dp_24"
                    android:paddingEnd="@dimen/dp_24"
                    android:layout_marginEnd="@dimen/dp_24"
                    android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_sw"
                android:background="@drawable/carlights_background"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/dp_24"
                android:paddingEnd="@dimen/dp_8">
                <LinearLayout
                    android:gravity="start|center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_88">
                    <com.byd.base.view.BydSwitch
                        android:id="@+id/sw_time"
                        app:splitTrack="true"
                        app:switchMinWidth="@dimen/dp_56"
                        app:thumbTintMode="src_over"
                        app:track="?attr/transparent_00"
                        app:trackTint="?attr/transparent_00"
                        style="@style/bydswitch_style"/>
                    <TextView
                        android:textSize="@dimen/sp_20"
                        android:textColor="?attr/text_color_main"
                        android:gravity="start|center_vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/carhealthy_maintain_time"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/dp_16"
                        android:layout_marginEnd="@dimen/dp_8"/>
                    <TextView
                        android:textSize="@dimen/sp_20"
                        android:textColor="?attr/text_color_main_gray"
                        android:gravity="end|center_vertical"
                        android:id="@+id/tv_set_time"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp_48"/>
                    <ImageView
                        android:textSize="@dimen/sp_20"
                        android:id="@+id/iv_set_time"
                        android:visibility="gone"
                        android:layout_width="@dimen/dp_48"
                        android:layout_height="@dimen/dp_48"
                        android:src="@drawable/icon_dark_public_rightarrow_48"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="start|center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_88">
                    <com.byd.base.view.BydSwitch
                        android:id="@+id/sw_mile"
                        app:splitTrack="true"
                        app:switchMinWidth="@dimen/dp_56"
                        app:thumbTintMode="src_over"
                        app:track="?attr/transparent_00"
                        app:trackTint="?attr/transparent_00"
                        style="@style/bydswitch_style"/>
                    <TextView
                        android:textSize="@dimen/sp_20"
                        android:textColor="?attr/text_color_main"
                        android:gravity="start|center_vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/carhealthy_maintain_mile"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/dp_16"
                        android:layout_marginEnd="@dimen/dp_8"/>
                    <TextView
                        android:textSize="@dimen/sp_20"
                        android:textColor="?attr/text_color_main_gray"
                        android:gravity="end|center_vertical"
                        android:id="@+id/tv_set_mile"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp_48"/>
                    <ImageView
                        android:textSize="@dimen/sp_20"
                        android:id="@+id/iv_set_mile"
                        android:visibility="gone"
                        android:layout_width="@dimen/dp_48"
                        android:layout_height="@dimen/dp_48"
                        android:src="@drawable/icon_dark_public_rightarrow_48"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.bydux.api.common.views.window.DampingScrollView>
</RelativeLayout>
