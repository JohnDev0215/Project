<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/dp_560"
    android:layout_height="@dimen/dp_544"
    style="@style/vehicle_setting_dialog_background_container">
    <RelativeLayout
        android:id="@+id/rl_title_disk_statistics"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_71"
        android:layout_alignParentTop="true">
        <ImageView
            android:id="@+id/iv_back_disk_statistics"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:layout_marginLeft="@dimen/dp_16"
            android:src="@drawable/icon_public_close_48"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="@dimen/sp_20"
            android:textStyle="bold"
            android:textColor="@color/text_color_main_dilink_pagers"
            android:gravity="center"
            android:id="@+id/tv_title_disk_statistics"
            android:layout_width="@dimen/dp_512"
            android:layout_height="@dimen/dp_29"
            android:text="@string/storage_app_details"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <View
        android:id="@+id/v_title_line_disk_statistics"
        android:background="@color/bg_color_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_below="@+id/rl_title_disk_statistics"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_368"
        android:layout_marginTop="@dimen/dp_17"
        android:layout_below="@+id/v_title_line_disk_statistics"
        android:layout_marginEnd="@dimen/dp_11">
        <ScrollView
            android:scrollbarThumbVertical="@drawable/bar_thumb"
            android:scrollbarTrackVertical="@drawable/bar_track"
            android:orientation="vertical"
            android:id="@+id/disk_sv"
            android:scrollbars="vertical"
            android:fadingEdge="vertical"
            android:fadingEdgeLength="@dimen/dp_44"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:requiresFadingEdge="vertical">
            <include layout="@layout/subview_disk_statistics"/>
        </ScrollView>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_104"
        android:layout_alignParentBottom="true">
        <TextView
            android:id="@+id/btn_clear_cache_disk_statistics"
            android:text="@string/clear_cache_storage_app_details"
            android:stateListAnimator="@drawable/anim_btn_scale"
            style="@style/dialog_btn_cancel_dilink"/>
    </LinearLayout>
</RelativeLayout>
