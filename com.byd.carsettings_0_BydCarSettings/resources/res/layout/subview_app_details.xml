<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dp_24"
    android:layout_marginBottom="@dimen/dp_40"
    android:paddingStart="@dimen/dp_30"
    android:paddingEnd="@dimen/dp_34">
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_88"
        android:paddingStart="@dimen/dp_18">
        <ImageView
            android:id="@+id/iv_app_icon_app_details"
            android:layout_width="@dimen/dp_56"
            android:layout_height="@dimen/dp_56"
            android:layout_marginTop="@dimen/dp_16"
            android:layout_marginBottom="@dimen/dp_16"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/text_color_main_dilink_pagers"
            android:gravity="center_vertical"
            android:id="@+id/tv_app_name_app_details"
            android:layout_width="@dimen/dp_324"
            android:layout_height="@dimen/dp_28"
            android:layout_alignTop="@+id/iv_app_icon_app_details"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_toEndOf="@+id/iv_app_icon_app_details"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/text_color_item_right_dilink_link"
            android:gravity="center_vertical"
            android:id="@+id/tv_app_version_app_details"
            android:layout_width="@dimen/dp_390"
            android:layout_height="@dimen/dp_28"
            android:layout_alignBottom="@+id/iv_app_icon_app_details"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_toEndOf="@+id/iv_app_icon_app_details"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dp_18">
        <TextView
            android:id="@+id/btn_uninstall_app_details"
            android:text="@string/uninstall_app_details"
            style="@style/dialog_btn_big_dilink"/>
        <TextView
            android:id="@+id/btn_kill_app_details"
            android:text="@string/kill_app_details"
            android:layout_marginStart="@dimen/dp_48"
            style="@style/dialog_btn_big_dilink"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_storage_usage_app_details"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_74"
        android:layout_marginTop="@dimen/dp_14"
        android:paddingStart="@dimen/dp_16">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/text_color_main_dilink_pagers"
            android:layout_width="@dimen/dp_464"
            android:layout_height="wrap_content"
            android:text="@string/storage_app_details"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/text_color_item_right_dilink_link"
            android:id="@+id/tv_storage_usage_app_details"
            android:layout_width="@dimen/dp_464"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_2"/>
    </LinearLayout>
    <View
        android:background="@color/bg_color_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_16"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_mobile_data_usage_app_details"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_74"
        android:layout_marginTop="@dimen/dp_14"
        android:paddingStart="@dimen/dp_16">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/text_color_main_dilink_pagers"
            android:layout_width="@dimen/dp_464"
            android:layout_height="wrap_content"
            android:text="@string/mobile_data_usage_app_details"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/text_color_item_right_dilink_link"
            android:id="@+id/tv_mobile_data_usage_app_details"
            android:layout_width="@dimen/dp_464"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_2"/>
    </LinearLayout>
    <View
        android:background="@color/bg_color_line"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_16"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_permission_app_details"
        android:paddingTop="@dimen/dp_14"
        android:paddingBottom="@dimen/dp_20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dp_16">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/text_color_main_dilink_pagers"
            android:layout_width="@dimen/dp_464"
            android:layout_height="wrap_content"
            android:text="@string/permission_app_details"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/text_color_item_right_dilink_link"
            android:ellipsize="end"
            android:id="@+id/tv_permission_app_details"
            android:layout_width="@dimen/dp_464"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_2"
            android:maxLines="2"/>
    </LinearLayout>
    <View
        android:background="@color/bg_color_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_16"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_def_options_app_details"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_74"
        android:layout_marginTop="@dimen/dp_14"
        android:paddingStart="@dimen/dp_16">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/text_color_main_dilink_pagers"
            android:layout_width="@dimen/dp_464"
            android:layout_height="wrap_content"
            android:text="@string/def_options_app_details"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/text_color_item_right_dilink_link"
            android:id="@+id/tv_def_options_app_details"
            android:layout_width="@dimen/dp_464"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_2"/>
    </LinearLayout>
    <View
        android:background="@color/bg_color_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_16"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_memory_usage_app_details"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_74"
        android:layout_marginTop="@dimen/dp_14"
        android:layout_marginBottom="@dimen/dp_32"
        android:paddingStart="@dimen/dp_16">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/text_color_main_dilink_pagers"
            android:layout_width="@dimen/dp_464"
            android:layout_height="wrap_content"
            android:text="@string/memory_app_details"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/text_color_item_right_dilink_link"
            android:id="@+id/tv_memory_usage_app_details"
            android:layout_width="@dimen/dp_464"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_2"/>
    </LinearLayout>
</LinearLayout>
