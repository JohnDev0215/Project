<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/rear_view_mirror_screen_dialog_background"
        android:layout_width="@dimen/dp_622"
        android:layout_height="@dimen/dp_544"
        android:layout_centerInParent="true">
        <RelativeLayout
            android:id="@+id/carsetting_dialog_head"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_72"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/dialog_rearview_inner_mirror_close"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:src="@drawable/icon_dark_public_close_48"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/dp_16"
                android:layout_alignParentEnd="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:id="@+id/carsetting_dialog_title"
                android:text="@string/vehiclesettings_rear_view_mirror_screen_turn_dialog_title"
                android:layout_marginStart="@dimen/dp_64"
                android:layout_marginEnd="@dimen/dp_64"
                style="@style/byd_vehicle_setting_dialog_title_style"/>
            <View
                android:id="@+id/carsetting_dialog_line"
                android:background="@color/ambient_dialog_line_bg"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_1"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <TextView
            android:textSize="@dimen/dp_20"
            android:textColor="#ffdae1eb"
            android:id="@+id/content_up"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_25"
            android:text="@string/vehiclesettings_rear_view_mirror_screen_turn_dialog_message"
            android:layout_marginStart="@dimen/dp_60"
            android:layout_marginEnd="@dimen/dp_60"
            app:layout_constraintBottom_toTopOf="@+id/content_use"/>
        <TextView
            android:textSize="@dimen/dp_20"
            android:textColor="#ffdae1eb"
            android:id="@+id/content_use"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_10"
            android:text="@string/vehiclesettings_rear_view_mirror_screen_turn_dialog_use_message"
            android:layout_below="@+id/content_up"
            android:layout_marginStart="@dimen/dp_60"
            android:layout_marginEnd="@dimen/dp_60"
            app:layout_constraintBottom_toTopOf="@+id/brightness_container_out"/>
        <RelativeLayout
            android:id="@+id/brightness_container_out"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_240"
            android:layout_marginBottom="@dimen/dp_25"
            app:layout_constraintTop_toTopOf="parent">
            <RelativeLayout
                android:id="@+id/brightness_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                android:layout_marginStart="@dimen/dp_60">
                <ImageView
                    android:id="@+id/brightness"
                    android:layout_width="@dimen/dp_48"
                    android:layout_height="@dimen/dp_48"
                    android:src="@drawable/rear_view_up_icon"
                    android:scaleType="center"
                    android:layout_centerHorizontal="true"/>
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textColor="#ccdae1eb"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="@dimen/dp_128"
                    android:text="@string/vehiclesettings_rear_view_mirror_screen_turn_dialog_view_message"
                    android:layout_below="@+id/brightness"
                    android:layout_centerHorizontal="true"
                    android:textAlignment="center"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/up_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                android:layout_marginStart="@dimen/dp_16"
                android:layout_toEndOf="@+id/brightness_container">
                <ImageView
                    android:id="@+id/up"
                    android:layout_width="@dimen/dp_48"
                    android:layout_height="@dimen/dp_48"
                    android:src="@drawable/rear_view_height_icon"
                    android:scaleType="center"
                    android:layout_centerHorizontal="true"/>
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textColor="#ccdae1eb"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="@dimen/dp_128"
                    android:text="@string/vehiclesettings_hud_height_adjustment"
                    android:layout_below="@+id/up"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/height_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                android:layout_marginStart="@dimen/dp_16"
                android:layout_toEndOf="@+id/up_container">
                <ImageView
                    android:id="@+id/height"
                    android:layout_width="@dimen/dp_48"
                    android:layout_height="@dimen/dp_48"
                    android:src="@drawable/rear_view_brightness_icon"
                    android:scaleType="center"
                    android:layout_centerHorizontal="true"/>
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textColor="#ccdae1eb"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="@dimen/dp_128"
                    android:text="@string/vehiclesettings_hud_brightness_adjustment"
                    android:layout_below="@+id/height"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>
        </RelativeLayout>
        <TextView
            android:textSize="@dimen/dp_20"
            android:textColor="#ffdae1eb"
            android:id="@+id/content_wheel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_25"
            android:text="@string/vehiclesettings_rear_view_mirror_screen_turn_dialog_wheel_message"
            android:layout_marginStart="@dimen/dp_60"
            android:layout_marginEnd="@dimen/dp_60"
            app:layout_constraintTop_toBottomOf="@+id/brightness_container_out"/>
        <RelativeLayout
            android:id="@+id/switch_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_60"
            app:layout_constraintBottom_toTopOf="@+id/content_description"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/content_wheel">
            <com.byd.base.view.BydSwitch
                android:id="@+id/auto_light_sw"
                android:layout_centerVertical="true"
                style="@style/vehicle_setting_sw_common_style"/>
            <TextView
                android:textSize="@dimen/dp_20"
                android:textColor="#ffdae1eb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vehiclesettings_rear_view_mirror_brightness_auto"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/dp_16"
                android:layout_toEndOf="@+id/auto_light_sw"/>
        </RelativeLayout>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="#d9dae1eb"
            android:id="@+id/content_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_10"
            android:text="@string/vehiclesettings_rear_view_mirror_screen_turn_dialog_description_message"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="@dimen/dp_70"
            android:layout_marginEnd="@dimen/dp_70"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>
