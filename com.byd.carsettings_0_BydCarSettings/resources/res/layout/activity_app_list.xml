<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/dp_560"
    android:layout_height="@dimen/dp_544"
    style="@style/vehicle_setting_dialog_background_container">
    <RelativeLayout
        android:id="@+id/rl_title_app_list_app_manage"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_71"
        android:layout_alignParentTop="true">
        <ImageView
            android:id="@+id/iv_back_app_list_app_manage"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:layout_marginLeft="@dimen/dp_16"
            android:src="@drawable/icon_public_close_48"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="@dimen/sp_20"
            android:textStyle="bold"
            android:textColor="@color/text_color_main_dilink_pagers"
            android:gravity="center"
            android:id="@+id/tv_title_app_list_app_manage"
            android:layout_width="@dimen/dp_512"
            android:layout_height="@dimen/dp_29"
            android:text="@string/title_disable_self_start_dialog"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <View
        android:id="@+id/v_line_app_list_app_manage"
        android:background="@color/bg_color_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_below="@+id/rl_title_app_list_app_manage"/>
    <RelativeLayout
        android:id="@+id/rl_data_show_app_list_app_manage"
        android:paddingTop="@dimen/dp_27"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_425"
        android:layout_below="@+id/v_line_app_list_app_manage">
        <androidx.recyclerview.widget.RecyclerView
            android:scrollbarSize="@dimen/dp_4"
            android:scrollbarThumbVertical="@drawable/bar_thumb"
            android:scrollbarTrackVertical="@drawable/bar_track"
            android:id="@+id/rcv_app_list_app_manage"
            android:scrollbars="vertical"
            android:fadingEdgeLength="@dimen/dp_44"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:requiresFadingEdge="vertical"
            android:paddingStart="@dimen/dp_32"
            android:paddingEnd="@dimen/dp_8"/>
        <View
            android:background="@drawable/shape_gradient_top_disable_self_start"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_20"
            android:layout_alignParentTop="true"
            android:layout_marginStart="@dimen/dp_10"
            android:layout_marginEnd="@dimen/dp_10"/>
        <View
            android:background="@drawable/shape_gradient_bottom_disable_self_start"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_20"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/dp_10"
            android:layout_marginEnd="@dimen/dp_10"/>
    </RelativeLayout>
    <include
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        layout="@layout/view_status_in_loading"/>
    <RelativeLayout
        android:id="@+id/rl_no_data_show"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_405"
        android:layout_below="@+id/v_line_app_list_app_manage">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <ImageView
                android:background="@drawable/img_media_music_playlist_empty"
                android:layout_width="@dimen/dp_312"
                android:layout_height="@dimen/dp_208"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/text_color_item_right_dilink_link"
                android:gravity="center"
                android:id="@+id/tv_no_data_disable_self_start"
                android:layout_width="@dimen/dp_272"
                android:layout_height="@dimen/dp_24"
                android:text="@string/no_data_app_manage"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
