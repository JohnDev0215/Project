<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/setting_nfc_iv"
        android:layout_width="@dimen/dp_495"
        android:layout_height="@dimen/dp_368"
        android:src="@drawable/img_carsetting_key"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="@color/digital_key_empty_des"
        android:gravity="center"
        android:id="@+id/tv_yindao_lable"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_113"
        android:text="@string/nfc_key_open_yingdao"/>
    <com.youth.banner.Banner
        android:id="@+id/banner_view"
        android:visibility="gone"
        android:layout_width="@dimen/dp_360"
        android:layout_height="@dimen/dp_240"
        android:layout_marginTop="@dimen/dp_14"
        android:layout_marginBottom="@dimen/dp_15"
        android:src="@drawable/digital_empty_image"
        android:layout_below="@+id/tv_yindao_lable"
        android:layout_centerHorizontal="true"
        app:banner_indicator_normal_color="@color/banner_indicator_normal_color"
        app:banner_indicator_normal_width="@dimen/dp_6"
        app:banner_indicator_selected_color="@color/banner_indicator_selected_color"
        app:banner_indicator_selected_width="@dimen/dp_6"/>
    <com.youth.banner.indicator.CircleIndicator
        android:layout_gravity="center_horizontal"
        android:id="@+id/circle_indicator"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/banner_view"
        android:layout_centerHorizontal="true"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/switch_lay"
        android:background="@drawable/digital_key_item_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_88"
        android:layout_marginTop="@dimen/dp_108"
        android:layout_below="@+id/circle_indicator"
        android:paddingStart="@dimen/dp_24"
        android:layout_marginStart="@dimen/dp_48"
        android:layout_marginEnd="@dimen/dp_48">
        <com.byd.base.view.BydSwitch
            android:layout_gravity="center_vertical"
            android:id="@+id/digital_key_set_switch"
            style="@style/base_byd_switch"/>
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/digital_key_empty_des"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/no_key_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nfc_keyless_start"
            android:drawableEnd="@drawable/icon_dark_public_details_48"
            android:layout_marginStart="@dimen/dp_16"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_remove"
        android:background="@drawable/digital_key_item_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_60"
        android:layout_below="@+id/setting_nfc_iv"
        android:paddingStart="@dimen/dp_24"
        android:layout_marginStart="@dimen/dp_48"
        android:layout_marginEnd="@dimen/dp_48">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/ll_remove_all_key"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_88">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/digital_key_empty_des"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/nfc_delete_all_key"
                android:drawableEnd="@drawable/icon_dark_public_rightarrow_48"
                android:paddingEnd="@dimen/dp_10"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_88">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/digital_key_empty_des"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/nfc_user_agreement"
                android:drawableEnd="@drawable/icon_dark_public_rightarrow_48"
                android:paddingEnd="@dimen/dp_10"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_key_user_report"
        android:background="@drawable/digital_key_item_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_below="@+id/ll_remove"
        android:paddingStart="@dimen/dp_24"
        android:layout_marginStart="@dimen/dp_48"
        android:layout_marginEnd="@dimen/dp_48">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_88">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/digital_key_empty_des"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/nfc_user_agreement"
                android:drawableEnd="@drawable/icon_dark_public_rightarrow_48"
                android:paddingEnd="@dimen/dp_10"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/loading_ll"
        android:padding="@dimen/dp_25"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <ImageView
            android:id="@+id/iv_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_light_public_loading_sm"/>
    </LinearLayout>
</RelativeLayout>
