<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/wade_protect_arrow_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_58"
        android:minHeight="@dimen/dp_60">
        <ImageView
            android:id="@+id/wade_protect_arrow"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:src="@drawable/icon_set_public_rightarrow_48"
            android:layout_centerVertical="true"
            android:rotationY="180"
            android:layout_marginStart="@dimen/dp_32"/>
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/comfortable_wading_protect_read_title_tv_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vehiclesettings_comfortable_wading_protection_risk_title"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <com.bydux.api.common.views.window.DampingScrollView
        android:scrollbarThumbVertical="@drawable/setting_bar_thumb"
        android:scrollbarTrackVertical="@drawable/setting_bar_track"
        android:scrollbarStyle="insideOverlay"
        android:id="@+id/nsw"
        android:fadingEdge="vertical"
        android:fadingEdgeLength="@dimen/dp_24"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dp_20"
        android:layout_marginBottom="@dimen/dp_142"
        android:layout_below="@+id/wade_protect_arrow_container"
        android:overScrollMode="never"
        android:requiresFadingEdge="vertical">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/carsetting_text_color_white"
                android:id="@+id/carsetting_dialog_main_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/vehiclesettings_comfortable_wading_protection_risk_up_tips"
                android:layout_marginStart="@dimen/dp_40"
                android:layout_marginEnd="@dimen/dp_40"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textStyle="bold"
                android:textColor="@color/carsetting_text_color_white"
                android:id="@+id/carsetting_dialog_second_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/vehiclesettings_comfortable_wading_protection_risk_down_tips"
                android:layout_marginStart="@dimen/dp_40"
                android:layout_marginEnd="@dimen/dp_40"/>
        </LinearLayout>
    </com.bydux.api.common.views.window.DampingScrollView>
</RelativeLayout>
