<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="start|center_vertical"
    android:orientation="vertical"
    android:layout_width="@dimen/dp_464"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/dp_39"
    android:layout_marginEnd="@dimen/dp_39">
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="?attr/text_color_main"
        android:id="@+id/tv_record_title"
        android:layout_width="@dimen/dp_464"
        android:layout_height="@dimen/dp_26"
        android:layout_marginTop="@dimen/dp_10"
        android:layout_marginBottom="@dimen/dp_8"/>
    <LinearLayout
        android:gravity="start|center_vertical"
        android:orientation="horizontal"
        android:background="?attr/oil_title_background"
        android:layout_width="@dimen/dp_464"
        android:layout_height="@dimen/dp_24"
        android:paddingStart="@dimen/dp_17"
        android:paddingEnd="@dimen/dp_17">
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="?attr/text_color_main"
            android:id="@+id/tv_record_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/carhealthy_oil_record_date"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="?attr/text_color_main"
            android:id="@+id/tv_record_mile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/vehiclesettings_instrument_miles_total"
            android:layout_weight="1.2"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="?attr/attr_text_color_main"
            android:id="@+id/tv_record_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/vehiclesettings_instrument_miles_hev"
            android:layout_weight="1.2"/>
    </LinearLayout>
    <View
        android:background="?attr/oil_background"
        android:layout_width="@dimen/dp_464"
        android:layout_height="@dimen/dp_10"/>
</LinearLayout>
