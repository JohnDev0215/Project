<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:paddingStart="@dimen/dp_14">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_15"
            android:paddingStart="@dimen/dp_9">
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/text_color_main"
                android:id="@+id/tv_flow_limited_hotspot_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/flow_limited_for_one_time_hotspot_right"/>
        </RelativeLayout>
        <RadioGroup
            android:orientation="vertical"
            android:id="@+id/rg_flow_limited_hotspot_right"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_26"
            android:paddingStart="@dimen/dp_9"
            android:paddingEnd="@dimen/dp_24">
            <com.byd.mvp.ui.widget.TintRadioButton
                android:id="@+id/rbtn_custom_hotspot_right"
                android:text="@string/flow_limited_custom_hotspot_right"
                style="@style/rbtn_hotspot"/>
            <include layout="@layout/view_custom_flow_limited"/>
            <com.byd.mvp.ui.widget.TintRadioButton
                android:id="@+id/rbtn_unlimited_hotspot_right"
                android:layout_marginTop="@dimen/dp_8"
                android:text="@string/flow_limited_unlimited_hotspot_right"
                style="@style/rbtn_hotspot"/>
            <com.byd.mvp.ui.widget.TintRadioButton
                android:id="@+id/rbtn_100mb_hotspot_right"
                android:layout_marginTop="@dimen/dp_8"
                android:text="@string/flow_limited_100mb_hotspot_right"
                style="@style/rbtn_hotspot"/>
            <com.byd.mvp.ui.widget.TintRadioButton
                android:id="@+id/rbtn_200mb_hotspot_right"
                android:layout_marginTop="@dimen/dp_8"
                android:text="@string/flow_limited_200mb_hotspot_right"
                style="@style/rbtn_hotspot"/>
            <com.byd.mvp.ui.widget.TintRadioButton
                android:id="@+id/rbtn_500mb_hotspot_right"
                android:layout_marginTop="@dimen/dp_8"
                android:text="@string/flow_limited_500mb_hotspot_right"
                style="@style/rbtn_hotspot"/>
        </RadioGroup>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_104"
        android:layout_alignParentBottom="true">
        <com.byd.carsettings.ui.widget.BydInvalidButton
            android:id="@+id/btn_ok_flow_limited_hotspot_right"
            android:text="@string/dialog_btn_ok"
            style="@style/dialog_btn_ok_dilink"/>
        <com.byd.carsettings.ui.widget.BydInvalidButton
            android:id="@+id/btn_cancel_flow_limited_hotspot_right"
            android:text="@string/dialog_btn_cancel"
            android:layout_marginStart="@dimen/dp_48"
            style="@style/dialog_btn_cancel_dilink"/>
    </LinearLayout>
</RelativeLayout>
