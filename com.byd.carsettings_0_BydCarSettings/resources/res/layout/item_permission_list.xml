<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/dp_74">
    <RelativeLayout
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dp_24"
        android:paddingEnd="@dimen/dp_16">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/dp_74"
            android:layout_centerVertical="true"
            android:paddingEnd="@dimen/dp_20"
            android:layout_toStartOf="@+id/switch_item_permission_list"
            android:layout_alignParentStart="true">
            <ImageView
                android:id="@+id/iv_permission_icon_item_permission_list"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_main_dilink_pagers"
                android:gravity="center_vertical"
                android:id="@+id/tv_permission_name_item_app_list"
                android:paddingTop="@dimen/dp_10"
                android:paddingBottom="@dimen/dp_10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_24"
                android:layout_marginEnd="@dimen/dp_12"/>
        </LinearLayout>
        <com.byd.base.view.BydSwitch
            android:id="@+id/switch_item_permission_list"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp_24"
            android:layout_alignParentEnd="true"
            style="@style/byd_switch_on_service"/>
        <View
            android:id="@+id/v_line_item_permission_list"
            android:background="@color/bg_color_line"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="@dimen/dp_24"/>
    </RelativeLayout>
</LinearLayout>
