<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:scrollbarSize="@dimen/dp_4"
    android:scrollbarThumbVertical="@drawable/bar_thumb"
    android:scrollbarTrackVertical="@drawable/bar_track"
    android:scrollbars="vertical"
    android:layout_width="@dimen/dp_560"
    android:layout_height="wrap_content"
    android:requiresFadingEdge="vertical"
    android:paddingStart="@dimen/dp_8"
    android:paddingEnd="@dimen/dp_8"
    android:nestedScrollingEnabled="false">
    <RelativeLayout
        android:orientation="vertical"
        android:paddingTop="@dimen/dp_20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dp_40"
        android:paddingEnd="@dimen/dp_40">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="?attr/dialog_text_color_main"
            android:layout_width="@dimen/dp_235"
            android:layout_height="wrap_content"
            android:text="@string/newenergy_discharge_mps_discharge_car_title"/>
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="?attr/dialog_text_color_main"
            android:layout_width="@dimen/dp_200"
            android:layout_height="wrap_content"
            android:text="@string/newenergy_discharge_mps_charge_car_title"
            android:layout_marginStart="@dimen/dp_253"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="?attr/dialog_text_color_main"
            android:id="@+id/tv_owner_desc"
            android:layout_width="@dimen/dp_210"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_51"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="?attr/dialog_text_color_main"
            android:id="@+id/tv_charge_desc"
            android:layout_width="@dimen/dp_210"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_51"
            android:layout_marginStart="@dimen/dp_253"/>
    </RelativeLayout>
</LinearLayout>
