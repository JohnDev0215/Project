<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingEnd="@dimen/dp_10">
    <include layout="@layout/subview_wifi_left_connected"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_60">
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/text_color_gray_bt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/enable_net_wireless"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dp_24"/>
        <ImageView
            android:id="@+id/iv_refresh_wifi_left"
            android:background="@drawable/icon_public_refresh_48"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:layout_marginEnd="@dimen/dp_16"/>
    </LinearLayout>
    <com.bydux.api.common.views.window.DampingScrollView
        android:orientation="vertical"
        android:id="@+id/wifi_left_scroll_view"
        android:scrollbars="none"
        android:fadingEdge="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include layout="@layout/subview_wifi_left_scan_list"/>
    </com.bydux.api.common.views.window.DampingScrollView>
</LinearLayout>
