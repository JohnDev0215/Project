<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:id="@+id/ll_dialog_masks"
    android:background="@color/base_dialog_masks"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:alpha="0">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_bg_dialo_sound_focus"
        android:clickable="true"
        android:layout_width="@dimen/dp_560"
        android:layout_height="@dimen/dp_400"
        android:alpha="0"
        android:scaleX="0.9"
        android:scaleY="0.9"
        android:elevation="@dimen/dp_3"
        style="@style/vehicle_setting_dialog_background_container">
        <include
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_72"
            layout="@layout/dialog_common_title"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/dp_34"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dp_35"
            android:layout_marginEnd="@dimen/dp_35">
            <com.byd.carsettings.system.timezone.TimeZonePicker
                android:id="@+id/np_dialog_time_zone"
                android:fadingEdgeLength="@dimen/dp_44"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:requiresFadingEdge="vertical"/>
            <View
                android:background="@color/bg_color_line"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_1"
                android:layout_marginTop="@dimen/dp_50"
                android:layout_alignParentTop="true"/>
            <View
                android:background="@color/bg_color_line"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_1"
                android:layout_marginBottom="@dimen/dp_80"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <include
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_104"
            layout="@layout/dialog_bottom_2btn_left_hight_light"/>
    </LinearLayout>
</LinearLayout>
