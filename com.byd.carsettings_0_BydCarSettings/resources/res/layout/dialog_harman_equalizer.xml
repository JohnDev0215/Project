<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_bg_dialo_sound_focus"
    android:background="@drawable/bg_dyna_sound_charact_custom"
    android:layout_width="@dimen/dp_560"
    android:layout_height="@dimen/dp_544">
    <include
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_72"
        layout="@layout/dialog_common_title"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_70"
        android:layout_marginBottom="@dimen/dp_90"
        android:layout_weight="1">
        <RelativeLayout
            android:id="@+id/rl_range_view_sound_character_seekbar"
            android:layout_width="@dimen/dp_124"
            android:layout_height="match_parent">
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/text_color_gray_sound"
                android:id="@+id/tv_max_view_sound_character_seekbar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_30"
                android:text="@string/max_freq_band_range_dyna_sound_charact"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/text_color_gray_sound"
                android:id="@+id/tv_min_view_sound_character_seekbar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_30"
                android:text="@string/min_freq_band_range_dyna_sound_charact"
                android:layout_alignParentBottom="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <com.byd.carsettings.ui.widget.EqualizerView
            android:id="@+id/ev_dialog_harman_equalizer"
            android:layout_width="@dimen/dp_360"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/dp_26"
            app:has_signed="true"
            app:key_arr_seek_bar="@array/harman_freq_band_key_array"
            app:range_max_array="@array/harman_freq_band_range_max_array"
            app:range_min_array="@array/harman_freq_band_range_min_array"
            app:seekbar_id="@+id/sbar_view_harman_equalizer_seekbar"
            app:seekbar_layout_item_id="@layout/view_harman_equalizer_seekbar"
            app:seekbar_margin_end="@dimen/dp_72"
            app:seekbar_title_layout_id="@layout/view_sound_freq_band_title"
            app:seekbar_value_layout_id="@layout/view_sound_freq_band_value"
            app:show_values="true"
            app:title_arr_seek_bar="@array/harman_freq_band_list"/>
    </LinearLayout>
</LinearLayout>
