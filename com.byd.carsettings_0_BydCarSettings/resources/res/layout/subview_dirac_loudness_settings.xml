<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/ll_dirac_loudness_sound_pager"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/dp_24"
    android:paddingEnd="@dimen/dp_24">
    <com.byd.base.view.BydSwitch
        android:id="@+id/switch_dirac_loudness_sound_pager"
        android:layout_marginEnd="@dimen/dp_16"
        style="@style/byd_switch"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_title_dirac_loudness_sound_pager"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/text_color_item_left_dilink_link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/loudness_sound"/>
    </LinearLayout>
</LinearLayout>
