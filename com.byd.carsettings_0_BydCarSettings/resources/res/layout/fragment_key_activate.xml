<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="@color/digital_key_cancel"
        android:id="@+id/tv_cancel_activate"
        android:paddingLeft="@dimen/dp_50"
        android:paddingTop="@dimen/dp_20"
        android:paddingRight="@dimen/dp_50"
        android:paddingBottom="@dimen/dp_18"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/base_common_dialog_btn_cancel"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/pre_loading_ll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/digital_key_activate_lottie"
            android:layout_width="@dimen/dp_672"
            android:layout_height="@dimen/dp_448"/>
        <TextView
            android:textSize="@dimen/sp_24"
            android:textColor="@color/digital_open_des"
            android:gravity="center"
            android:id="@+id/tv_des"
            android:paddingTop="@dimen/dp_34"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nfc_open_step1"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/loading_ll"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_loading"
                android:layout_width="@dimen/dp_160"
                android:layout_height="@dimen/dp_160"
                android:src="@drawable/icon_dark_public_loading"/>
            <TextView
                android:textSize="@dimen/sp_28"
                android:textColor="@color/nfc_key_opening_des_color"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/open_loading_progress_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </FrameLayout>
        <TextView
            android:textSize="@dimen/sp_28"
            android:textColor="@color/nfc_key_opening_des_color"
            android:gravity="center"
            android:paddingTop="@dimen/dp_83"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nfc_key_opening"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
