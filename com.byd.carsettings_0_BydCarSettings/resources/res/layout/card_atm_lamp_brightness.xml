<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_frame_gray_a"
        android:layout_width="@dimen/dp_490"
        android:layout_height="@dimen/dp_144"
        android:minWidth="@dimen/dp_490"
        android:minHeight="@dimen/dp_144"
        android:layout_centerHorizontal="true"
        android:paddingStart="@dimen/dp_24">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_26">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_main"
                android:id="@+id/tv_title_card_atm_lamp_brightness"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/brightness_adjust_of_media_display"
                android:layout_alignParentStart="true"/>
        </RelativeLayout>
        <com.byd.base.view.BydSeekBar
            android:id="@+id/sbar_card_atm_lamp_brightness"
            android:background="@drawable/img_carsetting_ambient_light_slider_bg"
            android:layout_width="@dimen/dp_440"
            android:layout_height="@dimen/dp_44"
            android:layout_marginTop="@dimen/dp_23"
            android:max="5"
            android:thumbOffset="0dp"
            android:splitTrack="false"
            app:areaBackground="@drawable/light_level"
            app:areaBackgroundEnd="@drawable/icon_set_sun_big_48"
            app:areaBackgroundEndHeight="@dimen/dp_48"
            app:areaBackgroundEndMaginH="@dimen/dp_2"
            app:areaBackgroundEndWidth="@dimen/dp_48"
            app:areaBackgroundFirst="@drawable/icon_set_sun_48"
            app:areaBackgroundFirstHeight="@dimen/dp_48"
            app:areaBackgroundFirstMaginH="@dimen/dp_2"
            app:areaBackgroundFirstWidth="@dimen/dp_48"
            app:areaBackgroundSelctedColor="#ffffffff"
            app:areaBackgroundUnSelctedColor="@color/ambient_progress_dotcolor"
            app:areaCount="5"
            app:bacgroudRadius="@dimen/dp_22"
            app:backgroundBottom="@dimen/dp_8"
            app:backgroundLeft="@dimen/dp_8"
            app:backgroundRight="@dimen/dp_8"
            app:backgroundTop="@dimen/dp_7"
            app:defaultDistance="@dimen/dp_36"
            app:endAreaBgUnSelectedColor="@color/ambient_endDwUnseleted_color"
            app:innerBackgroundcolor="@color/transparent"
            app:isCanDrag="true"
            app:isDrawDefaultDistance="true"
            app:isThumbVisiable="false"
            app:isneedColorFilter="true"
            app:linearColorsToggle="false"
            app:progressEndColor="#ff45a2ff"
            app:progressGradient="true"
            app:progressStartColor="#ff1590fa"
            app:thumbMargin="@dimen/dp_3"/>
    </LinearLayout>
</RelativeLayout>
