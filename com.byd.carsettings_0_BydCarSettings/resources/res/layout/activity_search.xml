<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/bg_function_options_search"
    android:background="@drawable/bg_main_activity"
    android:paddingTop="@dimen/dp_56"
    android:paddingBottom="@dimen/dp_60"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_24">
        <ImageView
            android:id="@+id/iv_back_search"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:src="@drawable/icon_public_leftarrow_48"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/dp_28"
            android:layout_alignParentStart="true"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_search_key_words_search"
            android:background="@drawable/bg_frame_blue_content_transparent_00"
            android:layout_width="@dimen/dp_580"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_24"
            android:layout_toEndOf="@+id/iv_back_search">
            <ImageView
                android:id="@+id/iv_search_search"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:src="@drawable/icon_public_search_48"
                android:layout_marginStart="@dimen/dp_8"/>
            <com.byd.carsettings.ui.widget.BydEditText
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_main"
                android:textColorHint="@color/text_color_main_gray"
                android:id="@+id/et_search_key_words_search"
                android:background="@color/transparent_00"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="@dimen/dp_466"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/dp_3"
                android:layout_marginBottom="@dimen/dp_3"
                android:hint="@string/search_function"
                android:singleLine="true"
                android:inputType="textCapWords"
                android:imeOptions="actionDone"
                android:layout_marginStart="@dimen/dp_2"/>
            <ImageView
                android:id="@+id/iv_close_search"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:src="@drawable/icon_public_close_edit_48"/>
        </LinearLayout>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_search_history"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_22">
        <RelativeLayout
            android:id="@+id/rl_sh"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_34"
            android:paddingStart="@dimen/dp_45"
            android:paddingEnd="@dimen/dp_45">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_main_gray"
                android:id="@+id/tv_search_history"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/search_history"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/dp_24"
                android:layout_alignParentStart="true"/>
            <ImageView
                android:id="@+id/iv_delete_history_search"
                android:layout_width="@dimen/dp_32"
                android:layout_height="@dimen/dp_32"
                android:src="@drawable/icon_media_search_delete_32"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@+id/tv_search_history"/>
        </RelativeLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcv_search_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:overScrollMode="never"
            android:paddingStart="@dimen/dp_37"
            android:paddingEnd="@dimen/dp_37"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/result_fl"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:scrollbarSize="@dimen/dp_4"
            android:scrollbarThumbVertical="@drawable/bar_thumb"
            android:scrollbarTrackVertical="@drawable/bar_track"
            android:id="@+id/rcv_search_result"
            android:visibility="gone"
            android:scrollbars="vertical"
            android:fadingEdgeLength="@dimen/dp_24"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_14"
            android:requiresFadingEdge="vertical"
            android:paddingStart="@dimen/dp_76"
            android:paddingEnd="@dimen/dp_16"/>
    </FrameLayout>
    <RelativeLayout
        android:id="@+id/rl_no_data_search"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <ImageView
                android:background="@drawable/img_media_music_playlist_empty"
                android:layout_width="@dimen/dp_312"
                android:layout_height="@dimen/dp_208"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/text_color_main_gray"
                android:gravity="center"
                android:id="@+id/tv_no_connect_bt"
                android:layout_width="@dimen/dp_272"
                android:layout_height="@dimen/dp_24"
                android:text="@string/no_data_search"/>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
