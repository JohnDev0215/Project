<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_width="@dimen/dp_560"
        android:layout_height="wrap_content">
        <com.byd.carsettings.ui.widget.DampingRecyclerView
            android:paddingTop="@dimen/dp_22"
            android:paddingBottom="@dimen/dp_16"
            android:layout_width="@dimen/dp_560"
            android:layout_height="wrap_content">
            <com.byd.carsettings.ui.widget.MaxHeightRecyclerView
                android:scrollbarSize="@dimen/dp_4"
                android:scrollbarThumbVertical="@drawable/bar_thumb"
                android:scrollbarTrackVertical="@drawable/bar_track"
                android:id="@+id/rv_record"
                android:visibility="visible"
                android:scrollbars="vertical"
                android:fadingEdge="vertical"
                android:fadingEdgeLength="@dimen/dp_24"
                android:layout_width="@dimen/dp_560"
                android:layout_height="wrap_content"
                android:requiresFadingEdge="vertical"
                android:paddingStart="@dimen/dp_9"
                android:paddingEnd="@dimen/dp_9"
                app:maxHeight="@dimen/dp_312"/>
        </com.byd.carsettings.ui.widget.DampingRecyclerView>
        <ImageView
            android:id="@+id/iv_nodata"
            android:visibility="gone"
            android:layout_width="@dimen/dp_120"
            android:layout_height="@dimen/dp_120"
            android:layout_marginTop="@dimen/dp_54"
            android:src="@drawable/icon_carhealthy_nodata"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="?attr/text_color_main"
            android:id="@+id/tv_nodata"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_196"
            android:text="@string/carhealthy_oil_nodata"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
</FrameLayout>
