<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/dp_640"
    android:layout_height="wrap_content"
    style="@style/vehicle_setting_dialog_background_container">
    <ImageView
        android:id="@+id/carseat_massage_close_imge"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_12"
        android:src="@drawable/icon_public_close_48"
        android:layout_marginEnd="@dimen/dp_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:layout_marginTop="@dimen/dp_32"
        android:text="@string/vehiclesettings_carseat_massage_key_tips_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/byd_vehicle_setting_dialog_title_style"/>
    <ImageView
        android:id="@+id/imge"
        android:background="?attr/img_carseat_tips"
        android:layout_width="@dimen/dp_532"
        android:layout_height="@dimen/dp_186"
        android:layout_marginTop="@dimen/dp_137"
        android:layout_marginStart="@dimen/dp_59"
        android:layout_marginEnd="@dimen/dp_49"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/vehiclesettings_massage_tip_dialog_text_color"
        android:layout_width="@dimen/dp_186"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_100"
        android:text="@string/vehiclesettings_massage_tips_start_text"
        android:textAlignment="center"
        android:layout_marginStart="@dimen/dp_59"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/vehiclesettings_massage_tip_dialog_text_color"
        android:layout_width="@dimen/dp_186"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_100"
        android:text="@string/vehiclesettings_massage_tips_end_text"
        android:textAlignment="center"
        android:layout_marginEnd="@dimen/dp_49"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textStyle="bold"
        android:textColor="@color/vehiclesettings_massage_tip_dialog_text_color"
        android:gravity="bottom|center_horizontal"
        android:layout_width="@dimen/dp_140"
        android:layout_height="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_181"
        android:text="@string/vehiclesettings_massage_tips_center_up_text"
        android:layout_marginStart="@dimen/dp_258"
        android:layout_marginEnd="@dimen/dp_242"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/vehiclesettings_massage_tip_dialog_text_color"
        android:gravity="top|center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_239"
        android:maxWidth="@dimen/dp_140"
        android:text="@string/vehiclesettings_massage_tips_center_down_text"
        android:layout_marginStart="@dimen/dp_258"
        android:layout_marginEnd="@dimen/dp_242"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/vehiclesettings_massage_tip_dialog_text_color"
        android:gravity="center"
        android:layout_width="@dimen/dp_186"
        android:layout_height="@dimen/dp_20"
        android:layout_marginTop="@dimen/dp_165"
        android:text="@string/vehiclesettings_massage_tips_mode_text"
        android:layout_marginEnd="@dimen/dp_49"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/vehiclesettings_massage_tip_dialog_text_color"
        android:gravity="center"
        android:layout_width="@dimen/dp_186"
        android:layout_height="@dimen/dp_28"
        android:layout_marginTop="@dimen/dp_275"
        android:text="@string/vehiclesettings_massage_tips_mode_text"
        android:layout_marginEnd="@dimen/dp_49"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/massage_key_active_tips"
        android:id="@+id/massage_unactive"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_40"
        android:text="@string/vehiclesettings_carseat_massage_unactive_tips"
        android:layout_marginStart="@dimen/dp_36"
        android:layout_marginEnd="@dimen/dp_36"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imge"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/massage_key_active_tips"
        android:id="@+id/massage_active"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:text="@string/vehiclesettings_carseat_massage_active_tips"
        android:layout_marginStart="@dimen/dp_36"
        android:layout_marginEnd="@dimen/dp_36"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/massage_unactive"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_88"
        android:layout_marginTop="8dp"
        android:layout_marginStart="@dimen/dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/massage_active">
        <com.byd.base.view.BydSwitch
            android:id="@+id/carseat_massage_toggle"
            android:checked="false"
            app:splitTrack="true"
            app:switchMinWidth="@dimen/dp_56"
            app:thumbTintMode="src_over"
            app:track="@color/transparent_00"
            app:trackTint="@color/transparent_00"
            style="@style/carsetting_bydswitch_right_style"/>
        <TextView
            android:textSize="@dimen/sp_20"
            android:id="@+id/carseat_massage_toggle_tv"
            android:text="@string/vehiclesettings_carseat_massage_switch_active_tips"
            android:layout_toLeftOf="@+id/carseat_massage_toggle"
            style="@style/carsetting_switch_tv_right_style"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
