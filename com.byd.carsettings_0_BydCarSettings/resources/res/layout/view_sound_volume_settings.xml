<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/ll_media_volume_sound_pager"
        android:background="@drawable/bg_frame_gray_a"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_144"
        android:layout_marginTop="@dimen/dp_16">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_26"
            android:paddingStart="@dimen/dp_24"
            android:paddingEnd="@dimen/dp_24">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_main"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/media_volume_sound"
                android:layout_alignParentStart="true"/>
            <TextView
                android:id="@+id/tv_media_volume_sound_pager"
                android:layout_width="@dimen/dp_50"
                android:layout_height="wrap_content"
                style="@style/progress_value_text"/>
        </RelativeLayout>
        <com.byd.carsettings.ui.widget.AreaableSeekbar
            android:id="@+id/sbar_media_volume_sound_pager"
            android:paddingTop="@dimen/dp_16"
            android:paddingBottom="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_23"
            android:max="39"
            android:layout_marginStart="@dimen/dp_10"
            android:layout_marginEnd="@dimen/dp_10"
            android:min="0"
            style="@style/carsetting_seekbar_style"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/ll_phone_volume_sound_pager"
        android:background="@drawable/bg_frame_gray_a"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_144"
        android:layout_marginTop="@dimen/dp_16">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_26"
            android:paddingStart="@dimen/dp_24"
            android:paddingEnd="@dimen/dp_24">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_main"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/phone_volume_sound"
                android:layout_alignParentStart="true"/>
            <TextView
                android:id="@+id/tv_phone_volume_sound_pager"
                android:layout_width="@dimen/dp_50"
                android:layout_height="wrap_content"
                style="@style/progress_value_text"/>
        </RelativeLayout>
        <com.byd.carsettings.ui.widget.AreaableSeekbar
            android:id="@+id/sbar_phone_volume_sound_pager"
            android:paddingTop="@dimen/dp_16"
            android:paddingBottom="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_23"
            android:max="39"
            android:layout_marginStart="@dimen/dp_10"
            android:layout_marginEnd="@dimen/dp_10"
            android:min="5"
            style="@style/carsetting_seekbar_style"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/ll_ringtone_volume_sound_pager"
        android:background="@drawable/bg_frame_gray_a"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_144"
        android:layout_marginTop="@dimen/dp_16">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_26"
            android:paddingStart="@dimen/dp_24"
            android:paddingEnd="@dimen/dp_24">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_main"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ringtone_volume_sound"
                android:layout_alignParentStart="true"/>
            <TextView
                android:id="@+id/tv_ringtone_volume_sound_pager"
                android:layout_width="@dimen/dp_50"
                android:layout_height="wrap_content"
                style="@style/progress_value_text"/>
        </RelativeLayout>
        <com.byd.carsettings.ui.widget.AreaableSeekbar
            android:id="@+id/sbar_ringtone_volume_sound_pager"
            android:paddingTop="@dimen/dp_16"
            android:paddingBottom="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_23"
            android:max="39"
            android:layout_marginStart="@dimen/dp_10"
            android:layout_marginEnd="@dimen/dp_10"
            android:min="0"
            style="@style/carsetting_seekbar_style"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/ll_tts_volume_sound_pager"
        android:background="@drawable/bg_frame_gray_a"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_144"
        android:layout_marginTop="@dimen/dp_16">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_26"
            android:paddingStart="@dimen/dp_24"
            android:paddingEnd="@dimen/dp_24">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_main"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tts_volume_sound"
                android:layout_alignParentStart="true"/>
            <TextView
                android:id="@+id/tv_tts_volume_sound_pager"
                android:layout_width="@dimen/dp_50"
                android:layout_height="wrap_content"
                style="@style/progress_value_text"/>
        </RelativeLayout>
        <com.byd.carsettings.ui.widget.AreaableSeekbar
            android:id="@+id/sbar_tts_volume_sound_pager"
            android:paddingTop="@dimen/dp_16"
            android:paddingBottom="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_23"
            android:max="24"
            android:layout_marginStart="@dimen/dp_10"
            android:layout_marginEnd="@dimen/dp_10"
            android:min="5"
            style="@style/carsetting_seekbar_style"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/ll_navi_volume_sound_pager"
        android:background="@drawable/bg_frame_gray_a"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_144"
        android:layout_marginTop="@dimen/dp_16">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_26"
            android:paddingStart="@dimen/dp_24"
            android:paddingEnd="@dimen/dp_24">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_main"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/navi_volume_sound"
                android:layout_alignParentStart="true"/>
            <TextView
                android:id="@+id/tv_navi_volume_sound_pager"
                android:layout_width="@dimen/dp_50"
                android:layout_height="wrap_content"
                style="@style/progress_value_text"/>
        </RelativeLayout>
        <com.byd.carsettings.ui.widget.AreaableSeekbar
            android:id="@+id/sbar_navi_volume_sound_pager"
            android:paddingTop="@dimen/dp_16"
            android:paddingBottom="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_23"
            android:max="10"
            android:layout_marginStart="@dimen/dp_10"
            android:layout_marginEnd="@dimen/dp_10"
            android:min="0"
            style="@style/carsetting_seekbar_style"/>
    </LinearLayout>
</LinearLayout>
