<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingBottom="@dimen/dp_24"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_3">
        <ImageView
            android:id="@+id/iv_cloud_control_pager"
            android:layout_width="@dimen/dp_556"
            android:layout_height="@dimen/dp_468"
            android:src="@drawable/img_empty_cloud_control"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_cloud_control_pager"
        android:background="@drawable/bg_frame_gray_a"
        android:layout_width="@dimen/dp_640"
        android:layout_height="@dimen/dp_176"
        android:layout_marginTop="@dimen/dp_16">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_clairvoyant_cloud_control"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_88"
            android:paddingStart="@dimen/dp_24">
            <com.byd.base.view.BydSwitch
                android:id="@+id/switch_clairvoyant_cloud_control"
                style="@style/byd_switch"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_item_left_dilink_link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/clairvoyant_cloud_control"
                android:layout_marginStart="@dimen/dp_16"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_remote_location_cloud_control"
            android:layout_width="@dimen/dp_468"
            android:layout_height="@dimen/dp_88"
            android:paddingStart="@dimen/dp_24">
            <com.byd.base.view.BydSwitch
                android:id="@+id/switch_remote_location_cloud_control"
                style="@style/byd_switch"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_item_left_dilink_link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/remote_location_cloud_control"
                android:layout_marginStart="@dimen/dp_16"/>
            <ImageView
                android:id="@+id/iv_details_cloud_control_pager"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:src="@drawable/icon_public_details_48"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
