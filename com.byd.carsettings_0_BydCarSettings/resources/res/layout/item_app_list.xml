<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/dp_74">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_alignParentStart="true">
            <ImageView
                android:id="@+id/iv_app_icon_item_app_list"
                android:layout_width="@dimen/dp_56"
                android:layout_height="@dimen/dp_56"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_main_dilink_pagers"
                android:gravity="center_vertical"
                android:id="@+id/tv_app_name_item_app_list"
                android:layout_width="@dimen/dp_360"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:layout_alignParentTop="true"
                android:layout_marginStart="@dimen/dp_16"
                android:layout_toEndOf="@+id/iv_app_icon_item_app_list"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/text_color_item_right_dilink_link"
                android:gravity="center_vertical"
                android:id="@+id/tv_app_size_item_app_list"
                android:layout_width="@dimen/dp_360"
                android:layout_height="@dimen/dp_28"
                android:layout_marginBottom="@dimen/dp_16"
                android:layout_below="@+id/tv_app_name_item_app_list"
                android:layout_alignStart="@+id/tv_app_name_item_app_list"/>
        </RelativeLayout>
        <ImageView
            android:background="@drawable/icon_public_rightarrow_48"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp_22"
            android:layout_alignParentEnd="true"/>
        <View
            android:id="@+id/v_line_app_list"
            android:background="@color/bg_color_line"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_40"/>
    </RelativeLayout>
</LinearLayout>
