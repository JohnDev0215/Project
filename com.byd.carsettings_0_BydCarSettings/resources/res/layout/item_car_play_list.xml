<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_60"
    android:minHeight="@dimen/dp_60"
    android:layout_marginEnd="@dimen/dp_20">
    <View
        android:id="@+id/v_item_bg_checked_item_car_play_list"
        android:background="@drawable/bg_frame_blue_content_carplay"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_toStartOf="@+id/ll_icon"
        android:layout_alignParentStart="true">
        <ImageView
            android:id="@+id/iv_device_type_item_car_play_list"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/cp_aa_device_text_selector"
            android:ellipsize="end"
            android:id="@+id/tv_device_name_item_car_play_list"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true">
        <ImageView
            android:id="@+id/iv_usb_state_item_car_play_list"
            android:background="@drawable/icon_public_usb_sinal_48"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"/>
        <ImageView
            android:id="@+id/iv_phone_state_item_car_play_list"
            android:background="@drawable/icon_phone_48"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"/>
        <ImageView
            android:id="@+id/iv_wifi_state_item_car_play_list"
            android:background="@drawable/icon_public_wifi_sinal_48"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"/>
        <ImageView
            android:id="@+id/iv_bt_state_item_car_play_list"
            android:background="@drawable/icon_public_bt_sinal_48"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"/>
        <ImageView
            android:id="@+id/iv_delete_item_car_play_list"
            android:background="@drawable/icon_public_trash_48"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"/>
    </LinearLayout>
    <View
        android:background="@color/bg_color_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
