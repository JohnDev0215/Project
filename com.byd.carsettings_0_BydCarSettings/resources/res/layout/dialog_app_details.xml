<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="@dimen/dp_560"
    android:layout_height="@dimen/dp_544"
    android:splitMotionEvents="false"
    android:windowEnableSplitTouch="false"
    style="@style/vehicle_setting_dialog_background_container">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_71">
        <ImageView
            android:id="@+id/iv_back_dialog_app_details"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:src="@drawable/icon_public_leftarrow_48"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="@dimen/sp_20"
            android:textStyle="bold"
            android:textColor="@color/text_color_main_dilink_pagers"
            android:gravity="center"
            android:id="@+id/tv_title_dialog_app_details"
            android:layout_width="@dimen/dp_512"
            android:layout_height="@dimen/dp_29"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <View
        android:background="@color/bg_color_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ScrollView
            android:scrollbarThumbVertical="@drawable/bar_thumb"
            android:scrollbarTrackVertical="@drawable/bar_track"
            android:orientation="vertical"
            android:id="@+id/app_detail_sv"
            android:paddingBottom="@dimen/dp_40"
            android:scrollbars="vertical"
            android:fadingEdge="vertical"
            android:fadingEdgeLength="@dimen/dp_44"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:requiresFadingEdge="vertical"
            android:layout_marginEnd="@dimen/dp_11">
            <include layout="@layout/subview_app_details"/>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
