<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout xmlns:app="http://schemas.android.com/apk/res-auto"
        android:gravity="center"
        android:background="@drawable/bg_frame_gray_a"
        android:layout_width="@dimen/dp_490"
        android:layout_height="@dimen/dp_144"
        android:minWidth="@dimen/dp_490"
        android:minHeight="@dimen/dp_144"
        android:layout_centerInParent="true"
        android:paddingStart="@dimen/dp_24">
        <RelativeLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_0_card_2_switch"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_56">
            <com.byd.base.view.BydSwitch
                android:id="@+id/switch_0_card_2_switch"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                style="@style/byd_switch"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_item_left_dilink_link"
                android:id="@+id/tv_title_0_card_2_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/dp_16"
                android:layout_toEndOf="@+id/switch_0_card_2_switch"/>
            <com.byd.mvp.ui.widget.TintImageView
                android:id="@+id/iv_arrow_0_card_2_switch"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:src="@drawable/icon_public_rightarrow_48"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                app:color_close_state="@color/color_invalid"
                app:color_open_state="@color/text_color_main"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_item_left_dilink_link"
                android:id="@+id/tv_value_0_card_2_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/iv_arrow_0_card_2_switch"/>
        </RelativeLayout>
        <RelativeLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_0_card_1_switch"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_56"
            android:layout_below="@+id/ll_0_card_2_switch"
            android:layout_alignStart="@+id/ll_0_card_2_switch">
            <com.byd.base.view.BydSwitch
                android:id="@+id/switch_1_card_2_switch"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                style="@style/byd_switch"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_item_left_dilink_link"
                android:id="@+id/tv_title_1_card_2_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/dp_16"
                android:layout_toEndOf="@+id/switch_1_card_2_switch"/>
            <com.byd.mvp.ui.widget.TintImageView
                android:id="@+id/iv_arrow_1_card_2_switch"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:src="@drawable/icon_public_rightarrow_48"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                app:color_close_state="@color/color_invalid"
                app:color_open_state="@color/text_color_main"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_item_left_dilink_link"
                android:id="@+id/tv_value_1_card_2_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/iv_arrow_1_card_2_switch"/>
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>
