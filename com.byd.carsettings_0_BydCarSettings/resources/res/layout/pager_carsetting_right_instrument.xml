<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/instrument_image_container"
        style="@style/vehicle_setting_right_car_image_port_style">
        <ImageView
            android:id="@+id/instrument_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </RelativeLayout>
    <com.bydux.api.common.views.window.DampingScrollView
        android:id="@+id/nsw"
        android:layout_below="@+id/instrument_image_container"
        style="@style/vehicle_setting_right_module_damping_scrollView_port_style">
        <LinearLayout style="@style/vehicle_setting_right_module_damping_scrollView_child_port_style">
            <RelativeLayout
                android:id="@+id/instrument_height"
                android:layout_height="@dimen/dp_136"
                android:layout_marginBottom="@dimen/dp_16"
                style="@style/vehicle_setting_background_container">
                <SeekBar
                    android:id="@+id/instrument_back_door_sb"
                    android:layout_marginTop="@dimen/dp_16"
                    android:layout_marginBottom="@dimen/dp_26"
                    android:max="11"
                    android:layout_below="@+id/instrument_hight_percent"
                    android:layout_alignParentBottom="true"
                    android:layout_marginStart="@dimen/dp_6"
                    android:layout_marginEnd="@dimen/dp_6"
                    android:min="1"
                    style="@style/vehicle_setting_right_seekbar_style"/>
                <TextView
                    android:id="@+id/instrument_hight_percent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/dp_50"
                    android:textAlignment="textEnd"
                    android:layout_marginEnd="@dimen/dp_33"
                    android:layout_toEndOf="@+id/instrument_brightness_tv"
                    style="@style/vehicle_setting_right_seekbar_progress_tv_style"/>
                <TextView
                    android:id="@+id/instrument_brightness_tv"
                    android:text="@string/vehiclesettings_instrument_brightness_adjust"
                    style="@style/vehicle_setting_right_seekbar_title_tv_style"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/instrument_navi_display_container"
                style="@style/vehicle_setting_right_tv_seg_container_style">
                <TextView
                    android:id="@+id/instrument_navi_display_tv"
                    android:text="@string/vehiclesettings_instrument_navigation_display"
                    style="@style/vehicle_setting_right_tv_seg_tv_style"/>
                <com.byd.base.view.segmentedbutton.SegmentedButtonGroup
                    android:id="@+id/instrument_nav_segmentedButtonGroup"
                    android:layout_below="@+id/instrument_navi_display_tv"
                    style="@style/vehicle_setting_right_tv_seg_seg_style">
                    <com.byd.base.view.segmentedbutton.SegmentedButton
                        app:sb_text="@string/vehiclesettings_close"
                        style="@style/vehicle_setting_right_tv_seg_seg_btn_style"/>
                    <com.byd.base.view.segmentedbutton.SegmentedButton
                        app:sb_text="@string/vehiclesettings_instrument_navigation_display_simple"
                        style="@style/vehicle_setting_right_tv_seg_seg_btn_style"/>
                    <com.byd.base.view.segmentedbutton.SegmentedButton
                        app:sb_text="@string/vehiclesettings_instrument_navigation_display_screen_small"
                        style="@style/vehicle_setting_right_tv_seg_seg_btn_style"/>
                    <com.byd.base.view.segmentedbutton.SegmentedButton
                        app:sb_text="@string/vehiclesettings_instrument_navigation_display_screen_full"
                        style="@style/vehicle_setting_right_tv_seg_seg_btn_style"/>
                </com.byd.base.view.segmentedbutton.SegmentedButtonGroup>
                <com.byd.base.view.segmentedbutton.SegmentedButtonGroup
                    android:id="@+id/instrument_nav_segmentedButtonGroup_without_small"
                    android:layout_below="@+id/instrument_navi_display_tv"
                    style="@style/vehicle_setting_right_tv_seg_seg_style">
                    <com.byd.base.view.segmentedbutton.SegmentedButton
                        app:sb_text="@string/vehiclesettings_close"
                        style="@style/vehicle_setting_right_tv_seg_seg_btn_style"/>
                    <com.byd.base.view.segmentedbutton.SegmentedButton
                        app:sb_text="@string/vehiclesettings_instrument_navigation_display_simple"
                        style="@style/vehicle_setting_right_tv_seg_seg_btn_style"/>
                    <com.byd.base.view.segmentedbutton.SegmentedButton
                        app:sb_text="@string/vehiclesettings_instrument_navigation_display_screen_full"
                        style="@style/vehicle_setting_right_tv_seg_seg_btn_style"/>
                </com.byd.base.view.segmentedbutton.SegmentedButtonGroup>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/instrument_miles_display_container"
                android:paddingBottom="@dimen/dp_18"
                android:layout_marginBottom="@dimen/dp_16"
                style="@style/vehicle_setting_background_container">
                <TextView
                    android:id="@+id/instrument_miles_display_tv"
                    android:text="@string/vehiclesettings_instrument_miles_always_display"
                    style="@style/vehicle_setting_right_tv_seg_tv_style"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/instrument_miles_display_rv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:layout_below="@+id/instrument_miles_display_tv"
                    android:overScrollMode="never"
                    android:layout_marginStart="@dimen/dp_12"
                    android:layout_marginEnd="@dimen/dp_12"/>
                <RelativeLayout
                    android:id="@+id/instrument_miles_display_clear_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/dp_60"
                    android:layout_below="@+id/instrument_miles_display_rv">
                    <TextView
                        android:textSize="@dimen/sp_18"
                        android:id="@+id/instrument_miles_display_clear_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/dp_24"
                        android:layout_toStartOf="@+id/instrument_miles_display_clear_btn"
                        android:layout_alignParentStart="true"/>
                    <Button
                        android:textSize="@dimen/sp_18"
                        android:textColor="@color/btn_only_unselected"
                        android:id="@+id/instrument_miles_display_clear_btn"
                        android:background="@drawable/vehicle_selector_dialog_white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="@dimen/dp_128"
                        android:minHeight="@dimen/dp_40"
                        android:text="@string/vehiclesettings_instrument_miles_clear"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="@dimen/dp_24"
                        android:layout_alignParentEnd="true"
                        android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"/>
                </RelativeLayout>
            </RelativeLayout>
        </LinearLayout>
    </com.bydux.api.common.views.window.DampingScrollView>
</RelativeLayout>
