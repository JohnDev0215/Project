<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ambient_dialog_bg"
    android:layout_width="@dimen/dp_262"
    android:layout_height="@dimen/dp_321">
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/instrument_speed_remind_unitTextColor"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_27"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.byd.carsettings.ui.view.roundview.BydRoundView
        android:id="@+id/roundView"
        android:layout_width="@dimen/dp_188"
        android:layout_height="@dimen/dp_188"
        app:center_textColor="#ff45a2ff"
        app:center_textsize="@dimen/sp_16"
        app:click_background="@array/arcarray"
        app:dot_distance="@dimen/dp_75"
        app:dot_radius="@dimen/dp_6"
        app:dot_stance="@dimen/dp_8"
        app:dot_text_distance="@dimen/dp_7"
        app:img_down="@drawable/icon_public_downarrow"
        app:img_h_margin="@dimen/dp_5"
        app:img_height="@dimen/dp_20"
        app:img_left="@drawable/icon_public_add"
        app:img_right="@drawable/icon_public_subtaract"
        app:img_up="@drawable/icon_public_uparrow"
        app:img_v_margin="@dimen/dp_5"
        app:img_width="@dimen/dp_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:level_count="3"
        app:mode_level_textColor="@color/instrument_speed_remind_unitTextColor"
        app:mode_level_textsize="@dimen/sp_14"
        app:mode_selected_color="#ff45a2ff"
        app:mode_unSelected_color="@color/massage_dot_unselected"/>
    <CheckBox
        android:textSize="@dimen/sp_16"
        android:textColor="@color/instrument_speed_remind_unitTextColor"
        android:id="@+id/tips_cb"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_11"
        android:layout_alignParentStart="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/roundView"/>
</androidx.constraintlayout.widget.ConstraintLayout>
