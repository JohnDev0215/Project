<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="@dimen/dp_560"
    android:layout_height="@dimen/dp_544"
    style="@style/vehicle_setting_dialog_background_container">
    <ImageView
        android:id="@+id/iv_app_icon_app_uninstall"
        android:layout_width="@dimen/dp_72"
        android:layout_height="@dimen/dp_72"
        android:layout_marginTop="@dimen/dp_48"/>
    <LinearLayout
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_90">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/text_color_main_dilink_pagers"
            android:id="@+id/tv_msg_app_uninstall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/ll_opertion_bottom"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_104">
        <com.byd.carsettings.ui.widget.BydInvalidButton
            android:textSize="@dimen/sp_18"
            android:textColor="@color/dialog_btn_text_white_selector"
            android:id="@+id/btn_ok_app_uninstall"
            android:background="@drawable/selector_dialog_blue"
            android:layout_width="@dimen/dp_176"
            android:layout_height="@dimen/dp_48"
            android:text="@string/uninstall_app_details"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/dp_24"
            android:layout_marginEnd="@dimen/dp_24"
            android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"/>
        <com.byd.carsettings.ui.widget.BydInvalidButton
            android:textSize="@dimen/sp_18"
            android:textColor="@color/dialog_btn_text_gray_selector"
            android:id="@+id/btn_cancel_app_uninstall"
            android:background="@drawable/selector_dialog_white"
            android:layout_width="@dimen/dp_176"
            android:layout_height="@dimen/dp_48"
            android:text="@string/dialog_btn_cancel"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/dp_24"
            android:layout_marginEnd="@dimen/dp_24"
            android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"/>
    </LinearLayout>
</LinearLayout>
