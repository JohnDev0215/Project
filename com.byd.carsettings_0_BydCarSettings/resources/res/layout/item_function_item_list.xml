<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/dp_88">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/dp_24">
        <RelativeLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingEnd="@dimen/dp_58"
            android:layout_alignParentStart="true">
            <com.byd.mvp.ui.widget.TintImageView
                android:id="@+id/iv_function_icon_item_list"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                app:color_close_state="@color/bg_state_err"
                app:color_open_state="@color/bg_state_open"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_main_dilink_pagers"
                android:gravity="center_vertical"
                android:id="@+id/tv_function_name_item_list"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_15"
                android:layout_alignParentTop="true"
                android:layout_marginStart="@dimen/dp_8"
                android:layout_toEndOf="@+id/iv_function_icon_item_list"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/text_color_gray_search"
                android:id="@+id/tv_function_address_item_list"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_28"
                android:layout_marginTop="@dimen/dp_3"
                android:layout_marginBottom="@dimen/dp_15"
                android:layout_below="@+id/tv_function_name_item_list"
                android:layout_alignStart="@+id/tv_function_name_item_list"/>
            <View
                android:id="@+id/v_line_same_type_function_item_list"
                android:background="@color/bg_color_line_search"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_1"
                android:layout_alignParentTop="true"
                android:layout_alignStart="@+id/tv_function_name_item_list"/>
        </RelativeLayout>
        <ImageView
            android:background="@drawable/icon_public_rightarrow_48"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp_10"
            android:layout_alignParentEnd="true"/>
        <View
            android:id="@+id/v_line_function_item_list"
            android:background="@color/bg_color_line_search"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:layout_alignParentTop="true"
            android:layout_marginEnd="@dimen/dp_30"/>
    </RelativeLayout>
</LinearLayout>
