<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/digital_key_item_bg"
    android:paddingTop="@dimen/dp_17"
    android:paddingBottom="@dimen/dp_38"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/dp_24"
    android:paddingEnd="@dimen/dp_14">
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="@color/nfc_key_type_color"
        android:id="@+id/key_user_name_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_38"/>
    <ImageView
        android:id="@+id/iv_key_trash"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        android:src="@drawable/icon_dark_public_trash_48"
        android:layout_alignParentEnd="true"/>
    <ImageView
        android:id="@+id/key_icon"
        android:layout_width="@dimen/dp_100"
        android:layout_height="@dimen/dp_100"
        android:src="@drawable/img_dark_carsetting_digital_key_android_1"
        android:layout_below="@+id/key_user_name_tv"
        android:layout_marginEnd="@dimen/dp_14"/>
    <LinearLayout
        android:id="@+id/ll_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/key_user_name_tv"
        android:paddingEnd="@dimen/dp_48"
        android:layout_toEndOf="@+id/key_icon">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/white_text"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/key_type_name_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:lines="1"
            android:layout_weight="1"
            android:paddingEnd="@dimen/dp_24"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/white_text"
            android:gravity="center"
            android:id="@+id/key_change_tv"
            android:background="@drawable/digital_key_change_btn_bg"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_32"
            android:text="@string/nfc_change_phone"
            android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"
            android:paddingHorizontal="@dimen/dp_17"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="@color/digital_key_add_phone_des"
        android:id="@+id/key_type_model_tv"
        android:paddingTop="@dimen/dp_4"
        android:paddingBottom="@dimen/dp_9"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/ll_name"
        android:layout_toEndOf="@+id/key_icon"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_48"
        android:layout_below="@+id/key_type_model_tv"
        android:layout_toEndOf="@+id/key_icon">
        <ImageView
            android:id="@+id/iv_nfc"
            android:visibility="visible"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:src="@drawable/img_carsetting_nfc"
            android:layout_marginEnd="@dimen/dp_8"/>
        <ImageView
            android:id="@+id/iv_bt"
            android:visibility="gone"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:src="@drawable/img_carsetting_ble"
            android:layout_marginEnd="@dimen/dp_8"/>
        <ImageView
            android:id="@+id/iv_uwb"
            android:visibility="gone"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:src="@drawable/img_carsetting_uwb"/>
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/digital_key_add_phone_des"
            android:gravity="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_youxiao_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingEnd="@dimen/dp_16"/>
    </LinearLayout>
</RelativeLayout>
