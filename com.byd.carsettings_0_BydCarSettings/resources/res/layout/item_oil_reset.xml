<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="start|center_vertical"
    android:orientation="horizontal"
    android:layout_width="@dimen/dp_542"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dp_16"
    android:paddingStart="@dimen/dp_39"
    android:paddingEnd="@dimen/dp_39">
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="?attr/text_color_main"
        android:gravity="start"
        android:id="@+id/tv_oil_item"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="?attr/text_color_main_white"
        android:gravity="end|center_vertical"
        android:id="@+id/tv_oil_percent"
        android:layout_width="@dimen/dp_60"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_reset"
        android:background="@drawable/shape_bg_reset_button"
        android:layout_width="@dimen/dp_120"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/dp_32"
        android:layout_marginStart="@dimen/dp_32"
        android:stateListAnimator="@drawable/anim_btn_scale_alpha">
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="?attr/dialog_reset_text"
            android:gravity="center"
            android:id="@+id/tv_reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/carhealthy_oil_reset"/>
        <ProgressBar
            android:id="@+id/progressbar_resetting"
            android:visibility="gone"
            android:layout_width="@dimen/dp_20"
            android:layout_height="@dimen/dp_20"
            android:indeterminateDrawable="@drawable/progressbar_bg"/>
    </LinearLayout>
</LinearLayout>
