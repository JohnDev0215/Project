<?xml version="1.0" encoding="utf-8"?>
<com.byd.dipilot.widget.MaxHeightLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_view_group"
    android:tag="layout/dialog_adas_common_0"
    android:layout_width="@dimen/dp_560"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/sp_20"
        android:textStyle="bold"
        android:textColor="@color/text_color_main_dilink_pagers"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tv_title"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_71"
        android:maxWidth="@dimen/dp_500"/>
    <View
        android:id="@+id/view_line"
        android:tag="binding_2"
        android:background="@color/dialog_divider_common"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"/>
    <androidx.core.widget.NestedScrollView
        android:scrollbarThumbVertical="@drawable/setting_bar_thumb"
        android:scrollbarTrackVertical="@drawable/setting_bar_track"
        android:scrollbarStyle="insideOverlay"
        android:layout_gravity="center_horizontal"
        android:paddingTop="@dimen/dp_40"
        android:scrollbars="vertical"
        android:layout_width="@dimen/dp_560"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="top|center_horizontal"
            android:orientation="vertical"
            android:id="@+id/ll_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="?attr/dialog_text_color_main"
                android:id="@+id/tv_content"
                android:tag="binding_3"
                android:layout_width="@dimen/dp_464"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="?attr/dialog_text_color_tips"
                android:id="@+id/tv_notice"
                android:tag="binding_4"
                android:layout_width="@dimen/dp_464"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_btn_container"
        android:tag="binding_5"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_104">
        <com.byd.dipilot.widget.CountDownButton
            android:textSize="@dimen/sp_18"
            android:id="@+id/btn_ok"
            android:tag="binding_6"
            android:layout_width="@dimen/dp_176"
            android:layout_height="@dimen/dp_48"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/dp_24"
            android:layout_marginEnd="@dimen/dp_24"
            android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"
            app:duration="0"
            app:text="@string/dipilot_common_dialog_confirm"/>
        <Button
            android:textSize="@dimen/sp_18"
            android:textColor="@color/dialog_btn_text_gray_selector"
            android:id="@+id/btn_cancel"
            android:tag="binding_7"
            android:background="@drawable/selector_dialog_white"
            android:layout_width="@dimen/dp_176"
            android:layout_height="@dimen/dp_48"
            android:text="@string/dipilot_common_dialog_cancel"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/dp_24"
            android:layout_marginEnd="@dimen/dp_24"
            android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"/>
    </LinearLayout>
</com.byd.dipilot.widget.MaxHeightLinearLayout>
