<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:layout_width="@dimen/dp_560"
    android:layout_height="wrap_content"
    style="@style/vehicle_setting_dialog_background_container">
    <TextView
        android:textSize="@dimen/sp_20"
        android:textStyle="bold"
        android:textColor="@color/dialog_title"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_69"
        android:layout_marginTop="@dimen/dp_2"
        android:text="@string/dipilot_title_dialog_hint"
        android:maxLines="2"
        android:layout_marginStart="@dimen/dp_24"
        android:layout_marginEnd="@dimen/dp_24"/>
    <View
        android:id="@+id/view_line"
        android:background="@color/dialog_divider_common"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"/>
    <com.bydux.api.common.views.window.DampingScrollView
        android:id="@+id/dampingScrollView_dialog"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:id="@+id/ll_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/dp_112">
            <TextView
                android:scrollbarSize="@dimen/dp_4"
                android:scrollbarThumbVertical="@drawable/bar_thumb"
                android:scrollbarTrackVertical="@drawable/bar_track"
                android:scrollbarStyle="outsideInset"
                android:textSize="@dimen/sp_20"
                android:textColor="@color/dialog_text_color_main"
                android:id="@+id/tv_message"
                android:scrollbars="vertical"
                android:fadingEdge="vertical"
                android:fadingEdgeLength="@dimen/dp_24"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_24"
                android:maxHeight="@dimen/dp_312"
                android:minHeight="@dimen/dp_112"
                android:requiresFadingEdge="vertical"
                android:paddingStart="@dimen/dp_39"
                android:paddingEnd="@dimen/dp_35"
                android:layout_marginStart="@dimen/dp_9"
                android:layout_marginEnd="@dimen/dp_9"/>
        </LinearLayout>
    </com.bydux.api.common.views.window.DampingScrollView>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_opertion_bottom_byd_dialog_simple"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_104">
        <com.byd.carsettings.ui.widget.BydInvalidButton
            android:textSize="@dimen/sp_18"
            android:textColor="@color/dialog_btn_text_white_selector"
            android:id="@+id/btn_ok"
            android:background="@drawable/selector_dialog_blue"
            android:layout_width="@dimen/dp_176"
            android:layout_height="@dimen/dp_48"
            android:text="@string/dialog_btn_ok"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/dp_24"
            android:layout_marginEnd="@dimen/dp_24"
            android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"/>
        <com.byd.carsettings.ui.widget.BydInvalidButton
            android:textSize="@dimen/sp_18"
            android:textColor="@color/dialog_btn_text_gray_selector"
            android:id="@+id/btn_cancel"
            android:background="@drawable/selector_dialog_white"
            android:layout_width="@dimen/dp_176"
            android:layout_height="@dimen/dp_48"
            android:text="@string/dialog_btn_cancel"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/dp_24"
            android:layout_marginEnd="@dimen/dp_24"
            android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"/>
    </LinearLayout>
</LinearLayout>
