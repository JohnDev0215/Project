<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/dp_560"
    android:layout_height="@dimen/dp_544"
    style="@style/vehicle_setting_dialog_background_container">
    <RelativeLayout
        android:id="@+id/rl_title_dialog_accessibility_app_list"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_71"
        android:layout_alignParentTop="true">
        <ImageView
            android:id="@+id/iv_back_dialog_accessibility_app_list"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:src="@drawable/icon_public_close_48"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/text_color_main_dilink_pagers"
            android:gravity="center"
            android:id="@+id/tv_title_dialog_accessibility_app_list"
            android:layout_width="@dimen/dp_512"
            android:layout_height="@dimen/dp_29"
            android:text="@string/accessibility_app_manage"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <View
        android:id="@+id/v_line_dialog_accessibility_app_list"
        android:background="@color/bg_color_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_below="@+id/rl_title_dialog_accessibility_app_list"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/text_color_main_gray"
        android:id="@+id/tv_hint_dialog_accessibility_app_list"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:text="@string/hint_accessibility_dialog"
        android:layout_below="@+id/v_line_dialog_accessibility_app_list"
        android:layout_marginStart="@dimen/dp_48"/>
    <RelativeLayout
        android:id="@+id/rl_data_show_dialog_accessibility_app_list"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_405"
        android:layout_marginTop="@dimen/dp_10"
        android:layout_below="@+id/tv_hint_dialog_accessibility_app_list">
        <androidx.recyclerview.widget.RecyclerView
            android:scrollbarSize="@dimen/dp_4"
            android:scrollbarThumbVertical="@color/bg_color_scrollbar_thumb"
            android:scrollbarTrackVertical="@color/bg_color_scrollbar_track"
            android:id="@+id/rcv_dialog_accessibility_app_list"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="always"
            android:paddingStart="@dimen/dp_24"
            android:paddingEnd="@dimen/dp_9"/>
        <View
            android:background="@drawable/shape_gradient_top_disable_self_start"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_20"
            android:layout_alignParentTop="true"
            android:layout_marginStart="@dimen/dp_10"
            android:layout_marginEnd="@dimen/dp_10"/>
        <View
            android:background="@drawable/shape_gradient_bottom_disable_self_start"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_20"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/dp_10"
            android:layout_marginEnd="@dimen/dp_10"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_no_data_show_dialog_accessibility_app_list"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_405"
        android:layout_below="@+id/v_line_dialog_accessibility_app_list">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <ImageView
                android:background="@drawable/img_media_music_playlist_empty"
                android:layout_width="@dimen/dp_208"
                android:layout_height="@dimen/dp_208"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/text_color_main_gray"
                android:gravity="center"
                android:id="@+id/tv_no_data_dialog_accessibility_app_list"
                android:layout_width="@dimen/dp_272"
                android:layout_height="@dimen/dp_24"
                android:text="@string/no_data_app_permission_app_manage"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
