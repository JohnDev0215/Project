<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <WebView
        android:scrollbarThumbVertical="@drawable/base_bar_thumb"
        android:scrollbarTrackVertical="@drawable/base_bar_track"
        android:id="@+id/user_agreement_wv"
        android:fadingEdge="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:layerType="software"
        android:layout_marginStart="@dimen/dp_30"
        android:layout_marginEnd="@dimen/dp_30"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="@dimen/dp_20"
        android:paddingBottom="@dimen/dp_90"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <CheckBox
            android:textSize="@dimen/sp_16"
            android:gravity="center"
            android:id="@+id/ua_checkbox"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_40"
            android:button="@drawable/checkbox_style"
            android:text="@string/nfc_user_agreement_has_read"/>
        <com.byd.base.view.MultiStyleTextView
            android:enabled="false"
            android:textSize="@dimen/sp_18"
            android:textColor="@color/base_btn_text_selector"
            android:gravity="center"
            android:id="@+id/ua_add_digital_key_btn"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_20"
            android:minWidth="@dimen/dp_144"
            android:text="@string/nfc_ua_back"
            android:paddingStart="@dimen/dp_12"
            android:paddingEnd="@dimen/dp_12"/>
    </LinearLayout>
</LinearLayout>
