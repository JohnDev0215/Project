<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_frame_gray_a"
        android:layout_width="@dimen/dp_490"
        android:layout_height="@dimen/dp_144"
        android:minWidth="@dimen/dp_490"
        android:minHeight="@dimen/dp_144"
        android:layout_centerHorizontal="true"
        android:paddingStart="@dimen/dp_24">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_26"
            android:layout_marginBottom="@dimen/dp_23">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_main"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"/>
        </RelativeLayout>
        <com.byd.base.view.segmentedbutton.SegmentedButtonGroup
            android:layout_gravity="center_vertical"
            android:id="@+id/srg_card_al_area"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dp_23"
            style="@style/carsetting_segment_button_group_style">
            <com.byd.base.view.segmentedbutton.SegmentedButton
                android:id="@+id/area_whole"
                android:layout_width="@dimen/dp_110"
                android:layout_height="@dimen/dp_40"
                app:sb_textColor="@color/carlights_guest_color"
                app:sb_textColor_onSelection="@color/white"
                app:sb_textSize="@dimen/sp_20"/>
            <com.byd.base.view.segmentedbutton.SegmentedButton
                android:id="@+id/area_front"
                android:layout_width="@dimen/dp_110"
                android:layout_height="@dimen/dp_40"
                app:sb_textColor="@color/carlights_guest_color"
                app:sb_textColor_onSelection="@color/white"
                app:sb_textSize="@dimen/sp_20"/>
            <com.byd.base.view.segmentedbutton.SegmentedButton
                android:id="@+id/area_rear"
                android:layout_width="@dimen/dp_110"
                android:layout_height="@dimen/dp_40"
                app:sb_textColor="@color/carlights_guest_color"
                app:sb_textColor_onSelection="@color/white"
                app:sb_textSize="@dimen/sp_20"/>
            <com.byd.base.view.segmentedbutton.SegmentedButton
                android:id="@+id/area_ring_sb"
                android:layout_width="@dimen/dp_110"
                android:layout_height="@dimen/dp_40"
                app:sb_textColor="@color/carlights_guest_color"
                app:sb_textColor_onSelection="@color/white"
                app:sb_textSize="@dimen/sp_20"/>
        </com.byd.base.view.segmentedbutton.SegmentedButtonGroup>
    </LinearLayout>
</RelativeLayout>
