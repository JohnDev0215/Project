<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingEnd="@dimen/dp_9">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dp_52">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textColor="@color/text_color_statistics"
                    android:gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/size_used_storage_app_manage"/>
                <TextView
                    android:textSize="@dimen/sp_18"
                    android:textColor="@color/text_color_main_dilink_pagers"
                    android:id="@+id/tv_size_used_disk_statistics"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="@dimen/dp_90"
                    android:maxHeight="@dimen/dp_40"
                    android:hint="@string/calculating_app_manage"
                    android:layout_marginStart="@dimen/dp_10"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/dp_57">
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textColor="@color/text_color_statistics"
                    android:gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/size_not_used_storage_app_manage"/>
                <TextView
                    android:textSize="@dimen/sp_18"
                    android:textColor="@color/text_color_main_dilink_pagers"
                    android:id="@+id/tv_size_not_used_disk_statistics"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="@dimen/dp_90"
                    android:maxHeight="@dimen/dp_40"
                    android:hint="@string/calculating_app_manage"
                    android:layout_marginStart="@dimen/dp_10"/>
            </LinearLayout>
        </LinearLayout>
        <com.byd.mvp.ui.widget.DiskStatisticsView
            android:id="@+id/dsv_disk_statistics"
            android:layout_width="@dimen/dp_454"
            android:layout_height="@dimen/dp_24"
            android:layout_marginTop="@dimen/dp_16"
            app:bg_small_ring="@color/bg_small_ring_storage"
            app:color_not_use="@color/available_color_strip_storage"
            app:ring_size="@dimen/dp_20"
            app:rx="@dimen/dp_5"
            app:ry="@dimen/dp_5"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_24">
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/text_color_statistics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/total_size_storage_app_manage"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/text_color_main_dilink_pagers"
                android:id="@+id/tv_total_size_disk_statistics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="@string/calculating_app_manage"
                android:layout_marginStart="@dimen/dp_10"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dp_52"
        android:paddingEnd="@dimen/dp_24">
        <RelativeLayout
            android:layout_width="@dimen/dp_460"
            android:layout_height="@dimen/dp_74"
            android:layout_marginTop="@dimen/dp_20">
            <View
                android:id="@+id/v_tag_available_disk_statistics"
                android:background="@color/available_color_strip_storage"
                android:layout_width="@dimen/dp_17"
                android:layout_height="@dimen/dp_16"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/text_color_main"
                android:id="@+id/tv_available_disk_statistics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/available_storage_app_manage"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/dp_19"
                android:layout_toEndOf="@+id/v_tag_available_disk_statistics"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/text_color_main_gray"
                android:gravity="end"
                android:id="@+id/tv_available_size_disk_statistics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="@string/calculating_app_manage"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <View
            android:background="@color/bg_color_line"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"/>
        <RelativeLayout
            android:layout_width="@dimen/dp_460"
            android:layout_height="@dimen/dp_74">
            <View
                android:id="@+id/v_tag_app_disk_statistics"
                android:background="@color/app_color_strip_storage"
                android:layout_width="@dimen/dp_17"
                android:layout_height="@dimen/dp_16"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/text_color_main"
                android:id="@+id/tv_app_disk_statistics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/dp_300"
                android:text="@string/app_storage_app_manage"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/dp_19"
                android:layout_toEndOf="@+id/v_tag_app_disk_statistics"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/text_color_main_gray"
                android:gravity="end"
                android:id="@+id/tv_app_size_disk_statistics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="@string/calculating_app_manage"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <View
            android:background="@color/bg_color_line"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"/>
        <RelativeLayout
            android:layout_width="@dimen/dp_460"
            android:layout_height="@dimen/dp_74">
            <View
                android:id="@+id/v_tag_media_disk_statistics"
                android:background="@color/media_color_strip_storage"
                android:layout_width="@dimen/dp_17"
                android:layout_height="@dimen/dp_16"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/text_color_main"
                android:id="@+id/tv_media_disk_statistics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/media_storage_app_manage"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/dp_19"
                android:layout_toEndOf="@+id/v_tag_media_disk_statistics"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/text_color_main_gray"
                android:gravity="end"
                android:id="@+id/tv_media_size_disk_statistics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="@string/calculating_app_manage"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <View
            android:background="@color/bg_color_line"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"/>
        <RelativeLayout
            android:layout_width="@dimen/dp_460"
            android:layout_height="@dimen/dp_74">
            <View
                android:id="@+id/v_tag_download_disk_statistics"
                android:background="@color/download_color_strip_storage"
                android:layout_width="@dimen/dp_17"
                android:layout_height="@dimen/dp_16"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/text_color_main"
                android:id="@+id/tv_download_disk_statistics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/download_storage_app_manage"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/dp_19"
                android:layout_toEndOf="@+id/v_tag_download_disk_statistics"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/text_color_main_gray"
                android:gravity="end"
                android:id="@+id/tv_download_size_disk_statistics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="@string/calculating_app_manage"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <View
            android:background="@color/bg_color_line"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"/>
        <RelativeLayout
            android:layout_width="@dimen/dp_460"
            android:layout_height="@dimen/dp_74">
            <View
                android:id="@+id/v_tag_cache_disk_statistics"
                android:background="@color/cache_color_strip_storage"
                android:layout_width="@dimen/dp_17"
                android:layout_height="@dimen/dp_16"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/text_color_main"
                android:id="@+id/tv_cache_disk_statistics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cache_data_app_manage"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/dp_19"
                android:layout_toEndOf="@+id/v_tag_cache_disk_statistics"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/text_color_main_gray"
                android:gravity="end"
                android:id="@+id/tv_cache_size_disk_statistics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="@string/calculating_app_manage"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <View
            android:background="@color/bg_color_line"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"/>
        <RelativeLayout
            android:layout_width="@dimen/dp_460"
            android:layout_height="@dimen/dp_74">
            <View
                android:id="@+id/v_tag_other_disk_statistics"
                android:background="@color/other_color_strip_storage"
                android:layout_width="@dimen/dp_17"
                android:layout_height="@dimen/dp_16"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/text_color_main"
                android:id="@+id/tv_other_disk_statistics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/other_app_manage"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/dp_19"
                android:layout_toEndOf="@+id/v_tag_other_disk_statistics"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/text_color_main_gray"
                android:gravity="end"
                android:id="@+id/tv_other_size_disk_statistics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="@string/calculating_app_manage"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="@dimen/dp_460"
            android:layout_height="@dimen/dp_74"
            android:layout_marginBottom="@dimen/dp_16">
            <View
                android:id="@+id/v_tag_sys_disk_statistics"
                android:background="@color/sys_color_strip_storage"
                android:layout_width="@dimen/dp_17"
                android:layout_height="@dimen/dp_16"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/text_color_main"
                android:id="@+id/tv_sys_disk_statistics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/system_dilink"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/dp_19"
                android:layout_toEndOf="@+id/v_tag_sys_disk_statistics"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/text_color_main_gray"
                android:gravity="end"
                android:id="@+id/tv_sys_size_disk_statistics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="@string/calculating_app_manage"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_external_storage_disk_statistics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_24">
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/text_color_main_gray"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/external_storage_app_manage"
            android:layout_marginStart="@dimen/dp_24"/>
        <com.byd.base.view.recyclerview.FullHeightRecyclerView
            android:id="@+id/rv_external_storage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_24"/>
    </LinearLayout>
</LinearLayout>
