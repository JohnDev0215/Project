<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/ll_bg_dialo_sound_focus"
    android:layout_width="@dimen/dp_560"
    android:layout_height="@dimen/dp_380"
    style="@style/vehicle_setting_dialog_background_container">
    <include
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_72"
        layout="@layout/dialog_common_title"/>
    <FrameLayout
        android:paddingTop="@dimen/dp_10"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/dp_48"
            android:paddingEnd="@dimen/dp_48">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_ime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:paddingStart="@dimen/dp_20"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_operate_dialog_def_input_system"
                android:paddingTop="@dimen/dp_16"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/dp_20"
                    android:textColor="@color/text_color_blue_1"
                    android:id="@+id/tv_add_ime_input_system"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/add_ime"
                    android:layout_marginStart="@dimen/dp_30"/>
                <TextView
                    android:textSize="@dimen/dp_20"
                    android:textColor="@color/text_color_blue_1"
                    android:id="@+id/tv_remove_ime_input_system"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/remove_ime"
                    android:layout_marginStart="@dimen/dp_20"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
    <include
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_104"
        layout="@layout/dialog_bottom_2btn_left_hight_light"/>
</LinearLayout>
