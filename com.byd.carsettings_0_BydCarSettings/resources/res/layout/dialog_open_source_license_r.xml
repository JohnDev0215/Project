<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:id="@+id/ll_dialog_masks"
    android:background="@drawable/bg_main_activity"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:alpha="0">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_bg_dialo_sound_focus"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dp_12"
        android:alpha="0"
        android:scaleX="0.9"
        android:scaleY="0.9">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_48"
            android:layout_marginBottom="@dimen/dp_20">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textStyle="bold"
                android:textColor="@color/h5_license_title_color"
                android:gravity="center"
                android:id="@+id/tv_title_dialog_common_titles"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/dp_76"/>
            <ImageView
                android:id="@+id/iv_back_dialog_common_title"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:src="@drawable/base_icon_arrow"
                android:layout_marginEnd="@dimen/dp_28"/>
        </LinearLayout>
        <FrameLayout
            android:background="@android:color/transparent"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <WebView
                android:scrollbarThumbVertical="@drawable/bar_thumb"
                android:scrollbarTrackVertical="@drawable/bar_track"
                android:id="@+id/wbv_dialog_user_agreements"
                android:paddingBottom="@dimen/dp_24"
                android:fadingEdge="none"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never"
                android:layerType="software"
                android:layout_marginEnd="@dimen/dp_28"/>
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/iv_loading"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_light_public_loading_sm"/>
        </FrameLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_bottom_view"
            android:paddingBottom="@dimen/dp_32"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/h5_agree_data_color"
                android:id="@+id/privacy_allow_time"
                android:paddingBottom="@dimen/dp_12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/privacy_allow_time"/>
            <com.byd.carsettings.ui.widget.BydInvalidButton
                android:id="@+id/privacy_btn"
                android:text="@string/privacy_allow"
                android:textAllCaps="false"
                android:stateListAnimator="@drawable/anim_btn_scale"
                style="@style/dialog_btn_ok_dilink"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
