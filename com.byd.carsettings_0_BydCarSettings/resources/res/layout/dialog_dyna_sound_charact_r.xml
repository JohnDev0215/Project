<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_bg_dialog_sound_charact"
    android:background="@drawable/bg_dyna_sound_charact_original"
    android:layout_width="@dimen/dp_560"
    android:layout_height="@dimen/dp_544">
    <include
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_72"
        layout="@layout/dialog_common_title"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_352"
        android:layout_marginTop="@dimen/dp_37"
        android:layoutDirection="ltr">
        <com.byd.carsettings.ui.widget.UserRadioGroup
            android:id="@+id/rg_dyna_sound_charact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_17"
            android:layout_alignParentTop="true"
            android:layout_marginEnd="@dimen/dp_40"
            android:layout_alignParentEnd="true">
            <com.byd.mvp.ui.widget.TintRadioButton
                android:id="@+id/rbtn_original_dyna_sound_charact"
                android:text="@string/original_charact_dynaudio_sound"
                style="@style/rbtn_dyna_sound_charact"/>
            <com.byd.mvp.ui.widget.TintRadioButton
                android:id="@+id/rbtn_dynamic_dyna_sound_charact"
                android:layout_marginTop="@dimen/dp_24"
                android:text="@string/dynamic_charact_dynaudio_sound"
                style="@style/rbtn_dyna_sound_charact"/>
            <com.byd.mvp.ui.widget.TintRadioButton
                android:id="@+id/rbtn_soft_dyna_sound_charact"
                android:layout_marginTop="@dimen/dp_24"
                android:text="@string/soft_charact_dynaudio_sound"
                style="@style/rbtn_dyna_sound_charact"/>
            <com.byd.mvp.ui.widget.TintRadioButton
                android:id="@+id/rbtn_speech_dyna_sound_charact"
                android:layout_marginTop="@dimen/dp_24"
                android:text="@string/speech_charact_dynaudio_sound"
                style="@style/rbtn_dyna_sound_charact"/>
            <com.byd.mvp.ui.widget.TintRadioButton
                android:id="@+id/rbtn_custom_dyna_sound_charact"
                android:layout_marginTop="@dimen/dp_24"
                android:text="@string/custom_charact_dynaudio_sound"
                style="@style/rbtn_dyna_sound_charact"/>
        </com.byd.carsettings.ui.widget.UserRadioGroup>
        <com.byd.carsettings.ui.widget.EqualizerView
            android:id="@+id/ev_dialog_dyna_sound_charact"
            android:layout_width="@dimen/dp_300"
            android:layout_height="match_parent"
            android:layout_toLeftOf="@+id/rg_dyna_sound_charact"
            android:layout_marginEnd="@dimen/dp_20"
            app:key_arr_seek_bar="@array/dyna_sound_charact_freq_band_key_array"
            app:range_max_array="@array/dyna_sound_charact_freq_band_range_max_array"
            app:range_min_array="@array/dyna_sound_charact_freq_band_range_min_array"
            app:seekbar_id="@+id/sbar_view_sound_character_seekbar"
            app:seekbar_layout_item_id="@layout/view_sound_character_seekbar"
            app:seekbar_margin_end="@dimen/dp_24"
            app:seekbar_title_layout_id="@layout/view_sound_freq_band_title"
            app:seekbar_value_layout_id="@layout/view_sound_freq_band_value"
            app:title_arr_seek_bar="@array/dyna_freq_band_list"/>
        <RelativeLayout
            android:id="@+id/rl_range_view_sound_character_seekbar"
            android:visibility="gone"
            android:layout_width="@dimen/dp_60"
            android:layout_height="match_parent"
            android:layout_toStartOf="@+id/ev_dialog_dyna_sound_charact">
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/text_color_gray_sound"
                android:id="@+id/tv_max_view_sound_character_seekbar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_30"
                android:text="@string/max_freq_band_range_dyna_sound_charact"
                android:layout_alignParentTop="true"
                android:layout_alignParentRight="true"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/text_color_gray_sound"
                android:id="@+id/tv_min_view_sound_character_seekbar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_60"
                android:text="@string/min_freq_band_range_dyna_sound_charact"
                android:layout_alignParentBottom="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_80"
        android:layout_weight="1">
        <com.byd.carsettings.ui.widget.BydInvalidButton
            android:textSize="@dimen/sp_18"
            android:textColor="@color/text_color_main"
            android:id="@+id/btn_reset_dyna_sound_charact"
            android:background="@drawable/selector_rbtn_equalizer_music_style"
            android:visibility="gone"
            android:layout_width="@dimen/dp_144"
            android:layout_height="@dimen/dp_40"
            android:layout_marginLeft="@dimen/dp_29"
            android:layout_marginTop="@dimen/dp_5"
            android:text="@string/dilink_reset"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            android:stateListAnimator="@drawable/anim_btn_scale_alpha"/>
    </RelativeLayout>
</LinearLayout>
