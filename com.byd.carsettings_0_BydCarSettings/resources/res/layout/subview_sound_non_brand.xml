<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_frame_gray_a"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_sound_effects_non_brand"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_129"
            android:layout_marginStart="@dimen/dp_26"
            android:layout_marginEnd="@dimen/dp_26">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_26">
                <TextView
                    android:textSize="@dimen/sp_20"
                    android:textColor="@color/text_color_item_left_dilink_link"
                    android:id="@+id/tv_manufactor_name_subview_sound_non_brand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/manufactor_name_non_brand_sound"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_26">
                <com.byd.base.view.segmentedbutton.SegmentedButtonGroup
                    android:layout_gravity="center_vertical"
                    android:id="@+id/srg_sound_mode_subview_sound_non_brand"
                    android:background="@drawable/shape_bg_gray_radio_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/dilink_segment_button_group_style">
                    <com.byd.base.view.segmentedbutton.SegmentedButton
                        android:id="@+id/rbtn_mode_hifi_subview_sound_non_brand"
                        app:sb_text="@string/mode_hifi_dirac_live_sound"
                        style="@style/sbtn_2_sound_effects_mode"/>
                    <com.byd.base.view.segmentedbutton.SegmentedButton
                        android:id="@+id/rbtn_mode_stage_subview_sound_non_brand"
                        app:sb_text="@string/mode_stage_dirac_live_sound"
                        style="@style/sbtn_2_sound_effects_mode"/>
                </com.byd.base.view.segmentedbutton.SegmentedButtonGroup>
            </RelativeLayout>
        </LinearLayout>
        <include
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_88"
            layout="@layout/subview_dirac_loudness_settings"/>
    </LinearLayout>
    <include
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_176"
        android:layout_marginTop="@dimen/dp_16"
        layout="@layout/subview_dirac_equalizer_settings"/>
</LinearLayout>
