<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_bg_dialo_sound_focus"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/vehicle_setting_dialog_background_container">
    <include
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_72"
        layout="@layout/dialog_common_title_r"/>
    <com.bydux.api.common.views.window.DampingScrollView
        android:paddingTop="@dimen/dp_20"
        android:paddingBottom="@dimen/dp_20"
        android:scrollbars="none"
        android:fadingEdge="vertical"
        android:fadingEdgeLength="@dimen/dp_44"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:requiresFadingEdge="vertical"
        android:layout_marginEnd="@dimen/dp_11">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/dp_48">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_main"
                android:id="@+id/tv_distance_dialog_uint_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ev_distance_unit_setting_system"/>
            <com.byd.base.view.segmentedbutton.SegmentedButtonGroup
                android:layout_gravity="start|center_vertical"
                android:id="@+id/srg_ev_distance_dialog_uint_settings"
                android:background="@drawable/shape_bg_gray_radio_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_20"
                android:layout_marginBottom="@dimen/dp_20"
                style="@style/dilink_segment_button_group_style">
                <com.byd.base.view.segmentedbutton.SegmentedButton
                    android:id="@+id/rbtn_ev_km_dialog_uint_setting"
                    app:sb_text="@string/ev_km_distance_unit_setting_system"
                    style="@style/sbtn_2_unit_settings"/>
                <com.byd.base.view.segmentedbutton.SegmentedButton
                    android:id="@+id/rbtn_ev_mi_dialog_uint_setting"
                    app:sb_text="@string/ev_mi_distance_unit_setting_system"
                    style="@style/sbtn_2_unit_settings"/>
            </com.byd.base.view.segmentedbutton.SegmentedButtonGroup>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_main"
                android:id="@+id/tv_oil_dialog_uint_settings"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dm_distance_oil_consumption_unit_setting_system"/>
            <com.byd.base.view.segmentedbutton.SegmentedButtonGroup
                android:layout_gravity="start|center_vertical"
                android:id="@+id/srg_dm_distance_oil_dialog_uint_settings"
                android:background="@drawable/shape_bg_gray_radio_group"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_20"
                android:layout_marginBottom="@dimen/dp_20"
                style="@style/dilink_segment_button_group_style">
                <com.byd.base.view.segmentedbutton.SegmentedButton
                    android:id="@+id/rbtn_dm_distance_dialog_uint_setting"
                    app:sb_text="@string/km_l_distance_unit_setting_system"
                    style="@style/sbtn_3_unit_settings"/>
                <com.byd.base.view.segmentedbutton.SegmentedButton
                    android:id="@+id/rbtn_dm_oil_gb_dialog_uint_setting"
                    app:sb_text="@string/gb_oil_consumption_unit_setting_system"
                    style="@style/sbtn_3_unit_settings"/>
                <com.byd.base.view.segmentedbutton.SegmentedButton
                    android:id="@+id/rbtn_dm_oil_us_dialog_uint_setting"
                    app:sb_text="@string/us_oil_consumption_unit_setting_system"
                    style="@style/sbtn_3_unit_settings"/>
            </com.byd.base.view.segmentedbutton.SegmentedButtonGroup>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_main"
                android:id="@+id/tv_press"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pressure_unit_setting_system"/>
            <com.byd.base.view.segmentedbutton.SegmentedButtonGroup
                android:layout_gravity="start|center_vertical"
                android:id="@+id/srg_pressure_dialog_uint_settings"
                android:background="@drawable/shape_bg_gray_radio_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_20"
                style="@style/dilink_segment_button_group_style">
                <com.byd.base.view.segmentedbutton.SegmentedButton
                    android:id="@+id/rbtn_kpa_dialog_uint_setting"
                    app:sb_text="@string/kpa_unit_setting_system"
                    style="@style/sbtn_3_unit_settings"/>
                <com.byd.base.view.segmentedbutton.SegmentedButton
                    android:id="@+id/rbtn_bar_dialog_uint_setting"
                    app:sb_text="@string/bar_unit_setting_system"
                    style="@style/sbtn_3_unit_settings"/>
                <com.byd.base.view.segmentedbutton.SegmentedButton
                    android:id="@+id/rbtn_psi_dialog_uint_setting"
                    app:sb_text="@string/psi_unit_setting_system"
                    style="@style/sbtn_3_unit_settings"/>
            </com.byd.base.view.segmentedbutton.SegmentedButtonGroup>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_main"
                android:id="@+id/tv_power"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_20"
                android:text="@string/power_unit_setting_system"/>
            <com.byd.base.view.segmentedbutton.SegmentedButtonGroup
                android:layout_gravity="start|center_vertical"
                android:id="@+id/srg_power_dialog_uint_settings"
                android:background="@drawable/shape_bg_gray_radio_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_20"
                style="@style/dilink_segment_button_group_style">
                <com.byd.base.view.segmentedbutton.SegmentedButton
                    android:id="@+id/rbtn_kw_dialog_uint_setting"
                    app:sb_text="@string/kw_unit_setting_system"
                    style="@style/sbtn_2_unit_settings"/>
                <com.byd.base.view.segmentedbutton.SegmentedButton
                    android:id="@+id/rbtn_hp_dialog_uint_setting"
                    app:sb_text="@string/hp_unit_setting_system"
                    style="@style/sbtn_2_unit_settings"/>
            </com.byd.base.view.segmentedbutton.SegmentedButtonGroup>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_main"
                android:id="@+id/tv_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_20"
                android:text="@string/temperature_unit_setting_system"/>
            <com.byd.base.view.segmentedbutton.SegmentedButtonGroup
                android:layout_gravity="start|center_vertical"
                android:id="@+id/srg_temperature_dialog_uint_settings"
                android:background="@drawable/shape_bg_gray_radio_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_20"
                style="@style/dilink_segment_button_group_style">
                <com.byd.base.view.segmentedbutton.SegmentedButton
                    android:id="@+id/rbtn_temperature_c_dialog_uint_setting"
                    app:sb_text="@string/temperature_c_unit_setting_system"
                    style="@style/sbtn_2_unit_settings"/>
                <com.byd.base.view.segmentedbutton.SegmentedButton
                    android:id="@+id/rbtn_temperature_f_dialog_uint_setting"
                    app:sb_text="@string/temperature_f_unit_setting_system"
                    style="@style/sbtn_2_unit_settings"/>
            </com.byd.base.view.segmentedbutton.SegmentedButtonGroup>
        </LinearLayout>
    </com.bydux.api.common.views.window.DampingScrollView>
</LinearLayout>
