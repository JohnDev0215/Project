<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_74"
    android:minHeight="@dimen/dp_74">
    <RelativeLayout
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/dp_24">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingEnd="@dimen/dp_20"
            android:layout_toStartOf="@+id/switch_item_sub_app_list"
            android:layout_alignParentStart="true">
            <ImageView
                android:id="@+id/iv_app_icon_item_sub_app_list"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_main_dilink_pagers"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/tv_app_name_item_sub_app_list"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:lines="2"
                android:layout_marginStart="@dimen/dp_24"/>
        </LinearLayout>
        <com.byd.base.view.BydSwitch
            android:id="@+id/switch_item_sub_app_list"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp_24"
            android:layout_alignParentEnd="true"
            style="@style/byd_switch"/>
        <View
            android:id="@+id/v_line_app_list"
            android:background="@color/bg_color_line"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="@dimen/dp_24"/>
    </RelativeLayout>
</LinearLayout>
