<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/air_background"
        style="@style/vehicle_setting_right_car_image_port_style"/>
    <com.bydux.api.common.views.window.DampingScrollView
        android:id="@+id/nsw"
        android:layout_below="@+id/air_background"
        style="@style/vehicle_setting_right_module_damping_scrollView_port_style">
        <LinearLayout style="@style/vehicle_setting_right_module_damping_scrollView_child_port_style">
            <RelativeLayout
                android:id="@+id/airconditon_mode_container"
                android:paddingBottom="@dimen/dp_26"
                android:layout_marginBottom="@dimen/dp_16"
                style="@style/vehicle_setting_background_container">
                <RelativeLayout
                    android:id="@+id/aircondition_auto_rl"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <RelativeLayout
                        android:id="@+id/auto_icon_container"
                        style="@style/vehicle_setting_tv_seg_icon_tv_container">
                        <ImageView
                            android:id="@+id/auto_icon"
                            android:layout_centerVertical="true"
                            android:layout_toEndOf="@+id/auto_tv"
                            style="@style/vehicle_setting_right_tv_seg_icon_style"/>
                        <com.byd.base.view.BydFlexTextView
                            android:id="@+id/auto_tv"
                            android:text="@string/vehiclesettings_air_conditioner_automatic_mode"
                            android:layout_centerVertical="true"
                            style="@style/vehicle_setting_right_tv_seg_tv_port_style"/>
                    </RelativeLayout>
                    <com.byd.base.view.segmentedbutton.SegmentedButtonGroup
                        android:id="@+id/aircondition_auto_segmentedButtonGroup"
                        android:layout_below="@+id/auto_icon_container"
                        style="@style/vehicle_setting_right_tv_seg_seg_style_icon_up">
                        <com.byd.base.view.segmentedbutton.SegmentedButton
                            app:sb_text="@string/vehiclesettings_ac_auto_eco_mode"
                            style="@style/vehicle_setting_right_tv_seg_seg_btn_style"/>
                        <com.byd.base.view.segmentedbutton.SegmentedButton
                            app:sb_text="@string/vehiclesettings_comfort"
                            style="@style/vehicle_setting_right_tv_seg_seg_btn_style"/>
                    </com.byd.base.view.segmentedbutton.SegmentedButtonGroup>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/aircondition_warm_rl"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/aircondition_auto_rl">
                    <RelativeLayout
                        android:id="@+id/hot_tv_container"
                        style="@style/vehicle_setting_tv_seg_icon_tv_container">
                        <ImageView
                            android:id="@+id/hot_icon"
                            android:layout_centerVertical="true"
                            android:layout_toEndOf="@+id/hot_tv"
                            style="@style/vehicle_setting_right_tv_seg_icon_style"/>
                        <com.byd.base.view.BydFlexTextView
                            android:id="@+id/hot_tv"
                            android:maxWidth="@dimen/dp_544"
                            android:text="@string/vehiclesettings_air_conditioning_heating_mode"
                            android:layout_centerVertical="true"
                            style="@style/vehicle_setting_right_tv_seg_tv_port_style"/>
                    </RelativeLayout>
                    <com.byd.base.view.segmentedbutton.SegmentedButtonGroup
                        android:id="@+id/aircondition_hot_segmentedButtonGroup"
                        android:layout_below="@+id/hot_tv_container"
                        style="@style/vehicle_setting_right_tv_seg_seg_style_icon_up">
                        <com.byd.base.view.segmentedbutton.SegmentedButton
                            app:sb_text="@string/vehiclesettings_ac_heat_warm_ptc"
                            style="@style/vehicle_setting_right_tv_seg_seg_btn_style"/>
                        <com.byd.base.view.segmentedbutton.SegmentedButton
                            app:sb_text="@string/vehiclesettings_ac_heat_warm_fuel"
                            style="@style/vehicle_setting_right_tv_seg_seg_btn_style"/>
                    </com.byd.base.view.segmentedbutton.SegmentedButtonGroup>
                </RelativeLayout>
            </RelativeLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/airconditon_time_container"
                android:paddingBottom="@dimen/dp_26"
                android:layout_marginBottom="@dimen/dp_16"
                style="@style/vehicle_setting_background_container">
                <RelativeLayout
                    android:id="@+id/behind_board_contianer"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <RelativeLayout
                        android:id="@+id/behind_board_tv_container"
                        style="@style/vehicle_setting_tv_seg_icon_tv_container">
                        <ImageView
                            android:id="@+id/behind_board_icon"
                            android:layout_centerVertical="true"
                            android:layout_toEndOf="@+id/behind_board_tv"
                            style="@style/vehicle_setting_right_tv_seg_icon_style"/>
                        <com.byd.base.view.BydFlexTextView
                            android:id="@+id/behind_board_tv"
                            android:text="@string/vehiclesettings_placehodler"
                            android:layout_centerVertical="true"
                            style="@style/vehicle_setting_right_tv_seg_tv_port_style"/>
                    </RelativeLayout>
                    <com.byd.base.view.segmentedbutton.SegmentedButtonGroup
                        android:id="@+id/aircondition_board_lock_segmentedButtonGroup"
                        android:layout_below="@+id/behind_board_tv_container"
                        style="@style/vehicle_setting_right_tv_seg_seg_style_icon_up">
                        <com.byd.base.view.segmentedbutton.SegmentedButton
                            app:sb_text="@string/vehiclesettings_rear_panel_auto_lock_5_min"
                            style="@style/vehicle_setting_right_tv_seg_seg_btn_style"/>
                        <com.byd.base.view.segmentedbutton.SegmentedButton
                            app:sb_text="@string/vehiclesettings_rear_panel_auto_lock_8_min"
                            style="@style/vehicle_setting_right_tv_seg_seg_btn_style"/>
                        <com.byd.base.view.segmentedbutton.SegmentedButton
                            app:sb_text="@string/vehiclesettings_rear_panel_auto_lock_15_min"
                            style="@style/vehicle_setting_right_tv_seg_seg_btn_style"/>
                    </com.byd.base.view.segmentedbutton.SegmentedButtonGroup>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/runtime_container"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <RelativeLayout
                        android:id="@+id/runtime_tv_contianer"
                        style="@style/vehicle_setting_tv_seg_icon_tv_container">
                        <ImageView
                            android:id="@+id/runtime_icon"
                            android:layout_centerVertical="true"
                            android:layout_toEndOf="@+id/runtime_tv"
                            style="@style/vehicle_setting_right_tv_seg_icon_style"/>
                        <com.byd.base.view.BydFlexTextView
                            android:id="@+id/runtime_tv"
                            android:text="@string/vehiclesettings_placehodler"
                            android:layout_centerVertical="true"
                            style="@style/vehicle_setting_right_tv_seg_tv_port_style"/>
                    </RelativeLayout>
                    <com.byd.base.view.segmentedbutton.SegmentedButtonGroup
                        android:id="@+id/aircondition_runtime_segmentedButtonGroup"
                        android:layout_below="@+id/runtime_tv_contianer"
                        style="@style/vehicle_setting_right_tv_seg_seg_style_icon_up">
                        <com.byd.base.view.segmentedbutton.SegmentedButton
                            app:sb_text="@string/vehiclesettings_remote_open_ac_10_min"
                            style="@style/vehicle_setting_right_tv_seg_seg_btn_style"/>
                        <com.byd.base.view.segmentedbutton.SegmentedButton
                            app:sb_text="@string/vehiclesettings_remote_open_ac_15_min"
                            style="@style/vehicle_setting_right_tv_seg_seg_btn_style"/>
                        <com.byd.base.view.segmentedbutton.SegmentedButton
                            app:sb_text="@string/vehiclesettings_remote_open_ac_20_min"
                            style="@style/vehicle_setting_right_tv_seg_seg_btn_style"/>
                        <com.byd.base.view.segmentedbutton.SegmentedButton
                            app:sb_text="@string/vehiclesettings_remote_open_ac_25_min"
                            style="@style/vehicle_setting_right_tv_seg_seg_btn_style"/>
                        <com.byd.base.view.segmentedbutton.SegmentedButton
                            app:sb_text="@string/vehiclesettings_remote_open_ac_30_min"
                            style="@style/vehicle_setting_right_tv_seg_seg_btn_style"/>
                    </com.byd.base.view.segmentedbutton.SegmentedButtonGroup>
                </RelativeLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/aircondition_setting_up_container"
                style="@style/vehicle_setting_background_with_param_container">
                <RelativeLayout
                    android:id="@+id/aircondition_test_auto_container"
                    style="@style/vehicle_setting_right_tv_sw_icon_container_un_single_style">
                    <ImageView
                        android:id="@+id/aircondition_test_auto_icon"
                        android:layout_toEndOf="@+id/aircondition_test_auto_tv"
                        style="@style/vehicle_setting_right_tv_sw_icon_icon_style"/>
                    <com.byd.base.view.BydFlexTextView
                        android:id="@+id/aircondition_test_auto_tv"
                        android:text="@string/vehiclesettings_automatic_air_detection_on_power_up"
                        style="@style/vehicle_setting_right_tv_sw_icon_tv_port_style"/>
                    <com.byd.base.view.BydSwitch
                        android:id="@+id/aircondition_test_auto"
                        style="@style/vehicle_setting_right_tv_sw_icon_sw_style"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/aircondition_test_withtime_container"
                    style="@style/vehicle_setting_right_tv_sw_icon_container_un_single_style">
                    <ImageView
                        android:id="@+id/aircondition_test_time_icon"
                        android:layout_toEndOf="@+id/aircondition_test_withtime_tv"
                        style="@style/vehicle_setting_right_tv_sw_icon_icon_style"/>
                    <com.byd.base.view.BydFlexTextView
                        android:id="@+id/aircondition_test_withtime_tv"
                        android:text="@string/vehiclesettings_30_minutes_air_detection"
                        style="@style/vehicle_setting_right_tv_sw_icon_tv_port_style"/>
                    <com.byd.base.view.BydSwitch
                        android:id="@+id/aircondition_test_withtime"
                        style="@style/vehicle_setting_right_tv_sw_icon_sw_style"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/aircondition_test_withdoor_open_container"
                    style="@style/vehicle_setting_right_tv_sw_icon_container_un_single_style">
                    <ImageView
                        android:id="@+id/aircondition_test_door_icon"
                        android:layout_toEndOf="@+id/aircondition_test_door_tv"
                        style="@style/vehicle_setting_right_tv_sw_icon_icon_style"/>
                    <com.byd.base.view.BydFlexTextView
                        android:id="@+id/aircondition_test_door_tv"
                        android:text="@string/vehiclesettings_automatic_air_detection_of_switch_door"
                        style="@style/vehicle_setting_right_tv_sw_icon_tv_port_style"/>
                    <com.byd.base.view.BydSwitch
                        android:id="@+id/aircondition_test_withdoor_open"
                        style="@style/vehicle_setting_right_tv_sw_icon_sw_style"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/aircondition_auto_clean_container"
                    style="@style/vehicle_setting_right_tv_sw_icon_container_un_single_style">
                    <ImageView
                        android:id="@+id/auto_clean_icon"
                        android:layout_toEndOf="@+id/aircondition_auto_clean_tv"
                        style="@style/vehicle_setting_right_tv_sw_icon_icon_style"/>
                    <com.byd.base.view.BydFlexTextView
                        android:id="@+id/aircondition_auto_clean_tv"
                        android:text="@string/vehiclesettings_automatic_purification"
                        style="@style/vehicle_setting_right_tv_sw_icon_tv_port_style"/>
                    <com.byd.base.view.BydSwitch
                        android:id="@+id/aircondition_auto_clean"
                        style="@style/vehicle_setting_right_tv_sw_icon_sw_style"/>
                </RelativeLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/aircondition_setting_down_container"
                style="@style/vehicle_setting_background_with_param_container">
                <RelativeLayout
                    android:id="@+id/aircondition_park_cycle_container"
                    style="@style/vehicle_setting_right_tv_sw_icon_container_un_single_style">
                    <ImageView
                        android:id="@+id/aircondition_park_cycle_icon"
                        android:layout_toEndOf="@+id/aircondition_park_cycle_tv"
                        style="@style/vehicle_setting_right_tv_sw_icon_icon_style"/>
                    <com.byd.base.view.BydFlexTextView
                        android:id="@+id/aircondition_park_cycle_tv"
                        android:text="@string/vehiclesettings_parking_automatic_inner_circulation"
                        style="@style/vehicle_setting_right_tv_sw_icon_tv_port_style"/>
                    <com.byd.base.view.BydSwitch
                        android:id="@+id/aircondition_park_cycle"
                        style="@style/vehicle_setting_right_tv_sw_icon_sw_style"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/aircondition_hole_cycle_container"
                    style="@style/vehicle_setting_right_tv_sw_icon_container_un_single_style">
                    <ImageView
                        android:id="@+id/aircondition_hole_cycle_icon"
                        android:layout_toEndOf="@+id/aircondition_hole_cycle_tv"
                        style="@style/vehicle_setting_right_tv_sw_icon_icon_style"/>
                    <com.byd.base.view.BydFlexTextView
                        android:id="@+id/aircondition_hole_cycle_tv"
                        android:text="@string/vehiclesettings_automatic_internal_circulation_of_tunnel"
                        style="@style/vehicle_setting_right_tv_sw_icon_tv_port_style"/>
                    <com.byd.base.view.BydSwitch
                        android:id="@+id/aircondition_hole_cycle"
                        style="@style/vehicle_setting_right_tv_sw_icon_sw_style"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/aircondition_blue_talk_contianer"
                    style="@style/vehicle_setting_right_tv_sw_icon_container_un_single_style">
                    <ImageView
                        android:id="@+id/aircondition_blue_talk_icon"
                        android:layout_toEndOf="@+id/aircondition_blue_talk_tv"
                        style="@style/vehicle_setting_right_tv_sw_icon_icon_style"/>
                    <com.byd.base.view.BydFlexTextView
                        android:id="@+id/aircondition_blue_talk_tv"
                        android:text="@string/vehiclesettings_bluetooth_call_automatically_reduces_wind_speed"
                        style="@style/vehicle_setting_right_tv_sw_icon_tv_port_style"/>
                    <com.byd.base.view.BydSwitch
                        android:id="@+id/aircondition_blue_talk"
                        style="@style/vehicle_setting_right_tv_sw_icon_sw_style"/>
                </RelativeLayout>
            </LinearLayout>
            <RelativeLayout
                android:id="@+id/ac_intelligent_partition_switch_container"
                style="@style/vehicle_setting_right_tv_sw_icon_container_style">
                <ImageView
                    android:id="@+id/ac_intelligent_partition_icon"
                    android:layout_toEndOf="@+id/ac_intelligent_partition_tv"
                    style="@style/vehicle_setting_right_tv_sw_icon_icon_style"/>
                <com.byd.base.view.BydFlexTextView
                    android:id="@+id/ac_intelligent_partition_tv"
                    android:text="@string/vehiclesettings_intelligent_partition"
                    style="@style/vehicle_setting_right_tv_sw_icon_tv_port_style"/>
                <com.byd.base.view.BydSwitch
                    android:id="@+id/ac_intelligent_partition_switch"
                    style="@style/vehicle_setting_right_tv_sw_icon_sw_style"/>
            </RelativeLayout>
        </LinearLayout>
    </com.bydux.api.common.views.window.DampingScrollView>
</RelativeLayout>
