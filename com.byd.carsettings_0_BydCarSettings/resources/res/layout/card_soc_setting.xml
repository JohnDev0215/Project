<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_frame_gray_a"
        android:layout_width="@dimen/dp_490"
        android:layout_height="@dimen/dp_144"
        android:minWidth="@dimen/dp_490"
        android:minHeight="@dimen/dp_144"
        android:layout_centerHorizontal="true">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:paddingStart="@dimen/dp_24"
            android:paddingEnd="@dimen/dp_24">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_main"
                android:id="@+id/tv_title_card_soc_setting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>
            <com.byd.base.view.segmentedbutton.SegmentedButtonGroup
                android:layout_gravity="center_vertical"
                android:id="@+id/srg_card_soc_setting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                style="@style/carsetting_segment_button_group_style">
                <com.byd.base.view.segmentedbutton.SegmentedButton
                    android:id="@+id/rbtn_0_card_soc_setting"
                    app:sb_textColor="@color/carlights_guest_color"
                    app:sb_textColor_onSelection="@color/white"
                    app:sb_textSize="@dimen/sp_20"
                    style="@style/sbtn_common_settings"/>
                <com.byd.base.view.segmentedbutton.SegmentedButton
                    android:id="@+id/rbtn_1_card_soc_setting"
                    app:sb_textColor="@color/carlights_guest_color"
                    app:sb_textColor_onSelection="@color/white"
                    app:sb_textSize="@dimen/sp_20"
                    style="@style/sbtn_common_settings"/>
            </com.byd.base.view.segmentedbutton.SegmentedButtonGroup>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_18"
            android:paddingEnd="@dimen/dp_24">
            <SeekBar
                android:id="@+id/sbar_card_soc_setting"
                android:paddingTop="@dimen/dp_16"
                android:paddingBottom="@dimen/dp_16"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_40"
                android:progressDrawable="@drawable/layer_blue_gray_seekbar_track"
                android:thumb="@drawable/seekbar_thumb_background"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/dp_10"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_progress"
                android:gravity="end"
                android:id="@+id/tv_progress_card_soc_setting"
                android:layout_width="@dimen/dp_50"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
