<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="left"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:layout_width="@dimen/dp_560"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="?attr/carmsg_serious"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:text="@string/itac_desc_warn"
        android:layout_marginStart="@dimen/dp_48"
        android:layout_marginEnd="@dimen/dp_48"/>
    <CheckBox
        android:textSize="@dimen/sp_18"
        android:textColor="?attr/consumption_text_white"
        android:id="@+id/cb_open_avm"
        android:background="@null"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_5"
        android:checked="false"
        android:button="@null"
        android:text="@string/itac_autoopen_avm"
        android:drawableStart="@drawable/radio_btn_bg_selector"
        android:layout_marginStart="@dimen/dp_40"
        android:layout_marginEnd="@dimen/dp_48"/>
</LinearLayout>
