<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:layout_width="@dimen/dp_560"
    android:layout_height="wrap_content"
    style="@style/vehicle_setting_dialog_background_container">
    <TextView
        android:textSize="@dimen/sp_20"
        android:textStyle="bold"
        android:textColor="@color/text_color_main_dilink_pagers"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_29"
        android:layout_marginTop="@dimen/dp_22"
        android:text="@string/dipilot_highway_navigation_title"
        android:layout_marginStart="@dimen/dp_24"
        android:layout_marginEnd="@dimen/dp_24"/>
    <View
        android:id="@+id/divider"
        android:background="@color/dialog_divider_common"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_marginTop="@dimen/dp_20"/>
    <androidx.core.widget.NestedScrollView
        android:scrollbarThumbVertical="@drawable/setting_bar_thumb"
        android:scrollbarTrackVertical="@drawable/setting_bar_track"
        android:layout_gravity="center_horizontal"
        android:paddingTop="@dimen/dp_40"
        android:scrollbars="vertical"
        android:layout_width="@dimen/dp_560"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">
        <LinearLayout
            android:layout_gravity="top|center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/dialog_text_color_main"
                android:layout_gravity="center"
                android:id="@+id/tv_content"
                android:layout_width="@dimen/dp_464"
                android:layout_height="wrap_content"
                android:text="@string/dipilot_highway_navigation_hint_message"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/dialog_text_color_tips"
                android:layout_gravity="center"
                android:id="@+id/tv_notice"
                android:layout_width="@dimen/dp_464"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:text="@string/dipilot_highway_navigation_note_message"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_btn_container"
        android:paddingBottom="@dimen/dp_28"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_76"
        android:layout_marginTop="@dimen/dp_44">
        <Button
            android:textSize="@dimen/sp_18"
            android:textColor="@color/white"
            android:id="@+id/btn_positive"
            android:background="@drawable/selector_dialog_blue"
            android:layout_width="@dimen/dp_176"
            android:layout_height="@dimen/dp_48"
            android:text="@string/dialog_btn_ok"
            android:textAllCaps="false"
            android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"
            style="?android:attr/buttonBarButtonStyle"/>
        <Button
            android:textSize="@dimen/sp_18"
            android:textColor="@color/dialog_cancle_text_color"
            android:id="@+id/btn_reset"
            android:background="@drawable/selector_dialog_white"
            android:layout_width="@dimen/dp_176"
            android:layout_height="@dimen/dp_48"
            android:text="@string/dialog_btn_cancel"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/dp_48"
            android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"
            style="?android:attr/buttonBarButtonStyle"/>
    </LinearLayout>
</LinearLayout>
