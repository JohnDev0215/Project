<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/ll_bg_dialo_sound_focus"
    android:layout_width="@dimen/dp_560"
    android:layout_height="@dimen/dp_358"
    style="@style/vehicle_setting_dialog_background_container">
    <include
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_72"
        layout="@layout/dialog_common_title"/>
    <RadioGroup
        android:orientation="vertical"
        android:id="@+id/rg_dialog_ial_dynamic_colors"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_22"
        android:layout_weight="1"
        android:paddingStart="@dimen/dp_48">
        <com.byd.mvp.ui.widget.TintRadioButton
            android:id="@+id/rbtn_sea_of_stars_dialog_ial_dynamic_colors"
            android:checked="true"
            style="@style/rbtn_language_selector"/>
        <com.byd.mvp.ui.widget.TintRadioButton
            android:id="@+id/rbtn_tropical_dialog_ial_dynamic_colors"
            android:layout_marginTop="@dimen/dp_8"
            style="@style/rbtn_language_selector"/>
        <com.byd.mvp.ui.widget.TintRadioButton
            android:id="@+id/rbtn_colorful_dialog_ial_dynamic_colors"
            android:layout_marginTop="@dimen/dp_8"
            style="@style/rbtn_language_selector"/>
    </RadioGroup>
    <include
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_104"
        android:layout_marginTop="@dimen/dp_6"
        layout="@layout/dialog_bottom_2btn_left_hight_light"/>
</LinearLayout>
