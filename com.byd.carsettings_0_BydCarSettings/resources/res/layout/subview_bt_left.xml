<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/bt_left_sv"
    android:scrollbars="none"
    android:fadingEdge="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingEnd="@dimen/dp_10">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_paired_device_list_bt_left"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:splitMotionEvents="false">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_60">
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textColor="@color/text_color_gray_bt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/paired_device_bt"
                    android:layout_marginStart="@dimen/dp_24"/>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcv_bond_device_bt_left"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_120"
                android:overScrollMode="never"
                android:splitMotionEvents="false"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/ll_show_more_bt_left"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_60">
                <ImageView
                    android:id="@+id/iv_show_more_bt_left"
                    android:layout_width="@dimen/dp_24"
                    android:layout_height="@dimen/dp_24"
                    android:src="@drawable/icon_public_dowmarrow_s_24"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_discover_device_list_bt_left"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_60">
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textColor="@color/text_color_gray_bt"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/enable_device_bt"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp_24"/>
                <ImageView
                    android:id="@+id/iv_refresh_bt_left"
                    android:background="@drawable/icon_public_refresh_48"
                    android:layout_width="@dimen/dp_48"
                    android:layout_height="@dimen/dp_48"
                    android:layout_marginEnd="@dimen/dp_16"/>
            </LinearLayout>
            <com.byd.base.view.recyclerview.FullHeightRecyclerView
                android:id="@+id/rcv_discovered_device_bt_left"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="@dimen/dp_3"
                android:layout_weight="1"
                android:overScrollMode="never"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
