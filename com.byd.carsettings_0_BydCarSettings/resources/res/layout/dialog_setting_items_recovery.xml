<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="@dimen/dp_560"
    android:layout_height="@dimen/dp_456"
    style="@style/vehicle_setting_dialog_background_container">
    <include
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_72"
        layout="@layout/dialog_common_title"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_content_dialog_setting_items_recovery"
        android:paddingTop="@dimen/dp_32"
        android:paddingBottom="@dimen/dp_16"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="@dimen/dp_48">
        <com.byd.mvp.ui.widget.TintCheckBox
            android:id="@+id/rbtn_dilink_dialog_setting_items_recovery"
            android:text="@string/dilink_main_v2"
            style="@style/rbtn_setting_items_recovery"/>
        <com.byd.mvp.ui.widget.TintCheckBox
            android:id="@+id/rbtn_dipilot_dialog_setting_items_recovery"
            android:layout_marginTop="@dimen/dp_8"
            android:text="@string/dipilot_main"
            style="@style/rbtn_setting_items_recovery"/>
        <com.byd.mvp.ui.widget.TintCheckBox
            android:id="@+id/rbtn_new_energy_dialog_setting_items_recovery"
            android:layout_marginTop="@dimen/dp_8"
            android:text="@string/new_energy_main_v2"
            style="@style/rbtn_setting_items_recovery"/>
        <com.byd.mvp.ui.widget.TintCheckBox
            android:id="@+id/rbtn_car_setting_dialog_setting_items_recovery"
            android:layout_marginTop="@dimen/dp_8"
            android:text="@string/car_setting_main_v2"
            style="@style/rbtn_setting_items_recovery"/>
        <com.byd.mvp.ui.widget.TintCheckBox
            android:id="@+id/rbtn_car_healthy_dialog_setting_items_recovery"
            android:layout_marginTop="@dimen/dp_8"
            android:text="@string/car_healthy_main_v2"
            style="@style/rbtn_setting_items_recovery"/>
    </LinearLayout>
    <include
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_104"
        layout="@layout/dialog_bottom_2btn_left_hight_light"/>
</LinearLayout>
