<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/dp_560"
    android:layout_height="@dimen/dp_544"
    style="@style/vehicle_setting_dialog_background_container">
    <RelativeLayout
        android:id="@+id/rl_title_dialog_credential_list"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_71"
        android:layout_alignParentTop="true">
        <ImageView
            android:id="@+id/iv_back_dialog_credential_list"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:src="@drawable/icon_public_leftarrow_48"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/text_color_main_dilink_pagers"
            android:id="@+id/tv_title_dialog_credential_list"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:paddingEnd="@dimen/dp_10"
            android:layout_marginStart="@dimen/dp_3"
            android:layout_toStartOf="@+id/srg_credential_type_dialog_credential_list"
            android:layout_toEndOf="@+id/iv_back_dialog_credential_list"/>
        <com.byd.base.view.segmentedbutton.SegmentedButtonGroup
            android:layout_gravity="center_vertical"
            android:id="@+id/srg_credential_type_dialog_credential_list"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp_30"
            android:layout_alignParentEnd="true"
            style="@style/carsetting_segment_button_group_style">
            <com.byd.base.view.segmentedbutton.SegmentedButton
                android:id="@+id/rbtn_system_credential_dialog_credential_list"
                app:sb_text="@string/system_dilink"
                style="@style/sbtn_2_credential_list"/>
            <com.byd.base.view.segmentedbutton.SegmentedButton
                android:id="@+id/rbtn_user_credential_dialog_credential_list"
                app:sb_text="@string/user_credential_list_app_manage"
                style="@style/sbtn_2_credential_list"/>
        </com.byd.base.view.segmentedbutton.SegmentedButtonGroup>
    </RelativeLayout>
    <View
        android:id="@+id/v_line_dialog_credential_list"
        android:background="@color/bg_color_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_below="@+id/rl_title_dialog_credential_list"/>
    <RelativeLayout
        android:id="@+id/rl_data_show_dialog_credential_list"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_405"
        android:layout_marginTop="@dimen/dp_27"
        android:layout_below="@+id/v_line_dialog_credential_list">
        <androidx.recyclerview.widget.RecyclerView
            android:scrollbarSize="@dimen/dp_4"
            android:scrollbarThumbVertical="@drawable/bar_thumb"
            android:scrollbarTrackVertical="@drawable/bar_track"
            android:id="@+id/rcv_dialog_credential_list"
            android:scrollbars="vertical"
            android:fadingEdgeLength="@dimen/dp_44"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:requiresFadingEdge="vertical"
            android:paddingStart="@dimen/dp_24"
            android:paddingEnd="@dimen/dp_8"/>
        <View
            android:background="@drawable/shape_gradient_top_disable_self_start"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_20"
            android:layout_alignParentTop="true"
            android:layout_marginStart="@dimen/dp_10"
            android:layout_marginEnd="@dimen/dp_10"/>
        <View
            android:background="@drawable/shape_gradient_bottom_disable_self_start"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_20"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="@dimen/dp_30"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_no_data_show_dialog_credential_list"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_405"
        android:layout_below="@+id/v_line_dialog_credential_list">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <ImageView
                android:background="@drawable/img_media_music_playlist_empty"
                android:layout_width="@dimen/dp_312"
                android:layout_height="@dimen/dp_208"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/text_color_item_right_dilink_link"
                android:gravity="center"
                android:id="@+id/tv_no_data_dialog_credential_list"
                android:layout_width="@dimen/dp_272"
                android:layout_height="@dimen/dp_24"
                android:text="@string/no_data_credential_list_app_manage"/>
        </LinearLayout>
        <include layout="@layout/view_status_in_loading"/>
    </RelativeLayout>
</RelativeLayout>
