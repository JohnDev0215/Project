<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2"
        android:paddingEnd="@dimen/dp_60">
        <TextView
            android:textSize="@dimen/sp_24"
            android:id="@+id/tv_has_che_zhu_help"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nfc_no_che_zhu_key_text"/>
        <com.byd.base.view.MultiStyleTextView
            android:textSize="@dimen/sp_16"
            android:gravity="center"
            android:id="@+id/tv_nfc_kaitong"
            android:visibility="gone"
            android:layout_width="@dimen/dp_144"
            android:layout_height="@dimen/dp_40"
            android:text="@string/nfc_apple_add_now"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="end"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/nfc_update_time_color"
            android:gravity="end"
            android:id="@+id/tv_update_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/nfc_update_time_color"
            android:gravity="end"
            android:id="@+id/tv_total_key"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
