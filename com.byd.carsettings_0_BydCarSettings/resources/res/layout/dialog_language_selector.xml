<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:id="@+id/ll_dialog_masks"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:alpha="0">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_bg_dialo_sound_focus"
        android:clickable="true"
        android:layout_width="@dimen/dp_560"
        android:layout_height="wrap_content"
        android:alpha="0"
        android:scaleX="0.9"
        android:scaleY="0.9"
        android:elevation="@dimen/dp_3"
        style="@style/vehicle_setting_dialog_background_container">
        <include
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_72"
            android:layout_marginBottom="@dimen/dp_20"
            layout="@layout/dialog_common_title"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.recyclerview.widget.RecyclerView
                android:scrollbarSize="@dimen/dp_4"
                android:scrollbarThumbVertical="@drawable/bar_thumb"
                android:scrollbarTrackVertical="@drawable/bar_track"
                android:id="@+id/rcv_dialog_language_selector"
                android:scrollbars="vertical"
                android:fadingEdgeLength="@dimen/dp_44"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:requiresFadingEdge="vertical"
                android:paddingStart="@dimen/dp_24"
                android:paddingEnd="@dimen/dp_9"/>
        </FrameLayout>
        <include
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_104"
            android:layout_marginTop="@dimen/dp_6"
            layout="@layout/dialog_bottom_2btn_left_hight_light"/>
    </LinearLayout>
</LinearLayout>
