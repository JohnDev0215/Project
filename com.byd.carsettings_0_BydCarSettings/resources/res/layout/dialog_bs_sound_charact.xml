<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_bg_dialog_bs_sound_charact"
    android:layout_width="@dimen/dp_640"
    android:layout_height="@dimen/dp_544">
    <include
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_72"
        layout="@layout/dialog_common_title"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_472">
        <com.byd.carsettings.ui.widget.UserRadioGroup
            android:id="@+id/rg_bs_sound_charact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/dp_24"
            android:layout_alignParentStart="true">
            <com.byd.mvp.ui.widget.TintRadioButton
                android:id="@+id/rbtn_classics_bs_sound_charact"
                android:text="@string/classics_charact_bs_sound"
                style="@style/rbtn_bs_sound_charact"/>
            <com.byd.mvp.ui.widget.TintRadioButton
                android:id="@+id/rbtn_rhythm_bs_sound_charact"
                android:layout_marginTop="@dimen/dp_32"
                android:text="@string/rhythm_charact_bs_sound"
                style="@style/rbtn_bs_sound_charact"/>
            <com.byd.mvp.ui.widget.TintRadioButton
                android:id="@+id/rbtn_soft_bs_sound_charact"
                android:layout_marginTop="@dimen/dp_32"
                android:text="@string/soft_charact_bs_sound"
                style="@style/rbtn_bs_sound_charact"/>
            <com.byd.mvp.ui.widget.TintRadioButton
                android:id="@+id/rbtn_custom_bs_sound_charact"
                android:layout_marginTop="@dimen/dp_32"
                android:text="@string/custom_charact_dynaudio_sound"
                style="@style/rbtn_bs_sound_charact"/>
        </com.byd.carsettings.ui.widget.UserRadioGroup>
        <com.byd.carsettings.ui.widget.EqualizerView
            android:id="@+id/ev_dialog_bs_sound_charact"
            android:layout_width="@dimen/dp_380"
            android:layout_height="@dimen/dp_300"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp_20"
            android:layout_alignParentEnd="true"
            app:key_arr_seek_bar="@array/bs_sound_charact_freq_band_key_array"
            app:range_max_array="@array/bs_sound_charact_freq_band_range_max_array"
            app:range_min_array="@array/bs_sound_charact_freq_band_range_min_array"
            app:seekbar_id="@+id/sbar_view_equalizer_seekbar"
            app:seekbar_layout_item_id="@layout/view_equalizer_seekbar"
            app:seekbar_margin_end="@dimen/dp_32"
            app:seekbar_title_layout_id="@layout/view_bs_sound_freq_band_title"
            app:seekbar_value_layout_id="@layout/view_sound_freq_band_value"
            app:title_arr_seek_bar="@array/bs_freq_band_list"/>
        <RelativeLayout
            android:id="@+id/rl_range_view_bs_sound_character_seekbar"
            android:layout_width="@dimen/dp_60"
            android:layout_height="@dimen/dp_300"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/ev_dialog_bs_sound_charact">
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/text_color_gray_sound"
                android:id="@+id/tv_max_view_bs_sound_character_seekbar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:text="@string/max_freq_band_range_dyna_sound_charact"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/text_color_gray_sound"
                android:id="@+id/tv_min_view_bs_sound_character_seekbar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_40"
                android:text="@string/min_freq_band_range_dyna_sound_charact"
                android:layout_alignParentBottom="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/pag_parent_bs_sound_character"
            android:visibility="gone"
            android:layout_width="@dimen/dp_374"
            android:layout_height="@dimen/dp_382"
            android:layout_marginBottom="@dimen/dp_40"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="@dimen/dp_40"
            android:layout_alignParentEnd="true">
            <org.libpag.PAGImageView
                android:id="@+id/pag_classics_bs_sound_character"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <org.libpag.PAGImageView
                android:id="@+id/pag_rhythm_bs_sound_character"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <org.libpag.PAGImageView
                android:id="@+id/pag_soft_bs_sound_character"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </RelativeLayout>
    </RelativeLayout>
</LinearLayout>
