<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/message_fragment_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.google.android.material.appbar.AppBarLayout
        android:theme="@style/AppTheme.PopupOverlay"
        android:gravity="center"
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp">
        <androidx.appcompat.widget.Toolbar
            android:theme="@style/AppTheme.PopupOverlay"
            android:id="@+id/toolbar"
            android:background="#fff"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize">
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="match_parent">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/ll_title_toolbar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="20dp"
                        android:textColor="@color/text_color_black"
                        android:id="@+id/toolbar_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <ImageView
                        android:id="@+id/iv_title_toolbar"
                        android:visibility="gone"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>
                <TextView
                    android:textSize="12dp"
                    android:id="@+id/toolbar_title_msg"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="right"
                android:orientation="horizontal"
                android:id="@+id/ll_commit_title_toolbar"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingStart="10dp">
                <TextView
                    android:textSize="14dp"
                    android:textColor="#ff7a40"
                    android:layout_gravity="center"
                    android:id="@+id/toolbar_commit"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"
                    android:text="保存"
                    android:singleLine="true"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"/>
                <RelativeLayout
                    android:layout_gravity="center"
                    android:id="@+id/rl_msg_title_toolbar"
                    android:visibility="gone"
                    android:layout_width="18dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="16dp">
                    <ImageView
                        android:id="@+id/iv_msg_title_toolbar"
                        android:layout_width="16dp"
                        android:layout_height="18dp"
                        android:layout_centerInParent="true"/>
                    <ImageView
                        android:id="@+id/iv_hint_msg_title_toolbar"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>
    <View
        android:background="#d8d8d8"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
</LinearLayout>
