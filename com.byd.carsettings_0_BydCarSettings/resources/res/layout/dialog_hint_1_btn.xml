<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="@dimen/dp_560"
    android:layout_height="wrap_content"
    style="@style/vehicle_setting_dialog_background_container">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_71">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textStyle="bold"
            android:textColor="@color/dialog_title"
            android:gravity="center"
            android:id="@+id/tv_title_dialog_hint_1_btn"
            android:layout_width="@dimen/dp_512"
            android:layout_height="@dimen/dp_29"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <View
        android:background="@color/bg_color_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_24">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/text_color_main_dilink_pagers"
            android:id="@+id/tv_msg_dialog_hint_1_btn"
            android:scrollbars="none"
            android:layout_width="@dimen/dp_464"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_104">
        <com.byd.carsettings.ui.widget.BydInvalidButton
            android:textSize="@dimen/sp_20"
            android:textColor="@color/text_color_checked_dilink_pagers"
            android:gravity="center"
            android:id="@+id/btn_ok_dialog_hint_1_btn"
            android:background="@drawable/shape_bg_blue_radio_button"
            android:layout_width="@dimen/dp_160"
            android:layout_height="@dimen/dp_48"
            android:text="@string/dialog_btn_ok"
            android:layout_centerInParent="true"
            android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"/>
    </RelativeLayout>
</LinearLayout>
