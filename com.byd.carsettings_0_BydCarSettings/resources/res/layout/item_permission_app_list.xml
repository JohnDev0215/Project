<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/dp_74">
        <RelativeLayout
            android:orientation="horizontal"
            android:id="@+id/v_item_bg_item_permission_app_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/dp_24"
            android:layout_marginEnd="@dimen/dp_10"
            android:layout_alignParentStart="true">
            <ImageView
                android:id="@+id/iv_app_icon_item_permission_app_list"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_main"
                android:gravity="center_vertical"
                android:id="@+id/tv_app_name_item_permission_app_list"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:layout_alignParentTop="true"
                android:paddingEnd="@dimen/dp_12"
                android:layout_marginStart="@dimen/dp_8"
                android:layout_toEndOf="@+id/iv_app_icon_item_permission_app_list"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/text_color_main_gray"
                android:gravity="center_vertical"
                android:id="@+id/tv_permission_info_item_permission_app_list"
                android:paddingBottom="@dimen/dp_12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_4"
                android:layout_below="@+id/tv_app_name_item_permission_app_list"
                android:paddingEnd="@dimen/dp_12"
                android:layout_alignStart="@+id/tv_app_name_item_permission_app_list"/>
        </RelativeLayout>
        <View
            android:id="@+id/v_line_item_permission_app_list"
            android:background="@color/bg_color_line"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/dp_32"
            android:layout_marginEnd="@dimen/dp_32"/>
    </RelativeLayout>
</LinearLayout>
