<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="@dimen/dp_560"
    android:layout_height="@dimen/dp_544"
    android:layoutDirection="ltr"
    style="@style/vehicle_setting_dialog_background_container">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_71">
        <TextView
            android:id="@+id/smart_reminder_dialog_title"
            android:text="@string/vehiclesettings_reminder_content"
            android:layout_centerInParent="true"
            style="@style/byd_vehicle_setting_dialog_title_style"/>
        <ImageView
            android:id="@+id/smart_reminder_close"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:src="@drawable/icon_set_public_close_48"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/dp_16"/>
    </RelativeLayout>
    <View
        android:id="@+id/smart_reminder_dialog_line"
        android:background="@color/ambient_dialog_line_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/smart_reminder_close"/>
    <ScrollView
        android:scrollbarThumbVertical="@drawable/smartreminder_scrollview_thumb"
        android:scrollbarTrackVertical="@drawable/smartreminder_scrollview_track"
        android:fadingEdge="vertical"
        android:fadingEdgeLength="@dimen/dp_21"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_19"
        android:layout_marginBottom="@dimen/dp_19"
        android:overScrollMode="never"
        android:requiresFadingEdge="vertical"
        app:layout_constraintTop_toBottomOf="@+id/smart_reminder_dialog_line">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/smart_report_recyclerview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </RelativeLayout>
    </ScrollView>
</LinearLayout>
