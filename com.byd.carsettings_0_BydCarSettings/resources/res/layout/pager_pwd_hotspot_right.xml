<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:paddingStart="@dimen/dp_14">
        <RelativeLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_56"
            android:paddingStart="@dimen/dp_9">
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/text_color_main"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/set_hotspot_pwd_hotspot_right"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_bg_hotspot_pwd_hotspot_right"
            android:background="@drawable/bg_frame_gray_search"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_48"
            android:layout_marginTop="@dimen/dp_25"
            android:paddingStart="@dimen/dp_9"
            android:layout_marginEnd="@dimen/dp_24">
            <com.byd.carsettings.ui.widget.NoMenuEditText
                android:textSize="@dimen/sp_18"
                android:textColor="@color/text_color_main_gray"
                android:id="@+id/et_hotspot_pwd_hotspot_right"
                android:background="@color/transparent_00"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:hint="@string/hint_input_pwd_wireless"
                android:singleLine="true"
                android:maxLength="63"
                android:layout_weight="1"
                android:inputType="textPassword"
                android:imeOptions="actionDone"/>
            <ImageView
                android:id="@+id/iv_hotspot_pwd_hotspot_right"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:src="@drawable/icon_public_closeeeye_48"
                android:layout_marginEnd="@dimen/dp_8"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/text_color_red"
            android:id="@+id/tv_pwd_err_hotspot_right"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:text="@string/pwd_err_8_wireless"
            android:layout_marginStart="@dimen/dp_8"
            android:layout_marginEnd="@dimen/dp_24"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="@dimen/dp_10">
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/text_color_main_gray"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_10"
            android:text="@string/hotspot_not_support_share"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/bottom_view"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_104">
            <com.byd.carsettings.ui.widget.BydInvalidButton
                android:id="@+id/btn_ok_pwd_hotspot_right"
                android:text="@string/dialog_btn_ok"
                style="@style/dialog_btn_ok_dilink_bt"/>
            <com.byd.carsettings.ui.widget.BydInvalidButton
                android:id="@+id/btn_cancel_pwd_hotspot_right"
                android:text="@string/dialog_btn_cancel"
                android:layout_marginStart="@dimen/dp_40"
                style="@style/dialog_btn_cancel_dilink_bt"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
