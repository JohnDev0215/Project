<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/version_sub_parent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ly_version"
        android:background="@drawable/bg_frame_gray_a"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <RelativeLayout
            android:id="@+id/ly_version_detail"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_88">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_main"
                android:id="@+id/tv_title_car_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/dp_300"
                android:text="@string/version_car"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/dp_24"/>
            <ImageView
                android:id="@+id/iv_tip"
                android:visibility="gone"
                android:layout_width="@dimen/dp_8"
                android:layout_height="@dimen/dp_8"
                android:layout_marginTop="@dimen/dp_29"
                android:src="@drawable/bg_dot_update"
                android:layout_toEndOf="@+id/tv_title_car_version"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_blue_night"
                android:id="@+id/tv_upgrade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/version_upgrade"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/dp_24"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <LinearLayout
            android:id="@+id/rl_upgrade_order"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_88">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_main"
                android:gravity="start"
                android:layout_gravity="start|center_vertical"
                android:id="@+id/tv_order"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/version_order"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/dp_24"
                android:layout_marginEnd="@dimen/dp_16"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_blue_night"
                android:gravity="end"
                android:layout_gravity="end|center_vertical"
                android:id="@+id/tv_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel_btn"
                android:layout_marginEnd="@dimen/dp_24"/>
        </LinearLayout>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/ly_media"
        android:background="@drawable/bg_frame_gray_a"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_88"
        android:layout_marginBottom="@dimen/dp_16"
        app:layout_constraintStart_toStartOf="@+id/ly_version"
        app:layout_constraintTop_toBottomOf="@+id/ly_version">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/text_color_main"
            android:id="@+id/tv_media"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/version_media_detail"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/dp_24"/>
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/text_color_blue_night"
            android:id="@+id/tv_media_version_details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/version_show"
            android:layout_centerVertical="true"
            android:paddingStart="@dimen/dp_24"
            android:paddingEnd="@dimen/dp_24"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_frame_gray_a"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_16"
        app:layout_constraintStart_toStartOf="@+id/ly_version"
        app:layout_constraintTop_toBottomOf="@+id/ly_media">
        <RelativeLayout
            android:id="@+id/ly_recover_setting"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_88">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_main"
                android:id="@+id/tv_setting_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/version_recover_setting"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/dp_24"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_blue_night"
                android:id="@+id/tv_recover_setting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/version_recover"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/dp_24"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/ly_recover"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_88">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_main"
                android:id="@+id/tv_recover_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/version_recover_factory"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/dp_24"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_blue_night"
                android:id="@+id/tv_recover"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/version_recover"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/dp_24"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
