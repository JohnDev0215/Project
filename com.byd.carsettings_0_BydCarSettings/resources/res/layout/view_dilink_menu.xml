<?xml version="1.0" encoding="utf-8"?>
<com.byd.mvp.ui.widget.BydHScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/hscv_rg_dilink_fragment"
    android:scrollbars="none"
    android:fadingEdge="horizontal"
    android:fadingEdgeLength="@dimen/dp_88"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:requiresFadingEdge="horizontal">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingEnd="@dimen/dp_60">
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tl_dilink_fragment"
            android:background="@color/transparent"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_44"
            android:layout_marginTop="@dimen/dp_16"
            android:layout_marginStart="@dimen/dp_6"
            app:tabBackground="@color/transparent"
            app:tabIndicator="@drawable/carsetting_tabindicator"
            app:tabIndicatorAnimationDuration="300"
            app:tabIndicatorColor="@color/carsetting_tabitem_selected"
            app:tabIndicatorHeight="@dimen/dp_4"
            app:tabMaxWidth="@dimen/dp_72"
            app:tabMinWidth="@dimen/dp_66"
            app:tabMode="scrollable"
            app:tabRippleColor="@color/transparent"/>
    </LinearLayout>
</com.byd.mvp.ui.widget.BydHScrollView>
