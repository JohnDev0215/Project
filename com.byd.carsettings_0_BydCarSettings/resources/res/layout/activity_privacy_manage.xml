<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="@dimen/dp_560"
    android:layout_height="@dimen/dp_412"
    style="@style/vehicle_setting_dialog_background_container">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_71">
        <ImageView
            android:id="@+id/iv_back_privacy_manage"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:src="@drawable/icon_public_close_48"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/text_color_main_dilink_pagers"
            android:gravity="center"
            android:id="@+id/tv_title_privacy_manage"
            android:layout_width="@dimen/dp_512"
            android:layout_height="@dimen/dp_29"
            android:text="@string/privacy_manage_app_manage"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <View
        android:background="@color/bg_color_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dp_48"
        android:paddingEnd="@dimen/dp_48">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/text_color_main_dilink_pagers"
            android:id="@+id/tv_title_camera_privacy_manage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:text="@string/title_camera_app_manage"/>
        <com.byd.base.view.segmentedbutton.SegmentedButtonGroup
            android:layout_gravity="center_vertical"
            android:id="@+id/srg_camera_privacy_manage"
            android:background="@drawable/shape_bg_gray_radio_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_18"
            style="@style/carsetting_segment_button_group_style">
            <com.byd.base.view.segmentedbutton.SegmentedButton
                android:id="@+id/rbtn_12_months_camera_privacy_manage"
                app:sb_text="@string/valid_date_12_months_app_manage"
                app:sb_textColor="@color/carlights_guest_color"
                app:sb_textColor_onSelection="@color/white"
                app:sb_textSize="@dimen/sp_20"
                style="@style/sbtn_w112_display_pager"/>
            <com.byd.base.view.segmentedbutton.SegmentedButton
                android:id="@+id/rbtn_6_months_camera_privacy_manage"
                app:sb_text="@string/valid_date_6_months_app_manage"
                app:sb_textColor="@color/carlights_guest_color"
                app:sb_textColor_onSelection="@color/white"
                app:sb_textSize="@dimen/sp_20"
                style="@style/sbtn_w112_display_pager"/>
            <com.byd.base.view.segmentedbutton.SegmentedButton
                android:id="@+id/rbtn_single_camera_privacy_manage"
                app:sb_text="@string/valid_date_single_app_manage"
                app:sb_textColor="@color/carlights_guest_color"
                app:sb_textColor_onSelection="@color/white"
                app:sb_textSize="@dimen/sp_20"
                style="@style/sbtn_w112_display_pager"/>
            <com.byd.base.view.segmentedbutton.SegmentedButton
                android:id="@+id/rbtn_close_camera_privacy_manage"
                app:sb_text="@string/valid_date_close_app_manage"
                app:sb_textColor="@color/carlights_guest_color"
                app:sb_textColor_onSelection="@color/white"
                app:sb_textSize="@dimen/sp_20"
                style="@style/sbtn_w112_display_pager"/>
        </com.byd.base.view.segmentedbutton.SegmentedButtonGroup>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/text_color_main_gray"
            android:id="@+id/tv_description_camera_privacy_manage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:text="@string/description_camera_app_manage"
            android:layout_below="@+id/tv_title_camera_privacy_manage"
            android:layout_alignStart="@+id/tv_title_camera_privacy_manage"/>
    </LinearLayout>
    <View
        android:background="@color/bg_color_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_marginTop="@dimen/dp_20"
        android:layout_marginStart="@dimen/dp_48"
        android:layout_marginEnd="@dimen/dp_48"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dp_48"
        android:paddingEnd="@dimen/dp_48">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/text_color_main_dilink_pagers"
            android:id="@+id/tv_title_mic_privacy_manage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:text="@string/title_mic_app_manage"/>
        <com.byd.base.view.segmentedbutton.SegmentedButtonGroup
            android:layout_gravity="center_vertical"
            android:id="@+id/srg_mic_privacy_manage"
            android:background="@drawable/shape_bg_gray_radio_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            style="@style/carsetting_segment_button_group_style">
            <com.byd.base.view.segmentedbutton.SegmentedButton
                android:id="@+id/rbtn_12_months_mic_privacy_manage"
                app:sb_text="@string/valid_date_12_months_app_manage"
                app:sb_textColor="@color/carlights_guest_color"
                app:sb_textColor_onSelection="@color/white"
                app:sb_textSize="@dimen/sp_20"
                style="@style/sbtn_w112_display_pager"/>
            <com.byd.base.view.segmentedbutton.SegmentedButton
                android:id="@+id/rbtn_6_months_mic_privacy_manage"
                app:sb_text="@string/valid_date_6_months_app_manage"
                app:sb_textColor="@color/carlights_guest_color"
                app:sb_textColor_onSelection="@color/white"
                app:sb_textSize="@dimen/sp_20"
                style="@style/sbtn_w112_display_pager"/>
            <com.byd.base.view.segmentedbutton.SegmentedButton
                android:id="@+id/rbtn_single_mic_privacy_manage"
                app:sb_text="@string/valid_date_single_app_manage"
                app:sb_textColor="@color/carlights_guest_color"
                app:sb_textColor_onSelection="@color/white"
                app:sb_textSize="@dimen/sp_20"
                style="@style/sbtn_w112_display_pager"/>
            <com.byd.base.view.segmentedbutton.SegmentedButton
                android:id="@+id/rbtn_close_mic_privacy_manage"
                app:sb_text="@string/valid_date_close_app_manage"
                app:sb_textColor="@color/carlights_guest_color"
                app:sb_textColor_onSelection="@color/white"
                app:sb_textSize="@dimen/sp_20"
                style="@style/sbtn_w112_display_pager"/>
        </com.byd.base.view.segmentedbutton.SegmentedButtonGroup>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/text_color_main_gray"
            android:id="@+id/tv_description_mic_privacy_manage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:text="@string/description_mic_app_manage"
            android:layout_below="@+id/tv_title_mic_privacy_manage"
            android:layout_alignStart="@+id/tv_title_mic_privacy_manage"/>
    </LinearLayout>
</LinearLayout>
