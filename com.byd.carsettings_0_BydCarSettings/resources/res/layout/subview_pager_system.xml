<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingBottom="@dimen/dp_24"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_time_system_pager"
        android:background="@drawable/bg_frame_gray_a"
        android:layout_width="@dimen/dp_640"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_time_sync_system_pager"
            android:background="@drawable/bg_frame_gray_a"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_88"
            android:paddingStart="@dimen/dp_24"
            android:paddingEnd="@dimen/dp_24">
            <com.byd.base.view.BydSwitch
                android:id="@+id/switch_time_sync_system_pager"
                android:layout_marginEnd="@dimen/dp_16"
                style="@style/byd_switch"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_title_time_sync_system_pager"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="@dimen/sp_20"
                    android:textColor="@color/text_color_main"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/time_auto_sync_system"/>
            </LinearLayout>
        </LinearLayout>
        <com.byd.carsettings.ui.widget.TintLinearItem
            android:id="@+id/item_time_system_pager"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_88"
            app:textLeft="@string/time_system"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/item_time_zone_system_pager"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_88">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_item_left_dilink_link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/time_zone_system"
                android:layout_marginStart="@dimen/dp_24"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_item_right_dilink_link"
                android:gravity="end|center_vertical"
                android:id="@+id/tv_zone_name"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
            <ImageView
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:src="@drawable/icon_public_rightarrow_48"
                app:color_close_state="@color/text_color_main_gray"
                app:color_open_state="@color/text_color_main"/>
        </LinearLayout>
        <RelativeLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_time_system_system_pager"
            android:background="@drawable/bg_frame_gray_a"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_88"
            android:paddingStart="@dimen/dp_24"
            android:paddingEnd="@dimen/dp_24">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_main"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/time_system_system"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>
            <com.byd.base.view.segmentedbutton.SegmentedButtonGroup
                android:layout_gravity="center_vertical"
                android:id="@+id/srg_time_system_system_pager"
                android:background="@drawable/shape_bg_gray_radio_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/dp_16"
                android:layout_alignParentEnd="true"
                style="@style/carsetting_segment_button_group_style_12h_24h">
                <com.byd.base.view.segmentedbutton.SegmentedButton
                    android:id="@+id/rbtn_24_time_system_12_system"
                    app:sb_text="@string/time_system_24_system"
                    style="@style/sbtn_3_display_pager"/>
                <com.byd.base.view.segmentedbutton.SegmentedButton
                    android:id="@+id/rbtn_12_time_system_12_system"
                    app:sb_text="@string/time_system_12_system"
                    style="@style/sbtn_3_display_pager"/>
            </com.byd.base.view.segmentedbutton.SegmentedButtonGroup>
        </RelativeLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_language_input_system_pager"
        android:background="@drawable/bg_frame_gray_a"
        android:layout_width="@dimen/dp_640"
        android:layout_height="@dimen/dp_264"
        android:layout_marginTop="@dimen/dp_16">
        <com.byd.carsettings.ui.widget.LinearItem
            android:id="@+id/item_language_system_pager"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_88"
            app:textLeft="@string/language_system"/>
        <com.byd.carsettings.ui.widget.SimpleLinearItem
            android:id="@+id/item_def_input_method_pager"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_88"
            app:textLeft="@string/def_input_method"/>
        <com.byd.carsettings.ui.widget.SimpleLinearItem
            android:id="@+id/item_cur_input_setting_method_pager"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_88"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_memory_playback_system_pager"
        android:background="@drawable/bg_frame_gray_a"
        android:layout_width="@dimen/dp_640"
        android:layout_height="@dimen/dp_88"
        android:layout_marginTop="@dimen/dp_16"
        android:paddingStart="@dimen/dp_24"
        android:paddingEnd="@dimen/dp_24">
        <com.byd.base.view.BydSwitch
            android:id="@+id/switch_memory_playback_system_pager"
            android:layout_marginEnd="@dimen/dp_16"
            style="@style/byd_switch"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_title_memory_playback_system_pager"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_item_left_dilink_link"
                android:id="@+id/tv_memory_playback_system_pager"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/memory_playback"/>
            <ImageView
                android:id="@+id/iv_details_memory_playback_system_pager"
                android:background="@drawable/icon_public_details_48"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"/>
        </LinearLayout>
    </LinearLayout>
    <RelativeLayout
        android:orientation="vertical"
        android:background="@drawable/bg_frame_gray_a"
        android:layout_width="@dimen/dp_640"
        android:layout_height="@dimen/dp_88"
        android:layout_marginTop="@dimen/dp_16">
        <com.byd.carsettings.ui.widget.SimpleLinearItem
            android:id="@+id/item_unit_system_pager"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_88"
            app:textLeft="@string/unit_setting_system"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_unit_protocol_system_pager"
        android:background="@drawable/bg_frame_gray_a"
        android:layout_width="@dimen/dp_640"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16">
        <com.byd.carsettings.ui.widget.SimpleLinearItem
            android:id="@+id/item_user_agreement_system_pager"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_88"
            app:textLeft="@string/user_agreement_system"/>
        <com.byd.carsettings.ui.widget.SimpleLinearItem
            android:id="@+id/item_privacy_policy_system_pager"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_88"
            app:textLeft="@string/privacy_policy_system"/>
        <com.byd.carsettings.ui.widget.SimpleLinearItem
            android:id="@+id/item_licenses_system_pager"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_88"
            app:textLeft="@string/open_source_licenses"/>
    </LinearLayout>
</LinearLayout>
