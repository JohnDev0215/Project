<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingBottom="@dimen/dp_30"
    android:layout_width="@dimen/dp_560"
    android:layout_height="wrap_content"
    android:splitMotionEvents="false"
    android:windowEnableSplitTouch="false"
    style="@style/vehicle_setting_dialog_background_container">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_71">
        <ImageView
            android:id="@+id/iv_back_dialog_security"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:layout_marginLeft="@dimen/dp_16"
            android:src="@drawable/icon_public_close_48"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="@dimen/sp_20"
            android:textStyle="bold"
            android:textColor="@color/text_color_main_dilink_pagers"
            android:gravity="center"
            android:id="@+id/tv_title_dialog_security"
            android:layout_width="@dimen/dp_512"
            android:layout_height="@dimen/dp_29"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <View
        android:background="@color/bg_color_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"/>
    <RelativeLayout
        android:gravity="center_vertical"
        android:paddingLeft="@dimen/dp_48"
        android:paddingRight="@dimen/dp_48"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_74"
        android:layout_marginTop="@dimen/dp_19">
        <com.byd.base.view.BydSwitch
            android:id="@+id/switch_show_credential_dialog_security"
            android:layout_alignParentLeft="true"
            style="@style/byd_switch"/>
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/text_color_main"
            android:paddingTop="@dimen/dp_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/show_security_app_manage"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
    <View
        android:background="@color/bg_color_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_marginStart="@dimen/dp_48"
        android:layout_marginEnd="@dimen/dp_48"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_74"
        android:paddingStart="@dimen/dp_48"
        android:paddingEnd="@dimen/dp_48">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/text_color_main"
            android:id="@+id/tv_title_credential_storage_dialog_security"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/save_credential_app_manage"/>
        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingStart="@dimen/dp_8">
            <com.byd.carsettings.ui.widget.BydInvalidButton
                android:textSize="@dimen/sp_18"
                android:textColor="@color/text_color_btn_blue"
                android:id="@+id/btn_clear_credential_dialog_security"
                android:background="@drawable/bg_frame_gray_big_corner_btn_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxHeight="@dimen/dp_48"
                android:minWidth="@dimen/dp_128"
                android:text="@string/clear_credential_app_manage"
                android:layout_centerVertical="true"
                android:paddingStart="@dimen/dp_8"
                android:layout_alignParentEnd="true"
                android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"/>
        </RelativeLayout>
    </LinearLayout>
    <View
        android:background="@color/bg_color_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_marginStart="@dimen/dp_48"
        android:layout_marginEnd="@dimen/dp_48"/>
    <RelativeLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/rl_show_credential_dialog_security"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_74"
        android:paddingStart="@dimen/dp_48"
        android:paddingEnd="@dimen/dp_35">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/text_color_main"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_7"
            android:text="@string/trusted_credential_app_manage"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/text_color_main_gray"
            android:id="@+id/tv_show_credential_dialog_security"
            android:paddingBottom="@dimen/dp_12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/show_credential_app_manage"
            android:layout_alignParentBottom="true"
            android:layout_alignParentStart="true"/>
        <ImageView
            android:background="@drawable/icon_public_rightarrow_48"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <View
        android:background="@color/bg_color_line"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"/>
    <RelativeLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/rl_install_credential_dialog_security"
        android:visibility="gone"
        android:layout_width="@dimen/dp_512"
        android:layout_height="@dimen/dp_74"
        android:layout_marginBottom="@dimen/dp_31"
        android:paddingStart="@dimen/dp_24">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/text_color_main"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_7"
            android:text="@string/install_from_sdcard_app_manage"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/text_color_main_gray"
            android:id="@+id/tv_install_credential_dialog_security"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_12"
            android:text="@string/install_credential_app_manage"
            android:layout_alignParentBottom="true"
            android:layout_alignParentStart="true"/>
        <ImageView
            android:background="@drawable/icon_public_rightarrow_48"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp_8"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</LinearLayout>
