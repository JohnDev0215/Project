<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="@dimen/dp_120"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/dp_24"
        android:textColor="@color/digital_key_empty_des"
        android:gravity="center"
        android:id="@+id/tv_empty_des"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/nfc_add_message"
        android:layout_centerHorizontal="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_banner"
        android:paddingTop="@dimen/dp_60"
        android:layout_width="@dimen/dp_360"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tv_empty_des"
        android:layout_centerHorizontal="true">
        <com.youth.banner.indicator.CircleIndicator
            android:layout_gravity="center_horizontal"
            android:id="@+id/circle_indicator"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_6"/>
        <com.youth.banner.Banner
            android:id="@+id/banner_view"
            android:layout_width="@dimen/dp_360"
            android:layout_height="@dimen/dp_191"
            android:layout_marginTop="@dimen/dp_16"
            android:layout_marginBottom="@dimen/dp_15"
            android:src="@drawable/digital_empty_image"
            app:banner_indicator_normal_color="@color/banner_indicator_normal_color"
            app:banner_indicator_normal_width="@dimen/dp_6"
            app:banner_indicator_selected_color="@color/banner_indicator_selected_color"
            app:banner_indicator_selected_width="@dimen/dp_6"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/dp_18"
        android:textColor="@color/digital_key_empty_des"
        android:id="@+id/tv_banner_des"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/nfc_banner_1_des"
        android:layout_below="@+id/ll_banner"
        android:layout_centerHorizontal="true"/>
    <RelativeLayout
        android:id="@+id/rl_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_145"
        android:layout_below="@+id/tv_banner_des"
        android:layout_centerHorizontal="true">
        <ImageView
            android:id="@+id/iv_2"
            android:visibility="gone"
            android:layout_width="@dimen/dp_96"
            android:layout_height="@dimen/dp_96"
            android:src="@drawable/nfc_img_carsetting_apple"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/iv_2">
            <TextView
                android:textSize="@dimen/sp_21"
                android:textColor="@color/nfc_apple_support_color"
                android:gravity="center"
                android:id="@+id/nfc_activate_service_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/dp_30"
                android:paddingEnd="@dimen/dp_30"/>
        </LinearLayout>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_32"
        android:layout_below="@+id/rl_2">
        <com.byd.base.view.MultiStyleTextView
            android:textSize="@dimen/sp_18"
            android:gravity="center"
            android:id="@+id/add_digital_key_btn"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_40"
            android:minWidth="@dimen/dp_144"
            android:text="@string/nfc_apple_add_now"
            android:textAllCaps="false"
            android:paddingStart="@dimen/dp_12"
            android:paddingEnd="@dimen/dp_12"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/nfc_apple_support_adapter_color"
            android:id="@+id/tv_user_report"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/dp_24"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/loading_ll"
        android:padding="@dimen/dp_25"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <ImageView
            android:id="@+id/iv_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_light_public_loading_sm"/>
    </LinearLayout>
</RelativeLayout>
