<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="?attr/dialog_text_color_main"
        android:id="@+id/tv_index1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_30"
        android:text="@string/newenergy_discharge_mps_safety_instructions_index1"
        android:paddingStart="@dimen/dp_48"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="?attr/dialog_text_color_main"
        android:id="@+id/tv_content1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_40"
        android:text="@string/newenergy_discharge_mps_safety_instructions_content1"
        android:paddingEnd="@dimen/dp_48"
        android:layout_toEndOf="@+id/tv_index1"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="?attr/dialog_text_color_main"
        android:id="@+id/tv_index2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/newenergy_discharge_mps_safety_instructions_index2"
        android:layout_below="@+id/tv_content1"
        android:paddingStart="@dimen/dp_48"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="?attr/dialog_text_color_main"
        android:id="@+id/tv_content2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/newenergy_discharge_mps_safety_instructions_content2"
        android:layout_below="@+id/tv_content1"
        android:paddingEnd="@dimen/dp_48"
        android:layout_toEndOf="@+id/tv_index2"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="?attr/dialog_text_color_main"
        android:id="@+id/tv_index3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/newenergy_discharge_mps_safety_instructions_index3"
        android:layout_below="@+id/tv_content2"
        android:paddingStart="@dimen/dp_48"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="?attr/dialog_text_color_main"
        android:id="@+id/tv_content3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/newenergy_discharge_mps_safety_instructions_content3"
        android:layout_below="@+id/tv_content2"
        android:paddingEnd="@dimen/dp_48"
        android:layout_toEndOf="@+id/tv_index3"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="?attr/dialog_text_color_main"
        android:id="@+id/tv_index4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/newenergy_discharge_mps_safety_instructions_index4"
        android:layout_below="@+id/tv_content3"
        android:paddingStart="@dimen/dp_48"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="?attr/dialog_text_color_main"
        android:id="@+id/tv_content4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/newenergy_discharge_mps_safety_instructions_content4"
        android:layout_below="@+id/tv_content3"
        android:paddingEnd="@dimen/dp_48"
        android:layout_toEndOf="@+id/tv_index4"/>
    <CheckBox
        android:textSize="@dimen/sp_18"
        android:textColor="?attr/dialog_text_gray"
        android:id="@+id/cb_reminder"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_16"
        android:button="@drawable/checkbox_circle_bg_selector"
        android:text="@string/newenergy_discharge_mps_no_more_hint"
        android:layout_below="@+id/tv_content4"
        android:layout_marginStart="@dimen/dp_40"
        android:layout_marginEnd="@dimen/dp_40"/>
</RelativeLayout>
