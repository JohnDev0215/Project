<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_frame_gray_a"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.byd.carsettings.ui.widget.LinearItem
            android:id="@+id/item_sound_balance_sound_harman"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_88"
            app:textLeft="@string/sound_field_balance_sound"
            app:textRight="@string/whole_car_sound_balance_harman_sound"/>
        <com.byd.carsettings.ui.widget.LinearItem
            android:id="@+id/item_sound_fade_sound_harman"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_88"
            app:textLeft="@string/sound_fade_harman_sound"/>
        <com.byd.carsettings.ui.widget.LinearItem
            android:id="@+id/item_sound_equalizer_sound_harman"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_88"
            app:textLeft="@string/sound_equalizer_harman_sound"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_frame_gray_a"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:paddingStart="@dimen/dp_24"
        android:paddingEnd="@dimen/dp_24">
        <RelativeLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_26">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_main"
                android:id="@+id/tv_title_sound_regulate_sound_harman"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_dialog_sound_regulate_dynaudio_sound"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>
        </RelativeLayout>
        <com.byd.base.view.segmentedbutton.SegmentedButtonGroup
            android:layout_gravity="center_vertical"
            android:id="@+id/srg_sound_regulate_sound_harman"
            android:background="@drawable/shape_bg_gray_radio_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_26"
            android:layout_marginBottom="@dimen/dp_27"
            style="@style/carsetting_segment_button_group_style">
            <com.byd.base.view.segmentedbutton.SegmentedButton
                android:id="@+id/rbtn_high_sound_harman"
                app:sb_text="@string/high_sound_regulate_harman_sound"
                app:sb_textColor="@color/carlights_guest_color"
                app:sb_textColor_onSelection="@color/white"
                app:sb_textSize="@dimen/sp_20"
                style="@style/srbtn_sound_regulate_harman"/>
            <com.byd.base.view.segmentedbutton.SegmentedButton
                android:id="@+id/rbtn_middle_sound_harman"
                app:sb_text="@string/middle_sound_regulate_harman_sound"
                app:sb_textColor="@color/carlights_guest_color"
                app:sb_textColor_onSelection="@color/white"
                app:sb_textSize="@dimen/sp_20"
                style="@style/srbtn_sound_regulate_harman"/>
            <com.byd.base.view.segmentedbutton.SegmentedButton
                android:id="@+id/rbtn_low_sound_harman"
                app:sb_text="@string/low_sound_regulate_harman_sound"
                app:sb_textColor="@color/carlights_guest_color"
                app:sb_textColor_onSelection="@color/white"
                app:sb_textSize="@dimen/sp_20"
                style="@style/srbtn_sound_regulate_harman"/>
            <com.byd.base.view.segmentedbutton.SegmentedButton
                android:id="@+id/rbtn_close_sound_harman"
                app:sb_text="@string/close_sound_regulate_harman_sound"
                app:sb_textColor="@color/carlights_guest_color"
                app:sb_textColor_onSelection="@color/white"
                app:sb_textSize="@dimen/sp_20"
                style="@style/srbtn_sound_regulate_harman"/>
        </com.byd.base.view.segmentedbutton.SegmentedButtonGroup>
    </LinearLayout>
</LinearLayout>
