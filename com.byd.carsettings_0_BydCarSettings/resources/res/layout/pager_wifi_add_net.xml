<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_pager_add_net"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_15"
        android:layout_alignParentTop="true"
        android:paddingStart="@dimen/dp_30">
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/text_color_main"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mobile_network_wireless"/>
        <LinearLayout
            android:id="@+id/ll_bg_net_name_pager_add_net"
            android:background="@drawable/bg_frame_gray_search_no_stroke"
            android:layout_width="@dimen/dp_277"
            android:layout_height="@dimen/dp_48"
            android:layout_marginTop="@dimen/dp_30"
            android:paddingStart="@dimen/dp_12">
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/text_color_main_gray"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wifi_name_wireless"/>
            <com.byd.carsettings.ui.widget.NoMenuEditText
                android:textSize="@dimen/sp_18"
                android:textColor="@color/text_color_main"
                android:textColorHint="@color/text_color_main_gray"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/et_net_name_pager_add_net"
                android:background="@color/transparent_00"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:hint="@string/wifi_name_wireless"
                android:singleLine="true"
                android:maxLength="32"
                android:layout_weight="1"
                android:inputType="text"
                android:imeOptions="actionDone"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/text_color_red"
            android:id="@+id/tv_net_name_err_pager_add_net"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:maxWidth="@dimen/dp_277"
            android:text="@string/net_name_err_32_wireless"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_60"
            android:layout_marginTop="@dimen/dp_6"
            android:layout_marginEnd="@dimen/dp_24">
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/text_color_main"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wifi_security_wireless"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_net_security_pwd_pager_add_net"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true">
                <TextView
                    android:textSize="@dimen/sp_18"
                    android:textColor="@color/text_color_main_gray"
                    android:id="@+id/tv_net_security_pwd_pager_add_net"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wifi_security_wireless"/>
                <ImageView
                    android:id="@+id/iv_show_security_list_pager_add_net"
                    android:layout_width="@dimen/dp_48"
                    android:layout_height="@dimen/dp_48"
                    android:src="@drawable/icon_public_arrow_down_gray_48"/>
            </LinearLayout>
        </RelativeLayout>
        <LinearLayout
            android:id="@+id/ll_net_pwd_pager_add_net"
            android:background="@drawable/bg_frame_gray_search_no_stroke"
            android:visibility="gone"
            android:layout_width="@dimen/dp_277"
            android:layout_height="@dimen/dp_48"
            android:layout_marginTop="@dimen/dp_6"
            android:paddingStart="@dimen/dp_12"
            android:layout_marginEnd="@dimen/dp_24">
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/text_color_main_gray"
                android:id="@+id/tv_title_add_pwd_wireless"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_add_pwd_wireless"/>
            <com.byd.carsettings.ui.widget.NoMenuEditText
                android:textSize="@dimen/sp_18"
                android:textColor="@color/text_color_main"
                android:textColorHint="@color/text_color_main_gray"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/et_net_pwd_pager_add_net"
                android:background="@color/transparent_00"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:hint="@string/title_add_pwd_wireless"
                android:singleLine="true"
                android:maxLength="63"
                android:layout_weight="1"
                android:inputType="textPassword"
                android:imeOptions="actionDone"/>
            <ImageView
                android:id="@+id/iv_net_pwd_pager_add_net"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:src="@drawable/icon_public_closeeeye_48"
                android:layout_marginEnd="@dimen/dp_8"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/text_color_red"
            android:id="@+id/tv_pwd_err_pager_add_net"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:maxWidth="@dimen/dp_277"
            android:text="@string/pwd_err_8_wireless"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_104"
        android:layout_alignParentBottom="true">
        <com.byd.carsettings.ui.widget.BydInvalidButton
            android:id="@+id/btn_connect_pager_add_net"
            android:text="@string/connect_wireless"
            style="@style/dialog_btn_ok_dilink_bt"/>
        <com.byd.carsettings.ui.widget.BydInvalidButton
            android:id="@+id/btn_cancel_pager_add_net"
            android:text="@string/dialog_btn_cancel"
            android:layout_marginStart="@dimen/dp_40"
            style="@style/dialog_btn_cancel_dilink_bt"/>
    </LinearLayout>
</RelativeLayout>
