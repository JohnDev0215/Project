<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/dp_880"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/sp_20"
        android:textStyle="bold"
        android:textColor="?attr/text_color_main"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_68"
        android:text="@string/newenergy_discharge_mps_discharging_title"
        android:layout_marginStart="@dimen/dp_119"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="?attr/text_color_main_gray_85"
        android:id="@+id/tv_remain_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_99"
        android:text="@string/newenergy_discharge_mps_discharge_remain_time"
        android:layout_marginStart="@dimen/dp_119"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="?attr/text_color_main"
        android:id="@+id/tv_remain_time_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_97"
        android:layout_marginStart="@dimen/dp_10"
        android:layout_toEndOf="@+id/tv_remain_time"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="?attr/text_color_main"
        android:id="@+id/tv_detail"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_30"
        android:layout_marginTop="@dimen/dp_83"
        android:text="@string/newenergy_discharge_mps_detail_info"
        android:drawableRight="@mipmap/ic_arrow_right"
        android:drawablePadding="@dimen/dp_8"
        android:layout_marginEnd="@dimen/dp_133"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
