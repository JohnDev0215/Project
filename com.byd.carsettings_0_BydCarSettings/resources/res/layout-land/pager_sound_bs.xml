<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_frame_gray_a"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.byd.carsettings.ui.widget.LinearItem
            android:id="@+id/item_sound_field_focusing_sound_bs"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_88"
            app:textLeft="@string/sound_field_bs_sound"
            app:textRight="@string/all_sound_focus_dynaudio_sound"/>
        <com.byd.carsettings.ui.widget.LinearItem
            android:id="@+id/item_sound_charact_sound_bs"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_88"
            app:textLeft="@string/sound_charact_bs_sound"
            app:textRight="@string/classics_charact_bs_sound"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_sound_all_dimensional_sound_bs"
        android:background="@drawable/bg_frame_gray_a"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_88"
        android:layout_marginTop="@dimen/dp_16"
        android:paddingStart="@dimen/dp_24"
        android:paddingEnd="@dimen/dp_24">
        <com.byd.base.view.BydSwitch
            android:id="@+id/switch_all_dimensional_sound_bs"
            android:layout_marginEnd="@dimen/dp_16"
            style="@style/byd_switch"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_title_sound_all_dimensional_sound_bs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_item_left_dilink_link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sound_all_dimensional_bs_sound"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_sound_regulate_sound_bs"
        android:background="@drawable/bg_frame_gray_a"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16">
        <RelativeLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_26"
            android:paddingStart="@dimen/dp_24"
            android:paddingEnd="@dimen/dp_24">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_main"
                android:id="@+id/tv_title_sound_regulate_sound_bs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/dp_520"
                android:text="@string/title_dialog_sound_regulate_dynaudio_sound"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>
            <ImageView
                android:id="@+id/iv_sound_regulate_detail_sound_bs"
                android:background="@drawable/icon_public_details_48"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@+id/tv_title_sound_regulate_sound_bs"/>
        </RelativeLayout>
        <com.byd.base.view.segmentedbutton.SegmentedButtonGroup
            android:layout_gravity="start|center_vertical"
            android:id="@+id/srg_sound_regulate_sound_bs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_23"
            android:layout_marginBottom="@dimen/dp_24"
            android:layout_marginStart="@dimen/dp_24"
            android:layout_marginEnd="@dimen/dp_24"
            style="@style/dilink_segment_button_group_style">
            <com.byd.base.view.segmentedbutton.SegmentedButton
                android:id="@+id/rbtn_close_sound_regulate_sound_bs"
                app:sb_text="@string/close_sound_regulate"
                style="@style/sbtn_4_display_pager_land"/>
            <com.byd.base.view.segmentedbutton.SegmentedButton
                android:id="@+id/rbtn_l_sound_regulate_sound_bs"
                app:sb_text="@string/l_sound_regulate"
                style="@style/sbtn_4_display_pager_land"/>
            <com.byd.base.view.segmentedbutton.SegmentedButton
                android:id="@+id/rbtn_m_sound_regulate_sound_bs"
                app:sb_text="@string/m_sound_regulate"
                style="@style/sbtn_4_display_pager_land"/>
            <com.byd.base.view.segmentedbutton.SegmentedButton
                android:id="@+id/rbtn_h_sound_regulate_sound_bs"
                app:sb_text="@string/h_sound_regulate"
                style="@style/sbtn_4_display_pager_land"/>
        </com.byd.base.view.segmentedbutton.SegmentedButtonGroup>
    </LinearLayout>
</LinearLayout>
