<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_vertical"
    android:orientation="vertical"
    android:layout_width="@dimen/dp_560"
    android:layout_height="wrap_content"
    android:maxHeight="@dimen/dp_544"
    android:minHeight="@dimen/dp_264"
    style="@style/vehicle_setting_dialog_background_container">
    <RelativeLayout
        android:id="@+id/carsetting_dialog_head"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_72">
        <TextView
            android:id="@+id/carsetting_dialog_title"
            style="@style/byd_vehicle_setting_dialog_title_style"/>
        <View
            android:id="@+id/carsetting_dialog_line"
            android:background="@color/ambient_dialog_line_bg"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dp_28"
        android:layout_marginBottom="@dimen/dp_28">
        <ScrollView
            android:scrollbarThumbVertical="@drawable/setting_bar_thumb"
            android:scrollbarTrackVertical="@drawable/setting_bar_track"
            android:scrollbarStyle="insideOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:overScrollMode="never">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/carsetting_dialog_image_content"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_centerInParent="true"/>
                <TextView
                    android:textSize="@dimen/sp_20"
                    android:textColor="@color/carlights_guest_color"
                    android:gravity="center"
                    android:id="@+id/carsetting_dialog_main_content"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/dp_58"
                    android:layout_centerInParent="true"
                    android:textDirection="locale"
                    android:layout_marginStart="@dimen/dp_48"
                    android:layout_marginEnd="@dimen/dp_48"/>
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textColor="@color/aircondition_second_text"
                    android:id="@+id/carsetting_dialog_second_content"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dp_16"
                    android:layout_below="@+id/carsetting_dialog_main_content"
                    android:layout_alignParentBottom="true"
                    android:textDirection="locale"
                    android:layout_marginStart="@dimen/dp_48"
                    android:layout_marginEnd="@dimen/dp_48"/>
            </RelativeLayout>
        </ScrollView>
    </RelativeLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/carsetting_dialog_bottom"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_76">
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <Button
                android:textSize="@dimen/sp_18"
                android:textColor="@color/white"
                android:id="@+id/carsetting_dialog_btn_confirm"
                android:background="@drawable/selector_dialog_blue"
                android:visibility="gone"
                android:layout_width="@dimen/dp_176"
                android:layout_height="@dimen/dp_48"
                android:layout_marginBottom="@dimen/dp_28"
                android:text="@string/vehiclesettings_button_confirm"
                android:textAllCaps="false"
                android:textDirection="locale"
                android:layout_marginStart="@dimen/dp_48"
                android:layout_toEndOf="@+id/carsetting_dialog_btn_cancel"
                android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"/>
            <Button
                android:textSize="@dimen/sp_18"
                android:textColor="@color/ambient_btn_cancel"
                android:id="@+id/carsetting_dialog_btn_cancel"
                android:background="@drawable/selector_dialog_white"
                android:visibility="gone"
                android:layout_width="@dimen/dp_176"
                android:layout_height="@dimen/dp_48"
                android:layout_marginBottom="@dimen/dp_28"
                android:text="@string/vehiclesettings_button_cancel"
                android:textAllCaps="false"
                android:textDirection="locale"
                android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"/>
        </RelativeLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
