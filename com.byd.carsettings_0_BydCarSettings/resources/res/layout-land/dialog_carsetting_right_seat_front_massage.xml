<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/dp_1088"
    android:layout_height="@dimen/dp_518"
    style="@style/vehicle_setting_dialog_background_container">
    <ImageView
        android:id="@+id/carseat_massage_close_imge"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_12"
        android:src="@drawable/icon_public_close_48"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.byd.base.view.segmentedbutton.SegmentedButtonGroup
        android:id="@+id/carseat_seat_position"
        android:layout_width="@dimen/dp_412"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_34"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/vehicle_setting_base_seg_style">
        <com.byd.base.view.segmentedbutton.SegmentedButton
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:minHeight="@dimen/dp_48"
            android:layout_weight="1"
            app:sb_text="@string/vehiclesettings_carseat_massage_front"
            app:sb_textSize="@dimen/sp_22"
            style="@style/vehicle_setting_base_seg_btn_common_style"/>
        <com.byd.base.view.segmentedbutton.SegmentedButton
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:minHeight="@dimen/dp_48"
            android:layout_weight="1"
            app:sb_text="@string/vehiclesettings_carseat_massage_rear"
            app:sb_textSize="@dimen/sp_22"
            style="@style/vehicle_setting_base_seg_btn_common_style"/>
    </com.byd.base.view.segmentedbutton.SegmentedButtonGroup>
    <TextView
        android:textSize="@dimen/dp_22"
        android:textColor="@color/carlights_guest_color"
        android:gravity="center"
        android:id="@+id/carset_massage_title"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_34"
        android:layout_centerInParent="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <RelativeLayout
        android:id="@+id/cl_seat_driver_massage"
        android:layout_width="?attr/byd_vehicle_massage_seat_image_width"
        android:layout_height="?attr/byd_vehicle_massage_seat_image_height"
        android:layout_marginTop="?attr/byd_vehicle_massage_seat_image_top"
        android:layout_marginStart="?attr/byd_vehicle_massage_seat_image_start"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <RelativeLayout
            android:id="@+id/cl_seat_driver_massage_bg_rl"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:rotationY="180">
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/massage_lottie_left"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
        </RelativeLayout>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/cl_seat_copilot_massage"
        android:layout_width="?attr/byd_vehicle_massage_seat_image_width"
        android:layout_height="?attr/byd_vehicle_massage_seat_image_height"
        android:layout_marginTop="?attr/byd_vehicle_massage_seat_image_top"
        android:layout_marginEnd="?attr/byd_vehicle_massage_seat_image_end"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <RelativeLayout
            android:id="@+id/cl_seat_copilot_massage_bg_rl"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true">
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/massage_lottie_right"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
        </RelativeLayout>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/massage_container_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/byd_vehicle_massage_seat_image_top"
        android:layout_marginStart="@dimen/dp_52"
        app:layout_constraintEnd_toStartOf="@+id/cl_seat_driver_massage"
        app:layout_constraintTop_toTopOf="parent">
        <CheckBox
            android:textSize="@dimen/sp_14"
            android:textColor="@color/btn_selected_selector"
            android:id="@+id/ib_seat_driver_massage_toggle_left"
            android:background="@drawable/btn_massage_toggle_background"
            android:layout_width="@dimen/dp_67"
            android:layout_height="wrap_content"
            android:button="@null"
            android:minHeight="@dimen/dp_40"
            android:text="OFF"
            android:layout_centerVertical="true"
            android:textAlignment="center"/>
        <com.byd.base.view.segmentedbutton.SegmentedButtonGroup
            android:id="@+id/sbg_seat_driver_massage"
            android:layout_width="@dimen/dp_213"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/dp_40"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_toEndOf="@+id/ib_seat_driver_massage_toggle_left"
            app:layout_constraintStart_toEndOf="@+id/ib_seat_driver_massage_toggle_left"
            app:layout_constraintTop_toTopOf="parent"
            app:sbg_firstSelectorColor="@color/first_segment_button_bg"
            app:sbg_position="0"
            app:sbg_radius="@dimen/dp_30"
            app:sbg_rippleColor="@android:color/transparent"
            style="@style/vehicle_setting_base_seg_style">
            <com.byd.base.view.segmentedbutton.SegmentedButton
                android:layout_width="@dimen/dp_0"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:sb_text="@string/vehiclesettings_control_reminder_touch_weak"
                app:sb_textSize="@dimen/sp_14"
                style="@style/vehicle_setting_base_seg_btn_common_style"/>
            <com.byd.base.view.segmentedbutton.SegmentedButton
                android:layout_width="@dimen/dp_0"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:sb_text="@string/vehiclesettings_control_reminder_touch_middle"
                app:sb_textSize="@dimen/sp_14"
                style="@style/vehicle_setting_base_seg_btn_common_style"/>
            <com.byd.base.view.segmentedbutton.SegmentedButton
                android:layout_width="@dimen/dp_0"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:sb_text="@string/vehiclesettings_control_touch_strong"
                app:sb_textSize="@dimen/sp_14"
                style="@style/vehicle_setting_base_seg_btn_common_style"/>
        </com.byd.base.view.segmentedbutton.SegmentedButtonGroup>
    </RelativeLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_driver_massage_style_container"
        android:background="@drawable/shape_seat_massage_bg"
        android:layout_width="@dimen/dp_300"
        android:layout_height="@dimen/dp_217"
        android:layout_marginTop="@dimen/dp_24"
        app:layout_constraintEnd_toEndOf="@+id/massage_container_left"
        app:layout_constraintStart_toStartOf="@+id/massage_container_left"
        app:layout_constraintTop_toBottomOf="@+id/massage_container_left">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/massage_mode_left"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageButton
                android:id="@+id/ib_seat_driver_massage_shoulder"
                android:background="@drawable/massage_shoulder_selector"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:layout_marginTop="@dimen/dp_20"
                android:layout_marginStart="@dimen/dp_34"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:id="@+id/tv_seat_driver_massage_shoulder"
                android:text="@string/vehiclesettings_seat_massage_mode_relieve"
                app:layout_constraintEnd_toEndOf="@+id/ib_seat_driver_massage_shoulder"
                app:layout_constraintStart_toStartOf="@+id/ib_seat_driver_massage_shoulder"
                app:layout_constraintTop_toBottomOf="@+id/ib_seat_driver_massage_shoulder"
                style="@style/vehicle_setting_massage_button_text"/>
            <ImageButton
                android:id="@+id/ib_seat_driver_massage_waist"
                android:background="@drawable/massage_waist_selector"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:layout_marginTop="@dimen/dp_20"
                android:layout_marginStart="@dimen/dp_44"
                app:layout_constraintStart_toEndOf="@+id/ib_seat_driver_massage_shoulder"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:id="@+id/tv_seat_driver_massage_waist"
                android:text="@string/vehiclesettings_seat_massage_mode_slack"
                app:layout_constraintEnd_toEndOf="@+id/ib_seat_driver_massage_waist"
                app:layout_constraintStart_toStartOf="@+id/ib_seat_driver_massage_waist"
                app:layout_constraintTop_toBottomOf="@+id/ib_seat_driver_massage_waist"
                style="@style/vehicle_setting_massage_button_text"/>
            <ImageButton
                android:id="@+id/ib_seat_driver_massage_stretch"
                android:background="@drawable/massage_stretch_selector"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:layout_marginTop="@dimen/dp_20"
                android:layout_marginStart="@dimen/dp_44"
                app:layout_constraintStart_toEndOf="@+id/ib_seat_driver_massage_waist"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:id="@+id/tv_seat_driver_massage_stretch"
                android:text="@string/vehiclesettings_carseat_massage_stretch"
                app:layout_constraintEnd_toEndOf="@+id/ib_seat_driver_massage_stretch"
                app:layout_constraintStart_toStartOf="@+id/ib_seat_driver_massage_stretch"
                app:layout_constraintTop_toBottomOf="@+id/ib_seat_driver_massage_stretch"
                style="@style/vehicle_setting_massage_button_text"/>
            <ImageButton
                android:id="@+id/ib_seat_driver_massage_pluse"
                android:background="@drawable/massage_pluse_selector"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:layout_marginTop="@dimen/dp_119"
                android:layout_marginStart="@dimen/dp_34"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:id="@+id/tv_seat_driver_massage_pluse"
                android:text="@string/vehiclesettings_carseat_massage_pluse"
                app:layout_constraintEnd_toEndOf="@+id/ib_seat_driver_massage_pluse"
                app:layout_constraintStart_toStartOf="@+id/ib_seat_driver_massage_pluse"
                app:layout_constraintTop_toBottomOf="@+id/ib_seat_driver_massage_pluse"
                style="@style/vehicle_setting_massage_button_text"/>
            <ImageButton
                android:id="@+id/ib_seat_driver_massage_wave"
                android:background="@drawable/massage_wave_selector"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:layout_marginTop="@dimen/dp_119"
                android:layout_marginStart="@dimen/dp_44"
                app:layout_constraintStart_toEndOf="@+id/ib_seat_driver_massage_pluse"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:id="@+id/tv_seat_driver_massage_wave"
                android:text="@string/vehiclesettings_carseat_massage_wave"
                app:layout_constraintEnd_toEndOf="@+id/ib_seat_driver_massage_wave"
                app:layout_constraintStart_toStartOf="@+id/ib_seat_driver_massage_wave"
                app:layout_constraintTop_toBottomOf="@+id/ib_seat_driver_massage_wave"
                style="@style/vehicle_setting_massage_button_text"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <RelativeLayout
            android:id="@+id/massage_mode_left_low"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@style/vehicle_setting_dialog_background_container_low">
            <CheckBox
                android:textSize="@dimen/sp_18"
                android:textColor="@color/btn_selected_selector"
                android:id="@+id/ib_seat_driver_massage_low_toggle_left"
                android:background="@drawable/btn_massage_toggle_background"
                android:layout_width="@dimen/dp_128"
                android:layout_height="@dimen/dp_48"
                android:button="@null"
                android:minHeight="@dimen/dp_40"
                android:text="OFF"
                android:layout_centerInParent="true"
                android:layout_centerVertical="true"
                android:textAlignment="center"/>
        </RelativeLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="@color/carseat_dialog_textcolor"
        android:id="@+id/start_seat_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_26"
        android:maxWidth="@dimen/dp_300"
        android:text="@string/vehiclesettings_carseat_massage_main_seat"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="@+id/cl_driver_massage_style_container"
        app:layout_constraintStart_toStartOf="@+id/cl_driver_massage_style_container"
        app:layout_constraintTop_toBottomOf="@+id/cl_driver_massage_style_container"/>
    <RelativeLayout
        android:id="@+id/massage_container_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/byd_vehicle_massage_seat_image_top"
        app:layout_constraintStart_toEndOf="@+id/cl_seat_copilot_massage"
        app:layout_constraintTop_toTopOf="parent">
        <CheckBox
            android:textSize="@dimen/sp_14"
            android:textColor="@color/btn_selected_selector"
            android:id="@+id/ib_seat_copilot_massage_toggle_right"
            android:background="@drawable/btn_massage_toggle_background"
            android:layout_width="@dimen/dp_67"
            android:layout_height="wrap_content"
            android:button="@null"
            android:minHeight="@dimen/dp_40"
            android:text="OFF"
            android:layout_centerVertical="true"
            android:textAlignment="center"
            android:layout_marginEnd="@dimen/dp_20"/>
        <com.byd.base.view.segmentedbutton.SegmentedButtonGroup
            android:id="@+id/sbg_seat_copilot_massage"
            android:layout_width="@dimen/dp_213"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/dp_40"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp_50"
            android:layout_toEndOf="@+id/ib_seat_copilot_massage_toggle_right"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:sbg_firstSelectorColor="@color/first_segment_button_bg"
            app:sbg_position="0"
            app:sbg_radius="@dimen/dp_30"
            app:sbg_rippleColor="@android:color/transparent"
            style="@style/vehicle_setting_base_seg_style">
            <com.byd.base.view.segmentedbutton.SegmentedButton
                android:layout_width="@dimen/dp_0"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:sb_text="@string/vehiclesettings_control_reminder_touch_weak"
                app:sb_textSize="@dimen/sp_14"
                style="@style/vehicle_setting_base_seg_btn_common_style"/>
            <com.byd.base.view.segmentedbutton.SegmentedButton
                android:layout_width="@dimen/dp_0"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:sb_text="@string/vehiclesettings_control_reminder_touch_middle"
                app:sb_textSize="@dimen/sp_14"
                style="@style/vehicle_setting_base_seg_btn_common_style"/>
            <com.byd.base.view.segmentedbutton.SegmentedButton
                android:layout_width="@dimen/dp_0"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:sb_text="@string/vehiclesettings_control_touch_strong"
                app:sb_textSize="@dimen/sp_14"
                style="@style/vehicle_setting_base_seg_btn_common_style"/>
        </com.byd.base.view.segmentedbutton.SegmentedButtonGroup>
    </RelativeLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_copilot_massage_style_container"
        android:background="@drawable/shape_seat_massage_bg"
        android:layout_width="@dimen/dp_300"
        android:layout_height="@dimen/dp_217"
        android:layout_marginTop="@dimen/dp_24"
        app:layout_constraintStart_toStartOf="@+id/massage_container_right"
        app:layout_constraintTop_toBottomOf="@+id/massage_container_right">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/massage_mode_right"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageButton
                android:id="@+id/ib_seat_copilot_massage_shoulder"
                android:background="@drawable/massage_shoulder_selector"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:layout_marginTop="@dimen/dp_20"
                android:layout_marginStart="@dimen/dp_34"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:id="@+id/tv_seat_copilot_massage_shoulder"
                android:text="@string/vehiclesettings_seat_massage_mode_relieve"
                app:layout_constraintEnd_toEndOf="@+id/ib_seat_copilot_massage_shoulder"
                app:layout_constraintStart_toStartOf="@+id/ib_seat_copilot_massage_shoulder"
                app:layout_constraintTop_toBottomOf="@+id/ib_seat_copilot_massage_shoulder"
                style="@style/vehicle_setting_massage_button_text"/>
            <ImageButton
                android:id="@+id/ib_seat_copilot_massage_waist"
                android:background="@drawable/massage_waist_selector"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:layout_marginTop="@dimen/dp_20"
                android:layout_marginStart="@dimen/dp_44"
                app:layout_constraintStart_toEndOf="@+id/ib_seat_copilot_massage_shoulder"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:id="@+id/tv_seat_copilot_massage_waist"
                android:text="@string/vehiclesettings_seat_massage_mode_slack"
                app:layout_constraintEnd_toEndOf="@+id/ib_seat_copilot_massage_waist"
                app:layout_constraintStart_toStartOf="@+id/ib_seat_copilot_massage_waist"
                app:layout_constraintTop_toBottomOf="@+id/ib_seat_copilot_massage_waist"
                style="@style/vehicle_setting_massage_button_text"/>
            <ImageButton
                android:id="@+id/ib_seat_copilot_massage_stretch"
                android:background="@drawable/massage_stretch_selector"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:layout_marginTop="@dimen/dp_20"
                android:layout_marginStart="@dimen/dp_44"
                app:layout_constraintStart_toEndOf="@+id/ib_seat_copilot_massage_waist"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:id="@+id/tv_seat_copilot_massage_stretch"
                android:text="@string/vehiclesettings_carseat_massage_stretch"
                app:layout_constraintEnd_toEndOf="@+id/ib_seat_copilot_massage_stretch"
                app:layout_constraintStart_toStartOf="@+id/ib_seat_copilot_massage_stretch"
                app:layout_constraintTop_toBottomOf="@+id/ib_seat_copilot_massage_stretch"
                style="@style/vehicle_setting_massage_button_text"/>
            <ImageButton
                android:id="@+id/ib_seat_copilot_massage_pluse"
                android:background="@drawable/massage_pluse_selector"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:layout_marginTop="@dimen/dp_119"
                android:layout_marginStart="@dimen/dp_34"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:id="@+id/tv_seat_copilot_massage_pluse"
                android:text="@string/vehiclesettings_carseat_massage_pluse"
                app:layout_constraintEnd_toEndOf="@+id/ib_seat_copilot_massage_pluse"
                app:layout_constraintStart_toStartOf="@+id/ib_seat_copilot_massage_pluse"
                app:layout_constraintTop_toBottomOf="@+id/ib_seat_copilot_massage_pluse"
                style="@style/vehicle_setting_massage_button_text"/>
            <ImageButton
                android:id="@+id/ib_seat_copilot_massage_wave"
                android:background="@drawable/massage_wave_selector"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:layout_marginTop="@dimen/dp_119"
                android:layout_marginStart="@dimen/dp_44"
                app:layout_constraintStart_toEndOf="@+id/ib_seat_copilot_massage_pluse"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:id="@+id/tv_seat_copilot_massage_wave"
                android:text="@string/vehiclesettings_carseat_massage_wave"
                app:layout_constraintEnd_toEndOf="@+id/ib_seat_copilot_massage_wave"
                app:layout_constraintStart_toStartOf="@+id/ib_seat_copilot_massage_wave"
                app:layout_constraintTop_toBottomOf="@+id/ib_seat_copilot_massage_wave"
                style="@style/vehicle_setting_massage_button_text"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <RelativeLayout
            android:id="@+id/massage_mode_right_low"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@style/vehicle_setting_dialog_background_container_low">
            <CheckBox
                android:textSize="@dimen/sp_18"
                android:textColor="@color/btn_selected_selector"
                android:id="@+id/ib_seat_copilot_massage_low_toggle_right"
                android:background="@drawable/btn_massage_toggle_background"
                android:layout_width="@dimen/dp_128"
                android:layout_height="@dimen/dp_48"
                android:button="@null"
                android:minHeight="@dimen/dp_40"
                android:text="OFF"
                android:layout_centerInParent="true"
                android:textAlignment="center"/>
        </RelativeLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="@color/carseat_dialog_textcolor"
        android:id="@+id/end_seat_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_26"
        android:maxWidth="@dimen/dp_300"
        android:text="@string/vehiclesettings_carseat_massage_passager_seat"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="@+id/cl_copilot_massage_style_container"
        app:layout_constraintStart_toStartOf="@+id/cl_copilot_massage_style_container"
        app:layout_constraintTop_toBottomOf="@+id/cl_copilot_massage_style_container"/>
    <RelativeLayout
        android:id="@+id/massage_tips_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/carseat_massage_tips_imge"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:src="@drawable/icon_public_details_48"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"/>
        <com.byd.base.view.BydFlexTextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/instrument_speed_remind_unitTextColor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vehiclesettings_carseat_massage_key_tips_title"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/carseat_massage_tips_imge"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
