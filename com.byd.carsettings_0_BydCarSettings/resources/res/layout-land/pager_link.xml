<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/link_parent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bydux.api.common.views.window.DampingScrollView
        android:orientation="vertical"
        android:id="@+id/scv_link_pager"
        android:scrollbars="none"
        android:fadingEdge="vertical"
        android:fadingEdgeLength="@dimen/dp_24"
        android:layout_width="@dimen/dp_468"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dp_6"
        android:requiresFadingEdge="vertical">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_frame_gray_a"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16">
                <com.byd.carsettings.ui.widget.LinearItemTextRightSupportRtl
                    android:id="@+id/item_bt_link"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_88"
                    app:textLeft="@string/bluetooth_link"
                    app:textRight="@string/state_close_link"/>
                <com.byd.carsettings.ui.widget.LinearItemTextRightSupportRtl
                    android:id="@+id/item_wireless_net_link"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_88"
                    app:textLeft="@string/wireless_net_link"
                    app:textRight="@string/state_close_link"/>
                <com.byd.carsettings.ui.widget.EndMatchLinearItem
                    android:id="@+id/item_hotspot_link"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_88"
                    app:textLeft="@string/hotspot_link"
                    app:textRight="@string/state_close_link"/>
                <com.byd.carsettings.ui.widget.EndMatchLinearItem
                    android:id="@+id/item_carplay_link"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_88"
                    app:textLeft="@string/carplay_link"/>
                <com.byd.carsettings.ui.widget.LinearItem
                    android:id="@+id/item_remote_control"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_88"
                    app:textLeft="@string/remote_control"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_mobile_data_link"
                android:background="@drawable/bg_frame_gray_a"
                android:layout_width="@dimen/dp_468"
                android:layout_height="@dimen/dp_88"
                android:layout_marginTop="@dimen/dp_16"
                android:paddingStart="@dimen/dp_24"
                android:paddingEnd="@dimen/dp_24">
                <com.byd.base.view.BydSwitch
                    android:id="@+id/switch_mobile_data_link"
                    android:layout_marginEnd="@dimen/dp_16"
                    style="@style/byd_switch"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/ll_title_mobile_data_link"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="@dimen/sp_20"
                        android:textColor="@color/text_color_item_left_dilink_link"
                        android:id="@+id/tv_title_mobile_data_link"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mobile_data_link"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.bydux.api.common.views.window.DampingScrollView>
    <LinearLayout
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <ImageView
            android:id="@+id/iv_link"
            android:layout_width="@dimen/dp_556"
            android:layout_height="@dimen/dp_468"/>
    </LinearLayout>
</LinearLayout>
