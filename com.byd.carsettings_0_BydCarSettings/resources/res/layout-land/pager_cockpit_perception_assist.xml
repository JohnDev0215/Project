<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bydux.api.common.views.window.DampingScrollView
        android:id="@+id/nsw"
        style="@style/vehicle_setting_module_damping_scrollView_land_style">
        <LinearLayout style="@style/vehicle_setting_module_damping_scrollView_child_land_style">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/dms_out_container"
                android:visibility="visible"
                style="@style/vehicle_setting_background_with_param_container">
                <RelativeLayout
                    android:id="@+id/dms_container"
                    android:visibility="visible"
                    style="@style/vehicle_setting_tv_sw_icon_container_un_single_style">
                    <ImageView
                        android:id="@+id/driver_detection_sys_img"
                        android:layout_toEndOf="@+id/driver_detection_sys_tv"
                        style="@style/vehicle_setting_tv_sw_icon_icon_style"/>
                    <com.byd.base.view.BydFlexTextView
                        android:id="@+id/driver_detection_sys_tv"
                        android:text="@string/vehiclesettings_cockpitper_driver_monitor_assist"
                        android:layout_toEndOf="@+id/cockpit_perception_driver_detection_sys_sw"
                        style="@style/vehicle_setting_tv_sw_icon_tv_land_style"/>
                    <com.byd.base.view.BydSwitch
                        android:id="@+id/cockpit_perception_driver_detection_sys_sw"
                        style="@style/vehicle_setting_tv_sw_icon_sw_style"/>
                </RelativeLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/cockpit_set_container"
                    android:visibility="visible"
                    android:layout_marginStart="@dimen/dp_24"
                    style="@style/vehicle_setting_un_background_container">
                    <View
                        android:background="@color/cockpit_line_color"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_1"
                        android:layout_marginStart="@dimen/dp_24"
                        android:layout_marginEnd="@dimen/dp_24"/>
                    <RelativeLayout
                        android:visibility="visible"
                        style="@style/vehicle_setting_tv_sw_icon_container_un_single_style">
                        <ImageView
                            android:id="@+id/driver_tired_tips_img"
                            android:layout_toEndOf="@+id/driver_tired_tips_tv"
                            style="@style/vehicle_setting_tv_sw_icon_icon_style"/>
                        <com.byd.base.view.BydFlexTextView
                            android:id="@+id/driver_tired_tips_tv"
                            android:maxWidth="@dimen/dp_284"
                            android:text="@string/vehiclesettings_cockpitper_driver_tired_reminder"
                            android:layout_toEndOf="@+id/cockpit_perception_driver_tired_tips_sw"
                            style="@style/vehicle_setting_tv_sw_icon_tv_land_style"/>
                        <com.byd.base.view.BydSwitch
                            android:id="@+id/cockpit_perception_driver_tired_tips_sw"
                            style="@style/vehicle_setting_tv_sw_icon_sw_style"/>
                    </RelativeLayout>
                    <RelativeLayout
                        android:visibility="visible"
                        style="@style/vehicle_setting_tv_sw_icon_container_un_single_style">
                        <ImageView
                            android:id="@+id/driver_distraction_monitor_img"
                            android:layout_toEndOf="@+id/driver_distraction_monitor_tv"
                            style="@style/vehicle_setting_tv_sw_icon_icon_style"/>
                        <com.byd.base.view.BydFlexTextView
                            android:id="@+id/driver_distraction_monitor_tv"
                            android:maxWidth="@dimen/dp_284"
                            android:text="@string/vehiclesettings_cockpitper_driver_distraction_monitor_reminder"
                            android:layout_toEndOf="@+id/cockpit_perception_distraction_monitor_sw"
                            style="@style/vehicle_setting_tv_sw_icon_tv_land_style"/>
                        <com.byd.base.view.BydSwitch
                            android:id="@+id/cockpit_perception_distraction_monitor_sw"
                            style="@style/vehicle_setting_tv_sw_icon_sw_style"/>
                    </RelativeLayout>
                </LinearLayout>
            </LinearLayout>
            <RelativeLayout
                android:id="@+id/cl_cpd"
                android:layout_marginBottom="@dimen/dp_16"
                style="@style/vehicle_setting_background_container">
                <RelativeLayout
                    android:id="@+id/cpd_btn_switch_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/dp_88">
                    <ImageView
                        android:id="@+id/iv_cpd_notice"
                        android:layout_toEndOf="@+id/tv_cpd"
                        style="@style/vehicle_setting_tv_sw_icon_icon_style"/>
                    <com.byd.base.view.BydFlexTextView
                        android:id="@+id/tv_cpd"
                        android:text="@string/vehiclesettings_legacy_detection_in_children"
                        android:layout_toEndOf="@+id/cpd_btn_switch"
                        style="@style/vehicle_setting_tv_sw_icon_tv_land_style"/>
                    <com.byd.base.view.BydSwitch
                        android:id="@+id/cpd_btn_switch"
                        style="@style/vehicle_setting_tv_sw_icon_sw_style"/>
                </RelativeLayout>
                <com.byd.base.view.segmentedbutton.SegmentedButtonGroup
                    android:id="@+id/sbg_cpd"
                    android:layout_marginTop="@dimen/dp_0"
                    android:layout_marginBottom="@dimen/dp_26"
                    android:layout_below="@+id/cpd_btn_switch_container"
                    style="@style/vehicle_setting_tv_seg_seg_style">
                    <com.byd.base.view.segmentedbutton.SegmentedButton
                        android:id="@+id/trb_cpd_open"
                        app:sb_text="@string/vehiclesettings_standard"
                        style="@style/vehicle_setting_tv_seg_seg_btn_style"/>
                    <com.byd.base.view.segmentedbutton.SegmentedButton
                        android:id="@+id/trb_cpd_delay"
                        app:sb_text="@string/vehiclesettings_legacy_detection_for_children_delay"
                        style="@style/vehicle_setting_tv_seg_seg_btn_style"/>
                </com.byd.base.view.segmentedbutton.SegmentedButtonGroup>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/cockpit_mobile_monitoring_system"
                style="@style/vehicle_setting_tv_sw_icon_container_style">
                <com.byd.base.view.BydFlexTextView
                    android:id="@+id/cockpit_mobile_monitoring_system_tv"
                    android:text="@string/vehiclesettings_legacy_detection_system_interior_motion_sensor"
                    android:layout_toEndOf="@+id/cockpit_mobile_monitoring_system_sw"
                    style="@style/vehicle_setting_tv_sw_icon_tv_land_style"/>
                <com.byd.base.view.BydSwitch
                    android:id="@+id/cockpit_mobile_monitoring_system_sw"
                    style="@style/vehicle_setting_tv_sw_icon_sw_style"/>
                <ImageView
                    android:id="@+id/cockpit_mobile_monitoring_system_icon"
                    android:layout_toEndOf="@+id/cockpit_mobile_monitoring_system_tv"
                    style="@style/vehicle_setting_tv_sw_icon_icon_style"/>
            </RelativeLayout>
        </LinearLayout>
    </com.bydux.api.common.views.window.DampingScrollView>
    <ImageView
        android:id="@+id/cockpit_image"
        style="@style/vehicle_setting_car_image_land_style"/>
</LinearLayout>
