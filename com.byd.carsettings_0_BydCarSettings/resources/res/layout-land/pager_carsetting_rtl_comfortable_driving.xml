<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">
    <com.bydux.api.common.views.window.DampingScrollView
        android:id="@+id/nsw"
        style="@style/vehicle_setting_rtl_module_damping_scrollView_land_style">
        <LinearLayout style="@style/vehicle_setting_rtl_module_damping_scrollView_child_land_style">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/comfortable_driving_safetybelt_rain_container"
                android:visibility="gone"
                style="@style/vehicle_setting_background_with_param_container">
                <RelativeLayout
                    android:id="@+id/comfortable_driving_safetybelt_container"
                    style="@style/vehicle_setting_rtl_tv_sw_icon_container_un_single_style">
                    <TextView
                        android:text="@string/vehiclesettings_pretightened_seat_belt"
                        android:layout_toEndOf="@+id/comfortable_driving_safetybelt"
                        style="@style/vehicle_setting_rtl_tv_sw_icon_tv_land_style"/>
                    <com.byd.base.view.BydSwitch
                        android:id="@+id/comfortable_driving_safetybelt"
                        style="@style/vehicle_setting_rtl_tv_sw_icon_sw_style"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/comfortable_driving_windshieldwiper_contianer"
                    style="@style/vehicle_setting_rtl_tv_sw_icon_container_un_single_style">
                    <TextView
                        android:text="@string/vehiclesettings_automatic_wiper"
                        android:layout_toEndOf="@+id/comfortable_driving_windshieldwiper"
                        style="@style/vehicle_setting_rtl_tv_sw_icon_tv_land_style"/>
                    <com.byd.base.view.BydSwitch
                        android:id="@+id/comfortable_driving_windshieldwiper"
                        style="@style/vehicle_setting_rtl_tv_sw_icon_sw_style"/>
                </RelativeLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/comfortable_wading_protect_outside_container"
                style="@style/vehicle_setting_background_with_param_container">
                <RelativeLayout
                    android:id="@+id/comfortable_wading_protect_container"
                    style="@style/vehicle_setting_rtl_tv_sw_icon_container_un_single_style">
                    <com.byd.base.view.BydFlexTextView
                        android:id="@+id/comfortable_wading_protect_tv"
                        android:text="@string/vehiclesettings_comfortable_wading_protection"
                        style="@style/vehicle_setting_rtl_tv_sw_icon_tv_land_style"/>
                    <com.byd.base.view.BydSwitch
                        android:id="@+id/comfortable_wading_protect_sw"
                        style="@style/vehicle_setting_rtl_tv_sw_icon_sw_style"/>
                    <ImageView
                        android:id="@+id/comfortable_wading_protect_icon"
                        android:layout_toStartOf="@+id/comfortable_wading_protect_tv"
                        style="@style/vehicle_setting_rtl_tv_sw_icon_icon_style"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/comfortable_sand_abs_mode_container"
                    style="@style/vehicle_setting_rtl_tv_sw_icon_container_un_single_style">
                    <com.byd.base.view.BydFlexTextView
                        android:id="@+id/comfortable_sand_abs_mode_tv"
                        android:text="@string/vehiclesettings_comfortable_sand_abs_mode"
                        style="@style/vehicle_setting_rtl_tv_sw_icon_tv_land_style"/>
                    <com.byd.base.view.BydSwitch
                        android:id="@+id/comfortable_sand_abs_mode_sw"
                        style="@style/vehicle_setting_rtl_tv_sw_icon_sw_style"/>
                    <ImageView
                        android:id="@+id/comfortable_sand_abs_mode_icon"
                        android:layout_toStartOf="@+id/comfortable_sand_abs_mode_tv"
                        style="@style/vehicle_setting_rtl_tv_sw_icon_icon_style"/>
                </RelativeLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/comfortable_driving_seat_rain_container"
                android:visibility="gone"
                style="@style/vehicle_setting_background_with_param_container">
                <RelativeLayout
                    android:id="@+id/comfortable_driving_seat_container"
                    style="@style/vehicle_setting_rtl_tv_sw_icon_container_un_single_style">
                    <com.byd.base.view.BydSwitch
                        android:id="@+id/comfortable_driving_seat"
                        style="@style/vehicle_setting_rtl_tv_sw_icon_sw_style"/>
                    <TextView
                        android:text="@string/vehiclesettings_seat_welcome"
                        android:layout_toEndOf="@+id/comfortable_driving_seat"
                        style="@style/vehicle_setting_rtl_tv_sw_icon_tv_land_style"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/comfortable_passenger_seat_container"
                    style="@style/vehicle_setting_rtl_tv_sw_icon_container_un_single_style">
                    <com.byd.base.view.BydSwitch
                        android:id="@+id/comfortable_passenger_seat_sw"
                        style="@style/vehicle_setting_rtl_tv_sw_icon_sw_style"/>
                    <TextView
                        android:text="@string/vehiclesettings_passenger_seat_welcome"
                        android:layout_toEndOf="@+id/comfortable_passenger_seat_sw"
                        style="@style/vehicle_setting_rtl_tv_sw_icon_tv_land_style"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/comfortable_driving_steeringwheel_container"
                    style="@style/vehicle_setting_rtl_tv_sw_icon_container_un_single_style">
                    <com.byd.base.view.BydSwitch
                        android:id="@+id/comfortable_driving_steeringwheel"
                        style="@style/vehicle_setting_rtl_tv_sw_icon_sw_style"/>
                    <TextView
                        android:text="@string/vehiclesettings_steering_wheel_welcome"
                        android:layout_toEndOf="@+id/comfortable_driving_steeringwheel"
                        style="@style/vehicle_setting_rtl_tv_sw_icon_tv_land_style"/>
                </RelativeLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/comfortable_driving_mirrorset_mirrorfold"
                android:visibility="gone"
                style="@style/vehicle_setting_background_with_param_container">
                <RelativeLayout
                    android:id="@+id/comfortable_driving_mirrorfold_container"
                    style="@style/vehicle_setting_rtl_tv_sw_icon_container_un_single_style">
                    <com.byd.base.view.BydSwitch
                        android:id="@+id/comfortable_driving_mirrorfold"
                        style="@style/vehicle_setting_rtl_tv_sw_icon_sw_style"/>
                    <TextView
                        android:text="@string/vehiclesettings_automatic_folding"
                        android:layout_toEndOf="@+id/comfortable_driving_mirrorfold"
                        style="@style/vehicle_setting_rtl_tv_sw_icon_tv_land_style"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/comfortable_driving_mirrorturn_container"
                    style="@style/vehicle_setting_rtl_tv_sw_icon_container_un_single_style">
                    <com.byd.base.view.BydSwitch
                        android:id="@+id/comfortable_driving_mirrorturn"
                        style="@style/vehicle_setting_rtl_tv_sw_icon_sw_style"/>
                    <TextView
                        android:text="@string/vehiclesettings_reverse_flip"
                        android:layout_toEndOf="@+id/comfortable_driving_mirrorturn"
                        style="@style/vehicle_setting_rtl_tv_sw_icon_tv_land_style"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/comfortable_driving_mirrorset_container"
                    android:layout_marginBottom="@dimen/dp_18"
                    style="@style/vehicle_setting_rtl_tv_seg_container_un_single_style">
                    <TextView
                        android:id="@+id/door_tv"
                        android:text="@string/vehiclesettings_reverse_flip"
                        style="@style/vehicle_setting_rtl_tv_seg_tv_style"/>
                    <com.byd.base.view.segmentedbutton.SegmentedButtonGroup
                        android:id="@+id/comfortable_driving_mirrorset"
                        android:layout_below="@+id/door_tv"
                        style="@style/vehicle_setting_rtl_tv_seg_seg_style">
                        <com.byd.base.view.segmentedbutton.SegmentedButton
                            app:sb_text="@string/vehiclesettings_close"
                            style="@style/vehicle_setting_rtl_tv_seg_seg_btn_style"/>
                        <com.byd.base.view.segmentedbutton.SegmentedButton
                            app:sb_text="@string/vehiclesettings_memory_angle"
                            style="@style/vehicle_setting_rtl_tv_seg_seg_btn_style"/>
                        <com.byd.base.view.segmentedbutton.SegmentedButton
                            app:sb_text="@string/vehiclesettings_fixed_angle"
                            style="@style/vehicle_setting_rtl_tv_seg_seg_btn_style"/>
                    </com.byd.base.view.segmentedbutton.SegmentedButtonGroup>
                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>
    </com.bydux.api.common.views.window.DampingScrollView>
    <RelativeLayout
        android:id="@+id/comfortable_driving_image_container"
        style="@style/vehicle_setting_rtl_car_image_land_style">
        <ImageView
            android:id="@+id/comfortable_driving_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/comfortable_wading_protect_image_title_tv_color"
            android:id="@+id/comfortable_driving_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_388"
            android:layout_centerHorizontal="true"
            android:textAlignment="center"
            android:layout_marginStart="@dimen/dp_28"
            android:layout_marginEnd="@dimen/dp_28"/>
    </RelativeLayout>
</LinearLayout>
