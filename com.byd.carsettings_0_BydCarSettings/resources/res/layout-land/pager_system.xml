<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/system_parent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="@dimen/dp_468"
        android:layout_height="match_parent">
        <com.bydux.api.common.views.window.DampingScrollView
            android:orientation="vertical"
            android:id="@+id/scv_system_pager"
            android:scrollbars="none"
            android:fadingEdge="vertical"
            android:fadingEdgeLength="@dimen/dp_24"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_6"
            android:requiresFadingEdge="vertical">
            <include layout="@layout/subview_pager_system"/>
        </com.bydux.api.common.views.window.DampingScrollView>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <ImageView
            android:id="@+id/iv_system_pager"
            android:layout_width="@dimen/dp_556"
            android:layout_height="@dimen/dp_468"
            android:src="@drawable/img_empty_system"/>
    </LinearLayout>
</LinearLayout>
