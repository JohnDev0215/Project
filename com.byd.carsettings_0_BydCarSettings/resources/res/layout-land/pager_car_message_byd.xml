<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_oil_result"
        android:layout_width="@dimen/dp_556"
        android:layout_height="@dimen/dp_468"
        android:layout_marginTop="@dimen/dp_34"
        android:layout_marginRight="@dimen/dp_4"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_22"
        android:layout_weight="1">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_battery_health"
            android:background="@drawable/carlights_background"
            android:paddingTop="@dimen/dp_20"
            android:paddingBottom="@dimen/dp_20"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_16"
            android:minHeight="@dimen/dp_88"
            android:paddingStart="@dimen/dp_24"
            android:paddingEnd="@dimen/dp_24">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="?attr/text_color_main"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/carhealthy_battery_health"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/dp_16"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="?attr/dialog_text_color_tips"
                android:id="@+id/tv_battery_health"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/carlights_background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_16">
            <LinearLayout
                android:gravity="start|center_vertical"
                android:orientation="horizontal"
                android:paddingTop="@dimen/dp_20"
                android:paddingBottom="@dimen/dp_4"
                android:layout_width="@dimen/dp_468"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/dp_20"
                android:paddingEnd="@dimen/dp_20">
                <ImageView
                    android:id="@+id/iv_dtc_result"
                    android:layout_width="@dimen/dp_48"
                    android:layout_height="@dimen/dp_48"/>
                <TextView
                    android:textSize="@dimen/sp_20"
                    android:gravity="start|center_vertical"
                    android:id="@+id/tv_dtc_result"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/dp_8"/>
            </LinearLayout>
            <com.byd.carsettings.ui.widget.DampingRecyclerView
                android:paddingTop="@dimen/dp_4"
                android:paddingBottom="@dimen/dp_12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.recyclerview.widget.RecyclerView
                    android:scrollbarSize="@dimen/dp_4"
                    android:scrollbarThumbVertical="@drawable/bar_thumb"
                    android:scrollbarTrackVertical="@drawable/bar_track"
                    android:id="@+id/recyclerview"
                    android:scrollbars="vertical"
                    android:fadingEdge="vertical"
                    android:fadingEdgeLength="@dimen/dp_24"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:requiresFadingEdge="vertical"
                    android:paddingEnd="@dimen/dp_9"/>
            </com.byd.carsettings.ui.widget.DampingRecyclerView>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
