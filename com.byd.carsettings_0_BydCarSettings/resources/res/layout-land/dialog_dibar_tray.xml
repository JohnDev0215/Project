<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:layout_width="@dimen/dp_560"
    android:layout_height="@dimen/dp_420"
    android:layout_marginStart="@dimen/dp_360"
    android:layout_marginEnd="@dimen/dp_360"
    style="@style/vehicle_setting_dialog_background_container">
    <ImageView
        android:id="@+id/dibar_dialog_tray_iv"
        android:background="@drawable/dibar_dialog_tray_img"
        android:layout_width="@dimen/dp_325"
        android:layout_height="@dimen/dp_174"
        android:layout_marginTop="@dimen/dp_62"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="@color/carsetting_text_color_white"
        android:gravity="center"
        android:layout_width="@dimen/dp_364"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:text="@string/vehiclesettings_diba_trap_hint"
        android:layout_below="@+id/dibar_dialog_tray_iv"
        android:layout_centerHorizontal="true"
        android:textDirection="locale"/>
    <Button
        android:textSize="@dimen/sp_18"
        android:textColor="@color/byd_vehicle_dialog_btn_confirm_text_color"
        android:id="@+id/dibar_tray_btn_confirm"
        android:background="@drawable/selector_dialog_blue"
        android:layout_width="@dimen/dp_176"
        android:layout_height="@dimen/dp_48"
        android:layout_marginBottom="@dimen/dp_28"
        android:text="@string/vehiclesettings_button_confirm"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:textAllCaps="false"
        android:textDirection="locale"/>
</RelativeLayout>
