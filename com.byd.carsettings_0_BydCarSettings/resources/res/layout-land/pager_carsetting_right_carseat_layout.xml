<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/carseat_image"
        style="@style/vehicle_setting_right_car_image_land_style"/>
    <com.bydux.api.common.views.window.DampingScrollView
        android:id="@+id/nsw"
        style="@style/vehicle_setting_right_module_damping_scrollView_land_style">
        <LinearLayout style="@style/vehicle_setting_right_module_damping_scrollView_child_land_style">
            <RelativeLayout
                android:id="@+id/carseat_main_driving_container"
                style="@style/vehicle_setting_right_tv_arrow_container_style">
                <ImageView
                    android:id="@+id/carseat_main_driving_iv"
                    style="@style/vehicle_setting_right_tv_arrow_arrow_style"/>
                <TextView
                    android:text="@string/vehiclesettings_seat_turn_titile"
                    android:layout_toStartOf="@+id/carseat_main_driving_iv"
                    style="@style/vehicle_setting_right_tv_arrow_tv_style"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/carseat_wind_warm_container"
                style="@style/vehicle_setting_right_tv_arrow_container_style">
                <TextView
                    android:id="@+id/carseat_wind_warm_tv"
                    android:text="@string/vehiclesettings_carseat_seat_wind_hot"
                    android:layout_toStartOf="@+id/carseat_wind_warm_iv"
                    style="@style/vehicle_setting_right_tv_arrow_tv_style"/>
                <ImageView
                    android:id="@+id/carseat_wind_warm_iv"
                    style="@style/vehicle_setting_right_tv_arrow_arrow_style"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/carseat_front_massage_container"
                style="@style/vehicle_setting_right_tv_arrow_container_style">
                <TextView
                    android:text="@string/vehiclesettings_carseat_massage_seat_massage"
                    android:layout_toStartOf="@+id/carseat_front_massage_iv"
                    style="@style/vehicle_setting_right_tv_arrow_tv_style"/>
                <ImageView
                    android:id="@+id/carseat_front_massage_iv"
                    style="@style/vehicle_setting_right_tv_arrow_arrow_style"/>
            </RelativeLayout>
        </LinearLayout>
    </com.bydux.api.common.views.window.DampingScrollView>
</LinearLayout>
