<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="?attr/text_color_main"
        android:gravity="center"
        android:layout_width="@dimen/dp_216"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_155"
        android:text="@string/newenergy_discharge_mps_discharge_car_title"
        android:layout_marginStart="@dimen/dp_550"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="?attr/text_color_main"
        android:gravity="center"
        android:layout_width="@dimen/dp_200"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_155"
        android:text="@string/newenergy_discharge_mps_charge_car_title"
        android:layout_marginEnd="@dimen/dp_170"
        android:layout_alignParentEnd="true"/>
    <ProgressBar
        android:id="@+id/progressbar_own_car"
        android:layout_width="@dimen/dp_136"
        android:layout_height="@dimen/dp_20"
        android:layout_marginTop="@dimen/dp_320"
        android:max="100"
        android:progressDrawable="@drawable/progress_background_discharge"
        android:layout_marginStart="@dimen/dp_592"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="?attr/text_color_main"
        android:gravity="center"
        android:id="@+id/tv_progress_own_car"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_318"
        android:layout_alignBaseline="@+id/progressbar_own_car"
        android:layout_marginStart="@dimen/dp_6"
        android:layout_toEndOf="@+id/progressbar_own_car"/>
    <ProgressBar
        android:id="@+id/progressbar_charge_car"
        android:layout_width="@dimen/dp_136"
        android:layout_height="@dimen/dp_20"
        android:layout_marginTop="@dimen/dp_320"
        android:max="100"
        android:progressDrawable="@drawable/progress_background_discharge"
        android:layout_marginStart="@dimen/dp_944"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="?attr/text_color_main"
        android:gravity="center"
        android:id="@+id/tv_progress_charge_car"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_318"
        android:layout_marginStart="@dimen/dp_6"
        android:layout_toEndOf="@+id/progressbar_charge_car"/>
</RelativeLayout>
