<?xml version="1.0" encoding="utf-8"?>
<com.bydux.api.common.views.window.DampingScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/nested_scroll_view"
    android:tag="layout-land/fragment_park_assist_0"
    android:scrollbars="none"
    android:fadingEdge="vertical"
    android:fadingEdgeLength="@dimen/dp_24"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:requiresFadingEdge="vertical">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/out_container"
        android:paddingBottom="@dimen/dp_16"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingEnd="@dimen/dp_31">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/dynamic_container1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:layout_gravity="center"
                android:id="@+id/tv_park_assist_func_entrance"
                android:layout_marginTop="@dimen/dp_22"
                android:text="@string/dipilot_title_parking_entrance"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/adas_main_function_first_title_style"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rc_park_assist_func_entrance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:overScrollMode="never"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_park_assist_func_entrance"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/dynamic_container2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_22"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dynamic_container1"
            app:layout_goneMarginTop="@dimen/dp_22">
            <TextView
                android:layout_gravity="center"
                android:id="@+id/tv_park_assist_radar_monitor"
                android:text="@string/dipilot_parking_sensor_monitor"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/adas_main_function_first_title_style"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_park_assist_container"
                android:background="@drawable/bg_frame_gray_a"
                android:paddingTop="@dimen/dp_20"
                android:layout_height="@dimen/dp_192"
                android:layout_marginTop="@dimen/dp_12"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_park_assist_radar_monitor"
                style="@style/ll_switch_item_left_style_no_top">
                <TextView
                    android:textColor="?attr/dialog_text_color_main"
                    android:id="@+id/tv_assist_title"
                    android:text="@string/dipilot_title_parking_sensor"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/adas_title_style_right_rubble"/>
                <com.byd.base.view.BydSwitch
                    android:id="@+id/switch_recognition_intelligent_speed_control"
                    android:layout_marginTop="@dimen/dp_18"
                    android:layout_marginEnd="@dimen/dp_15"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_assist_title"
                    style="@style/adas_switch_style"/>
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/iv_assist"
                    android:layout_width="@dimen/dp_320"
                    android:layout_height="@dimen/dp_124"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_assist_title"
                    app:lottie_progress="1"
                    app:lottie_rawRes="@raw/dipilot_st_pdc"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.bydux.api.common.views.window.DampingScrollView>
