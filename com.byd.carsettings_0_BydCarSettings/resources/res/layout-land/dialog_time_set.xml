<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:layout_width="@dimen/dp_560"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:layout_width="@dimen/dp_560"
        android:layout_height="@dimen/dp_56"
        android:layout_marginTop="@dimen/dp_25"
        android:layout_marginStart="@dimen/dp_48"
        android:layout_marginEnd="@dimen/dp_48">
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/text_color_main"
            android:gravity="center"
            android:id="@+id/tv_h"
            android:layout_width="@dimen/dp_232"
            android:layout_height="match_parent"
            android:text="@string/newenergy_discharge_mps_hour"
            android:maxLines="1"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/text_color_main"
            android:gravity="center"
            android:id="@+id/tv_m"
            android:layout_width="@dimen/dp_232"
            android:layout_height="match_parent"
            android:text="@string/electricity_discharge_min"
            android:maxLines="1"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:layout_width="@dimen/dp_560"
        android:layout_height="@dimen/dp_192"
        android:layout_marginBottom="@dimen/dp_16"
        android:paddingStart="@dimen/dp_48"
        android:paddingEnd="@dimen/dp_48">
        <com.byd.carsettings.ui.widget.wheelview.WheelView
            android:id="@+id/wheelView_h"
            android:layout_width="@dimen/dp_232"
            android:layout_height="match_parent"
            app:itemNumber="3"
            app:lineColor="?attr/dialog_divider_common"
            app:lineHeight="@dimen/dp_1"
            app:noEmpty="true"
            app:normalTextColor="@color/text_color_main_gray"
            app:normalTextSize="@dimen/sp_24"
            app:selectedTextColor="@color/text_color_btn_blue"
            app:selectedTextSize="@dimen/sp_24"
            app:unitHeight="@dimen/dp_64"/>
        <com.byd.carsettings.ui.widget.wheelview.WheelView
            android:id="@+id/wheelView_m"
            android:layout_width="@dimen/dp_232"
            android:layout_height="match_parent"
            app:itemNumber="3"
            app:lineColor="@color/dialog_divider_common"
            app:lineHeight="@dimen/dp_1"
            app:noEmpty="true"
            app:normalTextColor="@color/text_color_main_gray"
            app:normalTextSize="@dimen/sp_24"
            app:selectedTextColor="@color/text_color_btn_blue"
            app:selectedTextSize="@dimen/sp_24"
            app:unitHeight="@dimen/dp_64"/>
    </LinearLayout>
</LinearLayout>
