<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:layout_width="@dimen/dp_612"
    android:layout_height="wrap_content"
    android:maxHeight="@dimen/dp_544"
    style="@style/vehicle_setting_dialog_background_container">
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="@color/text_color_main_dilink_pagers"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_29"
        android:layout_marginTop="@dimen/dp_22"
        android:text="@string/dipilot_ditrainer_cities_with_driving_explain"
        android:layout_marginStart="@dimen/dp_24"
        android:layout_marginEnd="@dimen/dp_24"/>
    <View
        android:id="@+id/divider"
        android:background="@color/dialog_divider_common"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_marginTop="@dimen/dp_20"/>
    <com.byd.carsettings.ui.widget.WrapHeightNestedScrollView
        android:scrollbarAlwaysDrawVerticalTrack="true"
        android:layout_gravity="center_horizontal"
        android:scrollbars="vertical"
        android:layout_width="@dimen/dp_612"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_40"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/dialog_text_color_main"
                android:gravity="left"
                android:layout_gravity="center"
                android:id="@+id/tv_content"
                android:layout_width="@dimen/dp_532"
                android:layout_height="wrap_content"
                android:text="@string/dipilot_ditrainer_cities_with_driving_tips"/>
            <ImageView
                android:layout_gravity="center_horizontal"
                android:background="@drawable/img_carsetting_qiancheqibutixing"
                android:layout_width="@dimen/dp_532"
                android:layout_height="@dimen/dp_168"
                android:layout_marginTop="@dimen/dp_24"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/dialog_text_color_main"
                android:gravity="left"
                android:layout_gravity="center"
                android:layout_width="@dimen/dp_532"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:text="@string/dipilot_ditrainer_car_ahead_start_warning_func"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/dialog_text_color_tips"
                android:gravity="left"
                android:layout_gravity="center"
                android:id="@+id/tv_notice"
                android:layout_width="@dimen/dp_532"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_4"
                android:text="@string/dipilot_ditrainer_car_ahead_start_warning_func_tips"/>
            <ImageView
                android:layout_gravity="center_horizontal"
                android:background="@drawable/img_carsetting_zhuanxiangdengfuzhu"
                android:layout_width="@dimen/dp_532"
                android:layout_height="@dimen/dp_168"
                android:layout_marginTop="@dimen/dp_24"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/dialog_text_color_main"
                android:gravity="left"
                android:layout_gravity="center"
                android:layout_width="@dimen/dp_532"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:text="@string/dipilot_ditrainer_turn_signal_assist"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/dialog_text_color_tips"
                android:gravity="left"
                android:layout_gravity="center"
                android:layout_width="@dimen/dp_532"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_4"
                android:text="@string/dipilot_ditrainer_turn_signal_assist_tips"/>
            <ImageView
                android:layout_gravity="center_horizontal"
                android:background="@drawable/img_carsetting_yutianwudengfuzhu"
                android:layout_width="@dimen/dp_532"
                android:layout_height="@dimen/dp_168"
                android:layout_marginTop="@dimen/dp_24"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/dialog_text_color_main"
                android:gravity="left"
                android:layout_gravity="center"
                android:layout_width="@dimen/dp_532"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:text="@string/dipilot_ditrainer_rain_fog_lamps_warning"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/dialog_text_color_tips"
                android:gravity="left"
                android:layout_gravity="center"
                android:layout_width="@dimen/dp_532"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_4"
                android:text="@string/dipilot_ditrainer_rain_fog_lamps_warning_tips"/>
        </LinearLayout>
    </com.byd.carsettings.ui.widget.WrapHeightNestedScrollView>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_btn_container"
        android:paddingBottom="@dimen/dp_28"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_76"
        android:layout_marginTop="@dimen/dp_44">
        <Button
            android:textSize="@dimen/sp_18"
            android:textColor="@color/white"
            android:id="@+id/btn_positive"
            android:background="@drawable/shape_bg_blue_radio_button"
            android:layout_width="@dimen/dp_160"
            android:layout_height="@dimen/dp_48"
            android:text="@string/dipilot_common_dialog_confirm"/>
    </LinearLayout>
</LinearLayout>
