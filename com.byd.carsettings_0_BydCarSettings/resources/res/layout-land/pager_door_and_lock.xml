<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bydux.api.common.views.window.DampingScrollView
        android:id="@+id/nsw"
        style="@style/vehicle_setting_module_damping_scrollView_land_style">
        <LinearLayout style="@style/vehicle_setting_module_damping_scrollView_child_land_style">
            <RelativeLayout
                android:id="@+id/nfc_container"
                style="@style/vehicle_setting_tv_arrow_container_style">
                <TextView
                    android:id="@+id/digital_key_tv"
                    android:text="@string/nfc_key_mode_nfc"
                    style="@style/vehicle_setting_tv_arrow_tv_style"/>
                <ImageView
                    android:id="@+id/door_and_lock_key_iv"
                    style="@style/vehicle_setting_tv_arrow_arrow_style"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/back_door_out_container"
                android:paddingBottom="@dimen/dp_28"
                android:layout_marginBottom="@dimen/dp_16"
                style="@style/vehicle_setting_background_container">
                <RelativeLayout
                    android:id="@+id/back_door_container"
                    style="@style/vehicle_setting_un_background_container">
                    <com.byd.carsettings.ui.widget.AreaableSeekbar
                        android:id="@+id/door_and_lock_height_sb"
                        android:layout_marginTop="@dimen/dp_16"
                        android:max="100"
                        android:layout_below="@+id/door_hight_percent"
                        android:layout_marginStart="@dimen/dp_16"
                        android:layout_marginEnd="@dimen/dp_16"
                        android:min="15"
                        style="@style/vehicle_setting_seekbar_style"/>
                    <TextView
                        android:id="@+id/door_hight_percent"
                        android:layout_width="@dimen/dp_50"
                        android:layout_height="@dimen/dp_28"
                        style="@style/vehicle_setting_seekbar_progress_tv_style"/>
                    <TextView
                        android:id="@+id/back_door_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/vehiclesettings_opening_height_of_back_door"
                        android:layout_toStartOf="@+id/door_hight_percent"
                        style="@style/vehicle_setting_seekbar_title_tv_style"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/door_and_lock_sgbg_container"
                    android:layout_below="@+id/back_door_container"
                    style="@style/vehicle_setting_tv_seg_container_un_single_style">
                    <TextView
                        android:id="@+id/carsetting_door_lock_auto"
                        android:text="@string/vehiclesettings_handle_auto_retraction"
                        style="@style/vehicle_setting_tv_seg_tv_style"/>
                    <com.byd.base.view.segmentedbutton.SegmentedButtonGroup
                        android:id="@+id/door_and_lock_sgbg"
                        android:layout_below="@+id/carsetting_door_lock_auto"
                        style="@style/vehicle_setting_tv_seg_seg_style">
                        <com.byd.base.view.segmentedbutton.SegmentedButton
                            app:sb_text="@string/vehiclesettings_close"
                            style="@style/vehicle_setting_tv_seg_seg_btn_style"/>
                        <com.byd.base.view.segmentedbutton.SegmentedButton
                            app:sb_text="@string/vehiclesettings_auto_reteaction_of_handle_2M"
                            style="@style/vehicle_setting_tv_seg_seg_btn_style"/>
                        <com.byd.base.view.segmentedbutton.SegmentedButton
                            app:sb_text="@string/vehiclesettings_auto_reteaction_of_handle_5M"
                            style="@style/vehicle_setting_tv_seg_seg_btn_style"/>
                        <com.byd.base.view.segmentedbutton.SegmentedButton
                            app:sb_text="@string/vehiclesettings_auto_reteaction_of_handle_10M"
                            style="@style/vehicle_setting_tv_seg_seg_btn_style"/>
                    </com.byd.base.view.segmentedbutton.SegmentedButtonGroup>
                </RelativeLayout>
            </RelativeLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/setting_part_up"
                style="@style/vehicle_setting_background_with_param_container">
                <RelativeLayout
                    android:id="@+id/doors_container"
                    android:minHeight="@dimen/dp_102"
                    style="@style/vehicle_setting_tv_seg_container_un_single_style">
                    <TextView
                        android:id="@+id/door_tv"
                        android:layout_marginTop="@dimen/dp_18"
                        android:text="@string/vehiclesettings_remote_unlock"
                        style="@style/vehicle_setting_tv_seg_tv_style"/>
                    <com.byd.base.view.segmentedbutton.SegmentedButtonGroup
                        android:id="@+id/doorlock_control_segmentedButtonGroup"
                        android:layout_marginBottom="@dimen/dp_16"
                        android:layout_below="@+id/door_tv"
                        style="@style/vehicle_setting_tv_seg_seg_style">
                        <com.byd.base.view.segmentedbutton.SegmentedButton
                            app:sb_text="@string/vehiclesettings_smart_lock_rmote_drive_door"
                            style="@style/vehicle_setting_tv_seg_seg_btn_style"/>
                        <com.byd.base.view.segmentedbutton.SegmentedButton
                            app:sb_text="@string/vehiclesettings_smart_lock_rmote_all_door"
                            style="@style/vehicle_setting_tv_seg_seg_btn_style"/>
                    </com.byd.base.view.segmentedbutton.SegmentedButtonGroup>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/doorlock_key_press_lock_container"
                    style="@style/vehicle_setting_tv_sw_icon_container_un_single_style">
                    <com.byd.base.view.BydSwitch
                        android:id="@+id/doorlock_key_press_lock"
                        style="@style/vehicle_setting_tv_sw_icon_sw_style"/>
                    <TextView
                        android:text="@string/vehiclesettings_long_press_the_remote_control_key_to_lock_and_close_the_window"
                        android:layout_toEndOf="@+id/doorlock_key_press_lock"
                        style="@style/vehicle_setting_tv_sw_icon_tv_un_icon_style"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/doorlock_key_press_unlock_container"
                    style="@style/vehicle_setting_tv_sw_icon_container_un_single_style">
                    <com.byd.base.view.BydSwitch
                        android:id="@+id/doorlock_key_press_unlock"
                        style="@style/vehicle_setting_tv_sw_icon_sw_style"/>
                    <TextView
                        android:text="@string/vehiclesettings_long_press_the_remote_control_key_to_unlock_the_window"
                        android:layout_toEndOf="@+id/doorlock_key_press_unlock"
                        style="@style/vehicle_setting_tv_sw_icon_tv_un_icon_style"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/doorlock_key_tip_lock_container"
                    style="@style/vehicle_setting_tv_sw_icon_container_un_single_style">
                    <com.byd.base.view.BydSwitch
                        android:id="@+id/doorlock_key_tip_lock"
                        style="@style/vehicle_setting_tv_sw_icon_sw_style"/>
                    <TextView
                        android:text="@string/vehiclesettings_lp_micro_switch_lock_window"
                        android:layout_toEndOf="@+id/doorlock_key_tip_lock"
                        style="@style/vehicle_setting_tv_sw_icon_tv_un_icon_style"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/doorlock_key_tip_unlock_container"
                    style="@style/vehicle_setting_tv_sw_icon_container_un_single_style">
                    <com.byd.base.view.BydSwitch
                        android:id="@+id/doorlock_key_tip_unlock"
                        style="@style/vehicle_setting_tv_sw_icon_sw_style"/>
                    <TextView
                        android:text="@string/vehiclesettings_lp_micro_switch_unlock_window"
                        android:layout_toEndOf="@+id/doorlock_key_tip_unlock"
                        style="@style/vehicle_setting_tv_sw_icon_tv_un_icon_style"/>
                </RelativeLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/setting_part_lock_container"
                style="@style/vehicle_setting_background_with_param_container">
                <RelativeLayout
                    android:id="@+id/doorlock_intelligent_unlock_container"
                    style="@style/vehicle_setting_tv_sw_icon_container_un_single_style">
                    <com.byd.base.view.BydSwitch
                        android:id="@+id/doorlock_rain_intelligent_unlock"
                        style="@style/vehicle_setting_tv_sw_icon_sw_style"/>
                    <TextView
                        android:text="@string/vehiclesettings_intelligent_unlock"
                        android:layout_toEndOf="@+id/doorlock_rain_intelligent_unlock"
                        style="@style/vehicle_setting_tv_sw_icon_tv_un_icon_style"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/doorlock_intelligent_lock_container"
                    style="@style/vehicle_setting_tv_sw_icon_container_un_single_style">
                    <com.byd.base.view.BydSwitch
                        android:id="@+id/doorlock_intelligent_lock"
                        style="@style/vehicle_setting_tv_sw_icon_sw_style"/>
                    <TextView
                        android:text="@string/vehiclesettings_intelligent_lock"
                        android:layout_toEndOf="@+id/doorlock_intelligent_lock"
                        style="@style/vehicle_setting_tv_sw_icon_tv_un_icon_style"/>
                </RelativeLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/setting_part_middle"
                style="@style/vehicle_setting_background_with_param_container">
                <RelativeLayout
                    android:id="@+id/doorlock_drive_unlock_container"
                    style="@style/vehicle_setting_tv_sw_icon_container_un_single_style">
                    <com.byd.base.view.BydSwitch
                        android:id="@+id/doorlock_drive_unlock"
                        style="@style/vehicle_setting_tv_sw_icon_sw_style"/>
                    <TextView
                        android:text="@string/vehiclesettings_driving_automatically_lock_down"
                        android:layout_toEndOf="@+id/doorlock_drive_unlock"
                        style="@style/vehicle_setting_tv_sw_icon_tv_un_icon_style"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/doorlock_rain_lock_container"
                    style="@style/vehicle_setting_tv_sw_icon_container_un_single_style">
                    <com.byd.base.view.BydSwitch
                        android:id="@+id/doorlock_rain_lock"
                        style="@style/vehicle_setting_tv_sw_icon_sw_style"/>
                    <TextView
                        android:text="@string/vehiclesettings_automatic_window_closing_on_rainy_days"
                        android:layout_toEndOf="@+id/doorlock_rain_lock"
                        style="@style/vehicle_setting_tv_sw_icon_tv_un_icon_style"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/doorlock_lock_updoor_container"
                    style="@style/vehicle_setting_tv_sw_icon_container_un_single_style">
                    <com.byd.base.view.BydSwitch
                        android:id="@+id/doorlock_lock_updoor"
                        style="@style/vehicle_setting_tv_sw_icon_sw_style"/>
                    <TextView
                        android:text="@string/vehiclesettings_lock_the_window_automatically"
                        android:layout_toEndOf="@+id/doorlock_lock_updoor"
                        style="@style/vehicle_setting_tv_sw_icon_tv_un_icon_style"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/doorlock_lock_high_speed_container"
                    style="@style/vehicle_setting_tv_sw_icon_container_un_single_style">
                    <com.byd.base.view.BydSwitch
                        android:id="@+id/doorlock_lock_high_speed"
                        style="@style/vehicle_setting_tv_sw_icon_sw_style"/>
                    <TextView
                        android:text="@string/vehiclesettings_comfortable_high_speed_auto_close"
                        android:layout_toEndOf="@+id/doorlock_lock_high_speed"
                        style="@style/vehicle_setting_tv_sw_icon_tv_un_icon_style"/>
                </RelativeLayout>
            </LinearLayout>
            <RelativeLayout
                android:id="@+id/doorlock_behind_lock_container"
                style="@style/vehicle_setting_tv_sw_icon_container_style">
                <com.byd.base.view.BydSwitch
                    android:id="@+id/doorlock_behind_lock"
                    style="@style/vehicle_setting_tv_sw_icon_sw_style"/>
                <TextView
                    android:text="@string/vehiclesettings_rear_control_panel_lock"
                    android:layout_toEndOf="@+id/doorlock_behind_lock"
                    style="@style/vehicle_setting_tv_sw_icon_tv_un_icon_style"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/doorlock_elec_slide_door_container"
                style="@style/vehicle_setting_tv_sw_icon_container_style">
                <com.byd.base.view.BydSwitch
                    android:id="@+id/doorlock_elec_slide_door"
                    style="@style/vehicle_setting_tv_sw_icon_sw_style"/>
                <com.byd.base.view.BydFlexTextView
                    android:id="@+id/doorlock_elec_slide_door_tv"
                    android:text="@string/vehiclesettings_door_lock_electric_door_state"
                    android:layout_toEndOf="@+id/doorlock_elec_slide_door"
                    style="@style/vehicle_setting_tv_sw_icon_tv_land_style"/>
                <ImageView
                    android:id="@+id/doorlock_elec_slide_door_icon"
                    android:layout_toEndOf="@+id/doorlock_elec_slide_door_tv"
                    style="@style/vehicle_setting_tv_sw_icon_icon_style"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/doorlock_run_auto_close_door_container"
                style="@style/vehicle_setting_tv_sw_icon_container_style">
                <com.byd.base.view.BydSwitch
                    android:id="@+id/doorlock_run_auto_close_door"
                    style="@style/vehicle_setting_tv_sw_icon_sw_style"/>
                <TextView
                    android:text="@string/vehiclesettings_comfortable_run_auto_close_door"
                    android:layout_toEndOf="@+id/doorlock_run_auto_close_door"
                    style="@style/vehicle_setting_tv_sw_icon_tv_un_icon_style"/>
            </RelativeLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/charge_out_container"
                style="@style/vehicle_setting_background_with_param_container">
                <RelativeLayout
                    android:id="@+id/comfortable_driving_chargeintell_container"
                    style="@style/vehicle_setting_tv_sw_icon_container_un_single_style">
                    <com.byd.base.view.BydSwitch
                        android:id="@+id/comfortable_driving_chargeintell"
                        style="@style/vehicle_setting_tv_sw_icon_sw_style"/>
                    <TextView
                        android:text="@string/vehiclesettings_doorlock_power_on"
                        android:layout_toEndOf="@+id/comfortable_driving_chargeintell"
                        style="@style/vehicle_setting_tv_sw_icon_tv_un_icon_style"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/comfortable_driving_outchargeintell_container"
                    style="@style/vehicle_setting_tv_sw_icon_container_un_single_style">
                    <com.byd.base.view.BydSwitch
                        android:id="@+id/comfortable_driving_outchargeintell"
                        style="@style/vehicle_setting_tv_sw_icon_sw_style"/>
                    <TextView
                        android:text="@string/vehiclesettings_doorlock_power_off"
                        android:layout_toEndOf="@+id/comfortable_driving_outchargeintell"
                        style="@style/vehicle_setting_tv_sw_icon_tv_un_icon_style"/>
                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>
    </com.bydux.api.common.views.window.DampingScrollView>
    <ImageView
        android:id="@+id/door_and_lock_image"
        style="@style/vehicle_setting_car_image_land_style"/>
</LinearLayout>
