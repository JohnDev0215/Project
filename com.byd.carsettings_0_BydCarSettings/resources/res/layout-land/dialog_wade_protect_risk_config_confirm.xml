<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_vertical"
    android:layout_width="@dimen/dp_560"
    android:layout_height="@dimen/dp_491"
    style="@style/vehicle_setting_dialog_background_container">
    <RelativeLayout
        android:id="@+id/carsetting_dialog_head"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_72"
        android:layout_alignParentTop="true">
        <TextView
            android:id="@+id/carsetting_dialog_title"
            android:text="@string/vehiclesettings_comfortable_wading_protection_action"
            style="@style/byd_vehicle_setting_dialog_title_style"/>
        <View
            android:id="@+id/carsetting_dialog_line"
            android:background="@color/ambient_dialog_line_bg"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <ScrollView
        android:scrollbarSize="@dimen/dp_22"
        android:scrollbarThumbVertical="@drawable/setting_bar_thumb"
        android:scrollbarTrackVertical="@drawable/setting_bar_track"
        android:scrollbarStyle="insideOverlay"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dp_40"
        android:layout_marginBottom="@dimen/dp_16"
        android:layout_above="@+id/carsetting_dialog_checkbox_contaner"
        android:layout_below="@+id/carsetting_dialog_head"
        android:overScrollMode="never">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/carsetting_text_color_white"
                android:id="@+id/carsetting_dialog_titile_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/vehiclesettings_comfortable_wading_protection_up_tips"
                android:textDirection="locale"
                android:layout_marginStart="@dimen/dp_48"
                android:layout_marginEnd="@dimen/dp_48"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/carsetting_text_color_white"
                android:id="@+id/carsetting_dialog_main_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                android:text="@string/vehiclesettings_comfortable_wading_protection_open_dlg_down_tips"
                android:layout_below="@+id/carsetting_dialog_titile_content"
                android:textDirection="locale"
                android:layout_marginStart="@dimen/dp_48"
                android:layout_marginEnd="@dimen/dp_48"/>
        </RelativeLayout>
    </ScrollView>
    <RelativeLayout
        android:id="@+id/carsetting_dialog_checkbox_contaner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/dp_40"
        android:layout_above="@+id/carsetting_dialog_bottom"
        android:layout_marginStart="@dimen/dp_40"
        android:layout_marginEnd="@dimen/dp_40">
        <CheckBox
            android:id="@+id/comfortable_wading_protect_cb"
            android:layout_width="@dimen/dp_40"
            android:layout_height="@dimen/dp_40"
            android:button="@drawable/veichle_checkbox_selected"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="@dimen/dp_18"
            android:textColor="@color/comfortable_wading_protect_read_tv_color"
            android:id="@+id/comfortable_wading_protect_read_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/dp_220"
            android:text="@string/vehiclesettings_comfortable_wading_protection_risk_read_and_confirm"
            android:layout_centerVertical="true"
            android:textDirection="locale"
            android:layout_toEndOf="@+id/comfortable_wading_protect_cb"/>
        <TextView
            android:textSize="@dimen/dp_18"
            android:textColor="#ff45a2ff"
            android:id="@+id/comfortable_wading_protect_risk_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/dp_220"
            android:text="@string/vehiclesettings_comfortable_wading_protection_risk_title"
            android:layout_centerVertical="true"
            android:textDirection="locale"
            android:layout_marginStart="@dimen/dp_4"
            android:layout_toEndOf="@+id/comfortable_wading_protect_read_tips"/>
    </RelativeLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/carsetting_dialog_bottom"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_104"
        android:layout_alignParentBottom="true">
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layoutDirection="ltr"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <Button
                android:textSize="@dimen/sp_18"
                android:textColor="@color/byd_vehicle_dialog_btn_confirm_text_color"
                android:id="@+id/carsetting_dialog_btn_confirm"
                android:background="@drawable/selector_dialog_blue"
                android:layout_width="@dimen/dp_176"
                android:layout_height="@dimen/dp_48"
                android:layout_marginTop="@dimen/dp_28"
                android:layout_marginBottom="@dimen/dp_28"
                android:text="@string/vehiclesettings_button_confirm"
                android:textAllCaps="false"
                android:textDirection="locale"/>
            <Button
                android:textSize="@dimen/sp_18"
                android:textColor="@color/byd_vehicle_dialog_btn_cancel_text_color"
                android:id="@+id/carsetting_dialog_btn_cancel"
                android:background="@drawable/selector_dialog_white"
                android:layout_width="@dimen/dp_176"
                android:layout_height="@dimen/dp_48"
                android:layout_marginTop="@dimen/dp_28"
                android:layout_marginBottom="@dimen/dp_28"
                android:text="@string/vehiclesettings_button_cancel"
                android:textAllCaps="false"
                android:textDirection="locale"
                android:layout_marginStart="@dimen/dp_48"
                android:layout_toEndOf="@+id/carsetting_dialog_btn_confirm"
                android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"/>
        </RelativeLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>
