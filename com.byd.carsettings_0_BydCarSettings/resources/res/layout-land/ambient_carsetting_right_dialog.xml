<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:layout_width="@dimen/dp_560"
    android:layout_height="wrap_content"
    android:elevation="@dimen/dp_10"
    style="@style/vehicle_setting_dialog_background_container">
    <TextView
        android:textColor="@color/carsetting_text_color_white"
        android:id="@+id/ambient_dialog_title"
        android:layout_marginTop="@dimen/dp_22"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/byd_vehicle_setting_dialog_title_style"/>
    <View
        android:id="@+id/ambient_dialog_line"
        android:background="@color/ambient_dialog_line_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_marginTop="@dimen/dp_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ambient_dialog_title"/>
    <RadioGroup
        android:orientation="vertical"
        android:id="@+id/ambient_rg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ambient_dialog_line">
        <com.byd.carsettings.ui.widget.BydRadioButton
            android:textSize="@dimen/sp_18"
            android:textColor="@color/carsetting_text_color_white"
            android:id="@+id/mode1"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_8"
            android:checked="true"
            android:layout_marginStart="@dimen/dp_48"
            style="@style/BydCheckboxTheme"/>
        <com.byd.carsettings.ui.widget.BydRadioButton
            android:textSize="@dimen/sp_18"
            android:textColor="@color/carsetting_text_color_white"
            android:id="@+id/mode2"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_8"
            android:layout_marginStart="@dimen/dp_48"
            style="@style/BydCheckboxTheme"/>
        <com.byd.carsettings.ui.widget.BydRadioButton
            android:textSize="@dimen/sp_18"
            android:textColor="@color/carsetting_text_color_white"
            android:id="@+id/mode3"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_8"
            android:textAlignment="center"
            android:layout_marginStart="@dimen/dp_48"
            style="@style/BydCheckboxTheme"/>
        <com.byd.carsettings.ui.widget.BydRadioButton
            android:textSize="@dimen/sp_18"
            android:textColor="@color/carsetting_text_color_white"
            android:id="@+id/mode4"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_8"
            android:layout_marginStart="@dimen/dp_48"
            style="@style/BydCheckboxTheme"/>
    </RadioGroup>
    <Button
        android:textSize="@dimen/sp_18"
        android:textColor="@color/white"
        android:id="@+id/ambient_btn_confirm"
        android:background="@drawable/selector_dialog_blue"
        android:layout_width="@dimen/dp_176"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_28"
        android:layout_marginBottom="@dimen/dp_25"
        android:text="@string/vehiclesettings_button_confirm"
        android:textAllCaps="false"
        android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ambient_btn_cancel"
        app:layout_constraintTop_toBottomOf="@+id/ambient_rg"/>
    <Button
        android:textSize="@dimen/sp_18"
        android:textColor="@color/ambient_btn_cancel"
        android:id="@+id/ambient_btn_cancel"
        android:background="@drawable/selector_dialog_white"
        android:layout_width="@dimen/dp_176"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_28"
        android:layout_marginBottom="@dimen/dp_25"
        android:text="@string/vehiclesettings_button_cancel"
        android:textAllCaps="false"
        android:layout_marginStart="@dimen/dp_80"
        android:stateListAnimator="@drawable/anim_btn_scale"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ambient_rg"/>
</androidx.constraintlayout.widget.ConstraintLayout>
