<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingBottom="@dimen/dp_24"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:splitMotionEvents="false"
    android:windowEnableSplitTouch="false">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_0_app_manage_pager"
        android:background="@drawable/bg_frame_gray_a"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16">
        <com.byd.carsettings.ui.widget.SimpleLinearItem
            android:id="@+id/item_app_app_manage_pager"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_88"
            app:textLeft="@string/dilink_application"/>
        <com.byd.carsettings.ui.widget.SimpleLinearItem
            android:id="@+id/item_storage_app_manage_pager"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_88"
            app:textLeft="@string/storage_app_details"/>
        <com.byd.carsettings.ui.widget.SimpleLinearItem
            android:id="@+id/item_security_app_manage_pager"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_88"
            app:textLeft="@string/security_app_manage"/>
        <com.byd.carsettings.ui.widget.SimpleLinearItem
            android:id="@+id/item_permission_app_manage_pager"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_88"
            app:textLeft="@string/permission_app_details"/>
        <com.byd.carsettings.ui.widget.SimpleLinearItem
            android:id="@+id/item_privacy_manage_app_manage_pager"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_88"
            app:textLeft="@string/privacy_manage_app_manage"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_1_app_manage_pager"
        android:background="@drawable/bg_frame_gray_a"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16">
        <com.byd.carsettings.ui.widget.SimpleLinearItem
            android:id="@+id/item_accessibility_app_manage_pager"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_88"
            app:textLeft="@string/accessibility_app_manage"/>
        <com.byd.carsettings.ui.widget.SimpleLinearItem
            android:id="@+id/item_disable_auto_start_app_manage_pager"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_88"
            app:textLeft="@string/disable_auto_start_app_manage"/>
        <com.byd.carsettings.ui.widget.SimpleLinearItem
            android:id="@+id/item_notification_app_manage_pager"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_88"
            app:textLeft="@string/notification_app_manage"/>
    </LinearLayout>
</LinearLayout>
