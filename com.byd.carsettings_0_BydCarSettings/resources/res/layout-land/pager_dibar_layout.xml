<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bydux.api.common.views.window.DampingScrollView
        android:id="@+id/nsw"
        style="@style/vehicle_setting_module_damping_scrollView_land_style">
        <LinearLayout
            android:id="@+id/carlight_params_ll"
            style="@style/vehicle_setting_module_damping_scrollView_child_land_style">
            <RelativeLayout
                android:id="@+id/dibar_tray_container"
                android:layout_height="@dimen/dp_136"
                android:layout_marginBottom="@dimen/dp_16"
                style="@style/vehicle_setting_background_container">
                <RelativeLayout
                    android:id="@+id/dibar_tray_out_rl"
                    android:background="@drawable/dibar_button_slector"
                    android:clickable="true"
                    android:layout_width="@dimen/dp_144"
                    android:layout_height="@dimen/dp_40"
                    android:layout_marginTop="@dimen/dp_16"
                    android:layout_below="@+id/dibar_tray_tv"
                    android:layout_marginStart="@dimen/dp_24">
                    <ImageView
                        android:id="@+id/dibar_tray_out_iv"
                        android:visibility="gone"
                        android:layout_width="@dimen/dp_24"
                        android:layout_height="@dimen/dp_24"
                        android:src="?attr/byd_vehicle_dibar_loading"
                        android:layout_centerInParent="true"
                        android:layout_marginEnd="@dimen/dp_4"
                        android:layout_toStartOf="@+id/dibar_tray_out_tv"
                        android:layout_alignParentStart="true"/>
                    <TextView
                        android:textSize="@dimen/sp_18"
                        android:textColor="@color/btn_selected_selector"
                        android:gravity="center"
                        android:id="@+id/dibar_tray_out_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/vehiclesettings_diba_tray_reach"
                        android:layout_centerInParent="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/dibar_tray_back_rl"
                    android:background="@drawable/dibar_button_slector"
                    android:clickable="true"
                    android:layout_width="@dimen/dp_144"
                    android:layout_height="@dimen/dp_40"
                    android:layout_marginTop="@dimen/dp_16"
                    android:layout_below="@+id/dibar_tray_tv"
                    android:layout_marginStart="@dimen/dp_16"
                    android:layout_toEndOf="@+id/dibar_tray_out_rl">
                    <ImageView
                        android:id="@+id/dibar_tray_back_iv"
                        android:visibility="gone"
                        android:layout_width="@dimen/dp_24"
                        android:layout_height="@dimen/dp_24"
                        android:src="?attr/byd_vehicle_dibar_loading"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="@dimen/dp_4"
                        android:layout_toStartOf="@+id/dibar_tray_back_tv"
                        android:layout_alignParentStart="true"/>
                    <TextView
                        android:textSize="@dimen/sp_18"
                        android:textColor="@color/btn_selected_selector"
                        android:gravity="center"
                        android:id="@+id/dibar_tray_back_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/vehiclesettings_diba_tray_retract"
                        android:layout_centerInParent="true"/>
                </RelativeLayout>
                <TextView
                    android:id="@+id/dibar_tray_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/vehiclesettings_diba_tray_title"
                    style="@style/carsetting_dibar_tv_start_style"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/dibar_refrigerator_container"
                style="@style/vehicle_setting_background_with_param_container">
                <RelativeLayout
                    android:id="@+id/dibar_refrigerator"
                    android:minHeight="@dimen/dp_102"
                    style="@style/vehicle_setting_tv_seg_container_un_single_style">
                    <TextView
                        android:id="@+id/dibar_refrigerator_tv"
                        android:layout_marginTop="@dimen/dp_18"
                        android:text="@string/vehiclesettings_diba_dc_thermoelectric_cooler"
                        style="@style/vehicle_setting_tv_seg_tv_style"/>
                    <com.byd.base.view.segmentedbutton.SegmentedButtonGroup
                        android:id="@+id/dibar_refrigerator_work_state_mode"
                        android:layout_below="@+id/dibar_refrigerator_tv"
                        style="@style/vehicle_setting_tv_seg_seg_style">
                        <com.byd.base.view.segmentedbutton.SegmentedButton
                            app:sb_text="@string/vehiclesettings_close"
                            style="@style/vehicle_setting_tv_seg_seg_btn_style"/>
                        <com.byd.base.view.segmentedbutton.SegmentedButton
                            android:id="@+id/warm"
                            app:sb_text="@string/vehiclesettings_diba_refrigerator_heating"
                            style="@style/vehicle_setting_tv_seg_seg_btn_style"/>
                        <com.byd.base.view.segmentedbutton.SegmentedButton
                            android:id="@+id/cold"
                            app:sb_text="@string/vehiclesettings_diba_refrigerator_refrigeration"
                            style="@style/vehicle_setting_tv_seg_seg_btn_style"/>
                    </com.byd.base.view.segmentedbutton.SegmentedButtonGroup>
                    <com.byd.base.view.segmentedbutton.SegmentedButtonGroup
                        android:id="@+id/dibar_refrigerator_work_state_mode_cold"
                        android:layout_below="@+id/dibar_refrigerator_tv"
                        style="@style/vehicle_setting_tv_seg_seg_style">
                        <com.byd.base.view.segmentedbutton.SegmentedButton
                            app:sb_text="@string/vehiclesettings_close"
                            style="@style/vehicle_setting_tv_seg_seg_btn_style"/>
                        <com.byd.base.view.segmentedbutton.SegmentedButton
                            app:sb_text="@string/vehiclesettings_diba_refrigerator_refrigeration"
                            style="@style/vehicle_setting_tv_seg_seg_btn_style"/>
                    </com.byd.base.view.segmentedbutton.SegmentedButtonGroup>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/dibar_remember_poweroff_container"
                    android:layout_marginTop="@dimen/dp_24"
                    android:layout_below="@+id/dibar_refrigerator"
                    style="@style/vehicle_setting_tv_sw_icon_container_un_single_style">
                    <TextView
                        android:id="@+id/dibar_remember_poweroff_tv"
                        android:text="@string/vehiclesettings_diba_pdm"
                        android:layout_toEndOf="@+id/dibar_remember_poweroff_sw"
                        style="@style/vehicle_setting_tv_sw_icon_tv_un_icon_style"/>
                    <com.byd.base.view.BydSwitch
                        android:id="@+id/dibar_remember_poweroff_sw"
                        style="@style/vehicle_setting_tv_sw_icon_sw_style"/>
                </RelativeLayout>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/dibar_disinf_container"
                android:layout_height="@dimen/dp_88"
                android:layout_marginBottom="@dimen/dp_16"
                style="@style/vehicle_setting_background_container">
                <RelativeLayout
                    android:id="@+id/dibar_disinf_rl"
                    android:background="@drawable/carsetting_raidobutton_selector"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/dp_188"
                    android:minHeight="@dimen/dp_40"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/dp_24">
                    <ImageView
                        android:id="@+id/dibar_disinf_iv"
                        android:visibility="gone"
                        android:layout_width="@dimen/dp_24"
                        android:layout_height="@dimen/dp_24"
                        android:src="?attr/byd_vehicle_dibar_loading"
                        android:layout_centerVertical="true"
                        android:layout_toStartOf="@+id/dibar_disinf_tv"
                        android:layout_alignParentStart="true"/>
                    <TextView
                        android:textSize="@dimen/sp_20"
                        android:textColor="@color/btn_selected_selector"
                        android:id="@+id/dibar_disinf_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/vehiclesettings_diba_disinfectings"
                        android:layout_centerInParent="true"
                        android:paddingStart="@dimen/dp_4"
                        android:paddingEnd="@dimen/dp_4"/>
                </RelativeLayout>
            </RelativeLayout>
        </LinearLayout>
    </com.bydux.api.common.views.window.DampingScrollView>
    <ImageView
        android:id="@+id/dibar_image"
        style="@style/vehicle_setting_car_image_land_style"/>
</LinearLayout>
