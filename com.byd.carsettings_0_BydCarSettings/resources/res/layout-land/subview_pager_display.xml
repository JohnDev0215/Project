<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingBottom="@dimen/dp_24"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/ll_brightness_adjust_of_media_display"
        android:background="@drawable/bg_frame_gray_a"
        android:layout_width="@dimen/dp_468"
        android:layout_height="@dimen/dp_144"
        android:layout_marginTop="@dimen/dp_16">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_26"
            android:paddingStart="@dimen/dp_24"
            android:paddingEnd="@dimen/dp_24">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_main"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/brightness_adjust_of_media_display"
                android:layout_alignParentStart="true"/>
            <TextView
                android:id="@+id/tv_progress_pager_display"
                android:layout_width="@dimen/dp_100"
                android:layout_height="wrap_content"
                style="@style/progress_value_text"/>
        </RelativeLayout>
        <com.byd.carsettings.ui.widget.AreaableSeekbar
            android:id="@+id/sbar_brightness_pager_display"
            android:paddingTop="@dimen/dp_16"
            android:paddingBottom="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_23"
            android:max="255"
            android:layout_marginStart="@dimen/dp_10"
            android:layout_marginEnd="@dimen/dp_10"
            style="@style/carsetting_seekbar_style"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_screen_saver_media_display"
        android:background="@drawable/bg_frame_gray_a"
        android:layout_width="@dimen/dp_468"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:minHeight="@dimen/dp_144"
        android:paddingStart="@dimen/dp_24"
        android:paddingEnd="@dimen/dp_24">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_26">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_main"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/screen_saver_media_display"
                android:layout_alignParentStart="true"/>
        </RelativeLayout>
        <com.byd.base.view.segmentedbutton.SegmentedButtonGroup
            android:layout_gravity="start|center_vertical"
            android:id="@+id/srg_screen_saver_media_display"
            android:background="@drawable/shape_bg_gray_radio_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_23"
            style="@style/dilink_segment_button_group_style">
            <com.byd.base.view.segmentedbutton.SegmentedButton
                android:id="@+id/rbtn_close_pager_display"
                app:sb_text="@string/close_display"
                style="@style/sbtn_4_display_pager_land"/>
            <com.byd.base.view.segmentedbutton.SegmentedButton
                android:id="@+id/rbtn_clock_1_pager_display"
                app:sb_text="@string/clock_1_display"
                style="@style/sbtn_4_display_pager_land"/>
            <com.byd.base.view.segmentedbutton.SegmentedButton
                android:id="@+id/rbtn_clock_2_pager_display"
                app:sb_text="@string/clock_2_display"
                style="@style/sbtn_4_display_pager_land"/>
            <com.byd.base.view.segmentedbutton.SegmentedButton
                android:id="@+id/rbtn_clock_3_pager_display"
                app:sb_text="@string/clock_3_display"
                style="@style/sbtn_4_display_pager_land"/>
        </com.byd.base.view.segmentedbutton.SegmentedButtonGroup>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_multimedia_brightness_linkage_media_display"
        android:background="@drawable/bg_frame_gray_a"
        android:layout_width="@dimen/dp_468"
        android:layout_height="@dimen/dp_88"
        android:layout_marginTop="@dimen/dp_16"
        android:paddingStart="@dimen/dp_24"
        android:paddingEnd="@dimen/dp_24">
        <com.byd.base.view.BydSwitch
            android:id="@+id/switch_multimedia_brightness_linkage_media_display"
            android:layout_marginEnd="@dimen/dp_16"
            style="@style/byd_switch"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_title_multimedia_brightness_linkage_media_display"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_item_left_dilink_link"
                android:ellipsize="end"
                android:id="@+id/tv_title_multimedia_brightness_linkage_media_display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/dp_300"
                android:text="@string/multimedia_brightness_linkage_media_display"/>
            <ImageView
                android:id="@+id/iv_details_multimedia_brightness"
                android:background="@drawable/icon_public_details_48"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_dark_light_mode_display"
        android:background="@drawable/bg_frame_gray_a"
        android:layout_width="@dimen/dp_468"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:minHeight="@dimen/dp_144"
        android:paddingStart="@dimen/dp_24"
        android:paddingEnd="@dimen/dp_24">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_26">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_main"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dark_light_mode_display"
                android:layout_alignParentStart="true"/>
        </RelativeLayout>
        <com.byd.base.view.segmentedbutton.SegmentedButtonGroup
            android:layout_gravity="start|center_vertical"
            android:id="@+id/srg_night_light_mode_media_display"
            android:background="@drawable/shape_bg_gray_radio_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_23"
            style="@style/carsetting_segment_button_group_style_tans_ripple">
            <com.byd.base.view.segmentedbutton.SegmentedButton
                android:id="@+id/rbtn_night_mode_pager_display"
                app:sb_text="@string/night_mode_display"
                style="@style/sbtn_3_display_light_mode_land"/>
            <com.byd.base.view.segmentedbutton.SegmentedButton
                android:id="@+id/rbtn_light_mode_pager_display"
                app:sb_text="@string/light_mode_display"
                style="@style/sbtn_3_display_light_mode_land"/>
            <com.byd.base.view.segmentedbutton.SegmentedButton
                android:id="@+id/rbtn_auto_mode_pager_display"
                app:sb_text="@string/auto_mode_display"
                style="@style/sbtn_3_display_light_mode_land"/>
        </com.byd.base.view.segmentedbutton.SegmentedButtonGroup>
    </LinearLayout>
    <com.byd.carsettings.ui.widget.LinearItem
        android:id="@+id/item_launcher_setting_display"
        android:background="@drawable/bg_frame_gray_a"
        android:layout_width="@dimen/dp_468"
        android:layout_height="@dimen/dp_88"
        android:layout_marginTop="@dimen/dp_14"
        app:textLeft="@string/launcher_setting_display"/>
</LinearLayout>
