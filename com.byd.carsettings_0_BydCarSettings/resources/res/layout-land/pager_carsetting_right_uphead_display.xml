<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/uphead_display_image"
        style="@style/vehicle_setting_right_car_image_land_style"/>
    <com.bydux.api.common.views.window.DampingScrollView
        android:id="@+id/nsw"
        style="@style/vehicle_setting_right_module_damping_scrollView_land_style">
        <LinearLayout style="@style/vehicle_setting_right_module_damping_scrollView_child_land_style">
            <RelativeLayout
                android:id="@+id/uphead_display_container"
                android:visibility="visible"
                style="@style/vehicle_setting_right_tv_sw_icon_container_style">
                <com.byd.base.view.BydSwitch
                    android:id="@+id/uphead_display_sw"
                    style="@style/vehicle_setting_right_tv_sw_icon_sw_style"/>
                <TextView
                    android:text="@string/vehiclesettings_hud_switch_name"
                    style="@style/vehicle_setting_right_tv_sw_icon_tv_un_icon_style"/>
            </RelativeLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/uphead_display_params_container"
                android:paddingBottom="@dimen/dp_26"
                android:layout_marginBottom="@dimen/dp_16"
                style="@style/vehicle_setting_background_container">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/uphead_display_height"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/vehiclesettings_hud_height_adjustment"
                        style="@style/vehicle_setting_right_seekbar_title_tv_style"/>
                    <TextView
                        android:id="@+id/uphead_display_height_level"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@+id/uphead_display_height"
                        style="@style/vehicle_setting_right_seekbar_progress_tv_style"/>
                    <SeekBar
                        android:id="@+id/uphead_display_height_sb"
                        android:layout_marginTop="@dimen/dp_15"
                        android:max="21"
                        android:layout_below="@+id/uphead_display_height_level"
                        android:layout_marginStart="@dimen/dp_6"
                        android:layout_marginEnd="@dimen/dp_6"
                        android:min="1"
                        style="@style/vehicle_setting_right_seekbar_style"/>
                </RelativeLayout>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/uphead_display_light"
                        android:text="@string/vehiclesettings_hud_brightness_adjustment"
                        style="@style/vehicle_setting_right_seekbar_title_tv_style"/>
                    <TextView
                        android:id="@+id/uphead_display_light_level"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@+id/uphead_display_light"
                        style="@style/vehicle_setting_right_seekbar_progress_tv_style"/>
                    <SeekBar
                        android:id="@+id/uphead_display_light_sb"
                        android:layout_marginTop="@dimen/dp_15"
                        android:max="11"
                        android:layout_below="@+id/uphead_display_light"
                        android:layout_marginStart="@dimen/dp_6"
                        android:layout_marginEnd="@dimen/dp_6"
                        android:min="1"
                        style="@style/vehicle_setting_right_seekbar_style"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/hud_angle_container"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dp_8">
                    <TextView
                        android:id="@+id/uphead_display_angle"
                        android:text="@string/vehiclesettings_hud_height_rotation_adjust"
                        style="@style/vehicle_setting_right_seekbar_title_tv_style"/>
                    <TextView
                        android:id="@+id/uphead_display_angle_unit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@+id/uphead_display_angle"
                        style="@style/vehicle_setting_right_seekbar_progress_tv_style"/>
                    <SeekBar
                        android:id="@+id/uphead_display_angle_sb"
                        android:layout_marginTop="@dimen/dp_15"
                        android:max="11"
                        android:layout_below="@+id/uphead_display_angle"
                        android:layout_marginStart="@dimen/dp_6"
                        android:layout_marginEnd="@dimen/dp_6"
                        android:min="1"
                        style="@style/vehicle_setting_right_seekbar_style"/>
                </RelativeLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/uphead_display_mode_change_container"
                android:layout_height="@dimen/dp_136"
                android:layout_marginBottom="@dimen/dp_16"
                style="@style/vehicle_setting_background_container">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/vehiclesettings_hud_mode_change"
                    android:layout_centerVertical="true"
                    style="@style/carsetting_hud_tv_start_style"/>
                <com.byd.base.view.segmentedbutton.SegmentedButtonGroup
                    android:id="@+id/uphead_display_mode_change_sbg"
                    android:visibility="gone"
                    android:layout_width="@dimen/dp_256"
                    android:layout_height="@dimen/dp_40"
                    android:layout_marginTop="@dimen/dp_18"
                    android:layout_marginBottom="@dimen/dp_26"
                    android:textDirection="locale"
                    android:layout_marginStart="@dimen/dp_20"
                    app:sbg_animateSelector="fastOutSlowIn"
                    app:sbg_animateSelectorDuration="1000"
                    app:sbg_backgroundColor="@color/carlights_segcontrolbutton_background"
                    app:sbg_dividerPadding="@dimen/dp_10"
                    app:sbg_dividerRadius="@dimen/dp_10"
                    app:sbg_position="0"
                    app:sbg_radius="@dimen/dp_24"
                    app:sbg_ripple="true"
                    app:sbg_rippleColor="@color/trans_65"
                    app:sbg_selectorGradient_endColor="@color/carsetting_text_color_blue"
                    app:sbg_selectorGradient_startColor="@color/carsetting_text_color_blue2">
                    <com.byd.base.view.segmentedbutton.SegmentedButton
                        android:layout_width="@dimen/dp_128"
                        android:layout_height="@dimen/dp_40"
                        android:textDirection="locale"
                        app:sb_text="@string/vehiclesettings_standard"
                        app:sb_textColor="@color/carlights_guest_color"
                        app:sb_textColor_onSelection="@color/btn_selected_selector"
                        app:sb_textSize="@dimen/dp_20"/>
                    <com.byd.base.view.segmentedbutton.SegmentedButton
                        android:layout_width="@dimen/dp_128"
                        android:layout_height="@dimen/dp_40"
                        android:textDirection="locale"
                        app:sb_text="@string/vehiclesettings_hud_mode_cross_country"
                        app:sb_textColor="@color/carlights_guest_color"
                        app:sb_textColor_onSelection="@color/btn_selected_selector"
                        app:sb_textSize="@dimen/dp_20"/>
                </com.byd.base.view.segmentedbutton.SegmentedButtonGroup>
            </LinearLayout>
            <RelativeLayout
                android:id="@+id/upheader_display_mode_container"
                style="@style/vehicle_setting_right_tv_seg_container_style">
                <TextView
                    android:id="@+id/mode_tv"
                    android:text="@string/vehiclesettings_hud_mode_setting"
                    style="@style/vehicle_setting_right_tv_seg_tv_style"/>
                <com.byd.base.view.segmentedbutton.SegmentedButtonGroup
                    android:id="@+id/uphead_display_mode_sbg"
                    android:visibility="gone"
                    android:layout_below="@+id/mode_tv"
                    style="@style/vehicle_setting_right_tv_seg_seg_style">
                    <com.byd.base.view.segmentedbutton.SegmentedButton
                        app:sb_text="@string/vehiclesettings_hud_classic_mode"
                        style="@style/vehicle_setting_right_tv_seg_seg_btn_style"/>
                    <com.byd.base.view.segmentedbutton.SegmentedButton
                        app:sb_text="@string/vehiclesettings_hud_snow_land_mode"
                        style="@style/vehicle_setting_right_tv_seg_seg_btn_style"/>
                    <com.byd.base.view.segmentedbutton.SegmentedButton
                        app:sb_text="@string/vehiclesettings_hud_desert_mode"
                        style="@style/vehicle_setting_right_tv_seg_seg_btn_style"/>
                </com.byd.base.view.segmentedbutton.SegmentedButtonGroup>
                <com.byd.base.view.segmentedbutton.SegmentedButtonGroup
                    android:id="@+id/uphead_display_mode_sbg_hud"
                    android:visibility="gone"
                    android:layout_below="@+id/mode_tv"
                    style="@style/vehicle_setting_right_tv_seg_seg_style">
                    <com.byd.base.view.segmentedbutton.SegmentedButton
                        app:sb_text="@string/vehiclesettings_hud_classic_mode"
                        style="@style/vehicle_setting_tv_seg_seg_btn_style"/>
                    <com.byd.base.view.segmentedbutton.SegmentedButton
                        app:sb_text="@string/vehiclesettings_hud_snow_land_mode"
                        style="@style/vehicle_setting_tv_seg_seg_btn_style"/>
                </com.byd.base.view.segmentedbutton.SegmentedButtonGroup>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/uphead_display_visible_container"
                android:layout_marginBottom="@dimen/dp_16"
                android:minHeight="@dimen/dp_136"
                style="@style/vehicle_setting_background_container">
                <TextView
                    android:id="@+id/headup_display_lan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/vehiclesettings_hud_optional_display_content"
                    style="@style/carsetting_hud_tv_start_style"/>
                <RadioGroup
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/headup_display_rg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:layout_marginBottom="@dimen/dp_26"
                    android:minHeight="@dimen/dp_40"
                    android:layout_below="@+id/headup_display_lan"
                    android:layout_marginStart="@dimen/dp_24"
                    android:layout_marginEnd="@dimen/dp_24">
                    <CheckBox
                        android:textSize="@dimen/sp_18"
                        android:textColor="@color/btn_selected_selector"
                        android:gravity="center"
                        android:id="@+id/headup_display_drive_help"
                        android:background="@drawable/carsetting_raidobutton_selector"
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="match_parent"
                        android:button="@null"
                        android:text="@string/vehiclesettings_hud_driving_assistance"
                        android:layout_weight="1"
                        android:textDirection="locale"
                        android:paddingStart="@dimen/dp_10"
                        android:paddingEnd="@dimen/dp_10"/>
                    <CheckBox
                        android:textSize="@dimen/sp_18"
                        android:textColor="@color/btn_selected_selector"
                        android:gravity="center"
                        android:id="@+id/headup_display_lead"
                        android:background="@drawable/carsetting_raidobutton_selector"
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="match_parent"
                        android:button="@null"
                        android:text="@string/vehiclesettings_hud_navigation"
                        android:layout_weight="1"
                        android:layout_toRightOf="@+id/carlight_unlock_btn"
                        android:textDirection="locale"
                        android:layout_marginStart="@dimen/dp_24"/>
                </RadioGroup>
            </RelativeLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/setting_part_middle"
                android:layout_marginBottom="@dimen/dp_16"
                style="@style/vehicle_setting_background_container">
                <RelativeLayout
                    android:id="@+id/hud_safe_drive_container"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_88"
                    android:layout_marginTop="@dimen/dp_16">
                    <com.byd.base.view.BydSwitch
                        android:id="@+id/hud_safe_drive_sw"
                        android:checked="false"
                        app:splitTrack="true"
                        app:switchMinWidth="@dimen/dp_56"
                        app:thumbTintMode="src_over"
                        app:track="@color/transparent_00"
                        app:trackTint="@color/transparent_00"
                        style="@style/carsetting_door_and_lock_bydswitch_style"/>
                    <TextView
                        android:text="@string/vehiclesettings_hud_safe_drive_toggle"
                        android:layout_toRightOf="@+id/hud_safe_drive_sw"
                        style="@style/carsetting_door_and_lock_switch_tv_style"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/hud_navigation__container"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_88">
                    <com.byd.base.view.BydSwitch
                        android:id="@+id/hud_navigation_sw"
                        android:checked="false"
                        app:splitTrack="true"
                        app:switchMinWidth="@dimen/dp_56"
                        app:thumbTintMode="src_over"
                        app:track="@color/transparent_00"
                        app:trackTint="@color/transparent_00"
                        style="@style/carsetting_door_and_lock_bydswitch_style"/>
                    <TextView
                        android:text="@string/vehiclesettings_hud_navigation_toggle"
                        android:layout_toRightOf="@+id/hud_navigation_sw"
                        style="@style/carsetting_door_and_lock_switch_tv_style"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/hud_mix_container"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_88">
                    <com.byd.base.view.BydSwitch
                        android:id="@+id/hud_mix_sw"
                        android:checked="false"
                        app:splitTrack="true"
                        app:switchMinWidth="@dimen/dp_56"
                        app:thumbTintMode="src_over"
                        app:track="@color/transparent_00"
                        app:trackTint="@color/transparent_00"
                        style="@style/carsetting_door_and_lock_bydswitch_style"/>
                    <TextView
                        android:text="@string/vehiclesettings_hud_mix_toggle"
                        android:layout_toRightOf="@+id/hud_mix_sw"
                        style="@style/carsetting_door_and_lock_switch_tv_style"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/hud_projection_screen_container"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_88">
                    <com.byd.base.view.BydSwitch
                        android:id="@+id/hud_projection_screen_sw"
                        android:checked="false"
                        app:splitTrack="true"
                        app:switchMinWidth="@dimen/dp_56"
                        app:thumbTintMode="src_over"
                        app:track="@color/transparent_00"
                        app:trackTint="@color/transparent_00"
                        style="@style/carsetting_door_and_lock_bydswitch_style"/>
                    <TextView
                        android:text="@string/vehiclesettings_hud_projection_screentoggle"
                        android:layout_toRightOf="@+id/hud_projection_screen_sw"
                        style="@style/carsetting_door_and_lock_switch_tv_style"/>
                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>
    </com.bydux.api.common.views.window.DampingScrollView>
</LinearLayout>
