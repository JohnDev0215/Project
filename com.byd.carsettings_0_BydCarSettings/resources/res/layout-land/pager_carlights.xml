<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bydux.api.common.views.window.DampingScrollView
        android:id="@+id/nsw"
        style="@style/vehicle_setting_module_damping_scrollView_land_style">
        <LinearLayout
            android:id="@+id/carlight_params_ll"
            style="@style/vehicle_setting_module_damping_scrollView_child_land_style">
            <com.byd.carsettings.ui.widget.InterceptRelativeLayout
                android:id="@+id/car_light_light_toggle_control_container"
                android:layout_marginBottom="@dimen/dp_16"
                style="@style/vehicle_setting_background_container">
                <TextView
                    android:id="@+id/car_light_light_toggle_control_tv"
                    android:text="@string/vehiclesettings_light_control"
                    style="@style/vehicle_setting_tv_seg_tv_style"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/carlight_light_control_display_rv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_18"
                    android:layout_below="@+id/car_light_light_toggle_control_rg"
                    android:overScrollMode="never"
                    android:layout_marginStart="@dimen/dp_24"
                    android:layout_marginEnd="@dimen/dp_24"/>
                <RadioGroup
                    android:orientation="horizontal"
                    android:id="@+id/car_light_light_toggle_control_rg"
                    android:background="@drawable/shape_light_rb_bg_unselected"
                    android:layout_marginTop="@dimen/dp_16"
                    android:minHeight="@dimen/dp_80"
                    android:layout_below="@+id/car_light_light_toggle_control_tv"
                    android:layout_marginStart="@dimen/dp_24"
                    android:layout_marginEnd="@dimen/dp_24"
                    style="@style/vehicle_setting_background_container">
                    <RadioButton
                        android:textSize="@dimen/sp_18"
                        android:textColor="@color/light_text_rb_text_color"
                        android:gravity="center_horizontal"
                        android:id="@+id/light_close"
                        android:background="@drawable/selector_light_rb_bg"
                        android:paddingTop="@dimen/dp_10"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:checked="false"
                        android:button="@null"
                        android:text="@string/vehiclesettings_light_control_light_state_close"
                        android:drawableTop="@drawable/selector_light_rb_close_drawable"
                        android:drawablePadding="@dimen/dp_2"
                        android:layout_weight="1"
                        android:textDirection="locale"/>
                    <RadioButton
                        android:textSize="@dimen/sp_18"
                        android:textColor="@color/light_text_rb_text_color"
                        android:gravity="center_horizontal"
                        android:id="@+id/light_auto"
                        android:background="@drawable/selector_light_rb_bg"
                        android:paddingTop="@dimen/dp_10"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:button="@null"
                        android:text="@string/vehiclesettings_light_control_light_state_Auto"
                        android:drawableTop="@drawable/selector_light_rb_auto_drawable"
                        android:drawablePadding="@dimen/dp_2"
                        android:layout_weight="1"
                        android:textDirection="locale"/>
                    <RadioButton
                        android:textSize="@dimen/sp_18"
                        android:textColor="@color/light_text_rb_text_color"
                        android:gravity="center_horizontal"
                        android:id="@+id/light_small"
                        android:background="@drawable/selector_light_rb_bg"
                        android:paddingTop="@dimen/dp_10"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:button="@null"
                        android:text="@string/vehiclesettings_light_control_light_state_small_light"
                        android:drawableTop="@drawable/selector_light_rb_small_drawable"
                        android:drawablePadding="@dimen/dp_2"
                        android:layout_weight="1"
                        android:textDirection="locale"/>
                    <RadioButton
                        android:textSize="@dimen/sp_18"
                        android:textColor="@color/light_text_rb_text_color"
                        android:gravity="center_horizontal"
                        android:id="@+id/light_near"
                        android:background="@drawable/selector_light_rb_bg"
                        android:paddingTop="@dimen/dp_10"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:button="@null"
                        android:text="@string/vehiclesettings_light_control_light_state_near_light"
                        android:drawableTop="@drawable/selector_light_rb_near_drawable"
                        android:drawablePadding="@dimen/dp_2"
                        android:layout_weight="1"
                        android:textDirection="locale"/>
                </RadioGroup>
            </com.byd.carsettings.ui.widget.InterceptRelativeLayout>
            <RelativeLayout
                android:id="@+id/amb_container"
                style="@style/vehicle_setting_tv_arrow_container_style">
                <TextView
                    android:id="@+id/amb_light"
                    android:text="@string/vehiclesettings_amb_light"
                    android:layout_toStartOf="@+id/amb_light_iv"
                    style="@style/vehicle_setting_tv_arrow_tv_style"/>
                <ImageView
                    android:id="@+id/amb_light_iv"
                    style="@style/vehicle_setting_tv_arrow_arrow_style"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/exlights_daylight_container"
                style="@style/vehicle_setting_tv_sw_icon_container_style">
                <com.byd.base.view.BydSwitch
                    android:id="@+id/carlight_switch"
                    style="@style/vehicle_setting_tv_sw_icon_sw_style"/>
                <TextView
                    android:text="@string/vehiclesettings_day_driving_lighting"
                    android:layout_toEndOf="@+id/carlight_switch"
                    style="@style/vehicle_setting_tv_sw_icon_tv_un_icon_style"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/afs_container"
                style="@style/vehicle_setting_tv_sw_icon_container_style">
                <TextView
                    android:text="@string/vehiclesettings_exlight_intelligent_near_light"
                    android:layout_toEndOf="@+id/light_adapter_switch"
                    style="@style/vehicle_setting_tv_sw_icon_tv_un_icon_style"/>
                <com.byd.base.view.BydSwitch
                    android:id="@+id/light_adapter_switch"
                    style="@style/vehicle_setting_tv_sw_icon_sw_style"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/light_container"
                android:paddingBottom="@dimen/dp_26"
                android:layout_marginBottom="@dimen/dp_16"
                style="@style/vehicle_setting_background_container">
                <RelativeLayout
                    android:id="@+id/headlamp_container"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <RelativeLayout
                        android:id="@+id/light_start_tips_img_rl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_10"
                        android:layout_below="@+id/carlight_main_light_container">
                        <TextView
                            android:textSize="@dimen/sp_20"
                            android:textColor="@color/carsetting_text_color_white"
                            android:id="@+id/light_start_tips_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/vehiclesettings_lamp_height_adjust_5unit"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="@dimen/dp_24"
                            android:layout_alignParentStart="true"/>
                        <ImageView
                            android:id="@+id/light_start_tips_img"
                            android:layout_width="@dimen/dp_32"
                            android:layout_height="@dimen/dp_32"
                            android:src="@drawable/exlight_turn_down"
                            android:layout_marginStart="@dimen/dp_4"
                            android:layout_toEndOf="@+id/light_start_tips_tv"/>
                        <TextView
                            android:textSize="@dimen/sp_20"
                            android:textColor="@color/carsetting_text_color_white"
                            android:id="@+id/light_end_tips__tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/vehiclesettings_lamp_height_adjust_0unit"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="@dimen/dp_24"
                            android:layout_marginEnd="@dimen/dp_4"
                            android:layout_toStartOf="@+id/light_end_tips_img"/>
                        <ImageView
                            android:id="@+id/light_end_tips_img"
                            android:layout_width="@dimen/dp_32"
                            android:layout_height="@dimen/dp_32"
                            android:src="@drawable/exlight_turn_up"
                            android:layout_marginEnd="@dimen/dp_24"
                            android:layout_alignParentEnd="true"/>
                    </RelativeLayout>
                    <SeekBar
                        android:id="@+id/carlight_main_light_sb"
                        android:max="10"
                        android:layout_below="@+id/light_start_tips_img_rl"
                        style="@style/vehicle_setting_seekbar_style"/>
                    <RelativeLayout
                        android:id="@+id/carlight_main_light_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_16">
                        <TextView
                            android:id="@+id/carlight_main_level"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="@dimen/dp_30"
                            android:layout_toEndOf="@+id/carlight_main_light"
                            style="@style/vehicle_setting_seekbar_progress_tv_style_with_container"/>
                        <com.byd.base.view.BydFlexTextView
                            android:id="@+id/carlight_main_light"
                            android:maxWidth="@dimen/dp_350"
                            android:text="@string/vehiclesettings_lamp_height_adjust"
                            android:layout_centerVertical="true"
                            style="@style/vehicle_setting_seekbar_title_tv_style_with_container"/>
                        <ImageView
                            android:id="@+id/carlight_main_light_img"
                            android:layout_width="@dimen/dp_48"
                            android:layout_height="@dimen/dp_48"
                            android:src="@drawable/icon_public_details_48"
                            android:layout_centerVertical="true"
                            android:layout_toEndOf="@+id/carlight_main_light"/>
                    </RelativeLayout>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/back_home_container"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/headlamp_container">
                    <RelativeLayout
                        android:id="@+id/carlight_home_light_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_26">
                        <TextView
                            android:id="@+id/carlight_home_light"
                            android:text="@string/vehiclesettings_back_home_delay_time_title"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="@dimen/dp_16"
                            android:layout_toStartOf="@+id/carlight_home_level"
                            style="@style/vehicle_setting_seekbar_title_tv_style_with_container"/>
                        <TextView
                            android:id="@+id/carlight_home_level"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            style="@style/vehicle_setting_seekbar_progress_tv_style_with_container"/>
                    </RelativeLayout>
                    <SeekBar
                        android:id="@+id/carlight_home_light_sb"
                        android:layout_marginTop="@dimen/dp_16"
                        android:max="6"
                        android:layout_below="@+id/carlight_home_light_container"
                        style="@style/vehicle_setting_seekbar_style"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/leave_home_container"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/back_home_container">
                    <RelativeLayout
                        android:id="@+id/carlight_leave_light_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_26">
                        <TextView
                            android:id="@+id/carlight_leave_light"
                            android:text="@string/vehiclesettings_leave_home_delay_time_title"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="@dimen/dp_16"
                            android:layout_toStartOf="@+id/carlight_leave_level"
                            style="@style/vehicle_setting_seekbar_title_tv_style_with_container"/>
                        <TextView
                            android:id="@+id/carlight_leave_level"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            style="@style/vehicle_setting_seekbar_progress_tv_style_with_container"/>
                    </RelativeLayout>
                    <SeekBar
                        android:id="@+id/carlight_leave_light_sb"
                        android:layout_marginTop="@dimen/dp_16"
                        android:max="6"
                        android:layout_below="@+id/carlight_leave_light_container"
                        style="@style/vehicle_setting_seekbar_style"/>
                </RelativeLayout>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/vehicle_lamp_signal_container"
                style="@style/vehicle_setting_background_with_param_container">
                <RelativeLayout
                    android:id="@+id/carlight_rg_container"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <RadioGroup
                        android:orientation="horizontal"
                        android:id="@+id/carlight_rg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_16"
                        android:layout_marginBottom="@dimen/dp_12"
                        android:minHeight="@dimen/dp_40"
                        android:layout_below="@+id/carlight_light_lan"
                        android:layout_marginStart="@dimen/dp_24"
                        android:layout_marginEnd="@dimen/dp_24">
                        <com.byd.base.view.BydRadioButton
                            android:textSize="@dimen/sp_18"
                            android:textColor="@color/btn_selected_selector"
                            android:gravity="center"
                            android:id="@+id/carlight_unlock_btn"
                            android:background="@drawable/carsetting_raidobutton_selector"
                            android:paddingTop="@dimen/dp_4"
                            android:paddingBottom="@dimen/dp_4"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:checked="false"
                            android:button="@null"
                            android:text="@string/vehiclesettings_unlock_welcome"
                            android:layout_weight="1"
                            android:paddingStart="@dimen/dp_4"
                            android:paddingEnd="@dimen/dp_4"
                            app:cal_height_strings_list="@array/cal_height_list"/>
                        <com.byd.base.view.BydRadioButton
                            android:textSize="@dimen/sp_18"
                            android:textColor="@color/btn_selected_selector"
                            android:gravity="center"
                            android:id="@+id/carlight_lock_btn"
                            android:background="@drawable/carsetting_raidobutton_selector"
                            android:paddingTop="@dimen/dp_4"
                            android:paddingBottom="@dimen/dp_4"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:button="@null"
                            android:text="@string/vehiclesettings_lock_welcome"
                            android:layout_weight="1"
                            android:paddingStart="@dimen/dp_4"
                            android:paddingEnd="@dimen/dp_4"
                            android:layout_marginStart="@dimen/dp_16"
                            android:layout_toEndOf="@+id/carlight_unlock_btn"
                            app:cal_height_strings_list="@array/cal_height_list"/>
                    </RadioGroup>
                    <TextView
                        android:id="@+id/carlight_light_lan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_18"
                        android:text="@string/vehiclesettings_lantern_language"
                        style="@style/carsetting_carlight_tv_start_style"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/welcome_container"
                    android:layout_below="@+id/carlight_rg_container"
                    style="@style/vehicle_setting_tv_sw_icon_container_un_single_style">
                    <TextView
                        android:text="@string/vehiclesettings_smart_welcome_guest"
                        android:layout_toEndOf="@+id/carlight_guest_switch"
                        style="@style/vehicle_setting_tv_sw_icon_tv_un_icon_style"/>
                    <com.byd.base.view.BydSwitch
                        android:id="@+id/carlight_guest_switch"
                        style="@style/vehicle_setting_tv_sw_icon_sw_style"/>
                </RelativeLayout>
            </RelativeLayout>
        </LinearLayout>
    </com.bydux.api.common.views.window.DampingScrollView>
    <ImageView
        android:id="@+id/carlight_image"
        style="@style/vehicle_setting_car_image_land_style"/>
</LinearLayout>
