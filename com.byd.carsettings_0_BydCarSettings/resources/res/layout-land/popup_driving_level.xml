<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@drawable/bg_popup_driving_level"
    android:layout_width="@dimen/dp_240"
    android:layout_height="@dimen/dp_300">
    <com.byd.carsettings.ui.view.seekbar.VerticalSeekBar
        android:id="@+id/vs_driving_level"
        android:layout_width="@dimen/dp_12"
        android:layout_height="@dimen/dp_244"
        android:layout_marginStart="@dimen/dp_26"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:vsb_areaCount="4"
        app:vsb_background="@color/vertical_seekbar_bg"
        app:vsb_progressBackground="@color/btn_open_bg_blue"
        app:vsb_progressRadius="@dimen/dp_3"
        app:vsb_progressWidth="@dimen/dp_6"
        app:vsb_scaleRadius="@dimen/dp_5"
        app:vsb_scaleSelectBackground="@color/btn_open_bg_blue"
        app:vsb_scaleUnSelectBackground="@color/vertical_seekbar_bg"
        app:vsb_scaleWidth="@dimen/dp_10"
        app:vsb_thumbBackground="@color/btn_open_bg_blue"
        app:vsb_thumbRadius="@dimen/dp_6"
        app:vsb_thumbWidth="@dimen/dp_12"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_driving_level1_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_2"
        android:layout_marginStart="@dimen/dp_16"
        app:layout_constraintStart_toEndOf="@+id/vs_driving_level"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:src="@drawable/icon_dark_level_2_48"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/dialog_text_color_main"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/dp_110"
            android:text="@string/dipilot_ditrainer_dialog_driving_level1"
            android:layout_marginStart="@dimen/dp_8"/>
    </LinearLayout>
    <View
        android:id="@+id/divider1"
        android:background="@color/dialog_text_color_tips"
        android:layout_width="@dimen/dp_170"
        android:layout_height="@dimen/dp_1"
        app:layout_constraintStart_toStartOf="@+id/ll_driving_level1_container"
        app:layout_constraintTop_toBottomOf="@+id/ll_driving_level1_container"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_driving_level2_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginStart="@dimen/dp_16"
        app:layout_constraintStart_toEndOf="@+id/vs_driving_level"
        app:layout_constraintTop_toBottomOf="@+id/ll_driving_level1_container">
        <ImageView
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:src="@drawable/icon_dark_level_2_48"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/dialog_text_color_main"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/dp_110"
            android:text="@string/dipilot_ditrainer_dialog_driving_level2"
            android:layout_marginStart="@dimen/dp_8"/>
    </LinearLayout>
    <View
        android:id="@+id/divider2"
        android:background="@color/dialog_text_color_tips"
        android:layout_width="@dimen/dp_170"
        android:layout_height="@dimen/dp_1"
        app:layout_constraintStart_toStartOf="@+id/ll_driving_level2_container"
        app:layout_constraintTop_toBottomOf="@+id/ll_driving_level2_container"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_driving_level3_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginStart="@dimen/dp_16"
        app:layout_constraintStart_toEndOf="@+id/vs_driving_level"
        app:layout_constraintTop_toBottomOf="@+id/ll_driving_level2_container">
        <ImageView
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:src="@drawable/icon_dark_level_3_48"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/dialog_text_color_main"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/dp_110"
            android:text="@string/dipilot_ditrainer_dialog_driving_level3"
            android:layout_marginStart="@dimen/dp_8"/>
    </LinearLayout>
    <View
        android:id="@+id/divider3"
        android:background="@color/dialog_text_color_tips"
        android:layout_width="@dimen/dp_170"
        android:layout_height="@dimen/dp_1"
        app:layout_constraintStart_toStartOf="@+id/ll_driving_level3_container"
        app:layout_constraintTop_toBottomOf="@+id/ll_driving_level3_container"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_driving_level4_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginStart="@dimen/dp_16"
        app:layout_constraintStart_toEndOf="@+id/vs_driving_level"
        app:layout_constraintTop_toBottomOf="@+id/ll_driving_level3_container">
        <ImageView
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:src="@drawable/icon_dark_level_4_48"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/dialog_text_color_main"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/dp_110"
            android:text="@string/dipilot_ditrainer_dialog_driving_level4"
            android:layout_marginStart="@dimen/dp_8"/>
    </LinearLayout>
    <View
        android:id="@+id/divider4"
        android:background="@color/dialog_text_color_tips"
        android:layout_width="@dimen/dp_170"
        android:layout_height="@dimen/dp_1"
        app:layout_constraintStart_toStartOf="@+id/ll_driving_level4_container"
        app:layout_constraintTop_toBottomOf="@+id/ll_driving_level4_container"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_driving_level5_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginStart="@dimen/dp_16"
        app:layout_constraintStart_toEndOf="@+id/vs_driving_level"
        app:layout_constraintTop_toBottomOf="@+id/ll_driving_level4_container">
        <ImageView
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:src="@drawable/icon_dark_level_5_48"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/dialog_text_color_main"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/dp_110"
            android:text="@string/dipilot_ditrainer_dialog_driving_level5"
            android:layout_marginStart="@dimen/dp_8"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
