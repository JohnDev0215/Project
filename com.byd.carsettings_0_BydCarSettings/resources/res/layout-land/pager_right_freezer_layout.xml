<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/freezer_car_image"
        style="@style/vehicle_setting_car_image_land_style"/>
    <com.bydux.api.common.views.window.DampingScrollView
        android:id="@+id/nsw"
        style="@style/vehicle_setting_right_module_damping_scrollView_land_style">
        <LinearLayout
            android:id="@+id/carlight_params_ll"
            style="@style/vehicle_setting_right_module_damping_scrollView_child_land_style">
            <com.byd.base.view.BydRelativeLayout
                android:id="@+id/freezer_door_container"
                style="@style/vehicle_setting_right_tv_sw_icon_container_style">
                <com.byd.base.view.BydSwitch
                    android:id="@+id/freezer_door_switch"
                    style="@style/vehicle_setting_right_tv_sw_icon_sw_style"/>
                <TextView
                    android:text="@string/vehiclesettings_compression_refrigerator_door_state"
                    style="@style/vehicle_setting_right_tv_sw_icon_tv_un_icon_style"/>
            </com.byd.base.view.BydRelativeLayout>
            <com.byd.base.view.BydRelativeLayout
                android:id="@+id/freezer_work_and_temperature_state_container"
                android:paddingBottom="@dimen/dp_26"
                android:layout_marginBottom="@dimen/dp_16"
                style="@style/vehicle_setting_background_container">
                <com.byd.base.view.BydRelativeLayout
                    android:id="@+id/freezer_work_sate_container"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dp_26">
                    <com.byd.base.view.BydFlexTextView
                        android:id="@+id/freezer_work_sate_tv"
                        android:text="@string/vehiclesettings_compression_refrigerator_work_state"
                        style="@style/vehicle_setting_right_seekbar_title_tv_style"/>
                    <com.byd.base.view.segmentedbutton.SegmentedButtonGroup
                        android:id="@+id/freezer_work_state_seg"
                        android:layout_below="@+id/freezer_work_sate_tv"
                        style="@style/vehicle_setting_right_tv_seg_seg_style">
                        <com.byd.base.view.segmentedbutton.SegmentedButton
                            android:id="@+id/close"
                            app:sb_text="@string/vehiclesettings_close"
                            style="@style/vehicle_setting_right_tv_seg_seg_btn_style"/>
                        <com.byd.base.view.segmentedbutton.SegmentedButton
                            android:id="@+id/cold"
                            app:sb_text="@string/vehiclesettings_diba_refrigerator_refrigeration"
                            style="@style/vehicle_setting_right_tv_seg_seg_btn_style"/>
                        <com.byd.base.view.segmentedbutton.SegmentedButton
                            android:id="@+id/warm"
                            app:sb_text="@string/vehiclesettings_compression_refrigerator_work_heart"
                            style="@style/vehicle_setting_right_tv_seg_seg_btn_style"/>
                        <com.byd.base.view.segmentedbutton.SegmentedButton
                            android:id="@+id/save"
                            app:sb_text="@string/vehiclesettings_compression_refrigerator_work_save"
                            style="@style/vehicle_setting_right_tv_seg_seg_btn_style"/>
                    </com.byd.base.view.segmentedbutton.SegmentedButtonGroup>
                </com.byd.base.view.BydRelativeLayout>
                <com.byd.base.view.BydRelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/freezer_work_sate_container">
                    <com.byd.base.view.BydRelativeLayout
                        android:id="@+id/freezer_temperature_turn_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.byd.base.view.BydRelativeLayout
                            android:id="@+id/freezer_temperature_turn_title_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:id="@+id/freezer_temperature_tv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/dp_30"
                                android:layout_toEndOf="@+id/freezer_temperature_turn_title"
                                style="@style/vehicle_setting_right_seekbar_progress_tv_style"/>
                            <com.byd.base.view.BydFlexTextView
                                android:id="@+id/freezer_temperature_turn_title"
                                android:text="@string/vehiclesettings_compression_refrigerator_work_temperature_turn"
                                style="@style/vehicle_setting_right_seekbar_title_tv_style"/>
                        </com.byd.base.view.BydRelativeLayout>
                        <SeekBar
                            android:id="@+id/freezer_temperature_turn_sb"
                            android:layout_marginTop="@dimen/dp_8"
                            android:max="10"
                            android:layout_below="@+id/freezer_temperature_turn_title_container"
                            style="@style/vehicle_setting_right_seekbar_style"/>
                        <com.byd.base.view.BydRelativeLayout
                            android:id="@+id/freezer_temperature_turn_title_area_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/freezer_temperature_turn_sb">
                            <TextView
                                android:id="@+id/freezer_temperature_right_tv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/dp_30"
                                android:layout_toEndOf="@+id/freezer_temperature_left_tv"
                                style="@style/vehicle_setting_right_seekbar_progress_tv_style"/>
                            <com.byd.base.view.BydFlexTextView
                                android:id="@+id/freezer_temperature_left_tv"
                                android:text="@string/vehiclesettings_placehodler"
                                style="@style/vehicle_setting_right_seekbar_title_tv_style"/>
                        </com.byd.base.view.BydRelativeLayout>
                    </com.byd.base.view.BydRelativeLayout>
                </com.byd.base.view.BydRelativeLayout>
            </com.byd.base.view.BydRelativeLayout>
            <com.byd.base.view.BydRelativeLayout
                android:id="@+id/freezer_power_off_delay_container"
                style="@style/vehicle_setting_right_tv_sw_icon_container_style">
                <com.byd.base.view.BydFlexTextView
                    android:id="@+id/freezer_power_off_delay_tv"
                    android:text="@string/vehiclesettings_compression_refrigerator_work_delay_power_off"
                    style="@style/vehicle_setting_right_tv_sw_icon_tv_land_style"/>
                <com.byd.base.view.BydSwitch
                    android:id="@+id/freezer_power_off_delay_sw"
                    style="@style/vehicle_setting_right_tv_sw_icon_sw_style"/>
            </com.byd.base.view.BydRelativeLayout>
            <com.byd.base.view.BydRelativeLayout
                android:id="@+id/freezer_power_off_delay_set_container"
                style="@style/vehicle_setting_right_tv_sw_icon_container_style">
                <ImageView
                    android:id="@+id/freezer_power_off_delay_iv"
                    android:layout_toEndOf="@+id/freezer_power_off_delay_set_tv"
                    style="@style/vehicle_setting_right_tv_sw_icon_icon_style"/>
                <com.byd.base.view.BydFlexTextView
                    android:id="@+id/freezer_power_off_delay_set_tv"
                    android:text="@string/vehiclesettings_compression_refrigerator_work_delay_power_off_set"
                    android:layout_marginStart="@dimen/dp_24"
                    style="@style/vehicle_setting_right_tv_sw_icon_tv_land_style"/>
                <TextView
                    android:textSize="@dimen/dp_20"
                    android:textColor="@color/text_color_gray"
                    android:id="@+id/freezer_power_off_delay_time_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@+id/freezer_power_off_delay_time_iv"/>
                <ImageView
                    android:id="@+id/freezer_power_off_delay_time_iv"
                    style="@style/vehicle_setting_right_tv_arrow_arrow_style"/>
            </com.byd.base.view.BydRelativeLayout>
            <com.byd.base.view.BydRelativeLayout
                android:id="@+id/freezer_power_remember_container"
                style="@style/vehicle_setting_right_tv_sw_icon_container_style">
                <ImageView
                    android:id="@+id/freezer_power_remember_icon"
                    android:layout_toEndOf="@+id/freezer_power_remember_tv"
                    style="@style/vehicle_setting_right_tv_sw_icon_icon_style"/>
                <com.byd.base.view.BydFlexTextView
                    android:id="@+id/freezer_power_remember_tv"
                    android:text="@string/vehiclesettings_diba_pdm"
                    style="@style/vehicle_setting_right_tv_sw_icon_tv_land_style"/>
                <com.byd.base.view.BydSwitch
                    android:id="@+id/freezer_power_remember_sw"
                    style="@style/vehicle_setting_right_tv_sw_icon_sw_style"/>
            </com.byd.base.view.BydRelativeLayout>
            <com.byd.base.view.BydRelativeLayout
                android:id="@+id/freezer_sterilization_and_disinfection_container"
                style="@style/vehicle_setting_right_tv_sw_icon_container_style">
                <com.byd.base.view.BydSwitch
                    android:id="@+id/freezer_sterilization_and_disinfection_sw"
                    style="@style/vehicle_setting_right_tv_sw_icon_sw_style"/>
                <com.byd.base.view.BydRelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@+id/freezer_sterilization_and_disinfection_sw">
                    <TextView
                        android:id="@+id/freezer_sterilization_and_disinfection_title_tv"
                        android:text="@string/vehiclesettings_compression_refrigerator_in_sterilization"
                        android:layout_centerVertical="false"
                        style="@style/vehicle_setting_right_tv_sw_icon_tv_un_icon_style"/>
                    <TextView
                        android:id="@+id/freezer_sterilization_and_disinfection_center_tv"
                        android:visibility="gone"
                        android:text="@string/vehiclesettings_diba_disinfectings"
                        android:layout_centerVertical="false"
                        style="@style/vehicle_setting_right_tv_sw_icon_tv_un_icon_style"/>
                    <TextView
                        android:textSize="@dimen/dp_16"
                        android:textColor="@color/text_color_gray_bt"
                        android:id="@+id/freezer_sterilization_and_disinfection_tip_tv"
                        android:text="@string/vehiclesettings_compression_refrigerator_in_sterilization_done"
                        android:layout_below="@+id/freezer_sterilization_and_disinfection_title_tv"
                        android:layout_centerVertical="false"
                        style="@style/vehicle_setting_right_tv_sw_icon_tv_un_icon_style"/>
                </com.byd.base.view.BydRelativeLayout>
            </com.byd.base.view.BydRelativeLayout>
            <com.byd.base.view.BydRelativeLayout
                android:id="@+id/freezer_child_lock_container"
                style="@style/vehicle_setting_right_tv_sw_icon_container_style">
                <ImageView
                    android:id="@+id/freezer_child_lock_iv"
                    android:layout_toEndOf="@+id/freezer_child_lock_tv"
                    style="@style/vehicle_setting_right_tv_sw_icon_icon_style"/>
                <com.byd.base.view.BydFlexTextView
                    android:id="@+id/freezer_child_lock_tv"
                    android:text="@string/vehiclesettings_compression_refrigerator_child_lock"
                    style="@style/vehicle_setting_right_tv_sw_icon_tv_land_style"/>
                <com.byd.base.view.BydSwitch
                    android:id="@+id/freezer_child_lock_sw"
                    style="@style/vehicle_setting_right_tv_sw_icon_sw_style"/>
            </com.byd.base.view.BydRelativeLayout>
        </LinearLayout>
    </com.bydux.api.common.views.window.DampingScrollView>
</LinearLayout>
