                android:id="@+id/ll_memory"
                android:background="@drawable/carlights_background"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/dp_24"
                android:paddingEnd="@dimen/dp_24">
                <LinearLayout
                    android:gravity="start|center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/ll_sport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_20"
                    android:layout_marginBottom="@dimen/dp_20">
                    <com.byd.base.view.BydSwitch
                        android:id="@+id/switch_sport"
                        app:intercept="true"
                        app:splitTrack="true"
                        app:switchMinWidth="@dimen/dp_56"
                        app:thumbTintMode="src_over"
                        app:track="?attr/transparent_00"
                        app:trackTint="?attr/transparent_00"
                        style="@style/bydswitch_style"/>
                    <TextView
                        android:textSize="@dimen/sp_20"
                        android:textColor="?attr/text_color_main"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/newenergy_memory_mode_sport"
                        android:layout_marginStart="@dimen/dp_16"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="start|center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/ll_maxev"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_20"
                    android:layout_marginBottom="@dimen/dp_20">
                    <com.byd.base.view.BydSwitch
                        android:id="@+id/switch_ev"
                        app:intercept="true"
                        app:splitTrack="true"
                        app:switchMinWidth="@dimen/dp_56"
                        app:thumbTintMode="src_over"
                        app:track="?attr/transparent_00"
                        app:trackTint="?attr/transparent_00"
                        style="@style/bydswitch_style"/>
                    <TextView
                        android:textSize="@dimen/sp_20"
                        android:textColor="?attr/text_color_main"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/newenergy_memory_mode_max_ev"
