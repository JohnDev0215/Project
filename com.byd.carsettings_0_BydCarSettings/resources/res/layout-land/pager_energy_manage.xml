                    app:sbg_backgroundColor="@color/carlights_segcontrolbutton_background"
                    app:sbg_dividerPadding="@dimen/dp_10"
                    app:sbg_dividerRadius="@dimen/dp_10"
                    app:sbg_position="0"
                    app:sbg_radius="@dimen/dp_24"
                    app:sbg_ripple="true"
                    app:sbg_selectorGradient_endColor="?attr/carsetting_text_color_blue"
                    app:sbg_selectorGradient_startColor="?attr/carsetting_text_color_blue2">
                    <com.byd.base.view.segmentedbutton.SegmentedButton
                        android:layout_width="0dp"
                        android:layout_height="@dimen/dp_40"
                        android:layout_weight="1"
                        app:sb_text="@string/newenergy_energy_recycle_standard"
                        app:sb_textColor="?attr/carlights_guest_color"
                        app:sb_textColor_onSelection="?attr/byd_button_selected_text_color"
                        app:sb_textSize="@dimen/dp_20"/>
                    <com.byd.base.view.segmentedbutton.SegmentedButton
                        android:layout_width="0dp"
                        android:layout_height="@dimen/dp_40"
                        android:layout_weight="1"
                        app:sb_text="@string/newenergy_energy_recycle_larger"
                        app:sb_textColor="?attr/carlights_guest_color"
                        app:sb_textColor_onSelection="?attr/byd_button_selected_text_color"
                        app:sb_textSize="@dimen/dp_20"/>
                </com.byd.base.view.segmentedbutton.SegmentedButtonGroup>
                <com.byd.base.view.segmentedbutton.SegmentedButtonGroup
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/switch_feedback_strength2"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_40"
                    android:layout_marginTop="@dimen/dp_16"
                    app:sbg_animateSelector="fastOutSlowIn"
                    app:sbg_animateSelectorDuration="1000"
                    app:sbg_backgroundColor="@color/carlights_segcontrolbutton_background"
                    app:sbg_dividerPadding="@dimen/dp_10"
                    app:sbg_dividerRadius="@dimen/dp_10"
                    app:sbg_position="0"
                    app:sbg_radius="@dimen/dp_24"
                    app:sbg_ripple="true"
                    app:sbg_selectorGradient_endColor="?attr/carsetting_text_color_blue"
                    app:sbg_selectorGradient_startColor="?attr/carsetting_text_color_blue2">
                    <com.byd.base.view.segmentedbutton.SegmentedButton
                        android:layout_width="0dp"
                        android:layout_height="@dimen/dp_40"
                        android:layout_weight="1"
                        app:sb_text="@string/newenergy_energy_recycle_standard"
                        app:sb_textColor="?attr/carlights_guest_color"
                        app:sb_textColor_onSelection="?attr/byd_button_selected_text_color"
                        app:sb_textSize="@dimen/dp_20"/>
                    <com.byd.base.view.segmentedbutton.SegmentedButton
                        android:layout_width="0dp"
                        android:layout_height="@dimen/dp_40"
                        android:layout_weight="1"
                        app:sb_text="@string/newenergy_energy_recycle_larger"
                        app:sb_textColor="?attr/carlights_guest_color"
                        app:sb_textColor_onSelection="?attr/byd_button_selected_text_color"
                        app:sb_textSize="@dimen/dp_20"/>
                    <com.byd.base.view.segmentedbutton.SegmentedButton
                        android:layout_width="0dp"
                        android:layout_height="@dimen/dp_40"
                        android:layout_weight="1"
                        app:sb_text="@string/newenergy_energy_recycle_super_larger"
                        app:sb_textColor="?attr/carlights_guest_color"
                        app:sb_textColor_onSelection="?attr/byd_button_selected_text_color"
                        app:sb_textSize="@dimen/dp_20"/>
                </com.byd.base.view.segmentedbutton.SegmentedButtonGroup>
                <TextView
                    android:textSize="@dimen/sp_20"
                    android:textColor="?attr/text_color_main"
                    android:id="@+id/tv_display_mode"
                    android:paddingTop="@dimen/dp_28"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/newenergy_energy_display_type_title"/>
                <com.byd.base.view.segmentedbutton.SegmentedButtonGroup
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/switch_display_mode"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    app:sbg_animateSelector="fastOutSlowIn"
                    app:sbg_animateSelectorDuration="1000"
                    app:sbg_backgroundColor="?attr/carlights_segcontrolbutton_background"
                    app:sbg_dividerPadding="@dimen/dp_10"
                    app:sbg_dividerRadius="@dimen/dp_10"
                    app:sbg_position="0"
                    app:sbg_radius="@dimen/dp_24"
                    app:sbg_ripple="true"
                    app:sbg_selectorGradient_endColor="?attr/carsetting_text_color_blue"
                    app:sbg_selectorGradient_startColor="?attr/carsetting_text_color_blue2">
                    <com.byd.base.view.segmentedbutton.SegmentedButton
                        android:paddingTop="@dimen/dp_3"
                        android:paddingBottom="@dimen/dp_3"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:minHeight="@dimen/dp_40"
                        android:layout_weight="1"
                        android:paddingStart="@dimen/dp_2"
                        android:paddingEnd="@dimen/dp_2"
                        app:sb_text="@string/newenergy_distance"
                        app:sb_textColor="?attr/carlights_guest_color"
                        app:sb_textColor_onSelection="?attr/byd_button_selected_text_color"
                        app:sb_textSize="@dimen/dp_20"/>
                    <com.byd.base.view.segmentedbutton.SegmentedButton
                        android:paddingTop="@dimen/dp_3"
                        android:paddingBottom="@dimen/dp_3"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:minHeight="@dimen/dp_40"
                        android:layout_weight="1"
                        android:paddingStart="@dimen/dp_2"
                        android:paddingEnd="@dimen/dp_2"
                        app:sb_text="@string/newenergy_energy"
                        app:sb_textColor="?attr/carlights_guest_color"
                        app:sb_textColor_onSelection="?attr/byd_button_selected_text_color"
                        app:sb_textSize="@dimen/dp_20"/>
                </com.byd.base.view.segmentedbutton.SegmentedButtonGroup>
                <TextView
                    android:textSize="@dimen/sp_20"
                    android:textColor="?attr/text_color_main"
                    android:id="@+id/tv_cruising_range_mode"
                    android:paddingTop="@dimen/dp_28"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/newenergy_ev_mileage_display_mode"/>
                <com.byd.base.view.segmentedbutton.SegmentedButtonGroup
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/switch_cruising_range_mode"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_40"
                    android:layout_marginTop="@dimen/dp_16"
                    android:elevation="@dimen/dp_0"
                    app:sbg_animateSelector="fastOutSlowIn"
                    app:sbg_animateSelectorDuration="1000"
                    app:sbg_backgroundColor="?attr/carlights_segcontrolbutton_background"
                    app:sbg_dividerPadding="@dimen/dp_10"
                    app:sbg_dividerRadius="@dimen/dp_10"
                    app:sbg_position="0"
                    app:sbg_radius="@dimen/dp_24"
                    app:sbg_ripple="true"
                    app:sbg_selectorGradient_endColor="?attr/carsetting_text_color_blue"
                    app:sbg_selectorGradient_startColor="?attr/carsetting_text_color_blue2">
                    <com.byd.base.view.segmentedbutton.SegmentedButton
                        android:layout_width="0dp"
                        android:layout_height="@dimen/dp_40"
                        android:layout_weight="1"
                        app:sb_text="@string/newenergy_ev_mileage_display_mode_standard"
                        app:sb_textColor="?attr/carlights_guest_color"
                        app:sb_textColor_onSelection="?attr/byd_button_selected_text_color"
                        app:sb_textSize="@dimen/dp_20"/>
                    <com.byd.base.view.segmentedbutton.SegmentedButton
                        android:layout_width="0dp"
                        android:layout_height="@dimen/dp_40"
                        android:layout_weight="1"
                        app:sb_text="@string/newenergy_ev_mileage_display_mode_dynamic"
                        app:sb_textColor="?attr/carlights_guest_color"
                        app:sb_textColor_onSelection="?attr/byd_button_selected_text_color"
                        app:sb_textSize="@dimen/dp_20"/>
                </com.byd.base.view.segmentedbutton.SegmentedButtonGroup>
                <LinearLayout
                    android:gravity="start|center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/ll_cruising_range_standard"
                    android:paddingTop="@dimen/dp_18"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/sp_20"
                        android:textColor="?attr/text_color_main"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="@dimen/dp_372"
                        android:text="@string/newenergy_ev_mileage_display_standard"/>
                    <ImageView
                        android:id="@+id/iv_cruising_hint"
                        android:layout_width="@dimen/dp_48"
                        android:layout_height="@dimen/dp_48"
                        android:src="@drawable/icon_light_public_details_48"/>
                </LinearLayout>
                <com.byd.base.view.segmentedbutton.SegmentedButtonGroup
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/switch_cruising_range_standard"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_40"
                    android:layout_marginTop="@dimen/dp_6"
                    app:sbg_animateSelector="fastOutSlowIn"
                    app:sbg_animateSelectorDuration="1000"
                    app:sbg_backgroundColor="?attr/carlights_segcontrolbutton_background"
                    app:sbg_dividerPadding="@dimen/dp_10"
                    app:sbg_dividerRadius="@dimen/dp_10"
                    app:sbg_position="0"
                    app:sbg_radius="@dimen/dp_24"
                    app:sbg_ripple="true"
                    app:sbg_selectorGradient_endColor="?attr/carsetting_text_color_blue"
                    app:sbg_selectorGradient_startColor="?attr/carsetting_text_color_blue2">
                    <com.byd.base.view.segmentedbutton.SegmentedButton
                        android:layout_width="0dp"
                        android:layout_height="@dimen/dp_40"
                        android:layout_weight="1"
                        app:sb_text="@string/newenergy_ev_mileage_display_standard_cltc_standard"
                        app:sb_textColor="?attr/carlights_guest_color"
                        app:sb_textColor_onSelection="?attr/byd_button_selected_text_color"
                        app:sb_textSize="@dimen/dp_20"/>
                    <com.byd.base.view.segmentedbutton.SegmentedButton
                        android:layout_width="0dp"
                        android:layout_height="@dimen/dp_40"
                        android:layout_weight="1"
                        app:sb_text="@string/newenergy_ev_mileage_display_standard_nedc_standard"
                        app:sb_textColor="?attr/carlights_guest_color"
                        app:sb_textColor_onSelection="?attr/byd_button_selected_text_color"
                        app:sb_textSize="@dimen/dp_20"/>
                </com.byd.base.view.segmentedbutton.SegmentedButtonGroup>
            </LinearLayout>
            <LinearLayout
