<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="@dimen/dp_580.5"
        android:layout_height="match_parent"
        android:layout_alignParentRight="true">
        <LinearLayout
            android:gravity="start|center_vertical"
            android:id="@+id/ll_keepbattery"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_24"
            android:layout_marginTop="@dimen/dp_73"
            android:layout_centerHorizontal="true">
            <ImageView
                android:id="@+id/iv_keepbattery"
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_24"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="?attr/text_color_main"
                android:gravity="center"
                android:id="@+id/tv_keepbattery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_5"/>
        </LinearLayout>
        <com.byd.carsettings.ui.widget.viewanim.EnergyAnimView
            android:id="@+id/energyAnimView"
            android:layout_width="@dimen/dp_580.5"
            android:layout_height="@dimen/dp_513"
            android:layout_centerVertical="true"/>
        <TextView
            android:id="@+id/tv_test_msg"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="50dp"/>
        <Button
            android:id="@+id/btn_test_config"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="车型加1"
            android:layout_below="@+id/tv_test_msg"/>
        <Button
            android:id="@+id/btn_test_status"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="状态加1"
            android:layout_below="@+id/btn_test_config"/>
        <Button
            android:id="@+id/btn_test_show"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="展示"
            android:layout_below="@+id/btn_test_status"/>
    </RelativeLayout>
