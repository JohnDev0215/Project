        android:fadingEdge="vertical"
        android:fadingEdgeLength="@dimen/dp_24"
        android:layout_width="@dimen/dp_468"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dp_6"
        android:layout_alignParentLeft="true"
        android:requiresFadingEdge="vertical">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="@dimen/dp_16"
            android:paddingBottom="@dimen/dp_16"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_soc"
                android:background="@drawable/carlights_background"
                android:paddingTop="@dimen/dp_20"
                android:paddingBottom="@dimen/dp_20"
                android:visibility="gone"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_16">
                <LinearLayout
                    android:gravity="start|center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_48"
                    android:paddingStart="@dimen/dp_24"
                    android:paddingEnd="@dimen/dp_24">
                    <com.byd.base.view.BydSwitch
                        android:id="@+id/switch_soc"
                        app:intercept="true"
                        app:splitTrack="true"
                        app:switchMinWidth="@dimen/dp_56"
                        app:thumbTintMode="src_over"
                        app:track="?attr/transparent_00"
                        app:trackTint="?attr/transparent_00"
                        style="@style/bydswitch_style"/>
                    <TextView
                        android:textSize="@dimen/sp_20"
                        android:textColor="?attr/text_color_main"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/newenergy_power_protect_force"
                        android:layout_marginStart="@dimen/dp_16"/>
                    <ImageView
                        android:id="@+id/iv_soc_hint"
                        android:layout_width="@dimen/dp_48"
                        android:layout_height="@dimen/dp_48"
                        android:src="@drawable/icon_light_public_details_48"/>
                </LinearLayout>
                <RelativeLayout
                    android:id="@+id/rl_soc_seekbar"
                    android:clipChildren="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/sp_20"
                        android:textColor="?attr/text_color_main"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/newenergy_soc_target_elec"
                        android:paddingStart="@dimen/dp_24"/>
                    <TextView
                        android:textSize="@dimen/sp_20"
                        android:textColor="?attr/text_color_main"
                        android:id="@+id/tv_soc_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingEnd="@dimen/dp_24"
                        android:layout_alignParentEnd="true"/>
                    <com.byd.carsettings.ui.view.seekbar.SocSeekbar
                        android:id="@+id/seekbar_soc"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_40"
                        android:layout_marginTop="@dimen/dp_14"
                        android:layout_below="@+id/tv_soc_value"/>
                    <TextView
                        android:textSize="@dimen/sp_20"
                        android:textColor="@color/text_color_main_gray"
                        android:id="@+id/tv_soc_start"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/seekbar_soc"
                        android:paddingStart="@dimen/dp_24"
                        android:layout_alignParentStart="true"/>
                    <TextView
                        android:textSize="@dimen/sp_20"
                        android:textColor="?attr/text_color_main_gray"
                        android:id="@+id/tv_soc_end"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/seekbar_soc"
                        android:paddingEnd="@dimen/dp_24"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
                <LinearLayout
                    android:gravity="start|center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/ll_electricity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_20"
                    android:paddingStart="@dimen/dp_24"
                    android:paddingEnd="@dimen/dp_24">
                    <com.byd.base.view.BydSwitch
                        android:id="@+id/switch_electricity"
                        app:intercept="true"
                        app:splitTrack="true"
                        app:switchMinWidth="@dimen/dp_56"
                        app:thumbTintMode="src_over"
                        app:track="?attr/transparent_00"
                        app:trackTint="?attr/transparent_00"
                        style="@style/bydswitch_style"/>
                    <TextView
                        android:textSize="@dimen/sp_20"
                        android:textColor="?attr/text_color_main"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/newenergy_memory_mode_save"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/dp_16"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_epedal"
                android:background="@drawable/carlights_background"
                android:paddingTop="@dimen/dp_20"
                android:paddingBottom="@dimen/dp_20"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_16"
                android:paddingStart="@dimen/dp_24"
                android:paddingEnd="@dimen/dp_24">
                <com.byd.base.view.BydSwitch
                    android:id="@+id/switch_epedal"
                    app:intercept="true"
                    app:splitTrack="true"
                    app:switchMinWidth="@dimen/dp_56"
                    app:thumbTintMode="src_over"
                    app:track="?attr/transparent_00"
                    app:trackTint="?attr/transparent_00"
                    style="@style/bydswitch_style"/>
                <TextView
                    android:textSize="@dimen/sp_20"
                    android:textColor="?attr/text_color_main"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/newenergy_e_pedal_mode"
                    android:layout_marginStart="@dimen/dp_16"/>
            </LinearLayout>
            <RelativeLayout
