<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/version_parent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true">
    <ImageView
        android:id="@+id/iv_bg_version_manage"
        android:layout_width="@dimen/dp_556"
        android:layout_height="@dimen/dp_468"
        android:layout_marginTop="@dimen/dp_34"
        android:src="@drawable/img_carsetting_dilink_version_management"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_24"
        android:textColor="@color/text_color_gray_bt"
        android:gravity="center"
        android:id="@+id/tv_version_os"
        android:layout_width="@dimen/dp_556"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_84"
        app:layout_constraintBottom_toBottomOf="@+id/iv_bg_version_manage"
        app:layout_constraintStart_toStartOf="@+id/iv_bg_version_manage"/>
    <com.bydux.api.common.views.window.DampingScrollView
        android:orientation="vertical"
        android:id="@+id/version_scrollView"
        android:scrollbars="none"
        android:fadingEdge="vertical"
        android:fadingEdgeLength="@dimen/dp_24"
        android:layout_width="@dimen/dp_468"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_6"
        android:requiresFadingEdge="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <include layout="@layout/subview_version_manage"/>
    </com.bydux.api.common.views.window.DampingScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
