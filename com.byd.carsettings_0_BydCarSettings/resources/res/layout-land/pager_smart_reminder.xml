<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bydux.api.common.views.window.DampingScrollView
        android:id="@+id/nsw"
        style="@style/vehicle_setting_module_damping_scrollView_land_style">
        <LinearLayout style="@style/vehicle_setting_module_damping_scrollView_child_land_style">
            <LinearLayout
                android:orientation="vertical"
                android:visibility="visible"
                style="@style/vehicle_setting_background_with_param_container">
                <RelativeLayout
                    android:id="@+id/uphead_display_container"
                    android:visibility="visible"
                    style="@style/vehicle_setting_tv_sw_icon_container_un_single_style">
                    <TextView
                        android:text="@string/vehiclesettings_smart_broadcast"
                        android:layout_toEndOf="@+id/smart_reminder_sw"
                        style="@style/vehicle_setting_tv_sw_icon_tv_un_icon_style"/>
                    <com.byd.base.view.BydSwitch
                        android:id="@+id/smart_reminder_sw"
                        style="@style/vehicle_setting_tv_sw_icon_sw_style"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/smart_reminder_content_container"
                    android:layout_height="@dimen/dp_48"
                    style="@style/vehicle_setting_tv_arrow_container_un_single_style">
                    <ImageView
                        android:id="@+id/smart_reminder_content_imge"
                        style="@style/vehicle_setting_tv_arrow_arrow_style"/>
                    <TextView
                        android:text="@string/vehiclesettings_reminder_content"
                        android:layout_toStartOf="@+id/smart_reminder_content_imge"
                        style="@style/vehicle_setting_tv_arrow_tv_style"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/smart_reminder_volume_container"
                    android:visibility="visible"
                    android:layout_marginTop="@dimen/dp_20"
                    style="@style/vehicle_setting_un_background_container">
                    <TextView
                        android:id="@+id/smart_reminder_percent_tv"
                        android:text="@string/vehiclesettings_broadcast_volume"
                        android:layout_centerVertical="true"
                        style="@style/vehicle_setting_seekbar_title_tv_style"/>
                    <TextView
                        android:id="@+id/smart_reminder_percent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="@dimen/dp_33"
                        android:layout_toEndOf="@+id/smart_reminder_percent_tv"
                        style="@style/vehicle_setting_seekbar_progress_tv_style"/>
                </RelativeLayout>
                <com.byd.carsettings.ui.widget.AreaableSeekbar
                    android:id="@+id/smart_reminder_volume"
                    android:layout_marginTop="@dimen/dp_10"
                    android:layout_marginBottom="@dimen/dp_18"
                    android:max="39"
                    android:thumbOffset="@dimen/dp_0"
                    android:layout_marginStart="@dimen/dp_6"
                    android:layout_marginEnd="@dimen/dp_6"
                    android:min="5"
                    style="@style/vehicle_setting_seekbar_style"/>
            </LinearLayout>
            <RelativeLayout
                android:id="@+id/smart_voice_set_container"
                android:paddingBottom="@dimen/dp_26"
                android:layout_marginBottom="@dimen/dp_16"
                style="@style/vehicle_setting_background_container">
                <RelativeLayout
                    android:id="@+id/smart_tips_container"
                    style="@style/vehicle_setting_tv_seg_container_un_single_style">
                    <RelativeLayout
                        android:id="@+id/smart_reminder_tip_voice_container"
                        style="@style/vehicle_setting_tv_seg_icon_tv_container">
                        <ImageView
                            android:id="@+id/auto_icon"
                            android:layout_centerVertical="true"
                            android:layout_toEndOf="@+id/smart_reminder_tip_voice"
                            style="@style/vehicle_setting_tv_seg_icon_style"/>
                        <com.byd.base.view.BydFlexTextView
                            android:id="@+id/smart_reminder_tip_voice"
                            android:text="@string/vehiclesettings_tip_sound_source"
                            android:layout_centerVertical="true"
                            style="@style/vehicle_setting_tv_seg_tv_land_style"/>
                    </RelativeLayout>
                    <com.byd.base.view.segmentedbutton.SegmentedButtonGroup
                        android:id="@+id/smart_tips_segmentedButtonGroup"
                        android:layout_below="@+id/smart_reminder_tip_voice_container"
                        style="@style/vehicle_setting_tv_seg_seg_style_icon_up">
                        <com.byd.base.view.segmentedbutton.SegmentedButton
                            app:sb_text="@string/vehiclesettings_standard"
                            style="@style/vehicle_setting_tv_seg_seg_btn_style"/>
                        <com.byd.base.view.segmentedbutton.SegmentedButton
                            app:sb_text="@string/vehiclesettings_reminder_band"
                            style="@style/vehicle_setting_tv_seg_seg_btn_style"/>
                    </com.byd.base.view.segmentedbutton.SegmentedButtonGroup>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/smart_voice_set_state_container"
                    android:layout_below="@+id/smart_tips_container"
                    style="@style/vehicle_setting_tv_seg_container_un_single_style">
                    <RelativeLayout
                        android:id="@+id/smart_tips_state_container"
                        style="@style/vehicle_setting_tv_seg_container_un_single_style">
                        <RelativeLayout
                            android:id="@+id/smart_reminder_tip_voice_state_container"
                            style="@style/vehicle_setting_tv_seg_icon_tv_container">
                            <ImageView
                                android:id="@+id/auto_state_icon"
                                android:layout_centerVertical="true"
                                android:layout_toEndOf="@+id/smart_reminder_tip_state_voice"
                                style="@style/vehicle_setting_tv_seg_icon_style"/>
                            <com.byd.base.view.BydFlexTextView
                                android:id="@+id/smart_reminder_tip_state_voice"
                                android:text="@string/vehiclesettings_tip_sound_source_level"
                                android:layout_centerVertical="true"
                                style="@style/vehicle_setting_tv_seg_tv_land_style"/>
                        </RelativeLayout>
                        <com.byd.base.view.segmentedbutton.SegmentedButtonGroup
                            android:id="@+id/smart_tips_state_segmentedButtonGroup"
                            android:layout_below="@+id/smart_reminder_tip_voice_state_container"
                            style="@style/vehicle_setting_tv_seg_seg_style_icon_up">
                            <com.byd.base.view.segmentedbutton.SegmentedButton
                                app:sb_text="@string/vehiclesettings_tip_sound_source_level_low"
                                style="@style/vehicle_setting_tv_seg_seg_btn_style"/>
                            <com.byd.base.view.segmentedbutton.SegmentedButton
                                app:sb_text="@string/vehiclesettings_control_reminder_touch_middle"
                                style="@style/vehicle_setting_tv_seg_seg_btn_style"/>
                            <com.byd.base.view.segmentedbutton.SegmentedButton
                                app:sb_text="@string/vehiclesettings_tip_sound_source_level_hight"
                                style="@style/vehicle_setting_tv_seg_seg_btn_style"/>
                        </com.byd.base.view.segmentedbutton.SegmentedButtonGroup>
                    </RelativeLayout>
                </RelativeLayout>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/applicaion_limit_container"
                android:visibility="visible"
                style="@style/vehicle_setting_tv_sw_icon_container_style">
                <TextView
                    android:text="@string/vehiclesettings_navigation_volume"
                    android:layout_toEndOf="@+id/smart_reminder_nav_sw"
                    style="@style/vehicle_setting_tv_sw_icon_tv_un_icon_style"/>
                <com.byd.base.view.BydSwitch
                    android:id="@+id/smart_reminder_nav_sw"
                    style="@style/vehicle_setting_tv_sw_icon_sw_style"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/smart_reminder_safe_belt_warn_container"
                android:visibility="visible"
                style="@style/vehicle_setting_tv_sw_icon_container_style">
                <TextView
                    android:text="@string/vehiclesettings_smart_reminder_safe_belt_warn"
                    android:layout_toEndOf="@+id/smart_reminder_safe_belt_warn_sw"
                    style="@style/vehicle_setting_tv_sw_icon_tv_un_icon_style"/>
                <com.byd.base.view.BydSwitch
                    android:id="@+id/smart_reminder_safe_belt_warn_sw"
                    style="@style/vehicle_setting_tv_sw_icon_sw_style"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/smart_voice_container"
                android:visibility="visible"
                style="@style/vehicle_setting_tv_arrow_container_style">
                <ImageView
                    android:id="@+id/voice_setting_img"
                    style="@style/vehicle_setting_tv_arrow_arrow_style"/>
                <TextView
                    android:text="@string/vehiclesettings_voice_skills_center_set"
                    android:layout_toStartOf="@+id/voice_setting_img"
                    style="@style/vehicle_setting_tv_arrow_tv_style"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/system_key_voice_container"
                android:visibility="visible"
                style="@style/vehicle_setting_tv_sw_icon_container_style">
                <TextView
                    android:text="@string/vehiclesettings_system_key_voice"
                    android:layout_toEndOf="@+id/system_key_voice_sw"
                    style="@style/vehicle_setting_tv_sw_icon_tv_un_icon_style"/>
                <com.byd.base.view.BydSwitch
                    android:id="@+id/system_key_voice_sw"
                    style="@style/vehicle_setting_tv_sw_icon_sw_style"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/vehiclesettings_control_touch_rl"
                style="@style/vehicle_setting_tv_seg_container_style">
                <TextView
                    android:id="@+id/vehiclesettings_control_touch_tv"
                    android:text="@string/vehiclesettings_control_touch_level"
                    style="@style/vehicle_setting_tv_seg_tv_style"/>
                <com.byd.base.view.segmentedbutton.SegmentedButtonGroup
                    android:id="@+id/vehiclesettings_control_touch_sbg"
                    android:layout_below="@+id/vehiclesettings_control_touch_tv"
                    style="@style/vehicle_setting_tv_seg_seg_style">
                    <com.byd.base.view.segmentedbutton.SegmentedButton
                        app:sb_text="@string/vehiclesettings_control_reminder_touch_weak"
                        style="@style/vehicle_setting_tv_seg_seg_btn_style"/>
                    <com.byd.base.view.segmentedbutton.SegmentedButton
                        app:sb_text="@string/vehiclesettings_control_reminder_touch_middle"
                        style="@style/vehicle_setting_tv_seg_seg_btn_style"/>
                    <com.byd.base.view.segmentedbutton.SegmentedButton
                        app:sb_text="@string/vehiclesettings_control_touch_strong"
                        style="@style/vehicle_setting_tv_seg_seg_btn_style"/>
                </com.byd.base.view.segmentedbutton.SegmentedButtonGroup>
            </RelativeLayout>
        </LinearLayout>
    </com.bydux.api.common.views.window.DampingScrollView>
    <ImageView
        android:id="@+id/smart_reminder_image"
        style="@style/vehicle_setting_car_image_land_style"/>
</LinearLayout>
