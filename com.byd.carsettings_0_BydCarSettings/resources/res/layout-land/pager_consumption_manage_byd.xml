<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dp_40"
        android:layout_weight="1">
        <LinearLayout
            android:gravity="start|center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_48"
            android:layout_marginStart="@dimen/dp_30"
            android:layout_marginEnd="@dimen/dp_30">
            <ImageView
                android:layout_width="@dimen/dp_32"
                android:layout_height="@dimen/dp_32"
                android:src="@drawable/icon_dark_energy_curve_32"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="?attr/consumption_text_white"
                android:gravity="start|center_vertical"
                android:id="@+id/tv_table_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/newenergy_consumption_line_table"
                android:layout_weight="1"/>
            <RadioGroup
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/rg_mode"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="match_parent">
                <RadioButton
                    android:textSize="@dimen/sp_18"
                    android:textColor="?attr/consumption_text_white"
                    android:id="@+id/rg_electricity"
                    android:background="@null"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:button="@null"
                    android:text="@string/newenergy_consumption_line_elec"
                    android:drawableStart="@drawable/radio_btn_bg_selector"
                    android:layout_marginEnd="@dimen/dp_16"/>
                <RadioButton
                    android:textSize="@dimen/sp_18"
                    android:textColor="?attr/consumption_text_white"
                    android:id="@+id/rg_fuel"
                    android:background="@null"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:button="@null"
                    android:text="@string/newenergy_consumption_line_fuel"
                    android:drawableStart="@drawable/radio_btn_bg_selector"
                    android:layout_marginEnd="@dimen/dp_16"/>
                <RadioButton
                    android:textSize="@dimen/sp_18"
                    android:textColor="?attr/consumption_text_white"
                    android:id="@+id/rg_all"
                    android:background="@null"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:button="@null"
                    android:text="@string/newenergy_consumption_line_all"
                    android:drawableStart="@drawable/radio_btn_bg_selector"/>
            </RadioGroup>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/dp_54"
            android:layout_marginStart="@dimen/dp_89"
            android:layout_marginEnd="@dimen/dp_89">
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="?attr/chart_ytext_elec"
                android:gravity="left"
                android:layout_gravity="bottom"
                android:id="@+id/tv_chart_title_left"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/dp_2"
                android:text="@string/newenergy_consumption_line_average_elec_title"
                android:layout_weight="1"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="?attr/chart_ytext_fuel"
                android:gravity="right"
                android:layout_gravity="bottom"
                android:id="@+id/tv_chart_title_right"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_2"
                android:text="@string/newenergy_consumption_line_average_fuel_title"
                android:layout_weight="1"/>
        </LinearLayout>
        <com.byd.carsettings.ui.widget.bydenergychart.BydEnergyChartView
            android:id="@+id/chart_energy"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_286"
            android:layout_marginStart="@dimen/dp_33"
            android:layout_marginEnd="@dimen/dp_31"/>
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_38"
            android:layout_marginStart="@dimen/dp_64"
            android:layout_marginEnd="@dimen/dp_61">
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="?attr/consumption_data_clear_text"
                android:gravity="center"
                android:id="@+id/tv_chart_clear"
                android:background="@drawable/selector_dialog_white"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_40"
                android:layout_marginBottom="@dimen/dp_5"
                android:minWidth="@dimen/dp_128"
                android:text="@string/newenergy_consumption_line_clear_data"
                android:textAllCaps="false"
                android:paddingStart="@dimen/dp_24"
                android:paddingEnd="@dimen/dp_24"
                android:layout_marginStart="@dimen/dp_30"
                android:layout_marginEnd="@dimen/dp_30"
                android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"/>
            <com.byd.base.view.segmentedbutton.SegmentedButtonGroup
                android:id="@+id/sbg_mile"
                android:visibility="gone"
                android:layout_width="@dimen/dp_324"
                android:layout_height="@dimen/dp_40"
                android:layout_marginBottom="@dimen/dp_5"
                android:layout_marginEnd="@dimen/dp_31"
                app:sbg_animateSelector="fastOutSlowIn"
                app:sbg_animateSelectorDuration="1000"
                app:sbg_backgroundColor="?attr/carlights_segcontrolbutton_background"
                app:sbg_dividerPadding="@dimen/dp_10"
                app:sbg_dividerRadius="@dimen/dp_10"
                app:sbg_position="0"
                app:sbg_radius="@dimen/dp_24"
                app:sbg_ripple="true"
                app:sbg_selectorGradient_endColor="?attr/carsetting_text_color_blue"
                app:sbg_selectorGradient_startColor="?attr/carsetting_text_color_blue2">
                <com.byd.base.view.segmentedbutton.SegmentedButton
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_40"
                    android:layout_weight="1"
                    app:sb_text="10km"
                    app:sb_textColor="?attr/carlights_guest_color"
                    app:sb_textColor_onSelection="?attr/byd_button_selected_text_color"
                    app:sb_textSize="@dimen/dp_20"/>
                <com.byd.base.view.segmentedbutton.SegmentedButton
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_40"
                    android:layout_weight="1"
                    app:sb_text="25km"
                    app:sb_textColor="?attr/carlights_guest_color"
                    app:sb_textColor_onSelection="?attr/byd_button_selected_text_color"
                    app:sb_textSize="@dimen/dp_20"/>
                <com.byd.base.view.segmentedbutton.SegmentedButton
                    android:id="@+id/sb_intelligent"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_40"
                    android:layout_weight="1"
                    app:sb_text="50km"
                    app:sb_textColor="?attr/carlights_guest_color"
                    app:sb_textColor_onSelection="?attr/byd_button_selected_text_color"
                    app:sb_textSize="@dimen/dp_20"/>
            </com.byd.base.view.segmentedbutton.SegmentedButtonGroup>
        </LinearLayout>
    </LinearLayout>
    <com.bydux.api.common.views.window.DampingScrollView
        android:id="@+id/scrollView"
        android:scrollbars="none"
        android:layout_width="@dimen/dp_350"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dp_6">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="@dimen/dp_350"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/carlights_background"
                android:paddingTop="@dimen/dp_26"
                android:paddingBottom="@dimen/dp_26"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16">
                <LinearLayout
                    android:gravity="start|center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_32"
                    android:layout_marginStart="@dimen/dp_18">
                    <ImageView
                        android:layout_width="@dimen/dp_32"
                        android:layout_height="@dimen/dp_32"
                        android:src="@drawable/icon_dark_energy_checklist_32"/>
                    <TextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="?attr/consumption_text_white"
                        android:gravity="start|center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/newenergy_consumption_list_table"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/ll_total_mileage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_6"
                    android:layout_marginBottom="@dimen/dp_10"
                    android:minHeight="@dimen/dp_35"
                    android:layout_marginStart="@dimen/dp_24"
                    android:layout_marginEnd="@dimen/dp_24">
                    <TextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="?attr/consumption_text_gray"
                        android:layout_gravity="bottom"
                        android:id="@+id/tv_mile_total_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="@dimen/dp_110"
                        android:text="@string/newenergy_consumption_list_total"/>
                    <TextView
                        android:textSize="@dimen/sp_30"
                        android:textStyle="bold"
                        android:textColor="?attr/consumption_text_white"
                        android:id="@+id/tv_mile_total_value"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp_35"
                        android:text="--"
                        android:layout_marginStart="@dimen/dp_8"/>
                    <TextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="?attr/consumption_text_gray"
                        android:id="@+id/tv_mile_total_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/newenergy_mile_unit"
                        android:layout_marginStart="@dimen/dp_8"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_6"
                    android:layout_marginBottom="@dimen/dp_2"
                    android:minHeight="@dimen/dp_24"
                    android:layout_marginStart="@dimen/dp_24">
                    <TextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="?attr/consumption_text_gray"
                        android:gravity="start|center_vertical"
                        android:id="@+id/tv_list_average_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/newenergy_consumption_list_average_elec"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="?attr/consumption_text_gray"
                        android:gravity="start|center_vertical"
                        android:id="@+id/tv_endurance_mileage"
                        android:visibility="gone"
                        android:layout_width="@dimen/dp_130"
                        android:layout_height="wrap_content"
                        android:text="@string/newenergy_consumption_list_endurance_mileage"
                        android:paddingStart="@dimen/dp_8"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/ll_dm"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_18">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/ll_dm_1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_4"
                        android:layout_weight="1">
                        <ImageView
                            android:layout_width="@dimen/dp_32"
                            android:layout_height="@dimen/dp_32"
                            android:src="@drawable/icon_dark_public_dashboard_32"/>
                        <TextView
                            android:textSize="@dimen/sp_22"
                            android:textStyle="bold"
                            android:textColor="?attr/consumption_text_white"
                            android:gravity="start|center_vertical"
                            android:id="@+id/tv_oil_total_average_value"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/dp_32"
                            android:text="--"
                            android:layout_marginStart="4dp"/>
                        <TextView
                            android:textSize="@dimen/sp_14"
                            android:textColor="?attr/consumption_text_gray"
                            android:gravity="start|center_vertical"
                            android:id="@+id/tv_oil_total_average_unit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/newenergy_average_fuel_unit"
                            android:layout_marginStart="@dimen/dp_4"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/ll_dm_2"
                        android:layout_width="@dimen/dp_130"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_4">
                        <ImageView
                            android:layout_width="@dimen/dp_32"
                            android:layout_height="@dimen/dp_32"
                            android:src="@drawable/icon_dark_public_dashboard_32"/>
                        <TextView
                            android:textSize="@dimen/sp_22"
                            android:textStyle="bold"
                            android:textColor="?attr/consumption_text_white"
                            android:gravity="start|center_vertical"
                            android:id="@+id/tv_mile_endurance_value"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/dp_32"
                            android:text="--"
                            android:layout_marginStart="4dp"/>
                        <TextView
                            android:textSize="@dimen/sp_14"
                            android:textColor="?attr/consumption_text_gray"
                            android:gravity="start|center_vertical"
                            android:id="@+id/tv_mile_endurance_unit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/newenergy_mile_unit"
                            android:layout_marginStart="@dimen/dp_4"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_4"
                    android:layout_marginStart="@dimen/dp_18"
                    android:layout_marginEnd="@dimen/dp_24">
                    <ImageView
                        android:layout_width="@dimen/dp_32"
                        android:layout_height="@dimen/dp_32"
                        android:src="@drawable/icon_dark_public_electricity_32"/>
                    <TextView
                        android:textSize="@dimen/sp_22"
                        android:textStyle="bold"
                        android:textColor="?attr/consumption_text_white"
                        android:gravity="start|center_vertical"
                        android:id="@+id/tv_elec_total_average_value"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp_32"
                        android:text="--"
                        android:layout_marginStart="4dp"/>
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="?attr/consumption_text_gray"
                        android:gravity="start|center_vertical"
                        android:id="@+id/tv_elec_total_average_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/newenergy_average_elec_unit_kw_km"
                        android:layout_marginStart="@dimen/dp_4"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/carlights_background"
                android:paddingTop="@dimen/dp_20"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/ll_list_total_fuel"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_38"
                    android:layout_marginStart="@dimen/dp_24"
                    android:layout_marginEnd="@dimen/dp_24">
                    <TextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="?attr/consumption_text_gray"
                        android:layout_gravity="center_vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/newenergy_consumption_list_total_fuel_consumption"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="@dimen/sp_22"
                        android:textStyle="bold"
                        android:textColor="?attr/consumption_text_white"
                        android:gravity="end|center_vertical"
                        android:id="@+id/tv_oil_total_value"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp_38"
                        android:text="--"/>
                    <TextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="?attr/consumption_text_gray"
                        android:id="@+id/tv_oil_total_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/consumption_l"
                        android:layout_marginStart="@dimen/dp_4"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/ll_list_charge_elec"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_38"
                    android:layout_marginStart="@dimen/dp_24"
                    android:layout_marginEnd="@dimen/dp_24">
                    <TextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="?attr/consumption_text_gray"
                        android:layout_gravity="center_vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/newenergy_consumption_list_charge_elec"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="@dimen/sp_22"
                        android:textStyle="bold"
                        android:textColor="?attr/consumption_text_white"
                        android:gravity="end|center_vertical"
                        android:id="@+id/tv_elec_total_value"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp_38"
                        android:text="--"/>
                    <TextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="?attr/consumption_text_gray"
                        android:id="@+id/tv_elec_total_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/newenergy_elec_unit_kw"
                        android:layout_marginStart="@dimen/dp_4"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_38"
                    android:layout_marginStart="@dimen/dp_24"
                    android:layout_marginEnd="@dimen/dp_24">
                    <TextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="?attr/consumption_text_gray"
                        android:layout_gravity="center_vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/newenergy_consumption_list_drive_time"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="@dimen/sp_22"
                        android:textStyle="bold"
                        android:textColor="?attr/consumption_text_white"
                        android:gravity="end|center_vertical"
                        android:id="@+id/tv_time_travel_value"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp_38"
                        android:text="--"/>
                    <TextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="?attr/consumption_text_gray"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/consumption_h"
                        android:layout_marginStart="@dimen/dp_4"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dp_17"
                    android:layout_marginStart="@dimen/dp_24"
                    android:layout_marginEnd="@dimen/dp_24">
                    <TextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="?attr/consumption_text_gray"
                        android:layout_gravity="center_vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/consumption_average_speed"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="@dimen/sp_22"
                        android:textStyle="bold"
                        android:textColor="?attr/consumption_text_white"
                        android:gravity="end|center_vertical"
                        android:id="@+id/tv_average_speed_value"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp_38"
                        android:text="--"/>
                    <TextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="?attr/consumption_text_gray"
                        android:id="@+id/tv_average_speed_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/newenergy_speed_unit_km"
                        android:layout_marginStart="@dimen/dp_4"/>
                </LinearLayout>
                <TextView
                    android:textSize="@dimen/sp_18"
                    android:textColor="?attr/consumption_data_clear_text"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/tv_data_clear"
                    android:background="@drawable/selector_dialog_white"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp_40"
                    android:layout_marginBottom="@dimen/dp_26"
                    android:minWidth="@dimen/dp_128"
                    android:text="@string/newenergy_consumption_list_clear_data"
                    android:textAllCaps="false"
                    android:paddingStart="@dimen/dp_24"
                    android:paddingEnd="@dimen/dp_24"
                    android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"/>
            </LinearLayout>
        </LinearLayout>
    </com.bydux.api.common.views.window.DampingScrollView>
</LinearLayout>
