<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_60"
    android:minHeight="@dimen/dp_60">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/dp_15"
        android:layout_alignParentStart="true">
        <ImageView
            android:id="@+id/iv_wifi_rssi_item_wifi_list"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"/>
        <com.byd.carsettings.ui.widget.LengthMaxTextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/text_color_main_dilink_pagers"
            android:id="@+id/tv_wifi_name_item_wifi_list"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/dp_200"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/iv_detail_item_wifi_list"
        android:background="@drawable/icon_public_details_48"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/dp_15"
        android:layout_alignParentEnd="true"/>
    <View
        android:id="@+id/v_item_bg_checked_item_wifi_list"
        android:background="@drawable/bg_frame_blue_content_transparent_00"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:background="@color/bg_color_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/dp_28"
        android:layout_marginEnd="@dimen/dp_27"/>
</RelativeLayout>
