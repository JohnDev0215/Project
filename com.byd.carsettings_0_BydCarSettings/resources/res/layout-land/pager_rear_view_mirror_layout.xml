<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bydux.api.common.views.window.DampingScrollView
        android:id="@+id/nsw"
        style="@style/vehicle_setting_module_damping_scrollView_land_style">
        <LinearLayout
            android:id="@+id/carlight_params_ll"
            style="@style/vehicle_setting_module_damping_scrollView_child_land_style">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/rear_view_out_container"
                android:layout_marginBottom="@dimen/dp_16"
                style="@style/vehicle_setting_background_container">
                <TextView
                    android:textSize="@dimen/sp_18"
                    android:textColor="@color/carsetting_text_color_white"
                    android:id="@+id/rear_view_out_title_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_18"
                    android:text="@string/vehiclesettings_title_out_rear_view_mirror"
                    android:layout_marginStart="@dimen/dp_24"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/rear_view_brightness_container_ll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <RelativeLayout
                        android:id="@+id/rear_view_out_brightness_title_rl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_20">
                        <TextView
                            android:id="@+id/rear_view_brightness_level_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="@dimen/dp_30"
                            android:layout_toEndOf="@+id/rear_view_brightness_title_tv"
                            style="@style/vehicle_setting_seekbar_progress_tv_style"/>
                        <com.byd.base.view.BydFlexTextView
                            android:id="@+id/rear_view_brightness_title_tv"
                            android:text="@string/vehiclesettings_rear_view_mirror_brightness"
                            android:layout_centerVertical="true"
                            style="@style/vehicle_setting_seekbar_title_tv_style"/>
                    </RelativeLayout>
                    <SeekBar
                        android:id="@+id/rear_view_brightness_sb"
                        android:max="10"
                        android:layout_below="@+id/light_start_tips_img_rl"
                        style="@style/vehicle_setting_seekbar_style"/>
                </LinearLayout>
                <RelativeLayout
                    android:id="@+id/rear_view_brightness_auto_container"
                    style="@style/vehicle_setting_right_tv_sw_icon_container_un_single_style">
                    <com.byd.base.view.BydSwitch
                        android:id="@+id/rear_view_brightness_auto_sw"
                        style="@style/vehicle_setting_tv_sw_icon_sw_style"/>
                    <TextView
                        android:text="@string/vehiclesettings_rear_view_mirror_brightness_auto"
                        android:layout_toEndOf="@+id/rear_view_brightness_auto_sw"
                        style="@style/vehicle_setting_tv_sw_icon_tv_un_icon_style"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/rear_view_view_change_container"
                    style="@style/vehicle_setting_tv_sw_icon_container_un_single_style">
                    <TextView
                        android:text="@string/vehiclesettings_rear_view_mirror_back_off_view_change"
                        android:layout_toEndOf="@+id/rear_view_view_change_switch"
                        style="@style/vehicle_setting_tv_sw_icon_tv_un_icon_style"/>
                    <com.byd.base.view.BydSwitch
                        android:id="@+id/rear_view_view_change_switch"
                        style="@style/vehicle_setting_tv_sw_icon_sw_style"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/rear_view_view_help_line_container"
                    style="@style/vehicle_setting_tv_sw_icon_container_un_single_style">
                    <TextView
                        android:text="@string/vehiclesettings_rear_view_mirror_back_off_help_line"
                        android:layout_toEndOf="@+id/rear_view_view_help_line_switch"
                        style="@style/vehicle_setting_tv_sw_icon_tv_un_icon_style"/>
                    <com.byd.base.view.BydSwitch
                        android:id="@+id/rear_view_view_help_line_switch"
                        style="@style/vehicle_setting_tv_sw_icon_sw_style"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/rear_view_view_reset_view_container"
                    style="@style/vehicle_setting_tv_sw_icon_container_un_single_style">
                    <TextView
                        android:id="@+id/rear_view_view_reset_view_tv"
                        android:text="@string/vehiclesettings_rear_view_mirror_reset_view"
                        style="@style/vehicle_setting_tv_arrow_tv_style"/>
                    <ImageView
                        android:id="@+id/rear_view_view_reset_view_iv"
                        style="@style/vehicle_setting_tv_arrow_arrow_style"/>
                </RelativeLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/rear_view_inner_container"
                android:layout_marginBottom="@dimen/dp_16"
                style="@style/vehicle_setting_background_container">
                <RelativeLayout
                    android:id="@+id/rear_view_inner_sw_container"
                    style="@style/vehicle_setting_un_background_container_88dp">
                    <com.byd.base.view.BydSwitch
                        android:id="@+id/rear_view_inner_sw"
                        style="@style/vehicle_setting_tv_sw_icon_sw_style"/>
                    <TextView
                        android:text="@string/vehiclesettings_title_inner_rear_view_mirror"
                        android:layout_toEndOf="@+id/rear_view_inner_sw"
                        style="@style/vehicle_setting_tv_sw_icon_tv_un_icon_style"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/rear_view_screen_turn_container"
                    style="@style/vehicle_setting_un_background_container_88dp">
                    <TextView
                        android:id="@+id/rear_view_screen_turn_tv"
                        android:text="@string/vehiclesettings_rear_view_mirror_screen_turn"
                        style="@style/vehicle_setting_tv_arrow_tv_style"/>
                    <ImageView
                        android:id="@+id/rear_view_screen_turn_iv"
                        style="@style/vehicle_setting_tv_arrow_arrow_style"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/rear_view_brightness_view_reset_container"
                    style="@style/vehicle_setting_un_background_container_88dp">
                    <TextView
                        android:id="@+id/rear_view_brightness_view_reset_tv"
                        android:text="@string/vehiclesettings_rear_view_mirror_reset_brightness_view"
                        android:layout_toStartOf="@+id/rear_view_brightness_view_reset_iv"
                        style="@style/vehicle_setting_tv_arrow_tv_style"/>
                    <ImageView
                        android:id="@+id/rear_view_brightness_view_reset_iv"
                        style="@style/vehicle_setting_tv_arrow_arrow_style"/>
                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>
    </com.bydux.api.common.views.window.DampingScrollView>
    <ImageView
        android:id="@+id/rear_view_image"
        style="@style/vehicle_setting_car_image_land_style"/>
</LinearLayout>
