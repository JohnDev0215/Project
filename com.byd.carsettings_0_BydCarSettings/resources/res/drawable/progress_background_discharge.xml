<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:gravity="center"
        android:id="@android:id/background">
        <shape>
            <corners android:radius="@dimen/dp_14"/>
            <size android:height="@dimen/dp_20"/>
            <solid android:color="?attr/progress_discharge"/>
        </shape>
    </item>
    <item
        android:gravity="center"
        android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="@dimen/dp_14"/>
                <size android:height="@dimen/dp_20"/>
                <gradient
                    android:startColor="?attr/progress_discharge_end"
                    android:endColor="?attr/progress_discharge_start"
                    android:angle="270"/>
            </shape>
        </clip>
    </item>
</layer-list>
