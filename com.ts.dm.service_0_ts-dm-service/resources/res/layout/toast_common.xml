<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="top|center_horizontal"
        android:orientation="vertical"
        android:id="@+id/toast_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/CommonToastBgStyle">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <ImageView
                android:id="@+id/toast_icon"
                style="@style/CommonToastIconStyle"/>
            <TextView
                android:id="@+id/toast_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:text="Smart"
                android:layout_weight="1"
                style="@style/CommonToastContentStyle"/>
            <TextView
                android:id="@+id/toast_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/close"
                style="@style/CommonToastCloseStyle"/>
        </LinearLayout>
        <ImageView
            android:layout_width="@dimen/top_pulldown_width"
            android:layout_height="@dimen/top_pulldown_height"
            android:src="@drawable/ic_pulldown"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"/>
    </LinearLayout>
</FrameLayout>
