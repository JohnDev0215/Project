<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/rl"
    android:background="@color/bg_white_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/text_size"
                android:textStyle="bold"
                android:textColor="@color/text_color_black"
                android:gravity="center"
                android:id="@+id/tvVersion"
                android:layout_width="wrap_content"
                android:layout_height="44px"
                android:layout_marginLeft="40px"
                android:layout_marginTop="40px"
                android:text="Version：--"/>
            <TextView
                android:textSize="@dimen/text_size"
                android:textStyle="bold"
                android:textColor="@color/text_color_black"
                android:gravity="center"
                android:id="@+id/tvDBVersion"
                android:layout_width="wrap_content"
                android:layout_height="44px"
                android:layout_marginLeft="80px"
                android:layout_marginTop="40px"
                android:text="DBVersion：--"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/icon_margin_left">
            <ImageView
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:layout_marginTop="@dimen/icon_margin_top"
                android:src="@mipmap/icon_time"/>
            <TextView
                android:textSize="@dimen/text_size"
                android:textStyle="bold"
                android:textColor="@color/text_color_black"
                android:gravity="center"
                android:id="@+id/tvTime"
                android:layout_width="@dimen/text_width"
                android:layout_height="@dimen/text_height"
                android:layout_marginLeft="@dimen/text_margin_left"
                android:layout_marginTop="@dimen/text_margin_top"
                android:text="Time：--"/>
            <ImageView
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:layout_marginLeft="@dimen/icon_margin_left"
                android:src="@mipmap/icon_geo"/>
            <TextView
                android:textSize="@dimen/text_size"
                android:textStyle="bold"
                android:textColor="@color/text_color_black"
                android:gravity="center"
                android:id="@+id/tvLocation"
                android:layout_width="@dimen/text_width2"
                android:layout_height="@dimen/text_height"
                android:layout_marginLeft="@dimen/text_margin_left"
                android:layout_marginTop="@dimen/text_margin_top"
                android:text="Geo：--"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/icon_margin_left">
            <ImageView
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:layout_marginTop="@dimen/icon_margin_top"
                android:src="@mipmap/icon_status"/>
            <TextView
                android:textSize="@dimen/text_size"
                android:textStyle="bold"
                android:textColor="@color/text_color_black"
                android:gravity="center"
                android:id="@+id/tvMapStatus"
                android:layout_width="@dimen/text_width"
                android:layout_height="@dimen/text_height"
                android:layout_marginLeft="@dimen/text_margin_left"
                android:layout_marginTop="@dimen/text_margin_top"
                android:text="Status：--"/>
            <ImageView
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:layout_marginLeft="@dimen/icon_margin_left"
                android:src="@mipmap/icon_country"/>
            <TextView
                android:textSize="@dimen/text_size"
                android:textStyle="bold"
                android:textColor="@color/text_color_black"
                android:gravity="center"
                android:id="@+id/tvCountryCode"
                android:layout_width="@dimen/text_width2"
                android:layout_height="@dimen/text_height"
                android:layout_marginLeft="@dimen/text_margin_left"
                android:layout_marginTop="@dimen/text_margin_top"
                android:text="Country：--"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/icon_margin_left">
            <ImageView
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:layout_marginTop="@dimen/icon_margin_top"
                android:src="@mipmap/icon_speed"/>
            <TextView
                android:textSize="@dimen/text_size"
                android:textStyle="bold"
                android:textColor="#dc3333"
                android:gravity="center"
                android:id="@+id/tvSpeedLimitAndSpeedlimitType"
                android:layout_width="@dimen/text_width"
                android:layout_height="@dimen/text_height"
                android:layout_marginLeft="@dimen/text_margin_left"
                android:layout_marginTop="@dimen/text_margin_top"
                android:text="speed：-- (type：--)"/>
            <ImageView
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:layout_marginLeft="@dimen/icon_margin_left"
                android:src="@mipmap/icon_snow"/>
            <TextView
                android:textSize="@dimen/text_size"
                android:textStyle="bold"
                android:textColor="#dc3333"
                android:gravity="center"
                android:id="@+id/tvSpeedlimit_Snow"
                android:layout_width="266dp"
                android:layout_height="@dimen/text_height"
                android:layout_marginLeft="@dimen/text_margin_left"
                android:layout_marginTop="@dimen/text_margin_top"
                android:text="Snow：--"/>
            <ImageView
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:layout_marginLeft="10dp"
                android:src="@mipmap/icon_rain"/>
            <TextView
                android:textSize="@dimen/text_size"
                android:textStyle="bold"
                android:textColor="#dc3333"
                android:gravity="center"
                android:id="@+id/tvSpeedlimit_Rain"
                android:layout_width="266dp"
                android:layout_height="@dimen/text_height"
                android:layout_marginLeft="@dimen/text_margin_left"
                android:layout_marginTop="@dimen/text_margin_top"
                android:text="Rain：--"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/icon_margin_left">
            <ImageView
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:layout_marginTop="@dimen/icon_margin_top"
                android:src="@mipmap/icon_time_exist"/>
            <TextView
                android:textSize="@dimen/text_size"
                android:textStyle="bold"
                android:textColor="@color/text_color_black"
                android:gravity="center"
                android:id="@+id/tvTimeConditionSignExist"
                android:layout_width="@dimen/text_width"
                android:layout_height="@dimen/text_height"
                android:layout_marginLeft="@dimen/text_margin_left"
                android:layout_marginTop="@dimen/text_margin_top"
                android:text="TimeExist: --"/>
            <ImageView
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:layout_marginLeft="@dimen/icon_margin_left"
                android:src="@mipmap/icon_ramp"/>
            <TextView
                android:textSize="@dimen/text_size"
                android:textStyle="bold"
                android:textColor="@color/text_color_black"
                android:gravity="center"
                android:id="@+id/tvNextRampAndRampOffset"
                android:layout_width="@dimen/text_width2"
                android:layout_height="@dimen/text_height"
                android:layout_marginLeft="@dimen/text_margin_left"
                android:layout_marginTop="@dimen/text_margin_top"
                android:text="Ramp：-- (Dist：--)"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/icon_margin_left">
            <ImageView
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:layout_marginTop="@dimen/icon_margin_top"
                android:src="@mipmap/icon_road"/>
            <TextView
                android:textSize="@dimen/text_size"
                android:textStyle="bold"
                android:textColor="@color/text_color_black"
                android:gravity="center"
                android:id="@+id/tvRoadtype"
                android:layout_width="1342px"
                android:layout_height="@dimen/text_height"
                android:layout_marginLeft="@dimen/text_margin_left"
                android:layout_marginTop="@dimen/text_margin_top"
                android:text="Road：--"/>
        </LinearLayout>
        <View
            android:background="#ffe7ecf0"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="10dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/icon_margin_left"
            android:layout_marginTop="10dp">
            <ImageView
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:layout_marginTop="@dimen/icon_margin_top"
                android:src="@drawable/ic_icon_jams"/>
            <TextView
                android:textSize="@dimen/text_size"
                android:textStyle="bold"
                android:textColor="@color/text_color_black"
                android:gravity="center"
                android:id="@+id/tvJams"
                android:layout_width="@dimen/text_width"
                android:layout_height="@dimen/text_height"
                android:layout_marginLeft="@dimen/text_margin_left"
                android:layout_marginTop="@dimen/text_margin_top"
                android:text="Jams: --"/>
            <ImageView
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:layout_marginLeft="@dimen/icon_margin_left"
                android:src="@drawable/ic_icon_accident"/>
            <TextView
                android:textSize="@dimen/text_size"
                android:textStyle="bold"
                android:textColor="@color/text_color_black"
                android:gravity="center"
                android:id="@+id/tvAccident"
                android:layout_width="@dimen/text_width2"
                android:layout_height="@dimen/text_height"
                android:layout_marginLeft="@dimen/text_margin_left"
                android:layout_marginTop="@dimen/text_margin_top"
                android:text="Accident: --"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/icon_margin_left">
            <ImageView
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:layout_marginTop="@dimen/icon_margin_top"
                android:src="@drawable/ic_icon_construction"/>
            <TextView
                android:textSize="@dimen/text_size"
                android:textStyle="bold"
                android:textColor="@color/text_color_black"
                android:gravity="center"
                android:id="@+id/tvConstruction"
                android:layout_width="@dimen/text_width"
                android:layout_height="@dimen/text_height"
                android:layout_marginLeft="@dimen/text_margin_left"
                android:layout_marginTop="@dimen/text_margin_top"
                android:text="Construction: --"/>
            <ImageView
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:layout_marginLeft="@dimen/icon_margin_left"
                android:src="@drawable/ic_icon_sign"/>
            <TextView
                android:textSize="@dimen/text_size"
                android:textStyle="bold"
                android:textColor="@color/text_color_black"
                android:gravity="center"
                android:id="@+id/tvSign"
                android:layout_width="@dimen/text_width2"
                android:layout_height="@dimen/text_height"
                android:layout_marginLeft="@dimen/text_margin_left"
                android:layout_marginTop="@dimen/text_margin_top"
                android:text="Sign: --"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/icon_margin_left">
            <ImageView
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:layout_marginTop="@dimen/icon_margin_top"
                android:src="@drawable/ic_icon_roundabout"/>
            <TextView
                android:textSize="@dimen/text_size"
                android:textStyle="bold"
                android:textColor="@color/text_color_black"
                android:gravity="center"
                android:id="@+id/tvRoundaboutSign"
                android:layout_width="@dimen/text_width"
                android:layout_height="@dimen/text_height"
                android:layout_marginLeft="@dimen/text_margin_left"
                android:layout_marginTop="@dimen/text_margin_top"
                android:text="RoundaboutSign: --"/>
            <ImageView
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:layout_marginLeft="@dimen/icon_margin_left"
                android:src="@drawable/ic_icon_junction"/>
            <TextView
                android:textSize="@dimen/text_size"
                android:textStyle="bold"
                android:textColor="@color/text_color_black"
                android:gravity="center"
                android:id="@+id/tvJunctionSign"
                android:layout_width="@dimen/text_width2"
                android:layout_height="@dimen/text_height"
                android:layout_marginLeft="@dimen/text_margin_left"
                android:layout_marginTop="@dimen/text_margin_top"
                android:text="JunctionSign: --"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/icon_margin_left">
            <ImageView
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:layout_marginTop="@dimen/icon_margin_top"
                android:src="@drawable/ic_icon_sign"/>
            <TextView
                android:textSize="@dimen/text_size"
                android:textStyle="bold"
                android:textColor="@color/text_color_black"
                android:gravity="center"
                android:id="@+id/tvTrafficLightSign"
                android:layout_width="@dimen/text_width"
                android:layout_height="@dimen/text_height"
                android:layout_marginLeft="@dimen/text_margin_left"
                android:layout_marginTop="@dimen/text_margin_top"
                android:text="TrafficLightSign: --"/>
            <ImageView
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:layout_marginLeft="@dimen/icon_margin_left"
                android:src="@drawable/ic_icon_stop"/>
            <TextView
                android:textSize="@dimen/text_size"
                android:textStyle="bold"
                android:textColor="@color/text_color_black"
                android:gravity="center"
                android:id="@+id/tvStopSign"
                android:layout_width="@dimen/text_width2"
                android:layout_height="@dimen/text_height"
                android:layout_marginLeft="@dimen/text_margin_left"
                android:layout_marginTop="@dimen/text_margin_top"
                android:text="StopSign: --"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/icon_margin_left">
            <ImageView
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:layout_marginTop="@dimen/icon_margin_top"
                android:src="@drawable/ic_icon_yield"/>
            <TextView
                android:textSize="@dimen/text_size"
                android:textStyle="bold"
                android:textColor="@color/text_color_black"
                android:gravity="center"
                android:id="@+id/tvYieldSign"
                android:layout_width="@dimen/text_width"
                android:layout_height="@dimen/text_height"
                android:layout_marginLeft="@dimen/text_margin_left"
                android:layout_marginTop="@dimen/text_margin_top"
                android:text="YieldSign: --"/>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:id="@+id/close"
        android:layout_width="96px"
        android:layout_height="96px"
        android:layout_marginTop="14px"
        android:layout_marginRight="60px"
        android:src="@drawable/ic_icon_64_dbu_delete"
        android:layout_alignParentRight="true"/>
    <Button
        android:id="@+id/blackBg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="20dp"
        android:text="black bg"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"/>
    <Button
        android:id="@+id/whiteBg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="120dp"
        android:layout_marginBottom="20dp"
        android:text="white bg"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"/>
    <Switch
        android:textColor="#0000"
        android:id="@+id/switchBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="250dp"
        android:layout_marginBottom="30dp"
        android:text="open dlt "
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:track="@drawable/gray_btn_normal"/>
</RelativeLayout>
