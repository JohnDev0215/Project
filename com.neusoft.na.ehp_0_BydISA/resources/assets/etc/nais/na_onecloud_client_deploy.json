{
  "Watchdog": {
    "comment 1": "default service- and worker-agent timeout in ms, set to 0 to disable",
    "comment 2": "any agent is able to overwrite the default timeout",
    "ServiceAgentTimeout": 7500,
    "WorkerAgentTimeout": 20000,
    "comment 3": "how often in ms the watchdog thread inspect all current running agent procedures, set to 0 to disable",
    "CycleTime": 1000,
    "comment 4": "log some agent statistic in ms, set to 0 to disable",
    "StatisticCycleTime": 60000
  },

  "FinishTimeout": 300000,
  "DrainTimeout": 300000,

   "SharedLibraries": [
      { "Name": "na_onecloud_client_adaptors_fcall", "Enabled": "${interface.cpp}" },
      { "Name": "na_onecloud_client_adaptors_dbus",  "Enabled": "${interface.dbus}" },
      { "Name": "na_onecloud_client_adaptors_json",  "Enabled": "${interface.json}" }
   ],

  "Instances": [
    {
      "Comment": "start infrastructure manager first",
      "Name": "MemTrackerManagerImpl"
    },
    {
      "Comment": "start infrastructure manager first",
      "Name": "CPUTrackerManagerImpl"
    },
    {
      "Comment": "start infrastructure manager first",
      "Name": "TimerManagerInstance"
    },
    {
      "Comment": "start infrastructure manager first",
      "Name": "TimeServiceManagerInstance"
    },
    {
      "Regex": "FCallCppProvider.*",
      "Comment": "deploy all FCallCppProviders",
      "ServiceAgent": "AdaptorAgent",
      "Optional": true,
      "Enabled": "${interface.cpp}"
    },
    {
      "Regex": "FCallCppFacade.*",
      "Comment": "deploy add FCallCppFacades",
      "ServiceAgent": "AdaptorAgent",
      "Optional": true,
      "Enabled": true
    },
    {
      "Name": "DBusCommunication",
      "ServiceAgent": "AdaptorAgent",
      "Optional": true,
      "Enabled": "${interface.dbus}"
    },
    {
      "Regex": "DBusProvider.*",
      "Comment": "deploy all DBusProviders",
      "ServiceAgent": "AdaptorAgent",
      "Optional": true,
      "Enabled": "${interface.dbus}"
    },
    {
      "Regex": "DBusFacade.*",
      "Comment": "deploy all DBusFacades",
      "ServiceAgent": "AdaptorAgent",
      "Optional": true,
      "Enabled": true
    },
    {
      "Name": "JsonWsCommunication",
      "ServiceAgent": "AdaptorAgent",
      "Optional": true,
      "Enabled": "${interface.json}"
    },
    {
      "Regex": "JsonWsProvider.*",
      "Comment": "deploy all JsonWsProviders",
      "ServiceAgent": "AdaptorAgent",
      "Optional": true,
      "Enabled": "${interface.json}"
    },
    {
      "Regex": "JsonWsFacade.*",
      "Comment": "deploy all JsonWsFacades",
      "ServiceAgent": "AdaptorAgent",
      "Optional": true,
      "Enabled": true
    },
    {
      "Names": ["UserCredentialsManager","UtilityManager", "LocationSearchManager", "DbUpdateManager", "GuidanceManager","HybridDbProviderManager", "ConfigProviderManager", "RouteManager", "TrafficInfoProviderManager"],
      "Comment": "used for OneCloud integration",
      "Optional": true,
      "Enabled": true
    }
  ]
}
