<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:tag="layout/activity_open_bt_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:tag="binding_1"
        android:background="@drawable/bg_my_dialog_dark"
        android:layout_width="@dimen/dp_560"
        android:layout_height="@dimen/dp_264"
        android:layout_marginBottom="@dimen/dialog_bottom_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/text_color_tab"
            android:gravity="center"
            android:id="@+id/tv_cancel"
            android:tag="binding_2"
            android:background="@drawable/bg_my_dialog_btn_cancel"
            android:layout_width="@dimen/dp_176"
            android:layout_height="@dimen/dp_48"
            android:text="@string/cancel"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="@dimen/dp_80"
            android:layout_alignParentEnd="true"
            app:layout_constraintBottom_toBottomOf="@+id/tv_confirm"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_confirm"
            app:layout_constraintVertical_bias="0"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_confirm"
            android:tag="binding_3"
            android:background="@drawable/bg_my_dialog_btn_confirm"
            android:layout_width="@dimen/dp_176"
            android:layout_height="@dimen/dp_48"
            android:layout_marginBottom="@dimen/dp_28"
            android:text="@string/open_bluetooth"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/dp_80"
            android:layout_alignParentStart="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/text_color_tab"
            android:gravity="center"
            android:id="@+id/tv_desc"
            android:layout_width="@dimen/dp_512"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_80"
            android:text="@string/open_bluetooth_desc"
            android:layout_centerHorizontal="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
