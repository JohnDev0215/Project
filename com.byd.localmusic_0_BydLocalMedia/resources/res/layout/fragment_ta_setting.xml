<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_ta_setting_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/dp_20">
    <LinearLayout
        android:gravity="start|center_vertical"
        android:id="@+id/layoutTitle"
        android:layout_width="534dp"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dp_15"
        android:layoutDirection="locale"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageButton
            android:id="@+id/btnBack"
            android:background="@drawable/bg_icon_pressed"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:src="@drawable/icon_public_leftarrow_48_rtl"
            android:scaleType="centerCrop"/>
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/pure_main_text"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ta_settings"
            android:layout_marginStart="@dimen/dp_16"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/checkBoxContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_20"
        app:layout_constraintTop_toBottomOf="@+id/layoutTitle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
