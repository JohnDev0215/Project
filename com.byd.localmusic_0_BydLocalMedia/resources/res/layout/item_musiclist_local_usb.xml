<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_musiclist_local_usb_0"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:layout_marginBottom="8dp">
    <TextView
        android:textSize="16sp"
        android:textColor="@color/color_selector_text_index"
        android:gravity="center"
        android:id="@+id/tvIndex"
        android:tag="binding_1"
        android:background="@drawable/img_dark_media_list_bg"
        android:layout_width="50dp"
        android:layout_height="21dp"
        android:layout_marginTop="9dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/color_selector_text"
        android:ellipsize="end"
        android:id="@+id/tv_song_name"
        android:tag="binding_2"
        android:duplicateParentState="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:maxWidth="200dp"
        android:singleLine="true"
        android:textDirection="locale"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@+id/tvIndex"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_selector_sub_text"
        android:ellipsize="end"
        android:id="@+id/tv_announcer"
        android:tag="binding_3"
        android:duplicateParentState="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="200dp"
        android:singleLine="true"
        android:textDirection="locale"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@+id/tvIndex"
        app:layout_constraintTop_toBottomOf="@+id/tv_song_name"/>
    <com.byd.music.view.musicPlayingSlideView.PlayingSlideAnimView
        android:id="@+id/play_slide_view"
        android:tag="binding_4"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_like"
        android:tag="binding_5"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_delete"
        app:layout_constraintEnd_toStartOf="@+id/iv_delete"
        app:layout_constraintTop_toTopOf="@+id/iv_delete"/>
    <com.byd.music.view.CollectLottieView
        android:id="@+id/collectLottiesView"
        android:tag="binding_6"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_like"
        app:layout_constraintEnd_toEndOf="@+id/iv_like"
        app:layout_constraintStart_toStartOf="@+id/iv_like"
        app:layout_constraintTop_toTopOf="@+id/iv_like"/>
    <ImageView
        android:id="@+id/iv_delete"
        android:tag="binding_7"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/icon_dark_media_list_close_s_48"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_multi_select"
        android:tag="binding_8"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/multi_nromal_regular"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/view2"
        android:background="@color/color_divider"
        android:layout_width="0dp"
        android:layout_height="1px"
        android:layout_marginEnd="7dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
