<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:background="@color/color_bg_head_view"
    android:layout_width="match_parent"
    android:layout_height="50dp"
    android:layoutDirection="locale"
    android:paddingStart="15dp">
    <CheckBox
        android:id="@+id/group_checkbox_header"
        android:background="@android:color/transparent"
        android:focusable="false"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:button="@null"
        android:drawableStart="@drawable/media_check_selector"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_expand_arrow_header"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_expand_arrow_header"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/icon_dark_public_uparrow_s_48"
        android:scaleType="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/color_music_name"
        android:id="@+id/tv_album_name_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="110dp"
        android:text="@string/unknown_album"
        android:singleLine="true"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/img_album"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/color_gray_front"
        android:id="@+id/tv_album_artist_name_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="110dp"
        android:text="@string/unknown_artist"
        android:singleLine="true"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_album_name_header"
        app:layout_constraintStart_toEndOf="@+id/tv_album_name_header"
        app:layout_constraintTop_toTopOf="@+id/tv_album_name_header"/>
    <TextView
        android:textColor="@color/color_gray_front"
        android:id="@+id/tv_album_total_music_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/unknown_album"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_album_artist_name_header"
        app:layout_constraintStart_toEndOf="@+id/tv_album_artist_name_header"
        app:layout_constraintTop_toTopOf="@+id/tv_album_artist_name_header"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/color_gray_front"
        android:gravity="center"
        android:id="@+id/tvIndex_header"
        android:layout_width="50dp"
        android:layout_height="wrap_content"
        android:text="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:gravity="center"
        android:id="@+id/view"
        android:background="@drawable/img_dark_media_list_bg"
        android:layout_width="50dp"
        android:layout_height="20dp"
        android:layout_marginTop="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.byd.music.view.homeMusic.RoundCornerImageView
        android:id="@+id/img_album"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="12dp"
        android:layout_marginVertical="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tvIndex_header"
        app:layout_constraintTop_toTopOf="parent"
        app:roundRadius="8dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
