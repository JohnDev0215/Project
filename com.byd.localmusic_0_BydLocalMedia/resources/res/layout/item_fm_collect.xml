<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_fm_collect_0"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_60">
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="@color/color_selector_text"
        android:ellipsize="end"
        android:id="@+id/tvAlignName"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_75"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="wrap"/>
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="@color/color_selector_name_text"
        android:gravity="start"
        android:id="@+id/tvRadioName"
        android:tag="binding_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginStart="@dimen/dp_8"
        android:layout_marginEnd="@dimen/dp_12"
        app:layout_constraintEnd_toStartOf="@+id/emptyView"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toEndOf="@+id/tvAlignName"
        app:layout_constraintTop_toTopOf="@+id/tvAlignName"/>
    <View
        android:id="@+id/emptyView"
        android:layout_width="32dp"
        android:layout_height="32dp"
        app:layout_constraintEnd_toStartOf="@+id/btnRemove2"
        app:layout_constraintStart_toEndOf="@+id/tvRadioName"
        app:layout_constraintTop_toTopOf="@+id/tvAlignName"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/color_fm_type_text"
        android:gravity="center"
        android:id="@+id/tvRadioType"
        android:tag="binding_3"
        android:visibility="visible"
        android:layout_width="@dimen/dp_32"
        android:layout_height="@dimen/dp_32"
        app:layout_constraintEnd_toStartOf="@+id/btnRemove2"
        app:layout_constraintStart_toEndOf="@+id/tvRadioName"
        app:layout_constraintTop_toTopOf="@+id/tvAlignName"/>
    <com.byd.music.view.musicPlayingSlideView.PlayingSlideAnimView
        android:id="@+id/playingSlideAnimView"
        android:tag="binding_4"
        android:layout_width="@dimen/dp_32"
        android:layout_height="@dimen/dp_32"
        app:layout_constraintEnd_toStartOf="@+id/btnRemove2"
        app:layout_constraintStart_toEndOf="@+id/tvRadioName"
        app:layout_constraintTop_toTopOf="@+id/tvAlignName"/>
    <ImageButton
        android:id="@+id/btnRemove2"
        android:tag="binding_5"
        android:background="@null"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.byd.music.view.CollectLottieView
        android:id="@+id/collectLottie"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        app:layout_constraintBottom_toBottomOf="@+id/btnRemove2"
        app:layout_constraintEnd_toEndOf="@+id/btnRemove2"
        app:layout_constraintStart_toStartOf="@+id/btnRemove2"
        app:layout_constraintTop_toTopOf="@+id/btnRemove2"/>
    <View
        android:background="@color/color_radio_divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
