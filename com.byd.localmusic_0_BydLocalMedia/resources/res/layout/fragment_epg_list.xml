<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_epg_list_0"
    android:paddingTop="@dimen/dp_14"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/dp_14">
    <ImageButton
        android:id="@+id/btnBack"
        android:background="@drawable/bg_icon_pressed"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        android:src="@drawable/icon_public_leftarrow_48_rtl"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="@color/pure_main_text"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="EPG"
        android:layout_marginStart="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/btnBack"
        app:layout_constraintStart_toEndOf="@+id/btnBack"
        app:layout_constraintTop_toTopOf="@+id/btnBack"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="vertical"
        android:id="@+id/rvCurrentDabList"
        android:tag="binding_1"
        android:background="@color/color_epg_no_select"
        android:layout_width="@dimen/dp_220"
        android:layout_height="@dimen/dp_300"
        android:layout_marginTop="@dimen/dp_14"
        app:layoutManager="com.byd.music.view.CatchInconsistencyDetectedLinearLayoutManager"
        app:layout_constraintEnd_toStartOf="@+id/rvCurrentEPGList"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnBack"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="vertical"
        android:id="@+id/rvCurrentEPGList"
        android:tag="binding_2"
        android:background="@color/color_epg_selected"
        android:layout_width="@dimen/dp_340"
        android:layout_height="@dimen/dp_300"
        android:layout_marginTop="@dimen/dp_14"
        app:layoutManager="com.byd.music.view.CatchInconsistencyDetectedLinearLayoutManager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/rvCurrentDabList"
        app:layout_constraintTop_toBottomOf="@+id/btnBack"/>
    <ImageView
        android:tag="binding_3"
        android:layout_width="@dimen/dp_312"
        android:layout_height="@dimen/dp_208"
        android:layout_marginTop="@dimen/dp_90"
        android:src="@drawable/img_no_data"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:tag="binding_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_100"
        android:text="@string/radio_hint_no_channel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:tag="binding_5"
        android:layout_width="@dimen/dp_240"
        android:layout_height="@dimen/dp_156"
        android:layout_marginTop="@dimen/dp_50"
        android:src="@drawable/img_no_data"
        app:layout_constraintEnd_toEndOf="@+id/rvCurrentEPGList"
        app:layout_constraintStart_toStartOf="@+id/rvCurrentEPGList"
        app:layout_constraintTop_toTopOf="@+id/rvCurrentEPGList"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:tag="binding_6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_60"
        android:text="@string/radio_hint_no_channel"
        app:layout_constraintBottom_toBottomOf="@+id/rvCurrentEPGList"
        app:layout_constraintEnd_toEndOf="@+id/rvCurrentEPGList"
        app:layout_constraintStart_toStartOf="@+id/rvCurrentEPGList"/>
</androidx.constraintlayout.widget.ConstraintLayout>
