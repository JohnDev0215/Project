<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:tag="layout/activity_local_dialog_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:tag="binding_1"
        android:background="@drawable/bg_my_dialog_dark"
        android:layout_width="560dp"
        android:layout_height="264dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="18sp"
            android:textColor="@color/text_color_tab"
            android:gravity="center"
            android:id="@+id/tv_cancel"
            android:tag="binding_2"
            android:background="@drawable/bg_my_dialog_btn_dark"
            android:layout_width="176dp"
            android:layout_height="48dp"
            android:text="@string/cancel"
            app:layout_constraintBottom_toBottomOf="@+id/tvDiv"
            app:layout_constraintTop_toTopOf="@+id/tvDiv"/>
        <TextView
            android:id="@+id/tvDiv"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="28dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/color_my_login_or_member"
            android:gravity="center"
            android:id="@+id/tv_confirm"
            android:tag="binding_3"
            android:background="@drawable/bg_my_dialog_confirm_btn_dark"
            android:layout_width="176dp"
            android:layout_height="48dp"
            android:text="@string/delete"
            app:layout_constraintBottom_toBottomOf="@+id/tvDiv"
            app:layout_constraintTop_toTopOf="@+id/tvDiv"/>
        <TextView
            android:textSize="20sp"
            android:textColor="@color/text_color_dialog_src"
            android:gravity="center"
            android:id="@+id/tv_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="80dp"
            android:text="@string/confirm_delete_desc"
            android:layout_centerHorizontal="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
