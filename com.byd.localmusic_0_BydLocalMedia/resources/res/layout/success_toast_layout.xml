<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ll_toast"
    android:background="@drawable/bg_toast"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/dp_56">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/iv_toast"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_toast_ok"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/color_text_toast"
        android:gravity="center"
        android:id="@+id/tv_toast"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_56"
        android:maxWidth="@dimen/dp_550"
        android:text="一段很长的测试文字一段很长的测试文字一段很长的测试文字"
        android:lineSpacingMultiplier="1.2"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_toast"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginStart="15dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
