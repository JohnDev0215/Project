<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nestedScrollView"
    android:tag="layout/fragment_fm_0"
    android:scrollbars="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rootContainer"
        android:padding="@dimen/dp_15"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/groupPlayingCard"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_298"
            app:layout_constraintTop_toTopOf="parent">
            <ImageButton
                android:id="@+id/topSetting"
                android:background="@drawable/bg_icon_pressed"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:src="@drawable/icon_radio_setting"
                android:scaleType="centerCrop"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/topMirror"
                android:background="@drawable/bg_icon_pressed"
                android:visibility="gone"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:src="@drawable/icon_radio_mirror"
                android:scaleType="centerCrop"
                app:layout_constraintRight_toLeftOf="@+id/topSetting"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageButton
                android:id="@+id/topSearch"
                android:background="@drawable/bg_icon_pressed"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:src="@drawable/icon_radio_search"
                android:scaleType="centerCrop"
                app:layout_constraintRight_toLeftOf="@+id/topMirror"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/sp_40"
                android:textStyle="bold"
                android:textColor="@color/pure_main_text"
                android:gravity="end|center_vertical"
                android:id="@+id/programFrequency"
                android:tag="binding_1"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_44"
                android:hint="87.5"
                android:layoutDirection="ltr"
                app:layout_constraintBottom_toTopOf="@+id/RDSContainer"
                app:layout_constraintEnd_toStartOf="@+id/programFreqUnit"
                app:layout_constraintStart_toStartOf="parent"/>
            <TextView
                android:textSize="@dimen/sp_30"
                android:textColor="@color/pure_main_text"
                android:gravity="start|center_vertical"
                android:id="@+id/programFreqUnit"
                android:tag="binding_2"
                android:paddingBottom="@dimen/dp_3"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text=" MHz"
                android:layoutDirection="ltr"
                app:layout_constraintBaseline_toBaselineOf="@+id/programFrequency"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/programFrequency"/>
            <TextView
                android:textSize="@dimen/sp_40"
                android:textStyle="bold"
                android:textColor="@color/pure_main_text"
                android:gravity="center"
                android:id="@+id/RDSPS"
                android:tag="binding_3"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_8"
                app:layout_constraintBottom_toTopOf="@+id/RDSContainer"
                app:layout_constraintEnd_toEndOf="@+id/rulerView"
                app:layout_constraintStart_toStartOf="@+id/rulerView"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/RDSContainer"
                android:tag="binding_4"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_10"
                app:layout_constraintBottom_toTopOf="@+id/RDSRT"
                app:layout_constraintEnd_toEndOf="@+id/rulerView"
                app:layout_constraintStart_toStartOf="@+id/rulerView">
                <TextView
                    android:textSize="@dimen/sp_20"
                    android:gravity="center"
                    android:id="@+id/RDSFreq"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:hint=" 0 "
                    android:singleLine="true"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/text_color_selected"
                    android:gravity="center"
                    android:id="@+id/RDSPTY"
                    android:background="@drawable/bg_radio_pty"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:hint=" -1 "
                    android:paddingStart="@dimen/dp_4"
                    android:paddingEnd="@dimen/dp_4"
                    android:layout_marginStart="@dimen/dp_5"/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/sp_18"
                android:gravity="top|center_horizontal"
                android:id="@+id/RDSRT"
                android:tag="binding_5"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:minHeight="@dimen/dp_33"
                app:layout_constraintBottom_toTopOf="@+id/rulerView"
                app:layout_constraintEnd_toEndOf="@+id/rulerView"
                app:layout_constraintStart_toStartOf="@+id/rulerView"/>
            <com.byd.music.view.RulerView
                android:id="@+id/rulerView"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_30"
                android:layout_marginTop="@dimen/dp_170"
                android:layoutDirection="ltr"
                android:layout_marginHorizontal="@dimen/dp_56"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:layout_width="@dimen/dp_81"
                android:layout_height="@dimen/dp_48"
                android:src="@drawable/mask_ruler_start"
                android:layoutDirection="ltr"
                app:layout_constraintStart_toStartOf="@+id/rulerView"
                app:layout_constraintTop_toTopOf="@+id/btnPre"/>
            <ImageView
                android:layout_width="@dimen/dp_81"
                android:layout_height="@dimen/dp_48"
                android:src="@drawable/mask_ruler_end"
                android:layoutDirection="ltr"
                app:layout_constraintEnd_toEndOf="@+id/rulerView"
                app:layout_constraintTop_toTopOf="@+id/btnNext"/>
            <ImageButton
                android:id="@+id/btnPre"
                android:background="@drawable/bg_icon_pressed"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:src="@drawable/icon_public_leftarrow_48"
                android:scaleType="centerCrop"
                android:layoutDirection="ltr"
                android:layout_marginEnd="5dp"
                app:layout_constraintBottom_toBottomOf="@+id/rulerView"
                app:layout_constraintEnd_toStartOf="@+id/rulerView"
                app:layout_constraintTop_toTopOf="@+id/rulerView"/>
            <ImageButton
                android:id="@+id/btnNext"
                android:background="@drawable/bg_icon_pressed"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:src="@drawable/icon_public_rightarrow_48"
                android:scaleType="centerCrop"
                android:layoutDirection="ltr"
                android:layout_marginStart="5dp"
                app:layout_constraintBottom_toBottomOf="@+id/rulerView"
                app:layout_constraintStart_toEndOf="@+id/rulerView"
                app:layout_constraintTop_toTopOf="@+id/rulerView"/>
            <ImageButton
                android:id="@+id/btnCollect"
                android:tag="binding_6"
                android:background="@drawable/bg_icon_pressed"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:scaleType="centerCrop"
                android:layoutDirection="ltr"
                android:layout_marginEnd="@dimen/dp_36"
                app:layout_constraintBottom_toBottomOf="@+id/btnSearchPre"
                app:layout_constraintEnd_toStartOf="@+id/btnSearchPre"
                app:layout_constraintTop_toTopOf="@+id/btnSearchPre"/>
            <com.byd.music.view.CollectLottieView
                android:id="@+id/collectLottie"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                app:layout_constraintBottom_toBottomOf="@+id/btnCollect"
                app:layout_constraintEnd_toEndOf="@+id/btnCollect"
                app:layout_constraintStart_toStartOf="@+id/btnCollect"
                app:layout_constraintTop_toTopOf="@+id/btnCollect"/>
            <ImageButton
                android:id="@+id/btnSearchPre"
                android:tag="binding_7"
                android:background="@drawable/bg_icon_pressed"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:src="@drawable/icon_dark_card_previous_48"
                android:scaleType="centerCrop"
                android:layoutDirection="ltr"
                android:layout_marginEnd="@dimen/dp_48"
                app:layout_constraintBottom_toBottomOf="@+id/btnPlayOrPause"
                app:layout_constraintEnd_toStartOf="@+id/btnPlayOrPause"
                app:layout_constraintTop_toTopOf="@+id/btnPlayOrPause"/>
            <ImageButton
                android:id="@+id/btnPlayOrPause"
                android:tag="binding_8"
                android:background="@null"
                android:layout_width="@dimen/dp_60"
                android:layout_height="@dimen/dp_60"
                android:layout_marginTop="@dimen/dp_26"
                android:foreground="@drawable/bg_alpha_pressed"
                android:scaleType="centerCrop"
                android:layoutDirection="ltr"
                app:layout_constraintEnd_toEndOf="@+id/rulerView"
                app:layout_constraintStart_toStartOf="@+id/rulerView"
                app:layout_constraintTop_toBottomOf="@+id/rulerView"/>
            <ImageButton
                android:id="@+id/btnSearchNext"
                android:tag="binding_9"
                android:background="@drawable/bg_icon_pressed"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:src="@drawable/icon_dark_card_next_48"
                android:scaleType="centerCrop"
                android:layoutDirection="ltr"
                android:layout_marginStart="@dimen/dp_48"
                app:layout_constraintBottom_toBottomOf="@+id/btnPlayOrPause"
                app:layout_constraintStart_toEndOf="@+id/btnPlayOrPause"
                app:layout_constraintTop_toTopOf="@+id/btnPlayOrPause"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/groupProgramList"
            android:paddingTop="@dimen/dp_70"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="@dimen/dp_10"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/groupPlayingCard">
            <RadioGroup
                android:orientation="horizontal"
                android:id="@+id/rbgProgramList"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_60"
                android:weightSum="2"
                android:layoutDirection="ltr"
                android:paddingHorizontal="@dimen/dp_5"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <RadioButton
                    android:textSize="@dimen/sp_20"
                    android:textColor="@color/color_tab_selector_text"
                    android:gravity="center"
                    android:id="@+id/rbChannel"
                    android:background="@drawable/selector_radio_tab"
                    android:paddingBottom="@dimen/dp_3"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp_45"
                    android:checked="true"
                    android:button="@null"
                    android:text="@string/radio_channels"
                    android:layout_weight="1"/>
                <RadioButton
                    android:textSize="@dimen/sp_20"
                    android:textColor="@color/color_tab_selector_text"
                    android:gravity="center"
                    android:id="@+id/rbCollect"
                    android:background="@drawable/selector_radio_tab"
                    android:paddingBottom="@dimen/dp_3"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp_45"
                    android:button="@null"
                    android:text="@string/radio_collection"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp_38"/>
            </RadioGroup>
            <com.byd.viewsup.BydScrollerSupportedFrameLayout
                android:id="@+id/channelListContainer"
                android:tag="binding_10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/rbgProgramList">
                <androidx.recyclerview.widget.RecyclerView
                    android:orientation="vertical"
                    android:id="@+id/rvChannelList"
                    android:tag="binding_11"
                    android:scrollbars="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbarFadeDuration="1500"
                    android:fadeScrollbars="true"
                    app:layoutManager="com.byd.music.view.CatchInconsistencyDetectedLinearLayoutManager"/>
            </com.byd.viewsup.BydScrollerSupportedFrameLayout>
            <com.byd.viewsup.BydScrollerSupportedFrameLayout
                android:id="@+id/collectListContainer"
                android:tag="binding_12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/rbgProgramList">
                <androidx.recyclerview.widget.RecyclerView
                    android:orientation="vertical"
                    android:id="@+id/rvCollectList"
                    android:tag="binding_13"
                    android:scrollbars="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbarFadeDuration="1500"
                    android:fadeScrollbars="true"
                    app:layoutManager="com.byd.music.view.CatchInconsistencyDetectedLinearLayoutManager"/>
            </com.byd.viewsup.BydScrollerSupportedFrameLayout>
            <ImageView
                android:id="@+id/ivNoData"
                android:tag="binding_14"
                android:layout_width="@dimen/dp_312"
                android:layout_height="@dimen/dp_208"
                android:src="@drawable/img_no_data"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rbgProgramList"
                app:layout_constraintVertical_bias="0.35"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:tag="binding_15"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ivNoData"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
