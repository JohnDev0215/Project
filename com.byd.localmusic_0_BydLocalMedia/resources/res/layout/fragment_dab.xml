<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_dab_0"
    android:scrollbars="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rootContainer"
        android:padding="@dimen/dp_15"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/groupDabList"
            android:paddingTop="@dimen/dp_80"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/groupPlayingDabCard">
            <RadioGroup
                android:orientation="horizontal"
                android:id="@+id/rbgProgramList"
                android:paddingBottom="@dimen/dp_15"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:weightSum="2"
                android:layoutDirection="ltr"
                android:paddingStart="@dimen/dp_5"
                android:paddingEnd="@dimen/dp_5"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <RadioButton
                    android:textSize="@dimen/sp_20"
                    android:textColor="@color/color_tab_selector_text"
                    android:gravity="center"
                    android:id="@+id/rbChannel"
                    android:background="@drawable/selector_radio_tab"
                    android:paddingBottom="@dimen/dp_3"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp_44"
                    android:checked="true"
                    android:button="@null"
                    android:text="@string/radio_channels"
                    android:layout_weight="1"/>
                <RadioButton
                    android:textSize="@dimen/sp_20"
                    android:textColor="@color/color_tab_selector_text"
                    android:gravity="center"
                    android:id="@+id/rbCollect"
                    android:background="@drawable/selector_radio_tab"
                    android:paddingBottom="@dimen/dp_3"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp_44"
                    android:button="@null"
                    android:text="@string/radio_collection"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp_40"/>
            </RadioGroup>
            <ImageButton
                android:id="@+id/topSearch"
                android:background="@drawable/bg_icon_pressed"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:src="@drawable/icon_radio_search"
                android:scaleType="centerCrop"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageButton
                android:id="@+id/topSetting"
                android:background="@drawable/bg_icon_pressed"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:src="@drawable/icon_radio_setting"
                android:scaleType="centerCrop"
                android:layout_marginEnd="@dimen/dp_10"
                app:layout_constraintRight_toLeftOf="@+id/topSearch"
                app:layout_constraintTop_toTopOf="parent"/>
            <Button
                android:id="@+id/epg"
                android:background="@drawable/epg_icon"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:layout_marginEnd="@dimen/dp_10"
                app:layout_constraintRight_toLeftOf="@+id/topSetting"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.byd.viewsup.BydScrollerSupportedFrameLayout
                android:id="@+id/channelListContainer"
                android:tag="binding_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rbgProgramList">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvChannelList"
                    android:tag="binding_2"
                    android:scrollbars="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fadeScrollbars="false"/>
            </com.byd.viewsup.BydScrollerSupportedFrameLayout>
            <com.byd.viewsup.BydScrollerSupportedFrameLayout
                android:id="@+id/collectListContainer"
                android:tag="binding_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rbgProgramList">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCollectList"
                    android:tag="binding_4"
                    android:scrollbars="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fadeScrollbars="false"/>
            </com.byd.viewsup.BydScrollerSupportedFrameLayout>
            <ImageView
                android:id="@+id/ivNoData"
                android:tag="binding_5"
                android:layout_width="@dimen/dp_312"
                android:layout_height="@dimen/dp_208"
                android:src="@drawable/img_no_data"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rbgProgramList"
                app:layout_constraintVertical_bias="0.35"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:tag="binding_6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ivNoData"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/groupPlayingDabCard"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_298"
            android:paddingStart="@dimen/dp_6"
            android:paddingEnd="@dimen/dp_6"
            app:layout_constraintTop_toTopOf="parent">
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/dab_pic"
                android:background="#ff888888"
                android:layout_width="@dimen/dp_240"
                android:layout_height="@dimen/dp_240"
                android:foreground="@drawable/dab_album_mask"
                android:src="@drawable/album_default_248"
                android:scaleType="fitCenter"
                android:layout_marginStart="@dimen/dp_91"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearance="@style/dabImgRadiusStyle"/>
            <TextView
                android:textSize="@dimen/sp_22"
                android:textStyle="bold"
                android:textColor="@color/color_white_front"
                android:ellipsize="marquee"
                android:gravity="start"
                android:id="@+id/dab_service"
                android:layout_width="@dimen/dp_210"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:text="@string/unknown_radio_station"
                android:singleLine="true"
                android:marqueeRepeatLimit="marquee_forever"
                android:textDirection="locale"
                android:layout_marginStart="@dimen/dp_48"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/dab_pic"
                app:layout_constraintTop_toTopOf="@+id/dab_pic"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/color_white_front"
                android:gravity="start"
                android:id="@+id/dab_ensemble"
                android:layout_width="@dimen/dp_210"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_2"
                android:text="@string/dab_no_radio_ensemble"
                android:singleLine="true"
                app:layout_constraintBottom_toTopOf="@+id/dab_pty"
                app:layout_constraintStart_toStartOf="@+id/dab_service"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/color_white_front"
                android:gravity="start"
                android:id="@+id/dab_pty"
                android:layout_width="@dimen/dp_210"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_20"
                android:singleLine="true"
                app:layout_constraintBottom_toTopOf="@+id/dab_dls"
                app:layout_constraintStart_toStartOf="@+id/dab_service"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/dab_dls_text"
                android:ellipsize="marquee"
                android:gravity="start"
                android:id="@+id/dab_dls"
                android:layout_width="@dimen/dp_210"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_8"
                android:singleLine="true"
                android:marqueeRepeatLimit="marquee_forever"
                app:layout_constraintBottom_toBottomOf="@+id/dab_pic"
                app:layout_constraintStart_toStartOf="@+id/dab_service"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <Button
            android:id="@+id/btn_tune_dab"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="测试：设置电台"
            android:layout_marginStart="@dimen/dp_260"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <Button
            android:id="@+id/btn_update_list"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="测试：更新列表"
            app:layout_constraintStart_toEndOf="@+id/btn_tune_dab"
            app:layout_constraintTop_toTopOf="parent"/>
        <Button
            android:id="@+id/testbtn"
            android:visibility="gone"
            android:layout_width="50dp"
            android:layout_height="50dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
