<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_fm_settings_radio_btn"
    android:padding="@dimen/dp_10"
    android:layout_width="534dp"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dp_16"
    android:layout_marginHorizontal="@dimen/dp_16">
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/settings_switch"
        android:background="@drawable/fmam_settings_switch_bg"
        android:layout_width="@dimen/dp_64"
        android:layout_height="@dimen/dp_48"
        android:button="@null"
        android:thumb="@null"
        android:track="@null"
        android:layout_marginHorizontal="@dimen/dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="20sp"
        android:textColor="@color/color_fmam_settings_text"
        android:id="@+id/settings_switch_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
