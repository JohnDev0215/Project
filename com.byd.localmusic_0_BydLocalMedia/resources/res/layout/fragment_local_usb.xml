<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_local_usb_0"
    android:scrollbars="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_tools_container"
        android:tag="binding_1"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_search"
            android:tag="binding_2"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/icon_public_search_48"
            android:layout_marginEnd="32dp"
            app:layout_constraintBottom_toBottomOf="@+id/iv_voice"
            app:layout_constraintRight_toLeftOf="@+id/iv_voice"
            app:layout_constraintTop_toTopOf="@+id/iv_voice"/>
        <ImageView
            android:id="@+id/iv_voice"
            android:tag="binding_3"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/icon_media_audio_48"
            android:layout_marginEnd="32dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_tools_container">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/rootContainer"
            android:paddingBottom="@dimen/dp_90"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="@dimen/dp_35"
            android:paddingEnd="@dimen/dp_15">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_gravity="center"
                android:id="@+id/cl_music_info_container"
                android:tag="binding_4"
                android:paddingLeft="@dimen/dp_15"
                android:paddingTop="15dp"
                android:paddingRight="@dimen/dp_30"
                android:visibility="gone"
                android:layout_width="@dimen/dp_514"
                android:layout_height="match_parent"
                android:layoutDirection="ltr"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@+id/iv_collect"
                    android:tag="binding_5"
                    android:background="@drawable/bg_icon_pressed"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/icon_dark_media_playcollection_48"
                    app:layout_constraintBottom_toBottomOf="@+id/iv_last_music"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/iv_last_music"/>
                <com.byd.music.view.CollectLottieView
                    android:id="@+id/collectLottiesView"
                    android:visibility="gone"
                    android:layout_width="@dimen/dp_48"
                    android:layout_height="@dimen/dp_48"
                    app:layout_constraintEnd_toEndOf="@+id/iv_collect"
                    app:layout_constraintStart_toStartOf="@+id/iv_collect"
                    app:layout_constraintTop_toBottomOf="@+id/iv_last_music"
                    app:layout_constraintTop_toTopOf="@+id/iv_last_music"/>
                <ImageView
                    android:id="@+id/iv_last_music"
                    android:tag="binding_6"
                    android:background="@drawable/bg_icon_pressed"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/icon_dark_card_previous_48"
                    android:layout_marginEnd="55dp"
                    app:layout_constraintBottom_toBottomOf="@+id/iv_play_music"
                    app:layout_constraintEnd_toStartOf="@+id/iv_play_music"
                    app:layout_constraintTop_toTopOf="@+id/iv_play_music"/>
                <ImageView
                    android:id="@+id/iv_play_music"
                    android:tag="binding_7"
                    android:background="@null"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_marginTop="20dp"
                    android:foreground="@drawable/bg_alpha_pressed"
                    app:layout_constraintEnd_toEndOf="@+id/seekBar"
                    app:layout_constraintStart_toStartOf="@+id/seekBar"
                    app:layout_constraintTop_toBottomOf="@+id/seekBar"/>
                <ImageView
                    android:id="@+id/iv_next_music"
                    android:tag="binding_8"
                    android:background="@drawable/bg_icon_pressed"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/icon_dark_card_next_48"
                    android:layout_marginStart="55dp"
                    app:layout_constraintBottom_toBottomOf="@+id/iv_play_music"
                    app:layout_constraintStart_toEndOf="@+id/iv_play_music"
                    app:layout_constraintTop_toTopOf="@+id/iv_play_music"/>
                <ImageView
                    android:id="@+id/iv_play_mode"
                    android:tag="binding_9"
                    android:background="@drawable/bg_icon_pressed"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:layout_constraintBottom_toBottomOf="@+id/iv_next_music"
                    app:layout_constraintEnd_toEndOf="@+id/seekBar"
                    app:layout_constraintTop_toTopOf="@+id/iv_next_music"/>
                <SeekBar
                    android:id="@+id/seekBar"
                    android:tag="binding_10"
                    android:duplicateParentState="true"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginTop="40dp"
                    android:maxHeight="6dp"
                    android:progressDrawable="@drawable/bg_seekbar"
                    android:thumb="@drawable/bg_seekbar_thum"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:splitTrack="false"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cl_music_info"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/color_gray_front"
                    android:gravity="center"
                    android:id="@+id/tv_music_zerotime"
                    android:tag="binding_11"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginStart="15dp"
                    app:layout_constraintBottom_toTopOf="@+id/seekBar"
                    app:layout_constraintStart_toStartOf="parent"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/color_gray_front"
                    android:gravity="right"
                    android:id="@+id/tv_music_totaltime"
                    android:tag="binding_12"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginEnd="15dp"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_music_zerotime"
                    app:layout_constraintEnd_toEndOf="@+id/seekBar"
                    app:layout_constraintTop_toTopOf="@+id/tv_music_zerotime"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_music_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layoutDirection="locale"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:textColor="@color/color_music_name"
                        android:ellipsize="marquee"
                        android:id="@+id/tv_music_name"
                        android:tag="binding_13"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:singleLine="true"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:textDirection="locale"
                        android:layout_marginStart="32dp"
                        app:layout_constraintStart_toEndOf="@+id/iv_music_pic"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textColor="@color/color_gray_front"
                        android:gravity="center_vertical"
                        android:id="@+id/tv_singer_name"
                        android:tag="binding_14"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:maxWidth="376dp"
                        android:maxHeight="32dp"
                        android:singleLine="true"
                        android:textDirection="locale"
                        app:layout_constraintStart_toStartOf="@+id/tv_music_name"
                        app:layout_constraintTop_toBottomOf="@+id/tv_music_name"/>
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/iv_music_pic"
                        android:tag="binding_15"
                        android:layout_width="140dp"
                        android:layout_height="140dp"
                        android:scaleType="fitXY"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:shapeAppearanceOverlay="@style/roundedCornerStyle"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_music_main"
                android:tag="binding_16"
                android:visibility="gone"
                android:descendantFocusability="blocksDescendants"
                android:layout_width="@dimen/dp_540"
                android:layout_height="@dimen/dp_415"
                android:layoutDirection="ltr"
                android:paddingHorizontal="@dimen/dp_10">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_music_list"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <HorizontalScrollView
                        android:id="@+id/sll_view"
                        android:tag="binding_17"
                        android:visibility="gone"
                        android:scrollbars="none"
                        android:fadingEdge="horizontal"
                        android:fadingEdgeLength="0dp"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginEnd="@dimen/dp_40"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/cl_operate"
                            android:tag="binding_18"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="60dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">
                            <TextView
                                android:textSize="18sp"
                                android:textColor="@color/text_color_tab"
                                android:gravity="center_vertical"
                                android:id="@+id/tv_delete_all_tips"
                                android:tag="binding_19"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/batch_operation"
                                android:layout_marginStart="10dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>
                            <ImageView
                                android:gravity="center_vertical"
                                android:id="@+id/iv_select_all"
                                android:tag="binding_20"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_marginStart="11dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toEndOf="@+id/tv_delete_all_tips"
                                app:layout_constraintTop_toTopOf="parent"/>
                            <TextView
                                android:textSize="18sp"
                                android:textColor="@color/color_white_front"
                                android:gravity="end"
                                android:id="@+id/tv_select_all"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/select_all"
                                android:layout_marginEnd="14dp"
                                app:layout_constraintBottom_toBottomOf="@+id/iv_select_all"
                                app:layout_constraintStart_toEndOf="@+id/iv_select_all"
                                app:layout_constraintTop_toTopOf="@+id/iv_select_all"/>
                            <ImageView
                                android:gravity="center_vertical"
                                android:id="@+id/iv_delete"
                                android:tag="binding_21"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/icon_dark_public_delete_s_40"
                                android:layout_marginStart="14dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toEndOf="@+id/tv_select_all"
                                app:layout_constraintTop_toTopOf="parent"/>
                            <TextView
                                android:textSize="18sp"
                                android:textColor="@color/color_white_front"
                                android:gravity="end"
                                android:id="@+id/tv_delete"
                                android:tag="binding_22"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/delete"
                                app:layout_constraintBottom_toBottomOf="@+id/iv_delete"
                                app:layout_constraintStart_toEndOf="@+id/iv_delete"
                                app:layout_constraintTop_toTopOf="@+id/iv_delete"/>
                            <ImageView
                                android:gravity="center_vertical"
                                android:id="@+id/iv_cancel_select"
                                android:tag="binding_23"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/icon_dark_public_close_s_40"
                                android:layout_marginStart="5dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toEndOf="@+id/tv_delete"
                                app:layout_constraintTop_toTopOf="parent"/>
                            <TextView
                                android:textSize="18sp"
                                android:textColor="@color/color_white_front"
                                android:gravity="end"
                                android:id="@+id/tv_cancel_select"
                                android:tag="binding_24"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/cancel"
                                android:layout_marginEnd="48dp"
                                app:layout_constraintBottom_toBottomOf="@+id/iv_cancel_select"
                                app:layout_constraintStart_toEndOf="@+id/iv_cancel_select"
                                app:layout_constraintTop_toTopOf="@+id/iv_cancel_select"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </HorizontalScrollView>
                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/tabLayout"
                        android:tag="binding_25"
                        android:fadingEdge="horizontal"
                        android:fadingEdgeLength="150dp"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:requiresFadingEdge="horizontal"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tabGravity="center"
                        app:tabIndicator="@drawable/tab_indicator"
                        app:tabIndicatorAnimationDuration="0"
                        app:tabIndicatorColor="@color/color_tab_indicator"
                        app:tabMinWidth="@dimen/dp_105"
                        app:tabMode="fixed"
                        app:tabPaddingBottom="6dp"
                        app:tabRippleColor="@null"
                        app:tabTextAppearance="@style/tabLayout_text_size_singer"
                        app:tabTextColor="@color/color_tab_selector_text">
                        <com.google.android.material.tabs.TabItem
                            android:textSize="@dimen/sp_20"
                            android:id="@+id/tab_all_music"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/local_songlist_music_count_search"/>
                        <com.google.android.material.tabs.TabItem
                            android:textSize="@dimen/sp_20"
                            android:id="@+id/tab_collect_music"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/radio_collection"/>
                        <com.google.android.material.tabs.TabItem
                            android:textSize="@dimen/sp_20"
                            android:id="@+id/tab_singer_music"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/singer"/>
                        <com.google.android.material.tabs.TabItem
                            android:textSize="@dimen/sp_20"
                            android:id="@+id/tab_album_music"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/local_songlist_album_count_search"/>
                    </com.google.android.material.tabs.TabLayout>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_local_music_list"
                        android:tag="binding_26"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginTop="16dp"
                        android:textDirection="locale"
                        android:layoutDirection="locale"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="40dp"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tabLayout"
                        app:layout_goneMarginTop="76dp"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_local_music_list_collect"
                        android:tag="binding_27"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginTop="16dp"
                        android:textDirection="locale"
                        android:layoutDirection="locale"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="40dp"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tabLayout"
                        app:layout_goneMarginTop="76dp"/>
                    <com.byd.music.view.HeaderExpandListview
                        android:id="@+id/el_artist_album_list"
                        android:scrollbars="none"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginTop="16dp"
                        android:listSelector="@android:color/transparent"
                        android:groupIndicator="@null"
                        android:childDivider="@android:color/transparent"
                        android:divider="@android:color/transparent"
                        android:dividerHeight="30dp"
                        android:textDirection="locale"
                        android:layoutDirection="locale"
                        android:layout_marginEnd="40dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tabLayout"
                        app:layout_goneMarginTop="76dp"/>
                    <ImageView
                        android:id="@+id/iv_no_content"
                        android:tag="binding_28"
                        android:visibility="gone"
                        android:layout_width="312dp"
                        android:layout_height="208dp"
                        android:layout_marginTop="43dp"
                        android:layout_marginEnd="40dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="16sp"
                        android:gravity="center"
                        android:id="@+id/tv_no_content"
                        android:tag="binding_29"
                        android:visibility="gone"
                        android:layout_width="272dp"
                        android:layout_height="wrap_content"
                        android:text="@string/no_music"
                        app:layout_constraintEnd_toEndOf="@+id/iv_no_content"
                        app:layout_constraintStart_toStartOf="@+id/iv_no_content"
                        app:layout_constraintTop_toBottomOf="@+id/iv_no_content"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layoutDirection="locale"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <TextView
                            android:textSize="20sp"
                            android:textColor="@color/colorLight"
                            android:gravity="center"
                            android:id="@+id/slide_letter"
                            android:background="@drawable/icon_light_media_bubble_48"
                            android:visibility="invisible"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginTop="80dp"
                            android:paddingEnd="2dp"
                            android:layout_marginEnd="25dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <com.byd.music.view.SlideBar
                            android:layout_gravity="end"
                            android:id="@+id/slide_bar_letter"
                            android:tag="binding_30"
                            android:visibility="gone"
                            android:clickable="true"
                            android:layout_width="12dp"
                            android:layout_height="@dimen/dp_330"
                            android:layout_marginTop="66dp"
                            android:layout_marginBottom="18dp"
                            android:layout_marginEnd="24dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <com.byd.music.view.LoadingView
                    android:id="@+id/loading_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <ImageView
        android:id="@+id/no_sd_usb_iv"
        android:tag="binding_31"
        android:layout_width="@dimen/dp_312"
        android:layout_height="@dimen/dp_208"
        android:layout_marginTop="57dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_tools_container"/>
    <TextView
        android:textSize="16sp"
        android:gravity="center"
        android:id="@+id/no_sd_usb_tips_tv"
        android:tag="binding_32"
        android:layout_width="@dimen/dp_272"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/no_sd_usb_iv"
        app:layout_constraintStart_toStartOf="@+id/no_sd_usb_iv"
        app:layout_constraintTop_toBottomOf="@+id/no_sd_usb_iv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
