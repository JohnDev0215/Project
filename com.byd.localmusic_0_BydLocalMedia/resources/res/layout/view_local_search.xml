<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/imgBg"
        android:background="@drawable/bg_search_et"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_search"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        android:src="@drawable/icon_search"
        android:contentDescription="搜索"
        android:layout_marginStart="@dimen/dp_8"
        app:layout_constraintBottom_toBottomOf="@+id/imgBg"
        app:layout_constraintStart_toStartOf="@+id/imgBg"
        app:layout_constraintTop_toTopOf="@+id/imgBg"/>
    <EditText
        android:textColor="@color/selector_search_edit_text"
        android:textColorHint="@color/text_color_search_hint"
        android:gravity="center_vertical"
        android:id="@+id/edittext"
        android:background="@color/transparent"
        android:padding="@dimen/dp_10"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_48"
        android:hint="@string/search_hint"
        android:maxLines="1"
        android:singleLine="true"
        android:inputType="textNoSuggestions"
        android:imeOptions="actionSearch"
        android:textDirection="locale"
        android:layoutDirection="locale"
        android:layout_marginEnd="-8dp"
        android:autofillHints="搜索输入框"
        app:layout_constraintBottom_toBottomOf="@+id/imgBg"
        app:layout_constraintEnd_toStartOf="@+id/iv_delete"
        app:layout_constraintStart_toEndOf="@+id/iv_search"
        app:layout_constraintTop_toTopOf="@+id/imgBg"/>
    <ImageView
        android:id="@+id/iv_delete"
        android:visibility="gone"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_40"
        android:src="@drawable/icon_clear"
        android:contentDescription="删除按钮"
        android:layout_marginEnd="@dimen/dp_8"
        app:layout_constraintBottom_toBottomOf="@+id/imgBg"
        app:layout_constraintEnd_toEndOf="@+id/imgBg"
        app:layout_constraintTop_toTopOf="@+id/imgBg"/>
</androidx.constraintlayout.widget.ConstraintLayout>
