<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/global_window_traffic"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:background="@color/color_dialog_obscuration"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/global_traffic_window_child"
        android:background="@drawable/bg_my_dialog_dark"
        android:layout_width="@dimen/dp_560"
        android:layout_height="@dimen/dp_440"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/traffic_view4"
        android:background="@color/color_radio_divider"
        android:layout_width="560dp"
        android:layout_height="@dimen/dp_1"
        android:layout_marginTop="@dimen/dp_71"
        app:layout_constraintEnd_toEndOf="@+id/global_traffic_window_child"
        app:layout_constraintStart_toStartOf="@+id/global_traffic_window_child"
        app:layout_constraintTop_toTopOf="@+id/global_traffic_window_child"/>
    <TextView
        android:textSize="@dimen/sp_22"
        android:textColor="@color/color_music_name"
        android:id="@+id/traffic_textView_glb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/traffic_title"
        app:layout_constraintBottom_toTopOf="@+id/traffic_view4"
        app:layout_constraintEnd_toEndOf="@+id/global_traffic_window_child"
        app:layout_constraintStart_toStartOf="@+id/global_traffic_window_child"
        app:layout_constraintTop_toTopOf="@+id/global_traffic_window_child"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="@color/color_music_name"
        android:id="@+id/global_traffic_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_37"
        android:text="@string/global_traffic_information"
        app:layout_constraintEnd_toEndOf="@+id/global_traffic_window_child"
        app:layout_constraintStart_toStartOf="@+id/global_traffic_window_child"
        app:layout_constraintTop_toBottomOf="@+id/imageView"/>
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_139"
        android:layout_marginTop="@dimen/dp_60"
        android:src="@drawable/tiffact_trumpet_img"
        android:scaleType="centerInside"
        app:layout_constraintEnd_toEndOf="@+id/global_traffic_window_child"
        app:layout_constraintStart_toStartOf="@+id/global_traffic_window_child"
        app:layout_constraintTop_toBottomOf="@+id/traffic_view4"/>
    <Button
        android:textSize="@dimen/sp_18"
        android:textColor="@color/color_local_search_text"
        android:id="@+id/traffic_btn"
        android:background="@drawable/traffic_window_btn_bg"
        android:layout_width="@dimen/dp_176"
        android:layout_height="@dimen/dp_48"
        android:layout_marginBottom="@dimen/dp_28"
        android:text="@string/cancel"
        app:layout_constraintBottom_toBottomOf="@+id/global_traffic_window_child"
        app:layout_constraintEnd_toEndOf="@+id/global_traffic_window_child"
        app:layout_constraintStart_toStartOf="@+id/global_traffic_window_child"/>
</androidx.constraintlayout.widget.ConstraintLayout>
