<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/global_window"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:background="@color/color_dialog_obscuration"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/global_window_child"
        android:background="@drawable/bg_my_dialog_dark"
        android:layout_width="@dimen/dp_560"
        android:layout_height="@dimen/dp_400"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/view4"
        android:background="@color/color_radio_divider"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_1"
        android:layout_marginTop="@dimen/dp_71"
        app:layout_constraintEnd_toEndOf="@+id/global_window_child"
        app:layout_constraintStart_toStartOf="@+id/global_window_child"
        app:layout_constraintTop_toTopOf="@+id/global_window_child"
        app:layout_constraintWidth_percent="0.438"/>
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="@color/global_window_title"
        android:id="@+id/textView_glb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/alram_title"
        app:layout_constraintBottom_toTopOf="@+id/view4"
        app:layout_constraintEnd_toEndOf="@+id/global_window_child"
        app:layout_constraintStart_toStartOf="@+id/global_window_child"
        app:layout_constraintTop_toTopOf="@+id/global_window_child"/>
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="@color/global_content"
        android:id="@+id/global_alarm_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_80"
        android:text="@string/global_alarm_information"
        app:layout_constraintBottom_toBottomOf="@+id/global_window_child"
        app:layout_constraintEnd_toEndOf="@+id/global_window_child"
        app:layout_constraintStart_toStartOf="@+id/global_window_child"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_44"
        android:src="@drawable/main_alrm"
        android:scaleType="centerInside"
        app:layout_constraintEnd_toEndOf="@+id/global_window_child"
        app:layout_constraintStart_toStartOf="@+id/global_window_child"
        app:layout_constraintTop_toBottomOf="@+id/view4"/>
</androidx.constraintlayout.widget.ConstraintLayout>
