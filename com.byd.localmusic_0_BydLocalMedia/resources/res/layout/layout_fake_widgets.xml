<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/iv_fake_navi"
        android:background="@drawable/iv_card_bg_navigation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_24"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/iv_fake_music"
        android:background="@drawable/iv_card_bg_media_music"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_24"
        app:layout_constraintStart_toEndOf="@+id/iv_fake_navi"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/iv_fake_mycar"
        android:background="@drawable/iv_card_bg_mycar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_24"
        app:layout_constraintStart_toEndOf="@+id/iv_fake_music"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
