<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_dab_station_0"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_60">
    <View
        android:background="#24262d33"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_marginEnd="5dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivStationImg"
        android:tag="binding_1"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_40"
        android:foreground="@drawable/dab_small_album_mask"
        android:scaleType="centerCrop"
        android:layout_marginStart="@dimen/dp_14"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearance="@style/dabImgSmallRadiusStyle"/>
    <TextView
        android:textSize="@dimen/sp_19"
        android:textColor="@color/color_selector_text"
        android:gravity="start"
        android:id="@+id/tvDabTitle"
        android:tag="binding_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/unknown_radio_station"
        android:singleLine="true"
        android:layout_marginStart="@dimen/dp_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/playingSlide"
        app:layout_constraintStart_toEndOf="@+id/ivStationImg"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/clock"
        android:tag="binding_3"
        android:layout_width="@dimen/dp_24"
        android:layout_height="@dimen/dp_24"
        android:src="@drawable/epg_clock"
        android:layout_marginStart="@dimen/dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tvDabTitle"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.byd.music.view.musicPlayingSlideView.PlayingSlideAnimView
        android:id="@+id/playingSlide"
        android:tag="binding_4"
        android:layout_width="@dimen/dp_30"
        android:layout_height="@dimen/dp_30"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnCollect"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageButton
        android:id="@+id/btnCollect"
        android:tag="binding_5"
        android:background="@null"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        android:scaleType="centerCrop"
        android:layout_marginEnd="@dimen/dp_14"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.byd.music.view.CollectLottieView
        android:id="@+id/collectLottie"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        app:layout_constraintBottom_toBottomOf="@+id/btnCollect"
        app:layout_constraintEnd_toEndOf="@+id/btnCollect"
        app:layout_constraintStart_toStartOf="@+id/btnCollect"
        app:layout_constraintTop_toTopOf="@+id/btnCollect"/>
</androidx.constraintlayout.widget.ConstraintLayout>
