<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:paddingStart="30dp">
    <CheckBox
        android:id="@+id/group_artist_checkbox"
        android:background="@android:color/transparent"
        android:focusable="false"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:button="@null"
        android:drawableStart="@drawable/media_check_selector"
        app:layout_constraintBottom_toBottomOf="@+id/tv_artist_name"
        app:layout_constraintEnd_toStartOf="@+id/iv_expand_arrow_artist"
        app:layout_constraintTop_toTopOf="@+id/tv_artist_name"/>
    <ImageView
        android:id="@+id/iv_expand_arrow_artist"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/icon_dark_public_dowmarrow_s_48"
        android:scaleType="center"
        app:layout_constraintBottom_toBottomOf="@+id/tv_artist_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_artist_name"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/color_white_front"
        android:gravity="center"
        android:id="@+id/tv_artist_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxWidth="200dp"
        android:singleLine="true"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@+id/img_artist"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/color_gray_front"
        android:id="@+id/tv_total_music"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_artist_name"
        app:layout_constraintStart_toEndOf="@+id/tv_artist_name"
        app:layout_constraintTop_toTopOf="@+id/tv_artist_name"/>
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/img_artist"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/icon_dark_status_bar_personal_48"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/tvIndex"
        app:layout_constraintStart_toEndOf="@+id/tvIndex"
        app:layout_constraintTop_toTopOf="@+id/tvIndex"
        app:shapeAppearance="@style/roundedCornerStyle"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/color_gray_front"
        android:gravity="center"
        android:id="@+id/tvIndex"
        android:background="@drawable/img_dark_media_list_bg"
        android:layout_width="50dp"
        android:layout_height="21dp"
        android:layout_marginTop="10dp"
        android:text="1"
        android:includeFontPadding="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/view2"
        android:background="@color/color_divider"
        android:layout_width="0dp"
        android:layout_height="1px"
        android:layout_marginEnd="7dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
