<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_constraint"
    android:tag="layout/activity_media_main_0"
    android:background="@drawable/app_bg"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.byd.viewsup.BydScrollerSupportedFrameLayout
        android:id="@+id/horizontalSourceListContainer"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        app:bydOrientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="horizontal"
            android:id="@+id/horizontalSourceList"
            android:tag="binding_1"
            android:fadingEdgeLength="100dp"
            android:clipToPadding="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fadeScrollbars="true"
            android:requiresFadingEdge="horizontal"
            android:paddingHorizontal="@dimen/dp_24"
            app:layoutManager="com.byd.music.view.CatchInconsistencyDetectedLinearLayoutManager"/>
    </com.byd.viewsup.BydScrollerSupportedFrameLayout>
    <com.byd.viewsup.BydScrollerSupportedFrameLayout
        android:id="@+id/verticalSourceListContainer"
        android:tag="binding_2"
        android:paddingTop="-4dp"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_320"
        app:bydOrientation="vertical"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="vertical"
            android:id="@+id/verticalSourceList"
            android:tag="binding_3"
            android:fadingEdgeLength="50dp"
            android:clipToPadding="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fadeScrollbars="true"
            android:requiresFadingEdge="vertical"
            app:layoutManager="com.byd.music.view.CatchInconsistencyDetectedLinearLayoutManager"/>
    </com.byd.viewsup.BydScrollerSupportedFrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bt_music_battery"
        android:tag="binding_4"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_71"
        android:layout_marginBottom="@dimen/dp_144"
        android:layout_marginStart="@dimen/dp_21"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/verticalSourceListContainer">
        <ImageView
            android:id="@+id/bt_bluetooth"
            android:tag="binding_5"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:tag="binding_6"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:src="@drawable/bt_no_battery"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/color_selector_text"
            android:ellipsize="end"
            android:id="@+id/textView"
            android:tag="binding_7"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/dp_150"
            android:singleLine="true"
            android:paddingStart="@dimen/dp_10"
            android:paddingEnd="@dimen/dp_10"
            android:layout_marginStart="@dimen/dp_40"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:tag="binding_8"
        android:paddingBottom="20dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/horizontalSourceListContainer"/>
</androidx.constraintlayout.widget.ConstraintLayout>
