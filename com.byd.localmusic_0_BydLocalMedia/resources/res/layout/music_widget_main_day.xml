<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/dp_400"
    android:layout_height="@dimen/dp_116">
    <ImageView
        android:id="@+id/music_widget_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/iv_select_mask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/iv_music_pic"
        android:layout_width="@dimen/dp_64"
        android:layout_height="@dimen/dp_64"/>
    <ImageView
        android:id="@+id/iv_music_progress"
        android:layout_width="@dimen/dp_64"
        android:layout_height="@dimen/dp_64"/>
    <ImageView
        android:id="@+id/iv_music_type"
        android:layout_width="@dimen/dp_20"
        android:layout_height="@dimen/dp_20"/>
    <TextView
        android:id="@+id/tv_music_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <TextView
        android:id="@+id/tv_music_singer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <ImageButton
        android:id="@+id/btn_previous"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"/>
    <ImageButton
        android:id="@+id/btn_play_pause"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"/>
    <ImageButton
        android:id="@+id/btn_next"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"/>
    <ImageView
        android:id="@+id/iv_app_shift"
        android:layout_width="@dimen/dp_10"
        android:layout_height="@dimen/dp_10"/>
</RelativeLayout>
