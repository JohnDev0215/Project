<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_music_bluetooth_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="@dimen/dp_32"
            android:paddingEnd="@dimen/dp_32">
            <ImageView
                android:id="@+id/iv_voice"
                android:tag="binding_1"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/icon_dark_media_audio_48"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/selector_back_text_icon"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_content"
                android:tag="binding_2"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="@dimen/dp_33"
                android:paddingEnd="@dimen/dp_84"
                app:layout_constraintTop_toBottomOf="@+id/iv_voice">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/llBlueContent"
                    android:tag="binding_3"
                    android:layout_width="540dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="106dp"
                    android:layout_marginTop="34dp"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:textSize="34sp"
                        android:textColor="@color/color_bt_song_name"
                        android:ellipsize="marquee"
                        android:gravity="center_vertical"
                        android:id="@+id/tv_music_name"
                        android:tag="binding_4"
                        android:layout_width="wrap_content"
                        android:layout_height="50dp"
                        android:singleLine="true"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"/>
                    <TextView
                        android:textSize="20sp"
                        android:textColor="@color/color_gray_front"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:id="@+id/tv_singer"
                        android:tag="binding_5"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginTop="10dp"
                        android:lines="1"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"/>
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/iv_icon_album_port"
                        android:tag="binding_6"
                        android:layout_width="140dp"
                        android:layout_height="140dp"
                        android:layout_marginTop="30dp"
                        android:src="@drawable/album_default_248"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintLeft_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:shapeAppearanceOverlay="@style/roundedCornerStyle"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_gravity="left"
                        android:id="@+id/cl_progress"
                        android:layout_width="580dp"
                        android:layout_height="52dp"
                        android:layout_marginTop="36dp"
                        android:layoutDirection="ltr"
                        android:paddingStart="6dp"
                        android:paddingEnd="0dp"
                        android:layout_marginEnd="10dp">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/color_gray_front"
                            android:gravity="center"
                            android:id="@+id/tv_radio_current_time"
                            android:tag="binding_7"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/color_gray_front"
                            android:gravity="center"
                            android:id="@+id/tv_radio_total_time"
                            android:tag="binding_8"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="13dp"
                            app:layout_constraintEnd_toEndOf="@+id/seekBar"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <SeekBar
                            android:id="@+id/seekBar"
                            android:tag="binding_9"
                            android:layout_width="540dp"
                            android:layout_height="40dp"
                            android:layout_marginTop="6dp"
                            android:maxHeight="6dp"
                            android:progressDrawable="@drawable/bg_seekbar"
                            android:thumb="@drawable/bg_seekbar_thum"
                            android:layout_marginStart="-6dp"
                            android:layout_marginEnd="-6dp"
                            android:splitTrack="false"
                            android:paddingHorizontal="15dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_gravity="left"
                        android:id="@+id/clControl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="57dp"
                        android:layout_marginBottom="10dp"
                        android:layoutDirection="ltr"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp">
                        <Button
                            android:id="@+id/bt_radio_play_pre"
                            android:background="@drawable/icon_dark_card_previous_48"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layoutDirection="ltr"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <ImageButton
                            android:id="@+id/bt_radio_play"
                            android:tag="binding_10"
                            android:background="@null"
                            android:layout_width="@dimen/dp_60"
                            android:layout_height="@dimen/dp_60"
                            android:foreground="@drawable/bg_alpha_pressed"
                            android:layoutDirection="ltr"
                            android:layout_marginHorizontal="72dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <Button
                            android:id="@+id/bt_radio_play_next"
                            android:background="@drawable/icon_dark_card_next_48"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layoutDirection="ltr"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:tag="binding_11"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_marginStart="0dp"
                        app:layout_constraintStart_toStartOf="parent">
                        <LinearLayout
                            android:id="@+id/ll_bluetooth"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">
                            <ImageView
                                android:id="@+id/bt_bluetooth"
                                android:tag="binding_12"
                                android:layout_width="@dimen/dp_48"
                                android:layout_height="@dimen/dp_48"/>
                            <ImageView
                                android:id="@+id/imageView2"
                                android:tag="binding_13"
                                android:layout_width="@dimen/dp_48"
                                android:layout_height="@dimen/dp_48"
                                android:src="@drawable/bt_no_battery"/>
                        </LinearLayout>
                        <TextView
                            android:textSize="@dimen/sp_20"
                            android:textColor="@color/color_selector_text"
                            android:ellipsize="end"
                            android:id="@+id/textView"
                            android:tag="binding_14"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxWidth="@dimen/dp_150"
                            android:singleLine="true"
                            app:layout_constraintBottom_toBottomOf="@+id/ll_bluetooth"
                            app:layout_constraintStart_toEndOf="@+id/ll_bluetooth"
                            app:layout_constraintTop_toTopOf="@+id/ll_bluetooth"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_icon_ablum"
                    android:tag="binding_15"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_marginTop="74dp"
                    android:src="@drawable/album_default_248"
                    app:layout_constraintTop_toTopOf="parent"
                    app:shapeAppearanceOverlay="@style/roundedCornerStyle"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_no_connect"
                android:tag="binding_16"
                android:paddingTop="45dp"
                android:paddingBottom="10dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_constraintTop_toBottomOf="@+id/iv_voice">
                <ImageView
                    android:id="@+id/iv_no_connect"
                    android:layout_width="312dp"
                    android:layout_height="208dp"
                    android:src="@drawable/ic_bluetooth_not_connected"
                    android:scaleType="centerCrop"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/color_gray_front"
                    android:id="@+id/tv_no_connect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bluetooth_no_connect"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/iv_no_connect"/>
                <TextView
                    android:textSize="18sp"
                    android:textColor="@color/text_connect_bluetooth"
                    android:gravity="center"
                    android:id="@+id/tv_to_connect"
                    android:tag="binding_17"
                    android:background="@drawable/bg_bluetooth_to_connect"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="24dp"
                    android:minWidth="160dp"
                    android:paddingHorizontal="22dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_no_connect"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/androidauto"
                android:background="@color/main_tab_bg"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="513dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@+id/auto_img_tow"
                    android:layout_width="@dimen/dp_100"
                    android:layout_height="@dimen/dp_80"
                    android:src="@drawable/bluetooth_auto"
                    app:layout_constraintBottom_toTopOf="@+id/auto_text_phone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed"/>
                <TextView
                    android:textSize="18sp"
                    android:textColor="@color/bt_aa_txt_color"
                    android:gravity="center"
                    android:id="@+id/auto_text_phone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:layout_marginBottom="@dimen/dp_40"
                    android:text="@string/auto_text_phone"
                    android:lineSpacingExtra="@dimen/dp_6"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@+id/auto_img_tow"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="@+id/auto_img_tow"
                    app:layout_constraintTop_toBottomOf="@+id/auto_img_tow"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
