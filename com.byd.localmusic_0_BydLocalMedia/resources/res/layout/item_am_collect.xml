<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_am_collect_0"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_60">
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="@color/color_selector_text"
        android:ellipsize="end"
        android:id="@+id/tvAlignName"
        android:tag="binding_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_75"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="wrap"/>
    <com.byd.music.view.musicPlayingSlideView.PlayingSlideAnimView
        android:id="@+id/playingSlideAnimView2"
        android:tag="binding_2"
        android:layout_width="@dimen/dp_32"
        android:layout_height="@dimen/dp_32"
        app:layout_constraintBottom_toBottomOf="@+id/tvAlignName"
        app:layout_constraintEnd_toStartOf="@+id/btnRemove2"
        app:layout_constraintTop_toTopOf="@+id/tvAlignName"/>
    <ImageButton
        android:id="@+id/btnRemove2"
        android:tag="binding_3"
        android:background="@null"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.byd.music.view.CollectLottieView
        android:id="@+id/collectLottie"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        app:layout_constraintBottom_toBottomOf="@+id/btnRemove2"
        app:layout_constraintEnd_toEndOf="@+id/btnRemove2"
        app:layout_constraintStart_toStartOf="@+id/btnRemove2"
        app:layout_constraintTop_toTopOf="@+id/btnRemove2"/>
    <View
        android:background="@color/color_radio_divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
