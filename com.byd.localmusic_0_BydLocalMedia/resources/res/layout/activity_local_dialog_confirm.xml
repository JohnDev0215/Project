<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:tag="layout/activity_local_dialog_confirm_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:id="@+id/cl_content"
        android:tag="binding_1"
        android:background="@drawable/bg_my_dialog_dark"
        android:layout_width="560dp"
        android:layout_height="312dp"
        android:layout_marginTop="50dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/text_color_tab"
            android:gravity="center"
            android:id="@+id/tv_delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_22"
            android:text="@string/deleting"
            android:layout_centerHorizontal="true"
            app:layout_constraintEnd_toEndOf="@+id/seekBar"
            app:layout_constraintStart_toStartOf="@+id/seekBar"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/view"
            android:background="@color/color_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_delete"/>
        <SeekBar
            android:id="@+id/seekBar"
            android:tag="binding_2"
            android:layout_width="460dp"
            android:layout_height="40dp"
            android:layout_marginBottom="144dp"
            android:maxHeight="6dp"
            android:progressDrawable="@drawable/bg_seekbar"
            android:thumb="@drawable/bg_seekbar_thum"
            android:splitTrack="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_22"
            android:textColor="@color/text_color_tab"
            android:id="@+id/tv_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/seekBar"
            app:layout_constraintEnd_toEndOf="@+id/seekBar"
            app:layout_constraintStart_toStartOf="@+id/seekBar"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/text_color_tab"
            android:gravity="center"
            android:id="@+id/tv_cancel_delete"
            android:background="@drawable/bg_my_dialog_cancel_btn_dark"
            android:layout_width="176dp"
            android:layout_height="48dp"
            android:layout_marginTop="56dp"
            android:text="@string/cancel"
            app:layout_constraintEnd_toEndOf="@+id/seekBar"
            app:layout_constraintStart_toStartOf="@+id/seekBar"
            app:layout_constraintTop_toBottomOf="@+id/seekBar"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
