<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="5dp"/>
            <gradient
                android:startColor="@color/bg_seekbar"
                android:endColor="@color/bg_seekbar"
                android:angle="270"
                android:centerY="0.75"
                android:centerColor="@color/bg_seekbar"/>
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape>
                <corners android:radius="5dp"/>
                <solid android:color="@color/bg_color_item_music_name"/>
            </shape>
        </clip>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="5dp"/>
                <gradient
                    android:startColor="#ff1590fa"
                    android:endColor="#ff00aceb"
                    android:angle="0"/>
            </shape>
        </clip>
    </item>
</layer-list>
