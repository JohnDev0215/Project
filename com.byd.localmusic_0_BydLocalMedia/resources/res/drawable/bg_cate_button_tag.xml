<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#a600aceb"
                android:endColor="#a61590fa"
                android:angle="180"/>
            <corners android:radius="36dp"/>
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#ff00aceb"
                android:endColor="#ff1590fa"
                android:angle="180"/>
            <corners android:radius="36dp"/>
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape>
            <solid android:color="@color/color_bg_search_tag_disable"/>
            <corners android:radius="36dp"/>
            <stroke
                android:width="1px"
                android:color="@color/color_bg_search_tag_disable_stroke"/>
        </shape>
    </item>
    <item android:state_selected="false">
        <shape>
            <solid android:color="@color/color_bg_search_tag"/>
            <corners android:radius="36dp"/>
            <stroke
                android:width="1px"
                android:color="@color/color_bg_search_tag_stroke"/>
        </shape>
    </item>
</selector>
