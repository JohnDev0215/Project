<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout-sw580dp/fragment_local_search_0"
    android:paddingTop="@dimen/dp_68"
    android:paddingBottom="60dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/dp_5">
    <ImageView
        android:id="@+id/iv_local_music"
        android:visibility="gone"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        android:src="@drawable/icon_local_search"
        android:layout_marginEnd="@dimen/dp_28"
        app:layout_constraintBottom_toBottomOf="@+id/ll_search_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ll_search_bar"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_search_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp_24"
        app:layout_constraintEnd_toStartOf="@+id/iv_local_music"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/icon_search_back"
            android:tag="binding_1"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:src="@drawable/icon_public_leftarrow_48_rtl"
            android:layout_marginStart="@dimen/dp_28"/>
        <com.byd.music.view.LocalSearchView
            android:gravity="center_vertical"
            android:id="@+id/et_local_search"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_48"
            android:maxLines="1"
            android:drawablePadding="@dimen/dp_10"
            android:inputType="textCapWords"
            android:imeOptions="actionSearch"
            android:layoutDirection="locale"
            android:layout_marginStart="@dimen/dp_24"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/flHolderMask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dp_50"
        android:layout_marginBottom="@dimen/dp_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/rg_local_search"
        app:layout_constraintTop_toBottomOf="@+id/ll_search_bar"/>
    <FrameLayout
        android:id="@+id/fl_tab_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_20"
        android:layoutDirection="locale"
        android:layout_marginStart="@dimen/dp_20"
        app:layout_constraintLeft_toLeftOf="@+id/ll_search_bar"
        app:layout_constraintRight_toRightOf="@+id/ll_search_bar"
        app:layout_constraintTop_toBottomOf="@+id/ll_search_bar">
        <com.google.android.material.tabs.TabLayout
            android:orientation="horizontal"
            android:id="@+id/tabLayout_local_search"
            android:tag="binding_2"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_48"
            android:requiresFadingEdge="horizontal"
            android:layoutDirection="locale"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="parent"
            app:tabGravity="center"
            app:tabIndicator="@drawable/tab_indicator"
            app:tabIndicatorAnimationDuration="0"
            app:tabIndicatorColor="@color/color_tab_indicator"
            app:tabMinWidth="@dimen/dp_50"
            app:tabPaddingBottom="6dp"
            app:tabPaddingEnd="@dimen/dp_20"
            app:tabPaddingStart="@dimen/dp_20"
            app:tabRippleColor="@null"
            app:tabTextAppearance="@style/tabLayout_text_size_search"
            app:tabTextColor="@color/color_tab_selector_text">
            <com.google.android.material.tabs.TabItem
                android:id="@+id/tab_music_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/local_songlist_music_count_search"/>
            <com.google.android.material.tabs.TabItem
                android:id="@+id/tab_artist_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/local_songlist_artist_count_search"/>
            <com.google.android.material.tabs.TabItem
                android:id="@+id/tab_album_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/local_songlist_album_count_search"/>
        </com.google.android.material.tabs.TabLayout>
    </FrameLayout>
    <RadioGroup
        android:orientation="horizontal"
        android:id="@+id/rg_local_search"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_20"
        android:layout_marginStart="@dimen/dp_84"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_search_bar">
        <RadioButton
            android:textSize="@dimen/sp_18"
            android:textColor="@color/color_selector_text"
            android:layout_gravity="center_vertical"
            android:id="@+id/rtn_musiclist"
            android:tag="binding_3"
            android:background="@color/transparent"
            android:layout_width="@dimen/dp_140"
            android:layout_height="wrap_content"
            android:checked="true"
            android:button="@null"
            android:scaleType="fitXY"
            android:drawablePadding="-6dp"
            android:drawableTint="@color/color_selector_text"/>
        <RadioButton
            android:textSize="@dimen/sp_18"
            android:textColor="@color/color_selector_text"
            android:layout_gravity="center_vertical"
            android:id="@+id/rtn_musiclist_singer"
            android:tag="binding_4"
            android:background="@color/transparent"
            android:layout_width="@dimen/dp_140"
            android:layout_height="wrap_content"
            android:button="@null"
            android:scaleType="fitXY"
            android:drawablePadding="-6dp"
            android:drawableTint="@color/color_selector_text"/>
        <RadioButton
            android:textSize="@dimen/sp_18"
            android:textColor="@color/color_selector_text"
            android:layout_gravity="center_vertical"
            android:id="@+id/rtn_musiclist_album"
            android:tag="binding_5"
            android:background="@color/transparent"
            android:layout_width="@dimen/dp_140"
            android:layout_height="wrap_content"
            android:button="@null"
            android:scaleType="fitXY"
            android:drawablePadding="-6dp"
            android:drawableTint="@color/color_selector_text"/>
    </RadioGroup>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_local_music_list"
        android:tag="binding_6"
        android:scrollbars="vertical"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_138"
        android:layout_marginBottom="@dimen/dp_20"
        android:layoutDirection="locale"
        android:layout_marginStart="@dimen/dp_40"
        android:layout_marginEnd="@dimen/dp_40"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_album_list"
        android:tag="binding_7"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_138"
        android:layout_marginBottom="@dimen/dp_20"
        android:layout_marginStart="@dimen/dp_40"
        android:layout_marginEnd="@dimen/dp_40"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ExpandableListView
        android:id="@+id/el_artist_list"
        android:tag="binding_8"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_138"
        android:layout_marginBottom="@dimen/dp_20"
        android:listSelector="@android:color/transparent"
        android:groupIndicator="@null"
        android:childDivider="@android:color/transparent"
        android:divider="@android:color/transparent"
        android:dividerHeight="@dimen/dp_8"
        android:layoutDirection="locale"
        android:layout_marginStart="@dimen/dp_40"
        android:layout_marginEnd="@dimen/dp_40"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:tag="binding_9"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_24"
        android:layout_marginStart="@dimen/dp_40"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_search_bar">
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/color_gray_front"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/search_history"/>
            <ImageView
                android:id="@+id/btn_clear_history"
                android:tag="binding_10"
                android:layout_width="@dimen/dp_32"
                android:layout_height="@dimen/dp_32"
                android:src="@drawable/icon_media_search_delete_32"/>
        </LinearLayout>
        <com.byd.music.view.FlowLayout
            android:id="@+id/history_group"
            android:layout_width="@dimen/dp_520"
            android:layout_height="@dimen/dp_120"
            android:layout_marginTop="@dimen/dp_16"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:tag="binding_11"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_115"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_search_bar">
        <ImageView
            android:layout_width="@dimen/dp_312"
            android:layout_height="@dimen/dp_208"
            android:src="@drawable/img_no_data"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/color_search_no_data_text"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/string_search_no_data"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
