<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_60">
    <ImageView
        android:id="@+id/iv_expand_arrow_artist"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/icon_dark_public_dowmarrow_s_48"
        android:scaleType="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="20sp"
        android:textColor="@color/color_selector_text"
        android:id="@+id/tv_artist_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="@dimen/dp_200"
        android:singleLine="true"
        android:textDirection="locale"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/tvIndex"
        app:layout_constraintStart_toEndOf="@+id/tvIndex"
        app:layout_constraintTop_toTopOf="@+id/tvIndex"/>
    <TextView
        android:textSize="14sp"
        android:id="@+id/tv_total_music"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="@dimen/dp_20"
        app:layout_constraintBottom_toBottomOf="@+id/tv_artist_name"
        app:layout_constraintEnd_toStartOf="@+id/iv_expand_arrow_artist"
        app:layout_constraintTop_toTopOf="@+id/tv_artist_name"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/color_selector_text_index"
        android:gravity="center"
        android:id="@+id/tvIndex"
        android:layout_width="@dimen/dp_50"
        android:layout_height="wrap_content"
        android:text="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:gravity="center"
        android:id="@+id/view"
        android:background="@drawable/img_dark_media_list_bg"
        android:layout_width="50dp"
        android:layout_height="20dp"
        android:layout_marginTop="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/view2"
        android:background="@color/color_divider"
        android:layout_width="0dp"
        android:layout_height="1px"
        android:layout_marginEnd="7dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
