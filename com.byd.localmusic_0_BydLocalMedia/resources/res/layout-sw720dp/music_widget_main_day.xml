<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/dp_392"
    android:layout_height="@dimen/dp_100">
    <ImageView
        android:id="@+id/music_widget_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/media_widget_bg"
        android:scaleType="centerCrop"/>
    <ImageView
        android:id="@+id/iv_select_mask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/media_widget_mask_selected"
        android:scaleType="centerCrop"/>
    <ImageView
        android:id="@+id/iv_music_pic"
        android:layout_width="@dimen/dp_64"
        android:layout_height="@dimen/dp_64"
        android:src="@drawable/img_logo_media64"
        android:scaleType="centerCrop"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/dp_19"
        android:layout_alignParentStart="true"/>
    <ImageView
        android:id="@+id/iv_music_progress"
        android:layout_width="@dimen/dp_64"
        android:layout_height="@dimen/dp_64"
        android:scaleType="centerCrop"
        android:layout_alignTop="@+id/iv_music_pic"
        android:layout_alignStart="@+id/iv_music_pic"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/color_white_front"
        android:textColorHint="@color/color_gray_hint"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tv_music_name"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_22"
        android:layout_marginBottom="@dimen/dp_14"
        android:maxWidth="@dimen/dp_158"
        android:singleLine="true"
        android:layout_alignParentBottom="true"
        android:textDirection="locale"
        android:layout_marginStart="@dimen/dp_21"
        android:layout_toEndOf="@+id/iv_music_pic"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color_white_front"
        android:textColorHint="@color/color_gray_hint"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tv_music_singer"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_22"
        android:maxWidth="@dimen/dp_130"
        android:singleLine="true"
        android:layout_alignBottom="@+id/tv_music_name"
        android:textDirection="locale"
        android:layout_marginStart="@dimen/dp_10"
        android:layout_toEndOf="@+id/tv_music_name"
        android:layout_alignEnd="@+id/group_music_type"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_music_control"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp__10"
        android:layout_alignTop="@+id/iv_music_pic"
        android:layoutDirection="ltr"
        android:layout_marginStart="@dimen/dp_12"
        android:layout_toEndOf="@+id/iv_music_pic">
        <ImageButton
            android:id="@+id/btn_previous"
            android:background="@drawable/bg_icon_pressed"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:src="@drawable/icon_card_previous_48"
            android:scaleType="centerCrop"
            android:layout_marginEnd="@dimen/dp_28"/>
        <ImageButton
            android:id="@+id/btn_play_pause"
            android:background="@drawable/bg_icon_pressed"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:src="@drawable/icon_card_play_48"
            android:scaleType="centerCrop"
            android:layout_marginEnd="@dimen/dp_28"/>
        <ImageButton
            android:id="@+id/btn_next"
            android:background="@drawable/bg_icon_pressed"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:src="@drawable/icon_card_next_48"
            android:scaleType="centerCrop"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/group_music_type"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        android:layout_alignTop="@+id/ll_music_control"
        android:paddingStart="@dimen/dp_5"
        android:layout_marginStart="@dimen/dp_28"
        android:layout_toEndOf="@+id/ll_music_control">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_music_type"
            android:layout_width="@dimen/dp_24"
            android:layout_height="@dimen/dp_24"
            android:scaleType="centerCrop"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_app_shift"
            android:layout_width="@dimen/dp_10"
            android:layout_height="@dimen/dp_10"
            android:src="@drawable/icon_app_shift"
            android:scaleType="centerCrop"
            android:layout_marginStart="@dimen/dp_3"/>
    </LinearLayout>
</RelativeLayout>
