<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout-sw720dp/item_music_list_local_search_0"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:layout_marginBottom="8dp">
    <TextView
        android:textSize="16sp"
        android:textColor="@color/color_selector_text_index"
        android:gravity="center"
        android:id="@+id/tvIndex"
        android:tag="binding_1"
        android:background="@drawable/img_dark_media_list_bg"
        android:layout_width="50dp"
        android:layout_height="21dp"
        android:layout_marginTop="9dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/color_selector_text"
        android:ellipsize="end"
        android:id="@+id/tv_song_name"
        android:tag="binding_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:maxWidth="400dp"
        android:singleLine="true"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@+id/tvIndex"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_selector_sub_text"
        android:ellipsize="end"
        android:id="@+id/tv_announcer"
        android:tag="binding_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="200dp"
        android:singleLine="true"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@+id/tvIndex"
        app:layout_constraintTop_toBottomOf="@+id/tv_song_name"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_selector_sub_text"
        android:ellipsize="end"
        android:id="@+id/tv_storage_type"
        android:tag="binding_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="200dp"
        android:singleLine="true"
        android:layout_marginEnd="@dimen/dp_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/view2"
        android:background="@color/color_divider"
        android:layout_width="0dp"
        android:layout_height="1px"
        android:layout_marginEnd="7dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
