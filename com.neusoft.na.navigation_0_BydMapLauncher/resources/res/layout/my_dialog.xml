<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#8024313f"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/ll_root"
        android:background="@drawable/permission_top_bg"
        android:layout_width="560dp"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_necessary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="20dp"
                android:textColor="@color/permission_hint_text"
                android:gravity="center"
                android:id="@+id/tv_title"
                android:paddingLeft="48dp"
                android:paddingTop="40dp"
                android:paddingRight="48dp"
                android:paddingBottom="11dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/permission_necessary"/>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/ll_necessary_child"
                android:paddingBottom="43dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_phone"
            android:background="@drawable/permission_top_bg"
            android:paddingTop="40dp"
            android:paddingBottom="43dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="75dp"
            android:paddingEnd="75dp">
            <TextView
                android:textSize="16dp"
                android:textColor="@color/permission_hint_text"
                android:gravity="center"
                android:id="@+id/tv_title_phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/permission_phone"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_bottom"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginBottom="28dp">
            <TextView
                android:textSize="19dp"
                android:textColor="@color/permission_agree_text"
                android:gravity="center"
                android:id="@+id/tv_setting"
                android:background="@drawable/permission_agree_bg"
                android:layout_width="181dp"
                android:layout_height="match_parent"
                android:text="@string/permission_setting"/>
            <TextView
                android:textSize="19dp"
                android:textColor="@color/permission_exit_text"
                android:gravity="center"
                android:id="@+id/tv_exit"
                android:background="@drawable/permission_exit_bg"
                android:layout_width="181dp"
                android:layout_height="match_parent"
                android:text="@string/permission_exit"
                android:layout_marginStart="48dp"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
