<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/appRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/appPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextureView
            android:id="@+id/mapDisplayArea"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:keepScreenOn="true"/>
        <TextureView
            android:layout_gravity="right"
            android:id="@+id/arDisplayArea"
            android:visibility="gone"
            android:layout_width="1280px"
            android:layout_height="match_parent"
            android:keepScreenOn="true"/>
        <View
            android:id="@+id/mapMaskView"
            android:background="@android:color/transparent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/hmiWebViewContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"/>
        <FrameLayout
            android:layout_gravity="right"
            android:id="@+id/frame_minibar"
            android:visibility="gone"
            android:layout_width="460px"
            android:layout_height="630px"
            android:layout_marginTop="60px"
            android:layout_marginStart="30px"
            android:layout_marginEnd="30px"/>
        <View
            android:id="@+id/hmiMaskView"
            android:background="@android:color/transparent"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/permissionsError"
        android:background="@drawable/no_permissions_background"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/actionBarTopView"
        android:background="@drawable/action_bar_background_night"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/welcome"
        android:background="@drawable/splash_screen"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/test_version"
        android:scaleType="centerInside"/>
    <Button
        android:id="@+id/soundButton"
        android:background="@color/transparent"
        android:layout_width="1px"
        android:layout_height="1px"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/mask"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerInside"
        android:soundEffectsEnabled="false"/>
    <TextView
        android:textColor="@android:color/white"
        android:id="@+id/topMessageTextView"
        android:background="@android:color/holo_green_light"
        android:padding="16dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:lineSpacingExtra="6dp"
        android:layout_marginStart="40dp"/>
</RelativeLayout>
