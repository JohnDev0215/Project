<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/ll_root_privacy"
    android:background="@color/privacy_policy_bg_start"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/size24"
        android:textColor="@color/privacy_policy_text"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:paddingTop="@dimen/size80"
        android:paddingBottom="@dimen/size10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/privacy_policy"/>
    <TextView
        android:textSize="@dimen/size21"
        android:textColor="@color/privacy_policy_hint"
        android:gravity="center"
        android:id="@+id/tv_hint"
        android:paddingBottom="@dimen/size10"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/privacy_policy_hint"
        android:layout_below="@+id/tv_title"
        android:paddingStart="@dimen/privacy_padding_left"
        android:paddingEnd="@dimen/privacy_padding_left"/>
    <ScrollView
        android:id="@+id/sl_content"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/tv_hint"
        android:overScrollMode="never"
        android:paddingStart="@dimen/privacy_padding"
        android:paddingEnd="@dimen/privacy_padding_end">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="@dimen/privacy_padding"
            android:paddingEnd="@dimen/privacy_padding_end">
            <WebView
                android:id="@+id/web_content"
                android:background="@android:color/transparent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                android:id="@+id/ll_bottom"
                android:paddingTop="@dimen/size67"
                android:paddingBottom="@dimen/size165"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layoutDirection="ltr">
                <TextView
                    android:textSize="@dimen/size18"
                    android:textColor="@color/privacy_policy_allow"
                    android:gravity="center"
                    android:id="@+id/tv_setting"
                    android:background="@drawable/privacy_policy_allow_bg"
                    android:layout_width="@dimen/size206"
                    android:layout_height="@dimen/size48"
                    android:text="@string/privacy_policy_agree"
                    android:layout_marginEnd="@dimen/size48"/>
                <TextView
                    android:textSize="@dimen/size18"
                    android:textColor="@color/privacy_policy_text"
                    android:gravity="center"
                    android:id="@+id/tv_exit"
                    android:background="@drawable/privacy_policy_deny_bg"
                    android:layout_width="@dimen/size208"
                    android:layout_height="@dimen/size48"
                    android:text="@string/privacy_policy_deny"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <ImageView
        android:id="@+id/iv_change"
        android:layout_width="72px"
        android:layout_height="72px"
        android:layout_marginLeft="40px"
        android:layout_marginBottom="@dimen/privacy_change"
        android:src="@drawable/icon_theme_change"
        android:layout_alignParentLeft="true"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
