<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/size256"
    android:layout_height="@dimen/size100">
    <ImageView
        android:id="@+id/iv_root"
        style="@style/widget_root_layout"/>
    <ImageView
        android:id="@+id/iv_shadow"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/img_card_bg_selected"/>
    <LinearLayout
        android:id="@+id/rl_root"
        style="@style/widget_parent_layout">
        <ImageView
            android:id="@+id/iv_navigation"
            android:layout_width="@dimen/size92"
            style="@style/widget_navigation_image_left"/>
        <LinearLayout
            android:id="@+id/ll_home"
            style="@style/widget_text_layout_parent">
            <FrameLayout style="@style/widget_navigation_image">
                <ImageView
                    android:id="@+id/iv_home_bg"
                    android:background="@drawable/icon_card_btn_fast_entry"
                    style="@style/widget_navigation_image"/>
                <ImageView
                    android:id="@+id/iv_home"
                    android:src="@drawable/icon_navi_home"
                    style="@style/widget_navigation_image"/>
            </FrameLayout>
            <TextView
                android:ellipsize="end"
                android:id="@+id/tv_home"
                android:text="@string/app_map_home"
                android:maxLines="1"
                style="@style/widget_text"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/ll_work"
            android:layout_marginEnd="@dimen/size24"
            style="@style/widget_text_layout_parent">
            <FrameLayout style="@style/widget_navigation_image">
                <ImageView
                    android:id="@+id/iv_work_bg"
                    android:background="@drawable/icon_card_btn_fast_entry"
                    style="@style/widget_navigation_image"/>
                <ImageView
                    android:id="@+id/iv_work"
                    android:src="@drawable/icon_navi_work"
                    style="@style/widget_navigation_image"/>
            </FrameLayout>
            <TextView
                android:ellipsize="end"
                android:id="@+id/tv_work"
                android:text="@string/app_map_company"
                android:maxLines="1"
                style="@style/widget_text"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
