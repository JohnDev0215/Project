<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory android:title="@string/pref_name_cat_general">
        <CheckBoxPreference
            android:title="@string/pref_name_server_startAtBoot"
            android:key="@string/pref_key_server_startAtBoot"
            android:summary="@string/pref_summary_server_startAtBoot"
            android:defaultValue="@bool/const_general_startAtBoot"/>
        <EditTextPreference
            android:maxLines="1"
            android:singleLine="true"
            android:title="@string/pref_name_logger_port"
            android:key="@string/pref_key_logger_port"
            android:defaultValue="@integer/const_logger_port_default"
            android:inputType="numberDecimal"/>
        <EditTextPreference
            android:maxLines="1"
            android:singleLine="true"
            android:title="@string/pref_name_logger_ws_port"
            android:key="@string/pref_key_logger_ws_port"
            android:defaultValue="@integer/const_logger_ws_port_default"
            android:inputType="numberDecimal"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/pref_name_cat_logsink_file"
        android:key="@string/pref_key_cat_logsink_file">
        <CheckBoxPreference
            android:title="@string/pref_name_logsink_file_enable"
            android:key="@string/pref_key_logsink_file_enable"
            android:summary="@string/pref_summary_logsink_file_enable"
            android:defaultValue="true"/>
        <Preference
            android:title="@string/pref_name_logsink_file_path"
            android:key="@string/pref_key_logsink_file_path"
            android:dependency="@string/pref_key_logsink_file_enable"/>
        <EditTextPreference
            android:maxLines="1"
            android:singleLine="true"
            android:title="@string/pref_name_logsink_file_maxFileLen"
            android:key="@string/pref_key_logsink_file_maxFileLen"
            android:dependency="@string/pref_key_logsink_file_enable"
            android:defaultValue="@integer/const_logsink_file_maxFileLen_defaut"
            android:inputType="numberDecimal"/>
        <EditTextPreference
            android:maxLines="1"
            android:singleLine="true"
            android:title="@string/pref_name_logsink_file_ecu"
            android:key="@string/pref_key_logsink_file_ecu"
            android:dependency="@string/pref_key_logsink_file_enable"
            android:defaultValue="@string/const_logsink_file_ecu_default"
            android:inputType="textCapCharacters"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/pref_name_cat_logsink_tcpip"
        android:key="@string/pref_key_cat_logsink_tcpip">
        <CheckBoxPreference
            android:title="@string/pref_name_logsink_tcpip_enable"
            android:key="@string/pref_key_logsink_tcpip_enable"
            android:summary="@string/pref_summary_logsink_tcpip_enable"
            android:defaultValue="false"/>
        <EditTextPreference
            android:maxLines="1"
            android:singleLine="true"
            android:title="@string/pref_name_logsink_tcpip_port"
            android:key="@string/pref_key_logsink_tcpip_port"
            android:dependency="@string/pref_key_logsink_tcpip_enable"
            android:defaultValue="@integer/const_logsink_tcpip_port_default"
            android:inputType="numberDecimal"/>
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/pref_name_cat_info">
        <EditTextPreference
            android:enabled="false"
            android:title="@string/pref_name_version"
            android:key="@string/pref_key_version"
            android:summary=""/>
        <EditTextPreference
            android:enabled="false"
            android:title="@string/pref_name_ip"
            android:key="@string/pref_key_ip"
            android:summary=""/>
    </PreferenceCategory>
</PreferenceScreen>
