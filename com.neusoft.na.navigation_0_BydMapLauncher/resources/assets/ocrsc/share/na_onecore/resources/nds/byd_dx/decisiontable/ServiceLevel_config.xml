
<ServiceLevelConfig>
   <readme>
      <!-- ******************************************************************************* -->
      <!-- This file configures the service level for component features.                  -->
      <!-- Optional attribute could be added under <RuleStatusAttribute> for specific      -->
      <!-- ServiceLevel if needed;The Optional setting under <default> is effective to     -->
      <!-- all <ServiceLevel> which own attribute is absence.                              -->
      <!--                                                                                 -->
      <!-- Supported configuration for <Component>:                                        -->
      <!--     name     : the component name(e.g. DI,TRAFFIC,GUIDANCE)                     -->
      <!--     feature  : the component feature(e.g. WHERE_AM_I,GUIDANCE_ELEMENT)          -->
      <!-- e.g.: <Component name="GUIDANCE" feature="GUIDANCE_ELEMENT"></Component>        -->
      <!-- the combination of [name] and [feature](e.g. GUIDANCE_GUIDANCE_ELEMENT) is      -->
      <!-- used for the name of enumeration ComponentFeature in ServiceLevelTypes.fidl     -->
      <!-- see: https://review.nts.neusoft.local/#/c/iface/mgr/+/153856/                   -->
      <!--                                                                                 -->
      <!-- Supported configuration for <ServiceLevel>:                                     -->
      <!--     Database : Local_Hybrid,Fresh_Hybrid,Autonomous                             -->
      <!--     Provider : Local,Remote,Autonomous                                          -->
      <!-- e.g.: <ServiceLevel Database="Local_Hybrid" Provider="Remote" > </ServiceLevel> -->
      <!--                                                                                 -->
      <!-- Supported configuration for <RuleStatus>:                                       -->
      <!--     RuleOnlineConnection : unknown,connected,unconnected                        -->
      <!--     RuleRemoteData       : invalid,valid,canceled,lost                          -->
      <!--     RuleActiveRoute      : invalid,local,cloud                                  -->
      <!--     RuleStrippedDBSync   : unknown,local,remote,error                           -->
      <!--     RulePartialDB        : true,false                                           -->
      <!-- e.g.: <RuleStatus                                                               -->
      <!--           RuleOnlineConnection="connected" RuleRemoteData="invalid"             -->
      <!--           RuleActiveRoute="invalid" RuleStrippedDBSync="unknown">               -->
      <!--       </RuleStatus>                                                             -->
      <!--                                                                                 -->
      <!-- Supported configuration for <RuleStatusAttribute>:                              -->
      <!--     AttrOnlineConnection : "1","0"                                              -->
      <!--     AttrRemoteData       : "1","0"                                              -->
      <!--     AttrActiveRoute      : "1","0"                                              -->
      <!--     AttrStrippedDBSync   : "1","0"                                              -->
      <!-- e.g.: <RuleStatusAttribute>                                                     -->
      <!--           <Optional AttrRemoteData="1" />                                       -->
      <!--       </RuleStatusAttribute>                                                    -->
      <!-- ******************************************************************************* -->
   </readme>

   <!-- ********************  DI_FTS     *********************** -->
   <Component name="DI" feature="FTS">
      <!-- default setting -->
      <default>
         <ServiceLevel Database="Local_Hybrid" Provider="Local" > </ServiceLevel>
         <!-- there is no <RuleStatus> setting for the default ServiceLevel use default value:   -->
         <!--     default value of RuleOnlineConnection   : "unknown"                            -->
         <!--     default value of RuleRemoteData         : "invalid"                            -->
         <!--     default value of RuleActiveRoute        : "invalid"                            -->
         <!--     default value of RuleStrippedDBSync     : "unknown"                            -->

         <RuleStatusAttribute>
            <!-- set default Optional attribute : 1-true,0-false -->
            <Optional AttrRemoteData="1" />
         </RuleStatusAttribute>
      </default>

      <ServiceLevel Database="Fresh_Hybrid" Provider="Remote" >
         <RuleStatus RulePartialDB="false" RuleOnlineConnection="connected" RuleActiveRoute="cloud" RuleStrippedDBSync="remote">  </RuleStatus>
         <RuleStatus RulePartialDB="false" RuleOnlineConnection="connected" RuleActiveRoute="cloud" RuleStrippedDBSync="remote">  </RuleStatus>
         <RuleStatus RulePartialDB="true" RuleOnlineConnection="connected" RuleStrippedDBSync="remote">   </RuleStatus>
         <!-- there is no specific RuleStatusAttribute setting for current ServiceLevel,use default-->
      </ServiceLevel>
   </Component>

