<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dimens_50">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/capital_letter_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimens_38"
        android:layout_alignParentBottom="true">
        <TextView
            android:textSize="@dimen/text_sp_20"
            android:textColor="@color/d9_text_color"
            android:gravity="center"
            android:id="@+id/capital_letter"
            android:layout_width="@dimen/dimens_38"
            android:layout_height="@dimen/dimens_34"
            android:text="A"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dimens_21"/>
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimens_1"
            android:src="#0f1f2326"
            android:layout_marginStart="@dimen/dimens_24"
            android:layout_marginEnd="@dimen/dimens_24"/>
    </LinearLayout>
</RelativeLayout>
