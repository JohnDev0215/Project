<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dimens_104">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <ImageView
            android:id="@+id/special_networkcall_voice2phone_btn"
            android:layout_width="@dimen/dimens_48"
            android:layout_height="@dimen/dimens_48"
            android:src="?attr/special_calling_voice2phone_btn"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/text_sp_18"
            android:textColor="?attr/ff_text_color"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/networkcall_name_text"
            android:layout_width="@dimen/dimens_120"
            android:layout_height="@dimen/dimens_26"
            android:lines="1"/>
        <TextView
            android:textSize="@dimen/text_sp_14"
            android:textColor="?attr/b3_text_color"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/networkcall_time_text"
            android:layout_width="@dimen/dimens_120"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimens_4"
            android:lines="1"/>
    </LinearLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <ImageView
            android:id="@+id/networkcall_micswitch_btn"
            android:layout_width="@dimen/dimens_48"
            android:layout_height="@dimen/dimens_48"
            android:src="?attr/special_calling_mic_mute_btn"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
</LinearLayout>
