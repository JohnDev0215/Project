<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dimens_8"
    android:minHeight="@dimen/dimens_334">
    <View
        android:id="@+id/ing_dimens_32"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dimens_40"/>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimens_16">
        <TextView
            android:textSize="@dimen/text_sp_20"
            android:textColor="?attr/ff_text_color"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/call_ing_name_text"
            android:layout_width="@dimen/dimens_300"
            android:layout_height="wrap_content"
            android:lines="1"/>
        <TextView
            android:textSize="@dimen/text_sp_18"
            android:textColor="?attr/b3_text_color"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/call_ing_time_text"
            android:layout_width="@dimen/dimens_200"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimens_8"/>
    </LinearLayout>
    <View
        android:id="@+id/ing_dimens_26"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dimens_26"/>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimens_29"
        android:layout_marginBottom="@dimen/dimens_26">
        <ImageView
            android:id="@+id/call_ing_keyboard_btn"
            android:layout_width="@dimen/dimens_58"
            android:layout_height="@dimen/dimens_58"
            android:src="?attr/bt_calling_show_keyboard_btn"/>
        <ImageView
            android:id="@+id/call_ing_changevoice_btn"
            android:layout_width="@dimen/dimens_58"
            android:layout_height="@dimen/dimens_58"
            android:src="?attr/bt_calling_voice2phone_btn"
            android:layout_marginStart="@dimen/dimens_64"
            android:layout_marginEnd="@dimen/dimens_64"/>
        <ImageView
            android:id="@+id/call_ing_micswitch_btn"
            android:layout_width="@dimen/dimens_58"
            android:layout_height="@dimen/dimens_58"
            android:src="?attr/bt_calling_mic_mute_btn"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/call_ing_keyboard_layout"
        android:visibility="gone"
        android:layout_width="@dimen/dimens_348"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimens_16">
        <EditText
            android:textSize="@dimen/text_sp_22"
            android:textColor="@color/ff_text_color"
            android:ellipsize="middle"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/call_ing_keyboard_input_text"
            android:background="@color/list_bg_n"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:clickable="false"
            android:layout_width="@dimen/dimens_332"
            android:layout_height="@dimen/dimens_48"
            android:layout_marginBottom="@dimen/dimens_10"
            android:cursorVisible="false"
            android:singleLine="true"
            android:focusedByDefault="false"/>
        <include
            android:layout_gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimens_216"
            layout="@layout/bt_calling_keyboard"/>
    </LinearLayout>
    <RelativeLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/call_ing_hugup_btn"
        android:background="@drawable/keyboard_call_btn_bg"
        android:layout_width="@dimen/dimens_270"
        android:layout_height="@dimen/dimens_48"
        android:layout_marginTop="@dimen/dimens_14">
        <ImageView
            android:layout_width="@dimen/dimens_48"
            android:layout_height="@dimen/dimens_48"
            android:src="?attr/btcall_btn_hugup_icon"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
</LinearLayout>
