<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/activity_bg"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:layout_gravity="center_horizontal"
        android:id="@+id/include_table_layout"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dimens_116"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/multiwindowmode_bt_tablehost_layout"/>
    <FrameLayout
        android:id="@+id/contacts_search_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimens_10"
        android:layout_marginBottom="@dimen/dimens_156"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/include_table_layout">
        <include layout="@layout/search_contacts_layout"/>
    </FrameLayout>
    <com.byd.bluetoothcall.view.ui.CustomViewPager
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimens_436"
        android:layout_marginTop="@dimen/dimens_8"
        android:layout_marginEnd="@dimen/dimens_10"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/include_table_layout"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/bt_name_text_layout"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dimens_56"
        android:layout_marginTop="@dimen/dimens_6"
        android:layout_marginEnd="@dimen/dimens_8"
        android:layout_alignParentEnd="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/include_table_layout">
        <ImageView
            android:id="@+id/bt_battery_icon"
            android:layout_width="@dimen/dimens_48"
            android:layout_height="@dimen/dimens_48"
            android:src="@drawable/bat_level"/>
        <TextView
            android:textSize="@dimen/text_sp_20"
            android:textColor="@color/ff_text_color"
            android:ellipsize="end"
            android:gravity="end|center_vertical"
            android:id="@+id/bt_nametext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/dimens_148"
            android:lines="1"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/not_connect_layout"
        android:background="@color/popover_translucent_background"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/not_connect_image"
            android:layout_width="@dimen/dimens_312"
            android:layout_height="@dimen/dimens_208"
            android:layout_marginTop="@dimen/dimens_169"
            android:src="@drawable/bt_empty_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/text_sp_16"
            android:textColor="@color/c8_text_color"
            android:id="@+id/not_connect_text"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dimens_24"
            android:text="@string/bt_not_connect"
            app:layout_constraintEnd_toEndOf="@+id/not_connect_image"
            app:layout_constraintStart_toStartOf="@+id/not_connect_image"
            app:layout_constraintTop_toBottomOf="@+id/not_connect_image"/>
        <TextView
            android:textSize="@dimen/text_sp_18"
            android:textColor="@color/d9_text_color"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/go_to_connect_btn"
            android:background="@drawable/shape_round_corner"
            android:layout_width="@dimen/dimens_160"
            android:layout_height="@dimen/dimens_48"
            android:layout_marginTop="@dimen/dimens_24"
            android:minWidth="@dimen/dimens_160"
            android:text="@string/bt_to_conncet"
            android:lines="1"
            android:textAllCaps="false"
            android:paddingStart="@dimen/dimens_15"
            android:paddingEnd="@dimen/dimens_15"
            app:layout_constraintEnd_toEndOf="@+id/not_connect_text"
            app:layout_constraintStart_toStartOf="@+id/not_connect_text"
            app:layout_constraintTop_toBottomOf="@+id/not_connect_text"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <include
        android:id="@+id/contacts_permission_layout"
        android:visibility="gone"
        layout="@layout/sync_contacts_permission_tips"/>
</androidx.constraintlayout.widget.ConstraintLayout>
