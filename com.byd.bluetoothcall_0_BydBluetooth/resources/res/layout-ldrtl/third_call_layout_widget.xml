<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dimens_56"
    android:layout_marginTop="@dimen/dimens_8"
    android:layout_marginStart="@dimen/dimens_10"
    android:layout_marginEnd="@dimen/dimens_10">
    <ImageView
        android:id="@+id/switch_call_image_widget"
        android:layout_width="@dimen/dimens_32"
        android:layout_height="@dimen/dimens_32"
        android:src="?attr/switch_call_icon"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/dimens_32"/>
    <ImageView
        android:id="@+id/hugup_third_image_widget"
        android:visibility="gone"
        android:layout_width="@dimen/dimens_48"
        android:layout_height="@dimen/dimens_48"
        android:src="?attr/hugup_third_icon"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/dimens_24"/>
    <TextView
        android:textSize="@dimen/text_sp_16"
        android:textColor="?attr/ff_text_color"
        android:gravity="center"
        android:id="@+id/third_call_name_widget"
        android:layout_width="@dimen/dimens_150"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginStart="@dimen/dimens_61"/>
    <TextView
        android:textSize="@dimen/text_sp_16"
        android:textColor="?attr/b3_text_color"
        android:ellipsize="end"
        android:gravity="end"
        android:id="@+id/third_call_time_widget"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lines="1"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/dimens_32"
        android:layout_alignParentEnd="true"/>
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/line"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
