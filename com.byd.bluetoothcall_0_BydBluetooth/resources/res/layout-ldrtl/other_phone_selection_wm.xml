<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/phone_type_corver"
    android:background="?attr/popover_translucent_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/bt_dialog_bg"
        android:background="?attr/bt_dialog_bg"
        android:layout_width="@dimen/dimens_560"
        android:layout_height="@dimen/dimens_312"
        android:layout_marginTop="@dimen/dimens_185"
        android:layout_centerHorizontal="true"
        android:elevation="@dimen/dimens_24">
        <TextView
            android:textSize="@dimen/dimens_20"
            android:textStyle="bold"
            android:textColor="?attr/ff_text_color"
            android:gravity="center"
            android:id="@+id/phone_type_text"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimens_71"/>
        <View
            android:id="@+id/bt_dialog_line"
            android:background="?attr/list_line_1"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimens_1"/>
        <TextView
            android:textSize="@dimen/dimens_20"
            android:textColor="?attr/ff_text_color"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/phone_name_text"
            android:layout_width="@dimen/dimens_450"
            android:layout_height="@dimen/dimens_112"
            android:layout_marginTop="@dimen/dimens_24"
            android:lines="1"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimens_104">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true">
                <TextView
                    android:textSize="@dimen/dimens_18"
                    android:textColor="?attr/ff_white_color"
                    android:gravity="center"
                    android:id="@+id/dialog_end_and_accept_btn"
                    android:background="@drawable/bt_dialog_button_p_bg"
                    android:clickable="true"
                    android:layout_width="@dimen/dimens_176"
                    android:layout_height="@dimen/dimens_48"
                    android:layout_margin="@dimen/dimens_24"
                    android:text="@string/cp_dialog_accept"
                    android:textAllCaps="false"
                    android:stateListAnimator="@drawable/anim_btn_scale_alpha"/>
                <TextView
                    android:textSize="@dimen/dimens_18"
                    android:textColor="?attr/d9_text_color"
                    android:gravity="center"
                    android:id="@+id/dialog_reject_btn"
                    android:background="@drawable/bt_dialog_button_n_bg"
                    android:clickable="true"
                    android:layout_width="@dimen/dimens_176"
                    android:layout_height="@dimen/dimens_48"
                    android:layout_margin="@dimen/dimens_24"
                    android:text="@string/cp_dialog_reject"
                    android:textAllCaps="false"
                    android:stateListAnimator="@drawable/anim_btn_scale_alpha"/>
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>
