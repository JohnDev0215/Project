<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/search_layout_back"
            android:layout_width="@dimen/dimens_48"
            android:layout_height="@dimen/dimens_48"
            android:src="@drawable/back_btn_icon"
            android:layout_marginStart="@dimen/dimens_28"/>
        <RelativeLayout
            android:layout_gravity="center_horizontal"
            android:background="@drawable/edit_text_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimens_24"
            android:layout_marginEnd="@dimen/dimens_40">
            <EditText
                android:textSize="@dimen/text_sp_18"
                android:textStyle="normal"
                android:textColor="@color/ff_text_color"
                android:textColorHighlight="#010fa0f6"
                android:gravity="start|center_vertical"
                android:id="@+id/search_book"
                android:background="@android:color/transparent"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimens_48"
                android:maxLines="1"
                android:lines="1"
                android:singleLine="true"
                android:drawablePadding="@dimen/dimens_8"
                android:layout_centerVertical="true"
                android:inputType="textCapWords"
                android:imeOptions="actionDone"
                android:textCursorDrawable="@drawable/edittext_custom"
                android:paddingStart="@dimen/dimens_56"
                android:paddingEnd="@dimen/dimens_40"/>
            <ImageView
                android:layout_width="@dimen/dimens_48"
                android:layout_height="@dimen/dimens_48"
                android:src="@drawable/contacts_search_icon"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/dimens_8"/>
            <ImageView
                android:id="@+id/search_clear_btn"
                android:visibility="invisible"
                android:layout_width="@dimen/dimens_48"
                android:layout_height="@dimen/dimens_48"
                android:src="@drawable/search_clear_btn"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/dimens_8"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/search_list_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dimens_24"
        android:layout_marginStart="@dimen/dimens_15"
        android:layout_marginEnd="@dimen/dimens_40">
        <TextView
            android:textSize="@dimen/text_sp_16"
            android:textColor="@color/c8_text_color"
            android:gravity="center_vertical"
            android:id="@+id/search_contacts_number"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dimens_34"
            android:layout_marginStart="@dimen/dimens_24"/>
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimens_1"
            android:src="@color/list_line_1"
            android:layout_marginStart="@dimen/dimens_24"
            android:layout_marginEnd="@dimen/dimens_24"/>
        <TextView
            android:textSize="@dimen/text_sp_20"
            android:textColor="@color/c8_text_color"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/search_no_data"
            android:visibility="gone"
            android:layout_width="@dimen/dimens_378"
            android:layout_height="@dimen/dimens_29"
            android:layout_marginTop="@dimen/dimens_71"
            android:text="@string/bt_no_match_result"/>
        <ListView
            android:id="@+id/search_contacts_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/dimens_8"
            android:divider="@null"
            android:layout_marginStart="@dimen/dimens_8"
            android:layout_marginEnd="@dimen/dimens_8"
            style="@style/listview_scroolbar_style"/>
    </LinearLayout>
</LinearLayout>
