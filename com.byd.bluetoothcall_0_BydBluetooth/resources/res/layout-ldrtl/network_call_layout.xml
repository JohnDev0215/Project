<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimens_56">
        <TextView
            android:textSize="@dimen/text_sp_20"
            android:textColor="@color/ff_text_color"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/network_call_name_text"
            android:layout_width="@dimen/dimens_300"
            android:layout_height="wrap_content"
            android:lines="1"/>
        <TextView
            android:textSize="@dimen/text_sp_16"
            android:textColor="@color/b3_text_color"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/network_call_time_text"
            android:layout_width="@dimen/dimens_200"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimens_2"
            android:lines="1"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimens_115">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/network_call_changevoice_btn"
                android:layout_width="@dimen/dimens_58"
                android:layout_height="@dimen/dimens_58"
                android:src="@drawable/bt_calling_voice2phone_btn"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/network_call_micswitch_btn"
                android:layout_width="@dimen/dimens_58"
                android:layout_height="@dimen/dimens_58"
                android:src="@drawable/bt_calling_mic_mute_btn"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
