<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/in_dimens_32"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dimens_32"/>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimens_24">
        <TextView
            android:textSize="@dimen/text_sp_20"
            android:textColor="?attr/ff_text_color"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/call_in_name_text"
            android:layout_width="@dimen/dimens_300"
            android:layout_height="wrap_content"
            android:lines="1"/>
        <TextView
            android:textSize="@dimen/text_sp_16"
            android:textColor="?attr/b3_text_color"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/call_in_location_text"
            android:layout_width="@dimen/dimens_200"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimens_2"
            android:lines="1"/>
    </LinearLayout>
    <View
        android:id="@+id/in_dimens_34"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dimens_34"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimens_81">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/call_in_anser_btn"
                android:layout_width="@dimen/dimens_58"
                android:layout_height="@dimen/dimens_58"
                android:layout_centerInParent="true"
                app:lottie_autoPlay="true"
                app:lottie_fileName="pick_up.json"
                app:lottie_loop="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/call_in_hugup_btn"
                android:layout_width="@dimen/dimens_58"
                android:layout_height="@dimen/dimens_58"
                android:layout_centerInParent="true"
                app:lottie_autoPlay="true"
                app:lottie_fileName="hang_up.json"
                app:lottie_loop="true"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
