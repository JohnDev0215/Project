<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/dimens_116"
    android:layoutDirection="ltr">
    <RelativeLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimens_116"
        android:layout_marginStart="@dimen/dimens_40"
        android:layout_marginEnd="@dimen/dimens_40">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:id="@+id/tab_contacts_layout"
                android:background="@drawable/main_menu_bg"
                android:layout_width="0dp"
                android:layout_height="@dimen/dimens_110"
                android:layout_weight="1"
                android:stateListAnimator="@drawable/anim_btn_scale">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dimens_12"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true">
                    <ImageView
                        android:layout_gravity="center_horizontal"
                        android:layout_width="@dimen/dimens_48"
                        android:layout_height="@dimen/dimens_48"
                        android:src="@drawable/main_menu_contacts_icon"/>
                    <TextView
                        android:textSize="@dimen/text_sp_20"
                        android:textColor="@drawable/tablayout_text_select"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:layout_gravity="center_horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bt_contacts_text"
                        android:lines="1"/>
                </LinearLayout>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/tab_calllog_layout"
                android:background="@drawable/main_menu_bg"
                android:layout_width="0dp"
                android:layout_height="@dimen/dimens_110"
                android:layout_weight="1"
                android:stateListAnimator="@drawable/anim_btn_scale">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dimens_12"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true">
                    <ImageView
                        android:layout_gravity="center_horizontal"
                        android:layout_width="@dimen/dimens_48"
                        android:layout_height="@dimen/dimens_48"
                        android:src="@drawable/main_menu_calllog_icon"/>
                    <TextView
                        android:textSize="@dimen/text_sp_20"
                        android:textColor="@drawable/tablayout_text_select"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:layout_gravity="center_horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bt_call_log_text"
                        android:lines="1"/>
                </LinearLayout>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/tab_missedcalls_layout"
                android:background="@drawable/main_menu_bg"
                android:layout_width="0dp"
                android:layout_height="@dimen/dimens_110"
                android:layout_weight="1"
                android:stateListAnimator="@drawable/anim_btn_scale">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dimens_12"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true">
                    <ImageView
                        android:layout_gravity="center_horizontal"
                        android:layout_width="@dimen/dimens_48"
                        android:layout_height="@dimen/dimens_48"
                        android:src="@drawable/main_menu_missedcalls_icon"/>
                    <TextView
                        android:textSize="@dimen/text_sp_20"
                        android:textColor="@drawable/tablayout_text_select"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:layout_gravity="center_horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bt_missed_calls_text"
                        android:lines="1"/>
                </LinearLayout>
                <TextView
                    android:textSize="@dimen/text_sp_14"
                    android:textColor="@color/ff_white_color"
                    android:gravity="center"
                    android:id="@+id/unread_missed_calls"
                    android:background="@drawable/missed_calls_tips_red_bg_ty"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dimens_20"
                    android:layout_marginTop="@dimen/dimens_23"
                    android:text="99+"
                    android:paddingStart="@dimen/dimens_6"
                    android:paddingEnd="@dimen/dimens_6"
                    android:layout_marginStart="@dimen/dimens_97"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/tab_dial_keyboard_layout"
                android:background="@drawable/main_menu_bg"
                android:layout_width="0dp"
                android:layout_height="@dimen/dimens_110"
                android:layout_weight="1"
                android:stateListAnimator="@drawable/anim_btn_scale">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dimens_12"
                    android:layout_alignParentBottom="true"
                    android:layout_centerInParent="true">
                    <ImageView
                        android:layout_gravity="center_horizontal"
                        android:layout_width="@dimen/dimens_48"
                        android:layout_height="@dimen/dimens_48"
                        android:src="@drawable/main_menu_dial_keyboard_icon"/>
                    <TextView
                        android:textSize="@dimen/text_sp_20"
                        android:textColor="@drawable/tablayout_text_select"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:layout_gravity="center_horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bt_dial_keyboard_text"
                        android:lines="1"/>
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
