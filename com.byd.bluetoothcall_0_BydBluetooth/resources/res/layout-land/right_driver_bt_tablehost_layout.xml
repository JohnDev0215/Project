<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/rd_land_bt_tablehost_bg"
    android:layout_width="@dimen/dimens_249"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="start"
        android:id="@+id/tab_contacts_layout"
        android:background="?attr/rd_land_main_menu_bg"
        android:layout_width="@dimen/dimens_208"
        android:layout_height="@dimen/dimens_64"
        android:layout_marginTop="@dimen/dimens_28"
        android:stateListAnimator="@drawable/anim_btn_scale"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/land_bt_contacts_icon_n"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="?attr/main_menu_contacts_icon"
            android:layout_marginStart="@dimen/dimens_28"/>
        <TextView
            android:textSize="@dimen/text_sp_20"
            android:textColor="?attr/tablayout_text_select"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bt_contacts_text"
            android:lines="2"
            android:layout_marginStart="@dimen/dimens_3"
            android:layout_toStartOf="@+id/land_bt_contacts_icon_n"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="start"
        android:id="@+id/tab_calllog_layout"
        android:background="?attr/rd_land_main_menu_bg"
        android:layout_width="@dimen/dimens_208"
        android:layout_height="@dimen/dimens_64"
        android:layout_marginTop="@dimen/dimens_4"
        android:layout_below="@+id/tab_contacts_layout"
        android:stateListAnimator="@drawable/anim_btn_scale"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tab_contacts_layout">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/land_bt_call_log_icon_n"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="?attr/main_menu_calllog_icon"
            android:layout_marginStart="@dimen/dimens_28"/>
        <TextView
            android:textSize="@dimen/text_sp_20"
            android:textColor="?attr/tablayout_text_select"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bt_call_log_text"
            android:lines="2"
            android:layout_marginStart="@dimen/dimens_3"
            android:layout_toStartOf="@+id/land_bt_call_log_icon_n"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="start"
        android:id="@+id/tab_missedcalls_layout"
        android:background="?attr/rd_land_main_menu_bg"
        android:layout_width="@dimen/dimens_208"
        android:layout_height="@dimen/dimens_64"
        android:layout_marginTop="@dimen/dimens_4"
        android:layout_below="@+id/tab_calllog_layout"
        android:stateListAnimator="@drawable/anim_btn_scale"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tab_calllog_layout">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/land_bt_missedcalls_icon_n"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="?attr/main_menu_missedcalls_icon"
            android:layout_marginStart="@dimen/dimens_28"/>
        <TextView
            android:textSize="@dimen/text_sp_20"
            android:textColor="?attr/tablayout_text_select"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bt_missed_calls_text"
            android:lines="2"
            android:layout_marginStart="@dimen/dimens_3"
            android:layout_toStartOf="@+id/land_bt_missedcalls_icon_n"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/text_sp_14"
        android:textColor="?attr/ff_white_color"
        android:gravity="center"
        android:id="@+id/unread_missed_calls"
        android:background="@drawable/missed_calls_tips_red_bg_ty"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dimens_20"
        android:layout_marginTop="@dimen/dimens_5"
        android:text="99+"
        android:paddingStart="@dimen/dimens_6"
        android:paddingEnd="@dimen/dimens_6"
        android:layout_marginStart="@dimen/dimens_54"
        app:layout_constraintStart_toStartOf="@+id/tab_missedcalls_layout"
        app:layout_constraintTop_toTopOf="@+id/tab_missedcalls_layout"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/bt_name_text_layout"
        android:layout_width="@dimen/dimens_221"
        android:layout_height="@dimen/dimens_56"
        android:layout_marginTop="@dimen/dimens_188"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tab_missedcalls_layout">
        <ImageView
            android:id="@+id/bt_battery_icon"
            android:layout_width="@dimen/dimens_48"
            android:layout_height="@dimen/dimens_48"
            android:src="@drawable/bat_level"/>
        <TextView
            android:textSize="@dimen/text_sp_20"
            android:textColor="?attr/ff_text_color"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/bt_nametext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/dimens_148"
            android:lines="1"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
