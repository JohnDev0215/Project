<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/dimens_256"
    android:layout_height="@dimen/dimens_100">
    <ImageView
        android:id="@+id/bt_app_widget_bg"
        android:layout_width="@dimen/dimens_256"
        android:layout_height="@dimen/dimens_100"
        android:src="@drawable/bt_widget_bg"/>
    <ImageView
        android:id="@+id/bt_app_widget_piont"
        android:visibility="gone"
        android:layout_width="@dimen/dimens_256"
        android:layout_height="@dimen/dimens_100"
        android:src="@drawable/bt_widget_bg_select"/>
    <RelativeLayout
        android:id="@+id/connected_widget_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/bt_widget_connect_icon"
            android:layout_width="@dimen/dimens_92"
            android:layout_height="@dimen/dimens_100"
            android:src="@drawable/bt_widget_notconnect_icon"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/bt_widget_2_calllog"
            android:layout_width="@dimen/dimens_64"
            android:layout_height="@dimen/dimens_72"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dimens_8"
            android:layout_toStartOf="@+id/bt_widget_2_misscall">
            <RelativeLayout
                android:layout_gravity="center_horizontal"
                android:id="@+id/bt_widget_2_calllog_2"
                android:layout_width="@dimen/dimens_48"
                android:layout_height="@dimen/dimens_48">
                <ImageView
                    android:id="@+id/bt_widget_calllog_icon_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/widget_btn_bg"
                    android:layout_centerInParent="true"/>
                <ImageView
                    android:id="@+id/bt_widget_calllog_icon"
                    android:layout_width="@dimen/dimens_48"
                    android:layout_height="@dimen/dimens_48"
                    android:src="@drawable/bt_widget_calllog_icon"
                    android:layout_centerInParent="true"/>
            </RelativeLayout>
            <TextView
                android:textSize="@dimen/text_sp_14"
                android:textColor="@color/widget_text_color"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/bt_widget_calllog_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimens_4"
                android:text="@string/bt_call_log_text"
                android:lines="1"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/bt_widget_2_misscall"
            android:layout_width="@dimen/dimens_64"
            android:layout_height="@dimen/dimens_72"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dimens_24"
            android:layout_alignParentEnd="true">
            <RelativeLayout
                android:layout_gravity="center_horizontal"
                android:id="@+id/bt_widget_2_misscall_2"
                android:layout_width="@dimen/dimens_48"
                android:layout_height="@dimen/dimens_48">
                <ImageView
                    android:id="@+id/bt_widget_misscall_icon_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/widget_btn_bg"
                    android:layout_centerHorizontal="true"/>
                <ImageView
                    android:id="@+id/bt_widget_misscall_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/bt_widget_misscall_icon"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>
            <TextView
                android:textSize="@dimen/text_sp_14"
                android:textColor="@color/widget_text_color"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/bt_widget_misscall_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimens_4"
                android:text="@string/bt_missed_calls_text"
                android:lines="1"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/text_sp_14"
            android:textColor="@color/ff_white_color"
            android:gravity="top|center_horizontal"
            android:id="@+id/unread_missed_calls"
            android:background="@drawable/missed_calls_tips_red_bg_ty"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dimens_16"
            android:text="9"
            android:includeFontPadding="false"
            android:layout_alignTop="@+id/bt_widget_2_misscall"
            android:paddingStart="@dimen/dimens_2"
            android:paddingEnd="@dimen/dimens_2"
            android:layout_marginStart="@dimen/dimens_208"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/disconnect_widget_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:id="@+id/disconnect_widget_click_1"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/bt_widget_notconnect_icon"
                android:layout_width="@dimen/dimens_92"
                android:layout_height="@dimen/dimens_100"
                android:src="@drawable/bt_widget_notconnect_icon"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/disconnect_widget_click_2"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dimens_24"
            android:layout_alignParentEnd="true">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/widget_bt_icon"
                android:layout_width="@dimen/dimens_24"
                android:layout_height="@dimen/dimens_24"
                android:src="@drawable/bt_notconnect_icon"/>
            <TextView
                android:textSize="@dimen/text_sp_16"
                android:textColor="@color/widget_text_color"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/widget_not_connect"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dimens_24"
                android:text="@string/not_connect"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
