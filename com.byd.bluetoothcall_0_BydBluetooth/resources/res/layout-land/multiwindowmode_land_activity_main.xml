<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/land_activity_bg"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:layout_gravity="center_horizontal"
        android:id="@+id/include_table_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimens_116"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/multiwindowmode_land_bt_tablehost_layout"/>
    <FrameLayout
        android:id="@+id/contacts_search_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimens_0"
        android:layout_marginTop="@dimen/dimens_10"
        android:layout_marginBottom="@dimen/dimens_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/include_table_layout">
        <include layout="@layout/search_contacts_layout"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/bt_name_text_layout"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dimens_48"
        android:layout_marginTop="@dimen/dimens_4"
        android:layout_marginEnd="@dimen/dimens_36"
        android:layout_alignParentEnd="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/include_table_layout">
        <ImageView
            android:id="@+id/bt_battery_icon"
            android:layout_width="@dimen/dimens_48"
            android:layout_height="@dimen/dimens_48"
            android:src="@drawable/bat_level"/>
        <TextView
            android:textSize="@dimen/text_sp_20"
            android:textColor="?attr/ff_text_color"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/bt_nametext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/dimens_148"
            android:lines="1"/>
    </LinearLayout>
    <com.byd.bluetoothcall.view.ui.CustomViewPager
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimens_0"
        android:layout_marginTop="@dimen/dimens_6"
        android:layout_marginStart="@dimen/dimens_20"
        android:layout_marginEnd="@dimen/dimens_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/include_table_layout"/>
    <include
        android:id="@+id/not_connect_layout"
        layout="@layout/multiwindowmode_bt_not_connect_layout"/>
    <include
        android:id="@+id/contacts_permission_layout"
        android:visibility="gone"
        layout="@layout/sync_contacts_permission_tips"/>
</androidx.constraintlayout.widget.ConstraintLayout>
