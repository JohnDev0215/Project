<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="?attr/popover_translucent_background"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:background="?attr/bt_dialog_bg"
        android:layout_width="@dimen/dimens_560"
        android:layout_height="@dimen/dimens_312"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:elevation="@dimen/dimens_24"
        android:backgroundTint="@color/dialog_bg_test"
        android:outlineSpotShadowColor="#4d282c30"
        android:outlineAmbientShadowColor="#4d282c30">
        <LinearLayout
            android:orientation="vertical"
            android:background="?attr/bt_dialog_bg"
            android:layout_width="@dimen/dimens_558"
            android:layout_height="@dimen/dimens_310"
            android:layout_centerInParent="true">
            <TextView
                android:textSize="@dimen/dimens_20"
                android:textStyle="bold"
                android:textColor="?attr/ff_text_color"
                android:gravity="center"
                android:id="@+id/dialog_title"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimens_71"
                android:text="@string/contact_download_permission"
                android:lines="2"
                android:layout_marginStart="@dimen/dimens_8"
                android:layout_marginEnd="@dimen/dimens_8"/>
            <View
                android:background="@color/dialog_line_color"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimens_1"/>
            <TextView
                android:textSize="@dimen/dimens_20"
                android:textColor="?attr/ff_text_color"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/dialog_tips"
                android:layout_width="@dimen/dimens_500"
                android:layout_height="@dimen/dimens_112"
                android:layout_marginTop="@dimen/dimens_24"
                android:text="@string/contact_download_tips"
                android:lines="4"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimens_104">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="@dimen/dimens_416"
                    android:layout_height="@dimen/dimens_64"
                    android:layout_centerInParent="true">
                    <TextView
                        android:textSize="@dimen/dimens_18"
                        android:textColor="?attr/ff_white_color"
                        android:gravity="center"
                        android:id="@+id/dialog_confirm_btn"
                        android:background="?attr/dialog_btn_p_shape"
                        android:clickable="true"
                        android:layout_width="@dimen/dimens_176"
                        android:layout_height="@dimen/dimens_48"
                        android:layout_marginTop="8dp"
                        android:text="@string/bond_button_confirm"
                        android:textAllCaps="false"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="@dimen/dimens_24"
                        android:stateListAnimator="@drawable/anim_btn_scale_alpha"/>
                    <TextView
                        android:textSize="@dimen/dimens_18"
                        android:textColor="?attr/ff_text_color"
                        android:gravity="center"
                        android:id="@+id/dialog_cancle_btn"
                        android:background="?attr/dialog_btn_n_shape"
                        android:clickable="true"
                        android:layout_width="@dimen/dimens_176"
                        android:layout_height="@dimen/dimens_48"
                        android:layout_marginTop="8dp"
                        android:text="@string/bond_button_cancel"
                        android:textAllCaps="false"
                        android:layout_marginStart="@dimen/dimens_24"
                        android:elevation="@dimen/dimens_8"
                        android:stateListAnimator="@drawable/anim_btn_scale_alpha"
                        android:backgroundTint="@color/dialog_btn_backgroundTint"
                        android:outlineSpotShadowColor="@color/dialog_btn_outlinespotshadowcolor"
                        android:outlineAmbientShadowColor="@color/dialog_btn_outlineambientshadowcolor"/>
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
