<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/land_activity_bg"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:layout_gravity="center_horizontal"
        android:id="@+id/include_tab_layout"
        android:layout_width="@dimen/dimens_249"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/right_driver_bt_tablehost_layout"/>
    <FrameLayout
        android:id="@+id/contacts_search_layout"
        android:visibility="gone"
        android:layout_width="@dimen/dimens_974"
        android:layout_height="@dimen/dimens_410"
        android:layout_marginTop="@dimen/dimens_12"
        android:layout_marginBottom="@dimen/dimens_156"
        app:layout_constraintEnd_toStartOf="@+id/include_tab_layout"
        app:layout_constraintTop_toTopOf="parent">
        <include layout="@layout/search_contacts_layout"/>
    </FrameLayout>
    <com.byd.bluetoothcall.view.ui.CustomViewPager
        android:id="@+id/view_pager"
        android:visibility="visible"
        android:layout_width="@dimen/dimens_524"
        android:layout_height="@dimen/dimens_448"
        app:layout_constraintEnd_toStartOf="@+id/include_tab_layout"
        app:layout_constraintTop_toTopOf="parent"/>
    <EditText
        android:textSize="@dimen/text_sp_40"
        android:textStyle="normal"
        android:textColor="@color/ff_text_color"
        android:textColorHighlight="#010fa0f6"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/keyboard_iput"
        android:background="@null"
        android:layout_width="@dimen/dimens_305"
        android:layout_height="@dimen/dimens_48"
        android:text="123456"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:maxLength="32"
        android:inputType="phone"
        android:textSelectHandle="?attr/edittext_custom"
        android:textCursorDrawable="?attr/edittext_custom"
        app:layout_constraintBottom_toTopOf="@+id/address_of_number"
        app:layout_constraintEnd_toEndOf="@+id/address_of_number"
        app:layout_constraintStart_toStartOf="@+id/address_of_number"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/keyboard_delete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="?attr/keyboard_number_delete_icon"
        android:layout_alignParentEnd="true"
        app:layout_constraintBottom_toBottomOf="@+id/keyboard_iput"
        app:layout_constraintStart_toEndOf="@+id/keyboard_iput"
        app:layout_constraintTop_toTopOf="@+id/keyboard_iput"/>
    <TextView
        android:textSize="@dimen/text_sp_12"
        android:textColor="?attr/b3_text_color"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/address_of_number"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dimens_20"
        app:layout_constraintBottom_toTopOf="@+id/include_keyboard_layout"
        app:layout_constraintEnd_toEndOf="@+id/include_keyboard_layout"
        app:layout_constraintStart_toStartOf="@+id/include_keyboard_layout"/>
    <include
        android:layout_gravity="center_horizontal"
        android:id="@+id/include_keyboard_layout"
        android:layout_width="@dimen/dimens_398"
        android:layout_height="@dimen/dimens_276"
        android:layout_marginTop="@dimen/dimens_100"
        android:layout_marginEnd="@dimen/dimens_38"
        app:layout_constraintRight_toLeftOf="@+id/view_pager"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/keyboard"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/bt_dial_number_btn"
        android:background="?attr/dial_btn_bg"
        android:layout_width="@dimen/dimens_270"
        android:layout_height="@dimen/dimens_54"
        android:layout_marginTop="@dimen/dimens_10"
        android:src="?attr/button_phone_answer"
        android:soundEffectsEnabled="false"
        app:layout_constraintEnd_toEndOf="@+id/include_keyboard_layout"
        app:layout_constraintStart_toStartOf="@+id/include_keyboard_layout"
        app:layout_constraintTop_toBottomOf="@+id/include_keyboard_layout"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/not_connect_layout"
        android:background="?attr/popover_translucent_background"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/not_connect_image"
            android:layout_width="@dimen/dimens_312"
            android:layout_height="@dimen/dimens_208"
            android:layout_marginTop="@dimen/dimens_88"
            android:src="?attr/bt_empty_icon"
            android:layout_marginEnd="@dimen/dimens_365"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/text_sp_16"
            android:textColor="?attr/c8_text_color"
            android:id="@+id/not_connect_text"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dimens_24"
            android:text="@string/bt_not_connect"
            app:layout_constraintEnd_toEndOf="@+id/not_connect_image"
            app:layout_constraintStart_toStartOf="@+id/not_connect_image"
            app:layout_constraintTop_toBottomOf="@+id/not_connect_image"/>
        <TextView
            android:textSize="@dimen/text_sp_18"
            android:textColor="?attr/d9_text_color"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/go_to_connect_btn"
            android:background="?attr/shape_round_corner"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dimens_48"
            android:layout_marginTop="@dimen/dimens_24"
            android:minWidth="@dimen/dimens_160"
            android:text="@string/bt_to_conncet"
            android:lines="1"
            android:textAllCaps="false"
            android:paddingStart="@dimen/dimens_15"
            android:paddingEnd="@dimen/dimens_15"
            android:stateListAnimator="@drawable/anim_btn_scale"
            app:layout_constraintEnd_toEndOf="@+id/not_connect_text"
            app:layout_constraintStart_toStartOf="@+id/not_connect_text"
            app:layout_constraintTop_toBottomOf="@+id/not_connect_text"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <include
        android:id="@+id/contacts_permission_layout"
        android:visibility="gone"
        layout="@layout/sync_contacts_permission_tips"/>
</androidx.constraintlayout.widget.ConstraintLayout>
