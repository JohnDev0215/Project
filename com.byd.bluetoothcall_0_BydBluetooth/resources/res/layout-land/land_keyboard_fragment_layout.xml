<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <EditText
        android:textSize="@dimen/text_sp_40"
        android:textStyle="normal"
        android:textColor="?attr/ff_text_color"
        android:textColorHighlight="#010fa0f6"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/keyboard_iput"
        android:background="@null"
        android:layout_width="@dimen/dimens_386"
        android:layout_height="@dimen/dimens_48"
        android:layout_marginTop="@dimen/dimens_60"
        android:lines="1"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:maxLength="32"
        android:inputType="phone"
        android:textSelectHandle="?attr/edittext_custom"
        android:textCursorDrawable="?attr/edittext_custom"
        android:paddingStart="@dimen/dimens_48"
        android:paddingEnd="@dimen/dimens_48"
        android:focusedByDefault="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/keyboard_delete"
        android:visibility="invisible"
        android:layout_width="@dimen/dimens_48"
        android:layout_height="@dimen/dimens_48"
        android:src="?attr/keyboard_number_delete_icon"
        android:layout_alignParentEnd="true"
        app:layout_constraintBottom_toBottomOf="@+id/keyboard_iput"
        app:layout_constraintEnd_toEndOf="@+id/keyboard_iput"/>
    <TextView
        android:textSize="@dimen/text_sp_12"
        android:textColor="?attr/b3_text_color"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/address_of_number"
        android:layout_width="@dimen/dimens_310"
        android:layout_height="@dimen/dimens_20"
        app:layout_constraintEnd_toEndOf="@+id/keyboard_iput"
        app:layout_constraintStart_toStartOf="@+id/keyboard_iput"
        app:layout_constraintTop_toBottomOf="@+id/keyboard_iput"/>
    <include
        android:layout_gravity="center_horizontal"
        android:id="@+id/include_keyboard_layout"
        android:layout_width="@dimen/dimens_398"
        android:layout_height="@dimen/dimens_264"
        android:layout_marginTop="@dimen/dimens_6"
        app:layout_constraintEnd_toEndOf="@+id/address_of_number"
        app:layout_constraintStart_toStartOf="@+id/address_of_number"
        app:layout_constraintTop_toBottomOf="@+id/address_of_number"
        layout="@layout/multiwindowmode_land_keyboard"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/bt_dial_number_btn"
        android:background="?attr/dial_btn_bg"
        android:layout_width="@dimen/dimens_270"
        android:layout_height="@dimen/dimens_54"
        android:layout_marginTop="@dimen/dimens_10"
        android:src="?attr/button_phone_answer"
        android:soundEffectsEnabled="false"
        app:layout_constraintEnd_toEndOf="@+id/include_keyboard_layout"
        app:layout_constraintStart_toStartOf="@+id/include_keyboard_layout"
        app:layout_constraintTop_toBottomOf="@+id/include_keyboard_layout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
