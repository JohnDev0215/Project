<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/nodata_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimens_77"
        android:layout_marginStart="@dimen/dimens_116">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="@dimen/dimens_312"
            android:layout_height="@dimen/dimens_208"
            android:src="?attr/call_log_empty_icon"/>
        <TextView
            android:textSize="@dimen/text_sp_16"
            android:textColor="?attr/c8_text_color"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bt_no_calllogs_text"/>
    </LinearLayout>
    <com.byd.bluetoothcall.view.ui.OverScrollLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimens_30">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/call_log_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@style/listview_scroolbar_style"/>
    </com.byd.bluetoothcall.view.ui.OverScrollLayout>
</RelativeLayout>
