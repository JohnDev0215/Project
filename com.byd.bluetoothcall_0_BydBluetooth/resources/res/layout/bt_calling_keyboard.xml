        android:gravity="center"
        android:id="@+id/keyboard_number_j_text"
        android:paddingTop="@dimen/dimens_0"
        android:layout_marginTop="@dimen/dimens_12"
        android:text="#"
        android:layout_marginStart="@dimen/dimens_12"
        app:layout_constraintLeft_toRightOf="@+id/keyboard_number_0_text"
        app:layout_constraintTop_toBottomOf="@+id/keyboard_number_9_text"
        style="@style/calling_keyboard_number_style"/>
