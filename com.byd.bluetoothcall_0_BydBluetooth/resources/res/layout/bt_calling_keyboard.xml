<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:gravity="center"
        android:id="@+id/keyboard_number_1_text"
        android:paddingTop="@dimen/dimens_0"
        android:layout_marginTop="@dimen/dimens_6"
        android:text="1"
        android:layout_marginStart="@dimen/dimens_6"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/calling_keyboard_number_style"/>
    <TextView
        android:id="@+id/keyboard_number_2_text"
        android:paddingTop="5dp"
        android:layout_marginTop="@dimen/dimens_6"
