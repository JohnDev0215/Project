        android:layout_marginStart="@dimen/dimens_12"
        app:layout_constraintLeft_toRightOf="@+id/keyboard_number_1_text"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/calling_keyboard_number_style"/>
    <TextView
        android:id="@+id/keyboard_abc_text"
        android:text="ABC"
        app:layout_constraintBottom_toBottomOf="@+id/keyboard_number_2_text"
        app:layout_constraintEnd_toEndOf="@+id/keyboard_number_2_text"
        app:layout_constraintStart_toStartOf="@+id/keyboard_number_2_text"
        style="@style/calling_keyboard_letter_style"/>
