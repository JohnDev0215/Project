        android:id="@+id/keyboard_tuv_text"
        android:text="TUV"
        app:layout_constraintBottom_toBottomOf="@+id/keyboard_number_8_text"
        app:layout_constraintEnd_toEndOf="@+id/keyboard_number_8_text"
        app:layout_constraintStart_toStartOf="@+id/keyboard_number_8_text"
        style="@style/calling_keyboard_letter_style"/>
    <TextView
        android:id="@+id/keyboard_number_9_text"
        android:layout_marginTop="@dimen/dimens_12"
        android:text="9"
        android:layout_marginStart="@dimen/dimens_12"
        app:layout_constraintLeft_toRightOf="@+id/keyboard_number_8_text"
        app:layout_constraintTop_toBottomOf="@+id/keyboard_number_6_text"
        style="@style/calling_keyboard_number_style"/>
