        android:id="@+id/keyboard_wxyz_text"
        android:text="WXYZ"
        app:layout_constraintBottom_toBottomOf="@+id/keyboard_number_9_text"
        app:layout_constraintEnd_toEndOf="@+id/keyboard_number_9_text"
        app:layout_constraintStart_toStartOf="@+id/keyboard_number_9_text"
        style="@style/calling_keyboard_letter_style"/>
    <TextView
        android:gravity="center"
        android:id="@+id/keyboard_number_x_text"
        android:paddingTop="@dimen/dimens_0"
        android:layout_marginTop="@dimen/dimens_12"
        android:text="*"
