<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dimens_74"
    android:minHeight="@dimen/dimens_74">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/dimens_24"
        android:layout_marginEnd="@dimen/dimens_24">
        <TextView
            android:textSize="@dimen/text_sp_20"
            android:textColor="@color/b3_text_color"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/t9_search_item_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="比亚迪"
            android:lines="1"
            android:maxEms="6"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimens_5">
            <TextView
                android:textSize="@dimen/text_sp_18"
                android:textColor="@color/b3_text_color"
                android:ellipsize="end"
                android:id="@+id/t9_search_item_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="123 8379 3682"
                android:lines="1"
                android:maxEms="12"/>
            <TextView
                android:textSize="@dimen/text_sp_16"
                android:textColor="@color/b3_text_color"
                android:gravity="end"
                android:id="@+id/t9_search_item_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="上午 11:38"
                android:lines="1"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </LinearLayout>
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimens_1"
        android:src="@color/list_line_1"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/dimens_24"
        android:layout_marginEnd="@dimen/dimens_24"/>
</RelativeLayout>
