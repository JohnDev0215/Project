<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dimens_104">
    <RelativeLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/call_ing_hugup_btn"
        android:background="?attr/red_round_bg"
        android:layout_width="@dimen/dimens_48"
        android:layout_height="@dimen/dimens_48"
        android:layout_marginStart="@dimen/dimens_16">
        <ImageView
            android:layout_width="@dimen/dimens_38"
            android:layout_height="@dimen/dimens_38"
            android:src="?attr/special_hugup_icon"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/dimens_5"
        android:layout_marginEnd="@dimen/dimens_5">
        <TextView
            android:textSize="@dimen/text_sp_18"
            android:textColor="?attr/ff_text_color"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/call_ing_name_text"
            android:layout_width="@dimen/dimens_120"
            android:layout_height="@dimen/dimens_26"
            android:lines="1"/>
        <TextView
            android:textSize="@dimen/text_sp_14"
            android:textColor="?attr/b3_text_color"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/call_ing_time_text"
            android:layout_width="@dimen/dimens_120"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimens_4"
            android:lines="1"/>
    </LinearLayout>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/call_ing_micswitch_btn"
        android:layout_width="@dimen/dimens_48"
        android:layout_height="@dimen/dimens_48"
        android:src="?attr/special_calling_mic_mute_btn"
        android:layout_marginEnd="@dimen/dimens_16"/>
</LinearLayout>
