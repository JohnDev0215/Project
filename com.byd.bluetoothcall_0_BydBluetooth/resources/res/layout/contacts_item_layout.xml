<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bt_list_bg"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dimens_74">
    <ImageView
        android:id="@+id/first_word_bg"
        android:layout_width="@dimen/dimens_45"
        android:layout_height="@dimen/dimens_45"
        android:src="@drawable/first_word_bg"
        android:minWidth="@dimen/dimens_45"
        android:minHeight="@dimen/dimens_45"
        android:layout_marginStart="@dimen/dimens_21"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/text_sp_20"
        android:textColor="@color/ff_white_color"
        android:id="@+id/first_word"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="比"
        android:layout_centerInParent="true"
        app:layout_constraintBottom_toBottomOf="@+id/first_word_bg"
        app:layout_constraintEnd_toEndOf="@+id/first_word_bg"
        app:layout_constraintStart_toStartOf="@+id/first_word_bg"
        app:layout_constraintTop_toTopOf="@+id/first_word_bg"/>
    <TextView
        android:textSize="@dimen/text_sp_20"
        android:textColor="@color/ff_text_color"
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/contacts_name"
        android:layout_width="@dimen/dimens_453"
        android:layout_height="wrap_content"
        android:text="德玛西亚德玛西亚德玛西亚德玛西"
        android:lines="1"
        android:layout_marginStart="@dimen/dimens_13"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/first_word_bg"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
