<?xml version="1.0" encoding="utf-8"?>
<com.byd.bluetoothcall.view.ui.MyCallView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bt_call_view_click"
    android:background="?attr/popover_translucent_background"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/bt_call_wm_layout"
        android:background="?attr/bt_dialog_bg"
        android:clickable="true"
        android:layout_width="@dimen/dimens_500"
        android:layout_height="@dimen/dimens_344"
        android:minWidth="@dimen/dimens_430"
        android:minHeight="@dimen/dimens_344"
        android:layout_centerInParent="true"
        android:elevation="@dimen/dimens_24"
        android:outlineSpotShadowColor="@color/bt_call_view_bg_color_spot"
        android:outlineAmbientShadowColor="@color/bt_call_view_bg_color_ambient">
        <ImageView
            android:id="@+id/bt_call_small_icon"
            android:layout_width="@dimen/dimens_56"
            android:layout_height="@dimen/dimens_56"
            android:layout_marginTop="@dimen/dimens_12"
            android:src="?attr/bt_call_small_icon"
            android:layout_marginEnd="@dimen/dimens_16"
            android:layout_alignParentEnd="true"/>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/call_ing_keyboard_layout_left"
            android:visibility="gone"
            android:layout_width="@dimen/dimens_348"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimens_38"
            android:layout_alignParentRight="true"
            android:layout_marginEnd="@dimen/dimens_74">
            <EditText
                android:textSize="@dimen/text_sp_22"
                android:textColor="?attr/ff_text_color"
                android:ellipsize="middle"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/call_ing_keyboard_input_text_left"
                android:background="@color/list_bg_n"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:clickable="false"
                android:layout_width="@dimen/dimens_332"
                android:layout_height="@dimen/dimens_48"
                android:layout_marginBottom="@dimen/dimens_16"
                android:cursorVisible="false"
                android:singleLine="true"
                android:inputType="phone"
                android:focusedByDefault="false"/>
            <include
                android:layout_gravity="center_horizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimens_216"
                layout="@layout/bt_calling_keyboard"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_toStartOf="@+id/call_ing_keyboard_layout_left">
            <include
                android:layout_gravity="center_horizontal"
                android:id="@+id/third_call_layout"
                android:visibility="gone"
                android:layout_width="@dimen/dimens_320"
                android:layout_height="@dimen/dimens_54"
                android:layout_marginTop="@dimen/dimens_12"
                layout="@layout/third_call_layout"/>
            <include
                android:id="@+id/bt_call_out_layout"
                android:visibility="gone"
                layout="@layout/bt_call_out_layout"/>
            <include
                android:id="@+id/bt_call_in_layout"
                android:visibility="gone"
                layout="@layout/bt_call_in_layout"/>
            <include
                android:id="@+id/bt_call_ing_layout"
                android:visibility="gone"
                layout="@layout/bt_call_ing_layout"/>
            <include
                android:id="@+id/network_call_layout"
                android:visibility="gone"
                layout="@layout/network_call_layout"/>
        </LinearLayout>
    </RelativeLayout>
</com.byd.bluetoothcall.view.ui.MyCallView>
