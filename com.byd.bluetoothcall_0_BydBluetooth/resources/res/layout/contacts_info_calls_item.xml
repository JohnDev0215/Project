<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dimens_74"
    android:minHeight="@dimen/dimens_74">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimens_74"
        android:minHeight="@dimen/dimens_74"
        android:layout_marginStart="@dimen/dimens_12">
        <TextView
            android:textSize="@dimen/text_sp_14"
            android:textColor="@color/ff_white_color"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/serial_number"
            android:background="@drawable/land_call_log_item_id_bg"
            android:visibility="gone"
            android:layout_width="@dimen/dimens_30"
            android:layout_height="@dimen/dimens_26"
            android:text="1"
            android:layout_marginStart="@dimen/dimens_12"/>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dimens_12"
            android:layout_toEndOf="@+id/serial_number">
            <TextView
                android:textSize="@dimen/text_sp_20"
                android:textColor="@color/ff_text_color"
                android:ellipsize="end"
                android:id="@+id/item_number"
                android:layout_width="@dimen/dimens_178"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/dimens_158"
                android:text="+86 159 8664 1776"
                android:lines="1"/>
            <TextView
                android:textSize="@dimen/text_sp_16"
                android:textColor="@color/b3_text_color"
                android:ellipsize="end"
                android:id="@+id/item_location"
                android:layout_width="@dimen/dimens_160"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimens_4"
                android:text="Shenzhen,Guangdong"
                android:lines="1"
                android:layout_below="@+id/item_number"/>
        </LinearLayout>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/item_call_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/bt_call_out_icon"
            android:layout_marginEnd="@dimen/dimens_24"/>
    </LinearLayout>
    <View
        android:id="@+id/line"
        android:background="@color/list_line_1"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimens_1"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/dimens_24"
        android:layout_marginEnd="@dimen/dimens_24"/>
</RelativeLayout>
