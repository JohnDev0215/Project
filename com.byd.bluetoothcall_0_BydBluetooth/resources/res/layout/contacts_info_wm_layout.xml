<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimens_56"/>
    <RelativeLayout
        android:id="@+id/contacts_wm_bg"
        android:background="?attr/popover_translucent_background"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/id_pop_layout"
            android:background="?attr/contacts_list_wm_bg"
            android:clickable="true"
            android:layout_width="@dimen/dimens_630"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/dimens_380"
            android:layout_centerInParent="true"
            android:splitMotionEvents="false"
            android:elevation="@dimen/dimens_24">
            <RelativeLayout
                android:layout_width="@dimen/dimens_630"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/contacts_popwm_back"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimens_12"
                    android:src="?attr/clear_btn_n"
                    android:layout_marginStart="@dimen/dimens_16"/>
                <ImageView
                    android:id="@+id/first_word_bg"
                    android:layout_width="@dimen/dimens_72"
                    android:layout_height="@dimen/dimens_72"
                    android:layout_marginTop="@dimen/dimens_80"
                    android:src="@drawable/first_word_bg"
                    android:layout_marginStart="@dimen/dimens_88"/>
                <TextView
                    android:textSize="@dimen/dimens_38"
                    android:textColor="?attr/ff_white_color"
                    android:gravity="center"
                    android:id="@+id/first_word"
                    android:layout_width="@dimen/dimens_72"
                    android:layout_height="@dimen/dimens_72"
                    android:layout_marginTop="@dimen/dimens_80"
                    android:text="比"
                    android:layout_marginStart="@dimen/dimens_88"/>
                <TextView
                    android:textSize="@dimen/text_sp_28"
                    android:textStyle="bold"
                    android:textColor="?attr/ff_text_color"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/name"
                    android:layout_width="@dimen/dimens_188"
                    android:layout_height="@dimen/dimens_40"
                    android:layout_marginTop="@dimen/dimens_16"
                    android:text="比亚迪"
                    android:maxLines="1"
                    android:layout_below="@+id/first_word"
                    android:layout_marginStart="@dimen/dimens_30"/>
                <TextView
                    android:textSize="@dimen/text_sp_16"
                    android:textColor="?attr/c8_text_color"
                    android:gravity="center_vertical"
                    android:id="@+id/recent_call_history"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dimens_34"
                    android:layout_marginTop="@dimen/dimens_32"
                    android:text="@string/bt_call_log_recode"
                    android:layout_below="@+id/name"
                    android:layout_marginStart="@dimen/dimens_32"
                    android:layout_marginEnd="@dimen/dimens_47"
                    android:layout_alignParentStart="true"/>
                <View
                    android:id="@+id/line"
                    android:background="@color/list_line_1"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dimens_1"
                    android:layout_below="@+id/recent_call_history"
                    android:layout_marginStart="@dimen/dimens_32"
                    android:layout_marginEnd="@dimen/dimens_32"/>
                <RelativeLayout
                    android:id="@+id/no_call_records"
                    android:layout_width="@dimen/dimens_400"
                    android:layout_height="@dimen/dimens_106"
                    android:layout_below="@+id/recent_call_history"
                    android:layout_centerHorizontal="true">
                    <TextView
                        android:textSize="@dimen/text_sp_18"
                        android:textColor="?attr/c8_text_color"
                        android:id="@+id/bt_call_log_no_recode_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bt_call_log_no_recode"
                        android:layout_centerInParent="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/listview_relativelayout"
                    android:background="?attr/contacts_info_list_bg"
                    android:layout_width="@dimen/dimens_320"
                    android:layout_height="@dimen/dimens_77"
                    android:layout_marginTop="@dimen/dimens_68"
                    android:layout_marginEnd="@dimen/dimens_32"
                    android:layout_alignParentEnd="true"
                    android:elevation="@dimen/dimens_3">
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/listview"
                        android:scrollbars="none"
                        android:fadingEdge="none"
                        android:layout_width="@dimen/dimens_320"
                        android:layout_height="wrap_content"
                        android:listSelector="@null"
                        android:divider="@null"
                        android:layout_centerVertical="true"
                        android:overScrollMode="never"
                        android:paddingEnd="@dimen/dimens_5"/>
                </RelativeLayout>
            </RelativeLayout>
            <ListView
                android:id="@+id/call_records"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimens_8"
                android:layout_marginBottom="@dimen/dimens_16"
                android:listSelector="@color/list_bg_n"
                android:divider="@null"
                android:layout_below="@+id/recent_call_history"
                android:layout_marginStart="@dimen/dimens_32"
                android:layout_marginEnd="@dimen/dimens_32"
                style="@style/listview_scroolbar_style"/>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
