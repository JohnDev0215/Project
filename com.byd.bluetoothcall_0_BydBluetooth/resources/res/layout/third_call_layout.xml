<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:clipChildren="false"
    android:layout_width="@dimen/dimens_386"
    android:layout_height="@dimen/dimens_54">
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/switch_call_image"
        android:layout_width="@dimen/dimens_32"
        android:layout_height="@dimen/dimens_32"
        android:layout_centerVertical="true"/>
    <ImageView
        android:id="@+id/hugup_third_image"
        android:visibility="gone"
        android:layout_width="@dimen/dimens_48"
        android:layout_height="@dimen/dimens_48"
        android:src="@drawable/hugup_third_icon"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="@dimen/text_sp_16"
        android:textColor="?attr/ff_text_color"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/third_call_name"
        android:layout_width="@dimen/dimens_150"
        android:layout_height="wrap_content"
        android:lines="1"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/dimens_85"/>
    <TextView
        android:textSize="@dimen/text_sp_16"
        android:textColor="@color/b3_text_color"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/third_call_time"
        android:layout_width="@dimen/dimens_98"
        android:layout_height="wrap_content"
        android:text="@string/call_hold"
        android:lines="1"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/dimens_20"/>
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/line"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
