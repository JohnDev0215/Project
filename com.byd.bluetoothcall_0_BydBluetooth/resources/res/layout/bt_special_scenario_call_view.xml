<?xml version="1.0" encoding="utf-8"?>
<com.byd.bluetoothcall.view.ui.MyView xmlns:android="http://schemas.android.com/apk/res/android"
    android:clipChildren="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/bt_special_call_view"
        android:background="?attr/bt_call_small_view_bg"
        android:layout_width="@dimen/dimens_298"
        android:layout_height="@dimen/dimens_132">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true">
            <View
                android:id="@+id/view_up_6dp"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dimens_6"/>
            <include
                android:id="@+id/third_call_layout"
                android:visibility="gone"
                layout="@layout/special_third_call_layout"/>
            <include
                android:id="@+id/bt_call_out_layout"
                android:visibility="gone"
                layout="@layout/special_call_out_layout"/>
            <include
                android:id="@+id/bt_call_in_layout"
                android:visibility="gone"
                layout="@layout/special_call_in_layout"/>
            <include
                android:id="@+id/bt_call_ing_layout"
                android:visibility="gone"
                layout="@layout/special_call_ing_layout"/>
            <include
                android:id="@+id/special_networkcall_layout"
                android:visibility="gone"
                layout="@layout/special_networkcall_layout"/>
            <View
                android:id="@+id/view_down_6dp"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dimens_6"/>
        </LinearLayout>
    </RelativeLayout>
</com.byd.bluetoothcall.view.ui.MyView>
