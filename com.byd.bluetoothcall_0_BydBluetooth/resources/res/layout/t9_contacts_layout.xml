<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/text_sp_18"
        android:textColor="@color/c8_text_color"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimens_18"
        android:text="@string/bt_maybe_find_text"
        android:layout_marginStart="@dimen/dimens_32"/>
    <ListView
        android:id="@+id/t9_search_contacts_list"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dimens_6"
        android:divider="@null"
        android:layout_marginStart="@dimen/dimens_24"
        android:layout_marginEnd="@dimen/dimens_24"
        style="@style/listview_scroolbar_style"/>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/no_matching_result_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimens_3">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="@dimen/dimens_312"
            android:layout_height="@dimen/dimens_208"
            android:src="@drawable/no_matching_result_icon"/>
        <TextView
            android:textSize="@dimen/text_sp_16"
            android:textColor="@color/c8_text_color"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bt_no_match_result"/>
    </LinearLayout>
</LinearLayout>
