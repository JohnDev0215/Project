<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/out_dimens_32"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dimens_32"/>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimens_24">
        <TextView
            android:textSize="@dimen/text_sp_20"
            android:textColor="?attr/ff_text_color"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/call_out_name_text"
            android:layout_width="@dimen/dimens_300"
            android:layout_height="wrap_content"
            android:lines="1"/>
        <TextView
            android:textSize="@dimen/text_sp_16"
            android:textColor="?attr/b3_text_color"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/call_out_location_text"
            android:layout_width="@dimen/dimens_200"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimens_8"
            android:lines="1"/>
        <TextView
            android:textSize="@dimen/text_sp_16"
            android:textColor="?attr/b3_text_color"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/dialing_text"
            android:layout_width="@dimen/dimens_156"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimens_16"
            android:text="@string/call_out_text"/>
    </LinearLayout>
    <View
        android:id="@+id/out_dimens_30"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dimens_30"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimens_45">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <RelativeLayout
                android:id="@+id/call_out_hugup_btn"
                android:background="?attr/red_round_bg"
                android:layout_width="@dimen/dimens_58"
                android:layout_height="@dimen/dimens_58"
                android:layout_centerInParent="true">
                <ImageView
                    android:layout_width="@dimen/dimens_48"
                    android:layout_height="@dimen/dimens_48"
                    android:src="?attr/btcall_btn_hugup_icon"
                    android:layout_centerInParent="true"/>
            </RelativeLayout>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/call_out_changevoice_btn"
                android:layout_width="@dimen/dimens_58"
                android:layout_height="@dimen/dimens_58"
                android:src="?attr/bt_calling_voice2phone_btn"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
