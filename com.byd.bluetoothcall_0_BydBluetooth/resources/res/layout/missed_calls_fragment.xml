<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/nodata_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimens_49"
        android:layout_centerHorizontal="true">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="@dimen/dimens_312"
            android:layout_height="@dimen/dimens_208"
            android:src="@drawable/btcall_empty_icon"/>
        <TextView
            android:textSize="@dimen/text_sp_16"
            android:textColor="@color/c8_text_color"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bt_missed_no_recode"/>
    </LinearLayout>
    <com.byd.bluetoothcall.view.ui.OverScrollLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dimens_60"
        android:layout_marginStart="@dimen/dimens_24"
        android:layout_marginEnd="@dimen/dimens_9">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/missed_calls_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@style/listview_scroolbar_style"/>
    </com.byd.bluetoothcall.view.ui.OverScrollLayout>
</RelativeLayout>
