<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/calllog_item_bg"
    android:background="@drawable/bt_list_bg"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dimens_74">
    <RelativeLayout
        android:id="@+id/calllog_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/dimens_12">
        <ImageView
            android:id="@+id/call_log_type"
            android:layout_width="@dimen/dimens_48"
            android:layout_height="@dimen/dimens_48"
            android:src="?attr/callout_icon"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/dimens_12"/>
        <ImageView
            android:id="@+id/call_log_infomation"
            android:layout_width="@dimen/dimens_48"
            android:layout_height="@dimen/dimens_48"
            android:src="?attr/call_infomation_icon"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dimens_10"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:textSize="@dimen/text_sp_20"
            android:textColor="?attr/ff_text_color"
            android:gravity="center_vertical"
            android:id="@+id/call_log_count"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dimens_74"
            android:text="(99)"
            android:lines="1"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/dimens_8"
            android:layout_marginEnd="@dimen/dimens_8"
            android:layout_toEndOf="@+id/call_log_type"/>
        <TextView
            android:textSize="@dimen/text_sp_20"
            android:textColor="?attr/ff_text_color"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/call_log_name"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dimens_74"
            android:text="156 8297 3782"
            android:lines="1"
            android:maxEms="7"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/call_log_count"/>
        <TextView
            android:textSize="@dimen/text_sp_18"
            android:textColor="?attr/b3_text_color"
            android:gravity="end"
            android:id="@+id/call_log_time"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dimens_24"
            android:text="2021/06/11"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/call_log_infomation"/>
    </RelativeLayout>
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimens_1"
        android:src="?attr/list_line_1"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginEnd="@dimen/dimens_50"/>
</RelativeLayout>
