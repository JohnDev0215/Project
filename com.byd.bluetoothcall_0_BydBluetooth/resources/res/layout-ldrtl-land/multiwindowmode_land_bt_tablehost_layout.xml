<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/bt_tablehost_bg_116"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dimens_116"
    android:layoutDirection="ltr">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tab_contacts_layout"
        android:background="@drawable/main_menu_bg"
        android:layout_width="@dimen/dimens_128"
        android:layout_height="@dimen/dimens_96"
        android:layout_marginBottom="@dimen/dimens_6"
        android:stateListAnimator="@drawable/anim_btn_scale"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tab_calllog_layout"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/main_menu_contacts_icon"
            android:layout_width="@dimen/dimens_48"
            android:layout_height="@dimen/dimens_48"
            android:layout_marginTop="@dimen/dimens_9"
            android:src="?attr/main_menu_contacts_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/text_sp_20"
            android:textColor="?attr/tablayout_text_select"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bt_contacts_text"
            android:lines="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/main_menu_contacts_icon"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tab_calllog_layout"
        android:background="?attr/main_menu_bg"
        android:layout_width="@dimen/dimens_128"
        android:layout_height="@dimen/dimens_96"
        android:layout_marginBottom="@dimen/dimens_6"
        android:stateListAnimator="@drawable/anim_btn_scale"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tab_missedcalls_layout"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/tab_contacts_layout">
        <ImageView
            android:id="@+id/main_menu_calllog_icon"
            android:layout_width="@dimen/dimens_48"
            android:layout_height="@dimen/dimens_48"
            android:layout_marginTop="@dimen/dimens_9"
            android:src="?attr/main_menu_calllog_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/text_sp_20"
            android:textColor="?attr/tablayout_text_select"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bt_call_log_text"
            android:lines="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/main_menu_calllog_icon"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tab_missedcalls_layout"
        android:background="?attr/main_menu_bg"
        android:layout_width="@dimen/dimens_128"
        android:layout_height="@dimen/dimens_96"
        android:layout_marginBottom="@dimen/dimens_6"
        android:stateListAnimator="@drawable/anim_btn_scale"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tab_dial_keyboard_layout"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/tab_calllog_layout">
        <ImageView
            android:id="@+id/main_menu_missedcalls_icon"
            android:layout_width="@dimen/dimens_48"
            android:layout_height="@dimen/dimens_48"
            android:layout_marginTop="@dimen/dimens_9"
            android:src="?attr/main_menu_missedcalls_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/text_sp_20"
            android:textColor="?attr/tablayout_text_select"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bt_missed_calls_text"
            android:lines="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/main_menu_missedcalls_icon"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="@dimen/text_sp_14"
        android:textColor="?attr/ff_white_color"
        android:gravity="center"
        android:id="@+id/unread_missed_calls"
        android:background="@drawable/missed_calls_tips_red_bg_ty"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dimens_20"
        android:layout_marginTop="@dimen/dimens_8"
        android:text="9"
        android:lines="1"
        android:paddingStart="@dimen/dimens_6"
        android:paddingEnd="@dimen/dimens_6"
        android:layout_marginStart="@dimen/dimens_70"
        android:layout_alignParentEnd="true"
        app:layout_constraintStart_toStartOf="@+id/tab_missedcalls_layout"
        app:layout_constraintTop_toTopOf="@+id/tab_missedcalls_layout"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tab_dial_keyboard_layout"
        android:background="?attr/main_menu_bg"
        android:layout_width="@dimen/dimens_128"
        android:layout_height="@dimen/dimens_96"
        android:layout_marginBottom="@dimen/dimens_6"
        android:stateListAnimator="@drawable/anim_btn_scale"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/tab_missedcalls_layout">
        <ImageView
            android:id="@+id/main_menu_dial_keyboard_icon"
            android:layout_width="@dimen/dimens_48"
            android:layout_height="@dimen/dimens_48"
            android:layout_marginTop="@dimen/dimens_9"
            android:src="?attr/main_menu_dial_keyboard_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/text_sp_20"
            android:textColor="?attr/tablayout_text_select"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bt_dial_keyboard_text"
            android:lines="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/main_menu_dial_keyboard_icon"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
