<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bt_list_bg"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dimens_74"
    android:layout_marginEnd="@dimen/dimens_11">
    <ImageView
        android:id="@+id/first_word_bg"
        android:layout_width="@dimen/dimens_38"
        android:layout_height="@dimen/dimens_38"
        android:src="@drawable/first_word_bg"
        android:layout_marginEnd="@dimen/dimens_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/text_sp_20"
        android:textColor="?attr/ff_white_color"
        android:id="@+id/first_word"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="比"
        android:layout_centerInParent="true"
        app:layout_constraintBottom_toBottomOf="@+id/first_word_bg"
        app:layout_constraintEnd_toEndOf="@+id/first_word_bg"
        app:layout_constraintStart_toStartOf="@+id/first_word_bg"
        app:layout_constraintTop_toTopOf="@+id/first_word_bg"/>
    <TextView
        android:textSize="@dimen/text_sp_20"
        android:textColor="?attr/ff_text_color"
        android:ellipsize="end"
        android:gravity="right"
        android:layout_gravity="center_vertical"
        android:id="@+id/contacts_name"
        android:layout_width="@dimen/dimens_312"
        android:layout_height="wrap_content"
        android:text="abcdefghijklm"
        android:lines="1"
        android:textDirection="ltr"
        android:layout_marginEnd="@dimen/dimens_13"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/first_word_bg"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
