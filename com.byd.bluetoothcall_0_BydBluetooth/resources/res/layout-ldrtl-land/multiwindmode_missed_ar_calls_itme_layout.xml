<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/missed_calls_item_bg"
    android:background="@drawable/bt_list_bg"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dimens_74">
    <RelativeLayout
        android:id="@+id/missed_calls_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/dimens_24">
        <TextView
            android:textSize="@dimen/text_sp_20"
            android:textColor="@color/missed_call_red_color"
            android:gravity="center_vertical"
            android:id="@+id/missed_calls_count"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dimens_74"
            android:text="(99)"
            android:lines="1"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dimens_8"/>
        <TextView
            android:textSize="@dimen/text_sp_20"
            android:textColor="@color/missed_call_red_color"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/missed_calls_name"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dimens_74"
            android:text="156 8297 3782"
            android:lines="1"
            android:maxEms="7"
            android:layout_centerVertical="true"
            android:textDirection="ltr"
            android:layout_toEndOf="@+id/missed_calls_count"/>
        <TextView
            android:textSize="@dimen/text_sp_18"
            android:textColor="?attr/b3_text_color"
            android:gravity="end"
            android:id="@+id/missed_calls_time"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dimens_24"
            android:text="2021/06/11"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/missed_calls_infomation"/>
        <ImageView
            android:id="@+id/missed_calls_infomation"
            android:layout_width="@dimen/dimens_48"
            android:layout_height="@dimen/dimens_48"
            android:src="?attr/call_infomation_icon"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dimens_10"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimens_1"
        android:src="?attr/list_line_1"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginEnd="@dimen/dimens_50"/>
</RelativeLayout>
