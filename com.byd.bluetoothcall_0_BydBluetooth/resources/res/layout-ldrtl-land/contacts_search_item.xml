<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dimens_74"
    android:minHeight="@dimen/dimens_74">
    <ImageView
        android:id="@+id/contacts_search_item_first_word_bg"
        android:layout_width="@dimen/dimens_38"
        android:layout_height="@dimen/dimens_38"
        android:src="@drawable/first_word_bg"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/dimens_13"/>
    <TextView
        android:textSize="@dimen/text_sp_20"
        android:textColor="?attr/ff_white_color"
        android:gravity="center"
        android:id="@+id/contacts_search_item_first_word"
        android:layout_width="@dimen/dimens_38"
        android:layout_height="@dimen/dimens_38"
        android:text="比"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/dimens_13"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/dimens_13"
        android:layout_toEndOf="@+id/contacts_search_item_first_word">
        <TextView
            android:textSize="@dimen/text_sp_20"
            android:textColor="?attr/b3_text_color"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/contacts_search_item_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="比亚迪"
            android:lines="1"
            android:textDirection="ltr"
            android:layout_marginEnd="@dimen/dimens_20"/>
        <TextView
            android:textSize="@dimen/text_sp_18"
            android:textColor="?attr/b3_text_color"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/contacts_search_item_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimens_5"
            android:text="123 8379 3682"
            android:lines="1"
            android:textDirection="ltr"
            android:layout_marginEnd="@dimen/dimens_20"/>
    </LinearLayout>
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimens_1"
        android:src="?attr/list_line_1"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/dimens_16"
        android:layout_marginEnd="@dimen/dimens_16"/>
</RelativeLayout>
