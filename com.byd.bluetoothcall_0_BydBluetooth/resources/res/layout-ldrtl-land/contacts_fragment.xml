<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/nodata_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimens_88"
        android:layout_marginStart="@dimen/dimens_116">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="@dimen/dimens_312"
            android:layout_height="@dimen/dimens_208"
            android:src="?attr/contacts_empty_icon"/>
        <TextView
            android:textSize="@dimen/text_sp_16"
            android:textColor="?attr/c8_text_color"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bt_no_contacts_text"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/sync_text"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dimens_88"
        android:layout_marginStart="@dimen/dimens_50">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="@dimen/dimens_312"
            android:layout_height="@dimen/dimens_208"
            android:src="?attr/contacts_not_download_icon"/>
        <TextView
            android:textSize="@dimen/text_sp_16"
            android:textColor="?attr/c8_text_color"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/contact_download_text"
            android:lines="3"/>
        <TextView
            android:textSize="@dimen/text_sp_18"
            android:textColor="?attr/d9_text_color"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/sync_contacts_btn"
            android:background="@drawable/shape_round_corner"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dimens_48"
            android:layout_marginTop="@dimen/dimens_24"
            android:minWidth="@dimen/dimens_160"
            android:text="@string/sync_contacts"
            android:lines="1"
            android:textAllCaps="false"
            android:paddingStart="@dimen/dimens_15"
            android:paddingEnd="@dimen/dimens_15"
            android:stateListAnimator="@drawable/anim_btn_scale"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/show_contacts_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dp_42">
        <com.byd.bluetoothcall.view.ui.OverScrollLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerview"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fadeScrollbars="true"
                android:layoutDirection="ltr"
                android:layout_marginEnd="@dimen/dimens_24"
                style="@style/listview_scroolbar_style"/>
        </com.byd.bluetoothcall.view.ui.OverScrollLayout>
        <View
            android:background="#00000000"
            android:clickable="true"
            android:layout_width="@dimen/dimens_462"
            android:layout_height="@dimen/dimens_50"
            android:layout_marginStart="@dimen/dimens_24"/>
        <com.byd.bluetoothcall.view.azlist.AZSideBarView
            android:id="@+id/letter_list"
            android:paddingTop="@dimen/dimens_1"
            android:layout_width="@dimen/dimens_60"
            android:layout_height="match_parent"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            app:barPadding="@dimen/dimens_7"
            app:barWidth="@dimen/dimens_7"
            app:hintTextSize="@dimen/sp_20"
            app:selectTextSize="@dimen/sp_10"
            app:textSize="@dimen/sp_10"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/sync_seekbar_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimens_44"
        android:layout_marginTop="@dimen/dimens_8"
        android:layout_marginStart="@dimen/dimens_25"
        android:layout_marginEnd="@dimen/dimens_5">
        <TextView
            android:textSize="18sp"
            android:textColor="?attr/ff_text_color"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dimens_32"
            android:text="@string/bt_contacts_syncing"/>
        <TextView
            android:textSize="18sp"
            android:textColor="?attr/ff_text_color"
            android:gravity="center_vertical"
            android:id="@+id/sync_seekbar_text"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dimens_32"
            android:text="0%"
            android:layout_alignParentEnd="true"/>
        <ProgressBar
            android:id="@+id/sync_progressBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimens_6"
            android:layout_marginBottom="@dimen/dimens_3"
            android:progress="0"
            android:progressDrawable="@drawable/progressbar"
            android:layout_alignParentBottom="true"
            style="?android:attr/progressBarStyleHorizontal"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/show_contacts_number_layout"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimens_8">
        <ImageView
            android:id="@+id/contacts_search_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="?attr/contacts_search_icon"
            android:layout_toStartOf="@+id/contacts_search_button"/>
        <TextView
            android:textSize="@dimen/text_sp_18"
            android:textColor="?attr/d9_text_color"
            android:gravity="end|center_vertical"
            android:id="@+id/contacts_search_button"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dimens_48"
            android:text="@string/bt_contacts_number"
            android:layout_toStartOf="@+id/contacts_reflesh_icon"/>
        <ImageView
            android:id="@+id/contacts_reflesh_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="?attr/contacts_reflesh_icon"
            android:layout_marginStart="@dimen/dimens_24"
            android:layout_toStartOf="@+id/contacts_reflesh_textview"/>
        <TextView
            android:textSize="@dimen/text_sp_18"
            android:textColor="?attr/d9_text_color"
            android:gravity="center"
            android:id="@+id/contacts_reflesh_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bt_contacts_reflsh"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</RelativeLayout>
