<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:title="@string/display_settings"
    android:key="display_settings_screen"
    settings:initialExpandedChildrenCount="5"
    settings:keywords="@string/keywords_display">
    <com.android.settingslib.RestrictedPreference
        android:title="@string/brightness"
        android:key="brightness"
        settings:keywords="@string/keywords_display_brightness_level"
        settings:useAdminDisabledSummary="true"
        settings:userRestriction="no_config_brightness">
        <intent android:action="com.android.intent.action.SHOW_BRIGHTNESS_DIALOG"/>
    </com.android.settingslib.RestrictedPreference>
    <com.android.car.developeroptions.display.NightDisplayPreference
        android:title="@string/night_display_title"
        android:key="night_display"
        android:widgetLayout="@null"
        android:fragment="com.android.car.developeroptions.display.NightDisplaySettings"
        settings:searchable="false"
        settings:widgetLayout="@null"/>
    <Preference
        android:title="@string/auto_brightness_title"
        android:key="auto_brightness_entry"
        android:summary="@string/summary_placeholder"
        android:fragment="com.android.car.developeroptions.display.AutoBrightnessSettings"
        settings:controller="com.android.car.developeroptions.display.AutoBrightnessPreferenceController"
        settings:keywords="@string/keywords_auto_brightness"/>
    <com.android.settingslib.RestrictedPreference
        android:title="@string/wallpaper_settings_title"
        android:key="wallpaper"
        settings:controller="com.android.car.developeroptions.display.WallpaperPreferenceController"
        settings:keywords="@string/keywords_display_wallpaper"
        settings:useAdminDisabledSummary="true"/>
    <Preference
        android:title="@string/dark_ui_mode"
        android:key="dark_ui_mode"
        android:fragment="com.android.car.developeroptions.display.DarkUISettings"
        settings:controller="com.android.car.developeroptions.display.DarkUIPreferenceController"
        settings:searchable="false"/>
    <com.android.car.developeroptions.display.TimeoutListPreference
        android:entries="@array/screen_timeout_entries"
        android:title="@string/screen_timeout"
        android:key="screen_timeout"
        android:summary="@string/summary_placeholder"
        android:entryValues="@array/screen_timeout_values"
        settings:keywords="@string/keywords_screen_timeout"/>
    <Preference
        android:title="@string/adaptive_sleep_title"
        android:key="adaptive_sleep_entry"
        android:summary="@string/summary_placeholder"
        android:fragment="com.android.car.developeroptions.display.AdaptiveSleepSettings"
        settings:controller="com.android.car.developeroptions.display.AdaptiveSleepPreferenceController"/>
    <SwitchPreference
        android:title="@string/accelerometer_title"
        android:key="auto_rotate"
        settings:controller="com.android.car.developeroptions.display.AutoRotatePreferenceController"
        settings:keywords="@string/keywords_auto_rotate"/>
    <Preference
        android:title="@string/color_mode_title"
        android:key="color_mode"
        android:fragment="com.android.car.developeroptions.display.ColorModePreferenceFragment"
        settings:controller="com.android.car.developeroptions.display.ColorModePreferenceController"
        settings:keywords="@string/keywords_color_mode"/>
    <SwitchPreference
        android:title="@string/display_white_balance_title"
        android:key="display_white_balance"
        settings:controller="com.android.car.developeroptions.display.DisplayWhiteBalancePreferenceController"/>
    <Preference
        android:title="@string/title_font_size"
        android:key="font_size"
        android:fragment="com.android.car.developeroptions.display.ToggleFontSizePreferenceFragment"
        settings:controller="com.android.car.developeroptions.display.FontSizePreferenceController"/>
    <com.android.car.developeroptions.display.ScreenZoomPreference
        android:title="@string/screen_zoom_title"
        android:key="display_settings_screen_zoom"
        android:fragment="com.android.car.developeroptions.display.ScreenZoomSettings"
        settings:searchable="false"/>
    <SwitchPreference
        android:title="@string/show_operator_name_title"
        android:key="show_operator_name"
        android:summary="@string/show_operator_name_summary"/>
    <Preference
        android:title="@string/screensaver_settings_title"
        android:key="screensaver"
        android:fragment="com.android.car.developeroptions.dream.DreamSettings"
        settings:searchable="false"/>
    <com.android.settingslib.RestrictedPreference
        android:title="@string/lockscreen_settings_title"
        android:key="lockscreen_from_display_settings"
        android:fragment="com.android.car.developeroptions.security.LockscreenDashboardFragment"
        settings:controller="com.android.car.developeroptions.security.screenlock.LockScreenPreferenceController"
        settings:userRestriction="no_ambient_display"/>
    <SwitchPreference
        android:title="@string/camera_gesture_title"
        android:key="camera_gesture"
        android:summary="@string/camera_gesture_desc"/>
    <SwitchPreference
        android:title="@string/lift_to_wake_title"
        android:key="lift_to_wake"/>
    <SwitchPreference
        android:title="@string/tap_to_wake"
        android:key="tap_to_wake"
        android:summary="@string/tap_to_wake_summary"/>
    <ListPreference
        android:title="@string/device_theme"
        android:key="theme"
        android:summary="@string/summary_placeholder"/>
    <Preference
        android:title="@string/display_vr_pref_title"
        android:key="vr_display_pref"
        android:fragment="com.android.car.developeroptions.display.VrDisplayPreferencePicker"/>
</PreferenceScreen>
