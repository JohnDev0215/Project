<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:title="@string/privacy_dashboard_title"
    android:key="privacy_dashboard_page"
    settings:initialExpandedChildrenCount="4">
    <com.android.settingslib.widget.BarChartPreference
        android:title="@string/summary_placeholder"
        android:key="permission_bar_chart"
        settings:controller="com.android.car.developeroptions.privacy.PermissionBarChartPreferenceController"/>
    <Preference
        android:title="@string/accessibility_usage_title"
        android:key="privacy_accessibility_usage"
        settings:allowDividerAbove="true"
        settings:controller="com.android.car.developeroptions.privacy.AccessibilityUsagePreferenceController">
        <intent android:action="android.intent.action.REVIEW_ACCESSIBILITY_SERVICES"/>
    </Preference>
    <Preference
        android:title="@string/app_permissions"
        android:key="privacy_manage_perms"
        settings:allowDividerAbove="true"
        settings:controller="com.android.car.developeroptions.applications.AppPermissionsPreferenceController"
        settings:keywords="@string/keywords_app_permissions">
        <intent android:action="android.intent.action.MANAGE_PERMISSIONS"/>
    </Preference>
    <SwitchPreference
        android:title="@string/show_password"
        android:key="show_password"
        android:summary="@string/show_password_summary"
        settings:controller="com.android.car.developeroptions.security.ShowPasswordPreferenceController"/>
    <com.android.car.developeroptions.RestrictedListPreference
        android:title="@string/lock_screen_notifications_title"
        android:key="privacy_lock_screen_notifications"
        android:summary="@string/summary_placeholder"
        settings:searchable="false"/>
    <PreferenceCategory android:key="privacy_services"/>
    <PreferenceCategory android:key="dashboard_tile_placeholder"/>
    <PreferenceCategory
        android:title="@string/profile_section_header"
        android:key="privacy_work_profile_notifications_category"
        android:order="998"
        settings:searchable="false">
        <com.android.car.developeroptions.RestrictedListPreference
            android:title="@string/locked_work_profile_notification_title"
            android:key="privacy_lock_screen_work_profile_notifications"
            android:summary="@string/summary_placeholder"
            android:order="999"
            settings:searchable="false"/>
    </PreferenceCategory>
    <SwitchPreference
        android:title="@string/content_capture"
        android:key="content_capture"
        android:summary="@string/content_capture_summary"
        settings:controller="com.android.car.developeroptions.privacy.EnableContentCapturePreferenceController"/>
    <com.android.car.developeroptions.widget.MasterSwitchPreference
        android:title="@string/content_capture"
        android:key="content_capture_custom_settings"
        android:summary="@string/content_capture_summary"
        settings:controller="com.android.car.developeroptions.privacy.EnableContentCaptureWithServiceSettingsPreferenceController"/>
</PreferenceScreen>
