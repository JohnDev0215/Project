<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:title="@string/hardware_info"
    android:key="hardware_info_screen"
    settings:keywords="@string/keywords_model_and_hardware">
    <Preference
        android:title="@string/model_info"
        android:key="hardware_info_device_model"
        android:summary="@string/summary_placeholder"
        settings:controller="com.android.car.developeroptions.deviceinfo.hardwareinfo.DeviceModelPreferenceController"
        settings:enableCopying="true"/>
    <Preference
        android:title="@string/status_serial_number"
        android:key="hardware_info_device_serial"
        android:summary="@string/summary_placeholder"
        settings:controller="com.android.car.developeroptions.deviceinfo.hardwareinfo.SerialNumberPreferenceController"
        settings:enableCopying="true"/>
    <Preference
        android:title="@string/hardware_revision"
        android:key="hardware_info_device_revision"
        android:summary="@string/summary_placeholder"
        settings:controller="com.android.car.developeroptions.deviceinfo.hardwareinfo.HardwareRevisionPreferenceController"
        settings:enableCopying="true"/>
</PreferenceScreen>
