<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:title="@string/special_access"
    android:key="special_app_access_screen">
    <Preference
        android:title="@string/high_power_apps"
        android:key="high_power_apps"
        android:fragment="com.android.car.developeroptions.applications.manageapplications.ManageApplications"
        settings:controller="com.android.car.developeroptions.applications.specialaccess.HighPowerAppsController"
        settings:keywords="@string/keywords_ignore_optimizations">
        <extra
            android:name="classname"
            android:value="com.android.car.developeroptions.Settings$HighPowerApplicationsActivity"/>
    </Preference>
    <Preference
        android:title="@string/manage_device_admin"
        android:key="device_administrators"
        android:summary="@string/summary_placeholder"
        android:fragment="com.android.car.developeroptions.applications.specialaccess.deviceadmin.DeviceAdminSettings"
        settings:controller="com.android.car.developeroptions.enterprise.ManageDeviceAdminPreferenceController"/>
    <Preference
        android:title="@string/system_alert_window_settings"
        android:key="system_alert_window"
        android:fragment="com.android.car.developeroptions.applications.manageapplications.ManageApplications"
        settings:controller="com.android.car.developeroptions.applications.specialaccess.SystemAlertWindowPreferenceController"
        settings:keywords="@string/keywords_system_alert_window">
        <extra
            android:name="classname"
            android:value="com.android.car.developeroptions.Settings$OverlaySettingsActivity"/>
    </Preference>
    <Preference
        android:title="@string/manage_zen_access_title"
        android:key="zen_access"
        android:fragment="com.android.car.developeroptions.notification.ZenAccessSettings"
        settings:controller="com.android.car.developeroptions.applications.specialaccess.zenaccess.ZenAccessController"/>
    <Preference
        android:title="@string/write_settings"
        android:key="write_settings_apps"
        android:fragment="com.android.car.developeroptions.applications.manageapplications.ManageApplications"
        settings:keywords="@string/keywords_write_settings">
        <extra
            android:name="classname"
            android:value="com.android.car.developeroptions.Settings$WriteSettingsActivity"/>
    </Preference>
    <com.android.settingslib.widget.apppreference.AppPreference
        android:title="@string/notification_assistant_title"
        android:key="notification_assistant"
        android:summary="@string/summary_placeholder"
        settings:controller="com.android.car.developeroptions.notification.NotificationAssistantPreferenceController"
        settings:fragment="com.android.car.developeroptions.notification.NotificationAssistantPicker"/>
    <Preference
        android:title="@string/manage_notification_access_title"
        android:key="notification_access"
        android:fragment="com.android.car.developeroptions.notification.NotificationAccessSettings"
        settings:controller="com.android.car.developeroptions.applications.specialaccess.notificationaccess.NotificationAccessController"/>
    <Preference
        android:title="@string/picture_in_picture_title"
        android:key="picture_in_picture"
        android:fragment="com.android.car.developeroptions.applications.specialaccess.pictureinpicture.PictureInPictureSettings"
        settings:controller="com.android.car.developeroptions.applications.specialaccess.pictureinpicture.PictureInPictureController"
        settings:keywords="@string/picture_in_picture_keywords"/>
    <Preference
        android:title="@string/premium_sms_access"
        android:key="premium_sms"
        android:fragment="com.android.car.developeroptions.applications.specialaccess.premiumsms.PremiumSmsAccess"
        settings:controller="com.android.car.developeroptions.applications.specialaccess.premiumsms.PremiumSmsController"/>
    <Preference
        android:title="@string/nfc_payment_settings_title"
        android:key="default_payment_app"
        android:fragment="com.android.car.developeroptions.nfc.PaymentSettings"
        settings:controller="com.android.car.developeroptions.applications.specialaccess.DefaultPaymentSettingsPreferenceController"
        settings:keywords="@string/keywords_default_payment_app"/>
    <Preference
        android:title="@string/unrestricted_data_saver"
        android:key="data_saver"
        android:fragment="com.android.car.developeroptions.datausage.UnrestrictedDataAccess"
        settings:controller="com.android.car.developeroptions.applications.specialaccess.DataSaverController"/>
    <Preference
        android:title="@string/install_other_apps"
        android:key="manage_external_sources"
        android:fragment="com.android.car.developeroptions.applications.manageapplications.ManageApplications"
        settings:keywords="@string/keywords_install_other_apps">
        <extra
            android:name="classname"
            android:value="com.android.car.developeroptions.Settings$ManageExternalSourcesActivity"/>
    </Preference>
    <Preference
        android:title="@string/usage_access"
        android:key="special_app_usage_access"
        android:fragment="com.android.car.developeroptions.applications.manageapplications.ManageApplications"
        settings:keywords="@string/keywords_write_settings">
        <extra
            android:name="classname"
            android:value="com.android.car.developeroptions.Settings$UsageAccessSettingsActivity"/>
    </Preference>
    <Preference
        android:title="@string/vr_listeners_title"
        android:key="enabled_vr_listeners"
        android:fragment="com.android.car.developeroptions.applications.specialaccess.vrlistener.VrListenerSettings"
        settings:controller="com.android.car.developeroptions.applications.specialaccess.vrlistener.EnabledVrListenersController"
        settings:keywords="@string/keywords_vr_listener">
        <extra
            android:name="classname"
            android:value="com.android.car.developeroptions.Settings$VrListenersSettingsActivity"/>
    </Preference>
    <Preference
        android:title="@string/change_wifi_state_title"
        android:key="change_wifi_state"
        android:fragment="com.android.car.developeroptions.applications.manageapplications.ManageApplications"
        settings:keywords="@string/keywords_change_wifi_state">
        <extra
            android:name="classname"
            android:value="com.android.car.developeroptions.Settings$ChangeWifiStateActivity"/>
    </Preference>
    <Preference
        android:title="@string/financial_apps_sms_access_title"
        android:key="financial_apps_sms_access"
        android:fragment="com.android.car.developeroptions.applications.specialaccess.financialapps.FinancialAppsSmsAccess"
        settings:keywords="@string/keywords_financial_apps_sms_access"/>
    <Preference
        android:title="@string/special_access_more"
        android:key="special_access_more"
        settings:controller="com.android.car.developeroptions.applications.specialaccess.MoreSpecialAccessPreferenceController"/>
</PreferenceScreen>
