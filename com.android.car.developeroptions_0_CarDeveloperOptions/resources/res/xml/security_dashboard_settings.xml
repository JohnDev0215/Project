<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:title="@string/security_settings_title"
    android:key="security_dashboard_page"
    settings:initialExpandedChildrenCount="9">
    <PreferenceCategory
        android:title="@string/security_status_title"
        android:key="security_status"
        android:order="-10"/>
    <PreferenceCategory
        android:key="dashboard_tile_placeholder"
        android:order="1"/>
    <PreferenceCategory
        android:title="@string/lock_settings_title"
        android:key="security_category"
        android:order="10">
        <com.android.car.developeroptions.widget.GearPreference
            android:title="@string/unlock_set_unlock_launch_picker_title"
            android:key="unlock_set_or_change"
            android:summary="@string/summary_placeholder"
            settings:keywords="@string/keywords_lockscreen"/>
        <Preference
            android:title="@string/security_settings_fingerprint_preference_title"
            android:key="fingerprint_settings"
            android:summary="@string/summary_placeholder"
            settings:keywords="@string/keywords_fingerprint_settings"/>
        <Preference
            android:title="@string/security_settings_face_preference_title"
            android:key="face_settings"
            android:summary="@string/summary_placeholder"
            settings:keywords="@string/keywords_face_settings"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/lock_settings_profile_title"
        android:key="security_category_profile"
        android:order="20">
        <com.android.settingslib.RestrictedSwitchPreference
            android:title="@string/lock_settings_profile_unification_title"
            android:key="unification"
            android:summary="@string/lock_settings_profile_unification_summary"
            settings:keywords="@string/keywords_unification"/>
        <com.android.settingslib.RestrictedPreference
            android:title="@string/unlock_set_unlock_launch_picker_title_profile"
            android:key="unlock_set_or_change_profile"
            android:summary="@string/unlock_set_unlock_mode_pattern"
            settings:keywords="@string/keywords_lockscreen"/>
        <SwitchPreference
            android:title="@string/lockpattern_settings_enable_visible_pattern_title_profile"
            android:key="visiblepattern_profile"
            android:summary="@string/summary_placeholder"
            settings:controller="com.android.car.developeroptions.security.VisiblePatternProfilePreferenceController"/>
        <Preference
            android:title="@string/security_settings_fingerprint_preference_title"
            android:key="fingerprint_settings_profile"
            android:summary="@string/summary_placeholder"/>
        <Preference
            android:title="@string/security_settings_face_preference_title"
            android:key="face_settings_profile"
            android:summary="@string/summary_placeholder"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:key="security_settings_device_admin_category"
        android:order="40">
        <Preference
            android:title="@string/manage_device_admin"
            android:key="manage_device_admin"
            android:summary="@string/summary_placeholder"
            android:fragment="com.android.car.developeroptions.applications.specialaccess.deviceadmin.DeviceAdminSettings"
            settings:controller="com.android.car.developeroptions.enterprise.ManageDeviceAdminPreferenceController"/>
        <Preference
            android:title="@string/enterprise_privacy_settings"
            android:key="enterprise_privacy"
            android:summary="@string/summary_placeholder"
            android:fragment="com.android.car.developeroptions.enterprise.EnterprisePrivacySettings"/>
    </PreferenceCategory>
    <Preference
        android:title="@string/sim_lock_settings_category"
        android:key="sim_lock_settings"
        android:order="50">
        <intent
            android:targetPackage="com.android.car.developeroptions"
            android:action="android.intent.action.MAIN"
            android:targetClass="com.android.car.developeroptions.Settings$IccLockSettingsActivity"/>
    </Preference>
    <Preference
        android:title="@string/encryption_and_credential_settings_title"
        android:key="encryption_and_credential"
        android:summary="@string/encryption_and_credential_settings_summary"
        android:order="60"
        android:fragment="com.android.car.developeroptions.security.EncryptionAndCredential"/>
    <Preference
        android:title="@string/screen_pinning_title"
        android:key="screen_pinning_settings"
        android:summary="@string/summary_placeholder"
        android:order="80"
        android:fragment="com.android.car.developeroptions.security.ScreenPinningSettings"/>
</PreferenceScreen>
