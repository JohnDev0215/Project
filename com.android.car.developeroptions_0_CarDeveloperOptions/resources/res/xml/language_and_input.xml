<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:title="@string/language_settings"
    android:key="language_and_input_settings_screen"
    settings:initialExpandedChildrenCount="3">
    <Preference
        android:icon="@drawable/ic_translate_24dp"
        android:title="@string/phone_language"
        android:key="phone_language"
        android:fragment="com.android.car.developeroptions.localepicker.LocaleListEditor"/>
    <PreferenceCategory
        android:title="@string/keyboard_and_input_methods_category"
        android:key="keyboards_category">
        <Preference
            android:title="@string/virtual_keyboard_category"
            android:key="virtual_keyboard_pref"
            android:fragment="com.android.car.developeroptions.inputmethod.VirtualKeyboardFragment"/>
        <Preference
            android:title="@string/physical_keyboard_title"
            android:key="physical_keyboard_pref"
            android:summary="@string/summary_placeholder"
            android:fragment="com.android.car.developeroptions.inputmethod.PhysicalKeyboardFragment"
            settings:searchable="false"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/input_assistance"
        android:key="input_assistance_category">
        <Preference
            android:persistent="false"
            android:title="@string/spellcheckers_settings_title"
            android:key="spellcheckers_settings"
            android:fragment="com.android.car.developeroptions.inputmethod.SpellCheckersSettings"/>
        <Preference
            android:title="@string/autofill_app"
            android:key="default_autofill"
            android:fragment="com.android.car.developeroptions.applications.defaultapps.AutofillPicker"
            settings:keywords="@string/autofill_keywords"/>
        <Preference
            android:title="@string/user_dict_settings_title"
            android:key="key_user_dictionary_settings"
            android:fragment="com.android.car.developeroptions.inputmethod.UserDictionaryList"
            settings:controller="com.android.car.developeroptions.language.UserDictionaryPreferenceController"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:layout="@layout/preference_category_no_label"
        android:key="pointer_and_tts_category">
        <com.android.car.developeroptions.PointerSpeedPreference
            android:title="@string/pointer_speed"
            android:key="pointer_speed"
            android:dialogTitle="@string/pointer_speed"/>
        <Preference
            android:title="@string/tts_settings_title"
            android:key="tts_settings_summary"
            android:fragment="com.android.car.developeroptions.tts.TextToSpeechSettings"
            settings:searchable="false"/>
    </PreferenceCategory>
    <SwitchPreference
        android:title="@string/vibrate_input_devices"
        android:key="vibrate_input_devices"
        android:summary="@string/vibrate_input_devices_summary"
        settings:controller="com.android.car.developeroptions.inputmethod.GameControllerPreferenceController"/>
    <com.android.car.developeroptions.widget.WorkOnlyCategory
        android:title="@string/language_and_input_for_work_category_title"
        android:key="language_and_input_for_work_category"
        settings:searchable="false">
        <Preference
            android:title="@string/virtual_keyboards_for_work_title"
            android:key="virtual_keyboards_for_work_pref"
            android:fragment="com.android.car.developeroptions.inputmethod.VirtualKeyboardFragment"
            settings:controller="com.android.car.developeroptions.inputmethod.VirtualKeyboardForWorkPreferenceController"/>
        <Preference
            android:title="@string/spellcheckers_settings_for_work_title"
            android:key="spellcheckers_settings_for_work_pref"
            android:fragment="com.android.car.developeroptions.inputmethod.SpellCheckersSettings"
            settings:controller="com.android.car.developeroptions.language.UserDictionaryForWorkPreferenceController"/>
        <Preference
            android:title="@string/user_dict_settings_for_work_title"
            android:key="user_dictionary_settings_for_work_pref"
            android:fragment="com.android.car.developeroptions.inputmethod.UserDictionaryList"
            settings:controller="com.android.car.developeroptions.inputmethod.SpellCheckerForWorkPreferenceController"/>
    </com.android.car.developeroptions.widget.WorkOnlyCategory>
</PreferenceScreen>
