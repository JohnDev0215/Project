<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:title="@string/nfc_payment_settings_title"
    android:key="nfc_payment_settings_screen">
    <com.android.car.developeroptions.nfc.NfcPaymentPreference
        android:title="@string/nfc_payment_default"
        android:key="nfc_payment"
        android:widgetLayout="@layout/preference_widget_gear"
        android:dialogTitle="@string/nfc_payment_pay_with"
        settings:controller="com.android.car.developeroptions.nfc.NfcPaymentPreferenceController"/>
    <DropDownPreference
        android:title="@string/nfc_payment_use_default"
        android:key="nfc_foreground"
        settings:controller="com.android.car.developeroptions.nfc.NfcForegroundPreferenceController"/>
</PreferenceScreen>
