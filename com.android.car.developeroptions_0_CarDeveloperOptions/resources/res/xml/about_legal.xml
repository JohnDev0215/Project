<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:title="@string/legal_information"
    android:key="legal_screen">
    <Preference
        android:title="@string/copyright_title"
        android:key="copyright"
        settings:controller="com.android.car.developeroptions.deviceinfo.legal.CopyrightPreferenceController"/>
    <Preference
        android:title="@string/license_title"
        android:key="license"
        settings:controller="com.android.car.developeroptions.deviceinfo.legal.LicensePreferenceController"/>
    <Preference
        android:title="@string/terms_title"
        android:key="terms"
        settings:controller="com.android.car.developeroptions.deviceinfo.legal.TermsPreferenceController"/>
    <Preference
        android:title="@string/webview_license_title"
        android:key="webview_license"
        settings:controller="com.android.car.developeroptions.deviceinfo.legal.WebViewLicensePreferenceController"/>
    <Preference
        android:title="@string/wallpaper_attributions"
        android:key="wallpaper_attributions"
        android:summary="@string/wallpaper_attributions_values"
        settings:controller="com.android.car.developeroptions.deviceinfo.legal.WallpaperAttributionsPreferenceController"/>
</PreferenceScreen>
