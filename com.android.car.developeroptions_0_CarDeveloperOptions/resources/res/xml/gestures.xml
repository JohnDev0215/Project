<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:title="@string/gesture_preference_title"
    android:key="gesture_settings_screen">
    <Preference
        android:title="@string/assist_gesture_title"
        android:key="gesture_assist_input_summary"
        android:fragment="com.android.car.developeroptions.gestures.AssistGestureSettings"
        settings:controller="com.android.car.developeroptions.gestures.AssistGestureSettingsPreferenceController"/>
    <Preference
        android:title="@string/fingerprint_swipe_for_notifications_title"
        android:key="gesture_swipe_down_fingerprint_input_summary"
        android:fragment="com.android.car.developeroptions.gestures.SwipeToNotificationSettings"
        settings:controller="com.android.car.developeroptions.gestures.SwipeToNotificationPreferenceController"/>
    <Preference
        android:title="@string/double_tap_power_for_camera_title"
        android:key="gesture_double_tap_power_input_summary"
        android:fragment="com.android.car.developeroptions.gestures.DoubleTapPowerSettings"
        settings:controller="com.android.car.developeroptions.gestures.DoubleTapPowerPreferenceController"/>
    <Preference
        android:title="@string/double_twist_for_camera_mode_title"
        android:key="gesture_double_twist_input_summary"
        android:fragment="com.android.car.developeroptions.gestures.DoubleTwistGestureSettings"
        settings:controller="com.android.car.developeroptions.gestures.DoubleTwistPreferenceController"/>
    <Preference
        android:title="@string/system_navigation_title"
        android:key="gesture_system_navigation_input_summary"
        android:fragment="com.android.car.developeroptions.gestures.SystemNavigationGestureSettings"
        settings:controller="com.android.car.developeroptions.gestures.SystemNavigationLegacyPreferenceController"/>
    <Preference
        android:title="@string/ambient_display_tap_screen_title"
        android:key="gesture_tap_screen_input_summary"
        android:fragment="com.android.car.developeroptions.gestures.TapScreenGestureSettings"
        settings:controller="com.android.car.developeroptions.gestures.TapScreenGesturePreferenceController"/>
    <Preference
        android:title="@string/ambient_display_title"
        android:key="gesture_double_tap_screen_input_summary"
        android:fragment="com.android.car.developeroptions.gestures.DoubleTapScreenSettings"
        settings:controller="com.android.car.developeroptions.gestures.DoubleTapScreenPreferenceController"/>
    <Preference
        android:title="@string/ambient_display_pickup_title"
        android:key="gesture_pick_up_input_summary"
        android:fragment="com.android.car.developeroptions.gestures.PickupGestureSettings"
        settings:controller="com.android.car.developeroptions.gestures.PickupGesturePreferenceController"/>
    <Preference
        android:title="@string/gesture_prevent_ringing_screen_title"
        android:key="gesture_prevent_ringing_summary"
        android:fragment="com.android.car.developeroptions.gestures.PreventRingingGestureSettings"
        settings:controller="com.android.car.developeroptions.gestures.PreventRingingParentPreferenceController"/>
</PreferenceScreen>
