<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/accessibility_vibration_settings_title"
    android:key="accessibility_settings_vibration_screen">
    <Preference
        android:title="@string/accessibility_ring_vibration_title"
        android:key="ring_vibration_preference_screen"
        android:fragment="com.android.car.developeroptions.accessibility.RingVibrationPreferenceFragment"
        app:controller="com.android.car.developeroptions.accessibility.RingVibrationIntensityPreferenceController"
        app:keywords="@string/keywords_ring_vibration"/>
    <Preference
        android:title="@string/accessibility_notification_vibration_title"
        android:key="notification_vibration_preference_screen"
        android:fragment="com.android.car.developeroptions.accessibility.NotificationVibrationPreferenceFragment"
        app:controller="com.android.car.developeroptions.accessibility.NotificationVibrationIntensityPreferenceController"
        app:keywords="@string/keywords_notification_vibration"/>
    <Preference
        android:title="@string/accessibility_touch_vibration_title"
        android:key="touch_vibration_preference_screen"
        android:fragment="com.android.car.developeroptions.accessibility.TouchVibrationPreferenceFragment"
        app:controller="com.android.car.developeroptions.accessibility.HapticFeedbackIntensityPreferenceController"
        app:keywords="@string/keywords_touch_vibration"/>
</PreferenceScreen>
