<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:title="@string/privacy_settings_title"
    android:key="privacy_settings_screen">
    <Preference
        android:persistent="false"
        android:title="@string/backup_data_title"
        android:key="backup_data"
        android:fragment="com.android.car.developeroptions.backup.ToggleBackupSettingFragment"
        settings:controller="com.android.car.developeroptions.backup.BackupDataPreferenceController"/>
    <Preference
        android:persistent="false"
        android:title="@string/backup_configure_account_title"
        android:key="configure_account"
        settings:controller="com.android.car.developeroptions.backup.ConfigureAccountPreferenceController">
        <intent android:action="dummy"/>
    </Preference>
    <Preference
        android:title="@string/backup_data_management_title"
        android:key="data_management"
        settings:controller="com.android.car.developeroptions.backup.DataManagementPreferenceController"/>
    <SwitchPreference
        android:title="@string/auto_restore_title"
        android:key="auto_restore"
        android:summary="@string/auto_restore_summary"
        settings:controller="com.android.car.developeroptions.backup.AutoRestorePreferenceController"/>
    <Preference
        android:enabled="false"
        android:title="@string/backup_inactive_title"
        android:selectable="false"
        android:key="backup_inactive"
        settings:controller="com.android.car.developeroptions.backup.BackupInactivePreferenceController"/>
</PreferenceScreen>
