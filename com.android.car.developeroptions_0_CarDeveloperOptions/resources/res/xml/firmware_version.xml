<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:title="@string/firmware_version"
    android:key="firmware_version_screen"
    settings:keywords="@string/keywords_android_version">
    <Preference
        android:title="@string/firmware_version"
        android:key="os_firmware_version"
        android:summary="@string/summary_placeholder"
        settings:controller="com.android.car.developeroptions.deviceinfo.firmwareversion.FirmwareVersionDetailPreferenceController"
        settings:enableCopying="true"/>
    <Preference
        android:title="@string/security_patch"
        android:key="security_key"
        settings:controller="com.android.car.developeroptions.deviceinfo.firmwareversion.SecurityPatchLevelPreferenceController"
        settings:enableCopying="true"/>
    <Preference
        android:title="@string/module_version"
        android:key="module_version"
        android:summary="@string/summary_placeholder"
        settings:controller="com.android.car.developeroptions.deviceinfo.firmwareversion.MainlineModuleVersionPreferenceController"
        settings:enableCopying="true"/>
    <Preference
        android:title="@string/baseband_version"
        android:key="base_band"
        android:summary="@string/summary_placeholder"
        settings:controller="com.android.car.developeroptions.deviceinfo.firmwareversion.BasebandVersionPreferenceController"
        settings:enableCopying="true"/>
    <Preference
        android:title="@string/kernel_version"
        android:key="kernel_version"
        android:summary="@string/summary_placeholder"
        settings:controller="com.android.car.developeroptions.deviceinfo.firmwareversion.KernelVersionPreferenceController"
        settings:enableCopying="true"/>
    <Preference
        android:title="@string/build_number"
        android:key="os_build_number"
        android:summary="@string/summary_placeholder"
        settings:controller="com.android.car.developeroptions.deviceinfo.firmwareversion.SimpleBuildNumberPreferenceController"
        settings:enableCopying="true"/>
</PreferenceScreen>
