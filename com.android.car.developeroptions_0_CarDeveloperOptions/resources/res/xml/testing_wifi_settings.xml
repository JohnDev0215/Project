<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/testing_wifi_info"
    android:key="parent">
    <Preference android:title="@string/wifi_api_test">
        <intent
            android:targetPackage="com.android.car.developeroptions"
            android:action="android.intent.action.MAIN"
            android:targetClass="com.android.car.developeroptions.Settings$WifiAPITestActivity"/>
    </Preference>
    <Preference android:title="@string/wifi_config_info">
        <intent
            android:targetPackage="com.android.car.developeroptions"
            android:action="android.intent.action.MAIN"
            android:targetClass="com.android.car.developeroptions.wifi.WifiConfigInfo"/>
    </Preference>
    <Preference android:title="@string/wifi_status_test">
        <intent
            android:targetPackage="com.android.car.developeroptions"
            android:action="android.intent.action.MAIN"
            android:targetClass="com.android.car.developeroptions.wifi.WifiStatusTest"/>
    </Preference>
</PreferenceScreen>
