<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:title="@string/about_settings"
    android:key="my_device_info_pref_screen">
    <com.android.settingslib.widget.LayoutPreference
        android:layout="@layout/settings_entity_header"
        android:selectable="false"
        android:key="my_device_info_header"
        android:order="0"
        settings:isPreferenceVisible="false"/>
    <com.android.car.developeroptions.widget.ValidatedEditTextPreference
        android:title="@string/my_device_info_device_name_preference_title"
        android:key="device_name"
        android:summary="@string/summary_placeholder"
        android:order="1"
        settings:controller="com.android.car.developeroptions.deviceinfo.DeviceNamePreferenceController"
        settings:enableCopying="true"/>
    <Preference
        android:title="@string/my_device_info_account_preference_title"
        android:key="branded_account"
        android:summary="@string/summary_placeholder"
        android:order="2"
        settings:controller="com.android.car.developeroptions.deviceinfo.BrandedAccountPreferenceController"/>
    <Preference
        android:title="@string/status_number"
        android:selectable="false"
        android:key="phone_number"
        android:summary="@string/summary_placeholder"
        android:order="3"
        settings:controller="com.android.car.developeroptions.deviceinfo.PhoneNumberPreferenceController"
        settings:enableCopying="true"/>
    <Preference
        android:title="@string/emergency_info_title"
        android:key="emergency_info"
        android:summary="@string/summary_placeholder"
        android:order="4"
        settings:controller="com.android.car.developeroptions.accounts.EmergencyInfoPreferenceController"/>
    <Preference
        android:title="@string/legal_information"
        android:key="legal_container"
        android:order="5"
        android:fragment="com.android.car.developeroptions.LegalSettings"
        settings:allowDividerAbove="true"
        settings:searchable="false"/>
    <Preference
        android:title="@string/regulatory_labels"
        android:key="regulatory_info"
        android:order="6">
        <intent android:action="android.settings.SHOW_REGULATORY_INFO"/>
    </Preference>
    <Preference
        android:title="@string/safety_and_regulatory_info"
        android:key="safety_info"
        android:order="7">
        <intent android:action="android.settings.SHOW_SAFETY_AND_REGULATORY_INFO"/>
    </Preference>
    <Preference
        android:title="@string/sim_status_title"
        android:key="sim_status"
        android:summary="@string/summary_placeholder"
        android:order="8"
        settings:allowDividerAbove="true"
        settings:keywords="@string/keywords_sim_status"/>
    <Preference
        android:title="@string/hardware_info"
        android:key="device_model"
        android:summary="@string/summary_placeholder"
        android:order="21"
        android:fragment="com.android.car.developeroptions.deviceinfo.hardwareinfo.HardwareInfoFragment"
        settings:controller="com.android.car.developeroptions.deviceinfo.HardwareInfoPreferenceController"
        settings:keywords="@string/keywords_model_and_hardware"/>
    <Preference
        android:title="@string/status_imei"
        android:key="imei_info"
        android:summary="@string/summary_placeholder"
        android:order="22"
        settings:controller="com.android.car.developeroptions.deviceinfo.imei.ImeiInfoPreferenceController"
        settings:keywords="@string/keywords_imei_info"/>
    <Preference
        android:title="@string/firmware_version"
        android:key="firmware_version"
        android:summary="@string/summary_placeholder"
        android:order="32"
        android:fragment="com.android.car.developeroptions.deviceinfo.firmwareversion.FirmwareVersionSettings"
        settings:controller="com.android.car.developeroptions.deviceinfo.firmwareversion.FirmwareVersionPreferenceController"/>
    <Preference
        android:title="@string/wifi_ip_address"
        android:selectable="false"
        android:key="wifi_ip_address"
        android:summary="@string/summary_placeholder"
        android:order="34"
        settings:allowDividerAbove="true"
        settings:enableCopying="true"/>
    <Preference
        android:title="@string/status_wifi_mac_address"
        android:selectable="false"
        android:key="wifi_mac_address"
        android:summary="@string/summary_placeholder"
        android:order="35"
        settings:enableCopying="true"/>
    <Preference
        android:title="@string/status_bt_address"
        android:selectable="false"
        android:key="bt_address"
        android:summary="@string/summary_placeholder"
        android:order="36"
        settings:enableCopying="true"/>
    <Preference
        android:title="@string/status_up_time"
        android:selectable="false"
        android:key="up_time"
        android:summary="@string/summary_placeholder"
        android:order="37"/>
    <Preference
        android:title="@string/manual"
        android:key="manual"
        android:order="40">
        <intent android:action="android.settings.SHOW_MANUAL"/>
    </Preference>
    <Preference
        android:title="@string/device_feedback"
        android:key="device_feedback"
        android:order="41"
        settings:keywords="@string/keywords_device_feedback"/>
    <Preference
        android:title="@string/fcc_equipment_id"
        android:key="fcc_equipment_id"
        android:summary="@string/summary_placeholder"
        android:order="42"/>
    <Preference
        android:title="@string/build_number"
        android:key="build_number"
        android:summary="@string/summary_placeholder"
        android:order="43"
        settings:allowDividerAbove="true"
        settings:controller="com.android.car.developeroptions.deviceinfo.BuildNumberPreferenceController"
        settings:enableCopying="true"/>
</PreferenceScreen>
