<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/item_close"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_12"
        android:src="@mipmap/ic_dialog_close"
        android:layout_marginStart="@dimen/dp_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="@color/carousel_title"
        android:id="@+id/item_title"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_29"
        android:layout_marginTop="@dimen/dp_22"
        android:text="@string/str_add_carousel_wallpaper"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="@color/carousel_edit_enabled"
        android:id="@+id/item_edit"
        android:paddingTop="@dimen/dp_11"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_11"
        android:text="@string/str_complete"
        android:paddingStart="@dimen/dp_18"
        android:paddingEnd="@dimen/dp_18"
        android:layout_marginEnd="@dimen/dp_7"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/item_line"
        android:background="@color/carousel_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_marginTop="@dimen/dp_21"
        app:layout_constraintTop_toBottomOf="@+id/item_title"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/tab_top_layout"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/item_line">
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_layout"
            android:background="@color/transparent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_27"
            app:tabBackground="@color/transparent"
            app:tabIndicator="@drawable/ic_tab_indicator"
            app:tabIndicatorColor="@color/carousel_tab_indicator"
            app:tabIndicatorHeight="@dimen/dp_4"
            app:tabRippleColor="@color/transparent"
            app:tabSelectedTextColor="@color/carousel_tab_indicator"
            app:tabTextAppearance="@style/TabLayoutTextStyle"
            app:tabTextColor="@color/carousel_tab_indicator_text">
            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_carousel_add_wallpaper"/>
            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_carousel_add_photo"/>
        </com.google.android.material.tabs.TabLayout>
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/carousel_add_count_text"
            android:gravity="center"
            android:id="@+id/select_count_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/dp_36"/>
    </LinearLayout>
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/view_pager"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tab_top_layout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
