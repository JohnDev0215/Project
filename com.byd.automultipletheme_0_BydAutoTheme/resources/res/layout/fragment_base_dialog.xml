<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/dp_560"
    android:layout_height="@dimen/dp_312">
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="@color/item_action_text"
        android:id="@+id/dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_22"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/item_line"
        android:background="@color/carousel_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_marginTop="@dimen/dp_20"
        app:layout_constraintTop_toBottomOf="@+id/dialog_title"/>
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="@color/item_action_text"
        android:id="@+id/dialog_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_48"
        android:layout_marginEnd="@dimen/dp_48"
        app:layout_constraintBottom_toTopOf="@+id/dialog_ok"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/item_line"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/glv50"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/dialog_ok"
        android:background="@drawable/ic_dialog_btn_ok"
        android:paddingTop="@dimen/dp_11"
        android:paddingBottom="@dimen/dp_11"
        android:layout_width="@dimen/dp_176"
        android:layout_height="@dimen/dp_48"
        android:layout_marginBottom="@dimen/dp_28"
        android:layout_marginEnd="@dimen/dp_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/glv50"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="@color/dialogBtnCancelTxtBg"
        android:gravity="center"
        android:id="@+id/dialog_cancel"
        android:background="@drawable/ic_dialog_btn_cancel"
        android:paddingTop="@dimen/dp_11"
        android:paddingBottom="@dimen/dp_11"
        android:layout_width="@dimen/dp_176"
        android:layout_height="@dimen/dp_48"
        android:layout_marginBottom="@dimen/dp_28"
        android:layout_marginStart="@dimen/dp_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/glv50"/>
</androidx.constraintlayout.widget.ConstraintLayout>
