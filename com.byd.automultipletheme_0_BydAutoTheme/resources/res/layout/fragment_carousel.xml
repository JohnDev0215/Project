<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/item_close"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_12"
        android:src="@mipmap/ic_dialog_close"
        android:layout_marginStart="@dimen/dp_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="@color/carousel_title"
        android:id="@+id/item_title"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_29"
        android:layout_marginTop="@dimen/dp_22"
        android:text="@string/str_carousel_wallpaper"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="@drawable/ic_carousel_edit_text_color"
        android:id="@+id/item_edit"
        android:paddingTop="@dimen/dp_11"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_11"
        android:text="@string/str_edit"
        android:paddingStart="@dimen/dp_18"
        android:paddingEnd="@dimen/dp_18"
        android:layout_marginEnd="@dimen/dp_7"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/item_line"
        android:background="@color/carousel_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_marginTop="@dimen/dp_21"
        app:layout_constraintTop_toBottomOf="@+id/item_title"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="@color/carousel_tips"
        android:gravity="center"
        android:id="@+id/item_carousel_tips"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_26"
        android:layout_marginTop="@dimen/dp_22"
        android:text="@string/str_carousel_Interval"
        android:layout_marginStart="@dimen/dp_28"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/item_line"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:gravity="center_vertical"
        android:id="@+id/item_carousel_time"
        android:background="@drawable/ic_carousel_time_bg"
        android:layout_width="@dimen/dp_104"
        android:layout_height="@dimen/dp_26"
        android:text="@string/str_carousel_popup_day"
        android:paddingStart="@dimen/dp_12"
        app:drawableRightCompat="@mipmap/ic_triangle_dowm"
        app:layout_constraintBottom_toBottomOf="@+id/item_carousel_tips"
        app:layout_constraintStart_toEndOf="@+id/item_carousel_tips"
        app:layout_constraintTop_toTopOf="@+id/item_carousel_tips"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_547"
        android:layout_marginStart="@dimen/dp_18"
        android:layout_marginEnd="@dimen/dp_18"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/item_carousel_time"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:id="@+id/item_action_background"
        android:background="@drawable/gradient_background"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_178"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/item_action"
            android:background="@drawable/ic_item_button_bg"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_48"
            android:layout_marginBottom="@dimen/dp_26"
            android:minWidth="@dimen/dp_176"
            android:text="@string/str_use_now"
            android:paddingStart="@dimen/dp_52"
            android:paddingEnd="@dimen/dp_52"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
