<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/fragment_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/tab_top_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_128"
        android:layoutDirection="ltr"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.byd.automultipletheme.widget.CommonTabLayout
            android:id="@+id/tab_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.byd.automultipletheme.widget.CommonTabItem
                android:icon="@mipmap/ic_theme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_theme"/>
            <com.byd.automultipletheme.widget.CommonTabItem
                android:icon="@mipmap/ic_wallpaper"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_wallpaper"/>
        </com.byd.automultipletheme.widget.CommonTabLayout>
    </LinearLayout>
    <androidx.fragment.app.FragmentContainerView
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:id="@+id/container_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tab_top_layout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
