<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.byd.automultipletheme.widget.MyScrollView
        android:background="@drawable/fragment_background"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent">
        <RelativeLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="@dimen/dp_28"
            android:paddingBottom="@dimen/dp_58"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:nestedScrollingEnabled="false"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/app_version_color"
                android:gravity="center"
                android:id="@+id/app_version"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_60"
                android:layout_below="@+id/recycler_view"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/copyright_color"
                android:gravity="center"
                android:id="@+id/app_copyright"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_17"
                android:text="@string/str_copyright"
                android:layout_below="@+id/app_version"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
    </com.byd.automultipletheme.widget.MyScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
