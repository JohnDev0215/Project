<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/social_connect_layout"
    android:background="?attr/selectableItemBackground"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/social_connect_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/social_connect_title_inactive"
        android:maxLines="2"
        app:layout_constraintBottom_toTopOf="@+id/social_connect_subtitle"
        app:layout_constraintEnd_toStartOf="@+id/social_connect_button_start"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/SettingsTitle"/>
    <TextView
        android:textSize="@dimen/settings_text_size_secondary"
        android:textColor="@color/activity_text_primary"
        android:ellipsize="end"
        android:id="@+id/social_connect_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/social_connect_subtitle_inactive"
        android:maxLines="2"
        app:layout_constraintEnd_toStartOf="@+id/social_connect_button_start"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/social_connect_title"/>
    <Button
        android:id="@+id/social_connect_button_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/social_connect_button_start"
        android:filterTouchesWhenObscured="true"
        android:textAllCaps="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/social_connect_title"
        style="@style/GreenButtonStyle"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/social_connect_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="social_connect_subtitle,social_connect_button_start"/>
    <TextView
        android:textSize="@dimen/settings_text_size_secondary"
        android:textColor="@color/activity_text_error"
        android:ellipsize="end"
        android:gravity="end"
        android:id="@+id/social_connect_error"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintTop_toBottomOf="@+id/social_connect_barrier"/>
</androidx.constraintlayout.widget.ConstraintLayout>
