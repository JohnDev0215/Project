<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:elevation="16dp"
    app:cardBackgroundColor="@color/dialog_background"
    app:cardCornerRadius="@dimen/dialog_corner_radius">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content_view"
        android:paddingTop="@dimen/dialog_inner_padding"
        android:paddingBottom="@dimen/dialog_inner_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/header_view"
            android:paddingTop="@dimen/dialog_inner_padding"
            android:paddingBottom="@dimen/dialog_inner_padding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dialog_inner_padding"
            android:layout_marginEnd="@dimen/dialog_inner_padding">
            <ImageView
                android:gravity="start"
                android:id="@+id/icon_view"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dialog_inner_padding"/>
            <TextView
                android:gravity="start|center_vertical"
                android:id="@+id/title"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dialog_header_height"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/dialog_body_text_size"
            android:textColor="@color/activity_text_tertiary"
            android:id="@+id/body"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dialog_button_vertical_padding"
            android:fontFamily="sans-serif"
            android:layout_marginStart="@dimen/dialog_inner_padding"
            android:layout_marginEnd="@dimen/dialog_inner_padding"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/button_panel"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dialog_action_bar_height">
            <Button
                android:id="@+id/positive_button"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:filterTouchesWhenObscured="true"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="20dp"
                style="@style/CarAlertDialogButton"/>
            <Button
                android:id="@+id/negative_button"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:filterTouchesWhenObscured="true"
                style="@style/CarAlertDialogButton"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
