<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/ActivityTheme">
    <include layout="@layout/layout_login_top"/>
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/login_text_need_help"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/logo"
        app:layout_constraintVertical_bias="@dimen/login_pin_vertical_bias">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/pin_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/login_text_size_primary"
                    android:textColor="@color/activity_text_primary"
                    android:id="@+id/pin_url_instructions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_pin_instructions1"
                    android:textAlignment="center"/>
                <TextView
                    android:textSize="@dimen/login_text_size_primary"
                    android:textStyle="bold"
                    android:textColor="@color/activity_text_secondary"
                    android:id="@+id/pin_url"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAllCaps="true"
                    android:textAlignment="center"
                    android:layout_marginStart="@dimen/login_pin_url_spacing"/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/login_text_size_primary"
                android:textColor="@color/activity_text_primary"
                android:id="@+id/pin_instructions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/login_pin_top_margin"
                android:text="@string/login_pin_instructions2"
                android:textAlignment="center"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/pin_code"
                android:layout_width="@dimen/login_pin_code_total_width"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/login_pin_code_top_margin"/>
        </LinearLayout>
        <include layout="@layout/layout_login_error"/>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/progressbar"
            android:visibility="gone"
            style="@style/LoadingIndicator"/>
    </FrameLayout>
    <include layout="@layout/layout_login_bottom"/>
</androidx.constraintlayout.widget.ConstraintLayout>
