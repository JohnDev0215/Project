<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/ActivityTheme">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="@dimen/activity_toolbar_height"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:titleTextAppearance="@style/TextAppearance.Header1"
        app:titleTextColor="@color/activity_text_primary"/>
    <View
        android:id="@+id/guideline"
        android:background="@color/activity_text_primary"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/guideline">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="@dimen/settings_top_margin"
            android:paddingBottom="@dimen/settings_bottom_margin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/settings_start_margin"
            android:layout_marginEnd="@dimen/settings_end_margin">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/profile_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/settings_header_margin">
                <ImageView
                    android:id="@+id/profile_image"
                    android:layout_width="@dimen/settings_user_image_size"
                    android:layout_height="@dimen/settings_user_image_size"
                    android:src="@drawable/profile_placeholder"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/settings_text_image_spacing"
                    android:layout_marginEnd="@dimen/settings_text_image_spacing"
                    app:layout_constraintBottom_toBottomOf="@+id/profile_image"
                    app:layout_constraintEnd_toStartOf="@+id/logo"
                    app:layout_constraintStart_toEndOf="@+id/profile_image"
                    app:layout_constraintTop_toTopOf="@+id/profile_image">
                    <TextView
                        android:textSize="@dimen/settings_text_size_display_name"
                        android:textStyle="bold"
                        android:textColor="@color/activity_text_primary"
                        android:ellipsize="end"
                        android:id="@+id/login_username"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"/>
                    <TextView
                        android:textSize="@dimen/settings_text_size_secondary"
                        android:textColor="@color/activity_text_tertiary"
                        android:id="@+id/product_type"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"/>
                </LinearLayout>
                <ImageView
                    android:id="@+id/logo"
                    android:layout_width="@dimen/settings_logo_size"
                    android:layout_height="@dimen/settings_logo_size"
                    android:src="@drawable/spotify_logo_small"
                    android:layout_marginEnd="@dimen/settings_text_image_spacing"
                    app:layout_constraintBottom_toBottomOf="@+id/version"
                    app:layout_constraintEnd_toStartOf="@+id/version"
                    app:layout_constraintTop_toTopOf="@+id/version"
                    app:tint="@color/spotify_logo_small"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="@+id/profile_image"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/profile_image">
                    <TextView
                        android:textSize="@dimen/settings_text_size_primary"
                        android:textStyle="bold"
                        android:textColor="@color/activity_text_primary"
                        android:id="@+id/app_version_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_version"/>
                    <TextView
                        android:textSize="@dimen/settings_text_size_secondary"
                        android:textColor="@color/activity_text_tertiary"
                        android:id="@+id/app_version"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <include
                app:layout_constraintTop_toBottomOf="@+id/profile_layout"
                layout="@layout/layout_settings_social_connect"/>
            <FrameLayout
                android:layout_gravity="center_horizontal"
                android:id="@+id/social_connect_scannable_layout"
                android:background="@drawable/scannable_background"
                android:paddingTop="@dimen/settings_social_connect_scannable_padding"
                android:paddingBottom="@dimen/settings_social_connect_scannable_padding"
                android:visibility="gone"
                android:layout_width="@dimen/settings_social_connect_scannable_size"
                android:layout_height="@dimen/settings_social_connect_scannable_size"
                android:layout_marginTop="@dimen/settings_social_connect_scannable_top_margin"
                android:paddingStart="@dimen/settings_social_connect_scannable_padding"
                android:paddingEnd="@dimen/settings_social_connect_scannable_padding">
                <ImageView
                    android:id="@+id/social_connect_scannable"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"/>
                <ProgressBar
                    android:layout_gravity="center"
                    android:id="@+id/social_connect_progress"
                    android:visibility="gone"
                    style="@style/LoadingIndicator"/>
            </FrameLayout>
            <Button
                android:layout_gravity="center_horizontal"
                android:id="@+id/social_connect_button_leave"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/settings_social_connect_button_leave_top_margin"
                android:layout_marginBottom="@dimen/settings_social_connect_button_leave_bottom_margin"
                android:text="@string/social_connect_button_leave"
                android:filterTouchesWhenObscured="true"
                style="@style/WhiteBorderButtonStyle"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="?attr/selectableItemBackground"
                android:layout_width="match_parent"
                android:layout_height="@dimen/settings_item_height">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/music_streaming_quality"
                    android:layout_weight="1"
                    style="@style/SettingsTitle"/>
                <Spinner
                    android:gravity="end"
                    android:id="@+id/music_quality_spinner"
                    android:layout_width="@dimen/settings_dropdown_width"
                    android:layout_height="wrap_content"
                    android:popupBackground="@color/spinner_background"
                    android:dropDownWidth="@dimen/settings_dropdown_width"
                    android:backgroundTint="@color/spinner_foreground"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/third_party_licenses_button"
                android:background="?attr/selectableItemBackground"
                android:layout_width="match_parent"
                android:layout_height="@dimen/settings_item_height">
                <TextView
                    android:id="@+id/third_party_licenses_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/third_party_licenses"
                    android:layout_weight="1"
                    style="@style/SettingsTitle"/>
                <ImageView
                    android:layout_width="@dimen/settings_chevron_size"
                    android:layout_height="@dimen/settings_chevron_size"
                    android:src="@drawable/chevron_right"
                    app:tint="@color/activity_text_primary"/>
            </LinearLayout>
            <Button
                android:layout_gravity="center_horizontal"
                android:id="@+id/logout_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/settings_logout_button_margin"
                android:text="@string/logout"
                android:filterTouchesWhenObscured="true"
                style="@style/WhiteButtonStyle"/>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
