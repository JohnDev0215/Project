<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="@dimen/activity_min_height">
    <include layout="@layout/layout_login_bottom"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include layout="@layout/layout_login_top"/>
            <LinearLayout
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/login_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/login_password_top_margin"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/logo">
                <TextView
                    android:textSize="@dimen/login_text_size_primary"
                    android:textStyle="bold"
                    android:textColor="@color/activity_text_primary"
                    android:gravity="start"
                    android:layout_width="@dimen/login_password_field_width"
                    android:layout_height="wrap_content"
                    android:text="@string/login_username_hint"
                    android:labelFor="@+id/login_username"/>
                <EditText
                    android:textSize="@dimen/login_text_size_primary"
                    android:textColor="@color/edit_text_foreground"
                    android:id="@+id/login_username"
                    android:background="@drawable/edit_text_background_selector"
                    android:layout_width="@dimen/login_password_field_width"
                    android:layout_height="@dimen/login_password_field_height"
                    android:layout_marginTop="@dimen/login_password_header_spacing"
                    android:inputType="textEmailAddress"
                    android:filterTouchesWhenObscured="true"
                    android:textAlignment="viewStart"
                    android:autofillHints="username"
                    android:importantForAutofill="yes"/>
                <TextView
                    android:textSize="@dimen/login_text_size_primary"
                    android:textStyle="bold"
                    android:textColor="@color/activity_text_primary"
                    android:gravity="start"
                    android:layout_width="@dimen/login_password_field_width"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/login_password_field_spacing"
                    android:text="@string/login_password_hint"
                    android:labelFor="@+id/login_password"/>
                <EditText
                    android:textSize="@dimen/login_text_size_primary"
                    android:textColor="@color/edit_text_foreground"
                    android:id="@+id/login_password"
                    android:background="@drawable/edit_text_background_selector"
                    android:layout_width="@dimen/login_password_field_width"
                    android:layout_height="@dimen/login_password_field_height"
                    android:layout_marginTop="@dimen/login_password_header_spacing"
                    android:inputType="textPassword"
                    android:imeOptions="actionDone"
                    android:filterTouchesWhenObscured="true"
                    android:textAlignment="viewStart"
                    android:autofillHints="password"
                    android:importantForAutofill="yes"/>
                <Button
                    android:textSize="@dimen/button_text_size"
                    android:id="@+id/login_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/login_password_button_vertical_margin"
                    android:text="@string/login_login_button"
                    android:filterTouchesWhenObscured="true"
                    style="@style/GreenButtonStyle"/>
                <TextView
                    android:textSize="@dimen/login_text_size_secondary"
                    android:textColor="@color/activity_text_primary"
                    android:id="@+id/login_error_text"
                    android:visibility="gone"
                    android:layout_width="@dimen/login_password_field_width"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/login_password_button_vertical_margin"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <ProgressBar
        android:id="@+id/progressbar"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/LoadingIndicator"/>
</androidx.constraintlayout.widget.ConstraintLayout>
