    <string name="login_error_travel_restriction">আপনার ট্রিপ উপভোগ করছেন? আপনি বিদেশে মাত্র 14 দিনের জন্য Spotify ব্যবহার করতে পারেন।</string>
    <string name="login_error_unknown">অজানা সমস্যা।</string>
    <string name="login_help_password_text">আপনি সাইন আপ করতে ব্যবহার করে থাকতে পারেন এমন অন্য কোনও ইমেল আইডি (বা ব্যবহারকারীর নাম) লিখে দেখুন।\n\nআপনার অ্যাকাউন্টটি Facebook-এর সাথে লিংক করা থাকতে পারে। যদি তাই হয়, তাহলে আপনার Facebook-এর ব্যবহারকারীর নাম এবং Facebook-এর পাসওয়ার্ড দিয়ে আবার চেষ্টা করুন।\n\nএতেও কোনও লাভ হয়নি? আপনার পাসওয়ার্ডটি রিসেট করুন- spotify.com/password-reset</string>
    <string name="login_help_password_title">সাইন ইন করার সময় সমস্যা হচ্ছে?</string>
    <string name="login_help_pin_text">আপনার ফোন এবং গাড়ি দুটোরই নেটওয়ার্ক কানেকশন দেখে নিয়ে আবার চেষ্টা করুন।\n\nআপনি আপনার মোবাইল ডিভাইসে সঠিকভাবে URL: spotify.com/pair লিখেছেন কিনা তা দেখুন।\n\nআপনার গাড়ির Spotify অ্যাপটি বন্ধ করে আবার চেষ্টা করুন। আপনার ফোনে কোডটি আবার লিখুন এবং আবার চেষ্টা করুন।</string>
    <string name="login_help_pin_title">পিন দিয়ে লগ ইন করতে সমস্যা হচ্ছে?</string>
    <string name="login_help_scannable_text">যদি QR কোডটি সঠিকভাবে স্ক্যান করা না যায়, তাহলে এর পরিবর্তে পিন কোড দিয়ে লগ ইন করার চেষ্টা করুন।\n\nআপনার ফোনে যদি কোনও বিল্ট-ইন QR কোড স্ক্যানার না থাকে, তাহলে আপনি অ্যাপ স্টোরেও এটি খুঁজে পেতে পারেন।</string>
