<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android" android:interpolator="@android:anim/accelerate_interpolator">
    <alpha
        android:duration="233"
        android:fromAlpha="0"
        android:toAlpha="1"/>
    <scale
        android:duration="133"
        android:pivotX="50%"
        android:pivotY="50%"
        android:fromXScale="@dimen/dialog_anim_enter_scale_small"
        android:toXScale="@dimen/dialog_anim_enter_scale_big"
        android:fromYScale="@dimen/dialog_anim_enter_scale_small"
        android:toYScale="@dimen/dialog_anim_enter_scale_big"/>
    <scale
        android:duration="100"
        android:pivotX="50%"
        android:pivotY="50%"
        android:fromXScale="@dimen/dialog_anim_enter_scale_big"
        android:toXScale="1"
        android:fromYScale="@dimen/dialog_anim_enter_scale_small"
        android:toYScale="1"
        android:delay="133"/>
</set>
