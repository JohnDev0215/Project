<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android" android:interpolator="@android:anim/accelerate_interpolator">
    <alpha
        android:duration="75"
        android:fromAlpha="1"
        android:toAlpha="0"
        android:delay="25"/>
    <scale
        android:duration="50"
        android:pivotX="50%"
        android:pivotY="50%"
        android:fromXScale="1"
        android:toXScale="@dimen/dialog_anim_exit_scale_small"
        android:fromYScale="1"
        android:toYScale="@dimen/dialog_anim_exit_scale_small"
        android:delay="25"/>
</set>
