<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="@dimen/dp_328"
    android:layout_height="@dimen/dp_143">
    <ImageView
        android:id="@+id/all_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@mipmap/denza_img_land_navi_bg"
        android:scaleType="fitXY"/>
    <ImageView
        android:id="@+id/im_location"
        android:layout_width="@dimen/dp_149"
        android:layout_height="@dimen/dp_149"
        android:src="@mipmap/denza_img_dark_land_navi"
        android:layout_centerVertical="true"
        android:layout_marginStart="-2dp"
        android:layout_alignParentStart="true"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/home"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_24"
        android:layout_marginStart="@dimen/dp_13"
        android:layout_toEndOf="@+id/im_location">
        <ImageView
            android:id="@+id/img_home"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:src="@mipmap/denza_icon_dark_card_home"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/app_map_title_text"
            android:id="@+id/text_home"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_1"
            android:text="@string/home"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/company"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/home"
        android:layout_marginStart="@dimen/dp_34"
        android:layout_toEndOf="@+id/home">
        <ImageView
            android:id="@+id/img_company"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:src="@mipmap/denza_icon_dark_card_work"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/app_map_title_text"
            android:id="@+id/text_company"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_1"
            android:text="@string/work"/>
    </LinearLayout>
</RelativeLayout>
