<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/launcher_dialog_appinfo_bg"
    android:layout_width="@dimen/dp_560"
    android:layout_height="@dimen/dp_312">
    <ImageView
        android:id="@+id/uninstall_app_icon"
        android:background="@mipmap/ic_launcher"
        android:layout_width="@dimen/dp_72"
        android:layout_height="@dimen/dp_72"
        android:layout_marginTop="@dimen/dp_48"
        android:layout_marginStart="@dimen/dp_244"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="@color/launcher_add_app_title"
        android:gravity="center"
        android:id="@+id/uninstall_content"
        android:layout_width="@dimen/dp_464"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_152"
        android:text="@string/uninstall_tip"
        android:layout_marginStart="@dimen/dp_48"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="@color/launcher_cancel"
        android:gravity="center"
        android:id="@+id/uninstall_ok"
        android:background="@drawable/add_app_sure_btn_bg"
        android:layout_width="@dimen/dp_160"
        android:layout_height="@dimen/dp_48"
        android:layout_marginBottom="@dimen/dp_28"
        android:text="@string/uninstall"
        android:layout_marginStart="@dimen/dp_88"
        android:elevation="@dimen/dp_2"
        android:stateListAnimator="@drawable/anim_btn_scale_alpha"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="@color/launcher_cancel"
        android:gravity="center"
        android:id="@+id/uninstall_cancel"
        android:background="@drawable/launcher_clear_data_dialog_cancel_bg"
        android:layout_width="@dimen/dp_160"
        android:layout_height="@dimen/dp_48"
        android:layout_marginBottom="@dimen/dp_28"
        android:text="@string/cancel"
        android:layout_marginEnd="@dimen/dp_88"
        android:elevation="@dimen/dp_2"
        android:stateListAnimator="@drawable/anim_btn_scale_alpha"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
