<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rl_recyclerview_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/img_drawer_mask"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <ImageView
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@color/qs_content_overlay"
        android:scaleType="centerCrop"/>
    <include
        android:id="@+id/rl_title"
        layout="@layout/include_back_title"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/sysui_qs_panel_content_bg"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:layout_marginBottom="@dimen/dp_36"
        android:layout_below="@+id/rl_title"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_16">
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/color_scene_introduce"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_24"
            android:text="@string/scene_introduce"
            android:layout_marginStart="@dimen/panel_scene_introduce_recycle_margin"
            android:layout_marginEnd="@dimen/dp_24"/>
        <com.android.systemui.widget.SysUiRecyclerView
            android:scrollbarStyle="insideOverlay"
            android:id="@+id/rv_introduce"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_18"
            android:layout_marginStart="@dimen/panel_scene_introduce_recycle_margin"
            android:layout_marginEnd="@dimen/panel_scene_introduce_recycle_margin"/>
    </LinearLayout>
</RelativeLayout>
