<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rl_recyclerview_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/sp_24"
        android:textColor="@color/color_title"
        android:gravity="center"
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_32"
        android:layout_marginTop="@dimen/dp_98"
        android:text="@string/split_screen_start_split_screen"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/color_sub_title"
        android:gravity="center"
        android:id="@+id/tvSubTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_24"
        android:text="@string/split_screen_sub_start_split_screen"
        android:layout_below="@+id/tvTitle"
        android:paddingStart="@dimen/dp_48"
        android:paddingEnd="@dimen/dp_48"/>
    <RelativeLayout
        android:layout_gravity="center"
        android:id="@+id/videoViewContainer"
        android:background="@drawable/shape_split_screen_video_bg"
        android:layout_width="@dimen/dp_455"
        android:layout_height="@dimen/dp_805"
        android:layout_marginTop="@dimen/dp_28"
        android:layout_below="@+id/tvSubTitle"
        android:layout_centerHorizontal="true">
        <VideoView
            android:id="@+id/video_view"
            android:background="@drawable/shape_split_screen_video_bg"
            android:layout_width="@dimen/dp_455"
            android:layout_height="@dimen/dp_805"/>
        <com.android.systemui.stackdivider.view.help.RoundImageView
            android:id="@+id/ivFirstFrame"
            android:layout_width="@dimen/dp_455"
            android:layout_height="@dimen/dp_805"
            android:scaleType="fitXY"
            android:layout_centerInParent="true"/>
        <com.android.systemui.stackdivider.view.help.RoundImageView
            android:background="@drawable/shape_split_screen_video_bg"
            android:layout_width="@dimen/dp_455"
            android:layout_height="@dimen/dp_805"
            android:scaleType="centerCrop"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
</RelativeLayout>
