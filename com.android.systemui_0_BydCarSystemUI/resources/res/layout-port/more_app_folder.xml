<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/edit_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_280">
        <EditText
            android:textSize="@dimen/sp_26"
            android:textColor="@color/launcher_app_name_text"
            android:id="@+id/folder_name"
            android:background="@null"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:hint=" "
            android:singleLine="true"
            android:maxLength="@integer/folder_name"
            android:layout_centerInParent="true"
            android:inputType="textCapWords"
            android:imeOptions="actionDone"
            android:textCursorDrawable="@drawable/color_cursor"
            android:paddingStart="@dimen/dp_48"
            android:paddingEnd="@dimen/dp_48"/>
        <ImageView
            android:id="@+id/clear_folder_name"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="@dimen/dp_48"
            android:layout_height="match_parent"
            android:src="@mipmap/launcher_folder_name_clear"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/folder_springboard"
        android:background="@drawable/launcher_folder_app_bg"
        android:layout_width="@dimen/dp_456"
        android:layout_height="@dimen/dp_456"
        android:layout_marginTop="@dimen/dp_24">
        <com.byd.card.drag.PageScrollView
            android:id="@+id/folder_pageView"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/folder_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </com.byd.card.drag.PageScrollView>
        <com.byd.card.drag.DotView
            android:id="@+id/dotView"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_20"
            android:layout_alignParentBottom="true"/>
        <RelativeLayout
            android:id="@+id/touchController"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </RelativeLayout>
</LinearLayout>
