<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <com.android.systemui.widget.StatusBydLinearLayout
        android:gravity="center"
        android:id="@+id/ll_voice"
        android:background="@drawable/shape_status_bar_icon_voice"
        style="@style/status_bar_button">
        <com.android.systemui.widget.VoiceImg
            android:id="@+id/sysui_status_bar_img_voice"
            android:layout_centerInParent="true"
            style="@style/status_bar_voice"/>
        <ImageView
            android:id="@+id/sysui_status_bar_img_voice_static"
            android:visibility="gone"
            android:src="@mipmap/img_voice_denza"
            android:layout_centerInParent="true"
            style="@style/status_bar_voice"/>
    </com.android.systemui.widget.StatusBydLinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_time"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@+id/ll_voice"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/dp_3">
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/color_status_time"
            android:id="@+id/sysui_status_bar_time_left"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_marginEnd="@dimen/dp_4"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/color_status_time"
            android:id="@+id/sysui_status_bar_time"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/color_status_time"
            android:id="@+id/sysui_status_bar_time_right"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_marginStart="@dimen/dp_4"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/ll_slw"
        android:visibility="gone"
        android:layout_toRightOf="@+id/ll_bt"
        android:layout_marginStart="@dimen/dp_3"
        style="@style/status_bar_button_44">
        <ImageView
            android:id="@+id/img_slw"
            android:src="@mipmap/icon_status_bar_tsr_slw_close"
            style="@style/status_bar_button_44"/>
        <com.android.systemui.widget.StatusBydImageView
            android:id="@+id/img_slw_btn"
            android:src="@drawable/shape_status_bar_icon"
            style="@style/status_bar_button_44_click"/>
    </FrameLayout>
    <com.android.systemui.widget.StatusBydLinearLayout
        android:gravity="center"
        android:id="@+id/ll_media"
        android:background="@drawable/shape_status_bar_icon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_32"
        android:adjustViewBounds="true"
        android:layout_centerVertical="true"
        android:paddingEnd="@dimen/dp_3">
        <ImageView
            android:id="@+id/sysui_status_bar_img_media_def"
            android:visibility="visible"
            android:clickable="false"
            android:src="@mipmap/icon_media_music"
            style="@style/status_bar_button_32"/>
        <com.android.systemui.widget.MediaPlayingImg
            android:layout_gravity="center_vertical"
            android:id="@+id/sysui_status_bar_img_media_playing"
            android:visibility="gone"
            android:clickable="false"
            style="@style/status_bar_button_32"/>
        <com.android.systemui.widget.MarqueeTextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/color_status_media_name"
            android:id="@+id/sysui_status_bar_media_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/dp_55"
            android:singleLine="true"
            android:layout_toRightOf="@+id/sysui_status_bar_img_media_playing"
            android:layout_centerVertical="true"/>
    </com.android.systemui.widget.StatusBydLinearLayout>
    <FrameLayout
        android:id="@+id/ll_wifi"
        android:layout_toRightOf="@+id/ll_signal"
        android:layout_marginStart="@dimen/dp_3"
        style="@style/status_bar_button_44">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/sysui_icon_wifi_data"
            android:visibility="gone"
            android:clickable="false"
            android:src="@mipmap/icon_status_bar_wifi_signal_data"
            style="@style/status_bar_button_44"/>
        <ImageView
            android:id="@+id/sysui_icon_wifi_signal"
            android:clickable="false"
            android:src="@mipmap/icon_status_bar_wifi_0"
            style="@style/status_bar_button_44"/>
        <com.android.systemui.widget.StatusBydImageView
            android:id="@+id/img_wifi_btn"
            android:src="@drawable/shape_status_bar_icon"
            style="@style/status_bar_button_44_click"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/ll_bt"
        android:layout_toRightOf="@+id/ll_hotspot"
        android:layout_marginStart="@dimen/dp_3"
        style="@style/status_bar_button_44">
        <ImageView
            android:id="@+id/sysui_icon_bt"
            android:src="@mipmap/icon_status_bar_bt_close"
            style="@style/status_bar_button_44"/>
        <com.android.systemui.widget.StatusBydImageView
            android:id="@+id/img_bt_btn"
            android:src="@drawable/shape_status_bar_icon"
            style="@style/status_bar_button_44_click"/>
    </FrameLayout>
    <ImageView
        android:id="@+id/sysui_icon_mute"
        android:padding="@dimen/dp_10"
        android:visibility="gone"
        android:src="@mipmap/icon_status_bar_mute"
        android:layout_marginStart="@dimen/dp_3"
        style="@style/status_bar_button_44"/>
    <RelativeLayout
        android:id="@+id/ll_carplay"
        android:visibility="gone"
        android:layout_toRightOf="@+id/ll_bt"
        android:layout_marginStart="@dimen/dp_3"
        style="@style/status_bar_button_44">
        <ImageView
            android:id="@+id/sysui_icon_carplay"
            android:layout_width="@dimen/dp_24"
            android:layout_height="@dimen/dp_24"
            android:src="@mipmap/icon_status_bar_carplay"
            android:layout_centerInParent="true"
            style="@style/status_bar_button_44"/>
        <com.android.systemui.widget.StatusBydImageView
            android:id="@+id/img_carplay_btn"
            android:src="@drawable/shape_status_bar_icon"
            style="@style/status_bar_button_44_click"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/ll_android_auto"
        android:visibility="gone"
        android:layout_toRightOf="@+id/ll_carplay"
        android:layout_marginStart="@dimen/dp_3"
        style="@style/status_bar_button_44">
        <ImageView
            android:id="@+id/sysui_icon_android_auto"
            android:layout_width="@dimen/dp_24"
            android:layout_height="@dimen/dp_24"
            android:src="@mipmap/icon_status_bar_android_auto"
            android:layout_centerInParent="true"
            style="@style/status_bar_button_44"/>
        <com.android.systemui.widget.StatusBydImageView
            android:id="@+id/img_android_auto_btn"
            android:src="@drawable/shape_status_bar_icon"
            style="@style/status_bar_button_44_click"/>
    </RelativeLayout>
</merge>
