<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:layout_width="@dimen/dp_672"
    android:layout_height="@dimen/dp_1128">
    <com.byd.card.widget.BlurView
        android:id="@+id/root_blur"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/close"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        android:layout_marginLeft="@dimen/dp_24"
        android:layout_marginTop="@dimen/dp_16"
        android:src="@mipmap/icon_public_close"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <RelativeLayout
        android:id="@+id/rl_launcher"
        android:layout_width="@dimen/dp_512"
        android:layout_height="@dimen/dp_302"
        android:layout_marginTop="@dimen/dp_146"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/wallpaper_select"
            android:background="@drawable/selector_launcher_selected_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:id="@+id/wallpaper"
            android:background="@mipmap/img_wallpaper_mode"
            android:layout_width="@dimen/dp_496"
            android:layout_height="@dimen/dp_286"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_map"
        android:layout_width="@dimen/dp_512"
        android:layout_height="@dimen/dp_302"
        android:layout_marginTop="@dimen/dp_588"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/map_select"
            android:background="@drawable/selector_launcher_selected_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:id="@+id/map"
            android:background="@mipmap/img_map_mode"
            android:layout_width="@dimen/dp_496"
            android:layout_height="@dimen/dp_286"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="@color/selector_color_launcher_mode_name"
        android:id="@+id/wallpaper_launcher"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_456"
        android:text="@string/wallpaper_launcher"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="@color/selector_color_launcher_mode_name"
        android:id="@+id/map_launcher"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_902"
        android:text="@string/map_launcher"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.android.systemui.widget.ToneGeneratorButton
        android:id="@+id/ok"
        android:layout_marginLeft="@dimen/dp_136"
        android:layout_marginBottom="@dimen/dp_28"
        android:text="@string/confirm"
        android:stateListAnimator="@drawable/anim_btn_scale"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        style="@style/dialog_btn_ok_dilink_bt"/>
    <com.android.systemui.widget.ToneGeneratorButton
        android:id="@+id/cancel"
        android:layout_marginRight="@dimen/dp_136"
        android:layout_marginBottom="@dimen/dp_28"
        android:text="@string/cancel"
        android:stateListAnimator="@drawable/anim_btn_scale"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        style="@style/dialog_btn_cancel_dilink_bt"/>
</androidx.constraintlayout.widget.ConstraintLayout>
