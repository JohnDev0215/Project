<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/vertical"
    android:background="@mipmap/img_navi_bar_bg"
    android:paddingTop="@dimen/nav_content_padding"
    android:paddingBottom="@dimen/nav_content_padding"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/rounded_corner_content_padding"
    android:layout_marginBottom="@dimen/rounded_corner_content_padding">
    <ImageView
        android:id="@+id/img_blur_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.3"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_left"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/dp_12"
        android:layout_alignParentStart="true">
        <com.android.systemui.widget.BackButtonView
            android:id="@+id/img_sysui_back"
            style="@style/navigation_bar_button_common"/>
        <com.android.systemui.widget.HomeButtonView
            android:id="@+id/img_sysui_home"
            style="@style/navigation_bar_button_left"/>
        <RelativeLayout style="@style/navigation_bar_button_left">
            <com.android.systemui.widget.CarButtonView
                android:id="@+id/img_sysui_car"
                style="@style/navigation_bar_button_common"/>
            <ImageView
                android:id="@+id/img_ota_update"
                android:visibility="gone"
                android:clickable="false"
                android:layout_width="@dimen/dp_8"
                android:layout_height="@dimen/dp_8"
                android:layout_marginTop="@dimen/dp_12"
                android:src="@drawable/bg_dot_update"
                android:layout_marginStart="@dimen/dp_40"/>
        </RelativeLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_center"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toLeftOf="@+id/ll_right"
        android:layout_toRightOf="@+id/ll_left"
        android:layout_centerVertical="true">
        <ImageView
            android:id="@+id/img_sysui_air_switch"
            android:background="@drawable/navi_bar_bitmap_ac"
            android:visibility="gone"
            android:layout_marginRight="@dimen/dp_45"
            style="@style/navigation_bar_button"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_temp_left"
            android:layout_width="@dimen/dp_96"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/dp_15">
            <ImageView
                android:id="@+id/iv_navigation_bar_set_temp_left_dec"
                android:visibility="gone"
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_32"
                android:src="@mipmap/icon_dock_ac_arrow_left"/>
            <RelativeLayout
                android:id="@+id/rlLeftTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:gravity="center"
                    android:id="@+id/rl_auto_hvac_temp_left"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <TextView
                        android:textSize="@dimen/sp_30"
                        android:textColor="@color/color_dock_hvac_temp_text"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/tv_temp_left"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp_40"
                        android:text="25"
                        android:maxLines="1"
                        android:lines="1"/>
                    <com.android.systemui.widget.BydImageView
                        android:id="@+id/iv_left_unit"
                        android:layout_width="@dimen/dp_16"
                        android:layout_height="@dimen/dp_40"
                        android:layout_toRightOf="@+id/tv_temp_left"
                        android:layout_alignTop="@+id/tv_temp_left"
                        android:layout_alignBottom="@+id/tv_temp_left"
                        app:clickChangeColor="false"/>
                </RelativeLayout>
                <SeekBar
                    android:id="@+id/eaac_temp_seek_bar"
                    android:background="@null"
                    android:visibility="gone"
                    android:layout_width="@dimen/dp_66"
                    android:layout_height="wrap_content"
                    android:max="33"
                    android:progress="25"
                    android:progressDrawable="@drawable/navi_bar_eaac_temp_on_seekbar_background"
                    android:thumb="@mipmap/img_dock_ecc_off_needle"
                    android:thumbOffset="0dp"
                    android:paddingStart="@dimen/dp_0"
                    android:paddingEnd="@dimen/dp_0"
                    android:min="17"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/ll_hvac_disable_left"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <com.android.systemui.widget.BydImageView
                        android:background="@color/color_navi_temp_set_text_nor"
                        android:layout_width="@dimen/dp_10"
                        android:layout_height="@dimen/dp_2"/>
                    <com.android.systemui.widget.BydImageView
                        android:background="@color/color_navi_temp_set_text_nor"
                        android:layout_width="@dimen/dp_10"
                        android:layout_height="@dimen/dp_2"
                        android:layout_marginLeft="@dimen/dp_8"/>
                </LinearLayout>
            </RelativeLayout>
            <ImageView
                android:id="@+id/iv_navigation_bar_set_temp_left_inc"
                android:visibility="gone"
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_32"
                android:src="@mipmap/icon_dock_ac_arrow_right"/>
        </LinearLayout>
        <RelativeLayout
            android:gravity="center"
            android:id="@+id/ll_air_center"
            android:layout_width="@dimen/dp_60"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/dp_8">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.android.systemui.widget.BydImageView
                    android:id="@+id/img_sysui_air_people_arrow_rw"
                    android:layout_width="@dimen/dp_30"
                    android:layout_height="@dimen/dp_30"
                    android:layout_marginLeft="@dimen/dp_23"
                    android:src="@mipmap/icon_dock_ac_people_arrow_rw"
                    app:clickChangeColor="false"/>
                <com.android.systemui.widget.BydImageView
                    android:id="@+id/img_sysui_air_defrost"
                    android:layout_width="@dimen/dp_24"
                    android:layout_height="@dimen/dp_8"
                    android:layout_marginLeft="@dimen/dp_15"
                    android:layout_marginTop="@dimen/dp_3"
                    android:src="@mipmap/icon_dock_ac_people_arrow_defrost"
                    app:clickChangeColor="false"/>
                <com.android.systemui.widget.BydImageView
                    android:id="@+id/img_sysui_air_wind_face"
                    android:layout_width="@dimen/dp_23"
                    android:layout_height="@dimen/dp_6"
                    android:layout_marginLeft="@dimen/dp_12"
                    android:src="@mipmap/icon_dock_ac_people_arrow_face"
                    android:layout_below="@+id/img_sysui_air_defrost"
                    app:clickChangeColor="false"/>
                <com.android.systemui.widget.BydImageView
                    android:id="@+id/img_sysui_air_wind_foot"
                    android:layout_width="@dimen/dp_18"
                    android:layout_height="@dimen/dp_8"
                    android:layout_marginLeft="@dimen/dp_9"
                    android:src="@mipmap/icon_dock_ac_people_arrow_foot"
                    android:layout_below="@+id/img_sysui_air_wind_face"
                    app:clickChangeColor="false"/>
                <com.android.systemui.widget.BydImageView
                    android:id="@+id/img_sysui_air_panel"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_7"
                    android:layout_marginTop="@dimen/dp_2"
                    android:src="@mipmap/icon_dock_air_volume_gear_bg"
                    android:layout_below="@+id/img_sysui_air_people_arrow_rw"
                    app:clickChangeColor="false"/>
                <com.android.systemui.widget.BydImageView
                    android:id="@+id/img_sysui_air_wind_level"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_7"
                    android:layout_marginTop="@dimen/dp_2"
                    android:layout_below="@+id/img_sysui_air_people_arrow_rw"
                    app:clickChangeColor="false"/>
            </RelativeLayout>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_temp_right"
            android:layout_width="@dimen/dp_96"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/dp_8">
            <ImageView
                android:id="@+id/iv_navigation_bar_set_temp_right_dec"
                android:visibility="gone"
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_32"
                android:src="@mipmap/icon_dock_ac_arrow_left"/>
            <RelativeLayout
                android:id="@+id/rlRightTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:gravity="center"
                    android:id="@+id/rl_double_zone_right"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <TextView
                        android:textSize="@dimen/sp_30"
                        android:textColor="@color/color_dock_hvac_temp_text"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/tv_temp_right"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp_40"
                        android:text="25"
                        android:maxLines="1"
                        android:lines="1"/>
                    <com.android.systemui.widget.BydImageView
                        android:id="@+id/iv_right_unit"
                        android:layout_width="@dimen/dp_16"
                        android:layout_height="@dimen/dp_40"
                        android:layout_toRightOf="@+id/tv_temp_right"
                        android:layout_alignTop="@+id/tv_temp_right"
                        android:layout_alignBottom="@+id/tv_temp_right"
                        app:clickChangeColor="false"/>
                </RelativeLayout>
                <LinearLayout
                    android:gravity="center"
                    android:id="@+id/ll_single_zone_eaac"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/sp_32"
                        android:layout_gravity="center"
                        android:id="@+id/tv_wind_level"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3"
                        android:includeFontPadding="false"/>
                    <com.android.systemui.widget.BydImageView
                        android:id="@+id/iv_wind_level"
                        android:layout_width="@dimen/dp_16"
                        android:layout_height="@dimen/dp_16"
                        android:src="@mipmap/icon_light_dock_ac_fan"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/ll_hvac_disable_right"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <com.android.systemui.widget.BydImageView
                        android:background="@color/color_navi_temp_set_text_nor"
                        android:layout_width="@dimen/dp_10"
                        android:layout_height="@dimen/dp_2"/>
                    <com.android.systemui.widget.BydImageView
                        android:background="@color/color_navi_temp_set_text_nor"
                        android:layout_width="@dimen/dp_10"
                        android:layout_height="@dimen/dp_2"
                        android:layout_marginLeft="@dimen/dp_8"/>
                </LinearLayout>
            </RelativeLayout>
            <ImageView
                android:id="@+id/iv_navigation_bar_set_temp_right_inc"
                android:visibility="gone"
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_32"
                android:src="@mipmap/icon_dock_ac_arrow_right"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/img_sysui_custom"
            android:background="@drawable/navi_bar_bitmap_custom_defrost"
            android:visibility="gone"
            android:layout_marginLeft="@dimen/dp_45"
            style="@style/navigation_bar_button"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_right"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginEnd="@dimen/dp_12"
        android:layout_alignParentEnd="true">
        <com.android.systemui.widget.AppsButtonView
            android:id="@+id/img_sysui_app"
            style="@style/navigation_bar_button_right"/>
        <com.android.systemui.widget.SplitButtonView
            android:id="@+id/img_sysui_split"
            style="@style/navigation_bar_button_right"/>
        <com.android.systemui.widget.RotateButtonView
            android:id="@+id/img_sysui_orientation"
            style="@style/navigation_bar_button"/>
        <com.android.systemui.widget.ScreenOffButtonView
            android:id="@+id/img_sysui_screen_off"
            android:visibility="gone"
            style="@style/navigation_bar_button"/>
    </LinearLayout>
    <com.android.systemui.widget.OperationModeImg
        android:id="@+id/img_operation_mode"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</RelativeLayout>
