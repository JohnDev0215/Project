<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/rollbench_mode_view"
    android:background="@drawable/rollbench_mode_bg"
    android:layout_width="@dimen/dp_240"
    android:layout_height="@dimen/dp_148">
    <LinearLayout
        android:gravity="start"
        android:orientation="horizontal"
        android:id="@+id/rollbench_view"
        android:layout_width="@dimen/dp_220"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/dialog_carplay_title"
            android:id="@+id/tvRollBench"
            android:layout_width="@dimen/dp_80"
            android:layout_height="wrap_content"
            android:text="@string/str_rollbench_mode"
            android:maxLines="1"/>
        <com.android.systemui.widget.BydSwitch
            android:id="@+id/rollbench_switch"
            android:background="@drawable/switch_track"
            android:layout_width="@dimen/dp_64"
            android:layout_height="@dimen/dp_48"
            android:thumb="@null"
            android:switchMinWidth="@dimen/dp_56"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/color_red_dot"
        android:gravity="start"
        android:id="@+id/tvRollBenchStatus"
        android:layout_width="@dimen/dp_220"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:text="@string/str_rollbench_mode_active"
        android:maxLines="1"/>
</LinearLayout>
