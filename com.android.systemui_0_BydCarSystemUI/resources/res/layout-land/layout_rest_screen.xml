<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_fullscreen_rest"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.byd.profile.view.TimeView
        android:textSize="@dimen/sp_102"
        android:textColor="@color/text_time_rest"
        android:id="@+id/tv_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_165"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_24"
        android:textColor="@color/text_time_rest"
        android:id="@+id/tv_noon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_20"
        android:text="上午"
        android:layout_marginStart="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/tv_time"
        app:layout_constraintStart_toEndOf="@+id/tv_time"/>
    <View
        android:id="@+id/background"
        android:background="@drawable/bg_alarm"
        android:layout_width="@dimen/dp_200"
        android:layout_height="@dimen/dp_48"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_time"/>
    <ImageView
        android:id="@+id/iv_alarm"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        android:src="@drawable/icon_dark_control_alarm_clock_48"
        android:layout_marginStart="@dimen/dp_25"
        app:layout_constraintStart_toStartOf="@+id/background"
        app:layout_constraintTop_toBottomOf="@+id/tv_time"
        app:tint="@color/tint_rest"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/text_option_rest"
        android:id="@+id/tv_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/alarm_closed"
        android:layout_marginStart="@dimen/dp_4"
        app:layout_constraintBottom_toBottomOf="@+id/iv_alarm"
        app:layout_constraintStart_toEndOf="@+id/iv_alarm"
        app:layout_constraintTop_toTopOf="@+id/iv_alarm"/>
    <TextView
        android:textSize="@dimen/sp_24"
        android:textColor="@color/text_main_rest"
        android:id="@+id/tv_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_72"
        android:text="@string/during_nap_mode"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_time"/>
    <androidx.appcompat.widget.AppCompatButton
        android:textSize="@dimen/sp_18"
        android:textColor="@color/selector_text_button"
        android:gravity="center"
        android:id="@+id/btn_exit"
        android:background="@drawable/bg_button_normal"
        android:layout_width="@dimen/dp_160"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_164"
        android:text="@string/exit"
        android:textAllCaps="false"
        android:stateListAnimator="@animator/profile_pressed_state_list"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_time"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <TextView
        android:textSize="@dimen/sp_32"
        android:textColor="@color/text_main_rest"
        android:id="@+id/tv_temp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_105"
        android:layout_marginEnd="@dimen/dp_56"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/guide"/>
    <TextView
        android:textSize="@dimen/sp_24"
        android:textColor="@color/text_main_rest"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_3"
        android:text="@string/unit_temp"
        android:layout_marginStart="@dimen/dp_1"
        app:layout_constraintStart_toEndOf="@+id/tv_temp"
        app:layout_constraintTop_toTopOf="@+id/tv_temp"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/text_main_rest"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_5"
        android:text="@string/unit_temp_c"
        android:layout_marginStart="@dimen/dp_1"
        app:layout_constraintBottom_toBottomOf="@+id/tv_temp"
        app:layout_constraintStart_toEndOf="@+id/tv_temp"/>
    <ImageView
        android:id="@+id/iv_temp_prev"
        android:layout_width="@dimen/dp_24"
        android:layout_height="@dimen/dp_32"
        android:src="@drawable/icon_dock_ac_arrow_left0525"
        android:layout_marginEnd="@dimen/dp_14"
        app:layout_constraintBottom_toBottomOf="@+id/tv_temp"
        app:layout_constraintEnd_toStartOf="@+id/tv_temp"
        app:layout_constraintTop_toTopOf="@+id/tv_temp"
        app:tint="@color/tint_rest"/>
    <ImageView
        android:id="@+id/iv_temp_next"
        android:layout_width="@dimen/dp_24"
        android:layout_height="@dimen/dp_32"
        android:src="@drawable/icon_dock_ac_arrow_right0525"
        android:layout_marginStart="@dimen/dp_14"
        app:layout_constraintBottom_toBottomOf="@+id/tv_temp"
        app:layout_constraintStart_toEndOf="@+id/tv_temp"
        app:layout_constraintTop_toTopOf="@+id/tv_temp"
        app:tint="@color/tint_rest"/>
    <TextView
        android:textSize="@dimen/sp_32"
        android:textColor="@color/text_main_rest"
        android:id="@+id/tv_wind"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_105"
        android:layout_marginStart="@dimen/dp_56"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/guide"/>
    <ImageView
        android:layout_width="@dimen/dp_16"
        android:layout_height="@dimen/dp_16"
        android:src="@drawable/icon_dock_ac_16"
        app:layout_constraintBottom_toBottomOf="@+id/tv_wind"
        app:layout_constraintStart_toEndOf="@+id/tv_wind"
        app:layout_constraintTop_toTopOf="@+id/tv_wind"
        app:tint="@color/tint_rest"/>
    <ImageView
        android:id="@+id/iv_wind_prev"
        android:layout_width="@dimen/dp_24"
        android:layout_height="@dimen/dp_32"
        android:src="@drawable/icon_dock_ac_arrow_left0525"
        android:layout_marginEnd="@dimen/dp_18"
        app:layout_constraintBottom_toBottomOf="@+id/tv_wind"
        app:layout_constraintEnd_toStartOf="@+id/tv_wind"
        app:layout_constraintTop_toTopOf="@+id/tv_wind"
        app:tint="@color/tint_rest"/>
    <ImageView
        android:id="@+id/iv_wind_next"
        android:layout_width="@dimen/dp_24"
        android:layout_height="@dimen/dp_32"
        android:src="@drawable/icon_dock_ac_arrow_right0525"
        android:layout_marginStart="@dimen/dp_28"
        app:layout_constraintBottom_toBottomOf="@+id/tv_wind"
        app:layout_constraintStart_toEndOf="@+id/tv_wind"
        app:layout_constraintTop_toTopOf="@+id/tv_wind"
        app:tint="@color/tint_rest"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="@color/text_tip_rest"
        android:id="@+id/tv_voice_control_air_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_60"
        android:text="@string/air_adjust"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
