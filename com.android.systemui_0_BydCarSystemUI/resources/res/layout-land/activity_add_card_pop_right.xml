<?xml version="1.0" encoding="utf-8"?>
<com.byd.card.widget.BlurView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/add_card_pop_root"
    android:background="@drawable/launcher_more_app_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_71">
        <ImageView
            android:id="@+id/close_edit_activity"
            android:background="@mipmap/launcher_icon_public_close"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:layout_marginTop="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_32"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/launcher_add_app_title"
            android:id="@+id/more_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_app"
            android:layout_centerInParent="true"
            android:textFontWeight="@integer/text_mid"/>
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/launcher_my_app"
            android:id="@+id/add_finish"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_24"
            android:text="@string/finish"
            android:layout_marginStart="@dimen/dp_40"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/add_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_72">
        <androidx.recyclerview.widget.RecyclerView
            android:scrollbarSize="@dimen/dp_4"
            android:scrollbarThumbVertical="@drawable/scroll_thumb"
            android:scrollbarTrackVertical="@color/app_center_scrollbar_track"
            android:scrollbarStyle="outsideOverlay"
            android:orientation="vertical"
            android:id="@+id/add_card_recycle_view"
            android:scrollbars="vertical"
            android:fadingEdgeLength="@dimen/dp_28"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_394"
            android:scrollbarFadeDuration="@integer/scroll_view_duration"
            android:overScrollMode="never"
            android:splitMotionEvents="false"
            android:requiresFadingEdge="vertical"
            android:layoutDirection="locale"
            android:paddingStart="@dimen/dp_54"
            android:paddingEnd="@dimen/dp_41"
            android:layout_marginEnd="@dimen/dp_9"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="8"/>
    </RelativeLayout>
</com.byd.card.widget.BlurView>
