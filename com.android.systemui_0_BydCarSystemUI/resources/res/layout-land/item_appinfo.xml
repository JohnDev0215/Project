<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/item_check"
    android:clickable="true"
    android:layout_width="@dimen/dp_128"
    android:layout_height="@dimen/dp_124"
    android:stateListAnimator="@drawable/anim_btn_scale">
    <RelativeLayout
        android:layout_gravity="center_horizontal"
        android:layout_width="@dimen/dp_72"
        android:layout_height="@dimen/dp_72">
        <ImageView
            android:id="@+id/app_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <CheckBox
            android:id="@+id/check_app"
            android:background="@drawable/app_selector"
            android:visibility="visible"
            android:clickable="false"
            android:layout_width="@dimen/dp_40"
            android:layout_height="@dimen/dp_40"
            android:button="@null"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/app_center_tv"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:layout_gravity="center"
        android:id="@+id/app_name"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_44"
        android:layout_marginTop="@dimen/dp_6"
        android:text="testtestetestest"
        android:lines="@integer/more_app_recent_tv"
        android:maxEms="@integer/more_app_recent_tv"/>
</LinearLayout>
