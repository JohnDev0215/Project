<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:background="@drawable/blur_shadow_bg"
    android:layout_width="@dimen/dp_1232"
    android:layout_height="@dimen/dp_570"
    android:elevation="@dimen/dp_10">
    <com.byd.card.widget.BlurView
        android:layout_gravity="center"
        android:id="@+id/id_ConstraintLayout"
        android:background="@drawable/launcher_more_app_bg"
        android:layout_width="@dimen/dp_1232"
        android:layout_height="@dimen/dp_570">
        <ImageView
            android:id="@+id/more_close"
            android:background="@mipmap/launcher_icon_public_close"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:layout_marginTop="@dimen/dp_16"
            android:layout_marginStart="@dimen/dp_24"/>
        <ImageView
            android:id="@+id/more_back"
            android:background="@mipmap/launcher_icon_public_leftarrow"
            android:visibility="gone"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:layout_marginTop="@dimen/dp_16"
            android:layout_marginStart="@dimen/dp_32"/>
        <RelativeLayout
            android:id="@+id/search_bg"
            android:background="@drawable/more_app_search_bg"
            android:layout_width="@dimen/dp_264"
            android:layout_height="@dimen/dp_48"
            android:layout_marginTop="@dimen/dp_58"
            android:layout_marginStart="@dimen/dp_80">
            <ImageView
                android:id="@+id/search"
                android:background="@mipmap/launcher_icon_public_search"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:layout_marginStart="@dimen/dp_8"/>
            <EditText
                android:textSize="@dimen/sp_18"
                android:textColor="@color/launcher_search_edit_txt"
                android:textColorHint="@color/launcher_search_hint_txt"
                android:ellipsize="end"
                android:id="@+id/more_search_edit"
                android:background="@null"
                android:layout_width="@dimen/dp_216"
                android:layout_height="match_parent"
                android:hint="@string/search"
                android:singleLine="true"
                android:inputType="textCapWords"
                android:imeOptions="actionDone"
                android:textCursorDrawable="@drawable/app_search_edit_cursor_color"
                android:layout_toEndOf="@+id/search"/>
            <ImageView
                android:id="@+id/clear"
                android:background="@mipmap/launcher_icon_public_clear"
                android:visibility="gone"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:layout_marginEnd="@dimen/dp_8"
                android:layout_alignParentEnd="true"/>
            <ImageView
                android:id="@+id/voice_divider"
                android:background="@color/divider_voice_color"
                android:visibility="gone"
                android:layout_width="@dimen/dp_1"
                android:layout_height="@dimen/dp_22"
                android:layout_marginTop="@dimen/dp_13"
                android:layout_toStartOf="@+id/voice"/>
            <ImageView
                android:id="@+id/voice"
                android:background="@mipmap/icon_public_voice"
                android:visibility="gone"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:layout_marginEnd="@dimen/dp_8"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/launcher_my_app"
            android:id="@+id/recent_use"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_131"
            android:text="@string/last_use"
            android:layout_marginStart="@dimen/dp_80"
            android:textFontWeight="500"/>
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/launcher_my_app"
            android:id="@+id/search_history"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_131"
            android:text="@string/search_history"
            android:layout_marginStart="@dimen/dp_80"
            android:textFontWeight="500"/>
        <ImageView
            android:id="@+id/delete_history_all"
            android:background="@mipmap/launcher_icon_control_delete"
            android:visibility="gone"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:layout_marginTop="@dimen/dp_125"
            android:layout_marginEnd="@dimen/dp_861"
            android:layout_alignParentEnd="true"/>
        <RelativeLayout
            android:layout_width="@dimen/dp_420"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_290">
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/launcher_my_app"
                android:gravity="center"
                android:id="@+id/no_recent_use"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_recent_use_app"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <com.byd.card.widget.DampingScrollView
            android:id="@+id/recent_scroll"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_600"
            android:layout_marginTop="@dimen/dp_166"
            android:overScrollMode="never"
            android:layout_marginStart="@dimen/dp_80">
            <androidx.recyclerview.widget.RecyclerView
                android:orientation="vertical"
                android:id="@+id/recent_recycler"
                android:scrollbars="none"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:overScrollMode="never"
                android:layoutDirection="locale"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="@integer/recent_app_row_count_land"/>
        </com.byd.card.widget.DampingScrollView>
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="horizontal"
            android:id="@+id/history_recycler"
            android:visibility="gone"
            android:layout_width="@dimen/dp_264"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_176"
            android:layout_marginStart="@dimen/dp_80"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/launcher_my_app"
            android:gravity="center"
            android:id="@+id/no_history"
            android:visibility="gone"
            android:layout_width="@dimen/dp_420"
            android:layout_height="wrap_content"
            android:text="@string/not_search_history"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/launcher_add_app_title"
            android:gravity="center"
            android:id="@+id/no_search_result"
            android:background="@drawable/all_app_search_result_bg"
            android:visibility="gone"
            android:layout_width="@dimen/dp_264"
            android:layout_height="@dimen/dp_50"
            android:layout_marginTop="@dimen/dp_114"
            android:text="@string/not_search_result"
            android:layout_marginStart="@dimen/dp_80"/>
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/launcher_my_app"
            android:id="@+id/my_app"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_58"
            android:text="@string/my_app"
            android:layout_marginStart="@dimen/dp_470"
            android:textFontWeight="500"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/app_market_btn"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_58"
            android:layout_marginEnd="@dimen/dp_68"
            android:layout_alignParentEnd="true">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/launcher_app_market"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_market"
                android:textFontWeight="500"/>
            <ImageView
                android:layout_gravity="center"
                android:background="@mipmap/launcher_icon_public_rightarrow_s_24"
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_24"/>
        </LinearLayout>
        <RelativeLayout
            android:id="@+id/springboard_container"
            android:layout_width="@dimen/dp_770"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/dp_75"
            android:layout_marginBottom="@dimen/dp_30"
            android:layout_marginStart="@dimen/dp_458">
            <com.byd.card.drag.FolderScrollView
                android:scrollbarSize="@dimen/dp_4"
                android:scrollbarThumbVertical="@drawable/scroll_thumb"
                android:scrollbarTrackVertical="@color/app_center_scrollbar_track"
                android:id="@+id/app_scrollview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/dp_10"
                android:fillViewport="true"
                android:scrollbarFadeDuration="@integer/scroll_view_duration">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/container"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="@dimen/dp_25"/>
            </com.byd.card.drag.FolderScrollView>
        </RelativeLayout>
        <com.byd.card.widget.OverScrollLayout
            android:id="@+id/search_scroll"
            android:background="@drawable/all_app_search_result_bg"
            android:visibility="gone"
            android:layout_width="@dimen/dp_395"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_114"
            android:paddingEnd="@dimen/dp_9"
            android:layout_marginStart="@dimen/dp_80">
            <com.byd.card.widget.MaxHeightRecyclerView
                android:scrollbarThumbVertical="@color/app_center_scrollbar"
                android:scrollbarTrackVertical="@color/app_center_scrollbar_track"
                android:orientation="vertical"
                android:id="@+id/search_result_rv"
                android:background="@android:color/transparent"
                android:visibility="gone"
                android:scrollbars="vertical"
                android:fadingEdgeLength="@dimen/dp_50"
                android:layout_width="@dimen/dp_386"
                android:layout_height="wrap_content"
                android:scrollbarFadeDuration="@integer/scroll_view_duration"
                android:overScrollMode="never"
                android:requiresFadingEdge="vertical"
                android:layoutDirection="locale"
                android:layout_marginEnd="@dimen/dp_9"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:maxHeight="@dimen/dp_420"/>
        </com.byd.card.widget.OverScrollLayout>
        <com.byd.card.widget.BlurView
            android:id="@+id/blur_folder_layout"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/folder_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </com.byd.card.widget.BlurView>
        <ImageView
            android:id="@+id/panelMoving"
            android:background="@null"
            android:visibility="gone"
            android:layout_width="@dimen/dp_72"
            android:layout_height="@dimen/dp_72"
            android:contentDescription="@null"/>
    </com.byd.card.widget.BlurView>
</FrameLayout>
