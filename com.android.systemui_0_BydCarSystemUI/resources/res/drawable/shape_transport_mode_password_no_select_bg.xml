<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
    <item
        android:gravity="center"
        android:height="@dimen/dp_10"
        android:width="@dimen/dp_10">
        <shape
            android:shape="ring"
            android:useLevel="false">
            <gradient
                android:startColor="@color/color_transport_mode_password"
                android:endColor="@color/color_transport_mode_password"
                android:angle="0"
                android:type="radial"
                android:gradientRadius="@dimen/dp_10"/>
        </shape>
    </item>
    <item
        android:gravity="center"
        android:height="@dimen/dp_8"
        android:width="@dimen/dp_8">
        <shape android:shape="oval">
            <gradient
                android:startColor="@color/transparent_00"
                android:endColor="@color/transparent_00"
                android:angle="0"
                android:type="radial"
                android:gradientRadius="@dimen/dp_5"
                android:centerColor="@color/transparent_00"/>
        </shape>
    </item>
</layer-list>
