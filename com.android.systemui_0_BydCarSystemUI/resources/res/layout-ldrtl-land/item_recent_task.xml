<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_root"
    android:clickable="true"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layoutDirection="ltr">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="@dimen/dp_320"
        android:layout_height="@dimen/dp_48">
        <ImageView
            android:id="@+id/img_split"
            android:visibility="gone"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:src="@mipmap/icon_control_split_screen"/>
        <ImageView
            android:id="@+id/img_lock"
            android:visibility="invisible"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:src="@mipmap/icon_control_car_lock"/>
        <Space
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/color_recent_app_name"
            android:ellipsize="end"
            android:id="@+id/tv_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/dp_180"
            android:text="爱奇艺"
            android:maxLines="2"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/sp_10"
            android:layout_toEndOf="@+id/img_logo"/>
        <ImageView
            android:id="@+id/img_logo"
            android:layout_width="@dimen/dp_24"
            android:layout_height="@dimen/dp_24"
            android:layout_centerVertical="true"/>
    </LinearLayout>
    <androidx.cardview.widget.CardView
        android:layout_width="@dimen/dp_320"
        android:layout_height="@dimen/dp_180"
        app:cardCornerRadius="@dimen/dp_8"
        app:cardElevation="@dimen/dp_0">
        <ImageView
            android:id="@+id/img_thumb"
            android:background="@android:color/transparent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"/>
    </androidx.cardview.widget.CardView>
</LinearLayout>
