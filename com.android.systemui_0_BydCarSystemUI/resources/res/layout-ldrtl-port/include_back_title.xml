<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_48"
    android:layout_marginTop="@dimen/panel_back_title_margin_top"
    android:layoutDirection="rtl"
    android:paddingStart="@dimen/dp_32"
    android:paddingEnd="@dimen/dp_32">
    <ImageView
        android:id="@+id/img_back"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        android:src="@mipmap/icon_public_leftarrow"
        android:layout_centerVertical="true"
        android:rotation="180"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textSize="@dimen/sp_20"
        android:textStyle="bold"
        android:textColor="@color/color_qs_back"
        android:gravity="center_vertical"
        android:id="@+id/tv_back"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_48"
        android:text="@string/qs_link_name"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@+id/img_back"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="@color/color_qs_back"
        android:gravity="center_vertical"
        android:id="@+id/tv_right"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/function_introduce"
        android:drawableLeft="@drawable/shape_scene_introduce_help"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/dp_44"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
