<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rl_recyclerview_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">
    <ImageView
        android:id="@+id/img_drawer_mask"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <ImageView
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@color/qs_content_overlay"
        android:scaleType="centerCrop"/>
    <include
        android:id="@+id/rl_title"
        layout="@layout/include_back_title"/>
    <RelativeLayout
        android:id="@+id/rl_selected"
        android:background="@drawable/sysui_qs_panel_content_bg"
        android:clickable="true"
        android:layout_width="@dimen/dp_688"
        android:layout_height="@dimen/dp_184"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_below="@+id/rl_title"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_alignParentStart="true">
        <TextView
            android:textSize="@dimen/sp_18"
            android:textStyle="bold"
            android:textColor="@color/color_qs_label"
            android:layout_gravity="left"
            android:id="@+id/tv_selected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:text="@string/label_selected"
            android:layout_marginStart="@dimen/dp_24"/>
        <com.android.systemui.widget.SysUiRecyclerView
            android:id="@+id/rv_items_selected"
            android:scrollbars="none"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_16"
            android:layout_marginRight="@dimen/dp_16"
            android:layout_below="@+id/tv_selected"
            android:overScrollMode="never"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_unselected"
        android:background="@drawable/sysui_qs_panel_content_bg"
        android:clickable="true"
        android:layout_width="@dimen/dp_688"
        android:layout_height="@dimen/dp_316"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_below="@+id/rl_selected"
        android:layout_marginStart="@dimen/dp_16">
        <TextView
            android:textSize="@dimen/sp_18"
            android:textStyle="bold"
            android:textColor="@color/color_qs_label"
            android:layout_gravity="left"
            android:id="@+id/tv_unselected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:text="@string/label_unselected"
            android:layout_marginStart="@dimen/dp_24"/>
        <com.android.systemui.widget.SysUiRecyclerView
            android:scrollbarStyle="insideOverlay"
            android:id="@+id/rv_items_unselected"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/dp_16"
            android:layout_marginRight="@dimen/dp_16"
            android:layout_below="@+id/tv_unselected"
            android:overScrollMode="never"/>
    </RelativeLayout>
</RelativeLayout>
