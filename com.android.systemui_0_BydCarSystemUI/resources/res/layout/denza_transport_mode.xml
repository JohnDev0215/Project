<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/transport_view"
    android:background="@drawable/denza_transport_mode_bg"
    android:layout_width="@dimen/dp_200"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/icon_transport"
        android:background="@mipmap/denza_icon_transport_mode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="@dimen/sp_24"
        android:textColor="@color/denza_add_card_title"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_transport"
        android:layout_width="@dimen/dp_200"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_1"
        android:text="@string/transport_mode"
        android:lines="@integer/more_app_recent_tv"
        android:maxEms="@integer/more_app_recent_tv"/>
</LinearLayout>
