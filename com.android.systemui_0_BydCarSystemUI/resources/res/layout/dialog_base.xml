<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_dialog"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/sp_20"
        android:textStyle="bold"
        android:textColor="@color/text_title"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatButton
        android:textSize="@dimen/sp_18"
        android:textColor="@color/selector_text_button"
        android:gravity="center"
        android:id="@+id/btn_reset"
        android:background="@drawable/bg_button_normal"
        android:layout_width="@dimen/dp_128"
        android:layout_height="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_16"
        android:text="@string/btn_reset"
        android:textAllCaps="false"
        android:layout_marginEnd="@dimen/dp_22"
        android:stateListAnimator="@animator/profile_pressed_state_list"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:background="@color/divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_marginTop="@dimen/dp_71"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.core.widget.NestedScrollView
        android:scrollbarSize="@dimen/dp_4"
        android:scrollbarThumbVertical="@color/scrollbar_thumb"
        android:scrollbarTrackVertical="@color/scrollbar_track"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dp_72"
        android:layout_marginBottom="@dimen/dp_104"
        android:fadeScrollbars="false"
        android:layout_marginEnd="@dimen/dp_9">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ly_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_13"/>
    </androidx.core.widget.NestedScrollView>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <androidx.appcompat.widget.AppCompatButton
        android:textSize="@dimen/sp_18"
        android:textColor="@color/selector_text_button_ok"
        android:gravity="center"
        android:id="@+id/btn_ok"
        android:background="@drawable/bg_button_default_selector"
        android:layout_width="@dimen/dp_144"
        android:layout_height="@dimen/dp_40"
        android:layout_marginBottom="@dimen/dp_32"
        android:text="@string/btn_save"
        android:textAllCaps="false"
        android:layout_marginEnd="@dimen/dp_20"
        android:stateListAnimator="@animator/profile_pressed_state_list"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guide"/>
    <androidx.appcompat.widget.AppCompatButton
        android:textSize="@dimen/sp_18"
        android:textColor="@color/selector_text_button"
        android:gravity="center"
        android:id="@+id/btn_cancel"
        android:background="@drawable/bg_button_normal"
        android:layout_width="@dimen/dp_144"
        android:layout_height="@dimen/dp_40"
        android:layout_marginBottom="@dimen/dp_32"
        android:text="@string/cancel"
        android:textAllCaps="false"
        android:layout_marginStart="@dimen/dp_20"
        android:stateListAnimator="@animator/profile_pressed_state_list"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/guide"/>
</androidx.constraintlayout.widget.ConstraintLayout>
