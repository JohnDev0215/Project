<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/shape_navi_bar_air_pop_bg"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.byd.card.widget.BlurView
        android:id="@+id/blurView"
        android:layout_width="@dimen/dp_240"
        android:layout_height="@dimen/dp_180"/>
    <RelativeLayout
        android:id="@+id/rlDefrost"
        android:paddingLeft="@dimen/margin_navi_bar_wind_set_pop"
        android:paddingRight="@dimen/margin_navi_bar_wind_set_pop"
        android:layout_width="@dimen/dp_240"
        android:layout_height="@dimen/height_navi_bar_wind_set_pop">
        <com.android.systemui.widget.BydImageView
            android:id="@+id/imgDefrost"
            android:src="@mipmap/icon_defrost_s"
            app:clickChangeColor="false"
            style="@style/navi_bar_wind_set_img"/>
        <TextView
            android:id="@+id/tvDefrost"
            android:text="@string/front_defrost"
            android:layout_toEndOf="@+id/imgDefrost"
            style="@style/navi_bar_wind_set_pop_tv_name"/>
        <RadioButton
            android:id="@+id/radioBtnDefrost"
            android:layout_toEndOf="@+id/tvDefrost"
            style="@style/navi_bar_wind_set_pop_btn_check"/>
        <View
            android:layout_alignParentBottom="true"
            style="@style/navi_bar_custom_pop_line"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rlCycleMode"
        android:paddingLeft="@dimen/margin_navi_bar_wind_set_pop"
        android:paddingRight="@dimen/margin_navi_bar_wind_set_pop"
        android:layout_width="@dimen/dp_240"
        android:layout_height="@dimen/height_navi_bar_wind_set_pop"
        android:layout_below="@+id/rlDefrost">
        <com.android.systemui.widget.BydImageView
            android:id="@+id/iv_loop_mode"
            android:src="@mipmap/icon_inner_loop_s"
            app:clickChangeColor="false"
            style="@style/navi_bar_wind_set_img"/>
        <TextView
            android:id="@+id/tv_loop_mode"
            android:text="@string/inner_loop"
            android:layout_toEndOf="@+id/iv_loop_mode"
            style="@style/navi_bar_wind_set_pop_tv_name"/>
        <RadioButton
            android:id="@+id/radioBtnCycleMode"
            android:layout_toEndOf="@+id/tv_loop_mode"
            style="@style/navi_bar_wind_set_pop_btn_check"/>
        <View
            android:layout_alignParentBottom="true"
            style="@style/navi_bar_custom_pop_line"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rlVentilation"
        android:paddingLeft="@dimen/margin_navi_bar_wind_set_pop"
        android:paddingRight="@dimen/margin_navi_bar_wind_set_pop"
        android:layout_width="@dimen/dp_240"
        android:layout_height="@dimen/height_navi_bar_wind_set_pop"
        android:layout_below="@+id/rlCycleMode">
        <com.android.systemui.widget.BydImageView
            android:id="@+id/ivVentilation"
            android:src="@mipmap/icon_ventilate_s"
            app:clickChangeColor="false"
            style="@style/navi_bar_wind_set_img"/>
        <TextView
            android:id="@+id/tvVentilation"
            android:text="@string/ventilation"
            android:layout_toEndOf="@+id/ivVentilation"
            style="@style/navi_bar_wind_set_pop_tv_name"/>
        <RadioButton
            android:id="@+id/radioBtnVentilation"
            android:layout_toEndOf="@+id/tvVentilation"
            style="@style/navi_bar_wind_set_pop_btn_check"/>
    </RelativeLayout>
</RelativeLayout>
