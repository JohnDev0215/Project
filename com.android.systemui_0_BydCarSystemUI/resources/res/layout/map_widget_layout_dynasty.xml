<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="@dimen/dp_254"
    android:layout_height="@dimen/dp_100">
    <ImageView
        android:id="@+id/all_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@mipmap/img_navi_bg"
        android:scaleType="fitXY"/>
    <ImageView
        android:id="@+id/im_location"
        android:layout_width="@dimen/dp_100"
        android:layout_height="@dimen/dp_100"
        android:src="@mipmap/img_navi"
        android:layout_centerVertical="true"
        android:layout_marginStart="-2dp"
        android:layout_alignParentStart="true"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/home"
        android:paddingTop="@dimen/dp_13"
        android:paddingBottom="@dimen/dp_12"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/dp_4"
        android:layout_toEndOf="@+id/im_location">
        <FrameLayout
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48">
            <ImageView
                android:id="@+id/img_home_ring"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@mipmap/map_widget_ring"/>
            <ImageView
                android:id="@+id/img_home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@mipmap/icon_navi_home"/>
        </FrameLayout>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/app_map_title_text"
            android:id="@+id/text_home"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_7"
            android:text="@string/home"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/company"
        android:paddingTop="@dimen/dp_13"
        android:paddingBottom="@dimen/dp_12"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/dp_22"
        android:layout_toEndOf="@+id/home">
        <FrameLayout
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48">
            <ImageView
                android:id="@+id/img_work_ring"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@mipmap/map_widget_ring"/>
            <ImageView
                android:id="@+id/img_company"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@mipmap/icon_navi_work"/>
        </FrameLayout>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/app_map_title_text"
            android:id="@+id/text_company"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_7"
            android:text="@string/work"/>
    </LinearLayout>
</RelativeLayout>
