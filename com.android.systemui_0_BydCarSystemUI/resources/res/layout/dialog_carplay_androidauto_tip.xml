<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:background="@color/bg_fullscreen_dialog"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/bg_frame_dialog_gradient"
        android:layout_width="@dimen/dp_560"
        android:layout_height="@dimen/dp_312"
        android:layout_centerInParent="true">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textStyle="bold"
            android:textColor="@color/dialog_hvac_system_text_color"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_71"
            android:text="@string/attention"
            android:layout_centerHorizontal="true"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/title_line"
            android:background="@color/bg_color_line"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/launcher_add_app_title"
            android:gravity="center"
            android:id="@+id/message"
            android:layout_width="@dimen/dp_464"
            android:layout_height="match_parent"
            android:layout_marginBottom="@dimen/dp_28"
            android:text="@string/confirm_clear_history"
            app:layout_constraintBottom_toTopOf="@+id/btnLeft"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/btnLeft"
            android:background="@drawable/shape_bg_blue_button_cp"
            android:layout_width="@dimen/dp_176"
            android:layout_height="@dimen/dp_48"
            android:layout_marginBottom="@dimen/dp_28"
            android:text="@string/confirm"
            android:layout_marginStart="@dimen/dp_88"
            android:stateListAnimator="@drawable/anim_btn_scale_alpha"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/launcher_cancel"
            android:gravity="center"
            android:id="@+id/btnRight"
            android:background="@drawable/shape_bg_white_button_cp"
            android:layout_width="@dimen/dp_176"
            android:layout_height="@dimen/dp_48"
            android:layout_marginBottom="@dimen/dp_28"
            android:text="@string/cancel"
            android:layout_marginEnd="@dimen/dp_88"
            android:stateListAnimator="@drawable/anim_btn_scale_alpha"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>
