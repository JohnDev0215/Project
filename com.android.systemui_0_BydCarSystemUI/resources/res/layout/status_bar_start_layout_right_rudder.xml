<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <com.android.systemui.widget.StatusBydImageView
        android:id="@+id/sysui_icon_user"
        android:background="@drawable/shape_status_bar_icon_voice"
        android:src="@mipmap/img_personal_normal"
        android:layout_alignParentRight="true"
        style="@style/status_bar_button"/>
    <com.android.systemui.widget.StatusBydLinearLayout
        android:gravity="center"
        android:id="@+id/ll_pm"
        android:background="@drawable/shape_status_bar_icon"
        android:paddingLeft="@dimen/dp_6"
        android:paddingRight="@dimen/dp_4"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_32"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true">
        <TextView
            android:textSize="@dimen/sp_8"
            android:textColor="@color/color_status_pm_key"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_pm"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="@dimen/dp_15"
            android:layout_height="wrap_content"
            android:text="@string/pm_2p5"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/color_status_pm_value"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_pm_in_option"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sys_ui_inside"
            android:singleLine="true"
            android:layout_marginStart="@dimen/dp_4"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/color_status_pm_value"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/sysui_status_bar_in_pm"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sys_ui_txt_whippletree"
            android:singleLine="true"
            android:layout_marginStart="@dimen/dp_2"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/color_status_pm_value"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" "
            android:singleLine="true"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/color_status_pm_value"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_pm_out_option"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sys_ui_outside"
            android:singleLine="true"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/color_status_pm_value"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/sysui_status_bar_out_pm"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sys_ui_txt_whippletree"
            android:singleLine="true"
            android:layout_marginStart="@dimen/dp_2"/>
    </com.android.systemui.widget.StatusBydLinearLayout>
    <FrameLayout
        android:id="@+id/ll_signal"
        android:clickable="true"
        style="@style/status_bar_button_44">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/sysui_icon_phone_signal_level"
            android:visibility="visible"
            android:clickable="false"
            android:src="@mipmap/icon_status_bar_signal_none"
            style="@style/status_bar_button_44"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/sysui_icon_phone_signal_type"
            android:visibility="gone"
            android:clickable="false"
            android:src="@drawable/bar_signal_type_list"
            style="@style/status_bar_button_44"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/sysui_icon_phone_signal_orientation"
            android:visibility="gone"
            android:clickable="false"
            android:src="@mipmap/icon_status_bar_signal_orientation_two"
            style="@style/status_bar_button_44"/>
        <com.android.systemui.widget.StatusBydImageView
            android:id="@+id/img_signal_btn"
            android:src="@drawable/shape_status_bar_icon"
            style="@style/status_bar_button_44_click"/>
    </FrameLayout>
</merge>
