<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:background="@drawable/shape_navi_bar_air_pop_bg"
        android:paddingTop="@dimen/dp_1"
        android:paddingBottom="@dimen/dp_1"
        android:layout_width="@dimen/width_navi_bar_temp_set_pop"
        android:layout_height="@dimen/height_navi_bar_temp_set_pop">
        <com.android.systemui.widget.BydImageView
            android:id="@+id/iv_separate"
            android:layout_width="@dimen/dp_100"
            android:layout_height="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_17"
            android:src="@mipmap/icon_air_synchronous"
            android:layout_centerHorizontal="true"/>
        <View
            android:id="@+id/line"
            android:layout_marginTop="@dimen/dp_7"
            android:layout_below="@+id/iv_separate"
            style="@style/navi_bar_temp_set_pop_line"/>
        <RelativeLayout
            android:layout_width="@dimen/width_navi_bar_temp_set_pop"
            android:layout_height="@dimen/dp_205"
            android:layout_below="@+id/line">
            <com.android.systemui.widget.BydImageView
                android:layout_width="@dimen/dp_16"
                android:layout_height="@dimen/dp_16"
                android:layout_marginLeft="@dimen/dp_4"
                android:src="@mipmap/icon_air_arrow_left"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"/>
            <com.android.systemui.widget.BydImageView
                android:layout_width="@dimen/dp_16"
                android:layout_height="@dimen/dp_16"
                android:layout_marginRight="@dimen/dp_4"
                android:src="@mipmap/icon_air_arrow_right"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
            <com.android.systemui.widget.WheelView
                android:gravity="center_horizontal"
                android:layout_gravity="center"
                android:id="@+id/wheel_view"
                android:layout_width="@dimen/dp_65"
                android:layout_height="@dimen/dp_190"
                android:layout_centerInParent="true"
                app:wh_max_text_size="@dimen/sp_60"
                app:wh_min_text_size="@dimen/sp_32"
                app:wh_selected_text_color="@color/color_navi_temp_set_text_sel"
                app:wh_text_color="@color/color_navi_temp_set_text_nor"
                app:wh_text_space_ratio="2"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/color_navi_temp_set_text_sel"
                android:gravity="center"
                android:id="@+id/tv_degree_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sys_ui_txt_centigrade"
                android:layout_toRightOf="@+id/wheel_view"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>
