<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:id="@+id/sysui_qs_panel_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/img_drawer_mask"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <ImageView
        android:id="@+id/img_drawer_overlay"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@color/denza_qs_content_overlay"
        android:scaleType="centerCrop"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_volume"
        android:background="@drawable/denza_sysui_qs_panel_content_bg"
        android:paddingLeft="@dimen/dp_26"
        android:paddingTop="@dimen/dp_68"
        android:paddingRight="@dimen/dp_26"
        android:clickable="true"
        android:layout_width="@dimen/dp_188"
        android:layout_height="@dimen/dp_348"
        android:layout_marginTop="@dimen/dp_32"
        android:layout_marginRight="@dimen/dp_12"
        android:layout_toLeftOf="@+id/rl_car">
        <com.android.systemui.widget.SeekBarContainer
            android:id="@+id/sysui_qs_seekbar_voice"
            android:visibility="gone"
            android:layout_width="@dimen/dp_56"
            android:layout_height="match_parent"/>
        <com.android.systemui.widget.SeekBarContainer
            android:id="@+id/sysui_qs_seekbar_media"
            android:layout_width="@dimen/dp_56"
            android:layout_height="match_parent"/>
        <Space
            android:id="@+id/space1"
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <com.android.systemui.widget.SeekBarContainer
            android:id="@+id/sysui_qs_seekbar_navigation"
            android:layout_width="@dimen/dp_56"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textStyle="bold"
        android:textColor="@color/denza_qs_seekbar_title"
        android:id="@+id/tv_volume"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_20"
        android:text="@string/sys_ui_qs_volume"
        android:layout_alignLeft="@+id/ll_volume"
        android:layout_alignTop="@+id/ll_volume"
        android:layout_marginStart="@dimen/dp_24"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_bright"
        android:background="@drawable/denza_sysui_qs_panel_content_bg"
        android:paddingLeft="@dimen/dp_26"
        android:paddingTop="@dimen/dp_68"
        android:paddingRight="@dimen/dp_26"
        android:clickable="true"
        android:layout_width="@dimen/dp_188"
        android:layout_height="@dimen/dp_348"
        android:layout_marginTop="@dimen/dp_32"
        android:layout_marginRight="@dimen/dp_12"
        android:layout_toLeftOf="@+id/ll_volume">
        <com.android.systemui.widget.SeekBarContainer
            android:id="@+id/sysui_qs_seekbar_central_control"
            android:layout_width="@dimen/dp_56"
            android:layout_height="match_parent"/>
        <Space
            android:id="@+id/space3"
            android:visibility="gone"
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"/>
        <com.android.systemui.widget.SeekBarContainer
            android:id="@+id/sysui_qs_seekbar_dashboard"
            android:visibility="gone"
            android:layout_width="@dimen/dp_56"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/dp_24"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textStyle="bold"
        android:textColor="@color/denza_qs_seekbar_title"
        android:id="@+id/tv_brightness"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_20"
        android:text="@string/sys_ui_qs_brightness"
        android:layout_alignTop="@+id/ll_bright"
        android:layout_marginStart="@dimen/dp_24"
        android:layout_alignStart="@+id/ll_bright"/>
    <include
        android:id="@+id/rl_car"
        android:layout_width="@dimen/dp_388"
        android:layout_height="@dimen/dp_348"
        android:layout_marginTop="@dimen/dp_32"
        android:layout_marginRight="@dimen/dp_12"
        android:layout_toLeftOf="@+id/rl_qs"
        layout="@layout/denza_include_qs_common"/>
    <include
        android:id="@+id/rl_qs"
        android:layout_width="@dimen/dp_388"
        android:layout_height="@dimen/dp_348"
        android:layout_marginTop="@dimen/dp_32"
        android:layout_marginRight="@dimen/dp_46"
        android:layout_alignParentRight="true"
        layout="@layout/denza_include_qs_common"/>
    <include
        android:id="@+id/rl_scene_mode"
        android:layout_width="@dimen/dp_388"
        android:layout_height="@dimen/dp_192"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginRight="@dimen/dp_46"
        android:layout_below="@+id/rl_qs"
        android:layout_alignParentRight="true"
        layout="@layout/denza_include_qs_common"/>
    <RelativeLayout
        android:id="@+id/rlSoc"
        android:background="@drawable/denza_sysui_qs_panel_content_bg"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="@dimen/dp_788"
        android:layout_height="@dimen/dp_192"
        android:layout_marginLeft="@dimen/dp_46"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_below="@+id/rl_qs"
        android:layout_alignParentLeft="true">
        <LinearLayout
            android:gravity="start|center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_soc_switch"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_48"
            android:layout_marginTop="@dimen/dp_10"
            android:paddingStart="@dimen/dp_26"
            android:paddingEnd="@dimen/dp_26">
            <com.android.systemui.widget.BydSwitch
                android:id="@+id/switch_soc"
                android:background="@drawable/switch_track"
                android:layout_width="@dimen/dp_64"
                android:layout_height="@dimen/dp_48"
                android:thumb="@null"
                android:switchMinWidth="@dimen/dp_56"
                android:paddingEnd="@dimen/dp_4"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/color_qs_title"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/energy_enforce_electricity"
                android:layout_marginStart="@dimen/dp_16"/>
        </LinearLayout>
        <RelativeLayout
            android:id="@+id/rl_soc_seekbar"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_42"
            android:layout_below="@+id/ll_soc_switch">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/soc_text_color"
                android:id="@+id/tv_soc_value"
                android:layout_width="@dimen/dp_49"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/dp_26"
                android:layout_alignParentStart="true"/>
            <com.android.systemui.widget.SocSeekbar
                android:id="@+id/seekbar_soc"
                android:layout_width="@dimen/dp_720"
                android:layout_height="@dimen/dp_40"
                android:layout_marginStart="@dimen/dp_66"/>
        </RelativeLayout>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color_qs_label"
            android:id="@+id/tv_soc_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/rl_soc_seekbar"
            android:layout_marginStart="@dimen/dp_87"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color_qs_label"
            android:id="@+id/tv_soc_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/rl_soc_seekbar"
            android:layout_marginEnd="@dimen/dp_21"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <ImageView
        android:layout_width="@dimen/dp_34"
        android:layout_height="@dimen/dp_4"
        android:layout_marginBottom="@dimen/dp_28"
        android:src="@drawable/denza_sysui_qs_panel_indicator_bg"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
