<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:background="@drawable/denza_blur_shadow_bg"
    android:layout_width="@dimen/dp_1232"
    android:layout_height="@dimen/dp_570"
    android:elevation="@dimen/dp_10">
    <com.byd.card.widget.BlurView
        android:layout_gravity="center"
        android:id="@+id/id_ConstraintLayout"
        android:background="@drawable/denza_add_card_bg"
        android:layout_width="@dimen/dp_1232"
        android:layout_height="@dimen/dp_570">
        <ImageView
            android:id="@+id/more_close"
            android:background="@mipmap/denza_close"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:layout_marginTop="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_24"
            android:layout_alignParentEnd="true"/>
        <ImageView
            android:id="@+id/more_back"
            android:background="@mipmap/denza_back"
            android:visibility="gone"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:layout_marginTop="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_32"
            android:layout_alignParentEnd="true"/>
        <RelativeLayout
            android:id="@+id/search_bg"
            android:background="@drawable/denza_app_search_bg"
            android:layout_width="@dimen/dp_264"
            android:layout_height="@dimen/dp_48"
            android:layout_marginTop="@dimen/dp_58"
            android:layout_marginEnd="@dimen/dp_80"
            android:layout_alignParentEnd="true">
            <ImageView
                android:id="@+id/search"
                android:background="@mipmap/denza_public_search"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:layout_marginStart="@dimen/dp_8"/>
            <EditText
                android:textSize="@dimen/sp_18"
                android:textColor="@color/denza_add_card_title"
                android:textColorHint="@color/denza_search_hint"
                android:ellipsize="end"
                android:id="@+id/more_search_edit"
                android:background="@null"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:hint="@string/search"
                android:singleLine="true"
                android:inputType="textCapWords"
                android:imeOptions="actionDone"
                android:layout_toEndOf="@+id/search"/>
            <ImageView
                android:id="@+id/clear"
                android:background="@mipmap/denza_delete_all"
                android:visibility="gone"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:layout_marginEnd="@dimen/dp_8"
                android:layout_alignParentEnd="true"/>
            <ImageView
                android:id="@+id/voice_divider"
                android:background="@color/divider_voice_color"
                android:visibility="gone"
                android:layout_width="@dimen/dp_1"
                android:layout_height="@dimen/dp_22"
                android:layout_marginTop="@dimen/dp_13"
                android:layout_toStartOf="@+id/voice"/>
            <ImageView
                android:id="@+id/voice"
                android:background="@mipmap/icon_public_voice"
                android:visibility="gone"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:layout_marginEnd="@dimen/dp_8"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/denza_app_name"
            android:id="@+id/recent_use"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_131"
            android:text="@string/last_use"
            android:layout_marginStart="@dimen/dp_870"
            android:textFontWeight="500"/>
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/denza_app_name"
            android:id="@+id/search_history"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_131"
            android:text="@string/search_history"
            android:layout_marginStart="@dimen/dp_870"
            android:textFontWeight="500"/>
        <ImageView
            android:id="@+id/delete_history_all"
            android:background="@mipmap/denza_delete_history"
            android:visibility="gone"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:layout_marginTop="@dimen/dp_125"
            android:layout_marginEnd="@dimen/dp_68"
            android:layout_alignParentEnd="true"/>
        <RelativeLayout
            android:layout_width="@dimen/dp_420"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_290"
            android:layout_alignParentEnd="true">
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/denza_no_recent_use"
                android:id="@+id/no_recent_use"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_recent_use_app"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <com.byd.card.widget.DampingScrollView
            android:id="@+id/recent_scroll"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_600"
            android:layout_marginTop="@dimen/dp_166"
            android:overScrollMode="never"
            android:layout_marginEnd="@dimen/dp_58"
            android:layout_alignParentEnd="true">
            <androidx.recyclerview.widget.RecyclerView
                android:orientation="vertical"
                android:id="@+id/recent_recycler"
                android:scrollbars="none"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:overScrollMode="never"
                android:layoutDirection="locale"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="@integer/recent_app_row_count_land"/>
        </com.byd.card.widget.DampingScrollView>
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="horizontal"
            android:id="@+id/history_recycler"
            android:visibility="gone"
            android:layout_width="@dimen/dp_264"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_176"
            android:layout_marginEnd="@dimen/dp_80"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/denza_no_recent_use"
            android:id="@+id/no_history"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_216"
            android:text="@string/not_search_history"
            android:layout_marginEnd="@dimen/dp_160"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/denza_app_name"
            android:gravity="center"
            android:id="@+id/no_search_result"
            android:background="@drawable/denza_search_result_bg"
            android:visibility="gone"
            android:layout_width="@dimen/dp_264"
            android:layout_height="@dimen/dp_50"
            android:layout_marginTop="@dimen/dp_114"
            android:text="@string/not_search_result"
            android:layout_marginEnd="@dimen/dp_80"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/denza_app_name"
            android:id="@+id/my_app"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_58"
            android:text="@string/my_app"
            android:layout_marginStart="@dimen/dp_45"
            android:textFontWeight="500"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/app_market_btn"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_58"
            android:layout_marginEnd="@dimen/dp_448"
            android:layout_alignParentEnd="true">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/launcher_app_market"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_market"
                android:textFontWeight="500"/>
            <ImageView
                android:layout_gravity="center"
                android:background="@mipmap/launcher_icon_public_rightarrow_s_24"
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_24"/>
        </LinearLayout>
        <RelativeLayout
            android:id="@+id/springboard_container"
            android:layout_width="@dimen/dp_780"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/dp_75"
            android:layout_marginBottom="@dimen/dp_30"
            android:layout_marginEnd="@dimen/dp_425"
            android:layout_alignParentEnd="true">
            <com.byd.card.drag.FolderScrollView
                android:scrollbarSize="@dimen/dp_4"
                android:scrollbarThumbVertical="@color/denza_scroll_thumb_color"
                android:scrollbarTrackVertical="@color/denza_scroll_track_color"
                android:id="@+id/app_scrollview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/dp_10"
                android:fillViewport="true"
                android:scrollbarFadeDuration="@integer/scroll_view_duration"
                android:layout_marginStart="@dimen/dp_10">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/container"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/dp_5"
                    android:layout_marginEnd="@dimen/dp_30"/>
            </com.byd.card.drag.FolderScrollView>
        </RelativeLayout>
        <com.byd.card.widget.OverScrollLayout
            android:id="@+id/search_scroll"
            android:background="@drawable/denza_search_result_bg"
            android:visibility="gone"
            android:scrollbars="none"
            android:layout_width="@dimen/dp_395"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_114"
            android:paddingEnd="@dimen/dp_9"
            android:layout_marginEnd="@dimen/dp_80"
            android:layout_alignParentEnd="true">
            <androidx.recyclerview.widget.RecyclerView
                android:scrollbarThumbVertical="@color/denza_scroll_thumb_color"
                android:scrollbarTrackVertical="@color/denza_scroll_track_color"
                android:orientation="vertical"
                android:id="@+id/search_result_rv"
                android:visibility="gone"
                android:scrollbars="vertical"
                android:fadingEdgeLength="@dimen/dp_50"
                android:layout_width="@dimen/dp_386"
                android:layout_height="wrap_content"
                android:scrollbarFadeDuration="@integer/scroll_view_duration"
                android:layoutDirection="locale"
                android:layout_marginEnd="@dimen/dp_9"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
        </com.byd.card.widget.OverScrollLayout>
        <com.byd.card.widget.BlurView
            android:id="@+id/blur_folder_layout"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/folder_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </com.byd.card.widget.BlurView>
        <ImageView
            android:id="@+id/panelMoving"
            android:background="@null"
            android:visibility="gone"
            android:layout_width="@dimen/dp_72"
            android:layout_height="@dimen/dp_72"
            android:contentDescription="@null"/>
    </com.byd.card.widget.BlurView>
</FrameLayout>
