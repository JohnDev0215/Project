<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="@dimen/panel_btn_item_width"
    android:layout_height="@dimen/dp_134">
    <RelativeLayout
        android:id="@+id/rl_content"
        android:background="@drawable/denza_selector_item_qs_btn"
        android:layout_width="@dimen/dp_66"
        android:layout_height="@dimen/dp_66">
        <com.android.systemui.widget.BydImageView
            android:id="@+id/iv_item"
            android:clickable="false"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:src="@mipmap/icon_control_wifi"
            android:layout_centerInParent="true"
            app:bg_tint_color="@color/denza_bg_qs_item_tint"
            app:bg_tint_color_normal="@color/denza_bg_qs_item_normal_tint"/>
    </RelativeLayout>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/denza_color_qs_title"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/tv_item"
        android:clickable="false"
        android:layout_width="@dimen/panel_btn_item_text_width"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4"
        android:text="@string/car_title_energy_feedback"
        android:lines="2"
        android:paddingStart="@dimen/dp_10"
        android:paddingEnd="@dimen/dp_10"/>
</LinearLayout>
