<?xml version="1.0" encoding="utf-8"?>
<com.android.systemui.statusbar.phone.PhoneStatusBarView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/status_bar"
    android:background="@android:color/transparent"
    android:focusable="false"
    android:descendantFocusability="afterDescendants"
    android:layout_width="match_parent"
    android:layout_height="@dimen/status_bar_height"
    android:accessibilityPaneTitle="@string/status_bar">
    <RelativeLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/status_bar_contents"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/dp_24"
        android:paddingEnd="@dimen/dp_20">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ly_start"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentLeft="true">
            <include layout="@layout/status_bar_start_layout"/>
        </LinearLayout>
        <include
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:minWidth="@dimen/dp_16"
            android:layout_weight="1"
            android:layout_toLeftOf="@+id/ly_end"
            android:layout_toRightOf="@+id/ly_start"
            android:layout_centerVertical="true"
            layout="@layout/status_bar_general_icon_layout"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ly_end"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentRight="true">
            <include layout="@layout/status_bar_end_layout"/>
        </LinearLayout>
    </RelativeLayout>
</com.android.systemui.statusbar.phone.PhoneStatusBarView>
