<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/denza_second_confirm_bg_drawable"
    android:layout_width="@dimen/dp_560"
    android:layout_height="@dimen/dp_200">
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="@color/denza_add_card_title"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_52"
        android:text="@string/confirm_clear_history"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="@color/denza_app_name"
        android:gravity="center"
        android:id="@+id/clear_history_cancel"
        android:background="@drawable/denza_add_app_cancel_btn_bg"
        android:layout_width="@dimen/dp_176"
        android:layout_height="@dimen/dp_48"
        android:layout_marginBottom="@dimen/dp_38"
        android:text="@string/cancel"
        android:layout_marginStart="@dimen/dp_88"
        android:elevation="@dimen/dp_2"
        android:stateListAnimator="@drawable/anim_btn_scale_alpha"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="@color/denza_confirm_text"
        android:gravity="center"
        android:id="@+id/clear_history_confirm"
        android:background="@drawable/denza_add_app_sure_btn_bg"
        android:layout_width="@dimen/dp_176"
        android:layout_height="@dimen/dp_48"
        android:layout_marginBottom="@dimen/dp_38"
        android:text="@string/confirm"
        android:layout_marginEnd="@dimen/dp_88"
        android:elevation="@dimen/dp_2"
        android:stateListAnimator="@drawable/anim_btn_scale_alpha"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
