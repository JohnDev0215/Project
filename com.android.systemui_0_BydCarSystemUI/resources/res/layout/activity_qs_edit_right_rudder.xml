<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rl_recyclerview_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/img_drawer_mask"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <ImageView
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@color/qs_content_overlay"
        android:scaleType="centerCrop"/>
    <include
        android:id="@+id/rl_title"
        layout="@layout/include_back_title"/>
    <RelativeLayout
        android:id="@+id/rl_selected"
        android:background="@drawable/sysui_qs_panel_content_bg"
        android:clickable="true"
        android:layout_width="@dimen/dp_388"
        android:layout_height="@dimen/dp_300"
        android:layout_marginTop="@dimen/dp_100"
        android:layout_marginRight="@dimen/dp_46"
        android:layout_alignParentRight="true">
        <TextView
            android:textSize="@dimen/sp_18"
            android:textStyle="bold"
            android:textColor="@color/color_qs_label"
            android:layout_gravity="left"
            android:id="@+id/tv_selected"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_24"
            android:layout_marginTop="@dimen/dp_20"
            android:text="@string/label_selected"/>
        <com.android.systemui.widget.SysUiRecyclerView
            android:id="@+id/rv_items_selected"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/tv_selected"
            android:layout_centerHorizontal="true"
            android:overScrollMode="never"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_unselected"
        android:background="@drawable/sysui_qs_panel_content_bg"
        android:clickable="true"
        android:layout_width="@dimen/dp_788"
        android:layout_height="@dimen/dp_300"
        android:layout_marginTop="@dimen/dp_100"
        android:layout_marginRight="@dimen/dp_12"
        android:layout_toLeftOf="@+id/rl_selected">
        <TextView
            android:textSize="@dimen/sp_18"
            android:textStyle="bold"
            android:textColor="@color/color_qs_label"
            android:layout_gravity="left"
            android:id="@+id/tv_unselected"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_24"
            android:layout_marginTop="@dimen/dp_20"
            android:text="@string/label_unselected"/>
        <com.android.systemui.widget.SysUiRecyclerView
            android:scrollbarStyle="insideOverlay"
            android:id="@+id/rv_items_unselected"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/tv_unselected"
            android:layout_centerHorizontal="true"
            android:overScrollMode="never"/>
    </RelativeLayout>
</RelativeLayout>
