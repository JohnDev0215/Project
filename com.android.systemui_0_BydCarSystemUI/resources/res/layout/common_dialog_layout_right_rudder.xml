<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/ll_dialog_container"
    android:background="#8c000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="-4dp">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_dialog_background"
        android:background="@drawable/system_ui_hvac_dialog_background"
        android:layout_width="@dimen/dp_560"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/dialog_hvac_system_text_color"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_22"
            android:layout_marginBottom="@dimen/dp_21"
            android:text="@string/hvac_sys"/>
        <View
            android:id="@+id/title_line"
            android:background="@color/dialog_hvac_system_line_color"
            android:layout_width="@dimen/dp_560"
            android:layout_height="1dp"/>
        <RelativeLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_48"
            android:paddingStart="@dimen/dp_48"
            android:paddingEnd="@dimen/dp_48">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/dialog_hvac_system_text_color"
                android:gravity="center"
                android:id="@+id/message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/dp_116"
                android:text="@string/ac_start_vehicle_tips"/>
        </RelativeLayout>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_btn_container"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_76"
            android:layout_marginTop="@dimen/dp_44">
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/dialog_hvac_system_text_color"
                android:gravity="center"
                android:id="@+id/btnLeft"
                android:background="@drawable/shape_hvac_system_button_bg"
                android:layout_width="@dimen/dp_176"
                android:layout_height="@dimen/dp_48"
                android:text="@string/cancel"
                android:layout_marginStart="@dimen/dp_70"
                android:layout_marginEnd="@dimen/dp_70"
                android:stateListAnimator="@drawable/anim_btn_alpha"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/dialog_hvac_system_text_color"
                android:gravity="center"
                android:id="@+id/btnRight"
                android:background="@drawable/shape_hvac_system_button_bg"
                android:layout_width="@dimen/dp_176"
                android:layout_height="@dimen/dp_48"
                android:text="@string/confirm"
                android:layout_marginEnd="@dimen/dp_70"
                android:stateListAnimator="@drawable/anim_btn_alpha"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
