<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">
    <FrameLayout
        android:id="@+id/fl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true">
        <com.android.systemui.widget.CustomVerticalSeekBar
            android:layout_gravity="center"
            android:id="@+id/sysui_qs_custom_vertical_seekbar"
            android:background="@null"
            android:paddingLeft="0dp"
            android:paddingTop="0dp"
            android:paddingRight="0dp"
            android:paddingBottom="0dp"
            android:layout_width="@dimen/dp_190"
            android:layout_height="@dimen/dp_66"
            android:maxWidth="@dimen/dp_190"
            android:maxHeight="@dimen/dp_66"
            android:progressDrawable="@drawable/sysui_volume_ui_seek_bar_style"
            android:minWidth="@dimen/dp_190"
            android:minHeight="@dimen/dp_66"
            android:thumb="@null"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"/>
        <TextView
            android:textSize="@dimen/sp_34"
            android:textColor="@color/sys_volume_dialog_text_color"
            android:layout_gravity="top|center_horizontal"
            android:id="@+id/tv_sysui_qs_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"/>
    </FrameLayout>
    <ImageView
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/iv_sysui_qs_icon"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_3"
        android:src="@mipmap/icon_control_media_volume"
        android:layout_below="@+id/fl"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/sys_volume_dialog_title_color"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_sysui_qs_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_2"
        android:lines="1"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
</LinearLayout>
