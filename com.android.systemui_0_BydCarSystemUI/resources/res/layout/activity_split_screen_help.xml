<?xml version="1.0" encoding="utf-8"?>
<com.android.systemui.stackdivider.view.help.HelpView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rl_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.android.systemui.widget.BydImageView
        android:id="@+id/ivBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"/>
    <com.android.systemui.stackdivider.view.help.NoScrollViewPager
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"/>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/llPage"
        android:layout_width="@dimen/dp_670"
        android:layout_height="@dimen/dp_52"
        android:layout_marginTop="@dimen/dp_536"
        android:layout_centerHorizontal="true">
        <com.android.systemui.widget.BydImageView
            android:id="@+id/ivPage_1"
            android:background="@drawable/split_screen_help_page_common_bg"
            android:layout_width="@dimen/sp_16"
            android:layout_height="@dimen/dp_4"/>
        <com.android.systemui.widget.BydImageView
            android:id="@+id/ivPage_2"
            android:background="@drawable/split_screen_help_page_common_bg"
            android:layout_width="@dimen/sp_16"
            android:layout_height="@dimen/dp_4"
            android:layout_marginStart="@dimen/dp_4"/>
        <com.android.systemui.widget.BydImageView
            android:id="@+id/ivPage_3"
            android:background="@drawable/split_screen_help_page_common_bg"
            android:layout_width="@dimen/sp_16"
            android:layout_height="@dimen/dp_4"
            android:layout_marginStart="@dimen/dp_4"/>
        <com.android.systemui.widget.BydImageView
            android:id="@+id/ivPage_4"
            android:background="@drawable/split_screen_help_page_common_bg"
            android:layout_width="@dimen/sp_16"
            android:layout_height="@dimen/dp_4"
            android:layout_marginStart="@dimen/dp_4"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_width="@dimen/dp_670"
        android:layout_height="@dimen/dp_40"
        android:layout_below="@+id/llPage"
        android:layout_centerInParent="true">
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/color_close_btn"
            android:gravity="center"
            android:id="@+id/tvClose"
            android:background="@drawable/split_screen_help_close_btn_bg"
            android:layout_width="@dimen/dp_144"
            android:layout_height="@dimen/dp_40"
            android:text="@string/split_screen_close"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/color_next_btn"
            android:gravity="center"
            android:id="@+id/tvNext"
            android:background="@drawable/split_screen_help_next_btn_bg"
            android:layout_width="@dimen/dp_144"
            android:layout_height="@dimen/dp_40"
            android:text="@string/split_screen_next"
            android:layout_marginStart="@dimen/dp_64"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/color_next_btn"
            android:gravity="center"
            android:id="@+id/tvExperience"
            android:background="@drawable/split_screen_help_next_btn_bg"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_40"
            android:text="@string/split_screen_experience"
            android:paddingStart="@dimen/dp_24"
            android:paddingEnd="@dimen/dp_24"/>
    </LinearLayout>
</com.android.systemui.stackdivider.view.help.HelpView>
