<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="@dimen/dp_252"
    android:layout_height="@dimen/dp_60"
    android:layoutDirection="locale">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/media_card_popup_rl"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_59"
        android:paddingStart="@dimen/dp_24">
        <ImageView
            android:id="@+id/media_card_menu_icon"
            android:background="@drawable/ic_launcher_foreground"
            android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_32"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/media_popup_text_bg"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/media_card_menu_name"
            android:layout_width="@dimen/dp_124"
            android:layout_height="match_parent"
            android:text="@string/app_name"
            android:singleLine="true"
            android:textDirection="locale"
            android:layout_marginStart="@dimen/dp_8"/>
        <ImageView
            android:gravity="center_vertical"
            android:id="@+id/media_card_menu_ck"
            android:background="@mipmap/ac_bar_defrost_custom_checked"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:layout_marginStart="@dimen/dp_4"
            android:layout_marginEnd="@dimen/dp_16"/>
    </LinearLayout>
    <View
        android:id="@+id/divider"
        android:background="@color/media_pop_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/dp_24"
        android:layout_marginEnd="@dimen/dp_24"/>
</LinearLayout>
