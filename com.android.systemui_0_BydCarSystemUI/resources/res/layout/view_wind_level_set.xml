<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/shape_navi_bar_air_pop_bg"
    android:layout_width="@dimen/dp_454"
    android:layout_height="@dimen/dp_90"
    android:layoutDirection="ltr">
    <com.byd.card.widget.BlurView
        android:id="@+id/blurView"
        android:layout_width="@dimen/dp_454"
        android:layout_height="@dimen/dp_90"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="@dimen/dp_454"
        android:layout_height="@dimen/dp_90">
        <com.android.systemui.widget.BydImageView
            android:id="@+id/iv_wind_dec"
            android:layout_width="@dimen/dp_60"
            android:layout_height="@dimen/dp_60"
            android:src="@mipmap/icon_air_volume_small"/>
        <com.android.systemui.widget.WindLevelButton
            android:id="@+id/wind_level_pop_seekbar"
            android:layout_width="@dimen/dp_317"
            android:layout_height="@dimen/dp_26"
            android:scaleType="fitXY"
            app:maxLevel="7"/>
        <com.android.systemui.widget.BydImageView
            android:id="@+id/iv_wind_inc"
            android:layout_width="@dimen/dp_60"
            android:layout_height="@dimen/dp_60"
            android:src="@mipmap/icon_air_volume_big"
            android:layout_marginStart="@dimen/dp_6"/>
    </LinearLayout>
</RelativeLayout>
