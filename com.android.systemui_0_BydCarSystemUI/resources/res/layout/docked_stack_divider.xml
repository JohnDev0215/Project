<?xml version="1.0" encoding="utf-8"?>
<com.android.systemui.stackdivider.DividerView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/docked_divider_background"
        android:visibility="gone"
        style="@style/DockedDividerBackground"/>
    <com.android.systemui.stackdivider.MinimizedDockShadow
        android:id="@+id/minimized_dock_shadow"
        android:visibility="gone"
        android:alpha="0"
        style="@style/DockedDividerMinimizedShadow"/>
    <RelativeLayout style="@style/DockedDividerHandle">
        <com.android.systemui.stackdivider.DividerHandleView
            android:id="@+id/docked_divider_handle"
            style="@style/DockedDividerHandle"/>
        <ImageView
            android:src="@color/split_screen_bg"
            style="@style/DockedDividerHandleBg"/>
    </RelativeLayout>
    <com.android.systemui.stackdivider.view.DividerMoreButtonView
        android:id="@+id/divider_more_button"
        style="@style/DividerMoreButtonView"/>
</com.android.systemui.stackdivider.DividerView>
