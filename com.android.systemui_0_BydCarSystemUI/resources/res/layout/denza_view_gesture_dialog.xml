<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/rl_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">
    <ImageView
        android:id="@+id/iv_blur"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dp_56"
        android:scaleType="fitXY"/>
    <com.android.systemui.widget.GestureRelativeLayout
        android:id="@+id/rl_temp"
        android:background="@drawable/denza_shape_gesture_pop_bg"
        android:layout_width="@dimen/dp_148"
        android:layout_height="@dimen/dp_260"
        android:layout_marginTop="@dimen/gesture_temp_margin_top"
        android:layout_centerHorizontal="true">
        <ImageView
            android:layout_width="@dimen/dp_20"
            android:layout_height="@dimen/dp_30"
            android:src="@mipmap/img_gesture_ac_arrow_left"
            android:tint="@color/white"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"/>
        <ImageView
            android:layout_width="@dimen/dp_20"
            android:layout_height="@dimen/dp_30"
            android:src="@mipmap/img_gesture_ac_arrow_right"
            android:tint="@color/white"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
        <com.android.systemui.widget.WheelView
            android:gravity="center_horizontal"
            android:layout_gravity="center"
            android:id="@+id/wheel_view"
            android:layout_width="@dimen/dp_108"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            app:wh_float_text_size="@dimen/sp_32"
            app:wh_max_text_size="@dimen/sp_48"
            app:wh_min_text_size="@dimen/sp_40"
            app:wh_selected_text_color="@color/denza_color_navi_temp_set_text_sel"
            app:wh_text_color="@color/denza_color_navi_temp_set_text_nor"
            app:wh_text_space_ratio="2"/>
        <ImageView
            android:id="@+id/img_degree"
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_40"
            android:layout_marginRight="@dimen/dp_24"
            android:src="@mipmap/denza_img_gesture_ac_temperature_unit"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </com.android.systemui.widget.GestureRelativeLayout>
    <com.android.systemui.widget.GestureRelativeLayout
        android:id="@+id/rl_wind"
        android:background="@drawable/denza_shape_gesture_pop_bg"
        android:paddingLeft="@dimen/dp_12"
        android:paddingRight="@dimen/dp_12"
        android:layout_width="@dimen/dp_412"
        android:layout_height="@dimen/dp_96"
        android:layout_marginTop="@dimen/gesture_wind_margin_top"
        android:layout_centerHorizontal="true">
        <ImageView
            android:id="@+id/img"
            android:layout_width="@dimen/dp_24"
            android:layout_height="@dimen/dp_24"
            android:layout_marginRight="@dimen/dp_12"
            android:src="@mipmap/icon_gesture_ac_air_volume_fan"
            android:tint="@color/white"
            android:layout_centerVertical="true"/>
        <com.android.systemui.widget.BydTabLayout
            android:id="@+id/tablayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_toRightOf="@+id/img"
            app:tabIndicatorColor="@android:color/transparent"
            app:tabIndicatorHeight="@dimen/dp_0"
            app:tabMode="fixed"
            app:tabPaddingEnd="@dimen/dp_0"
            app:tabPaddingStart="@dimen/dp_0"
            app:tabRippleColor="@android:color/transparent"/>
    </com.android.systemui.widget.GestureRelativeLayout>
</RelativeLayout>
