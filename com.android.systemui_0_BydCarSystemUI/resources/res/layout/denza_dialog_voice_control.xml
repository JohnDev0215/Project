<?xml version="1.0" encoding="utf-8"?>
<com.android.systemui.shadow.ShadowLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:id="@+id/shadowLayout"
    android:layout_width="@dimen/dp_122"
    android:layout_height="@dimen/dp_316"
    app:bgColor="@color/denza_bg_shadow_layout"
    app:blurRadius="@dimen/dp_8"
    app:shadowColor="@color/denza_bg_shadow"
    app:shadowRadius="@dimen/dp_12"
    app:xOffset="0dp"
    app:yOffset="0dp">
    <RelativeLayout
        android:background="@drawable/denza_sysui_qs_volume_ui_content_bg"
        android:padding="@dimen/dp_0"
        android:layout_width="@dimen/dp_106"
        android:layout_height="@dimen/dp_300">
        <com.android.systemui.widget.VolumeUISeekBarContainer
            android:id="@+id/sysui_qs_seekbar_ringtone"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/dp_20"
            android:layout_centerHorizontal="true"/>
        <com.android.systemui.widget.VolumeUISeekBarContainer
            android:id="@+id/sysui_qs_seekbar_broadcast"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/dp_20"
            android:layout_centerHorizontal="true"/>
        <com.android.systemui.widget.VolumeUISeekBarContainer
            android:id="@+id/sysui_qs_seekbar_phone"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/dp_20"
            android:layout_centerHorizontal="true"/>
        <com.android.systemui.widget.VolumeUISeekBarContainer
            android:id="@+id/sysui_qs_seekbar_navigation"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/dp_20"
            android:layout_centerHorizontal="true"/>
        <com.android.systemui.widget.VolumeUISeekBarContainer
            android:id="@+id/sysui_qs_seekbar_voice"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/dp_20"
            android:layout_centerHorizontal="true"/>
        <com.android.systemui.widget.VolumeUISeekBarContainer
            android:id="@+id/sysui_qs_seekbar_media"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/dp_20"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
</com.android.systemui.shadow.ShadowLayout>
