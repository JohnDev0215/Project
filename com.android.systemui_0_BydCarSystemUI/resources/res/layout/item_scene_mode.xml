<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="@dimen/dp_194"
    android:layout_height="@dimen/dp_134">
    <RelativeLayout
        android:id="@+id/rl_content"
        android:background="@drawable/selector_scene_mode_bg"
        android:layout_width="@dimen/dp_156"
        android:layout_height="@dimen/dp_100"
        android:layout_marginTop="@dimen/dp_18"
        android:layout_centerHorizontal="true">
        <com.android.systemui.widget.BydImageView
            android:id="@+id/iv_item"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:layout_marginTop="@dimen/dp_32"
            android:src="@mipmap/icon_scene_baby"
            android:layout_centerInParent="true"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/color_scene_mode"
            android:id="@+id/tv_item"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_10"
            android:layout_marginTop="@dimen/dp_8"/>
    </RelativeLayout>
    <ImageView
        android:id="@+id/iv_custom"
        android:visibility="gone"
        android:layout_width="@dimen/dp_24"
        android:layout_height="@dimen/dp_24"
        android:layout_marginLeft="@dimen/dp_12_"
        android:layout_marginTop="@dimen/dp_8"
        android:src="@mipmap/icon_scene_custom"
        android:layout_toRightOf="@+id/rl_content"/>
</RelativeLayout>
