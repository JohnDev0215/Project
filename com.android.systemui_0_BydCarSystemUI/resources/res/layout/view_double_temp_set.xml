<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/transparent_00"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layoutDirection="ltr">
    <RelativeLayout
        android:background="@drawable/shape_navi_bar_air_pop_bg"
        android:layout_width="@dimen/dp_380"
        android:layout_height="@dimen/dp_154">
        <com.byd.card.widget.BlurView
            android:id="@+id/blurView"
            android:layout_width="@dimen/dp_380"
            android:layout_height="@dimen/dp_154"/>
        <RelativeLayout
            android:id="@+id/rl_separate"
            android:background="@drawable/shape_hvac_set_temp_pop_btn_bg"
            android:layout_width="@dimen/dp_120"
            android:layout_height="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_16"
            android:layout_centerHorizontal="true">
            <com.android.systemui.widget.BydImageView
                android:gravity="center"
                android:id="@+id/tvDual"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@mipmap/icon_separate"
                android:layout_centerInParent="true"
                app:bg_tint_color="@color/bg_qs_item_tint"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="8dp"
            android:layout_below="@+id/rl_separate">
            <com.android.systemui.widget.BydImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_set_temp_reduction"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:src="@mipmap/icon_air_temperature_reduction_horizontal"
                android:layout_marginStart="@dimen/dp_17"
                app:clickChangeColor="false"/>
            <com.android.systemui.widget.HorizontalWheelView
                android:layout_gravity="center_vertical"
                android:id="@+id/wheel_view"
                android:layout_width="@dimen/dp_242"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_4"/>
            <com.android.systemui.widget.BydImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_set_temp_rise"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:src="@mipmap/icon_air_temperature_rise_horizontal"
                android:layout_marginStart="@dimen/dp_4"
                app:clickChangeColor="false"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
