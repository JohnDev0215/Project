<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/shape_navi_bar_air_pop_bg"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layoutDirection="ltr">
    <RelativeLayout
        android:layout_width="@dimen/dp_340"
        android:layout_height="@dimen/dp_90">
        <com.byd.card.widget.BlurView
            android:id="@+id/blurView"
            android:layout_width="@dimen/dp_340"
            android:layout_height="@dimen/dp_90"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.android.systemui.widget.BydImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_set_temp_reduction"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:src="@mipmap/icon_air_temperature_reduction_horizontal"
                app:clickChangeColor="false"/>
            <SeekBar
                android:layout_gravity="center_vertical"
                android:id="@+id/eaac_pop_seekbar"
                android:background="@null"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:layout_width="@dimen/dp_210"
                android:layout_height="@dimen/dp_50"
                android:max="33"
                android:progress="25"
                android:progressDrawable="@mipmap/img_dock_ecc_window_on_bg"
                android:thumb="@mipmap/img_dock_ecc_window_off_needle"
                android:thumbOffset="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:min="17"/>
            <com.android.systemui.widget.BydImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_set_temp_rise"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:src="@mipmap/icon_air_temperature_rise_horizontal"
                app:clickChangeColor="false"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
