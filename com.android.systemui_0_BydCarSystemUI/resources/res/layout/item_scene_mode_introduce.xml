<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/rl_content"
        android:background="@drawable/selector_scene_mode_bg"
        android:layout_width="@dimen/dp_156"
        android:layout_height="@dimen/dp_100">
        <ImageView
            android:id="@+id/iv_item"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:layout_marginTop="@dimen/dp_32"
            android:src="@mipmap/icon_scene_baby"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/panel_scene_introduce_item_margin"
        android:layout_toEndOf="@+id/rl_content">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/color_scene_mode"
            android:id="@+id/tv_item"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"
            android:layout_alignParentTop="true"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/color_scene_introduce_content"
            android:gravity="start|bottom"
            android:id="@+id/tv_content"
            android:paddingBottom="@dimen/dp_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:layout_below="@+id/tv_item"
            android:textAlignment="viewStart"
            android:layoutDirection="locale"/>
    </RelativeLayout>
</RelativeLayout>
