<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/launcher_add_app_bg_land"
    android:layout_width="@dimen/dp_616"
    android:layout_height="@dimen/dp_528">
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="@color/launcher_add_app_title"
        android:gravity="center"
        android:id="@+id/add_app_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_71"
        android:text="@string/add_to_folder"/>
    <View
        android:background="@color/card_allapp_divider_size"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <androidx.recyclerview.widget.RecyclerView
                android:scrollbarThumbVertical="@color/app_center_scrollbar"
                android:scrollbarTrackVertical="@color/app_center_scrollbar_track"
                android:id="@+id/add_content"
                android:scrollbars="vertical"
                android:fadingEdgeLength="@dimen/dp_28"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_352"
                android:scrollbarFadeDuration="@integer/scroll_view_duration"
                android:overScrollMode="never"
                android:requiresFadingEdge="vertical"
                android:layout_marginEnd="@dimen/dp_10"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="4"/>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_104">
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/launcher_cancel"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/add_cancel"
                android:background="@drawable/launcher_clear_data_dialog_cancel_bg"
                android:layout_width="@dimen/dp_176"
                android:layout_height="@dimen/dp_48"
                android:text="@string/cancel"
                android:layout_marginEnd="@dimen/dp_24"
                android:elevation="@dimen/dp_2"
                android:stateListAnimator="@drawable/anim_btn_scale_alpha"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/add_confirm"
                android:background="@drawable/add_app_sure_btn_bg"
                android:layout_width="@dimen/dp_176"
                android:layout_height="@dimen/dp_48"
                android:text="@string/confirm"
                android:layout_marginStart="@dimen/dp_24"
                android:elevation="@dimen/dp_2"
                android:stateListAnimator="@drawable/anim_btn_scale_alpha"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
