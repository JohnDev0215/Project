<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_app_item"
    android:layout_width="@dimen/dp_136"
    android:layout_height="@dimen/dp_125">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card_app_cl"
        android:background="@mipmap/denza_img_card_bg_addapp"
        android:layout_width="@dimen/dp_120"
        android:layout_height="@dimen/dp_100"
        android:layout_marginTop="@dimen/dp_26">
        <ImageView
            android:id="@+id/card_app_icon"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:layout_marginTop="@dimen/dp_14"
            android:layout_marginStart="@dimen/dp_36"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/denza_app_name"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/card_app_name"
            android:layout_width="@dimen/dp_94"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_66"
            android:singleLine="true"
            android:layout_marginStart="@dimen/dp_13"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/card_delete"
        android:visibility="visible"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_6"
        android:src="@mipmap/denza_card_delete"
        android:layout_marginStart="@dimen/dp_88"/>
</RelativeLayout>
