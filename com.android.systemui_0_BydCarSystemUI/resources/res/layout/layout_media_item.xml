<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:focusable="true"
    android:clickable="true"
    android:descendantFocusability="afterDescendants"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_40">
    <CheckBox
        android:id="@+id/cb_media"
        android:background="@drawable/selector_multi_grid"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_40"
        android:button="@null"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="@color/selector_title_optional"
        android:id="@+id/tv_media"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/media_volume"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/cb_media"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_30"
        android:textColor="@color/selector_text_highlight"
        android:id="@+id/tv_volume"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp_14"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/sb_volume"
        app:layout_constraintTop_toTopOf="parent"/>
    <SeekBar
        android:id="@+id/sb_volume"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="@dimen/dp_318"
        android:layout_height="@dimen/dp_40"
        android:max="39"
        android:progressDrawable="@drawable/selector_seekbar_track"
        android:thumb="@drawable/seekbar_thumb"
        android:paddingStart="@dimen/dp_10"
        android:paddingEnd="@dimen/dp_10"
        android:min="0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
