<?xml version="1.0" encoding="utf-8"?>
<com.android.systemui.ObservableView xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="end|center_vertical"
    android:orientation="horizontal"
    android:id="@+id/statusIcons"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:minWidth="@dimen/dp_16">
    <ImageView
        android:id="@+id/sysui_icon_more"
        android:visibility="gone"
        android:layout_width="@dimen/dp_16"
        android:src="@mipmap/icon_status_bar_more"
        style="@style/status_bar_button_general_icon"/>
    <ImageView
        android:id="@+id/sysui_icon_camera"
        android:visibility="gone"
        android:layout_width="@dimen/dp_16"
        android:src="@mipmap/icon_status_bar_camera"
        style="@style/status_bar_button_general_icon"/>
    <ImageView
        android:id="@+id/sysui_icon_mic"
        android:visibility="gone"
        android:layout_width="@dimen/dp_12"
        android:src="@mipmap/icon_status_bar_mic"
        style="@style/status_bar_button_general_icon"/>
    <ImageView
        android:id="@+id/sysui_icon_wireless_charging_left"
        android:visibility="gone"
        android:layout_width="@dimen/dp_24"
        android:src="@mipmap/icon_status_bar_charging_left_0"
        style="@style/status_bar_button_general_icon"/>
    <ImageView
        android:id="@+id/sysui_icon_wireless_charging"
        android:visibility="gone"
        android:layout_width="@dimen/dp_24"
        android:src="@mipmap/icon_status_bar_battery_charging_0"
        style="@style/status_bar_button_general_icon"/>
    <ImageView
        android:id="@+id/sysui_icon_wireless_charging_right"
        android:visibility="gone"
        android:layout_width="@dimen/dp_24"
        android:src="@mipmap/icon_status_bar_charging_right_0"
        style="@style/status_bar_button_general_icon"/>
    <ImageView
        android:id="@+id/sysui_icon_mute"
        android:visibility="gone"
        android:layout_width="@dimen/dp_18"
        android:src="@mipmap/icon_status_bar_mute"
        style="@style/status_bar_button_general_icon"/>
    <ImageView
        android:id="@+id/sysui_icon_usb"
        android:visibility="gone"
        android:layout_width="@dimen/dp_20"
        android:src="@mipmap/icon_status_bar_usb"
        style="@style/status_bar_button_general_icon"/>
    <ImageView
        android:id="@+id/sysui_icon_sdcard"
        android:visibility="gone"
        android:layout_width="@dimen/dp_16"
        android:src="@mipmap/icon_status_bar_sdcard_warm"
        style="@style/status_bar_button_general_icon"/>
    <ImageView
        android:id="@+id/sysui_icon_ota"
        android:visibility="gone"
        android:layout_width="@dimen/dp_26"
        android:src="@mipmap/icon_status_bar_ota"
        style="@style/status_bar_button_general_icon"/>
    <ImageView
        android:id="@+id/sysui_icon_dvr"
        android:visibility="gone"
        android:layout_width="@dimen/dp_24"
        android:src="@mipmap/icon_status_bar_dvr_error"
        style="@style/status_bar_button_general_icon"/>
    <ImageView
        android:id="@+id/sysui_icon_show_mode"
        android:visibility="gone"
        android:layout_width="@dimen/dp_24"
        android:src="@mipmap/icon_status_bar_indoor_mode"
        style="@style/status_bar_button_general_icon"/>
</com.android.systemui.ObservableView>
