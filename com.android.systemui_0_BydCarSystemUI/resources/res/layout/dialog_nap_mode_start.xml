<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:background="@color/bg_fullscreen_dialog"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/bg_dialog"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="@dimen/dp_560"
        android:layout_height="@dimen/dp_560"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <include layout="@layout/layout_dialog_header"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_72"
            app:layout_constraintTop_toTopOf="parent">
            <com.byd.profile.view.NumberPickerView
                android:id="@+id/duration_picker"
                android:layout_width="@dimen/dp_522"
                android:layout_height="@dimen/dp_320"
                android:layout_marginTop="@dimen/dp_14"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:npv_ShownCount="5"
                app:npv_TextColorHint="@color/text_rest_tip"
                app:npv_TextColorNormal="@color/text_option"
                app:npv_TextColorSelected="@color/text_title"
                app:npv_TextSizeNormal="@dimen/sp_24"
                app:npv_TextSizeSelected="@dimen/sp_24"/>
            <View
                android:background="@color/rest_time_hint"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_64"
                app:layout_constraintTop_toTopOf="@+id/duration_picker"/>
            <View
                android:background="@color/rest_time_hint"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_64"
                app:layout_constraintBottom_toBottomOf="@+id/duration_picker"/>
            <View
                android:background="@color/divider"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_1"
                android:layout_marginTop="@dimen/dp_77"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:background="@color/divider"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_1"
                android:layout_marginTop="@dimen/dp_140"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:background="@color/divider"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_1"
                android:layout_marginTop="@dimen/dp_203"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:background="@color/divider"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_1"
                android:layout_marginTop="@dimen/dp_266"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/text_main"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_40"
                android:text="@string/rest_duration_tip"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/duration_picker"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/text_main"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_164"
                android:text="@string/unit_minute"
                android:layout_marginStart="@dimen/dp_327"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <include layout="@layout/layout_buttons"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
