<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/system_ui_transport_mode_dialog_background"
    android:layout_width="@dimen/dp_560"
    android:layout_height="@dimen/wrap_content">
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="@color/dialog_transport_mode_text_color"
        android:gravity="center"
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_71"
        android:text="@string/set_auto_power_off_node_for_p_gear"
        android:layout_centerHorizontal="true"/>
    <View
        android:id="@+id/titleLine"
        android:background="@color/dialog_transport_mode_line_color"
        android:layout_width="@dimen/dp_560"
        android:layout_height="1dp"
        android:layout_below="@+id/tvTitle"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_open_transport_mode"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_239"
        android:layout_below="@+id/titleLine">
        <RelativeLayout
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_54">
            <SeekBar
                android:layout_gravity="center_vertical"
                android:id="@+id/seekbar"
                android:layout_width="@dimen/dp_431"
                android:layout_height="@dimen/dp_20"
                android:max="70"
                android:progress="35"
                android:progressDrawable="@drawable/transport_mode_seekbar_background"
                android:thumb="@drawable/transport_mode_seekbar_thumb"
                android:paddingStart="@dimen/dp_10"
                android:paddingEnd="@dimen/dp_10"
                android:min="30"/>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/seekbar"
                android:layout_alignBottom="@+id/seekbar"
                android:layout_alignStart="@+id/seekbar"
                android:layout_alignEnd="@+id/seekbar">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/ivSeekBarScale_1"
                    android:background="@color/seek_bar_background_progress_scale_bright_color"
                    android:layout_width="@dimen/dp_1"
                    android:layout_height="@dimen/dp_4"
                    android:layout_marginStart="@dimen/dp_11"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/ivSeekBarScale_2"
                    android:background="@color/seek_bar_background_progress_scale_bright_color"
                    android:layout_width="@dimen/dp_1"
                    android:layout_height="@dimen/dp_4"
                    android:layout_marginStart="@dimen/dp_100"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/ivSeekBarScale_3"
                    android:background="@color/seek_bar_background_progress_scale_bright_color"
                    android:layout_width="@dimen/dp_1"
                    android:layout_height="@dimen/dp_4"
                    android:layout_marginStart="@dimen/dp_102"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/ivSeekBarScale_4"
                    android:background="@color/seek_bar_background_progress_scale_bright_color"
                    android:layout_width="@dimen/dp_1"
                    android:layout_height="@dimen/dp_4"
                    android:layout_marginStart="@dimen/dp_101"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/ivSeekBarScale_5"
                    android:background="@color/seek_bar_background_progress_scale_bright_color"
                    android:layout_width="@dimen/dp_1"
                    android:layout_height="@dimen/dp_4"
                    android:layout_marginStart="@dimen/dp_100"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_2"
                android:layout_below="@+id/seekbar"
                android:layout_alignStart="@+id/seekbar"
                android:layout_alignEnd="@+id/seekbar">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_2">
                    <TextView
                        android:textSize="@dimen/sp_20"
                        android:textColor="@color/dialog_transport_mode_scale_text_color"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="30"/>
                    <TextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="@color/dialog_transport_mode_scale_text_color"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="%"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_56">
                    <TextView
                        android:textSize="@dimen/sp_20"
                        android:textColor="@color/dialog_transport_mode_scale_text_color"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="40"/>
                    <TextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="@color/dialog_transport_mode_scale_text_color"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="%"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_66">
                    <TextView
                        android:textSize="@dimen/sp_20"
                        android:textColor="@color/dialog_transport_mode_scale_text_color"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="50"/>
                    <TextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="@color/dialog_transport_mode_scale_text_color"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="%"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_66">
                    <TextView
                        android:textSize="@dimen/sp_20"
                        android:textColor="@color/dialog_transport_mode_scale_text_color"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="60"/>
                    <TextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="@color/dialog_transport_mode_scale_text_color"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="%"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_66">
                    <TextView
                        android:textSize="@dimen/sp_20"
                        android:textColor="@color/dialog_transport_mode_scale_text_color"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="70"/>
                    <TextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="@color/dialog_transport_mode_scale_text_color"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="%"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_12"
                android:layout_toEndOf="@+id/seekbar">
                <TextView
                    android:textSize="@dimen/sp_37"
                    android:textColor="@color/dialog_transport_mode_cnt_progress_text_color"
                    android:id="@+id/tvCntProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="30"/>
                <TextView
                    android:textSize="@dimen/sp_20"
                    android:textColor="@color/dialog_transport_mode_cnt_progress_text_color"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="%"/>
            </LinearLayout>
        </RelativeLayout>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/dialog_hvac_system_text_color"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tvOpenTransportConfirmBtn"
            android:background="@drawable/shape_transport_mode_button_bg"
            android:layout_width="@dimen/dp_176"
            android:layout_height="@dimen/dp_48"
            android:layout_marginTop="@dimen/dp_51"
            android:text="@string/confirm"/>
    </LinearLayout>
</RelativeLayout>
