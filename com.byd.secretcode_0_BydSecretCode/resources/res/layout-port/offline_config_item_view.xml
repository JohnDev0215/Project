<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_50">
    <TextView
        android:textSize="@dimen/text_size_18sp"
        android:textColor="@color/text_color"
        android:id="@+id/config_item_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="0.5"/>
    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="4.5">
        <RadioGroup
            android:orientation="horizontal"
            android:id="@+id/config_item_radiogroup"
            android:background="@drawable/shape_bg_gray_radio_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.byd.secretcode.view.TintRadioButton
                android:id="@+id/config_item_radioitem0"
                style="@style/rbtn_3_display_pager"/>
            <com.byd.secretcode.view.TintRadioButton
                android:id="@+id/config_item_radioitem1"
                style="@style/rbtn_3_display_pager"/>
            <com.byd.secretcode.view.TintRadioButton
                android:id="@+id/config_item_radioitem2"
                style="@style/rbtn_3_display_pager"/>
            <com.byd.secretcode.view.TintRadioButton
                android:id="@+id/config_item_radioitem3"
                style="@style/rbtn_3_display_pager"/>
        </RadioGroup>
        <com.byd.secretcode.view.BydSwitch
            android:id="@+id/config_item_switch"
            android:background="@mipmap/img_switch_bg_normal"
            android:focusable="true"
            android:layout_width="@dimen/dp_64"
            android:layout_height="@dimen/dp_48"
            android:thumb="@null"
            app:splitTrack="true"
            app:switchMinWidth="@dimen/dp_56"
            app:thumbTintMode="src_over"
            app:track="@color/transparent_00"
            app:trackTint="@color/transparent_00"/>
        <Spinner
            android:textSize="@dimen/text_size_28sp"
            android:id="@+id/config_item_spinner"
            android:layout_width="@dimen/dp_150"
            android:layout_height="wrap_content"
            android:dropDownWidth="@dimen/dp_150"/>
    </RelativeLayout>
    <TextView
        android:textSize="@dimen/text_size_18sp"
        android:textColor="@color/offline_config_text_color"
        android:id="@+id/config_item_content"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2"/>
    <TextView
        android:textSize="@dimen/text_size_18sp"
        android:textColor="@color/offline_config_text_color"
        android:id="@+id/config_item_note"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="3"/>
</LinearLayout>
