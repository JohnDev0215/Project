<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/offline_config_pwd_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_40">
        <TextView
            android:textSize="@dimen/text_size_22sp"
            android:textColor="@color/text_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/offline_config_app_name"/>
        <EditText
            android:textSize="@dimen/text_size_22sp"
            android:id="@+id/offline_config_password"
            android:paddingLeft="@dimen/dp_10"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:hint="@string/offline_config_password_text"/>
        <Button
            android:textSize="@dimen/text_size_22sp"
            android:textColor="@color/text_color"
            android:id="@+id/offline_config_enter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/offline_config_enter_text"/>
        <TextView
            android:textSize="@dimen/text_size_22sp"
            android:textColor="@color/text_color"
            android:id="@+id/offline_config_enter_tip_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/offline_config_password_remarks"
            android:layout_marginStart="@dimen/dp_10"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/offline_config_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_10"
        android:layout_below="@+id/offline_config_pwd_layout">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/offline_config_data_change_layout"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <Button
                android:textSize="@dimen/text_size_22sp"
                android:textColor="@color/text_color"
                android:id="@+id/offline_config_data_change_modify_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/offline_config_modify_text"/>
            <Button
                android:textSize="@dimen/text_size_22sp"
                android:textColor="@color/text_color"
                android:id="@+id/offline_config_data_change_reset_btn"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/offline_config_reset_text"/>
            <TextView
                android:textSize="@dimen/text_size_22sp"
                android:textColor="@color/offline_config_text_change_color"
                android:id="@+id/offline_config_data_change_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <ListView
            android:id="@+id/offline_config_list_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/dp_10"
            android:layout_marginBottom="@dimen/dp_70"/>
        <TextView
            android:textSize="@dimen/text_size_22sp"
            android:textColor="@color/text_color"
            android:id="@+id/offline_config_data"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"/>
    </LinearLayout>
</RelativeLayout>
