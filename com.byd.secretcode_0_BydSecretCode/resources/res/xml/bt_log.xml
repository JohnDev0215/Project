    android:layout_height="wrap_content">
    <CheckBoxPreference
        android:title="@string/str_bt_enable_disable"
        android:key="BYDBluetoothLogCheckBox"
        android:summary="@string/str_bt_enable_disable_msg"/>
    <Preference
        android:title="@string/str_savebtlog"
        android:key="BYDSaveBluetoothLog"/>
    <CheckBoxPreference
