<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/sp_24"
        android:gravity="center_horizontal"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_100"
        android:text="@string/str_sound_source_title"/>
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@+id/vertical_linear"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginTop="@dimen/dp_50"
        android:layout_below="@+id/title">
        <EditText
            android:textSize="@dimen/sp_20"
            android:id="@+id/et_vol_gain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:maxLength="4"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/tv_gain_db"/>
        <Spinner
            android:textSize="@dimen/sp_24"
            android:id="@+id/spinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:layout_below="@+id/sound_source_type"
            android:layout_marginStart="@dimen/dp_150"/>
        <TextView
            android:textSize="@dimen/sp_20"
            android:id="@+id/tv_set_gain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_sound_source_gain_set"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/et_vol_gain"/>
        <TextView
            android:textSize="@dimen/sp_20"
            android:id="@+id/sound_source_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_sound_source_type_select"
            android:layout_marginStart="@dimen/dp_150"/>
        <TextView
            android:textSize="@dimen/sp_20"
            android:id="@+id/tv_gain_db"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_sound_source_db_value"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp_150"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="@dimen/sp_20"
        android:id="@+id/tv_get_vol_gain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_30"
        android:layout_below="@+id/vertical_linear"
        android:layout_centerInParent="true"/>
    <RelativeLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginBottom="@dimen/dp_150"
        android:layout_alignParentBottom="true">
        <Button
            android:textSize="@dimen/sp_20"
            android:id="@+id/bt_activate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_sound_source_activate"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/dp_150"/>
        <Button
            android:textSize="@dimen/sp_20"
            android:id="@+id/bt_exit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_sound_source_exit"
            android:layout_centerInParent="true"
            android:layout_marginStart="@dimen/dp_400"/>
        <Button
            android:textSize="@dimen/sp_20"
            android:id="@+id/bt_get_vol_gain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_sound_source_check"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/dp_400"
            android:layout_marginEnd="@dimen/dp_150"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</RelativeLayout>
