<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/dialog_countyr_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/text_size_25sp"
        android:textColor="@color/dicare_remind_dialog_disable_color"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_20"
        android:text="@string/country_warning"/>
    <TextView
        android:textSize="@dimen/text_size_20sp"
        android:textColor="@color/dicare_remind_dialog_disable_color"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_10"
        android:layout_marginRight="@dimen/dp_40"
        android:text="@string/country_tx"/>
    <TextView
        android:textSize="@dimen/text_size_20sp"
        android:textColor="@color/dicare_remind_dialog_disable_color"
        android:layout_gravity="center_horizontal"
        android:id="@+id/country_code_tx"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_10"
        android:layout_marginRight="@dimen/dp_40"/>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="2">
        <Button
            android:textSize="@dimen/text_size_20sp"
            android:textColor="@color/white"
            android:id="@+id/country_cancel"
            android:background="@drawable/dialog_country_cancel_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_40"
            android:text="@string/cancel"
            android:layout_weight="1"/>
        <Button
            android:textSize="@dimen/text_size_20sp"
            android:textColor="@color/dialog_ok_color"
            android:id="@+id/country_confirm"
            android:background="@drawable/dialog_country_ok_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_40"
            android:text="@string/confirm"
            android:layout_weight="1"
            android:layout_toRightOf="@+id/country_cancel"/>
    </LinearLayout>
</LinearLayout>
