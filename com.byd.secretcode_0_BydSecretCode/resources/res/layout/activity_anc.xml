<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/ll_layout"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="@dimen/text_size_32sp"
            android:textColor="@color/black"
            android:id="@+id/tv_miyao"
            android:layout_width="@dimen/dp_368"
            android:layout_height="wrap_content"
            android:text="@string/str_miyao"/>
        <EditText
            android:textSize="@dimen/text_size_32sp"
            android:id="@+id/et_miyao"
            android:layout_width="@dimen/dp_368"
            android:layout_height="@dimen/dp_100"
            android:layout_marginTop="@dimen/dp_40"
            android:hint="@string/str_please_enter_password"
            android:inputType="textPassword"/>
        <Button
            android:textSize="@dimen/text_size_28sp"
            android:id="@+id/ok_btn_anc"
            android:layout_width="@dimen/dp_150"
            android:layout_height="@dimen/dp_70"
            android:layout_marginTop="@dimen/dp_40"
            android:text="@string/confirm"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/rl_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:id="@+id/tv_anc_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_100"
            android:text="@string/str_anc_switch"
            android:layout_marginStart="@dimen/dp_28"/>
        <CheckBox
            android:id="@+id/checkBox_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_100"
            android:text=""
            android:layout_alignParentTop="true"
            android:layout_marginStart="@dimen/dp_191"
            android:layout_alignParentStart="true"/>
        <CheckBox
            android:id="@+id/checkBox_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_160"
            android:text=""
            android:layout_alignParentTop="true"
            android:layout_marginStart="@dimen/dp_191"
            android:layout_alignParentStart="true"/>
        <TextView
            android:id="@+id/textView12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_237"
            android:text="@string/str_anc_1"
            android:layout_alignParentTop="true"
            android:layout_marginStart="@dimen/dp_181"
            android:layout_alignParentStart="true"/>
        <EditText
            android:id="@+id/et_start_speed_1"
            android:layout_width="@dimen/dp_100"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_90"
            android:maxLength="6"
            android:layout_alignParentTop="true"
            android:inputType="number"
            android:layout_marginStart="298dp"
            android:layout_alignParentStart="true"/>
        <EditText
            android:id="@+id/et_end_speed_2"
            android:layout_width="@dimen/dp_100"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_90"
            android:maxLength="6"
            android:layout_alignParentTop="true"
            android:inputType="number"
            android:layout_marginStart="500dp"
            android:layout_alignParentStart="true"/>
        <EditText
            android:id="@+id/et_start_speed_3"
            android:layout_width="@dimen/dp_100"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_160"
            android:maxLength="6"
            android:layout_alignParentTop="true"
            android:inputType="number"
            android:layout_marginStart="297dp"
            android:layout_alignParentStart="true"/>
        <EditText
            android:id="@+id/et_end_speed_4"
            android:layout_width="@dimen/dp_100"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_160"
            android:maxLength="6"
            android:layout_alignParentTop="true"
            android:inputType="number"
            android:layout_marginStart="500dp"
            android:layout_alignParentStart="true"/>
        <TextView
            android:id="@+id/textView13"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_237"
            android:text="@string/str_anc_2"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="300dp"
            android:layout_alignParentStart="true"/>
        <TextView
            android:id="@+id/textView14"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_237"
            android:text="@string/str_anc_3"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="@dimen/dp_500"
            android:layout_alignParentStart="true"/>
        <TextView
            android:id="@+id/tv_anc_app_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_300"
            android:text="@string/str_anc_app_version"
            android:layout_alignParentTop="true"
            android:layout_marginStart="@dimen/dp_28"
            android:layout_alignParentStart="true"/>
        <TextView
            android:id="@+id/tv_anc_data_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_350"
            android:text="@string/str_anc_data_version"
            android:layout_alignParentTop="true"
            android:layout_marginStart="@dimen/dp_28"
            android:layout_alignParentStart="true"/>
    </RelativeLayout>
</LinearLayout>
