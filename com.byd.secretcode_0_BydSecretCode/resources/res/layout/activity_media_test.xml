<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_60">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="sdcard/test/CHANNEL_IN_STEREO16000.pcm"/>
        <Button
            android:id="@+id/btn_play"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/play_btn"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="setDenoise mode"/>
        <EditText
            android:id="@+id/mode_edit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="@string/mode_hint_text"
            android:inputType="number"/>
        <Button
            android:id="@+id/btn_setdenoise_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/set_denoise_mode"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MediaPlayer play mp3 file"/>
        <Button
            android:id="@+id/btn_mp_mp3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/play_btn"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <EditText
            android:id="@+id/frame_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="@string/frame_time_ms"
            android:inputType="number"/>
        <Button
            android:id="@+id/save_bitmap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/save_bitmap_tx"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RadioGroup
            android:orientation="vertical"
            android:id="@+id/sample_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <RadioButton
                android:id="@+id/sample8_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="8k"/>
            <RadioButton
                android:id="@+id/sample16_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="16k"/>
            <RadioButton
                android:id="@+id/sample48_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="48k"/>
        </RadioGroup>
        <RadioGroup
            android:orientation="vertical"
            android:id="@+id/channel_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <RadioButton
                android:id="@+id/channelmono_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MONO"/>
            <RadioButton
                android:id="@+id/channelstereo_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="STEREO"/>
            <RadioButton
                android:id="@+id/channelequad_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="QUAD"/>
            <RadioButton
                android:id="@+id/channel5point1_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="5POINT1"/>
        </RadioGroup>
        <RadioGroup
            android:orientation="vertical"
            android:id="@+id/bit_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <RadioButton
                android:id="@+id/bit8_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="8bit"/>
            <RadioButton
                android:id="@+id/bit16_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="16bit"/>
        </RadioGroup>
        <Button
            android:id="@+id/audiorecord_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/start_btn"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:id="@+id/co_audiorecord_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/start_btn"
            android:layout_weight="1"/>
        <RadioGroup
            android:orientation="vertical"
            android:id="@+id/co_channel_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <RadioButton
                android:id="@+id/co_channelmono_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MONO"/>
            <RadioButton
                android:id="@+id/co_channelstereo_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="STEREO"/>
        </RadioGroup>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/mdlog_edit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mdlog_description"
            android:hint="@string/mode_hint_text"/>
        <Button
            android:id="@+id/mdlog_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/start_btn"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
