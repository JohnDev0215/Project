<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:background="@drawable/dialog_bg_shape"
    android:layout_width="@dimen/dp_560"
    android:layout_height="@dimen/dp_264">
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="@color/white_D9DAE1EB"
        android:gravity="center"
        android:layout_width="@dimen/dp_560"
        android:layout_height="@dimen/dp_58"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="40dp"
        android:text="@string/obd_text_1"
        app:layout_constraintBottom_toTopOf="@+id/bt_not_enough_open"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <Button
        android:textSize="@dimen/sp_18"
        android:textColor="@color/white_D9DAE1EB"
        android:id="@+id/bt_not_enough_open"
        android:background="@drawable/dialog_button_bg_selector"
        android:layout_width="@dimen/dp_150"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="140dp"
        android:layout_marginBottom="40dp"
        android:text="@string/obd_confirm"
        android:layout_marginStart="100dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <Button
        android:textSize="@dimen/sp_18"
        android:textColor="@color/white_D9DAE1EB"
        android:id="@+id/bt_not_enough_exit"
        android:background="@drawable/dialog_button_bg_selector"
        android:layout_width="@dimen/dp_150"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="140dp"
        android:layout_marginBottom="40dp"
        android:text="@string/cancel"
        android:layout_marginStart="190dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/bt_not_enough_open"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
