<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_80">
        <com.byd.secretcode.view.MultiSpinner
            android:gravity="center"
            android:id="@+id/mulSpinner"
            android:background="@drawable/edittext_bg"
            android:layout_width="@dimen/dp_300"
            android:layout_height="@dimen/dp_50"
            android:minHeight="45dp"
            android:hint="@string/obd_selection_2"
            android:layout_marginStart="70dp"/>
        <Button
            android:id="@+id/bt_id_confirm"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_60"
            android:text="@string/obd_confirm"
            android:layout_marginStart="40dp"/>
        <Button
            android:id="@+id/bt_id_reset"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_60"
            android:text="@string/obd_reset"
            android:layout_marginStart="40dp"/>
    </LinearLayout>
    <RelativeLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/rl_smart_entry"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_50"
        android:layout_marginTop="@dimen/dp_10">
        <TextView
            android:textSize="@dimen/sp_25"
            android:gravity="center"
            android:id="@+id/textView2"
            android:layout_width="@dimen/dp_150"
            android:layout_height="match_parent"
            android:text="@string/obd_smart_entry"
            android:layout_marginStart="70dp"/>
        <ImageView
            android:id="@+id/imageview1"
            android:background="@drawable/edittext_bg"
            android:clickable="false"
            android:layout_width="@dimen/dp_250"
            android:layout_height="@dimen/dp_50"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@+id/textView2"/>
        <EditText
            android:ellipsize="start"
            android:id="@+id/edittext_smart_entry"
            android:background="@null"
            android:longClickable="false"
            android:layout_width="@dimen/dp_200"
            android:layout_height="@dimen/dp_50"
            android:hint=""
            android:ems="10"
            android:singleLine="true"
            android:imeOptions="actionDone"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@+id/textView2"/>
        <ImageButton
            android:id="@+id/iv_smart_entry_del"
            android:background="@drawable/obd_del_selector"
            android:layout_width="@dimen/dp_40"
            android:layout_height="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_5"
            android:layout_marginStart="220dp"
            android:layout_toEndOf="@+id/textView2"/>
    </RelativeLayout>
    <RelativeLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/rl_car_body"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_50"
        android:layout_marginTop="@dimen/dp_10">
        <TextView
            android:textSize="@dimen/sp_25"
            android:gravity="center"
            android:id="@+id/textView3"
            android:layout_width="@dimen/dp_150"
            android:layout_height="match_parent"
            android:text="@string/obd_car_body"
            android:layout_marginStart="70dp"/>
        <ImageView
            android:id="@+id/imageview2"
            android:background="@drawable/edittext_bg"
            android:clickable="false"
            android:layout_width="@dimen/dp_250"
            android:layout_height="@dimen/dp_50"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@+id/textView3"/>
        <EditText
            android:ellipsize="start"
            android:id="@+id/edittext_car_body"
            android:background="@null"
            android:longClickable="false"
            android:layout_width="@dimen/dp_200"
            android:layout_height="@dimen/dp_50"
            android:hint=""
            android:ems="10"
            android:singleLine="true"
            android:imeOptions="actionDone"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@+id/textView3"/>
        <ImageButton
            android:id="@+id/iv_car_body_del"
            android:background="@drawable/obd_del_selector"
            android:layout_width="@dimen/dp_40"
            android:layout_height="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_5"
            android:layout_marginStart="220dp"
            android:layout_toEndOf="@+id/textView3"/>
    </RelativeLayout>
    <RelativeLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/rl_energy"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_50"
        android:layout_marginTop="@dimen/dp_10">
        <TextView
            android:textSize="@dimen/sp_25"
            android:gravity="center"
            android:id="@+id/textView4"
            android:layout_width="@dimen/dp_150"
            android:layout_height="match_parent"
            android:text="@string/obd_energy"
            android:layout_marginStart="70dp"/>
        <ImageView
            android:id="@+id/imageview3"
            android:background="@drawable/edittext_bg"
            android:clickable="false"
            android:layout_width="@dimen/dp_250"
            android:layout_height="@dimen/dp_50"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@+id/textView4"/>
        <EditText
            android:ellipsize="start"
            android:id="@+id/edittext_energy"
            android:background="@null"
            android:longClickable="false"
            android:layout_width="@dimen/dp_200"
            android:layout_height="@dimen/dp_50"
            android:hint=""
            android:ems="10"
            android:singleLine="true"
            android:imeOptions="actionDone"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@+id/textView4"/>
        <ImageButton
            android:id="@+id/iv_energy_del"
            android:background="@drawable/obd_del_selector"
            android:layout_width="@dimen/dp_40"
            android:layout_height="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_5"
            android:layout_marginStart="220dp"
            android:layout_toEndOf="@+id/textView4"/>
    </RelativeLayout>
    <RelativeLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/rl_chassis_net"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_50"
        android:layout_marginTop="@dimen/dp_10">
        <TextView
            android:textSize="@dimen/sp_25"
            android:gravity="center"
            android:id="@+id/textView5"
            android:layout_width="@dimen/dp_150"
            android:layout_height="match_parent"
            android:text="@string/obd_chassis_net"
            android:layout_marginStart="70dp"/>
        <ImageView
            android:id="@+id/imageview4"
            android:background="@drawable/edittext_bg"
            android:clickable="false"
            android:layout_width="@dimen/dp_250"
            android:layout_height="@dimen/dp_50"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@+id/textView5"/>
        <EditText
            android:ellipsize="start"
            android:id="@+id/edittext_chassis_net"
            android:background="@null"
            android:longClickable="false"
            android:layout_width="@dimen/dp_200"
            android:layout_height="@dimen/dp_50"
            android:hint=""
            android:ems="10"
            android:singleLine="true"
            android:imeOptions="actionDone"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@+id/textView5"/>
        <ImageButton
            android:id="@+id/iv_chassis_net_del"
            android:background="@drawable/obd_del_selector"
            android:layout_width="@dimen/dp_40"
            android:layout_height="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_5"
            android:layout_marginStart="220dp"
            android:layout_toEndOf="@+id/textView5"/>
    </RelativeLayout>
    <RelativeLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/rl_adas_net"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_50"
        android:layout_marginTop="@dimen/dp_10">
        <TextView
            android:textSize="@dimen/sp_25"
            android:gravity="center"
            android:id="@+id/textView6"
            android:layout_width="@dimen/dp_150"
            android:layout_height="match_parent"
            android:text="@string/obd_adas_net"
            android:layout_marginStart="70dp"/>
        <ImageView
            android:id="@+id/imageview5"
            android:background="@drawable/edittext_bg"
            android:clickable="false"
            android:layout_width="@dimen/dp_250"
            android:layout_height="@dimen/dp_50"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@+id/textView6"/>
        <EditText
            android:ellipsize="start"
            android:id="@+id/edittext_adas_net"
            android:background="@null"
            android:longClickable="false"
            android:layout_width="@dimen/dp_200"
            android:layout_height="@dimen/dp_50"
            android:hint=""
            android:ems="10"
            android:singleLine="true"
            android:imeOptions="actionDone"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@+id/textView6"/>
        <ImageButton
            android:id="@+id/iv_adas_net_del"
            android:background="@drawable/obd_del_selector"
            android:layout_width="@dimen/dp_40"
            android:layout_height="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_5"
            android:layout_marginStart="220dp"
            android:layout_toEndOf="@+id/textView6"/>
    </RelativeLayout>
    <RelativeLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/rl_car_body_2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_50"
        android:layout_marginTop="@dimen/dp_10">
        <TextView
            android:textSize="@dimen/sp_25"
            android:gravity="center"
            android:id="@+id/textView7"
            android:layout_width="@dimen/dp_150"
            android:layout_height="match_parent"
            android:text="@string/obd_car_body_2"
            android:layout_marginStart="70dp"/>
        <ImageView
            android:id="@+id/imageview6"
            android:background="@drawable/edittext_bg"
            android:clickable="false"
            android:layout_width="@dimen/dp_250"
            android:layout_height="@dimen/dp_50"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@+id/textView7"/>
        <EditText
            android:ellipsize="start"
            android:id="@+id/edittext_car_body_2"
            android:background="@null"
            android:longClickable="false"
            android:layout_width="@dimen/dp_200"
            android:layout_height="@dimen/dp_50"
            android:hint=""
            android:ems="10"
            android:singleLine="true"
            android:imeOptions="actionDone"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@+id/textView7"/>
        <ImageButton
            android:id="@+id/iv_car_body_2_del"
            android:background="@drawable/obd_del_selector"
            android:layout_width="@dimen/dp_40"
            android:layout_height="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_5"
            android:layout_marginStart="220dp"
            android:layout_toEndOf="@+id/textView7"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp">
        <Button
            android:id="@+id/bt_close_id_mapping"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_60"
            android:text="@string/obd_close_network_mapping"
            android:layout_marginStart="488dp"/>
        <Button
            android:id="@+id/bt_id_back"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_60"
            android:layout_marginLeft="@dimen/dp_10"
            android:text="@string/obd_back"/>
    </LinearLayout>
</LinearLayout>
