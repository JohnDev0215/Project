<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/dp_60"
    android:layout_marginStart="@dimen/dp_5">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp_24">
        <TextView
            android:textSize="@dimen/text_size_25sp"
            android:textColor="@color/teal_700"
            android:id="@+id/tvNetwork"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_network"/>
        <RelativeLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_5">
            <TextView
                android:textSize="@dimen/text_size_28sp"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_auto_select"/>
            <com.byd.secretcode.view.BydSwitch
                android:id="@+id/swAutoSelect"
                android:background="@mipmap/img_switch_bg_normal"
                android:focusable="true"
                android:layout_width="@dimen/dp_64"
                android:layout_height="@dimen/dp_48"
                android:thumb="@null"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <View
            android:background="@color/color_bg"
            android:layout_width="wrap_content"
            android:layout_height="1dp"/>
    </LinearLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/llSelectNetwork"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_5"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp_24"
            android:layout_alignParentStart="true">
            <TextView
                android:textSize="@dimen/text_size_25sp"
                android:textColor="@color/black"
                android:id="@+id/tvSelectNetwork1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_select_network"/>
            <TextView
                android:textSize="@dimen/text_size_25sp"
                android:textColor="@color/black"
                android:id="@+id/tvSelectNetwork"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_select_network"/>
        </LinearLayout>
        <Button
            android:textColor="@color/white"
            android:id="@+id/btnSimDiagnose"
            android:background="@drawable/selector_dialog_blue"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/str_sim_diagnose"
            android:layout_centerVertical="true"
            android:textAllCaps="false"
            android:layout_marginEnd="@dimen/dp_24"
            android:layout_alignParentEnd="true"
            android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"/>
    </RelativeLayout>
    <View
        android:background="@color/color_bg"
        android:layout_width="wrap_content"
        android:layout_height="1dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_60">
        <TextView
            android:textSize="@dimen/sp_26"
            android:textColor="@color/black"
            android:id="@+id/curr_mccmnc"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text=""
            android:layout_weight="8"/>
        <Button
            android:textColor="@color/white"
            android:id="@+id/btn_autoupdate"
            android:background="@drawable/selector_dialog_blue"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:text="@string/automatic"
            android:textAllCaps="false"
            android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/linearlayout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_15"
        android:baselineAligned="false"
        android:layout_weight="6"
        android:layout_marginStart="@dimen/dp_5">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list_automatically"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_320"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_40"
        android:layout_weight="2">
        <Button
            android:id="@+id/ok_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ok"
            android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"/>
    </LinearLayout>
</LinearLayout>
