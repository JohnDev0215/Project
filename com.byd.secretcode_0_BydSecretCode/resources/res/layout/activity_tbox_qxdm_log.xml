<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/sp_28"
        android:gravity="center_horizontal"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_100"
        android:text="@string/str_tbox_qxdm_log_title"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:id="@+id/tv_title_tips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:text="@string/str_qxdm_log_title_tips"
        android:layout_below="@+id/tv_title"
        android:layout_marginStart="@dimen/dp_80"/>
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@+id/rl_location"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_80"
        android:layout_below="@+id/tv_title"
        android:layout_marginStart="@dimen/dp_80"
        android:layout_marginEnd="@dimen/dp_80">
        <TextView
            android:textSize="@dimen/sp_24"
            android:textColor="@color/text_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_tbox_location_log"/>
        <com.byd.secretcode.view.BydSwitch
            android:id="@+id/sw_open_location"
            android:background="@mipmap/img_switch_bg_normal"
            android:focusable="true"
            android:layout_width="@dimen/dp_64"
            android:layout_height="@dimen/dp_48"
            android:layout_marginRight="@dimen/dp_24"
            android:thumb="@null"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@+id/rl_audio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_20"
        android:layout_below="@+id/rl_location"
        android:layout_marginStart="@dimen/dp_80"
        android:layout_marginEnd="@dimen/dp_80">
        <TextView
            android:textSize="@dimen/sp_24"
            android:textColor="@color/text_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_tbox_audio_log"/>
        <com.byd.secretcode.view.BydSwitch
            android:id="@+id/sw_open_audio"
            android:background="@mipmap/img_switch_bg_normal"
            android:focusable="true"
            android:layout_width="@dimen/dp_64"
            android:layout_height="@dimen/dp_48"
            android:layout_marginRight="@dimen/dp_24"
            android:thumb="@null"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@+id/rl_network"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_20"
        android:layout_below="@+id/rl_audio"
        android:layout_marginStart="@dimen/dp_80"
        android:layout_marginEnd="@dimen/dp_80">
        <TextView
            android:textSize="@dimen/sp_24"
            android:textColor="@color/text_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_tbox_network_log"/>
        <com.byd.secretcode.view.BydSwitch
            android:id="@+id/sw_open_network"
            android:background="@mipmap/img_switch_bg_normal"
            android:focusable="true"
            android:layout_width="@dimen/dp_64"
            android:layout_height="@dimen/dp_48"
            android:layout_marginRight="@dimen/dp_24"
            android:thumb="@null"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@+id/rl_ecall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_20"
        android:layout_below="@+id/rl_network"
        android:layout_marginStart="@dimen/dp_80"
        android:layout_marginEnd="@dimen/dp_80">
        <TextView
            android:textSize="@dimen/sp_24"
            android:textColor="@color/text_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_tbox_ecall_log"/>
        <com.byd.secretcode.view.BydSwitch
            android:id="@+id/sw_open_ecall"
            android:background="@mipmap/img_switch_bg_normal"
            android:focusable="true"
            android:layout_width="@dimen/dp_64"
            android:layout_height="@dimen/dp_48"
            android:layout_marginRight="@dimen/dp_24"
            android:thumb="@null"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
</RelativeLayout>
