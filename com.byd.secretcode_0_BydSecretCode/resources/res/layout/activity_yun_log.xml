<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="@dimen/dp_20"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/sp_15"
        android:textColor="#4caf50"
        android:id="@+id/lable_1"
        android:paddingTop="@dimen/dp_20"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cloudTest"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_15"
        android:textColor="#4caf50"
        android:id="@+id/tv_yun_version"
        android:padding="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/yun_log_version_name_temp"
        app:layout_constraintTop_toBottomOf="@+id/lable_1"/>
    <TextView
        android:textSize="@dimen/sp_15"
        android:textColor="#4caf50"
        android:id="@+id/tv_vin"
        android:padding="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/yun_log_vin_temp"
        app:layout_constraintTop_toBottomOf="@+id/tv_yun_version"/>
    <TextView
        android:textSize="@dimen/sp_15"
        android:textColor="#4caf50"
        android:id="@+id/tv_virtul_vin"
        android:padding="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/yun_log_vritual_vin_temp"
        app:layout_constraintTop_toBottomOf="@+id/tv_vin"/>
    <TextView
        android:textSize="@dimen/sp_15"
        android:textColor="#4caf50"
        android:id="@+id/tv_yun_ev"
        android:padding="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/yun_log_ev_temp"
        app:layout_constraintTop_toBottomOf="@+id/tv_virtul_vin"/>
    <TextView
        android:textSize="@dimen/sp_15"
        android:textColor="#4caf50"
        android:id="@+id/tv_ivi_tbox"
        android:padding="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/yun_log_ivi_tbox_temp"
        app:layout_constraintTop_toBottomOf="@+id/tv_yun_ev"/>
    <TextView
        android:textSize="@dimen/sp_15"
        android:textColor="#4caf50"
        android:id="@+id/tv_yun_connect_state"
        android:padding="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/yun_log_connect_temp"
        app:layout_constraintTop_toBottomOf="@+id/tv_ivi_tbox"/>
    <TextView
        android:textSize="@dimen/sp_15"
        android:textColor="#4caf50"
        android:id="@+id/tv_yun_connect_fail_reason"
        android:padding="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/yun_log_connect_fail_reason_temp"
        app:layout_constraintTop_toBottomOf="@+id/tv_yun_connect_state"/>
    <TextView
        android:textSize="@dimen/sp_15"
        android:textColor="#4caf50"
        android:id="@+id/tv_apn1_ip"
        android:padding="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/yun_apn1_ip_temp"
        app:layout_constraintTop_toBottomOf="@+id/tv_yun_connect_fail_reason"/>
    <TextView
        android:textSize="@dimen/sp_15"
        android:textColor="#4caf50"
        android:id="@+id/tv_yun_uuid"
        android:padding="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/yun_uuid_temp"
        app:layout_constraintTop_toBottomOf="@+id/tv_apn1_ip"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/tv_yun_uuid">
        <TextView
            android:textSize="@dimen/sp_15"
            android:textColor="#4caf50"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/yun_log_ev_change"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/sp_15"
                android:textColor="#4caf50"
                android:padding="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/yun_ev_test"/>
            <com.byd.secretcode.view.BydSwitch
                android:id="@+id/switch_yun_ev_change"
                style="@style/base_byd_switch"/>
            <TextView
                android:textSize="@dimen/sp_15"
                android:textColor="#4caf50"
                android:padding="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/yun_ev_office"/>
        </LinearLayout>
    </LinearLayout>
    <Button
        android:textSize="@dimen/sp_12"
        android:id="@+id/app_activate_test"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="App_Activate_Test"
        app:layout_constraintTop_toBottomOf="@+id/ll_switch"/>
    <Button
        android:textSize="@dimen/sp_12"
        android:id="@+id/app_activate_test_v2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="App_Activate_Test_v2"
        app:layout_constraintLeft_toRightOf="@+id/app_activate_test"
        app:layout_constraintTop_toBottomOf="@+id/ll_switch"/>
</androidx.constraintlayout.widget.ConstraintLayout>
