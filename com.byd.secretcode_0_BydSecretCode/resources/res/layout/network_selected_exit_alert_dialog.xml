<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_240"
        android:layout_centerInParent="true">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20">
            <TextView
                android:textSize="@dimen/sp_20"
                android:id="@+id/network_selected_exit_confirm_textview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/str_network_select_exit_dialog_title"
                android:layout_centerVertical="true"
                android:textAlignment="center"/>
            <ImageView
                android:id="@+id/network_auto_select_close"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:layout_marginTop="@dimen/dp_24"
                android:src="@drawable/icon_set_public_close_48"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/dp_24"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_24"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/dp_24"
            android:layout_marginEnd="@dimen/dp_24">
            <Button
                android:textColor="@color/white"
                android:id="@+id/network_selected_exit_confirm_button"
                android:background="@drawable/selector_dialog_blue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/obd_confirm"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"/>
            <Button
                android:id="@+id/network_selected_exit_cancel_button"
                android:background="@drawable/selector_dialog_white"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/obd_cancel"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:layout_marginStart="@dimen/dp_40"
                android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
