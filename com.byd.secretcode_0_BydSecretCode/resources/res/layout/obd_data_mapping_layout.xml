<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/sp_30"
        android:id="@+id/textView7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="150dp"
        android:text="@string/obd_ignition_cycle_configuration"
        android:layout_marginStart="61dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <EditText
        android:ellipsize="start"
        android:id="@+id/editTextNumber"
        android:background="@drawable/edittext_bg"
        android:longClickable="false"
        android:layout_width="@dimen/dp_250"
        android:layout_height="@dimen/dp_50"
        android:layout_marginTop="23dp"
        android:hint="1~100"
        android:ems="10"
        android:singleLine="true"
        android:inputType="number"
        android:imeOptions="actionDone"
        android:layout_marginStart="61dp"
        android:layout_marginEnd="40dp"
        app:layout_constraintEnd_toStartOf="@+id/bt_confirm"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView7"/>
    <Button
        android:id="@+id/bt_confirm"
        android:layout_width="@dimen/dp_150"
        android:layout_height="@dimen/dp_60"
        android:layout_marginTop="216dp"
        android:text="@string/obd_confirm"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="76dp"
        app:layout_constraintEnd_toStartOf="@+id/bt_start_mapping"
        app:layout_constraintStart_toEndOf="@+id/editTextNumber"
        app:layout_constraintTop_toTopOf="parent"/>
    <Button
        android:id="@+id/bt_start_mapping"
        android:layout_width="@dimen/dp_150"
        android:layout_height="@dimen/dp_60"
        android:layout_marginTop="216dp"
        android:text="@string/obd_start_mapping"
        android:layout_marginStart="40dp"
        app:layout_constraintStart_toEndOf="@+id/bt_confirm"
        app:layout_constraintTop_toTopOf="parent"/>
    <Button
        android:id="@+id/bt_network_segment_mapping"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_60"
        android:layout_marginTop="46dp"
        android:text="@string/obd_network_segment_mapping"
        android:layout_marginStart="79dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/editTextNumber"/>
    <Button
        android:id="@+id/bt_id_mapping"
        android:visibility="gone"
        android:layout_width="@dimen/dp_150"
        android:layout_height="@dimen/dp_60"
        android:layout_marginTop="9dp"
        android:text="@string/obd_id_mapping"
        android:layout_marginStart="79dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bt_network_segment_mapping"/>
    <Button
        android:id="@+id/button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="180dp"
        android:text="发送第一帧"
        android:layout_marginEnd="65dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <Button
        android:id="@+id/button6"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="发送第二帧"
        android:layout_marginEnd="65dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button"/>
    <Button
        android:id="@+id/button7"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="发送第三帧"
        android:layout_marginEnd="65dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button6"/>
    <Button
        android:id="@+id/button8"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="发送"
        android:layout_marginEnd="65dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button7"/>
    <TextView
        android:id="@+id/textView8"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:text="TextView"
        android:layout_marginStart="312dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bt_start_mapping"/>
    <TextView
        android:id="@+id/textView9"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="23dp"
        android:layout_marginBottom="16dp"
        android:text="TextView"
        android:layout_marginStart="312dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView8"
        app:layout_constraintVertical_bias="0"/>
    <EditText
        android:ellipsize="start"
        android:id="@+id/editTextTest"
        android:background="@drawable/edittext_bg"
        android:visibility="gone"
        android:longClickable="false"
        android:layout_width="@dimen/dp_250"
        android:layout_height="@dimen/dp_50"
        android:layout_marginTop="23dp"
        android:hint="请输入OBD指令"
        android:ems="10"
        android:singleLine="true"
        android:imeOptions="actionDone"
        android:layout_marginStart="312dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView9"/>
</androidx.constraintlayout.widget.ConstraintLayout>
