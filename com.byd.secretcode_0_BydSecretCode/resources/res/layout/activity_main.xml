<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/bg_h"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dp_60"
        android:layout_marginBottom="@dimen/dp_60">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/dp_30">
            <TextView
                android:textSize="@dimen/text_size_28sp"
                android:textColor="@color/text_color"
                android:id="@+id/tv_countrycode"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_25"
                android:text="@string/country_code"/>
            <TextView
                android:textSize="@dimen/text_size_28sp"
                android:textColor="@color/text_color"
                android:id="@+id/tv_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                android:text="@string/version_number"/>
            <TextView
                android:textSize="@dimen/text_size_28sp"
                android:textColor="@color/text_color"
                android:id="@+id/tv_dsp_version_name"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                android:text="@string/str_dsp"/>
            <TextView
                android:textSize="@dimen/text_size_28sp"
                android:textColor="@color/text_color"
                android:id="@+id/tv_ecu_version_name"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                android:text="@string/str_ecu"/>
            <TextView
                android:textSize="@dimen/text_size_28sp"
                android:id="@+id/tv_anc_app_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                android:text="@string/str_anc_app_version"/>
            <TextView
                android:textSize="@dimen/text_size_28sp"
                android:id="@+id/tv_anc_data_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                android:text="@string/str_anc_data_version"/>
            <TextView
                android:id="@+id/tv_avm"
                android:text="@string/str_avm"
                style="@style/TextViewStyle"/>
            <TextView
                android:id="@+id/tv_bydlogtool"
                android:visibility="gone"
                android:text="@string/str_bydlogtool"
                style="@style/TextViewStyle"/>
            <TextView
                android:id="@+id/tv_otatool"
                android:visibility="gone"
                android:text="@string/str_otatool"
                style="@style/TextViewStyle"/>
            <TextView
                android:textSize="@dimen/text_size_28sp"
                android:textColor="@color/text_color"
                android:id="@+id/tv_materiallnfotool"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_25"
                android:text="@string/str_materiallnfotool"/>
            <TextView
                android:textSize="@dimen/text_size_28sp"
                android:textColor="@color/text_color"
                android:id="@+id/tv_audiopcmdebugtool"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_25"
                android:text="@string/str_audiopcmdebugtool"/>
            <TextView
                android:textSize="@dimen/text_size_28sp"
                android:textColor="@color/text_color"
                android:id="@+id/tv_devtools"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_25"
                android:text="@string/str_devtools"/>
            <TextView
                android:textSize="@dimen/text_size_28sp"
                android:textColor="@color/text_color"
                android:id="@+id/tv_cloud_services"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_25"
                android:text="@string/str_cloud_service"/>
            <TextView
                android:textSize="@dimen/text_size_28sp"
                android:textColor="@color/text_color"
                android:id="@+id/tv_byddms"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_25"
                android:text="@string/str_byddms"/>
            <TextView
                android:textSize="@dimen/text_size_28sp"
                android:textColor="@color/text_color"
                android:id="@+id/tv_btlogtools"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_25"
                android:text="@string/str_btlogtools"/>
            <TextView
                android:textSize="@dimen/text_size_28sp"
                android:textColor="@color/text_color"
                android:id="@+id/tv_qtlogkit"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_25"
                android:text="@string/str_qtlogkit"/>
            <TextView
                android:textSize="@dimen/text_size_28sp"
                android:textColor="@color/text_color"
                android:id="@+id/tv_autostudy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_25"
                android:text="@string/str_autostudy"/>
            <TextView
                android:textSize="@dimen/text_size_28sp"
                android:textColor="@color/text_color"
                android:id="@+id/tv_offline"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_25"
                android:text="@string/str_offline"/>
            <TextView
                android:textSize="@dimen/text_size_28sp"
                android:textColor="@color/text_color"
                android:id="@+id/tv_stresstest"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_25"
                android:text="@string/str_stresstest"/>
            <TextView
                android:textSize="@dimen/text_size_28sp"
                android:textColor="@color/text_color"
                android:id="@+id/tv_instrumenttest"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_25"
                android:text="@string/str_instrumenttest"/>
            <TextView
                android:textSize="@dimen/text_size_28sp"
                android:textColor="@color/text_color"
                android:id="@+id/tv_bydwirelesstools"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_25"
                android:text="@string/str_bydwirelesstools"/>
            <TextView
                android:textSize="@dimen/text_size_28sp"
                android:textColor="@color/text_color"
                android:id="@+id/tv_clusterdebug"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_25"
                android:layout_marginBottom="@dimen/dp_10"
                android:text="@string/str_clusterdebug"/>
            <TextView
                android:textSize="@dimen/text_size_28sp"
                android:textColor="@color/text_color"
                android:id="@+id/tv_isanavi"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_15"
                android:layout_marginBottom="@dimen/dp_10"
                android:text="@string/str_isanavi"/>
            <TextView
                android:textSize="@dimen/text_size_28sp"
                android:textColor="@color/text_color"
                android:id="@+id/tv_network"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_15"
                android:layout_marginBottom="@dimen/dp_10"
                android:text="@string/manual_network"/>
            <TextView
                android:textSize="@dimen/text_size_28sp"
                android:textColor="@color/text_color"
                android:id="@+id/tv_amplifier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_15"
                android:layout_marginBottom="@dimen/dp_10"
                android:text="@string/str_amplifier"/>
            <TextView
                android:textSize="@dimen/text_size_28sp"
                android:textColor="@color/text_color"
                android:id="@+id/tv_devicenet"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_15"
                android:layout_marginBottom="@dimen/dp_10"
                android:text="@string/str_devicenet"/>
            <TextView
                android:textSize="@dimen/text_size_28sp"
                android:textColor="@color/text_color"
                android:id="@+id/tv_language"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_15"
                android:layout_marginBottom="@dimen/dp_10"
                android:text="@string/str_language"/>
            <TextView
                android:textSize="@dimen/text_size_28sp"
                android:textColor="@color/text_color"
                android:id="@+id/tv_shujucaiji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_15"
                android:layout_marginBottom="@dimen/dp_10"
                android:text="@string/str_shujucaiji"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_15"
                android:layout_marginBottom="@dimen/dp_10">
                <TextView
                    android:textSize="@dimen/text_size_28sp"
                    android:textColor="@color/text_color"
                    android:id="@+id/tv_satellite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/str_satellite"/>
                <CheckBox
                    android:textSize="@dimen/text_size_28sp"
                    android:textColor="@color/text_color"
                    android:id="@+id/rb_tcpdump"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    android:button="@drawable/byd_checkbox"
                    android:text="@string/str_tcpdump"/>
                <CheckBox
                    android:textSize="@dimen/text_size_28sp"
                    android:textColor="@color/text_color"
                    android:id="@+id/rb_cloudservicelog"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    android:button="@drawable/byd_checkbox"
                    android:text="@string/str_cloudservicelog"/>
                <CheckBox
                    android:textSize="@dimen/text_size_28sp"
                    android:textColor="@color/text_color"
                    android:id="@+id/rb_alarmlog"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    android:button="@drawable/byd_checkbox"
                    android:text="@string/str_alarmlog"/>
                <CheckBox
                    android:textSize="@dimen/text_size_28sp"
                    android:textColor="@color/text_color"
                    android:id="@+id/rb_enableramdumps"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    android:button="@drawable/byd_checkbox"
                    android:text="@string/str_enableramdumps"/>
                <CheckBox
                    android:textSize="@dimen/text_size_28sp"
                    android:textColor="@color/text_color"
                    android:id="@+id/rb_enabledexopt"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    android:button="@drawable/byd_checkbox"
                    android:text="@string/str_enabledexopt"/>
                <CheckBox
                    android:textSize="@dimen/text_size_28sp"
                    android:textColor="@color/text_color"
                    android:id="@+id/rb_autohallog"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    android:button="@drawable/byd_checkbox"
                    android:text="@string/str_autohallog"/>
                <CheckBox
                    android:textSize="@dimen/text_size_28sp"
                    android:textColor="@color/text_color"
                    android:id="@+id/rb_flymode"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    android:button="@drawable/byd_checkbox"
                    android:text="@string/str_flymode"/>
                <CheckBox
                    android:textSize="@dimen/text_size_28sp"
                    android:textColor="@color/text_color"
                    android:id="@+id/rb_consolesuspand"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    android:button="@drawable/byd_checkbox"
                    android:text="@string/str_consolesuspand"/>
                <TextView
                    android:textSize="@dimen/text_size_28sp"
                    android:textColor="@color/text_color"
                    android:id="@+id/tv_guandao"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    android:button="@drawable/byd_checkbox"
                    android:text="@string/str_guandao"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
