<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <EditText
        android:id="@+id/edt_state_hold"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/ll_password"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="@dimen/text_size_32sp"
            android:textColor="@color/black"
            android:id="@+id/imei_tv"
            android:layout_width="@dimen/dp_368"
            android:layout_height="wrap_content"
            android:text="@string/imei"/>
        <EditText
            android:textSize="@dimen/text_size_32sp"
            android:id="@+id/et_password"
            android:layout_width="@dimen/dp_368"
            android:layout_height="@dimen/dp_100"
            android:layout_marginTop="@dimen/dp_40"
            android:hint="@string/str_please_enter_password"
            android:inputType="textPassword"/>
        <Button
            android:textSize="@dimen/text_size_28sp"
            android:id="@+id/ok_btn"
            android:layout_width="@dimen/dp_150"
            android:layout_height="@dimen/dp_70"
            android:layout_marginTop="@dimen/dp_40"
            android:text="@string/confirm"/>
    </LinearLayout>
    <ScrollView
        android:id="@+id/sv_secretview"
        android:visibility="gone"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dp_20"
        android:layout_marginBottom="@dimen/dp_20">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/dp_30">
            <TextView
                android:textSize="@dimen/text_size_28sp"
                android:textColor="@color/text_color"
                android:id="@+id/tv_yunhua"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_40"
                android:layout_marginTop="@dimen/dp_15"
                android:text="@string/str_yunhuafuwu_test"/>
            <TextView
                android:textSize="@dimen/text_size_28sp"
                android:textColor="@color/text_color"
                android:id="@+id/tv_countrycode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_40"
                android:layout_marginTop="@dimen/dp_15"
                android:text="@string/country_code"/>
            <TextView
                android:textSize="@dimen/text_size_30sp"
                android:textColor="@color/black"
                android:background="@color/teal_700"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                android:text="@string/str_log_ctrl_switch"/>
            <include
                android:id="@+id/log_switch_view"
                android:visibility="visible"
                layout="@layout/log_switch_layout"/>
            <TextView
                android:textSize="@dimen/text_size_30sp"
                android:textColor="@color/black"
                android:background="@color/teal_700"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_20"
                android:text="@string/str_test_tools"/>
            <include
                android:id="@+id/test_view"
                android:visibility="visible"
                layout="@layout/adb_layout"/>
            <TextView
                android:textSize="@dimen/text_size_30sp"
                android:textColor="@color/black"
                android:id="@+id/tv_advanced_configuration"
                android:background="@color/teal_700"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_20"
                android:text="@string/str_advanced_configuration"/>
            <TextView
                android:textSize="@dimen/text_size_28sp"
                android:textColor="@color/text_color"
                android:id="@+id/tv_offline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_50"
                android:layout_marginTop="@dimen/dp_20"
                android:text="@string/str_offline"/>
            <RelativeLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_50"
                android:layout_marginTop="@dimen/dp_20">
                <TextView
                    android:textSize="@dimen/text_size_28sp"
                    android:textColor="@color/text_color"
                    android:id="@+id/network_detection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/str_network_detection"/>
                <com.byd.secretcode.view.BydSwitch
                    android:id="@+id/sw_network_detection"
                    android:background="@mipmap/img_switch_bg_normal"
                    android:focusable="true"
                    android:layout_width="@dimen/dp_64"
                    android:layout_height="@dimen/dp_48"
                    android:layout_marginRight="@dimen/dp_24"
                    android:thumb="@null"
                    android:layout_alignParentRight="true"
                    app:splitTrack="true"
                    app:switchMinWidth="@dimen/dp_56"
                    app:thumbTintMode="src_over"
                    app:track="@color/transparent_00"
                    app:trackTint="@color/transparent_00"/>
            </RelativeLayout>
            <RelativeLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_50"
                android:layout_marginTop="@dimen/dp_10">
                <TextView
                    android:textSize="@dimen/text_size_28sp"
                    android:textColor="@color/text_color"
                    android:id="@+id/cpaa_install"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/str_cp_install"/>
                <com.byd.secretcode.view.BydSwitch
                    android:id="@+id/sw_cp_install"
                    android:background="@mipmap/img_switch_bg_normal"
                    android:focusable="true"
                    android:layout_width="@dimen/dp_64"
                    android:layout_height="@dimen/dp_48"
                    android:layout_marginRight="@dimen/dp_24"
                    android:thumb="@null"
                    android:layout_alignParentRight="true"
                    app:splitTrack="true"
                    app:switchMinWidth="@dimen/dp_56"
                    app:thumbTintMode="src_over"
                    app:track="@color/transparent_00"
                    app:trackTint="@color/transparent_00"/>
            </RelativeLayout>
            <RelativeLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_50"
                android:layout_marginTop="@dimen/dp_10">
                <TextView
                    android:textSize="@dimen/text_size_28sp"
                    android:textColor="@color/text_color"
                    android:id="@+id/aa_install"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/str_aa_install"/>
                <com.byd.secretcode.view.BydSwitch
                    android:id="@+id/sw_aa_install"
                    android:background="@mipmap/img_switch_bg_normal"
                    android:focusable="true"
                    android:layout_width="@dimen/dp_64"
                    android:layout_height="@dimen/dp_48"
                    android:layout_marginRight="@dimen/dp_24"
                    android:thumb="@null"
                    android:layout_alignParentRight="true"
                    app:splitTrack="true"
                    app:switchMinWidth="@dimen/dp_56"
                    app:thumbTintMode="src_over"
                    app:track="@color/transparent_00"
                    app:trackTint="@color/transparent_00"/>
            </RelativeLayout>
            <TextView
                android:textSize="@dimen/text_size_28sp"
                android:textColor="@color/text_color"
                android:id="@+id/tv_audiopcmdebugtool"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                android:text="@string/str_audiopcmdebugtool"
                android:layout_marginStart="@dimen/dp_50"/>
            <TextView
                android:textSize="@dimen/text_size_28sp"
                android:textColor="@color/text_color"
                android:id="@+id/tv_isanavi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_20"
                android:text="@string/str_isanavi"
                android:layout_marginStart="@dimen/dp_50"/>
            <TextView
                android:textSize="@dimen/text_size_28sp"
                android:textColor="@color/text_color"
                android:id="@+id/tv_network"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_20"
                android:layout_marginBottom="@dimen/dp_10"
                android:text="@string/manual_network"
                android:layout_marginStart="@dimen/dp_50"/>
            <TextView
                android:textSize="@dimen/text_size_28sp"
                android:textColor="@color/text_color"
                android:id="@+id/tv_sound_calibration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_20"
                android:layout_marginBottom="@dimen/dp_10"
                android:text="@string/str_sound_source_exit_calibration"
                android:layout_marginStart="@dimen/dp_50"/>
            <TextView
                android:textSize="@dimen/text_size_28sp"
                android:textColor="@color/text_color"
                android:id="@+id/tv_anc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_15"
                android:layout_marginBottom="@dimen/dp_10"
                android:text="@string/str_anc"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
