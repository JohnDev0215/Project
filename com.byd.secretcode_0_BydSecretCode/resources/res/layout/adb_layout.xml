<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginLeft="@dimen/dp_30">
    <RelativeLayout
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_60">
        <TextView
            android:textSize="@dimen/text_size_28sp"
            android:textColor="@color/text_color"
            android:id="@+id/tv_test_linkusb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_20"
            android:text="@string/str_linkusb"/>
        <com.byd.secretcode.view.BydSwitch
            android:id="@+id/sw_test_str_linkusb"
            android:background="@mipmap/img_switch_bg_normal"
            android:focusable="true"
            android:layout_width="@dimen/dp_64"
            android:layout_height="@dimen/dp_48"
            android:layout_marginRight="@dimen/dp_24"
            android:thumb="@null"
            android:layout_alignParentRight="true"
            app:splitTrack="true"
            app:switchMinWidth="@dimen/dp_56"
            app:thumbTintMode="src_over"
            app:track="@color/transparent_00"
            app:trackTint="@color/transparent_00"/>
    </RelativeLayout>
    <RelativeLayout
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10">
        <TextView
            android:textSize="@dimen/text_size_28sp"
            android:textColor="@color/text_color"
            android:id="@+id/textView3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_20"
            android:text="@string/str_visual_effect"/>
        <com.byd.secretcode.view.BydSwitch
            android:id="@+id/sw_test_visual_effect"
            android:background="@mipmap/img_switch_bg_normal"
            android:focusable="true"
            android:layout_width="@dimen/dp_64"
            android:layout_height="@dimen/dp_48"
            android:layout_marginRight="@dimen/dp_24"
            android:thumb="@null"
            android:layout_alignParentRight="true"
            app:splitTrack="true"
            app:switchMinWidth="@dimen/dp_56"
            app:thumbTintMode="src_over"
            app:track="@color/transparent_00"
            app:trackTint="@color/transparent_00"/>
    </RelativeLayout>
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@+id/rl_rnc"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10">
        <TextView
            android:textSize="@dimen/text_size_28sp"
            android:textColor="@color/text_color"
            android:id="@+id/tv_rnc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_20"
            android:text="@string/str_rnc"/>
        <com.byd.secretcode.view.BydSwitch
            android:id="@+id/sw_test_rnc"
            android:background="@mipmap/img_switch_bg_normal"
            android:focusable="true"
            android:layout_width="@dimen/dp_64"
            android:layout_height="@dimen/dp_48"
            android:layout_marginRight="@dimen/dp_24"
            android:thumb="@null"
            android:layout_alignParentRight="true"
            app:splitTrack="true"
            app:switchMinWidth="@dimen/dp_56"
            app:thumbTintMode="src_over"
            app:track="@color/transparent_00"
            app:trackTint="@color/transparent_00"/>
    </RelativeLayout>
    <RelativeLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10">
        <TextView
            android:textSize="@dimen/text_size_28sp"
            android:textColor="@color/text_color"
            android:id="@+id/textView4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_20"
            android:text="@string/str_touch_data"/>
        <com.byd.secretcode.view.BydSwitch
            android:id="@+id/sw_test_touch_data"
            android:background="@mipmap/img_switch_bg_normal"
            android:focusable="true"
            android:layout_width="@dimen/dp_64"
            android:layout_height="@dimen/dp_48"
            android:layout_marginRight="@dimen/dp_24"
            android:thumb="@null"
            android:layout_alignParentRight="true"
            app:splitTrack="true"
            app:switchMinWidth="@dimen/dp_56"
            app:thumbTintMode="src_over"
            app:track="@color/transparent_00"
            app:trackTint="@color/transparent_00"/>
    </RelativeLayout>
    <CheckBox
        android:textSize="@dimen/text_size_28sp"
        android:textColor="@color/text_color"
        android:id="@+id/rb_switch_flymode"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:button="@drawable/byd_checkbox"
        android:text="@string/str_flymode"/>
    <TextView
        android:textSize="@dimen/text_size_28sp"
        android:textColor="@color/text_color"
        android:id="@+id/tv_camera_test"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_20"
        android:layout_marginTop="@dimen/dp_10"
        android:text="@string/str_camera_test"/>
    <RelativeLayout
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10">
        <TextView
            android:textSize="@dimen/text_size_28sp"
            android:textColor="@color/text_color"
            android:id="@+id/textView5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_20"
            android:text="@string/str_wireless_adb"/>
        <com.byd.secretcode.view.BydSwitch
            android:id="@+id/sw_test_wireless_adb"
            android:background="@mipmap/img_switch_bg_normal"
            android:focusable="true"
            android:layout_width="@dimen/dp_64"
            android:layout_height="@dimen/dp_48"
            android:layout_marginRight="@dimen/dp_24"
            android:thumb="@null"
            android:layout_alignParentRight="true"
            app:splitTrack="true"
            app:switchMinWidth="@dimen/dp_56"
            app:thumbTintMode="src_over"
            app:track="@color/transparent_00"
            app:trackTint="@color/transparent_00"/>
    </RelativeLayout>
    <TextView
        android:textSize="@dimen/text_size_28sp"
        android:textColor="@color/text_color"
        android:id="@+id/textView6"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_20"
        android:layout_marginTop="@dimen/dp_10"
        android:text="@string/str_wifi_pc"/>
    <TextView
        android:textSize="@dimen/text_size_28sp"
        android:textColor="@color/text_color"
        android:id="@+id/tv_test_wireless_ip"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_20"
        android:text="@string/str_ip"/>
</LinearLayout>
