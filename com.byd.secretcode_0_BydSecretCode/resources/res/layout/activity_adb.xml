<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_h"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_60">
        <Button
            android:textSize="@dimen/text_size_28sp"
            android:id="@+id/bt_linkusb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_20"
            android:text="@string/str_linkusb"/>
    </RelativeLayout>
    <RelativeLayout
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_30">
        <Button
            android:textSize="@dimen/text_size_28sp"
            android:id="@+id/bt_link_sv_usb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_20"
            android:text="@string/str_link_sv_usb"/>
    </RelativeLayout>
    <RelativeLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_60">
        <TextView
            android:textSize="@dimen/text_size_28sp"
            android:id="@+id/textView3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_20"
            android:text="@string/str_visual_effect"/>
        <Switch
            android:id="@+id/sw_visual_effect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/dp_24"
            android:thumb="@drawable/switch_thumb_shape"
            android:layout_alignParentRight="true"
            android:track="@drawable/check_tack_selector"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:splitTrack="true"
            app:track="@color/transparent_00"
            app:trackTint="@color/transparent_00"/>
    </RelativeLayout>
    <RelativeLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10">
        <TextView
            android:textSize="@dimen/text_size_28sp"
            android:id="@+id/textView4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_20"
            android:text="@string/str_touch_data"/>
        <Switch
            android:id="@+id/sw_touch_data"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/dp_24"
            android:thumb="@drawable/switch_thumb_shape"
            android:layout_alignParentRight="true"
            android:track="@drawable/check_tack_selector"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:splitTrack="true"
            app:track="@color/transparent_00"
            app:trackTint="@color/transparent_00"/>
    </RelativeLayout>
    <RelativeLayout
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10">
        <TextView
            android:textSize="@dimen/text_size_28sp"
            android:id="@+id/textView5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_20"
            android:text="@string/str_wireless_adb"/>
        <Switch
            android:id="@+id/sw_wireless_adb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/dp_24"
            android:thumb="@drawable/switch_thumb_shape"
            android:layout_alignParentRight="true"
            android:track="@drawable/check_tack_selector"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:splitTrack="true"
            app:track="@color/transparent_00"
            app:trackTint="@color/transparent_00"/>
    </RelativeLayout>
    <TextView
        android:textSize="@dimen/text_size_28sp"
        android:id="@+id/textView6"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_20"
        android:layout_marginTop="@dimen/dp_10"
        android:text="@string/str_wifi_pc"/>
    <TextView
        android:textSize="@dimen/text_size_28sp"
        android:id="@+id/tv_wireless_ip"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_20"
        android:text="@string/str_ip"/>
    <TextView
        android:textSize="@dimen/text_size_28sp"
        android:id="@+id/tv_factory_service_interface"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_20"
        android:layout_marginTop="@dimen/dp_25"
        android:text="@string/str_factory_service_interface"/>
    <TextView
        android:textSize="@dimen/text_size_28sp"
        android:textColor="@color/text_color"
        android:id="@+id/tvRollBench"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_20"
        android:layout_marginTop="@dimen/dp_25"
        android:text="@string/str_open_energy_test"/>
</LinearLayout>
