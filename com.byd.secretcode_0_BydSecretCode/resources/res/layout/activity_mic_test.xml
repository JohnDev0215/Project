<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_60">
        <Button
            android:id="@+id/bt_start_record"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/start_record"
            android:layout_weight="1"/>
        <Button
            android:id="@+id/bt_stop_record"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/play_front_left_channel"
            android:layout_weight="1"/>
        <Button
            android:id="@+id/bt_play"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/play_front_right_channel"
            android:layout_weight="1"/>
        <Button
            android:id="@+id/bt_pause"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/play_rear_left_channel"
            android:layout_weight="1"/>
        <Button
            android:id="@+id/bt_del_file"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/play_rear_right_channel"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
