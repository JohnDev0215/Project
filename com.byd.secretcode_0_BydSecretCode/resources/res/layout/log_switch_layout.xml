<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginLeft="@dimen/dp_50">
    <TextView
        android:id="@+id/tv_log_switch_bydlogtool"
        android:text="@string/str_bydlogtool"
        style="@style/TextViewStyle"/>
    <TextView
        android:textSize="@dimen/text_size_28sp"
        android:textColor="@color/text_color"
        android:id="@+id/tv_log_switch_cloud_services"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_25"
        android:text="@string/str_cloud_service"/>
    <TextView
        android:id="@+id/tv_log_switch_vr_log"
        android:text="@string/str_vrlog"
        style="@style/TextViewStyle"/>
    <TextView
        android:textSize="@dimen/text_size_28sp"
        android:textColor="@color/text_color"
        android:id="@+id/tv_log_switch_btlogtools"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_25"
        android:text="@string/str_btlogtools"/>
    <TextView
        android:textSize="@dimen/text_size_28sp"
        android:textColor="@color/text_color"
        android:id="@+id/tv_log_switch_tbox_Qxdm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_25"
        android:text="@string/str_qxdm_log"/>
    <CheckBox
        android:textSize="@dimen/text_size_28sp"
        android:textColor="@color/text_color"
        android:id="@+id/rb_log_switch_tcpdump"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:button="@drawable/byd_checkbox"
        android:text="@string/str_tcpdump"/>
    <CheckBox
        android:textSize="@dimen/text_size_28sp"
        android:textColor="@color/text_color"
        android:id="@+id/rb_log_switch_cloudservicelog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:button="@drawable/byd_checkbox"
        android:text="@string/str_cloudservicelog"/>
    <CheckBox
        android:textSize="@dimen/text_size_28sp"
        android:textColor="@color/text_color"
        android:id="@+id/rb_log_switch_enableramdumps"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:button="@drawable/byd_checkbox"
        android:text="@string/str_enableramdumps"/>
    <CheckBox
        android:textSize="@dimen/text_size_28sp"
        android:textColor="@color/text_color"
        android:id="@+id/rb_log_switch_enabledexopt"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:button="@drawable/byd_checkbox"
        android:text="@string/str_enabledexopt"/>
    <CheckBox
        android:textSize="@dimen/text_size_28sp"
        android:textColor="@color/text_color"
        android:id="@+id/rb_log_switch_autohallog"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:button="@drawable/byd_checkbox"
        android:text="@string/str_autohallog"/>
    <CheckBox
        android:textSize="@dimen/text_size_28sp"
        android:textColor="@color/text_color"
        android:id="@+id/rb_log_switch_flymode"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:button="@drawable/byd_checkbox"
        android:text="@string/str_flymode"/>
    <TextView
        android:textSize="@dimen/text_size_28sp"
        android:textColor="@color/text_color"
        android:id="@+id/tv_log_switch_clusterdebug"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:layout_marginBottom="@dimen/dp_10"
        android:text="@string/str_clusterdebug"/>
    <CheckBox
        android:textSize="@dimen/text_size_28sp"
        android:textColor="@color/text_color"
        android:id="@+id/rb_log_switch_consolesuspand"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:button="@drawable/byd_checkbox"
        android:text="@string/str_consolesuspand"/>
    <CheckBox
        android:textSize="@dimen/text_size_28sp"
        android:textColor="@color/text_color"
        android:id="@+id/rb_log_dabTuner"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:button="@drawable/byd_checkbox"
        android:text="@string/str_dab_tuner_log"/>
    <CheckBox
        android:textSize="@dimen/text_size_28sp"
        android:textColor="@color/text_color"
        android:id="@+id/rb_log_dabDumpTuner"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:button="@drawable/byd_checkbox"
        android:text="@string/str_dab_dump_tuner_log"/>
    <TextView
        android:id="@+id/tv_otatool"
        android:text="@string/str_otatool"
        style="@style/TextViewStyle"/>
</LinearLayout>
