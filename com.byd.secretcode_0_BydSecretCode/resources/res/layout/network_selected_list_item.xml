<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/network_signal_message_container"
        android:paddingTop="@dimen/dp_4"
        android:paddingBottom="@dimen/dp_4"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_72"
        android:paddingStart="@dimen/dp_24">
        <ImageView
            android:id="@+id/network_signal_level_iv"
            android:layout_width="@dimen/dp_36"
            android:layout_height="@dimen/dp_36"
            android:layout_centerVertical="true"/>
        <RelativeLayout
            android:id="@+id/network_signal_name_and_state_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/dp_24"
            android:layout_toEndOf="@+id/network_signal_level_iv">
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/black"
                android:id="@+id/network_signal_name_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="@dimen/sp_15"
                android:textColor="@color/black"
                android:id="@+id/network_signal_state_tv"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/network_signal_name_tv"/>
        </RelativeLayout>
    </RelativeLayout>
    <View
        android:background="@color/color_bg"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_below="@+id/network_signal_message_container"/>
</RelativeLayout>
