<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_recoverylog"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_30">
        <Button
            android:id="@+id/button1"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_30"
            android:text="Button"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_recoverylog"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_save_ota_log"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_30">
        <Button
            android:id="@+id/button2"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_30"
            android:text="Button"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_save_ota_log"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_switch_ota_network"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_30">
        <Button
            android:id="@+id/button3"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_30"
            android:text="Button"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_switch_ota_network"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_switch_ota_loop_test"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_30">
        <Button
            android:id="@+id/button4"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_30"
            android:text="Button"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_switch_ota_loop_test"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_switch_usb_loop_test"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_30">
        <Button
            android:id="@+id/button5"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_30"
            android:text="Button"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_switch_usb_loop_test"/>
    </LinearLayout>
</LinearLayout>
