<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.motion.widget.MotionLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:tag="layout-w600dp-h480dp/fragment_category_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layoutDescription="@xml/fragment_category_scene">
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/container"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/category_vp_margin_top"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tabLayout"/>
    <View
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/common_header_height"
        android:layout_marginTop="@dimen/common_header_margin_top"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/topBg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/common_top_bg_height"
        android:src="?attr/top_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_logo"
        android:layout_width="@dimen/category_title_logo_length"
        android:layout_height="@dimen/category_title_logo_length"
        android:src="@drawable/ic_user_default"
        android:onClick="onClickSetting"
        android:layout_marginStart="@dimen/category_grid_rv_margin_start"
        app:layout_constraintBottom_toBottomOf="@+id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/header"/>
    <TextView
        android:textAppearance="?attr/TextAppearance.VIVID.BYD.LargeTitle"
        android:textStyle="bold"
        android:textColor="?attr/title_color"
        android:gravity="center_vertical"
        android:id="@+id/tv_name"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/category_title_logo_length"
        android:text="@string/your_library"
        android:includeFontPadding="false"
        android:onClick="onClickSetting"
        android:layout_marginStart="@dimen/category_title_text_margin_start"
        app:layout_constraintStart_toEndOf="@+id/iv_logo"
        app:layout_constraintTop_toTopOf="@+id/iv_logo"/>
    <ImageView
        android:id="@+id/iv_right_top"
        android:layout_width="@dimen/ic_spotify_logo_width"
        android:layout_height="@dimen/ic_spotify_logo_height"
        android:src="?attr/logo"
        android:scaleType="centerInside"
        android:layout_marginEnd="@dimen/media_list_parent_item_logo_margin_end"
        app:layout_constraintBottom_toBottomOf="@+id/header"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/header"/>
    <com.vivid.spotify.common.ui.BaseTabLayout
        android:id="@+id/tabLayout"
        android:tag="binding_2"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tab_layout_height"
        android:layout_marginTop="@dimen/tab_layout_margin_top"
        android:layout_marginStart="@dimen/category_grid_rv_margin_start"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_logo"
        app:tabPaddingEnd="@dimen/tab_padding_start_and_end"
        app:tabPaddingStart="@dimen/tab_padding_start_and_end"
        style="@style/tabLayoutStyle"/>
</androidx.constraintlayout.motion.widget.MotionLayout>
