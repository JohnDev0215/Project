<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout-w600dp-h480dp/media_cover_item_0"
    android:background="@drawable/bg_ripple"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/fragment_main_grid_media_cover_item_margin_top"
    android:layout_marginBottom="@dimen/fragment_main_grid_media_cover_item_margin_bottom"
    android:layout_alignParentTop="true"
    android:layout_alignParentStart="true">
    <ImageView
        android:id="@+id/icon"
        android:tag="binding_1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/media_cover_item_title_margin_top"
        app:layout_constraintEnd_toStartOf="@+id/btn_play"
        app:layout_constraintStart_toStartOf="@+id/icon"
        app:layout_constraintTop_toBottomOf="@+id/icon">
        <TextView
            android:ellipsize="none"
            android:layout_gravity="center_horizontal"
            android:tag="binding_2"
            android:visibility="gone"
            android:fadingEdge="horizontal"
            android:fadingEdgeLength="@dimen/fading_edge_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:requiresFadingEdge="horizontal"
            style="@style/grid_item_title_text_style"/>
        <TextView
            android:ellipsize="none"
            android:id="@+id/title"
            android:tag="binding_3"
            android:fadingEdge="horizontal"
            android:fadingEdgeLength="@dimen/fading_edge_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:requiresFadingEdge="horizontal"
            style="@style/grid_item_title_text_style"/>
        <TextView
            android:textAppearance="?attr/TextAppearance.VIVID.BYD.Primary.Navigation"
            android:textColor="?attr/subtitle_color"
            android:ellipsize="none"
            android:id="@+id/subtitle"
            android:tag="binding_4"
            android:paddingBottom="@dimen/media_cover_item_subtitle_margin_bottom"
            android:fadingEdge="horizontal"
            android:fadingEdgeLength="@dimen/fading_edge_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/media_cover_item_subtitle_margin_top"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:alpha="0.6"
            android:requiresFadingEdge="horizontal"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="end"
        android:id="@+id/btn_play"
        android:tag="binding_5"
        android:paddingTop="@dimen/media_cover_item_play_icon_bg_padding_top"
        android:visibility="gone"
        android:layout_width="@dimen/media_cover_item_play_icon_bg_width"
        android:layout_height="@dimen/media_cover_item_play_icon_bg_size"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/icon">
        <ImageView
            android:tag="binding_6"
            android:layout_width="@dimen/media_cover_item_play_icon_size"
            android:layout_height="@dimen/media_cover_item_play_icon_size"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
