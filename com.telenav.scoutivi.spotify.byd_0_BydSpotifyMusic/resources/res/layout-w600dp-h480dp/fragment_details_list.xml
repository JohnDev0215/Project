<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.motion.widget.MotionLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:tag="layout-w600dp-h480dp/fragment_details_list_0"
    android:paddingBottom="@dimen/fragment_details_list_padding_bottom"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/fragment_details_list_padding_left"
    app:layoutDescription="@xml/fragment_details_list_scene">
    <ImageView
        android:id="@+id/topBg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:src="?attr/top_bg"
        android:alpha="0"
        android:layout_marginStart="@dimen/common_top_bg_margin_start"
        app:layout_constraintBottom_toBottomOf="@+id/tabLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/portrait_artist_viewpager_margin_top"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tabLayout"
        app:layout_goneMarginTop="@dimen/portrait_artist_viewpager_gone_margin_top"/>
    <ImageView
        android:id="@+id/img_cover"
        android:tag="binding_2"
        android:layout_width="@dimen/fragment_details_list_img_size"
        android:layout_height="@dimen/fragment_details_list_img_size"
        android:layout_marginTop="@dimen/fragment_details_list_img_margin_top"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/logo"
        android:layout_width="@dimen/ic_spotify_logo_width"
        android:layout_height="@dimen/ic_spotify_logo_height"
        android:layout_marginTop="@dimen/fragment_details_logo_margin_top"
        android:src="?attr/logo"
        android:layout_marginEnd="@dimen/fragment_details_logo_margin_right"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/rule_view_play_all"
        android:layout_width="@dimen/fragment_details_list_play_btn_size"
        android:layout_height="@dimen/fragment_details_list_play_btn_size"
        android:layout_marginStart="@dimen/fragment_details_list_play_btn_margin_start"
        android:layout_marginEnd="@dimen/fragment_details_logo_margin_right"
        app:layout_constraintBottom_toBottomOf="@+id/img_cover"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/title_layout"
        app:layout_constraintTop_toTopOf="@+id/img_cover"/>
    <com.vivid.spotify.common.ui.shimmer.ShimmerLayout
        android:id="@+id/shimmer_play_all"
        android:tag="binding_3"
        android:layout_width="@dimen/fragment_details_list_play_btn_size"
        android:layout_height="@dimen/fragment_details_list_play_btn_size"
        app:layout_constraintStart_toStartOf="@+id/rule_view_play_all"
        app:layout_constraintTop_toTopOf="@+id/rule_view_play_all">
        <ImageView
            android:layout_width="@dimen/fragment_details_list_play_btn_size"
            android:layout_height="@dimen/fragment_details_list_play_btn_size"
            android:src="?attr/viewholder_btn_play"/>
    </com.vivid.spotify.common.ui.shimmer.ShimmerLayout>
    <ImageView
        android:orientation="horizontal"
        android:id="@+id/play_all"
        android:tag="binding_4"
        android:visibility="gone"
        android:layout_width="@dimen/fragment_details_list_play_btn_size"
        android:layout_height="@dimen/fragment_details_list_play_btn_size"
        app:layout_constraintStart_toStartOf="@+id/rule_view_play_all"
        app:layout_constraintTop_toTopOf="@+id/rule_view_play_all"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/title_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/fragment_details_list_play_text_margin_left"
        app:layout_constraintEnd_toStartOf="@+id/rule_view_play_all"
        app:layout_constraintStart_toEndOf="@+id/img_cover"
        app:layout_constraintTop_toTopOf="@+id/img_cover">
        <TextView
            android:textAppearance="?attr/TextAppearance.VIVID.BYD.LargeTitle"
            android:textColor="?attr/title_color"
            android:ellipsize="none"
            android:gravity="start"
            android:id="@+id/title"
            android:tag="binding_5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:includeFontPadding="false"/>
        <TextView
            android:textAppearance="?attr/TextAppearance.VIVID.BYD.Primary.Navigation"
            android:textColor="?attr/title_color"
            android:ellipsize="none"
            android:gravity="start"
            android:id="@+id/subtitle"
            android:tag="binding_6"
            android:padding="0dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/fragment_details_list_subtitle_margin_top"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:alpha="0.6"/>
    </LinearLayout>
    <com.vivid.spotify.common.ui.shimmer.ShimmerRecyclerView
        android:scrollbarThumbVertical="?attr/common_scroll_bar_bg"
        android:scrollbarStyle="outsideOverlay"
        android:orientation="vertical"
        android:id="@+id/list_media"
        android:tag="binding_7"
        android:background="?attr/colorTransparent"
        android:scrollbars="vertical"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:verticalScrollbarPosition="defaultPosition"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/view_pager"
        app:pagination_on="false"
        app:shimmer_layout="@layout/base_list_item_viewholder"/>
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:tag="binding_8"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/tab_layout_height"
        android:layout_marginTop="@dimen/portrait_artist_tab_layout_margin_top"
        android:layout_marginEnd="@dimen/portrait_artist_tab_layout_margin_end"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/img_cover"
        app:tabPaddingEnd="@dimen/tab_padding_start_and_end"
        app:tabPaddingStart="@dimen/tab_padding_start_and_end"
        style="@style/detailTabLayoutStyle"/>
    <include
        android:id="@+id/error_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/img_cover"
        layout="@layout/detail_error_layout"/>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/btn_favorite"
        android:tag="binding_9"
        android:layout_width="@dimen/common_btn_size"
        android:layout_height="@dimen/common_btn_size"
        android:layout_marginTop="@dimen/fragment_details_list_favorite_button_margin_top"
        app:layout_constraintStart_toStartOf="@+id/title_layout"
        app:layout_constraintTop_toTopOf="@+id/img_cover">
        <ImageView
            android:tag="binding_10"
            android:layout_width="@dimen/common_btn_img_size"
            android:layout_height="@dimen/common_btn_img_size"/>
    </LinearLayout>
    <TextView
        android:textAppearance="?attr/TextAppearance.VIVID.BYD.LargeTitle"
        android:textColor="?attr/title_color"
        android:ellipsize="none"
        android:gravity="center_vertical"
        android:id="@+id/tv_back"
        android:tag="binding_11"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/common_btn_size"
        android:text="@string/back"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:layout_marginStart="@dimen/fragment_details_text_back_margin_start"
        app:layout_constraintStart_toStartOf="@+id/btn_back"
        app:layout_constraintTop_toTopOf="@+id/btn_back"/>
    <TextView
        android:textAppearance="?attr/TextAppearance.VIVID.BYD.LargeTitle"
        android:textColor="?attr/title_color"
        android:ellipsize="none"
        android:gravity="start|center_vertical"
        android:id="@+id/tv_top_title"
        android:tag="binding_12"
        android:layout_width="0dp"
        android:layout_height="@dimen/common_btn_size"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:alpha="0"
        android:layout_marginStart="@dimen/fragment_details_text_back_margin_start"
        android:layout_marginEnd="@dimen/fragment_details_list_play_text_margin_left"
        app:layout_constraintEnd_toStartOf="@+id/play_all"
        app:layout_constraintStart_toStartOf="@+id/btn_back"
        app:layout_constraintTop_toTopOf="@+id/btn_back"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/btn_back"
        android:layout_width="@dimen/fragment_details_list_back_touch_area_min_width"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fragment_details_list_back_margin_top"
        android:onClick="onBackPressed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:background="?attr/button_bg"
            android:layout_width="@dimen/common_btn_size"
            android:layout_height="@dimen/common_btn_size">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="@dimen/common_btn_img_size"
                android:layout_height="@dimen/common_btn_img_size"
                android:src="?attr/btn_back"
                android:rotationY="@integer/locale_mirror_flip"/>
        </FrameLayout>
    </LinearLayout>
</androidx.constraintlayout.motion.widget.MotionLayout>
