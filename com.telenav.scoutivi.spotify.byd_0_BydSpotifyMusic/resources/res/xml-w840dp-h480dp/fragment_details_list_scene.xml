<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <ConstraintSet android:id="@+id/start">
        <Constraint
            android:scrollbarThumbVertical="?attr/common_scroll_bar_bg"
            android:scrollbarStyle="outsideOverlay"
            android:orientation="vertical"
            android:id="@+id/list_media"
            android:background="?attr/colorTransparent"
            android:scrollbars="vertical"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:verticalScrollbarPosition="defaultPosition"
            android:layout_marginStart="@dimen/fragment_details_list_viewpager_margin_start"
            android:layout_marginEnd="@dimen/portrait_artist_tab_layout_margin_end"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/img_cover"
            app:layout_constraintTop_toBottomOf="@+id/shimmer_play_all"
            app:layout_goneMarginTop="@dimen/fragment_details_list_vp_gone_margin_top"
            app:shimmer_layout="@layout/base_list_item_viewholder"
            app:visibilityMode="ignore"/>
        <Constraint
            android:id="@+id/top_layout"
            android:layout_width="0dp"
            android:layout_height="@dimen/fragment_details_list_play_btn_size"
            android:layout_marginTop="@dimen/fragment_detail_child_landscape_tab_layout_margin_top"
            android:layout_marginStart="@dimen/fragment_details_list_viewpager_margin_start"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/img_cover"
            app:layout_constraintTop_toTopOf="parent"
            app:visibilityMode="ignore"/>
        <Constraint
            android:id="@+id/shimmer_play_all"
            android:layout_width="@dimen/fragment_details_list_play_btn_size"
            android:layout_height="@dimen/fragment_details_list_play_btn_size"
            android:layout_marginTop="@dimen/fragment_detail_child_landscape_tab_layout_margin_top"
            android:layout_marginEnd="@dimen/fragment_details_logo_margin_right"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:visibilityMode="ignore"/>
        <Constraint
            android:id="@+id/topBg"
            android:layout_width="match_parent"
            android:layout_height="@dimen/common_top_bg_height"
            android:src="?attr/top_bg"
            android:alpha="0"
            android:layout_marginStart="@dimen/common_top_bg_margin_start"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <Constraint
            android:id="@+id/fl_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/fragment_details_list_title_margin_top"
            app:layout_constraintEnd_toEndOf="@+id/title"
            app:layout_constraintStart_toStartOf="@+id/title"
            app:layout_constraintTop_toBottomOf="@+id/img_cover"
            app:visibilityMode="ignore"/>
        <Constraint
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/fragment_details_list_title_margin_top"
            app:layout_constraintEnd_toStartOf="@+id/btn_favorite"
            app:layout_constraintStart_toStartOf="@+id/img_cover"
            app:layout_constraintTop_toBottomOf="@+id/img_cover"
            app:visibilityMode="ignore"/>
        <Constraint
            android:id="@+id/btn_favorite"
            android:layout_width="@dimen/common_btn_size"
            android:layout_height="@dimen/common_btn_size"
            android:layout_marginStart="@dimen/fragment_details_list_favorite_button_margin_start"
            app:layout_constraintBottom_toBottomOf="@+id/title"
            app:layout_constraintEnd_toEndOf="@+id/img_cover"
            app:layout_constraintStart_toEndOf="@+id/title"
            app:layout_constraintTop_toTopOf="@+id/title"
            app:visibilityMode="ignore"/>
        <Constraint
            android:id="@+id/subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/fragment_details_list_subtitle_margin_top"
            app:layout_constraintEnd_toEndOf="@+id/img_cover"
            app:layout_constraintStart_toStartOf="@+id/img_cover"
            app:layout_constraintTop_toBottomOf="@+id/title"
            app:visibilityMode="ignore"/>
        <Constraint
            android:id="@+id/error_layout"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/fragment_details_list_viewpager_margin_start"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/img_cover"
            app:layout_constraintTop_toTopOf="@+id/img_cover"
            app:visibilityMode="ignore"/>
    </ConstraintSet>
    <ConstraintSet
        android:id="@+id/end"
        app:deriveConstraintsFrom="@+id/start">
        <Constraint
            android:id="@+id/topBg"
            android:layout_width="match_parent"
            android:layout_height="@dimen/common_top_bg_height"
            android:src="?attr/top_bg"
            android:alpha="1"
            android:layout_marginStart="@dimen/common_top_bg_margin_start"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <Constraint
            android:id="@+id/top_layout"
            android:layout_width="0dp"
            android:layout_height="@dimen/fragment_details_list_play_btn_size"
            android:layout_marginTop="@dimen/fragment_details_list_top_layout_margin_top_finish"
            android:layout_marginStart="@dimen/fragment_details_list_viewpager_margin_start"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/img_cover"
            app:layout_constraintTop_toTopOf="parent"/>
        <Constraint
            android:id="@+id/logo"
            android:layout_width="@dimen/fragment_details_list_logo_width"
            android:layout_height="@dimen/fragment_details_list_logo_height"
            android:layout_marginTop="@dimen/fragment_details_logo_margin_top_finish"
            android:src="?attr/logo"
            android:layout_marginEnd="@dimen/fragment_details_logo_margin_right"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <Constraint
            android:id="@+id/error_layout"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/fragment_details_list_viewpager_margin_start"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/img_cover"
            app:layout_constraintTop_toTopOf="@+id/img_cover"
            app:visibilityMode="ignore"/>
        <Constraint
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="@dimen/common_header_height"
            android:layout_marginTop="@dimen/common_header_margin_top_end"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </ConstraintSet>
    <Transition
        android:id="@+id/transition_detail"
        app:autoTransition="none"
        app:constraintSetEnd="@+id/end"
        app:constraintSetStart="@+id/start"
        app:duration="200">
        <OnSwipe
            app:dragDirection="dragUp"
            app:touchAnchorId="@+id/view_pager"
            app:touchAnchorSide="top"/>
    </Transition>
</MotionScene>
