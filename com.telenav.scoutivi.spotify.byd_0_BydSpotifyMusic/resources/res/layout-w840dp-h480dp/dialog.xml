<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/act_permission_dialog_bg"
    android:layout_width="@dimen/dialog_width"
    android:layout_height="wrap_content"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <TextView
        android:textStyle="bold"
        android:textColor="?attr/act_permission_dialog_text_color"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dialog_title_margin_top"
        android:text="@string/dialog_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextAppearance.VIVID.BYD.Toast"/>
    <TextView
        android:textColor="?attr/act_permission_dialog_text_color"
        android:gravity="center"
        android:id="@+id/tv_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dialog_content_margin_top"
        android:text="@string/dialog_content"
        android:layout_marginHorizontal="@dimen/dialog_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        style="@style/TextAppearance.VIVID.BYD.Body"/>
    <TextView
        android:textColor="@color/colorDialogBtnText"
        android:gravity="center"
        android:id="@+id/btn_sure"
        android:background="?attr/act_permission_dialog_left_btn_bg"
        android:layout_width="@dimen/dialog_btn_width"
        android:layout_height="@dimen/dialog_btn_height"
        android:layout_marginTop="@dimen/dialog_content_margin_top"
        android:text="@string/dialog_go_to_set"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_content"
        style="@style/TextAppearance.VIVID.BYD.DIALOG.BTN"/>
    <TextView
        android:textColor="?attr/act_permission_dialog_text_color"
        android:gravity="center"
        android:id="@+id/btn_cancel"
        android:layout_width="@dimen/dialog_btn_width"
        android:layout_height="@dimen/dialog_btn_height"
        android:layout_marginTop="@dimen/dialog_btn_margin_top"
        android:layout_marginBottom="@dimen/dialog_btn_margin_top"
        android:text="@string/dialog_cancel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_sure"
        style="@style/TextAppearance.VIVID.BYD.DIALOG.BTN"/>
</androidx.constraintlayout.widget.ConstraintLayout>
