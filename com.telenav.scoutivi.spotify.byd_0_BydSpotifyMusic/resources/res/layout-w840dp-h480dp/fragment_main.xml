<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout-w840dp-h480dp/fragment_main_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toLeftOf="@+id/right_driver_root_menu"
        android:layout_toRightOf="@+id/root_menu"
        android:layout_alignParentTop="true"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/root_menu"
        android:tag="binding_1"
        android:background="?attr/rv_menu_bg"
        android:layout_width="@dimen/fragment_main_root_menu_width"
        android:layout_height="match_parent"
        android:layout_alignParentLeft="true"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/right_driver_root_menu"
        android:tag="binding_2"
        android:layout_width="@dimen/fragment_main_root_menu_width"
        android:layout_height="match_parent"
        android:layout_alignParentRight="true"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"/>
    <ImageView
        android:tag="binding_3"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/now_playing_bar_height"
        android:src="?attr/shadow_bg"
        android:scaleType="fitXY"
        android:layout_toRightOf="@+id/root_menu"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"/>
    <ImageView
        android:tag="binding_4"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/now_playing_bar_height"
        android:src="?attr/shadow_bg"
        android:scaleType="fitXY"
        android:layout_toLeftOf="@+id/right_driver_root_menu"
        android:layout_alignParentLeft="true"
        android:layout_alignParentBottom="true"/>
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toLeftOf="@+id/right_driver_root_menu"
        android:layout_toRightOf="@+id/root_menu">
        <RelativeLayout
            android:id="@+id/rl_container"
            android:tag="binding_5"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:behavior_draggable="true"
            app:behavior_hideable="false"
            app:behavior_peekHeight="@dimen/now_playing_bar_height"
            app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
            <FrameLayout
                android:padding="@dimen/now_playing_page_padding"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <FrameLayout
                    android:id="@+id/now_playing_page_bg"
                    android:background="?attr/now_playing_page_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:outlineProvider="bounds">
                    <FrameLayout
                        android:id="@+id/now_playing_page"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                </FrameLayout>
            </FrameLayout>
            <include
                android:id="@+id/bar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/now_playing_bar_height"
                layout="@layout/now_playing_bar"/>
        </RelativeLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</RelativeLayout>
