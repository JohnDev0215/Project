<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.motion.widget.MotionLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:tag="layout-w840dp-h480dp/fragment_details_list_0"
    android:paddingBottom="@dimen/fragment_details_list_padding_bottom"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/fragment_details_list_padding_left"
    app:layoutDescription="@xml/fragment_details_list_scene">
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:tag="binding_1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/fragment_detail_child_landscape_vp_layout_margin_top"
        android:layout_marginStart="@dimen/fragment_details_list_viewpager_margin_start"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/img_cover"
        app:layout_constraintTop_toBottomOf="@+id/top_layout"
        app:layout_goneMarginTop="@dimen/fragment_detail_child_landscape_tab_layout_margin_top"/>
    <View
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/common_header_height"
        android:layout_marginTop="@dimen/common_header_margin_top"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/topBg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/common_top_bg_height"
        android:src="?attr/top_bg"
        android:alpha="0"
        android:layout_marginStart="@dimen/common_top_bg_margin_start"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/logo"
        android:layout_width="@dimen/ic_spotify_logo_width"
        android:layout_height="@dimen/ic_spotify_logo_height"
        android:src="?attr/logo"
        android:layout_marginEnd="@dimen/fragment_details_logo_margin_right"
        app:layout_constraintBottom_toBottomOf="@+id/header"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/header"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/btn_back"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/common_back_btn_margin_top"
        android:minWidth="@dimen/fragment_details_list_back_touch_area_min_width"
        android:onClick="onBackPressed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:gravity="center"
            android:background="?attr/button_bg"
            android:layout_width="@dimen/common_btn_size"
            android:layout_height="@dimen/common_btn_size">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="@dimen/common_btn_img_size"
                android:layout_height="@dimen/common_btn_img_size"
                android:src="?attr/btn_back"
                android:rotationY="@integer/locale_mirror_flip"/>
        </FrameLayout>
        <TextView
            android:textAppearance="?attr/TextAppearance.VIVID.BYD.LargeTitle"
            android:textColor="?attr/title_color"
            android:ellipsize="none"
            android:gravity="center_vertical"
            android:tag="binding_2"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/common_btn_size"
            android:text="@string/back"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:layout_marginStart="@dimen/fragment_details_text_back_margin_start"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/img_cover"
        android:tag="binding_3"
        android:layout_width="@dimen/fragment_details_list_img_size"
        android:layout_height="@dimen/fragment_details_list_img_size"
        android:layout_marginTop="@dimen/fragment_details_list_img_margin_top"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBg"/>
    <FrameLayout
        android:id="@+id/title"
        android:tag="binding_4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fragment_details_list_title_margin_top"
        app:layout_constraintEnd_toStartOf="@+id/btn_favorite"
        app:layout_constraintStart_toStartOf="@+id/img_cover"
        app:layout_constraintTop_toBottomOf="@+id/img_cover">
        <TextView
            android:textAppearance="?attr/TextAppearance.VIVID.BYD.LargeTitle"
            android:textColor="?attr/title_color"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:tag="binding_5"
            android:padding="0dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/fragment_details_list_title_height"
            android:maxLines="2"
            android:includeFontPadding="false"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/fl_subtitle"
        android:tag="binding_6"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fragment_details_list_title_margin_top"
        app:layout_constraintEnd_toEndOf="@+id/title"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/img_cover">
        <TextView
            android:textAppearance="?attr/TextAppearance.VIVID.BYD.Primary.Navigation"
            android:textColor="?attr/title_color"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:tag="binding_7"
            android:padding="0dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/fragment_details_list_title_height"
            android:maxLines="2"
            android:includeFontPadding="false"
            android:alpha="0.6"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/btn_favorite"
        android:tag="binding_8"
        android:layout_width="@dimen/common_btn_size"
        android:layout_height="@dimen/common_btn_size"
        android:layout_marginStart="@dimen/fragment_details_list_favorite_button_margin_start"
        app:layout_constraintBottom_toBottomOf="@+id/title"
        app:layout_constraintEnd_toEndOf="@+id/img_cover"
        app:layout_constraintStart_toEndOf="@+id/title"
        app:layout_constraintTop_toTopOf="@+id/title">
        <ImageView
            android:tag="binding_9"
            android:layout_width="@dimen/now_playing_bar_other_button_size"
            android:layout_height="@dimen/now_playing_bar_other_button_size"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/subtitle"
        android:tag="binding_10"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fragment_details_list_subtitle_margin_top"
        app:layout_constraintEnd_toEndOf="@+id/img_cover"
        app:layout_constraintStart_toStartOf="@+id/img_cover"
        app:layout_constraintTop_toBottomOf="@+id/title">
        <TextView
            android:textAppearance="?attr/TextAppearance.VIVID.BYD.Primary.Navigation"
            android:textColor="?attr/title_color"
            android:ellipsize="none"
            android:gravity="start"
            android:tag="binding_11"
            android:padding="0dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:alpha="0.6"/>
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_layout"
        android:tag="binding_12"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="@dimen/fragment_details_list_play_btn_size"
        android:layout_marginTop="@dimen/fragment_detail_child_landscape_tab_layout_margin_top"
        android:layout_marginStart="@dimen/fragment_details_list_viewpager_margin_start"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/img_cover"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/play_all"
            android:tag="binding_13"
            android:visibility="visible"
            android:layout_width="@dimen/fragment_details_list_play_btn_size"
            android:layout_height="@dimen/fragment_details_list_play_btn_size"
            android:layout_marginEnd="@dimen/fragment_details_logo_margin_right"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:tag="binding_14"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/tab_layout_height"
            app:layout_constraintBottom_toBottomOf="@+id/play_all"
            app:layout_constraintStart_toStartOf="parent"
            app:tabPaddingEnd="@dimen/tab_padding_start_and_end"
            app:tabPaddingStart="@dimen/tab_padding_start_and_end"
            style="@style/detailTabLayoutStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.vivid.spotify.common.ui.shimmer.ShimmerLayout
        android:id="@+id/shimmer_play_all"
        android:tag="binding_15"
        android:layout_width="@dimen/fragment_details_list_play_btn_size"
        android:layout_height="@dimen/fragment_details_list_play_btn_size"
        android:layout_marginEnd="@dimen/fragment_details_logo_margin_right"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/img_cover"
        app:visibilityMode="ignore">
        <ImageView
            android:layout_width="@dimen/fragment_details_list_play_btn_size"
            android:layout_height="@dimen/fragment_details_list_play_btn_size"
            android:src="?attr/viewholder_btn_play"/>
    </com.vivid.spotify.common.ui.shimmer.ShimmerLayout>
    <com.vivid.spotify.common.ui.shimmer.ShimmerRecyclerView
        android:scrollbarThumbVertical="?attr/common_scroll_bar_bg"
        android:scrollbarStyle="outsideOverlay"
        android:orientation="vertical"
        android:id="@+id/list_media"
        android:tag="binding_16"
        android:background="?attr/colorTransparent"
        android:visibility="visible"
        android:scrollbars="vertical"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:verticalScrollbarPosition="defaultPosition"
        android:layout_marginStart="@dimen/fragment_details_list_viewpager_margin_start"
        android:layout_marginEnd="@dimen/portrait_artist_tab_layout_margin_end"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/img_cover"
        app:layout_constraintTop_toBottomOf="@+id/shimmer_play_all"
        app:layout_goneMarginTop="@dimen/fragment_details_list_vp_gone_margin_top"
        app:pagination_on="false"
        app:shimmer_layout="@layout/base_list_item_viewholder"/>
    <include
        android:id="@+id/error_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/fragment_details_list_viewpager_margin_start"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/img_cover"
        app:layout_constraintTop_toTopOf="@+id/img_cover"
        layout="@layout/common_error_layout"/>
</androidx.constraintlayout.motion.widget.MotionLayout>
