<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="layout-w840dp-h480dp/media_title_item_0"
    android:background="?attr/colorTransparent"
    android:layout_width="match_parent"
    android:layout_height="@dimen/media_title_height"
    android:layout_marginEnd="@dimen/media_title_margin_end">
    <TextView
        android:textAppearance="?attr/TextAppearance.VIVID.BYD.LargeTitle"
        android:textColor="?attr/title_color"
        android:gravity="center_vertical"
        android:id="@+id/group_title"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:singleLine="true"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true"/>
    <ImageView
        android:layout_width="@dimen/ic_spotify_logo_width"
        android:layout_height="@dimen/ic_spotify_logo_height"
        android:layout_marginTop="@dimen/media_list_parent_item_logo_margin_top"
        android:src="?attr/logo"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
