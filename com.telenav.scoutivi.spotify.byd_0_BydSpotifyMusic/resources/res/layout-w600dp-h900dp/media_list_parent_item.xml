<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout-w600dp-h900dp/media_list_parent_item_0"
    android:background="?attr/colorTransparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="?attr/TextAppearance.VIVID.BYD.LargeTitle"
        android:textColor="?attr/title_color"
        android:ellipsize="none"
        android:gravity="center_vertical"
        android:id="@+id/group_title"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/media_title_height"
        android:singleLine="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:tag="binding_2"
        android:layout_width="@dimen/ic_spotify_logo_width"
        android:layout_height="@dimen/ic_spotify_logo_height"
        android:layout_marginTop="@dimen/media_list_parent_item_logo_margin_top"
        android:src="?attr/logo"
        android:layout_marginEnd="@dimen/media_list_parent_item_logo_margin_end"
        android:layout_alignParentEnd="true"/>
    <com.vivid.spotify.common.ui.recyclerview.BaseRecyclerView
        android:orientation="horizontal"
        android:id="@+id/list_parent"
        android:tag="binding_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/group_title"
        app:limit_item_size="true"
        app:pagination_on="false"
        app:view_offset_size="@dimen/fragment_main_grid_item_margin_end"/>
</RelativeLayout>
