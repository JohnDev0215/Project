<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/fragment_main_grid_media_cover_item_margin_top"
    android:layout_marginBottom="@dimen/fragment_main_grid_media_cover_item_margin_bottom"
    app:layout_constraintDimensionRatio="228:318">
    <ImageView
        android:id="@+id/icon"
        android:background="?attr/viewholder_img_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:ellipsize="none"
        android:id="@+id/title"
        android:background="?attr/viewholder_title_bg"
        android:layout_width="0dp"
        android:layout_height="@dimen/media_cover_item_title_height"
        android:layout_marginTop="@dimen/media_cover_item_viewholder_title_margin_top"
        android:singleLine="true"
        android:layout_marginEnd="@dimen/media_cover_item_viewholder_title_margin_top"
        app:layout_constraintEnd_toStartOf="@+id/play_btn"
        app:layout_constraintStart_toStartOf="@+id/icon"
        app:layout_constraintTop_toBottomOf="@+id/icon"/>
    <TextView
        android:ellipsize="none"
        android:id="@+id/subtitle"
        android:background="?attr/viewholder_title_bg"
        android:layout_width="0dp"
        android:layout_height="@dimen/media_cover_item_title_height"
        android:layout_marginTop="@dimen/media_cover_item_viewholder_subtitle_margin_top"
        android:singleLine="true"
        android:layout_marginEnd="@dimen/media_cover_item_viewholder_title_margin_top"
        app:layout_constraintEnd_toStartOf="@+id/play_btn"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <ImageView
        android:id="@+id/play_btn"
        android:layout_width="@dimen/media_cover_item_play_icon_size"
        android:layout_height="@dimen/media_cover_item_play_icon_size"
        android:layout_marginTop="@dimen/media_cover_item_viewholder_play_icon_margin_top"
        android:src="?attr/cover_item_play_holder"
        app:layout_constraintEnd_toEndOf="@+id/icon"
        app:layout_constraintTop_toBottomOf="@+id/icon"/>
</androidx.constraintlayout.widget.ConstraintLayout>
