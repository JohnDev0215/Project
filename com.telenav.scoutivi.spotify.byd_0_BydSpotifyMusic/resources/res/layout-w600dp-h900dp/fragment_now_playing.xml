<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout-w600dp-h900dp/fragment_now_playing_0"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/now_playing_page_return_bar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:onClick="exitNowPlayingPage"
        app:layout_constraintBottom_toTopOf="@+id/cover"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="@dimen/now_playing_page_return_bar_width"
            android:layout_height="@dimen/now_playing_page_return_bar_height"
            android:layout_marginTop="@dimen/now_playing_page_return_bar_margin_top"
            android:src="?attr/return_bar"/>
    </FrameLayout>
    <ImageView
        android:id="@+id/logo"
        android:layout_width="@dimen/now_playing_page_logo_width"
        android:layout_height="@dimen/now_playing_page_logo_height"
        android:layout_marginTop="@dimen/portrait_now_playing_page_logo_margin_top"
        android:layout_marginRight="@dimen/portrait_now_playing_page_logo_margin_end"
        android:src="?attr/logo"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/playlist"
        android:tag="binding_1"
        android:layout_width="@dimen/portrait_now_playing_page_playlist_button_width"
        android:layout_height="@dimen/portrait_now_playing_page_playlist_button_height"
        android:onClick="onPlaylistClicked"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center"
            android:tag="binding_2"
            android:layout_width="@dimen/now_playing_page_playlist_button_size"
            android:layout_height="@dimen/now_playing_page_playlist_button_size"
            android:src="?attr/playlist"/>
    </FrameLayout>
    <include
        android:id="@+id/cover"
        android:layout_width="@dimen/portrait_now_playing_page_cover_size"
        android:layout_height="@dimen/portrait_now_playing_page_cover_size"
        android:layout_marginTop="@dimen/portrait_now_playing_page_cover_margin_top"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/logo"
        layout="@layout/layout_cover"/>
    <FrameLayout
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/portrait_now_playing_page_title_margin_top"
        android:layout_marginStart="@dimen/portrait_now_playing_page_title_margin_start"
        android:layout_marginEnd="@dimen/portrait_now_playing_page_title_margin_start"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cover">
        <TextView
            android:textColor="?attr/title_color"
            android:ellipsize="end"
            android:gravity="start|bottom"
            android:tag="binding_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/now_playing_bar_title_min_height"
            android:maxLines="2"
            android:includeFontPadding="false"
            android:textDirection="locale"
            style="@style/TextAppearance.VIVID.BYD.SuperLargeTitle"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/subtitle"
        android:tag="binding_4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/now_playing_page_subtitle_margin_top"
        android:layout_marginStart="@dimen/portrait_now_playing_page_title_margin_start"
        android:layout_marginEnd="@dimen/portrait_now_playing_page_title_margin_start"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title">
        <TextView
            android:textColor="?attr/now_playing_subtitle_text_color"
            android:ellipsize="none"
            android:gravity="start"
            android:tag="binding_5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:textDirection="locale"
            style="@style/TextAppearance.VIVID.BYD.CustomizedTitle"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/control_button_speed"
        android:tag="binding_6"
        android:layout_width="@dimen/now_playing_page_speed_button_width"
        android:layout_height="@dimen/now_playing_page_speed_button_height"
        android:layout_marginLeft="@dimen/portrait_now_playing_page_speed_button_margin_start"
        android:layout_marginTop="@dimen/now_playing_page_speed_button_margin_top"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/subtitle">
        <ImageView
            android:layout_gravity="center"
            android:tag="binding_7"
            android:layout_width="@dimen/now_playing_page_other_button_width"
            android:layout_height="@dimen/now_playing_page_other_button_width"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/control_button_collect"
        android:tag="binding_8"
        android:layout_width="@dimen/now_playing_page_speed_button_width"
        android:layout_height="@dimen/now_playing_page_speed_button_height"
        android:layout_marginTop="@dimen/now_playing_page_speed_button_margin_top"
        android:layout_marginRight="@dimen/portrait_now_playing_page_collect_button_margin_end"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/subtitle">
        <ImageView
            android:layout_gravity="center"
            android:tag="binding_9"
            android:layout_width="@dimen/now_playing_bar_like_button_size"
            android:layout_height="@dimen/now_playing_bar_like_button_size"/>
    </FrameLayout>
    <androidx.appcompat.widget.AppCompatSeekBar
        android:id="@+id/seek_bar"
        android:tag="binding_10"
        android:layout_width="0dp"
        android:layout_height="@dimen/now_playing_page_seekbar_layout_height"
        android:layout_marginTop="@dimen/portrait_now_playing_page_seekbar_margin_top"
        android:progress="0"
        android:progressDrawable="?attr/media_progress_bar_bg"
        android:thumb="?attr/seekbar_dot"
        android:thumbOffset="@dimen/portrait_now_playing_page_thumb_offset"
        android:foregroundGravity="center"
        android:layout_marginStart="@dimen/portrait_now_playing_page_seekbar_margin_start"
        android:layout_marginEnd="@dimen/portrait_now_playing_page_seekbar_margin_end"
        android:mirrorForRtl="false"
        android:splitTrack="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/control_button_collect"/>
    <RelativeLayout
        android:id="@+id/time_info_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/portrait_now_playing_page_title_margin_start"
        android:layout_marginEnd="@dimen/portrait_now_playing_page_title_margin_start"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/seek_bar">
        <TextView
            android:textColor="?attr/now_playing_rest_time_text_color"
            android:gravity="center"
            android:id="@+id/rest_time"
            android:tag="binding_11"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            style="@style/TextAppearance.VIVID.BYD.Body"/>
        <TextView
            android:textColor="?attr/now_playing_rest_time_text_color"
            android:gravity="center"
            android:id="@+id/duration"
            android:tag="binding_12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            style="@style/TextAppearance.VIVID.BYD.Body"/>
    </RelativeLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_menu"
        android:layout_width="0dp"
        android:layout_height="@dimen/now_playing_page_button_click_area"
        android:layout_marginTop="@dimen/portrait_now_playing_page_bottom_buttons_margin_top"
        android:layout_marginStart="@dimen/portrait_now_playing_page_bottom_button_margin_start"
        android:layout_marginEnd="@dimen/portrait_now_playing_page_bottom_button_margin_start"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/time_info_layout">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/control_button4"
            android:tag="binding_13"
            android:layout_width="@dimen/now_playing_page_button_click_area"
            android:layout_height="@dimen/now_playing_page_button_click_area"
            app:layout_constraintBottom_toBottomOf="@+id/control_button_play"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/control_button_play">
            <ImageView
                android:id="@+id/iv_icon4"
                android:tag="binding_14"
                android:layout_width="@dimen/now_playing_page_other_button_width"
                android:layout_height="@dimen/now_playing_page_other_button_height"
                android:layout_marginTop="@dimen/now_playing_page_other_button_margin_top"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <FrameLayout
            android:id="@+id/control_button2"
            android:tag="binding_15"
            android:layout_width="@dimen/now_playing_page_button_click_area"
            android:layout_height="@dimen/now_playing_page_button_click_area"
            app:layout_constraintBottom_toBottomOf="@+id/control_button_play"
            app:layout_constraintEnd_toStartOf="@+id/control_button_play"
            app:layout_constraintStart_toEndOf="@+id/control_button4"
            app:layout_constraintTop_toTopOf="@+id/control_button_play">
            <ImageView
                android:layout_gravity="center"
                android:tag="binding_16"
                android:layout_width="@dimen/now_playing_page_other_button_width"
                android:layout_height="@dimen/now_playing_page_other_button_width"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/control_button_play"
            android:tag="binding_17"
            android:layout_width="@dimen/now_playing_page_button_click_area"
            android:layout_height="@dimen/now_playing_page_button_click_area"
            app:layout_constraintEnd_toStartOf="@+id/control_button5"
            app:layout_constraintStart_toEndOf="@+id/control_button4"
            app:layout_constraintTop_toTopOf="parent">
            <ProgressBar
                android:theme="@style/CircularGrayProgress"
                android:layout_gravity="center"
                android:id="@+id/status_loading_pandora"
                android:tag="binding_18"
                android:layout_width="@dimen/now_playing_page_buffering_size"
                android:layout_height="@dimen/now_playing_page_buffering_size"
                android:indeterminateDrawable="?attr/grey_progress"
                android:progressDrawable="?attr/grey_progress"
                style="@style/Widget.AppCompat.ProgressBar"/>
            <ImageView
                android:layout_gravity="center"
                android:tag="binding_19"
                android:layout_width="@dimen/now_playing_page_play_button_size"
                android:layout_height="@dimen/now_playing_page_play_button_size"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/control_button3"
            android:tag="binding_20"
            android:layout_width="@dimen/now_playing_page_button_click_area"
            android:layout_height="@dimen/now_playing_page_button_click_area"
            app:layout_constraintBottom_toBottomOf="@+id/control_button_play"
            app:layout_constraintEnd_toStartOf="@+id/control_button5"
            app:layout_constraintStart_toEndOf="@+id/control_button_play"
            app:layout_constraintTop_toTopOf="@+id/control_button_play">
            <ImageView
                android:layout_gravity="center"
                android:tag="binding_21"
                android:layout_width="@dimen/now_playing_page_other_button_width"
                android:layout_height="@dimen/now_playing_page_other_button_width"/>
        </FrameLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/control_button5"
            android:tag="binding_22"
            android:layout_width="@dimen/now_playing_page_button_click_area"
            android:layout_height="@dimen/now_playing_page_button_click_area"
            app:layout_constraintBottom_toBottomOf="@+id/control_button_play"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/control_button_play">
            <ImageView
                android:id="@+id/iv_icon5"
                android:tag="binding_23"
                android:layout_width="@dimen/now_playing_page_other_button_width"
                android:layout_height="@dimen/now_playing_page_other_button_height"
                android:layout_marginTop="@dimen/now_playing_page_other_button_margin_top"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
