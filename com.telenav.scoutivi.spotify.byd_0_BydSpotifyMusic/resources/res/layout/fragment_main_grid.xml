<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_main_grid_0"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/category_grid_rv_margin_start">
    <View
        android:id="@+id/top_rule_view"
        android:tag="binding_1"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="@dimen/fragment_main_mask_long_margin_top"
        android:layout_marginTop="@dimen/fragment_main_grid_padding_top"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.vivid.spotify.common.ui.shimmer.ShimmerRecyclerView
        android:scrollbarSize="@dimen/scrollbar_width"
        android:scrollbarThumbVertical="?attr/common_scroll_bar_bg"
        android:scrollbarStyle="outsideOverlay"
        android:id="@+id/list_media"
        android:tag="binding_2"
        android:background="?attr/colorTransparent"
        android:paddingBottom="@dimen/fragment_main_grid_padding_bottom"
        android:scrollbars="vertical"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:overScrollMode="never"
        android:verticalScrollbarPosition="defaultPosition"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_rule_view"
        app:layout_goneMarginTop="@dimen/fragment_main_grid_without_back_padding_top"
        app:pagination_on="false"/>
    <ImageView
        android:id="@+id/topBg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/common_top_bg_height"
        android:src="?attr/top_bg"
        android:layout_marginStart="@dimen/common_top_bg_margin_start"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/grid_btn_back"
        android:tag="binding_3"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fragment_main_grid_without_back_padding_top"
        android:minWidth="@dimen/fragment_details_list_back_touch_area_min_width"
        android:onClick="onBackPressed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:background="?attr/button_bg"
            android:layout_width="@dimen/grid_btn_back_size"
            android:layout_height="@dimen/grid_btn_back_size">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="@dimen/common_btn_img_size"
                android:layout_height="@dimen/common_btn_img_size"
                android:src="?attr/btn_back"
                android:rotationY="@integer/locale_mirror_flip"/>
        </FrameLayout>
        <TextView
            android:textAppearance="?attr/TextAppearance.VIVID.BYD.LargeTitle"
            android:textColor="?attr/title_color"
            android:ellipsize="none"
            android:gravity="center_vertical"
            android:tag="binding_4"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/grid_btn_back_size"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:layout_marginStart="@dimen/fragment_main_grid_title_margin_left"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/iv_right_top"
        android:tag="binding_5"
        android:layout_width="@dimen/ic_spotify_logo_width"
        android:layout_height="@dimen/ic_spotify_logo_height"
        android:layout_marginTop="@dimen/media_list_parent_item_logo_margin_top"
        android:src="?attr/logo"
        android:layout_marginEnd="@dimen/media_list_parent_item_logo_margin_end"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/grid_btn_back"/>
    <include
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/grid_btn_back"
        layout="@layout/common_error_layout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
