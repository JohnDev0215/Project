<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/list_speed_item_0"
    android:layout_width="match_parent"
    android:layout_height="@dimen/now_playing_page_speed_list_item_height">
    <ImageView
        android:id="@+id/icon"
        android:tag="binding_1"
        android:layout_width="@dimen/now_playing_page_speed_item_icon_size"
        android:layout_height="@dimen/now_playing_page_speed_item_icon_size"
        android:layout_marginStart="@dimen/now_playing_page_speed_list_start"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/checked"
        android:tag="binding_2"
        android:visibility="invisible"
        android:layout_width="@dimen/now_playing_page_speed_item_selected_icon_size"
        android:layout_height="@dimen/now_playing_page_speed_item_selected_icon_size"
        android:src="@drawable/item_checked"
        android:layout_marginEnd="@dimen/now_playing_page_speed_list_start"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
