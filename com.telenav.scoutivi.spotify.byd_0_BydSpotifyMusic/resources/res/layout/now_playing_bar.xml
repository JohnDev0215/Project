<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/now_playing_bar_0"
    android:padding="@dimen/now_playing_bar_padding"
    android:paddingBottom="@dimen/now_playing_bar_padding"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:tag="binding_1"
        android:background="?attr/now_playing_bar_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:onClick="gotoNowPlayingFragment"
        android:elevation="@dimen/shadow_elevation"
        android:outlineProvider="bounds">
        <ImageView
            android:layout_width="@dimen/now_playing_bar_return_bar_width"
            android:layout_height="@dimen/now_playing_page_return_bar_height"
            android:layout_marginTop="@dimen/now_playing_bar_return_bar_margin_top"
            android:src="?attr/return_bar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <include
            android:id="@+id/now_playing_bar_cover"
            android:layout_width="@dimen/now_playing_bar_cover_size"
            android:layout_height="@dimen/now_playing_bar_cover_size"
            android:layout_marginStart="@dimen/now_playing_bar_cover_margin_start"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/layout_cover"/>
        <FrameLayout
            android:id="@+id/control_button_skip_to_next"
            android:tag="binding_2"
            android:layout_width="@dimen/now_playing_bar_other_button_click_area"
            android:layout_height="@dimen/now_playing_bar_other_button_click_area"
            android:layout_marginEnd="@dimen/portrait_now_playing_bar_skip_to_next_button_margin_end"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_gravity="center"
                android:tag="binding_3"
                android:layout_width="@dimen/now_playing_bar_other_button_size"
                android:layout_height="@dimen/now_playing_bar_other_button_size"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/control_button_play"
            android:tag="binding_4"
            android:layout_width="@dimen/now_playing_bar_play_button_click_area"
            android:layout_height="@dimen/now_playing_bar_play_button_click_area"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/control_button_skip_to_next"
            app:layout_constraintTop_toTopOf="parent">
            <ProgressBar
                android:theme="@style/CircularGrayProgress"
                android:layout_gravity="center"
                android:id="@+id/status_loading_pandora"
                android:tag="binding_5"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminateDrawable="?attr/grey_progress"
                android:progressDrawable="?attr/grey_progress"
                style="@style/Widget.AppCompat.ProgressBar"/>
            <ImageView
                android:layout_gravity="center"
                android:tag="binding_6"
                android:layout_width="@dimen/now_playing_bar_play_button_size"
                android:layout_height="@dimen/now_playing_bar_play_button_size"/>
        </FrameLayout>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:id="@+id/title_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/portrait_now_playing_bar_title_margin_start"
            android:layout_marginEnd="@dimen/portrait_now_playing_bar_title_margin_end"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/control_button_play"
            app:layout_constraintStart_toEndOf="@+id/now_playing_bar_cover"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textStyle="bold"
                android:textColor="?attr/title_color"
                android:ellipsize="none"
                android:id="@+id/now_playing_bar_title"
                android:tag="binding_7"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                style="@style/TextAppearance.VIVID.BYD.Body"/>
            <TextView
                android:textColor="?attr/now_playing_subtitle_text_color"
                android:ellipsize="none"
                android:id="@+id/now_playing_bar_subtitle"
                android:tag="binding_8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/now_playing_bar_subtitle_margin"
                android:singleLine="true"
                style="@style/TextAppearance.VIVID.BYD.Supplementary.Body"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
