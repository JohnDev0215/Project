<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/base_list_item_0"
    android:layout_width="match_parent"
    android:layout_height="@dimen/base_list_item_height"
    android:paddingStart="@dimen/base_list_item_padding">
    <ImageView
        android:id="@+id/img_cover"
        android:tag="binding_1"
        android:layout_width="@dimen/base_list_item_img_size"
        android:layout_height="@dimen/base_list_item_img_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/playing_animation"
        android:tag="binding_2"
        android:layout_width="@dimen/base_list_item_playing_animation_size"
        android:layout_height="@dimen/base_list_item_playing_animation_size"
        app:layout_constraintBottom_toBottomOf="@+id/img_cover"
        app:layout_constraintEnd_toEndOf="@+id/img_cover"
        app:layout_constraintStart_toStartOf="@+id/img_cover"
        app:layout_constraintTop_toTopOf="@+id/img_cover"/>
    <FrameLayout
        android:id="@+id/right_img"
        android:tag="binding_3"
        android:layout_width="@dimen/base_list_item_right_button_width"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center"
            android:tag="binding_4"
            android:layout_width="@dimen/add_to_queue_button_size"
            android:layout_height="@dimen/add_to_queue_button_size"/>
    </FrameLayout>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/base_list_item_padding"
        android:layout_marginEnd="@dimen/base_list_item_title_margin_end"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/img_cover"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textAppearance="?attr/TextAppearance.VIVID.BYD.Body"
            android:textColor="?attr/list_item_text_color"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/title"
            android:tag="binding_5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:tag="binding_6"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/base_list_item_title_padding"
            android:minHeight="@dimen/base_list_item_subtitle_min_height">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/marking_img"
                android:tag="binding_7"
                android:visibility="gone"
                android:layout_width="@dimen/base_list_item_marking_img_size"
                android:layout_height="@dimen/base_list_item_marking_img_size"
                android:layout_marginEnd="@dimen/base_list_item_title_padding"/>
            <TextView
                android:textAppearance="?attr/TextAppearance.VIVID.BYD.Body"
                android:textColor="?attr/base_list_subtitle_text_color"
                android:ellipsize="none"
                android:gravity="start|center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@+id/subtitle"
                android:tag="binding_8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/base_list_item_subtitle_min_height"
                android:singleLine="true"
                android:layout_marginEnd="@dimen/base_list_item_progress_bar_margin_start"/>
            <ProgressBar
                android:layout_gravity="center_vertical"
                android:tag="binding_9"
                android:layout_width="@dimen/base_list_item_progress_bar_width"
                android:layout_height="@dimen/base_list_item_progress_bar_height"
                android:max="1000"
                android:progressDrawable="@drawable/progress_bar"
                style="?android:attr/progressBarStyleHorizontal"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.constraintlayout.widget.ConstraintLayout>
