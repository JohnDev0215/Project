<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/search_layout"
    android:tag="layout/fragment_search_0"
    android:paddingBottom="@dimen/fragment_details_list_padding_bottom"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/category_grid_rv_margin_start">
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:tag="binding_1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/fragment_search_viewpager_margin_top"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tabLayout"/>
    <ImageView
        android:id="@+id/topBg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/fragment_search_top_bg_height"
        android:src="?attr/top_bg"
        android:layout_marginStart="@dimen/common_top_bg_margin_start"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <RelativeLayout
        android:id="@+id/input_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/fragment_search_input_height"
        android:layout_marginTop="@dimen/fragment_main_grid_without_back_padding_top"
        android:layout_marginEnd="@dimen/media_list_parent_item_logo_margin_end"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="?attr/search_input_bg"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="@dimen/fragment_search_input_height"
            android:maxWidth="@dimen/fragment_search_input_width"
            android:layout_alignParentStart="true">
            <androidx.appcompat.widget.AppCompatEditText
                android:textAppearance="?attr/TextAppearance.VIVID.BYD.CustomizedTitle"
                android:textColor="?attr/title_color"
                android:id="@+id/edit_search"
                android:tag="binding_2"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:singleLine="true"
                android:inputType="text"
                android:imeOptions="flagNoExtractUi|actionSearch"
                android:paddingStart="@dimen/fragment_search_input_padding_start"
                android:paddingEnd="@dimen/fragment_search_input_padding_end"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/icon_search"
                android:layout_width="@dimen/fragment_search_icon_search_size"
                android:layout_height="@dimen/fragment_search_icon_search_size"
                android:src="?attr/icon_search"
                android:layout_marginStart="@dimen/fragment_search_input_view_padding_start"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <LinearLayout
                android:gravity="center"
                android:id="@+id/icon_remove"
                android:tag="binding_3"
                android:background="?attr/button_bg"
                android:layout_width="@dimen/common_btn_size"
                android:layout_height="@dimen/common_btn_size"
                android:layout_marginEnd="@dimen/fragment_search_input_view_padding_end"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:layout_width="@dimen/fragment_search_icon_remove_size"
                    android:layout_height="@dimen/fragment_search_icon_remove_size"
                    android:src="?attr/icon_remove"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </RelativeLayout>
    <TextView
        android:textAppearance="?attr/TextAppearance.VIVID.BYD.LargeTitle"
        android:textColor="?attr/title_color"
        android:ellipsize="none"
        android:id="@+id/title"
        android:tag="binding_4"
        android:padding="0dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fragment_search_title_margin_top"
        android:text="@string/recent_searches"
        android:singleLine="true"
        android:includeFontPadding="false"
        app:layout_constraintStart_toStartOf="@+id/input_layout"
        app:layout_constraintTop_toBottomOf="@+id/input_layout"/>
    <TextView
        android:textAppearance="?attr/TextAppearance.VIVID.BYD.CustomizedTitle"
        android:textColor="?attr/title_color"
        android:ellipsize="none"
        android:tag="binding_5"
        android:padding="0dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/clear_all"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:layout_marginEnd="@dimen/fragment_search_padding_end"
        app:layout_constraintBottom_toBottomOf="@+id/title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title"/>
    <FrameLayout
        android:tag="binding_6"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/fragment_search_tab_margin_top"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title">
        <com.vivid.labels.LabelsView
            android:id="@+id/labels_view"
            android:tag="binding_7"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:item_background="?attr/label_item_bg"
            app:item_height="@dimen/labels_item_height"
            app:item_max_width="@dimen/labels_item_max_width"
            app:item_padding="@dimen/labels_item_padding"
            app:line_margin="@dimen/labels_item_margin_bottom"
            app:max_lines="3"
            app:textAppearance="?attr/TextAppearance.VIVID.BYD.Supplementary.Body"
            app:textColor="?attr/title_color"
            app:word_margin="@dimen/labels_item_margin_right"/>
    </FrameLayout>
    <TextView
        android:textAppearance="?attr/TextAppearance.VIVID.BYD.CustomizedTitle"
        android:textColor="?attr/title_color"
        android:id="@+id/hint_empty_data"
        android:tag="binding_8"
        android:padding="0dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fragment_search_hint_title_margin_top"
        android:text="@string/something_wrong"
        android:includeFontPadding="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/input_layout"/>
    <TextView
        android:textAppearance="?attr/TextAppearance.VIVID.BYD.CustomizedTitle"
        android:textColor="?attr/title_color"
        android:id="@+id/hint_title"
        android:tag="binding_9"
        android:padding="0dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fragment_search_hint_title_margin_top"
        android:text="@string/play_what_you_love"
        android:includeFontPadding="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/input_layout"/>
    <TextView
        android:textAppearance="?attr/TextAppearance.VIVID.BYD.Primary.Navigation"
        android:textColor="?attr/title_color"
        android:id="@+id/hint_subtitle"
        android:tag="binding_10"
        android:padding="0dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fragment_search_hint_subtitle_margin_top"
        android:text="@string/search_for_something"
        android:includeFontPadding="false"
        android:alpha="0.6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/hint_title"/>
    <com.vivid.spotify.common.ui.BaseTabLayout
        android:id="@+id/tabLayout"
        android:tag="binding_11"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/tab_layout_height"
        android:layout_marginTop="@dimen/fragment_search_tab_margin_top"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/input_layout"
        app:tabPaddingEnd="@dimen/tab_padding_start_and_end"
        app:tabPaddingStart="@dimen/tab_padding_start_and_end"
        style="@style/tabLayoutStyle"/>
    <include
        android:id="@+id/shimmer_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/fragment_search_tab_margin_top"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/input_layout"
        layout="@layout/fragment_search_shimmer"/>
</androidx.constraintlayout.widget.ConstraintLayout>
