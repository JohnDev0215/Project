<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/rv_double_grid_item_0"
    android:background="@drawable/bg_ripple"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/fragment_main_grid_media_cover_item_margin_top"
    android:layout_marginBottom="@dimen/fragment_main_grid_media_cover_item_margin_bottom">
    <TextView
        android:textSize="@dimen/liked_song_info_text_size"
        android:ellipsize="end"
        android:gravity="start|top"
        android:id="@+id/tv_content"
        android:tag="binding_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/liked_song_item_song_info_margin_top"
        android:maxLines="3"
        android:lines="3"
        android:includeFontPadding="false"
        android:layout_marginStart="@dimen/liked_song_item_song_info_margin_start"
        android:layout_marginEnd="@dimen/liked_song_item_song_info_margin_start"
        android:lineHeight="@dimen/liked_song_info_line_height"
        android:textFontWeight="400"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/liked_song_title_margin_bottom"
        android:layout_marginStart="@dimen/liked_song_title_margin_start"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn_play"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textSize="@dimen/font_size_body"
            android:textStyle="bold"
            android:textColor="?attr/shared_white_text_color"
            android:ellipsize="none"
            android:tag="binding_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            textAppearance="?attr/TextAppearance.VIVID.BYD.Body.Bold"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/liked_song_sub_title_margin_top"
        android:layout_marginStart="@dimen/liked_song_title_margin_start"
        app:layout_constraintEnd_toStartOf="@+id/btn_play"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title">
        <TextView
            android:textAppearance="?attr/TextAppearance.VIVID.BYD.Primary.Navigation"
            android:textColor="@color/colorSharedWhite"
            android:ellipsize="none"
            android:tag="binding_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:alpha="0.6"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="end"
        android:id="@+id/btn_play"
        android:tag="binding_4"
        android:visibility="invisible"
        android:layout_width="@dimen/media_cover_item_play_icon_bg_width"
        android:layout_height="@dimen/media_cover_item_play_icon_bg_size"
        android:layout_marginEnd="@dimen/media_cover_item_btn_play_margin_end"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <ImageView
            android:tag="binding_5"
            android:layout_width="@dimen/media_cover_item_play_icon_size"
            android:layout_height="@dimen/media_cover_item_play_icon_size"
            android:layout_marginTop="@dimen/media_cover_double_item_play_margin_top"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
