<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_login_0"
    android:background="?attr/app_bg_color"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:soundEffectsEnabled="false">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <ImageView
            android:id="@+id/logo"
            android:layout_width="@dimen/fragment_login_logo_width"
            android:layout_height="@dimen/fragment_login_logo_height"
            android:src="@drawable/ic_spotify_logo"
            android:onClick="toggleDriveMode"/>
        <TextView
            android:textColor="?attr/title_color"
            android:ellipsize="none"
            android:id="@+id/title"
            android:tag="binding_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/fragment_login_title_margin_top"
            android:singleLine="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/logo"
            style="@style/TextAppearance.VIVID.BYD.CustomizedTitle"/>
        <Button
            android:textAppearance="?attr/TextAppearance.VIVID.BYD.CustomizedTitle"
            android:textStyle="bold"
            android:textColor="?attr/login_btn_text_color"
            android:ellipsize="none"
            android:gravity="center"
            android:id="@+id/btn_login"
            android:tag="binding_2"
            android:background="@drawable/btn_reload"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/common_layout_btn_text_height"
            android:layout_marginTop="@dimen/fragment_login_btn_margin_top"
            android:singleLine="true"
            android:onClick="login"
            android:textAllCaps="true"
            android:paddingStart="@dimen/common_layout_text_padding_horizontal"
            android:paddingEnd="@dimen/common_layout_text_padding_horizontal"/>
    </LinearLayout>
</RelativeLayout>
