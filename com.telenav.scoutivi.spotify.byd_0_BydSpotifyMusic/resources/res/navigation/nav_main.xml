<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_main"
    app:startDestination="@+id/emptyFragment">
    <action
        android:id="@+id/action_global_gridFragment"
        app:destination="@+id/gridFragment"/>
    <action
        android:id="@+id/action_global_detailFragment"
        app:destination="@+id/detailFragment"/>
    <action
        android:id="@+id/action_global_searchFragment"
        app:destination="@+id/searchFragment"/>
    <action
        android:id="@+id/action_global_nowPlayingFragment"
        app:destination="@+id/nowPlayingFragment"/>
    <action
        android:id="@+id/action_global_queueFragment"
        app:destination="@+id/queueFragment"/>
    <fragment
        android:label="search"
        android:name="com.vivid.spotify.search.SearchFragment"
        android:id="@+id/searchFragment"/>
    <fragment
        android:label="category"
        android:name="com.vivid.spotify.rootui.category.CategoryFragment"
        android:id="@+id/categoryFragment"/>
    <fragment
        android:label="main"
        android:name="com.vivid.spotify.rootui.GridFragment"
        android:id="@+id/gridFragment"/>
    <fragment
        android:label="rootGrid"
        android:name="com.vivid.spotify.rootui.GridFragment"
        android:id="@+id/rootGridFragment"/>
    <fragment
        android:label="empty"
        android:name="com.vivid.spotify.EmptyFragment"
        android:id="@+id/emptyFragment">
        <action
            android:id="@+id/action_to_rootGridFragment"
            app:destination="@+id/rootGridFragment"/>
        <action
            android:id="@+id/action_global_categoryFragment"
            app:destination="@+id/categoryFragment"/>
    </fragment>
    <fragment
        android:label="detail"
        android:name="com.vivid.spotify.details.DetailFragment"
        android:id="@+id/detailFragment"/>
    <fragment
        android:label="now_playing"
        android:name="com.vivid.spotify.nowplaying.NowPlayingFragment"
        android:id="@+id/nowPlayingFragment"/>
    <fragment
        android:label="queue"
        android:name="com.vivid.spotify.queue.QueueFragment"
        android:id="@+id/queueFragment"/>
</navigation>
