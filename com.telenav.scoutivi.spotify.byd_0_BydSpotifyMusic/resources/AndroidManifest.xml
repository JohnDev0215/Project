<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="116065"
    android:versionName="4.4.1.0-D_16"
    android:compileSdkVersion="34"
    android:compileSdkVersionCodename="14"
    package="com.telenav.scoutivi.spotify.byd"
    platformBuildVersionCode="34"
    platformBuildVersionName="14">
    <uses-sdk
        android:minSdkVersion="28"
        android:targetSdkVersion="29"/>
    <uses-permission android:name="android.permission.BYDAUTO_GEARBOX_COMMON"/>
    <uses-permission android:name="android.permission.BYDAUTO_GEARBOX_GET"/>
    <uses-permission android:name="android.permission.BYDAUTO_GEARBOX_SET"/>
    <uses-permission android:name="android.permission.START_ACTIVITIES_FROM_BACKGROUND"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <queries>
        <intent>
            <action android:name="android.media.browse.MediaBrowserService"/>
        </intent>
    </queries>
    <application
        android:theme="@style/Theme_VIVID_MUSIC_DX"
        android:label="@string/app_name"
        android:icon="@mipmap/icon_spotify"
        android:name="com.telenav.scoutivi.spotify.byd.BYDApplication"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:extractNativeLibs="false"
        android:resizeableActivity="true"
        android:networkSecurityConfig="@xml/net_config"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:requestLegacyExternalStorage="true">
        <service
            android:name="com.vivid.spotify.service.MediaManagerService"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.vivid.spotify.service.action.MediaManagerService"/>
            </intent-filter>
        </service>
        <meta-data
            android:name="com.vivid.music.classname"
            android:value="com.spotify.automotive.base.service.AAMMediaBrowserService"/>
        <meta-data
            android:name="com.vivid.music.packagename"
            android:value="com.spotify.music"/>
        <activity
            android:name="com.vivid.spotify.PermissionActivity"
            android:launchMode="singleTask"
            android:configChanges="smallestScreenSize|screenSize|screenLayout|orientation"/>
        <activity
            android:name="com.vivid.spotify.MainActivity"
            android:exported="true"
            android:launchMode="standard"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <service
            android:name="com.vivid.carcontroller.byd.dx.RestoreStateService"
            android:exported="true"/>
        <receiver
            android:name="com.vivid.carcontroller.byd.dx.DeviceBroadcastReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="byd.intent.action.MEDIA_MODE"/>
                <action android:name="byd.intent.action.KILL_SPOTIFY"/>
                <action android:name="com.spotify.music_StopPlayButPlayMemoryEnable"/>
            </intent-filter>
        </receiver>
        <meta-data
            android:name="com.bumptech.glide.integration.okhttp3.OkHttpGlideModule"
            android:value="GlideModule"/>
        <provider
            android:name="androidx.lifecycle.ProcessLifecycleOwnerInitializer"
            android:exported="false"
            android:multiprocess="true"
            android:authorities="com.telenav.scoutivi.spotify.byd.lifecycle-process"/>
    </application>
</manifest>
