<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/recommend_title_height">
        <RelativeLayout
            android:id="@+id/recommend_title_feature"
            android:layout_width="@dimen/recommend_title_width"
            android:layout_height="@dimen/recommend_title_height">
            <ImageView
                android:id="@+id/feature_title_image"
                android:layout_width="@dimen/recommend_title_image_size"
                android:layout_height="@dimen/recommend_title_image_size"
                android:scaleType="centerInside"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="@dimen/recommend_title_name_text_size"
                android:gravity="center"
                android:id="@+id/feature_title_name"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/recommend_title_feature"
                android:layout_toRightOf="@+id/feature_title_image"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/dp_6"/>
            <View
                android:id="@+id/feature_title_sign"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/recommend_title_sign"
                android:layout_alignParentBottom="true"
                android:layout_alignStart="@+id/feature_title_image"
                android:layout_alignEnd="@+id/feature_title_name"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/recommend_title_scene"
            android:layout_width="@dimen/recommend_title_width"
            android:layout_height="@dimen/recommend_title_height"
            android:layout_toRightOf="@+id/recommend_title_feature"
            android:layout_marginStart="@dimen/dp_30">
            <ImageView
                android:id="@+id/scene_title_image"
                android:layout_width="@dimen/recommend_title_image_size"
                android:layout_height="@dimen/recommend_title_image_size"
                android:scaleType="centerInside"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="@dimen/recommend_title_name_text_size"
                android:gravity="center"
                android:id="@+id/scene_title_name"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/recommend_title_scene"
                android:layout_toRightOf="@+id/scene_title_image"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/dp_6"/>
            <View
                android:id="@+id/scene_title_sign"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/recommend_title_sign"
                android:layout_alignParentBottom="true"
                android:layout_alignStart="@+id/scene_title_image"
                android:layout_alignEnd="@+id/scene_title_name"/>
        </RelativeLayout>
    </RelativeLayout>
    <View
        android:id="@+id/space_feature"
        android:layout_width="match_parent"
        android:layout_height="@dimen/recommend_space_height"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nested_scroll_view"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:focusableInTouchMode="true"
            android:descendantFocusability="blocksDescendants"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/layout_feature"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:id="@+id/video_player_feature_container"
                    android:layout_width="@dimen/recommend_video_width"
                    android:layout_height="@dimen/recommend_video_height">
                    <com.byd.auto_emanual.video.VideoPlayer
                        android:id="@+id/video_player_feature"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                    <View
                        android:id="@+id/video_player_feature_face_1"
                        android:background="@color/color_transparent"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="@dimen/dp_56"/>
                    <View
                        android:id="@+id/video_player_feature_face_2"
                        android:background="@color/color_transparent"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/dp_56"/>
                </RelativeLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_view_vertical_feature"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never"
                    android:layout_marginStart="@dimen/recommend_item_interval_width"/>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view_horizontal_feature"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/recommend_interval_height"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/layout_scene"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:id="@+id/video_player_scene_container"
                    android:layout_width="@dimen/recommend_video_width"
                    android:layout_height="@dimen/recommend_video_height">
                    <com.byd.auto_emanual.video.VideoPlayer
                        android:id="@+id/video_player_scene"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                    <View
                        android:id="@+id/video_player_scene_face_1"
                        android:background="@color/color_transparent"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="@dimen/dp_56"/>
                    <View
                        android:id="@+id/video_player_scene_face_2"
                        android:background="@color/color_transparent"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/dp_56"/>
                </RelativeLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_view_vertical_scene"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never"
                    android:layout_marginStart="@dimen/recommend_item_interval_width"/>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view_horizontal_scene"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/recommend_interval_height"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <include
        android:visibility="gone"
        layout="@layout/net_error_state"/>
    <include
        android:visibility="gone"
        layout="@layout/net_loading_state"/>
</RelativeLayout>
