<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.byd.auto_emanual.image.KImageView
        android:id="@+id/content_item_cover"
        android:visibility="gone"
        android:layout_width="@dimen/recommend_item_width"
        android:layout_height="@dimen/recommend_item_height"
        android:scaleType="centerInside"/>
    <TextView
        android:textSize="@dimen/recommend_item_header_text_size"
        android:textColor="@color/content_item_header_text"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/content_item_header"
        android:layout_width="@dimen/recommend_item_header_width"
        android:layout_height="wrap_content"
        android:hint="@string/content_item_header_hint"
        android:singleLine="true"
        android:paddingStart="@dimen/dp_15"
        android:layout_marginStart="@dimen/recommend_item_header_margin_start"
        android:layout_marginEnd="@dimen/recommend_item_header_margin_start"/>
    <TextView
        android:textSize="@dimen/recommend_item_header_text_size"
        android:textColor="@color/content_item_footer_text"
        android:gravity="center"
        android:id="@+id/content_item_footer"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/recommend_item_play_logo_margin"
        android:hint="@string/content_item_footer_hint"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"/>
    <ImageView
        android:id="@+id/content_item_play_logo"
        android:background="@drawable/icon_recommend_content_item_play_logo"
        android:layout_width="@dimen/recommend_item_play_logo_size"
        android:layout_height="@dimen/recommend_item_play_logo_size"
        android:layout_marginBottom="@dimen/recommend_item_play_logo_margin"
        android:scaleType="centerInside"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/recommend_item_play_logo_margin"/>
    <TextView
        android:id="@+id/content_item_path"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:hint="@string/app_name"/>
    <View
        android:id="@+id/content_item_line"
        android:background="@color/classify_line"
        android:layout_width="@dimen/recommend_item_header_width"
        android:layout_height="@dimen/dp_0_5"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
