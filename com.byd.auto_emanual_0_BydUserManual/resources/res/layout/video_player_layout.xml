<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <com.byd.auto_emanual.video.VideoView
        android:id="@+id/video_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"/>
    <ImageView
        android:id="@+id/video_start_pause_big"
        android:background="@drawable/icon_video_pause_big"
        android:visibility="gone"
        android:layout_width="@dimen/video_start_pause_size"
        android:layout_height="@dimen/video_start_pause_size"
        android:scaleType="centerInside"
        android:layout_centerInParent="true"/>
    <TextView
        android:textSize="@dimen/video_fast_text_size"
        android:textColor="@color/video_fast_text_color"
        android:gravity="center_horizontal"
        android:id="@+id/video_fast"
        android:background="@drawable/icon_video_fast_background"
        android:paddingTop="@dimen/video_fast_icon_padding_top"
        android:visibility="gone"
        android:layout_width="@dimen/video_fast_weight"
        android:layout_height="@dimen/video_fast_height"
        android:scaleType="centerCrop"
        android:text="00:08:30"
        android:drawableTop="@drawable/icon_video_fast_backward"
        android:drawablePadding="@dimen/video_fast_icon_padding"
        android:layout_centerInParent="true"/>
    <LinearLayout
        android:id="@+id/video_loading_container"
        android:background="@drawable/icon_video_fast_background"
        android:visibility="gone"
        android:layout_width="@dimen/video_loading_size"
        android:layout_height="@dimen/video_loading_size"
        android:scaleType="centerInside"
        android:layout_centerInParent="true">
        <ImageView
            android:id="@+id/video_loading"
            android:layout_width="@dimen/video_loading_size"
            android:layout_height="@dimen/video_loading_size"
            android:src="@drawable/loading_54"
            android:scaleType="center"
            android:layout_centerInParent="true"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/video_net_error"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <ImageView
            android:id="@+id/video_net_error_state_image"
            android:layout_width="match_parent"
            android:layout_height="@dimen/state_image_size_height"
            android:src="@drawable/state_net_error"
            android:scaleType="center"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="@dimen/state_text_size"
            android:textColor="@color/color_background"
            android:gravity="center"
            android:id="@+id/video_net_error_state_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:text="@string/state_net_error"/>
    </LinearLayout>
    <View
        android:id="@+id/video_header_background"
        android:background="@drawable/video_header_background"
        android:layout_width="match_parent"
        android:layout_height="@dimen/video_header_footer_background_height"/>
    <RelativeLayout
        android:id="@+id/video_back"
        android:layout_width="@dimen/video_back_width"
        android:layout_height="@dimen/video_title_height">
        <ImageView
            android:background="@drawable/icon_video_back"
            android:layout_width="@dimen/video_back_icon_size"
            android:layout_height="@dimen/video_back_icon_size"
            android:scaleType="centerInside"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="@dimen/video_title_text_size"
        android:textColor="@color/video_title_text_color"
        android:gravity="center"
        android:id="@+id/video_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/video_title_height"/>
    <View
        android:id="@+id/video_footer_background"
        android:background="@drawable/video_footer_background"
        android:layout_width="match_parent"
        android:layout_height="@dimen/video_header_footer_background_height"
        android:layout_alignParentBottom="true"/>
    <com.byd.auto_emanual.video.PlayController
        android:id="@+id/play_controller"
        android:layout_width="match_parent"
        android:layout_height="@dimen/controller_height"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="@dimen/controller_margin_size"/>
    <ImageView
        android:id="@+id/mute"
        android:background="@drawable/icon_video_mute_background"
        android:visibility="gone"
        android:layout_width="@dimen/video_mute_icon_size"
        android:layout_height="@dimen/video_mute_icon_size"
        android:layout_marginBottom="@dimen/recommend_item_play_logo_margin"
        android:src="@drawable/icon_video_sound_off"
        android:scaleType="centerInside"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/recommend_item_play_logo_margin"/>
</RelativeLayout>
