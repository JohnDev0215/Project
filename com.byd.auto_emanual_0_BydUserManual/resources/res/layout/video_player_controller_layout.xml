<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/full_screen"
        android:tag="zoomIn"
        android:layout_width="@dimen/controller_height"
        android:layout_height="@dimen/controller_height"
        android:layout_marginStart="@dimen/dp_18">
        <ImageView
            android:id="@+id/full_screen_icon"
            android:background="@drawable/icon_video_zoom_in"
            android:layout_width="@dimen/controller_button_width"
            android:layout_height="@dimen/controller_button_width"
            android:scaleType="centerInside"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/start_pause"
        android:tag="pause"
        android:layout_width="@dimen/controller_height"
        android:layout_height="@dimen/controller_height"
        android:layout_toRightOf="@+id/full_screen"
        android:layout_marginStart="@dimen/dp_3">
        <ImageView
            android:id="@+id/start_pause_icon"
            android:background="@drawable/icon_video_pause"
            android:layout_width="@dimen/controller_button_width"
            android:layout_height="@dimen/controller_button_width"
            android:scaleType="centerInside"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="@dimen/controller_current_progress_text_size"
        android:textColor="@color/controller_current_progress_text_color"
        android:id="@+id/current_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00"
        android:layout_toRightOf="@+id/start_pause"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/dp_15"/>
    <SeekBar
        android:id="@+id/video_progress"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:progressDrawable="@drawable/seek_bar_progress_drawable"
        android:thumb="@drawable/seek_bar_thumb"
        android:layout_toLeftOf="@+id/total_duration"
        android:layout_toRightOf="@+id/current_progress"
        android:layout_centerVertical="true"
        android:paddingStart="@dimen/dp_20_5"
        android:paddingEnd="@dimen/dp_4_5"
        android:layout_marginStart="@dimen/controller_seek_bar_margin_size"
        android:layout_marginEnd="@dimen/controller_seek_bar_margin_size"
        android:splitTrack="false"/>
    <TextView
        android:textSize="@dimen/controller_current_progress_text_size"
        android:textColor="@color/controller_current_progress_text_color"
        android:gravity="end"
        android:id="@+id/total_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/dp_15"/>
</RelativeLayout>
