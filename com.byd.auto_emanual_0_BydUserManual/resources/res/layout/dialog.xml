<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/dialog_width"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/dialog_title_text_size"
        android:textColor="@color/dialog_title_text_color"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dialog_title_height"
        android:layout_marginTop="@dimen/dialog_title_margin_top"
        android:text="@string/dialog_disclaimer_title"
        android:layout_marginStart="@dimen/dialog_content_margin"
        android:layout_marginEnd="@dimen/dialog_title_margin_top"/>
    <View
        android:id="@+id/line_horizontal"
        android:background="@color/dialog_line_color"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dialog_line_size"
        android:layout_marginTop="@dimen/dp_15"
        android:layout_below="@+id/title"/>
    <TextView
        android:scrollbarThumbVertical="@drawable/classify_scrollbar_color"
        android:scrollbarStyle="outsideInset"
        android:textSize="@dimen/dialog_detail_text_size"
        android:textColor="@color/dialog_detail_text_color"
        android:id="@+id/detail"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dialog_detail_margin_top"
        android:maxHeight="@dimen/dp_200"
        android:text="@string/dialog_disclaimer_detail"
        android:singleLine="false"
        android:layout_below="@+id/title"
        android:layout_marginStart="@dimen/dialog_content_margin"
        android:layout_marginEnd="@dimen/dialog_content_margin"/>
    <RelativeLayout
        android:id="@+id/radio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_5"
        android:layout_marginBottom="@dimen/dp_10"
        android:layout_below="@+id/detail"
        android:paddingStart="@dimen/dialog_content_margin"
        android:paddingEnd="@dimen/dialog_content_margin">
        <ImageView
            android:id="@+id/radio_image"
            android:tag="unselected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_dialog_unselected_dynasty"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="@dimen/dialog_radio_text_size"
            android:textColor="?attr/dialog_radio_text_color"
            android:gravity="center_vertical"
            android:id="@+id/radio_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dialog_disclaimer_radio"
            android:drawablePadding="@dimen/dialog_radio_drawable_padding"
            android:layout_toEndOf="@+id/radio_image"/>
    </RelativeLayout>
    <View
        android:id="@+id/line_vertical"
        android:background="@color/dialog_line_color"
        android:visibility="gone"
        android:layout_width="@dimen/dialog_line_size"
        android:layout_height="@dimen/dialog_button_height"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="@dimen/dialog_button_text_size"
        android:textColor="@color/dialog_confirm_text_color_selector"
        android:gravity="center"
        android:id="@+id/confirm"
        android:background="@drawable/button_confirm_background_shape_selector"
        android:layout_width="@dimen/dialog_button_width"
        android:layout_height="@dimen/dialog_button_height"
        android:layout_marginLeft="@dimen/button_confirm_start"
        android:layout_marginBottom="@dimen/dp_21"
        android:text="@string/dialog_button_confirm"
        android:layout_below="@+id/radio"/>
    <TextView
        android:textSize="@dimen/dialog_button_text_size"
        android:textColor="@color/dialog_cancel_text_color_selector"
        android:gravity="center"
        android:id="@+id/cancel"
        android:background="@drawable/button_cancel_background_shape_selector"
        android:layout_width="@dimen/dialog_button_width"
        android:layout_height="@dimen/dialog_button_height"
        android:layout_marginRight="@dimen/button_confirm_start"
        android:layout_marginBottom="@dimen/dp_21"
        android:text="@string/dialog_button_cancel"
        android:layout_below="@+id/radio"
        android:layout_alignParentRight="true"/>
    <TextView
        android:textSize="@dimen/dialog_button_text_size"
        android:textColor="@color/dialog_confirm_text_color_selector"
        android:gravity="center"
        android:id="@+id/confirm_only"
        android:background="@drawable/button_confirm_background_shape_selector"
        android:visibility="gone"
        android:layout_width="@dimen/dialog_button_width"
        android:layout_height="@dimen/dialog_button_height"
        android:layout_marginTop="@dimen/dp_24"
        android:layout_marginBottom="@dimen/dp_21"
        android:text="@string/dialog_button_confirm"
        android:layout_below="@+id/detail"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
