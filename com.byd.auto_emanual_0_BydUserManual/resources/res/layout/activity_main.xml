<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/main_container"
        android:background="?attr/background_horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:orientation="vertical"
            android:id="@+id/tab_container"
            android:background="?attr/tab_background_horizontal"
            android:layout_width="@dimen/tab_item_width"
            android:layout_height="@dimen/tab_height"
            android:layout_marginTop="@dimen/tab_item_margin_top">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/tab_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:overScrollMode="never"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/tab_edge"
            android:background="?attr/tab_edge_horizontal"
            android:visibility="gone"
            android:layout_width="@dimen/tab_edge_width"
            android:layout_height="@dimen/tab_edge_height"
            android:layout_marginTop="@dimen/tab_edge_margin_top"/>
        <RelativeLayout
            android:id="@+id/tab_edge_port"
            android:background="?attr/tab_edge_port"
            android:visibility="gone"
            android:layout_width="@dimen/tab_edge_width_port"
            android:layout_height="@dimen/tab_edge_height_port"
            android:layout_below="@+id/tab_container"/>
        <FrameLayout
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/fragment_container_margin_top"
            android:layout_marginBottom="@dimen/navigation_bar_height"
            android:layout_marginStart="@dimen/fragment_container_margin"
            android:layout_marginEnd="@dimen/fragment_container_margin"/>
    </RelativeLayout>
    <include
        android:id="@+id/search_result_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/search_result"/>
</RelativeLayout>
