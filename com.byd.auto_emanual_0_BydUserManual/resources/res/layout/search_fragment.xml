<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:soundEffectsEnabled="false">
    <RelativeLayout
        android:id="@+id/search_input"
        android:layout_width="match_parent"
        android:layout_height="@dimen/search_input_height">
        <ImageView
            android:id="@+id/search_input_icon"
            android:layout_width="@dimen/search_input_icon_size"
            android:layout_height="match_parent"
            android:src="?attr/icon_search"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/search_input_icon_margin_start"/>
        <TextView
            android:textSize="@dimen/search_input_text_size"
            android:textColor="?attr/search_input_text_color"
            android:textColorHint="?attr/search_input_hint_text_color"
            android:gravity="center_vertical"
            android:id="@+id/input_text_view"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="@string/search_hint_text"
            android:singleLine="true"
            android:textCursorDrawable="@drawable/search_input_text_cursor_drawable"
            android:layout_marginStart="@dimen/search_input_icon_margin_start"
            android:layout_marginEnd="@dimen/dp_8"
            android:layout_toEndOf="@+id/search_input_icon"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/voice"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/search_clause_margin_top">
        <TextView
            android:textSize="@dimen/search_voice_text_size"
            android:textColor="?attr/search_voice_text_color"
            android:gravity="center_vertical"
            android:id="@+id/voice_text"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/search_voice_text_height"
            android:text="@string/search_voice_text"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/search_voice_how_to_open_light"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/search_voice_icon_height">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/voice_icon_1"
                android:layout_width="@dimen/search_voice_icon_height"
                android:layout_height="@dimen/search_voice_icon_height"
                android:src="@drawable/icon_search_voice"
                android:scaleType="centerCrop"
                android:layout_marginStart="@dimen/search_voice_icon_margin"
                android:layout_marginEnd="@dimen/search_voice_icon_margin"/>
            <TextView
                android:textSize="@dimen/search_voice_icon_text_size"
                android:textColor="?attr/search_voice_icon_text_color"
                android:gravity="center_vertical"
                android:id="@+id/voice_example_1"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/search_voice_how_to_open_light"
                android:paddingEnd="@dimen/search_clause_item_margin"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/search_voice_nfc_open_lock"
            android:background="@drawable/search_voice_icon_background"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/search_voice_icon_height"
            android:layout_marginTop="@dimen/search_clause_item_margin"
            android:layout_below="@+id/voice_text"
            android:layout_marginStart="@dimen/search_clause_item_margin"
            android:layout_toEndOf="@+id/search_voice_how_to_open_light">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/voice_icon_2"
                android:layout_width="@dimen/search_voice_icon_size"
                android:layout_height="@dimen/search_voice_icon_size"
                android:src="@drawable/icon_search_voice"
                android:scaleType="centerCrop"
                android:layout_marginStart="@dimen/search_voice_icon_margin"
                android:layout_marginEnd="@dimen/search_voice_icon_margin"/>
            <TextView
                android:textSize="@dimen/search_voice_icon_text_size"
                android:textColor="?attr/search_voice_icon_text_color"
                android:gravity="center_vertical"
                android:id="@+id/voice_example_2"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/search_voice_nfc_open_lock"
                android:paddingEnd="@dimen/search_clause_item_margin"/>
        </LinearLayout>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/history"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/search_clause_margin_top">
        <TextView
            android:textSize="?attr/search_voice_text_size"
            android:textColor="?attr/search_voice_text_color"
            android:gravity="center_vertical"
            android:id="@+id/history_text"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/search_history_delete_height"
            android:text="@string/search_history_text"/>
        <ImageView
            android:id="@+id/history_delete"
            android:layout_width="@dimen/search_history_delete_weight"
            android:layout_height="@dimen/search_history_delete_height"
            android:src="?attr/icon_search_history_delete"
            android:scaleType="center"
            android:layout_toEndOf="@+id/history_text"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/history_recycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/search_clause_item_margin"
            android:layout_below="@+id/history_text"
            android:overScrollMode="never"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/hot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/search_clause_margin_top">
        <TextView
            android:textSize="?attr/search_voice_text_size"
            android:textColor="?attr/search_voice_text_color"
            android:gravity="center_vertical"
            android:id="@+id/hot_text"
            android:layout_width="match_parent"
            android:layout_height="@dimen/search_voice_text_height"
            android:text="@string/search_hot_text"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/hot_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/search_clause_item_hot_margin"
            android:layout_below="@+id/hot_text"
            android:overScrollMode="never"/>
    </RelativeLayout>
</LinearLayout>
