<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/settings_scroll"
        android:layout_width="@dimen/settings_item_width"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dp_101"
        android:layout_alignParentLeft="true">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include
                android:id="@+id/settings_item_0"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/settings_item_height"
                layout="@layout/settings_item"/>
            <include
                android:id="@+id/settings_item_1"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/settings_item_height"
                layout="@layout/settings_item"/>
            <include
                android:id="@+id/settings_item_2"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/settings_item_height"
                layout="@layout/settings_item"/>
            <RelativeLayout
                android:id="@+id/settings_download_language_layout"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/settings_item_height"
                android:layout_marginTop="@dimen/dp_12">
                <View
                    android:id="@+id/settings_download_line"
                    android:background="@color/settings_download_line_color"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginTop="@dimen/dp_15"/>
                <TextView
                    android:textSize="@dimen/sp_15"
                    android:textColor="@color/settings_download_text_color"
                    android:gravity="center_vertical"
                    android:id="@+id/settings_download_language"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:maxLines="2"
                    android:layout_centerVertical="true"
                    android:paddingStart="@dimen/settings_item_text_start"
                    android:layout_marginEnd="@dimen/dp_12"
                    android:layout_toStartOf="@+id/settings_download_size"
                    android:layout_alignParentStart="true"/>
                <TextView
                    android:textSize="@dimen/sp_13"
                    android:textColor="@color/dialog_confirm_text_color_selector"
                    android:gravity="center"
                    android:id="@+id/settings_download_button"
                    android:background="@drawable/button_confirm_background_shape_selector"
                    android:paddingTop="@dimen/dp_7_5"
                    android:paddingBottom="@dimen/dp_7_5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_13"
                    android:maxWidth="@dimen/dp_158"
                    android:minWidth="@dimen/dp_132"
                    android:text="@string/settings_download_button_download"
                    android:maxLines="2"
                    android:layout_below="@+id/settings_download_line"
                    android:layout_centerVertical="true"
                    android:paddingStart="@dimen/dp_18"
                    android:paddingEnd="@dimen/dp_18"
                    android:layout_marginEnd="@dimen/dp_12_5"
                    android:layout_alignParentEnd="true"/>
                <ImageView
                    android:id="@+id/settings_download_dot"
                    android:visibility="gone"
                    android:layout_width="@dimen/settings_new_version_dot"
                    android:layout_height="@dimen/settings_new_version_dot"
                    android:layout_marginTop="@dimen/dp_19"
                    android:src="@drawable/settings_new_version_dot"
                    android:layout_below="@+id/settings_download_line"
                    android:layout_marginEnd="@dimen/dp_9"
                    android:layout_alignParentEnd="true"/>
                <TextView
                    android:textSize="@dimen/sp_15"
                    android:textColor="@color/settings_download_text_color"
                    android:id="@+id/settings_download_size"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp_21"
                    android:layout_marginTop="@dimen/dp_19"
                    android:layout_below="@+id/settings_download_line"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/dp_17_5"
                    android:layout_toStartOf="@+id/settings_download_button"/>
            </RelativeLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/settings_download_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12">
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_15"/>
                <TextView
                    android:textSize="@dimen/sp_15"
                    android:textColor="@color/settings_download_text_color"
                    android:id="@+id/settings_download_text"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp_21"
                    android:text="@string/settings_download_text"
                    android:paddingStart="@dimen/settings_item_text_start"/>
                <TextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/settings_download_text_color"
                    android:id="@+id/settings_download_text_detail"
                    android:paddingTop="@dimen/dp_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_download_text_detail"
                    android:paddingStart="@dimen/settings_item_text_start"
                    android:paddingEnd="@dimen/settings_item_text_start"/>
                <TextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/settings_download_text_color"
                    android:id="@+id/settings_support_language_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_support_language"
                    android:paddingStart="@dimen/settings_item_text_start"
                    android:paddingEnd="@dimen/settings_item_text_start"/>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_15"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/settings_about"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/settings_icon"
            android:background="@drawable/icon_settings"
            android:layout_width="@dimen/settings_icon_size"
            android:layout_height="@dimen/settings_icon_size"
            android:scaleType="centerInside"
            android:contentDescription="@string/settings_name"/>
        <TextView
            android:textSize="@dimen/settings_name_text_size"
            android:textColor="@color/settings_name_text_color"
            android:gravity="center"
            android:id="@+id/settings_name"
            android:layout_width="match_parent"
            android:layout_height="@dimen/settings_name_height"
            android:layout_marginTop="@dimen/dp_12"
            android:text="@string/settings_name"/>
        <TextView
            android:textSize="@dimen/settings_version_text_size"
            android:textColor="@color/settings_version_text_color"
            android:gravity="center"
            android:id="@+id/settings_version"
            android:layout_width="match_parent"
            android:layout_height="@dimen/settings_version_height"
            android:layout_marginTop="@dimen/dp_3"
            android:text="@string/settings_version"/>
        <TextView
            android:textSize="@dimen/settings_copyright_text_size"
            android:textColor="@color/settings_copyright_text_color"
            android:gravity="center"
            android:id="@+id/settings_copyright"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/settings_copyright_height"
            android:layout_marginTop="@dimen/dp_12"/>
    </LinearLayout>
</RelativeLayout>
