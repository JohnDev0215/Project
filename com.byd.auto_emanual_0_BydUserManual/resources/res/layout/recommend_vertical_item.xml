<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <include
            android:id="@+id/vertical_item_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/content_item"/>
        <View
            android:id="@+id/interval_height"
            android:layout_width="match_parent"
            android:layout_height="@dimen/recommend_item_interval_height"/>
        <include
            android:id="@+id/vertical_item_2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/content_item"/>
    </LinearLayout>
    <View
        android:id="@+id/interval_width"
        android:layout_width="@dimen/recommend_item_interval_width"
        android:layout_height="match_parent"
        android:layout_toRightOf="@+id/content_item_cover"/>
</LinearLayout>
