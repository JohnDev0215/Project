<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/search_key_display_item"
    android:background="@drawable/search_history_item_background"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/search_history_item_text_height"
    android:layout_marginBottom="@dimen/search_clause_item_margin"
    android:layout_marginEnd="@dimen/search_clause_item_margin">
    <TextView
        android:textSize="@dimen/search_history_item_text_size"
        android:textColor="?attr/search_history_item_text_color"
        android:gravity="center"
        android:id="@+id/search_history_item_text"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:maxWidth="@dimen/search_history_item_text_width"
        android:singleLine="true"
        android:layout_centerVertical="true"
        android:paddingStart="@dimen/search_history_item_text_padding"
        android:paddingEnd="@dimen/search_history_item_text_padding"/>
</RelativeLayout>
