<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="?attr/background_horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:soundEffectsEnabled="false">
    <RelativeLayout
        android:id="@+id/bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/search_result_bar_height"
        android:layout_marginTop="@dimen/fragment_container_margin_top"
        android:layout_marginStart="@dimen/search_result_bar_margin_start"
        android:layout_marginEnd="@dimen/search_result_bar_margin_end">
        <ImageView
            android:id="@+id/result_back"
            android:background="?attr/icon_search_result_back"
            android:layout_width="@dimen/media_image_text_back_size"
            android:layout_height="@dimen/media_image_text_back_size"
            android:scaleType="centerInside"
            android:layout_centerVertical="true"/>
        <include
            android:id="@+id/result_input"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/search_result_bar_input_height"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/search_result_bar_input_margin_start"
            layout="@layout/search_input"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/result_history"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/search_result_margin_top"
        android:layout_marginBottom="@dimen/navigation_bar_height"
        android:layout_below="@+id/bar"
        android:layout_marginStart="@dimen/search_result_margin"
        android:layout_marginEnd="@dimen/search_result_bar_margin_end">
        <TextView
            android:textSize="?attr/search_voice_text_size"
            android:textColor="?attr/search_voice_text_color"
            android:gravity="center_vertical"
            android:id="@+id/result_history_text"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/search_voice_text_height"
            android:text="@string/search_history_text"/>
        <ImageView
            android:id="@+id/result_history_delete"
            android:background="?attr/icon_search_history_delete"
            android:layout_width="@dimen/search_history_delete_weight"
            android:layout_height="@dimen/search_history_delete_height"
            android:scaleType="center"
            android:layout_toEndOf="@+id/result_history_text"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/result_history_recycler"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/search_clause_item_margin"
            android:layout_below="@+id/result_history_text"
            android:overScrollMode="never"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/no_result"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/icon"
            android:background="@drawable/icon_search_result_no"
            android:layout_width="@dimen/search_result_no_icon_size_width"
            android:layout_height="@dimen/search_result_no_icon_size_height"
            android:layout_centerInParent="true"/>
        <TextView
            android:textSize="@dimen/search_result_no_text_size"
            android:textColor="@color/search_result_no_text_color"
            android:gravity="center"
            android:id="@+id/no_result_text"
            android:layout_width="match_parent"
            android:layout_height="@dimen/search_result_no_text_height"
            android:layout_marginTop="@dimen/search_result_no_text_margin_top"
            android:text="@string/search_result_no_text"
            android:layout_below="@+id/icon"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/result"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/search_result_margin_top"
        android:layout_marginBottom="@dimen/navigation_bar_height"
        android:layout_below="@+id/bar"
        android:layout_marginStart="@dimen/search_result_margin"
        android:layout_marginEnd="@dimen/search_result_margin_port"/>
</RelativeLayout>
