<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/interval_height"
        android:layout_width="match_parent"
        android:layout_height="@dimen/recommend_item_interval_height"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include
            android:id="@+id/horizontal_item_1"
            android:layout_width="@dimen/recommend_item_width"
            android:layout_height="wrap_content"
            layout="@layout/content_item"/>
        <View
            android:id="@+id/interval_width_12"
            android:layout_width="@dimen/recommend_item_interval_width"
            android:layout_height="match_parent"/>
        <include
            android:id="@+id/horizontal_item_2"
            android:layout_width="@dimen/recommend_item_width"
            android:layout_height="match_parent"
            layout="@layout/content_item"/>
        <View
            android:id="@+id/interval_width_23"
            android:layout_width="@dimen/recommend_item_interval_width"
            android:layout_height="match_parent"/>
        <include
            android:id="@+id/horizontal_item_3"
            android:layout_width="@dimen/recommend_item_width"
            android:layout_height="match_parent"
            layout="@layout/content_item"/>
        <View
            android:id="@+id/interval_width_34"
            android:layout_width="@dimen/recommend_item_interval_width"
            android:layout_height="match_parent"/>
        <include
            android:id="@+id/horizontal_item_4"
            android:layout_width="@dimen/recommend_item_width"
            android:layout_height="match_parent"
            layout="@layout/content_item"/>
    </LinearLayout>
</LinearLayout>
