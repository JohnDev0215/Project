<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/tab_item_width"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/tab_item_container"
        android:layout_width="@dimen/tab_item_width"
        android:layout_height="@dimen/tab_item_height"
        android:layout_centerHorizontal="true">
        <View
            android:layout_width="@dimen/dp_21"
            android:layout_height="match_parent"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/cover"
            android:layout_width="@dimen/tab_item_image_size"
            android:layout_height="@dimen/tab_item_image_size"
            android:scaleType="center"/>
        <View
            android:visibility="gone"
            android:layout_width="@dimen/dp_8_5"
            android:layout_height="match_parent"/>
        <TextView
            android:textSize="@dimen/tab_item_name_text_size"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dp_5"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_15"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/tab_dot"
        android:visibility="gone"
        android:layout_width="@dimen/settings_new_version_dot"
        android:layout_height="@dimen/settings_new_version_dot"
        android:layout_marginTop="@dimen/tab_dot_margin_top"
        android:src="@drawable/settings_new_version_dot"
        android:layout_marginStart="@dimen/tab_dot_margin_start"/>
    <View
        android:id="@+id/split_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tab_item_split_view_height"
        android:layout_below="@+id/tab_item_container"/>
</RelativeLayout>
