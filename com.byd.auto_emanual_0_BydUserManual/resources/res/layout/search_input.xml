<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/search_input_layout"
    android:background="@drawable/search_input_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:soundEffectsEnabled="false">
    <ImageView
        android:id="@+id/search_icon"
        android:layout_width="@dimen/search_input_icon_size"
        android:layout_height="match_parent"
        android:src="?attr/icon_search"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/search_input_icon_margin_start"/>
    <EditText
        android:textSize="@dimen/search_input_text_size"
        android:textColor="@color/search_input_text_color"
        android:textColorHint="@color/search_input_hint_text_color"
        android:gravity="center_vertical"
        android:id="@+id/input_edit_text"
        android:background="@null"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:hint="@string/search_hint_text"
        android:singleLine="true"
        android:maxLength="100"
        android:inputType="textCapSentences"
        android:imeOptions="actionSearch"
        android:textCursorDrawable="@drawable/search_input_text_cursor_drawable"
        android:layout_marginStart="@dimen/search_input_icon_margin_start"
        android:layout_marginEnd="@dimen/search_input_text_margin_end"
        android:layout_toEndOf="@+id/search_icon"/>
    <ImageView
        android:id="@+id/input_text_delete"
        android:visibility="gone"
        android:layout_width="@dimen/search_input_delete_icon_size"
        android:layout_height="@dimen/search_input_delete_icon_size"
        android:src="?attr/icon_search_input_text_delete"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/search_input_icon_margin_start"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
