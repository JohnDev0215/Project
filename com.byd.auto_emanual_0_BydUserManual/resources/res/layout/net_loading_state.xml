<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/net_loading_state"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/loading_icon"
        android:layout_width="@dimen/dp_54"
        android:layout_height="@dimen/dp_54"
        android:src="?attr/loading_54"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="@dimen/sp_13"
        android:textColor="@color/state_text_loading"
        android:gravity="center"
        android:id="@+id/loading_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/state_interval"
        android:text="@string/state_loading"
        android:layout_below="@+id/loading_icon"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
