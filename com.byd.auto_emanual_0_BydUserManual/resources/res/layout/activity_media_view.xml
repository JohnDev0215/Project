<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/video_player_parent"
    android:background="?attr/background_horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/fix_point"
        android:layout_width="@dimen/video_player_width"
        android:layout_height="@dimen/video_player_margin_top"/>
    <com.byd.auto_emanual.video.VideoPlayer
        android:id="@+id/video_player"
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/video_player_margin_top"
        android:layout_marginBottom="@dimen/video_player_margin_top"
        android:layout_toStartOf="@+id/classify_container"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/media_image_text_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/media_image_text_margin_top"
        android:layout_marginStart="@dimen/media_image_text_margin_start"
        android:layout_marginEnd="@dimen/media_image_text_margin_end"
        android:layout_toStartOf="@+id/classify_container">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_36">
            <RelativeLayout
                android:id="@+id/media_image_text_back"
                android:clickable="true"
                android:layout_width="@dimen/dp_48"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/icon_media_text_back"
                    android:background="@drawable/icon_media_text_back"
                    android:layout_width="@dimen/media_image_text_back_size"
                    android:layout_height="@dimen/media_image_text_back_size"
                    android:scaleType="centerInside"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
            <TextView
                android:textSize="@dimen/media_image_text_title_text_size"
                android:textColor="@color/media_image_text_title_text_color"
                android:gravity="center"
                android:id="@+id/media_image_text_title"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="@string/app_name"
                android:layout_marginStart="@dimen/media_image_text_back_size"/>
        </RelativeLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_7_5"/>
        <androidx.recyclerview.widget.RecyclerView
            android:layout_gravity="center_horizontal"
            android:id="@+id/media_image_text"
            android:layout_width="@dimen/media_image_text_width"
            android:layout_height="match_parent"/>
        <RelativeLayout
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/web_view_container"
            android:layout_width="@dimen/media_image_text_width"
            android:layout_height="match_parent">
            <WebView
                android:id="@+id/media_web_view"
                android:background="#00000000"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="@dimen/media_html_web_view_margin_bottom"/>
            <TextView
                android:textSize="@dimen/media_html_enter_manual_text_size"
                android:textColor="@color/dialog_confirm_text_color_selector"
                android:gravity="center"
                android:id="@+id/media_enter_manual"
                android:background="@drawable/button_confirm_background_shape_selector"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/media_html_enter_manual_height"
                android:layout_marginBottom="@dimen/dp_6"
                android:text="@string/enter_manual"
                android:singleLine="true"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:paddingStart="@dimen/dp_18"
                android:paddingEnd="@dimen/dp_18"/>
        </RelativeLayout>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/classify_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/classify_margin_top"
        android:layout_marginBottom="@dimen/classify_margin_bottom"
        android:layout_marginStart="@dimen/classify_margin_start"
        android:layout_marginEnd="@dimen/classify_margin_start"
        android:layout_toEndOf="@+id/fix_point">
        <TextView
            android:textSize="@dimen/classify_title_text_size"
            android:textStyle="bold"
            android:textColor="@color/media_classify_title_text"
            android:gravity="center_vertical"
            android:id="@+id/classify_title"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/title_classify_height"
            android:layout_marginStart="@dimen/classify_title_margin_start"/>
        <View
            android:id="@+id/classify_line"
            android:background="@color/classify_line"
            android:layout_width="@dimen/classify_line_length"
            android:layout_height="@dimen/dp_0_5"
            android:layout_below="@+id/classify_title"
            android:layout_marginStart="@dimen/classify_title_margin_start"/>
        <androidx.recyclerview.widget.RecyclerView
            android:scrollbarSize="@dimen/classify_scrollbar_size"
            android:scrollbarThumbVertical="@color/classify_scrollbar_color"
            android:id="@+id/classify_recycler_view"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/classify_recycler_view_margin_top"
            android:layout_below="@+id/classify_line"
            android:layout_marginEnd="@dimen/dp_9"/>
        <View
            android:id="@+id/classify_footer_background"
            android:background="@drawable/classify_footer_background"
            android:layout_width="@dimen/classify_item_width"
            android:layout_height="@dimen/video_header_footer_background_height"
            android:layout_alignParentBottom="true"/>
        <View
            android:id="@+id/classify_footer_background_port"
            android:background="@drawable/classify_footer_background_port"
            android:visibility="gone"
            android:layout_width="@dimen/video_header_footer_background_height"
            android:layout_height="@dimen/classify_item_height"
            android:layout_marginTop="@dimen/classify_recycler_view_margin_top"
            android:layout_below="@+id/classify_title"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</RelativeLayout>
