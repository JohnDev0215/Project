<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/tab_item_height_port">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/tab_item_container"
        android:layout_width="@dimen/tab_item_width_port"
        android:layout_height="@dimen/tab_item_height_port"
        android:layout_centerVertical="true">
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/tab_item_image_top"/>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/cover"
            android:layout_width="@dimen/tab_item_image_size"
            android:layout_height="@dimen/tab_item_image_size"
            android:scaleType="centerInside"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/tab_item_interval_image_and_text"/>
        <TextView
            android:textSize="@dimen/tab_item_name_text_size"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_38"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/tab_dot"
        android:visibility="gone"
        android:layout_width="@dimen/settings_new_version_dot"
        android:layout_height="@dimen/settings_new_version_dot"
        android:layout_marginTop="@dimen/tab_dot_margin_top_port"
        android:src="@drawable/settings_new_version_dot"
        android:layout_marginStart="@dimen/tab_dot_margin_start_port"/>
    <View
        android:id="@+id/split_view"
        android:layout_width="@dimen/tab_item_split_view_width"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@+id/tab_item_container"/>
</RelativeLayout>
