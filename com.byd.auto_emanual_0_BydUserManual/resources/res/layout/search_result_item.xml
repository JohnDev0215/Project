<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/result_item"
    android:layout_width="match_parent"
    android:layout_height="@dimen/search_result_item_height"
    android:layout_marginBottom="@dimen/search_result_item_margin_bottom">
    <com.byd.auto_emanual.image.KImageView
        android:id="@+id/cover"
        android:visibility="gone"
        android:layout_width="@dimen/search_result_item_image_width"
        android:layout_height="match_parent"/>
    <TextView
        android:textSize="@dimen/search_result_item_text_size"
        android:textColor="@color/search_result_item_text_color"
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/search_result_item_text_height"
        android:layout_marginTop="@dimen/search_result_item_text_margin_top"
        android:singleLine="true"
        android:layout_marginStart="@dimen/search_result_item_text_margin_start"
        android:layout_toEndOf="@+id/cover"/>
    <TextView
        android:textSize="@dimen/search_result_item_hint_text_size"
        android:textColor="@color/search_result_item_hint_text_color"
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="@dimen/search_result_item_hint_text_height"
        android:layout_marginTop="@dimen/search_result_item_hint_text_margin_top"
        android:singleLine="true"
        android:layout_below="@+id/header"
        android:layout_marginStart="@dimen/search_result_item_text_margin_start"
        android:layout_toEndOf="@+id/cover"/>
    <ImageView
        android:id="@+id/play_logo"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <TextView
        android:id="@+id/path"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/search_result_item_line"
        android:background="@color/search_result_line_color"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0_5"
        android:layout_marginBottom="@dimen/dp_7_5"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
