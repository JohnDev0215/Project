<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rcrl_root_layout"
    android:background="@drawable/base_bg_frame_dialog_gradient"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/base_text_color_main_dilink_pagers"
            android:gravity="center"
            android:id="@+id/tv_dialog_title"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_12"
            android:layout_marginTop="@dimen/dp_22"
            android:layout_marginRight="@dimen/dp_12"
            android:layout_marginBottom="@dimen/dp_20"
            android:layout_centerHorizontal="true"/>
        <View
            android:id="@+id/divider_line"
            android:background="@color/base_bg_color_line"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:layout_below="@+id/tv_dialog_title"/>
        <LinearLayout
            android:id="@+id/ll_dialog_center_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_14"
            android:layout_marginTop="@dimen/dp_64"
            android:layout_marginRight="@dimen/dp_14"
            android:maxHeight="@dimen/dp_100"
            android:layout_below="@+id/divider_line">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/base_text_color_main_dilink_pagers"
                android:gravity="center"
                android:id="@+id/tv_dialog_message"
                android:paddingLeft="@dimen/dp_18"
                android:paddingTop="@dimen/dp_10"
                android:paddingRight="@dimen/dp_18"
                android:paddingBottom="@dimen/dp_10"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:lineSpacingExtra="@dimen/dp_3"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/ll_dialog_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_70"
            android:layout_marginBottom="@dimen/dp_28"
            android:layout_below="@+id/ll_dialog_center_group">
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/base_dialog_sure_white_text"
                android:gravity="center"
                android:id="@+id/tv_dialog_confirm"
                android:background="@drawable/base_selector_dialog_blue"
                android:layout_width="@dimen/dp_176"
                android:layout_height="@dimen/dp_48"
                android:text="@string/base_common_dialog_btn_ok"
                android:textAllCaps="false"
                android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"/>
            <View
                android:id="@+id/divider_view"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_1"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/base_dialog_cancel_text"
                android:gravity="center"
                android:id="@+id/tv_dialog_cancel"
                android:background="@drawable/base_selector_dialog_white"
                android:layout_width="@dimen/dp_176"
                android:layout_height="@dimen/dp_48"
                android:text="@string/base_common_dialog_btn_cancel"
                android:textAllCaps="false"
                android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/iv_dialog_close"
            android:visibility="gone"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:layout_marginLeft="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_12"
            android:src="@drawable/icon_dark_public_close"
            android:layout_alignParentLeft="true"/>
    </RelativeLayout>
</RelativeLayout>
