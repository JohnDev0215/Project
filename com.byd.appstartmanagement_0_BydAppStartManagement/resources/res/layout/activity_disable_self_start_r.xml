<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rl_content"
    android:background="@drawable/bg_frame_dialog_gradient"
    android:layout_width="@dimen/dp_560"
    android:layout_height="@dimen/dp_544">
    <RelativeLayout
        android:id="@+id/rl_title_disable_self_start"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_71"
        android:layout_alignParentTop="true">
        <ImageView
            android:id="@+id/iv_back_disable_self_start"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:src="@drawable/icon_public_close_48"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp_16"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:textSize="@dimen/sp_20"
            android:textStyle="bold"
            android:textColor="@color/text_color_main_dilink_pagers"
            android:gravity="center"
            android:id="@+id/tv_title_disable_self_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_disable_self_start_dialog"
            android:layout_centerInParent="true"
            android:paddingStart="@dimen/dp_50"
            android:layout_toStartOf="@+id/iv_back_disable_self_start"/>
    </RelativeLayout>
    <View
        android:id="@+id/v_line_disable_self_start"
        android:background="@color/bg_color_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_below="@+id/rl_title_disable_self_start"/>
    <RelativeLayout
        android:id="@+id/rl_data_show"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_405"
        android:layout_marginTop="@dimen/dp_27"
        android:layout_below="@+id/v_line_disable_self_start">
        <androidx.recyclerview.widget.RecyclerView
            android:scrollbarSize="@dimen/dp_4"
            android:scrollbarThumbVertical="@color/bg_color_scrollbar_thumb"
            android:scrollbarTrackVertical="@color/bg_color_scrollbar_track"
            android:id="@+id/rcv_disable_self_start"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="always"
            android:paddingStart="@dimen/dp_24"
            android:paddingEnd="@dimen/dp_9"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_no_data_show"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_405"
        android:layout_below="@+id/v_line_disable_self_start">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <ImageView
                android:background="@drawable/img_media_music_playlist_empty"
                android:layout_width="@dimen/dp_312"
                android:layout_height="@dimen/dp_208"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/text_color_item_right_dilink_link"
                android:gravity="center"
                android:id="@+id/tv_no_data_disable_self_start"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_24"
                android:text="@string/no_data_disable_self_start_dialog"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
