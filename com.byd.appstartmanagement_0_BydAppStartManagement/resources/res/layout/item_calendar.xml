<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="48dp">
    <RelativeLayout
        android:id="@+id/rl_item_date_day"
        android:background="@drawable/selector_frame_blue_white"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_centerInParent="true">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/text_color_black_1"
            android:gravity="center"
            android:id="@+id/tv_text_item_date_day"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerInParent="true"/>
        <TextView
            android:textSize="9sp"
            android:textColor="@drawable/selector_tv_text_color_white_black"
            android:id="@+id/tv_text_hint_item_date_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="9sp"
            android:textColor="@color/text_color_white"
            android:id="@+id/tv_today_hint_item_date_day"
            android:background="@drawable/bg_frame_corner_orange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/today_single"
            android:layout_alignParentTop="true"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:layout_marginEnd="2dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</RelativeLayout>
