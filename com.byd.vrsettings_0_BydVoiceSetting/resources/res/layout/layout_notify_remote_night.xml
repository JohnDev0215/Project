<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root_remoteview"
    android:background="@color/voice_setting_title"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="108dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/imageview_icon"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:src="@mipmap/icon_voice_language_night"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/voice_setting_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="7dp"
            android:text="@string/text_language"/>
    </LinearLayout>
    <TextView
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/voice_setting_title_night"
        android:id="@+id/textview_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/voice_setting_tip"
        android:id="@+id/textview_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_alignParentBottom="true"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/voice_setting_tip"
        android:id="@+id/textview_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="刚刚"
        android:layout_alignParentRight="true"/>
</RelativeLayout>
