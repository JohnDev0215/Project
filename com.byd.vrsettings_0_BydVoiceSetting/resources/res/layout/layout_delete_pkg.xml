<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/view_ota_root"
    android:background="@mipmap/img_bg_setting"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/v_place_top"
        android:layout_width="match_parent"
        android:layout_height="@dimen/custom_title_height_size"
        android:layout_marginTop="@dimen/custom_title_margin_top"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/imageview_back"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@mipmap/btn_back_n"
        android:layout_marginStart="@dimen/custom_title_margin_start"
        app:layout_constraintBottom_toBottomOf="@+id/v_place_top"
        app:layout_constraintStart_toStartOf="@+id/v_place_top"
        app:layout_constraintTop_toTopOf="@+id/v_place_top"/>
    <ImageView
        android:id="@+id/imageview_icon"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:src="@mipmap/icon_voice_language_light"
        app:layout_constraintBottom_toBottomOf="@+id/v_place_top"
        app:layout_constraintStart_toEndOf="@+id/imageview_back"
        app:layout_constraintTop_toTopOf="@+id/v_place_top"/>
    <com.byd.vrsettings.view.AppTextView
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/voice_setting_title"
        android:id="@+id/textview_voice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="All language files"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/v_place_top"
        app:layout_constraintStart_toEndOf="@+id/imageview_icon"
        app:layout_constraintTop_toTopOf="@+id/v_place_top"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/voice_setting_title"
        android:id="@+id/textview_version"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/view_line"
        app:layout_constraintStart_toEndOf="@+id/textview_voice"
        app:layout_constraintTop_toTopOf="@+id/textview_voice"/>
    <View
        android:id="@+id/view_line"
        android:background="#00aceb"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="@+id/textview_voice"
        app:layout_constraintStart_toStartOf="@+id/imageview_icon"
        app:layout_constraintTop_toBottomOf="@+id/textview_voice"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_place_top"/>
    <com.byd.vrsettings.view.AppTextView
        android:textColor="@color/white"
        android:id="@+id/tv_json"
        android:background="@color/voice_setting_title"
        android:padding="15dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.byd.vrsettings.view.AppTextView
        android:id="@+id/textview_local_data"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/recyclerview"/>
    <ProgressBar
        android:id="@+id/progress_loading"
        android:visibility="gone"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginBottom="19dp"
        app:layout_constraintBottom_toTopOf="@+id/guideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/loading_icon"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:src="@mipmap/icon_progress"
        app:layout_constraintBottom_toTopOf="@+id/guideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.byd.vrsettings.view.AppTextView
        android:textSize="18sp"
        android:textColor="#565d65"
        android:id="@+id/tv_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="19dp"
        android:text="@string/text_loading"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/guideline"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_other"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="imageview_back,imageview_icon,textview_voice,view_line,recyclerview"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_progress"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tv_loading,loading_icon"/>
</androidx.constraintlayout.widget.ConstraintLayout>
