<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/v_background"
        android:background="@drawable/bg_setting_popup"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="@dimen/cl_privacy_word_width"
        android:layout_height="@dimen/cl_privacy_word_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.byd.vrsettings.view.AppTextView
        android:textSize="@dimen/text_size_30"
        android:textStyle="bold"
        android:textColor="@color/dialog_titleTextColor"
        android:id="@+id/tv_car_model"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="_____"
        app:layout_constraintBottom_toBottomOf="@+id/v_background"
        app:layout_constraintEnd_toEndOf="@+id/v_background"
        app:layout_constraintStart_toStartOf="@+id/v_background"
        app:layout_constraintTop_toTopOf="@+id/v_background"/>
    <com.byd.vrsettings.view.AppTextView
        android:id="@+id/tv_x"
        android:background="@mipmap/dialog_icon_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toStartOf="@+id/v_background"
        app:layout_constraintTop_toTopOf="@+id/v_background"/>
</androidx.constraintlayout.widget.ConstraintLayout>
