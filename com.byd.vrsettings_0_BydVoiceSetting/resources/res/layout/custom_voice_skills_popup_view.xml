<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_custom_voice_skills_popup_view"
    android:background="@drawable/bg_skills_popup"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_skills"
        android:layout_width="148dp"
        android:layout_height="184dp"
        android:src="@mipmap/ic_skills_one"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/text_size_30"
        android:textColor="@color/skills_title_8155"
        android:gravity="center"
        android:id="@+id/tv_skills"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_skills"
        app:layout_constraintEnd_toEndOf="@+id/iv_skills"
        app:layout_constraintStart_toStartOf="@+id/iv_skills"
        app:layout_constraintTop_toTopOf="@+id/iv_skills"/>
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/custom_viewpager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_skills"
        app:layout_constraintTop_toTopOf="@+id/iv_skills"/>
    <ImageView
        android:id="@+id/iv_left_btn"
        android:background="@drawable/iv_left_btn"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_skills"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_right_btn"
        android:background="@drawable/iv_right_btn"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
