<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/v_driver_register_back"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/v_driver_register_lock"
        android:background="@mipmap/register_lock_background"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="@dimen/cl_primary_secondary_width_8155"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/v_driver_register_back"
        app:layout_constraintEnd_toEndOf="@+id/v_driver_register_back"
        app:layout_constraintStart_toStartOf="@+id/v_driver_register_back"
        app:layout_constraintTop_toTopOf="@+id/v_driver_register_back">
        <com.byd.vrsettings.view.AppTextView
            android:textSize="@dimen/text_size_title"
            android:textColor="@color/voice_setting_title_8155"
            android:gravity="center"
            android:id="@+id/tv_title_register"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/custom_title_margin_top_8155"
            android:text="@string/text_driver_register_locked"
            android:layout_marginStart="@dimen/tv_title_register_left_right_8155"
            android:layout_marginEnd="@dimen/tv_title_register_left_right_8155"
            app:layout_constraintEnd_toEndOf="@+id/v_driver_register_lock"
            app:layout_constraintStart_toStartOf="@+id/v_driver_register_lock"
            app:layout_constraintTop_toTopOf="@+id/v_driver_register_lock"/>
        <com.byd.vrsettings.view.AppTextView
            android:textSize="@dimen/text_size_24"
            android:textColor="@color/voice_setting_text_8155"
            android:id="@+id/tv_content_register"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tv_content1_margin_top_8155"
            android:text="@string/text_driver_content"
            android:layout_marginStart="@dimen/tv_audio_wakeup_margin_start_end_8155"
            android:layout_marginEnd="@dimen/tv_audio_wakeup_margin_start_end_8155"
            app:layout_constraintEnd_toEndOf="@+id/v_driver_register_lock"
            app:layout_constraintStart_toStartOf="@+id/v_driver_register_lock"
            app:layout_constraintTop_toBottomOf="@+id/tv_title_register"/>
        <ImageView
            android:id="@+id/iv_locking_background"
            android:layout_width="225dp"
            android:layout_height="260dp"
            android:layout_marginTop="@dimen/iv_locking_background_top_8155"
            android:layout_marginBottom="@dimen/iv_locking_background_bottom_8155"
            android:src="@mipmap/ic_locking_background"
            app:layout_constraintBottom_toBottomOf="@+id/v_driver_register_lock"
            app:layout_constraintEnd_toEndOf="@+id/v_driver_register_lock"
            app:layout_constraintStart_toStartOf="@+id/v_driver_register_lock"
            app:layout_constraintTop_toBottomOf="@+id/tv_front_passenger_wakeup_locked_tip"/>
        <ImageView
            android:id="@+id/iv_driver_wakeup_locked"
            android:layout_width="83dp"
            android:layout_height="95dp"
            android:layout_marginTop="@dimen/iv_driver_wakeup_locked_top_8155"
            android:src="@mipmap/ic_driver_wakeup_locked"
            android:layout_marginStart="@dimen/iv_driver_wakeup_locked_left_8155"
            app:layout_constraintStart_toStartOf="@+id/iv_locking_background"
            app:layout_constraintTop_toTopOf="@+id/iv_locking_background"/>
        <com.byd.vrsettings.view.AppTextView
            android:textSize="@dimen/text_size_title"
            android:textColor="@color/voice_setting_title_8155"
            android:id="@+id/tv_driver_wakeup_locked"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tv_driver_wakeup_locked_top_8155"
            android:text="@string/text_driver_wakeup_locked"
            app:layout_constraintEnd_toEndOf="@+id/tv_content_register"
            app:layout_constraintStart_toStartOf="@+id/tv_content_register"
            app:layout_constraintTop_toBottomOf="@+id/tv_content_register"/>
        <com.byd.vrsettings.view.AppTextView
            android:textSize="@dimen/text_size_24"
            android:textColor="@color/voice_setting_tip_8155"
            android:id="@+id/tv_driver_wakeup_locked_tip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/px_5"
            android:text="@string/text_driver_wakeup_locked_tip"
            app:layout_constraintEnd_toEndOf="@+id/tv_driver_wakeup_locked"
            app:layout_constraintStart_toStartOf="@+id/tv_driver_wakeup_locked"
            app:layout_constraintTop_toBottomOf="@+id/tv_driver_wakeup_locked"/>
        <ImageView
            android:id="@+id/iv_front_passenger_wakeup_locked"
            android:layout_width="84dp"
            android:layout_height="97dp"
            android:layout_marginTop="@dimen/iv_front_passenger_wakeup_locked_top_8155"
            android:src="@mipmap/ic_front_passenger_wakeup_locked"
            android:layout_marginEnd="@dimen/iv_front_passenger_wakeup_locked_right_8155"
            app:layout_constraintEnd_toEndOf="@+id/iv_locking_background"
            app:layout_constraintTop_toTopOf="@+id/iv_locking_background"/>
        <com.byd.vrsettings.view.AppTextView
            android:textSize="@dimen/text_size_title"
            android:textColor="@color/voice_setting_title_8155"
            android:id="@+id/tv_front_passenger_wakeup_locked"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tv_front_passenger_wakeup_locked_top_8155"
            android:text="@string/text_front_passenger_wakeup_locked"
            app:layout_constraintEnd_toEndOf="@+id/tv_driver_wakeup_locked"
            app:layout_constraintStart_toStartOf="@+id/tv_driver_wakeup_locked"
            app:layout_constraintTop_toBottomOf="@+id/tv_driver_wakeup_locked_tip"/>
        <com.byd.vrsettings.view.AppTextView
            android:textSize="@dimen/text_size_24"
            android:textColor="@color/voice_setting_tip"
            android:id="@+id/tv_front_passenger_wakeup_locked_tip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/px_5"
            android:text="@string/text_front_passenger_wakeup_locked_tip"
            app:layout_constraintEnd_toEndOf="@+id/tv_driver_wakeup_locked"
            app:layout_constraintStart_toStartOf="@+id/tv_front_passenger_wakeup_locked"
            app:layout_constraintTop_toBottomOf="@+id/tv_front_passenger_wakeup_locked"/>
        <com.byd.vrsettings.view.AppTextView
            android:textSize="@dimen/text_size_24"
            android:textColor="@color/view_dialog_btn_ok_8155"
            android:gravity="center"
            android:id="@+id/tv_btn_yes_register"
            android:background="@drawable/bg_setting_btn_yes"
            android:layout_width="@dimen/dp_0"
            android:layout_height="@dimen/tv_btn_yes_no_height_8155"
            android:layout_marginBottom="@dimen/tv_btn_yes_wakeup_bottom_8155"
            android:text="@string/text_btn_on"
            android:layout_marginStart="@dimen/tv_btn_yes_wakeup_left_8155"
            android:layout_marginEnd="@dimen/tv_btn_yes_wakeup_padding_8155"
            app:layout_constraintBottom_toBottomOf="@+id/v_driver_register_lock"
            app:layout_constraintEnd_toStartOf="@+id/tv_btn_no_register"
            app:layout_constraintStart_toStartOf="@+id/v_driver_register_lock"/>
        <com.byd.vrsettings.view.AppTextView
            android:textSize="@dimen/text_size_24"
            android:textColor="@color/view_dialog_btn_no_8155"
            android:gravity="center"
            android:id="@+id/tv_btn_no_register"
            android:background="@drawable/bg_setting_btn_no"
            android:layout_width="@dimen/dp_0"
            android:layout_height="@dimen/tv_btn_yes_no_height_8155"
            android:text="@string/text_btn_off"
            android:layout_marginEnd="@dimen/tv_btn_yes_wakeup_left_8155"
            app:layout_constraintBottom_toBottomOf="@+id/tv_btn_yes_register"
            app:layout_constraintEnd_toEndOf="@+id/v_driver_register_lock"
            app:layout_constraintStart_toEndOf="@+id/tv_btn_yes_register"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
