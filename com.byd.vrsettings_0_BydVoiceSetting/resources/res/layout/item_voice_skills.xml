<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_item_voice_skills"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="locale">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_tab"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:id="@+id/v_map"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/layout_tab"
            app:layout_constraintEnd_toStartOf="@+id/v_vehicle"
            app:layout_constraintStart_toStartOf="@+id/layout_tab"
            app:layout_constraintTop_toTopOf="@+id/v_phone"/>
        <View
            android:id="@+id/v_map_click"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/v_map"
            app:layout_constraintEnd_toEndOf="@+id/v_map"
            app:layout_constraintStart_toStartOf="@+id/v_map"
            app:layout_constraintTop_toTopOf="@+id/v_map"/>
        <ImageView
            android:id="@+id/iv_voice_skills_map"
            android:layout_width="@dimen/iv_voice_skills_map_width_height_8155"
            android:layout_height="@dimen/iv_voice_skills_map_width_height_8155"
            android:src="@mipmap/ic_map_p"
            app:layout_constraintEnd_toEndOf="@+id/v_map"
            app:layout_constraintStart_toStartOf="@+id/v_map"
            app:layout_constraintTop_toTopOf="@+id/iv_voice_skills_phone"/>
        <com.byd.vrsettings.view.AppTextView
            android:textSize="@dimen/text_size_24"
            android:textColor="@color/voice_setting_text"
            android:gravity="center"
            android:id="@+id/tv_voice_skills_map"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/iv_voice_skills_map_top_8155"
            android:text="@string/text_map"
            app:layout_constraintEnd_toEndOf="@+id/v_map"
            app:layout_constraintStart_toStartOf="@+id/v_map"
            app:layout_constraintTop_toBottomOf="@+id/iv_voice_skills_map"/>
        <View
            android:id="@+id/v_vehicle"
            android:layout_width="0dp"
            android:layout_height="96dp"
            android:layout_marginStart="0dp"
            app:layout_constraintEnd_toStartOf="@+id/v_phone"
            app:layout_constraintStart_toEndOf="@+id/v_map"
            app:layout_constraintTop_toTopOf="@+id/v_phone"/>
        <View
            android:id="@+id/v_vehicle_click"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/v_vehicle"
            app:layout_constraintEnd_toEndOf="@+id/v_vehicle"
            app:layout_constraintStart_toStartOf="@+id/v_vehicle"
            app:layout_constraintTop_toTopOf="@+id/v_vehicle"/>
        <ImageView
            android:id="@+id/iv_voice_skills_vehicle"
            android:layout_width="@dimen/iv_voice_skills_map_width_height_8155"
            android:layout_height="@dimen/iv_voice_skills_map_width_height_8155"
            android:layout_marginTop="12dp"
            android:src="@mipmap/ic_vehicle_n"
            app:layout_constraintEnd_toEndOf="@+id/v_vehicle"
            app:layout_constraintStart_toStartOf="@+id/v_vehicle"
            app:layout_constraintTop_toTopOf="@+id/v_vehicle"/>
        <com.byd.vrsettings.view.AppTextView
            android:textSize="@dimen/text_size_24"
            android:textColor="@color/voice_setting_text"
            android:gravity="center"
            android:id="@+id/tv_voice_skills_vehicle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/iv_voice_skills_map_top_8155"
            android:text="@string/text_vehicle"
            app:layout_constraintEnd_toEndOf="@+id/v_vehicle"
            app:layout_constraintStart_toStartOf="@+id/v_vehicle"
            app:layout_constraintTop_toBottomOf="@+id/iv_voice_skills_vehicle"/>
        <View
            android:id="@+id/v_phone"
            android:layout_width="0dp"
            android:layout_height="96dp"
            android:layout_marginStart="0dp"
            app:layout_constraintEnd_toStartOf="@+id/v_player"
            app:layout_constraintStart_toEndOf="@+id/v_vehicle"
            app:layout_constraintTop_toTopOf="@+id/layout_tab"/>
        <View
            android:id="@+id/v_phone_click"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/v_phone"
            app:layout_constraintEnd_toEndOf="@+id/v_phone"
            app:layout_constraintStart_toStartOf="@+id/v_phone"
            app:layout_constraintTop_toTopOf="@+id/v_phone"/>
        <ImageView
            android:id="@+id/iv_voice_skills_phone"
            android:layout_width="@dimen/iv_voice_skills_map_width_height_8155"
            android:layout_height="@dimen/iv_voice_skills_map_width_height_8155"
            android:layout_marginTop="12dp"
            android:src="@mipmap/ic_phone_n"
            app:layout_constraintEnd_toEndOf="@+id/v_phone"
            app:layout_constraintStart_toStartOf="@+id/v_phone"
            app:layout_constraintTop_toTopOf="@+id/v_phone"/>
        <com.byd.vrsettings.view.AppTextView
            android:textSize="@dimen/text_size_24"
            android:textColor="@color/voice_setting_text"
            android:gravity="center"
            android:id="@+id/tv_voice_skills_phone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/iv_voice_skills_map_top_8155"
            android:text="@string/text_phone"
            app:layout_constraintEnd_toEndOf="@+id/v_phone"
            app:layout_constraintStart_toStartOf="@+id/v_phone"
            app:layout_constraintTop_toBottomOf="@+id/iv_voice_skills_phone"/>
        <View
            android:id="@+id/v_player"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/v_phone"
            app:layout_constraintEnd_toStartOf="@+id/v_system"
            app:layout_constraintStart_toEndOf="@+id/v_phone"
            app:layout_constraintTop_toTopOf="@+id/v_phone"/>
        <View
            android:id="@+id/v_player_click"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/v_player"
            app:layout_constraintEnd_toEndOf="@+id/v_player"
            app:layout_constraintStart_toStartOf="@+id/v_player"
            app:layout_constraintTop_toTopOf="@+id/v_player"/>
        <ImageView
            android:id="@+id/iv_voice_skills_player"
            android:layout_width="@dimen/iv_voice_skills_map_width_height_8155"
            android:layout_height="@dimen/iv_voice_skills_map_width_height_8155"
            android:src="@mipmap/ic_player_n"
            app:layout_constraintEnd_toEndOf="@+id/v_player"
            app:layout_constraintStart_toStartOf="@+id/v_player"
            app:layout_constraintTop_toTopOf="@+id/iv_voice_skills_phone"/>
        <com.byd.vrsettings.view.AppTextView
            android:textSize="@dimen/text_size_24"
            android:textColor="@color/voice_setting_text"
            android:gravity="center"
            android:id="@+id/tv_voice_skills_player"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/iv_voice_skills_map_top_8155"
            android:text="@string/text_player"
            app:layout_constraintEnd_toEndOf="@+id/v_player"
            app:layout_constraintStart_toStartOf="@+id/v_player"
            app:layout_constraintTop_toBottomOf="@+id/iv_voice_skills_player"/>
        <View
            android:id="@+id/v_system"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/v_phone"
            app:layout_constraintEnd_toEndOf="@+id/layout_tab"
            app:layout_constraintStart_toEndOf="@+id/v_player"
            app:layout_constraintTop_toTopOf="@+id/v_phone"/>
        <View
            android:id="@+id/v_system_click"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/v_system"
            app:layout_constraintEnd_toEndOf="@+id/v_system"
            app:layout_constraintStart_toStartOf="@+id/v_system"
            app:layout_constraintTop_toTopOf="@+id/v_system"/>
        <ImageView
            android:id="@+id/iv_voice_skills_system"
            android:layout_width="@dimen/iv_voice_skills_map_width_height_8155"
            android:layout_height="@dimen/iv_voice_skills_map_width_height_8155"
            android:src="@mipmap/ic_system_n"
            app:layout_constraintEnd_toEndOf="@+id/v_system"
            app:layout_constraintStart_toStartOf="@+id/v_system"
            app:layout_constraintTop_toTopOf="@+id/iv_voice_skills_phone"/>
        <com.byd.vrsettings.view.AppTextView
            android:textSize="@dimen/text_size_24"
            android:textColor="@color/voice_setting_text"
            android:gravity="center"
            android:id="@+id/tv_voice_skills_system"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/iv_voice_skills_map_top_8155"
            android:text="@string/text_system"
            app:layout_constraintEnd_toEndOf="@+id/v_system"
            app:layout_constraintStart_toStartOf="@+id/v_system"
            app:layout_constraintTop_toBottomOf="@+id/iv_voice_skills_system"/>
        <View
            android:id="@+id/v_offline"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="@dimen/fl_skills_margin_end"
            app:layout_constraintBottom_toBottomOf="@+id/v_vehicle"
            app:layout_constraintEnd_toEndOf="@+id/layout_tab"
            app:layout_constraintStart_toEndOf="@+id/v_system"
            app:layout_constraintTop_toTopOf="@+id/v_phone"/>
        <View
            android:id="@+id/v_offline_click"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/v_offline"
            app:layout_constraintEnd_toEndOf="@+id/v_offline"
            app:layout_constraintStart_toStartOf="@+id/v_offline"
            app:layout_constraintTop_toTopOf="@+id/v_offline"/>
        <ImageView
            android:id="@+id/iv_voice_skills_offline"
            android:visibility="gone"
            android:layout_width="@dimen/iv_voice_skills_map_width_height_8155"
            android:layout_height="@dimen/iv_voice_skills_map_width_height_8155"
            android:src="@mipmap/ic_offline_n"
            app:layout_constraintEnd_toEndOf="@+id/v_offline"
            app:layout_constraintStart_toStartOf="@+id/v_offline"
            app:layout_constraintTop_toTopOf="@+id/iv_voice_skills_vehicle"/>
        <com.byd.vrsettings.view.AppTextView
            android:textSize="@dimen/text_size_24"
            android:textColor="@color/voice_setting_text"
            android:gravity="center"
            android:id="@+id/tv_voice_skills_offline"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/iv_voice_skills_map_top_8155"
            android:text="@string/text_offline"
            app:layout_constraintEnd_toEndOf="@+id/v_offline"
            app:layout_constraintStart_toStartOf="@+id/v_offline"
            app:layout_constraintTop_toBottomOf="@+id/iv_voice_skills_offline"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/bugView"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/fl_skills"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_tab"/>
    <FrameLayout
        android:id="@+id/fl_skills"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        android:layout_marginTop="@dimen/fl_skills_margin_top_8155"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_tab"/>
</androidx.constraintlayout.widget.ConstraintLayout>
