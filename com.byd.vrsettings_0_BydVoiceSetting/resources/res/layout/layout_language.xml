<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_language"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/v_language"
        android:background="@drawable/bg_setting_dialog"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="@dimen/cl_wake_word_width"
        android:layout_height="@dimen/v_language_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/text_size_36"
        android:textColor="@color/voice_setting_title"
        android:id="@+id/tv_title_language"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/custom_title_margin_top"
        android:text="@string/text_language"
        app:layout_constraintEnd_toEndOf="@+id/v_language"
        app:layout_constraintStart_toStartOf="@+id/v_language"
        app:layout_constraintTop_toTopOf="@+id/v_language"/>
    <TextView
        android:textSize="@dimen/text_size_title"
        android:textColor="@color/voice_setting_text"
        android:id="@+id/tv_switch_language"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/tv_switch_language_margin_top"
        android:text="@string/text_switch_language"
        android:layout_marginStart="@dimen/tv_audio_wakeup_margin_start_end"
        android:layout_marginEnd="@dimen/tv_audio_wakeup_margin_start_end"
        app:layout_constraintEnd_toEndOf="@+id/v_language"
        app:layout_constraintStart_toStartOf="@+id/v_language"
        app:layout_constraintTop_toBottomOf="@+id/tv_title_language"/>
    <ScrollView
        android:id="@+id/sv_language"
        android:scrollbars="none"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        android:layout_marginTop="@dimen/margin_24"
        android:layout_marginBottom="@dimen/margin_24"
        app:layout_constraintBottom_toTopOf="@+id/g_language"
        app:layout_constraintEnd_toEndOf="@+id/tv_switch_language"
        app:layout_constraintStart_toStartOf="@+id/tv_switch_language"
        app:layout_constraintTop_toBottomOf="@+id/tv_switch_language">
        <RadioGroup
            android:layout_gravity="center"
            android:id="@+id/rg_language"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/g_language"
            app:layout_constraintEnd_toEndOf="@+id/tv_switch_language"
            app:layout_constraintStart_toStartOf="@+id/tv_switch_language"
            app:layout_constraintTop_toBottomOf="@+id/tv_switch_language"/>
    </ScrollView>
    <View
        android:orientation="vertical"
        android:id="@+id/g_language"
        android:background="@color/bg_guideline"
        android:layout_width="@dimen/px_1"
        android:layout_height="@dimen/tv_btn_yes_no_height"
        android:layout_marginTop="@dimen/custom_title_margin_top"
        app:layout_constraintBottom_toBottomOf="@+id/v_language"
        app:layout_constraintEnd_toEndOf="@+id/v_language"
        app:layout_constraintStart_toStartOf="@+id/v_language"/>
    <TextView
        android:textSize="@dimen/text_size_24"
        android:textColor="@color/voice_setting_text_selected"
        android:gravity="center"
        android:id="@+id/tv_btn_yes_language"
        android:background="@drawable/bg_setting_btn_yes"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/tv_btn_yes_no_height"
        android:text="@string/text_btn_yes"
        app:layout_constraintBottom_toBottomOf="@+id/v_language"
        app:layout_constraintEnd_toStartOf="@+id/g_language"
        app:layout_constraintStart_toStartOf="@+id/v_language"
        app:layout_constraintTop_toTopOf="@+id/g_language"/>
    <TextView
        android:textSize="@dimen/text_size_24"
        android:textColor="@color/voice_setting_title"
        android:gravity="center"
        android:id="@+id/tv_btn_no_language"
        android:background="@drawable/bg_setting_btn_no"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/tv_btn_yes_no_height"
        android:text="@string/text_btn_no"
        app:layout_constraintBottom_toBottomOf="@+id/v_language"
        app:layout_constraintEnd_toEndOf="@+id/v_language"
        app:layout_constraintStart_toEndOf="@+id/g_language"
        app:layout_constraintTop_toTopOf="@+id/g_language"/>
</androidx.constraintlayout.widget.ConstraintLayout>
