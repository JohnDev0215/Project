<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/register_lock_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/v_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_register_lock"
        android:background="@mipmap/view_dialog_background"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="@dimen/cl_primary_secondary_width_8155"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.byd.vrsettings.view.AppTextView
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold"
            android:textColor="@color/dialog_titleTextColor"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/custom_title_margin_top_8155"
            android:text="@string/text_audio_zone_settings"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/register_lock_line"
            android:background="@color/diglog_line_backColor_8155"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="79dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintEnd_toEndOf="@+id/cl_register_lock"
            app:layout_constraintStart_toStartOf="@+id/cl_register_lock"
            app:layout_constraintTop_toTopOf="@+id/cl_register_lock"/>
        <com.byd.vrsettings.view.AppTextView
            android:textSize="@dimen/text_size_30"
            android:textColor="@color/dialog_contentTextColor"
            android:gravity="center"
            android:id="@+id/tv_four_register_locked"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="45dp"
            android:text="@string/text_audio_zone_settings_short_tip"
            android:layout_marginStart="@dimen/tv_audio_wakeup_margin_start_end_8155"
            android:layout_marginEnd="@dimen/tv_audio_wakeup_margin_start_end_8155"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
        <ImageView
            android:id="@+id/iv_register_lock"
            android:layout_width="217dp"
            android:layout_height="326dp"
            android:layout_marginTop="139dp"
            android:src="@mipmap/img_register_lock"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/cl_register_lock"/>
        <Button
            android:id="@+id/iv_front_left"
            android:tag="1"
            android:background="@drawable/bg_front_left_style"
            android:layout_width="78dp"
            android:layout_height="88dp"
            android:layout_marginTop="99dp"
            android:layout_marginStart="30dp"
            app:layout_constraintStart_toStartOf="@+id/iv_register_lock"
            app:layout_constraintTop_toTopOf="@+id/iv_register_lock"/>
        <Button
            android:id="@+id/iv_front_right"
            android:tag="2"
            android:background="@drawable/bg_front_right_style"
            android:layout_width="82dp"
            android:layout_height="88dp"
            android:layout_marginTop="99dp"
            android:layout_marginEnd="23dp"
            app:layout_constraintEnd_toEndOf="@+id/iv_register_lock"
            app:layout_constraintTop_toTopOf="@+id/iv_register_lock"/>
        <Button
            android:id="@+id/iv_rear_left"
            android:tag="3"
            android:background="@drawable/bg_rear_left_style"
            android:layout_width="80dp"
            android:layout_height="106dp"
            android:layout_marginBottom="38dp"
            android:layout_marginStart="30dp"
            app:layout_constraintBottom_toBottomOf="@+id/iv_register_lock"
            app:layout_constraintStart_toStartOf="@+id/iv_register_lock"/>
        <Button
            android:id="@+id/iv_rear_right"
            android:tag="4"
            android:background="@drawable/bg_rear_right_style"
            android:layout_width="80dp"
            android:layout_height="106dp"
            android:layout_marginBottom="38dp"
            android:layout_marginEnd="23dp"
            app:layout_constraintBottom_toBottomOf="@+id/iv_register_lock"
            app:layout_constraintEnd_toEndOf="@+id/iv_register_lock"/>
        <com.byd.vrsettings.view.AppTextView
            android:textSize="@dimen/text_size_30"
            android:textColor="@color/dialog_button_ok_textColor"
            android:gravity="center"
            android:id="@+id/tv_btn_yes"
            android:background="@drawable/bg_setting_btn_yes"
            android:layout_width="192dp"
            android:layout_height="48dp"
            android:layout_marginBottom="85dp"
            android:text="@string/text_ok"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/iv_register_lock"
            app:layout_constraintStart_toStartOf="@+id/iv_register_lock"
            app:layout_constraintTop_toBottomOf="@+id/iv_register_lock"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
