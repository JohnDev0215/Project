<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fl_setting_background"
    android:background="@mipmap/img_light_app_bg_h"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_setting"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/iv_appIcon"
            android:layout_width="@dimen/iv_appIcon_8155"
            android:layout_height="@dimen/iv_appIcon_8155"
            android:layout_marginTop="@dimen/iv_appIcon_top_8155"
            android:src="@mipmap/img_light_voice_144"
            android:layout_marginStart="@dimen/iv_appIcon_left_8155"
            android:layout_marginEnd="@dimen/iv_appIcon_right_8155"
            android:elevation="@dimen/v_popup_elevation"
            app:layout_constraintEnd_toEndOf="@+id/iv_tab"
            app:layout_constraintStart_toStartOf="@+id/iv_tab"
            app:layout_constraintTop_toTopOf="@+id/iv_tab"/>
        <com.byd.vrsettings.view.AppTextView
            android:textSize="@dimen/iv_tab_Subtitle_textSize_8155"
            android:textColor="@color/tv_tabTitle"
            android:gravity="center"
            android:id="@+id/tv_tabSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/iv_tab_title_top_8155"
            android:text="@string/voice_setting_hello_tip"
            android:layout_marginStart="51dp"
            android:layout_marginEnd="79dp"
            android:elevation="@dimen/v_popup_elevation"
            app:layout_constraintEnd_toEndOf="@+id/iv_tab"
            app:layout_constraintStart_toStartOf="@+id/iv_tab"
            app:layout_constraintTop_toBottomOf="@+id/iv_appIcon"/>
        <ImageView
            android:id="@+id/iv_tab"
            android:clickable="false"
            android:layout_width="@dimen/iv_tab_width_8155"
            android:layout_height="0dp"
            android:src="@null"
            android:elevation="@dimen/elevation_tab"
            app:layout_constraintBottom_toTopOf="@+id/main_bottom"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/cl_setting"/>
        <View
            android:id="@+id/v_voice_setting"
            android:background="@mipmap/bg_primary_navigation_selected"
            android:layout_width="@dimen/voice_setting_wight_8155"
            android:layout_height="@dimen/voice_setting_height_8155"
            android:layout_marginTop="@dimen/iv_voice_setting_top_8155"
            android:elevation="@dimen/elevation_tab"
            app:layout_constraintStart_toStartOf="@+id/iv_tab"
            app:layout_constraintTop_toBottomOf="@+id/tv_tabSubtitle"/>
        <ImageView
            android:id="@+id/iv_voice_setting"
            android:layout_width="@dimen/voice_setting_vertical_width_8155"
            android:layout_height="@dimen/voice_setting_vertical_width_8155"
            android:src="@mipmap/voice_setting_selected"
            android:layout_marginStart="@dimen/voice_setting_image_margin_left_8155"
            android:elevation="@dimen/elevation_tab"
            app:layout_constraintBottom_toBottomOf="@+id/v_voice_setting"
            app:layout_constraintStart_toStartOf="@+id/v_voice_setting"
            app:layout_constraintTop_toTopOf="@+id/v_voice_setting"/>
        <com.byd.vrsettings.view.AppTextView
            android:textSize="@dimen/text_size_24"
            android:textColor="@color/voice_setting_text_selected"
            android:id="@+id/tv_voice_setting"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/text_voice_setting"
            android:layout_marginStart="@dimen/tv_voice_setting_margin_right_8155"
            android:elevation="@dimen/elevation_tab"
            app:layout_constraintBottom_toBottomOf="@+id/iv_voice_setting"
            app:layout_constraintStart_toEndOf="@+id/iv_voice_setting"
            app:layout_constraintTop_toTopOf="@+id/iv_voice_setting"/>
        <View
            android:id="@+id/v_voice_skills"
            android:layout_width="0dp"
            android:layout_height="@dimen/voice_setting_height_8155"
            android:layout_marginTop="@dimen/voice_skills_margin_top_8155"
            android:elevation="@dimen/elevation_tab"
            app:layout_constraintEnd_toEndOf="@+id/v_voice_setting"
            app:layout_constraintStart_toStartOf="@+id/iv_tab"
            app:layout_constraintTop_toBottomOf="@+id/v_voice_setting"/>
        <ImageView
            android:id="@+id/iv_voice_skills"
            android:layout_width="@dimen/voice_setting_vertical_width_8155"
            android:layout_height="@dimen/voice_setting_vertical_width_8155"
            android:src="@mipmap/voice_skills"
            android:layout_marginStart="@dimen/voice_setting_image_margin_left_8155"
            android:elevation="@dimen/elevation_tab"
            app:layout_constraintBottom_toBottomOf="@+id/v_voice_skills"
            app:layout_constraintStart_toStartOf="@+id/v_voice_skills"
            app:layout_constraintTop_toTopOf="@+id/v_voice_skills"/>
        <com.byd.vrsettings.view.AppTextView
            android:textSize="@dimen/text_size_24"
            android:textColor="@color/voice_setting_text_8155"
            android:id="@+id/tv_voice_skills"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/text_voice_skills"
            android:layout_marginStart="@dimen/tv_voice_setting_margin_right_8155"
            android:elevation="@dimen/elevation_tab"
            app:layout_constraintBottom_toBottomOf="@+id/iv_voice_skills"
            app:layout_constraintStart_toEndOf="@+id/iv_voice_skills"
            app:layout_constraintTop_toTopOf="@+id/iv_voice_skills"/>
        <FrameLayout
            android:id="@+id/fl_setting"
            android:background="@android:color/transparent"
            android:layout_width="@dimen/dp_0"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/main_bottom"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_tab"
            app:layout_constraintTop_toTopOf="@+id/cl_setting"/>
        <View
            android:id="@+id/main_bottom"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
