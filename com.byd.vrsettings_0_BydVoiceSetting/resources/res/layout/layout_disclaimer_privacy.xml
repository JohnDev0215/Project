<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_guide"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/v_guideBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/v_guide"
        android:background="@mipmap/view_dialog_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.78"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.52"/>
    <com.byd.vrsettings.view.AppTextView
        android:textSize="@dimen/text_size_30"
        android:textStyle="bold"
        android:textColor="@color/voice_setting_title"
        android:id="@+id/tv_title_guide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="@string/text_disclaimer_title"
        app:layout_constraintEnd_toEndOf="@+id/v_guide"
        app:layout_constraintStart_toStartOf="@+id/v_guide"
        app:layout_constraintTop_toTopOf="@+id/v_guide"/>
    <View
        android:id="@+id/disclaimer_line"
        android:background="@color/diglog_line_backColor_8155"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="79dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="@+id/v_guide"
        app:layout_constraintStart_toStartOf="@+id/v_guide"
        app:layout_constraintTop_toTopOf="@+id/v_guide"/>
    <ScrollView
        android:scrollbarThumbVertical="@drawable/bg_scrollbar"
        android:id="@+id/sv_guide"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="35dp"
        android:layout_marginBottom="65dp"
        android:layout_marginStart="72dp"
        android:layout_marginEnd="72dp"
        app:layout_constraintBottom_toBottomOf="@+id/v_guide"
        app:layout_constraintEnd_toEndOf="@+id/v_guide"
        app:layout_constraintStart_toStartOf="@+id/v_guide"
        app:layout_constraintTop_toBottomOf="@+id/disclaimer_BtnX">
        <com.byd.vrsettings.view.AppTextView
            android:textSize="@dimen/text_size_27"
            android:textColor="@color/voice_setting_text"
            android:id="@+id/tv_text_guide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auth_text"
            android:lineSpacingMultiplier="1.5"
            android:paddingEnd="5dp"/>
    </ScrollView>
    <ImageView
        android:id="@+id/disclaimer_BtnX"
        android:background="@mipmap/dialog_icon_back"
        android:layout_width="@dimen/tv_cerence_privacy_BtnX_width_height"
        android:layout_height="@dimen/tv_cerence_privacy_BtnX_width_height"
        android:layout_marginStart="40dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_title_guide"
        app:layout_constraintStart_toStartOf="@+id/v_guide"
        app:layout_constraintTop_toTopOf="@+id/tv_title_guide"/>
</androidx.constraintlayout.widget.ConstraintLayout>
