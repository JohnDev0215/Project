<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/blankdoorBackView_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/blankdoorBackView"
        android:background="@drawable/bg_setting_popup"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="@dimen/cl_privacy_word_width"
        android:layout_height="@dimen/cl_privacy_word_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.502"/>
    <ImageView
        android:id="@+id/blankdoor_BtnX"
        android:background="@drawable/ic_cerence_privacy_x"
        android:layout_width="@dimen/tv_cerence_privacy_BtnX_width_height"
        android:layout_height="@dimen/tv_cerence_privacy_BtnX_width_height"
        android:layout_marginTop="@dimen/tv_cerence_privacy_BtnX_margintop"
        android:layout_marginStart="@dimen/tv_cerence_privacy_BtnX_marginleft"
        app:layout_constraintStart_toStartOf="@+id/blankdoorBackView"
        app:layout_constraintTop_toTopOf="@+id/blankdoorBackView"/>
    <View
        android:id="@+id/background_view"
        android:background="@color/white"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/tv_cerence_privacy_BtnX_margintop"
        app:layout_constraintBottom_toBottomOf="@+id/blankdoorBackView"
        app:layout_constraintEnd_toEndOf="@+id/blankdoorBackView"
        app:layout_constraintStart_toStartOf="@+id/blankdoorBackView"
        app:layout_constraintTop_toBottomOf="@+id/blankdoor_BtnX"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mRecyclerView"
        android:background="@color/white"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/tv_cerence_privacy_BtnX_margintop"
        app:layout_constraintBottom_toBottomOf="@+id/blankdoorBackView"
        app:layout_constraintEnd_toEndOf="@+id/blankdoorBackView"
        app:layout_constraintStart_toStartOf="@+id/blankdoorBackView"
        app:layout_constraintTop_toBottomOf="@+id/blankdoor_BtnX"/>
    <Button
        android:textSize="@dimen/text_size_30"
        android:id="@+id/privacyLogBtn"
        android:background="@drawable/bg_hiddendoor_btn"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="privacyLog"
        android:textAllCaps="false"
        android:layout_marginStart="@dimen/padding_36"
        app:layout_constraintEnd_toStartOf="@+id/soundRecordingBtn"
        app:layout_constraintStart_toEndOf="@+id/blankdoor_BtnX"
        app:layout_constraintTop_toTopOf="@+id/blankdoor_BtnX"/>
    <Button
        android:textSize="@dimen/text_size_30"
        android:textColor="@color/bg_dialog_grey"
        android:id="@+id/soundRecordingBtn"
        android:background="@drawable/bg_hiddendoor_btn"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="sound recording"
        android:textAllCaps="false"
        android:layout_marginStart="@dimen/padding_36"
        app:layout_constraintEnd_toStartOf="@+id/weatherBtn"
        app:layout_constraintStart_toEndOf="@+id/privacyLogBtn"
        app:layout_constraintTop_toTopOf="@+id/privacyLogBtn"/>
    <Button
        android:textSize="@dimen/text_size_30"
        android:textColor="@color/bg_dialog_grey"
        android:id="@+id/weatherBtn"
        android:background="@drawable/bg_hiddendoor_btn"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="weather"
        android:textAllCaps="false"
        android:layout_marginStart="@dimen/padding_36"
        app:layout_constraintEnd_toStartOf="@+id/VRInfoBtn"
        app:layout_constraintStart_toEndOf="@+id/soundRecordingBtn"
        app:layout_constraintTop_toTopOf="@+id/soundRecordingBtn"/>
    <Button
        android:textSize="@dimen/text_size_30"
        android:textColor="@color/bg_dialog_grey"
        android:id="@+id/VRInfoBtn"
        android:background="@drawable/bg_hiddendoor_btn"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="VRInfo"
        android:textAllCaps="false"
        android:layout_marginStart="@dimen/padding_36"
        app:layout_constraintEnd_toStartOf="@+id/Language_test_Btn"
        app:layout_constraintStart_toEndOf="@+id/weatherBtn"
        app:layout_constraintTop_toTopOf="@+id/weatherBtn"/>
    <com.byd.vrsettings.view.AppTextView
        android:textSize="@dimen/text_size_30"
        android:textColor="@color/black"
        android:id="@+id/VRInfoText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:text=""
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="@+id/blankdoorBackView"
        app:layout_constraintStart_toStartOf="@+id/blankdoorBackView"
        app:layout_constraintTop_toBottomOf="@+id/soundRecordingBtn"/>
    <Button
        android:textSize="@dimen/text_size_30"
        android:id="@+id/weatherSwitch"
        android:visibility="gone"
        android:layout_width="100dp"
        android:layout_height="72dp"
        android:layout_marginTop="50dp"
        android:text="ON"
        android:textAllCaps="false"
        app:layout_constraintEnd_toEndOf="@+id/blankdoorBackView"
        app:layout_constraintStart_toStartOf="@+id/blankdoorBackView"
        app:layout_constraintTop_toBottomOf="@+id/soundRecordingBtn"/>
    <Button
        android:textSize="@dimen/text_size_30"
        android:id="@+id/sound_begin_btn"
        android:background="@drawable/sound_background_btn"
        android:visibility="gone"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginTop="50dp"
        android:textAllCaps="false"
        app:layout_constraintEnd_toEndOf="@+id/blankdoorBackView"
        app:layout_constraintStart_toStartOf="@+id/blankdoorBackView"
        app:layout_constraintTop_toBottomOf="@+id/soundRecordingBtn"/>
    <Button
        android:textSize="@dimen/text_size_30"
        android:textColor="@color/bg_dialog_grey"
        android:id="@+id/Language_test_Btn"
        android:background="@drawable/bg_hiddendoor_btn"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="INITMSG"
        android:textAllCaps="false"
        android:layout_marginStart="@dimen/padding_36"
        android:layout_marginEnd="@dimen/padding_36"
        app:layout_constraintEnd_toEndOf="@+id/blankdoorBackView"
        app:layout_constraintStart_toEndOf="@+id/VRInfoBtn"
        app:layout_constraintTop_toTopOf="@+id/VRInfoBtn"/>
    <com.byd.vrsettings.view.AppTextView
        android:textSize="@dimen/text_size_30"
        android:textColor="@color/black"
        android:id="@+id/language_BackView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:text=""
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="@+id/blankdoorBackView"
        app:layout_constraintStart_toStartOf="@+id/blankdoorBackView"
        app:layout_constraintTop_toBottomOf="@+id/soundRecordingBtn"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/language_BackView1"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/blankdoorBackView"
        app:layout_constraintStart_toStartOf="@+id/blankdoorBackView"
        app:layout_constraintTop_toBottomOf="@+id/Language_test_Btn">
        <Button
            android:id="@+id/de_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="De"
            app:layout_constraintEnd_toStartOf="@+id/No_btn"
            app:layout_constraintStart_toStartOf="@+id/language_BackView1"
            app:layout_constraintTop_toTopOf="@+id/language_BackView1"/>
        <Button
            android:id="@+id/No_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NO"
            app:layout_constraintEnd_toStartOf="@+id/Pt_btn"
            app:layout_constraintStart_toEndOf="@+id/de_btn"
            app:layout_constraintTop_toTopOf="@+id/de_btn"/>
        <Button
            android:id="@+id/Pt_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PT"
            app:layout_constraintEnd_toStartOf="@+id/Es_btn"
            app:layout_constraintStart_toEndOf="@+id/No_btn"
            app:layout_constraintTop_toTopOf="@+id/de_btn"/>
        <Button
            android:id="@+id/Es_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ES"
            app:layout_constraintEnd_toEndOf="@+id/language_BackView1"
            app:layout_constraintStart_toEndOf="@+id/Pt_btn"
            app:layout_constraintTop_toTopOf="@+id/de_btn"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
