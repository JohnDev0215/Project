<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dialog_bg"
        android:background="#b8000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_dialog_root"
            android:background="@drawable/bg_setting_dialog"
            android:paddingBottom="40dp"
            android:layout_width="560dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.byd.vrsettings.view.AppTextView
                android:textSize="20sp"
                android:textColor="@color/voice_setting_title"
                android:id="@+id/textview_content"
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:layout_marginBottom="16dp"
                android:paddingStart="40dp"
                android:paddingEnd="40dp"
                android:elevation="2dp"
                app:layout_constraintBottom_toTopOf="@+id/view_reboot"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.byd.vrsettings.view.AppTextView
                android:textSize="@dimen/text_size_30"
                android:textColor="@color/view_dialog_btn_ok_8155"
                android:gravity="center"
                android:id="@+id/positive"
                android:background="@drawable/bg_setting_btn_yes"
                android:layout_width="@dimen/dp_0"
                android:layout_height="48dp"
                android:layout_marginTop="@dimen/dimen_28"
                android:layout_marginBottom="@dimen/dimen_28"
                android:text="@string/text_download"
                android:layout_marginStart="@dimen/tv_btn_yes_wakeup_left_8155"
                app:layout_constraintEnd_toStartOf="@+id/negative"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view_reboot"/>
            <com.byd.vrsettings.view.AppTextView
                android:textSize="@dimen/text_size_30"
                android:textColor="@color/voice_setting_title_8155"
                android:gravity="center"
                android:id="@+id/negative"
                android:background="@drawable/bg_setting_btn_no"
                android:layout_width="@dimen/dp_0"
                android:layout_height="48dp"
                android:text="@string/text_btn_Disagree"
                android:layout_marginStart="@dimen/tv_btn_yes_wakeup_padding_8155"
                android:layout_marginEnd="@dimen/tv_btn_yes_wakeup_left_8155"
                app:layout_constraintBottom_toBottomOf="@+id/positive"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/positive"/>
            <CheckBox
                android:id="@+id/checkbox"
                android:clickable="true"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:checked="true"
                android:button="@drawable/checkbox_selector"
                android:layout_marginStart="40dp"
                android:elevation="3dp"
                app:layout_constraintBottom_toBottomOf="@+id/view_reboot"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/view_reboot"/>
            <com.byd.vrsettings.view.AppTextView
                android:textSize="18sp"
                android:textColor="@color/voice_setting_title"
                android:id="@+id/textview_radio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_auto_enable"
                android:elevation="3dp"
                app:layout_constraintBottom_toBottomOf="@+id/view_reboot"
                app:layout_constraintStart_toEndOf="@+id/checkbox"
                app:layout_constraintTop_toTopOf="@+id/view_reboot"/>
            <View
                android:id="@+id/view_reboot"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:elevation="2dp"
                app:layout_constraintBottom_toTopOf="@+id/positive"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>
