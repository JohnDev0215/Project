<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_cerence_privacy"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/v_cerence_privacyBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/cerence_privacy"
        android:background="@mipmap/view_dialog_background"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.78"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.52"/>
    <ImageView
        android:id="@+id/cerence_privacy_BtnX"
        android:background="@mipmap/dialog_icon_back"
        android:layout_width="@dimen/tv_cerence_privacy_BtnX_width_height"
        android:layout_height="@dimen/tv_cerence_privacy_BtnX_width_height"
        android:layout_marginStart="@dimen/tv_cerence_privacy_BtnX_marginleft_8155"
        app:layout_constraintBottom_toBottomOf="@+id/tv_title_cerence_privacy"
        app:layout_constraintStart_toStartOf="@+id/cerence_privacy"
        app:layout_constraintTop_toTopOf="@+id/tv_title_cerence_privacy"/>
    <com.byd.vrsettings.view.AppTextView
        android:textSize="@dimen/text_size_30"
        android:textStyle="bold"
        android:textColor="@color/voice_setting_title"
        android:id="@+id/tv_title_cerence_privacy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="@string/text_cerence_privacy_title"
        app:layout_constraintEnd_toEndOf="@+id/cerence_privacy"
        app:layout_constraintStart_toStartOf="@+id/cerence_privacy"
        app:layout_constraintTop_toTopOf="@+id/cerence_privacy"/>
    <View
        android:id="@+id/cerence_privacy_line"
        android:background="@color/diglog_line_backColor_8155"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="79dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="@+id/cerence_privacy"
        app:layout_constraintStart_toStartOf="@+id/cerence_privacy"
        app:layout_constraintTop_toTopOf="@+id/cerence_privacy"/>
    <com.byd.vrsettings.utils.MyWebView
        android:id="@+id/cerence_privacy_webView"
        android:background="@android:color/transparent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="55dp"
        android:layout_marginBottom="100dp"
        android:layout_marginStart="@dimen/tv_cerence_privacy_margin_start_end_8155"
        android:layout_marginEnd="@dimen/tv_cerence_privacy_margin_start_end_8155"
        app:layout_constraintBottom_toBottomOf="@+id/cerence_privacy"
        app:layout_constraintEnd_toEndOf="@+id/cerence_privacy"
        app:layout_constraintStart_toStartOf="@+id/cerence_privacy"
        app:layout_constraintTop_toBottomOf="@+id/tv_title_cerence_privacy"/>
</androidx.constraintlayout.widget.ConstraintLayout>
