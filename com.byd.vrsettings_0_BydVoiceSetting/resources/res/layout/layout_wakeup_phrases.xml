<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_wakeup_phrases"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/v_wakeupBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/v_wakeup_phrases"
        android:background="@mipmap/view_dialog_background"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="608dp"
        android:layout_height="441dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.byd.vrsettings.view.AppTextView
        android:textSize="@dimen/text_size_title"
        android:textStyle="bold"
        android:textColor="@color/dialog_titleTextColor"
        android:id="@+id/tv_title_wakeup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/custom_title_margin_top_8155"
        android:text="@string/text_user_define_title"
        app:layout_constraintEnd_toEndOf="@+id/v_wakeup_phrases"
        app:layout_constraintStart_toStartOf="@+id/v_wakeup_phrases"
        app:layout_constraintTop_toTopOf="@+id/v_wakeup_phrases"/>
    <View
        android:id="@+id/wakeup_line"
        android:background="@color/diglog_line_backColor_8155"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="79dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="@+id/v_wakeup_phrases"
        app:layout_constraintStart_toStartOf="@+id/v_wakeup_phrases"
        app:layout_constraintTop_toTopOf="@+id/v_wakeup_phrases"/>
    <com.byd.vrsettings.view.AppEditText
        android:textSize="@dimen/text_size_24"
        android:textColor="@color/dialog_editTextColor"
        android:textColorHint="@color/dialog_editTextHintColor"
        android:id="@+id/et_wake_up"
        android:background="@drawable/rounded_editview"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/et_wake_up_height_8155"
        android:layout_marginTop="@dimen/et_wake_up_margin_top_8155"
        android:hint="@string/text_type_text"
        android:maxLines="1"
        android:singleLine="true"
        android:maxLength="30"
        android:inputType="textNoSuggestions"
        android:paddingStart="24dp"
        android:layout_marginStart="@dimen/et_wake_up_margin_start_end_8155"
        android:layout_marginEnd="@dimen/et_wake_up_margin_start_end_8155"
        app:layout_constraintBottom_toTopOf="@+id/tv_wakeup_phrases"
        app:layout_constraintEnd_toEndOf="@+id/v_wakeup_phrases"
        app:layout_constraintStart_toStartOf="@+id/v_wakeup_phrases"
        app:layout_constraintTop_toBottomOf="@+id/tv_title_wakeup"/>
    <ImageView
        android:id="@+id/iv_empty"
        android:visibility="invisible"
        android:layout_width="@dimen/iv_empty_width_height_8155"
        android:layout_height="0dp"
        android:src="@mipmap/empty"
        app:layout_constraintBottom_toBottomOf="@+id/et_wake_up"
        app:layout_constraintEnd_toEndOf="@+id/et_wake_up"
        app:layout_constraintTop_toTopOf="@+id/et_wake_up"/>
    <com.byd.vrsettings.view.AppTextView
        android:textSize="@dimen/text_size_30"
        android:textColor="@color/dialog_contentTextColor"
        android:id="@+id/tv_wakeup_phrases"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/tv_wakeup_phrases_top_8155"
        android:text="@string/text_wakeup_phrases_tip"
        android:layout_marginStart="@dimen/tv_wakeup_phrases_left_right_8155"
        android:layout_marginEnd="@dimen/tv_wakeup_phrases_left_right_8155"
        app:layout_constraintEnd_toEndOf="@+id/v_wakeup_phrases"
        app:layout_constraintStart_toStartOf="@+id/v_wakeup_phrases"
        app:layout_constraintTop_toBottomOf="@+id/et_wake_up"/>
    <com.byd.vrsettings.view.AppTextView
        android:textSize="@dimen/text_size_30"
        android:textColor="@color/dialog_button_ok_textColor"
        android:gravity="center"
        android:id="@+id/tv_btn_yes_wakeup"
        android:background="@drawable/bg_setting_btn_yes"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginBottom="@dimen/tv_btn_yes_wakeup_bottom_8155"
        android:text="@string/text_btn_yes"
        android:layout_marginStart="@dimen/tv_btn_yes_wakeup_left_8155"
        android:layout_marginEnd="@dimen/tv_btn_yes_wakeup_padding_8155"
        app:layout_constraintBottom_toBottomOf="@+id/v_wakeup_phrases"
        app:layout_constraintEnd_toStartOf="@+id/tv_btn_no_wakeup"
        app:layout_constraintStart_toStartOf="@+id/v_wakeup_phrases"/>
    <com.byd.vrsettings.view.AppTextView
        android:textSize="@dimen/text_size_30"
        android:textColor="@color/dialog_button_cancel_textColor"
        android:gravity="center"
        android:id="@+id/tv_btn_no_wakeup"
        android:background="@drawable/bg_setting_btn_no"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="@string/text_btn_no"
        android:layout_marginEnd="@dimen/tv_btn_yes_wakeup_left_8155"
        app:layout_constraintBottom_toBottomOf="@+id/tv_btn_yes_wakeup"
        app:layout_constraintEnd_toEndOf="@+id/v_wakeup_phrases"
        app:layout_constraintStart_toEndOf="@+id/tv_btn_yes_wakeup"/>
</androidx.constraintlayout.widget.ConstraintLayout>
