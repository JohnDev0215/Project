<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:layout_width="120dp"
    android:layout_height="32dp"
    android:layoutDirection="locale">
    <TextView
        android:textSize="16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/text_funtion"
        android:background="@drawable/shape_corner"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="@string/text_download"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/gp_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="progressbar,text_progress,iv_status"/>
    <ProgressBar
        android:id="@+id/progressbar"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:progress="0"
        android:progressDrawable="@drawable/progressbar_style"
        style="?android:attr/progressBarStyleHorizontal"/>
    <ImageView
        android:id="@+id/iv_status"
        android:visibility="invisible"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="18dp"
        android:textColor="@color/btn_ota_main_color"
        android:gravity="end|center_vertical"
        android:id="@+id/text_progress"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toEndOf="@+id/iv_status"/>
</androidx.constraintlayout.widget.ConstraintLayout>
