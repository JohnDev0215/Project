<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_userimprove"
    android:background="@android:color/transparent"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="locale">
    <View
        android:id="@+id/v_user_Imporvement"
        android:layout_width="match_parent"
        android:layout_height="@dimen/custom_title_height_size"
        android:layout_marginTop="@dimen/custom_title_margin_top"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_userimprove_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@mipmap/btn_back_n"
        android:layout_marginStart="40dp"
        app:layout_constraintBottom_toBottomOf="@+id/v_user_Imporvement"
        app:layout_constraintStart_toStartOf="@+id/v_user_Imporvement"
        app:layout_constraintTop_toTopOf="@+id/v_user_Imporvement"/>
    <com.byd.vrsettings.view.AppTextView
        android:textSize="@dimen/text_size_title"
        android:textColor="@color/voice_setting_title_8155"
        android:id="@+id/tv_user_improve_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/text_userimprovement_setting"
        app:layout_constraintBottom_toBottomOf="@+id/v_user_Imporvement"
        app:layout_constraintEnd_toEndOf="@+id/v_user_Imporvement"
        app:layout_constraintStart_toStartOf="@+id/v_user_Imporvement"
        app:layout_constraintTop_toTopOf="@+id/v_user_Imporvement"/>
    <com.byd.vrsettings.view.AppTextView
        android:id="@+id/joinUser_backgroud"
        android:background="@drawable/bg_view_user_improve"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="33dp"
        android:layout_marginEnd="28dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_user_improve_privacy_policy_bottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/iv_userimprove_back"
        app:layout_constraintTop_toBottomOf="@+id/tv_user_improve_title"/>
    <ImageView
        android:id="@+id/iv_switch_userImprove"
        android:layout_width="@dimen/iv_switch_width_8155"
        android:layout_height="@dimen/iv_switch_height_8155"
        android:layout_marginTop="@dimen/dimen_28"
        android:layout_marginStart="@dimen/iv_switch_margin_start_8155"
        app:layout_constraintStart_toStartOf="@+id/joinUser_backgroud"
        app:layout_constraintTop_toTopOf="@+id/joinUser_backgroud"/>
    <com.byd.vrsettings.view.AppTextView
        android:textSize="@dimen/text_size_title"
        android:textColor="@color/tv_join_user_improve_title_color"
        android:id="@+id/tv_join_user_improve_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="@string/text_join_userimprove_title"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="28dp"
        android:elevation="@dimen/v_popup_elevation"
        app:layout_constraintEnd_toEndOf="@+id/joinUser_backgroud"
        app:layout_constraintStart_toEndOf="@+id/iv_switch_userImprove"
        app:layout_constraintTop_toTopOf="@+id/joinUser_backgroud"/>
    <com.byd.vrsettings.view.AppTextView
        android:textSize="@dimen/text_size_16"
        android:textColor="@color/tv_user_improve_privacy_policy_color"
        android:id="@+id/tv_user_improve_privacy_policy"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/user_privacy_improvement_text"
        android:layout_marginEnd="28dp"
        app:layout_constraintEnd_toEndOf="@+id/joinUser_backgroud"
        app:layout_constraintStart_toStartOf="@+id/tv_join_user_improve_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_join_user_improve_title"/>
    <com.byd.vrsettings.view.AppTextView
        android:id="@+id/tv_user_improve_privacy_policy_bottom"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        app:layout_constraintStart_toStartOf="@+id/tv_user_improve_privacy_policy"
        app:layout_constraintTop_toBottomOf="@+id/tv_user_improve_privacy_policy"/>
    <com.byd.vrsettings.view.AppTextView
        android:id="@+id/deldata_backgroud"
        android:background="@drawable/bg_view_user_improve"
        android:layout_width="0dp"
        android:layout_height="88dp"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="@+id/joinUser_backgroud"
        app:layout_constraintStart_toStartOf="@+id/joinUser_backgroud"
        app:layout_constraintTop_toBottomOf="@+id/joinUser_backgroud"/>
    <com.byd.vrsettings.view.AppTextView
        android:textSize="20dp"
        android:textColor="@color/userimprove_deldata"
        android:id="@+id/deldataText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/user_privacy_improvement_text_deldata"
        app:layout_constraintBottom_toBottomOf="@+id/deldata_backgroud"
        app:layout_constraintStart_toStartOf="@+id/iv_switch_userImprove"
        app:layout_constraintTop_toTopOf="@+id/deldata_backgroud"/>
    <ImageView
        android:id="@+id/iv_usr_improve_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@mipmap/iv_jiantou"
        android:layout_marginEnd="@dimen/cell_click_icon_right_8155"
        android:elevation="@dimen/v_popup_elevation"
        app:layout_constraintBottom_toBottomOf="@+id/deldata_backgroud"
        app:layout_constraintEnd_toEndOf="@+id/deldata_backgroud"
        app:layout_constraintTop_toTopOf="@+id/deldata_backgroud"/>
    <com.byd.vrsettings.view.AppTextView
        android:id="@+id/tv_copyright"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/tv_copyright_margin_bottom"
        android:text=""
        app:layout_constraintBottom_toTopOf="@+id/bottomView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:id="@+id/bottomView"
        android:layout_width="match_parent"
        android:layout_height="@dimen/wakeup_free_placeholder"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
