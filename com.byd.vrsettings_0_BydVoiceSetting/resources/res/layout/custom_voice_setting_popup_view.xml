<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_popup"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_switch"
        android:layout_width="@dimen/iv_switch_width_8155"
        android:layout_height="@dimen/iv_switch_height_8155"
        android:layout_marginTop="27dp"
        android:layout_marginStart="27dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.byd.vrsettings.view.AppTextView
        android:textSize="@dimen/text_size_title"
        android:textColor="@color/voice_setting_title_8155"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_marginTop="9dp"
        android:text="XXXXX"
        android:layout_marginStart="102dp"
        app:layout_constraintStart_toStartOf="@+id/cl_popup"
        app:layout_constraintTop_toTopOf="@+id/cl_popup"/>
    <com.byd.vrsettings.view.AppTextView
        android:textSize="@dimen/text_size_24"
        android:textColor="@color/voice_setting_tip"
        android:id="@+id/tv_title_tip"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:minHeight="24dp"
        android:text="12312312"
        app:layout_constraintStart_toStartOf="@+id/tv_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        app:layout_constraintWidth_percent="0.8"/>
    <ImageView
        android:id="@+id/iv_up_down"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@mipmap/btn_down_n"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/fbl_popup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/tv_title_tip_margin_top"
        android:minHeight="40dp"
        app:dividerDrawable="@drawable/shape_flexbox_divider"
        app:flexDirection="row"
        app:flexWrap="wrap"
        app:layout_constraintEnd_toEndOf="@+id/tv_title_tip"
        app:layout_constraintStart_toStartOf="@+id/tv_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_title_tip"
        app:showDivider="middle">
        <com.byd.vrsettings.view.AppTextView
            android:textSize="18dp"
            android:textColor="@color/voice_setting_text"
            android:gravity="center"
            android:id="@+id/tv_btn_command1"
            android:background="@mipmap/command_background"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginEnd="48dp"/>
        <com.byd.vrsettings.view.AppTextView
            android:textSize="18dp"
            android:textColor="@color/voice_setting_text"
            android:gravity="center"
            android:id="@+id/tv_btn_command2"
            android:background="@mipmap/command_background"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginEnd="48dp"/>
        <com.byd.vrsettings.view.AppTextView
            android:textSize="18dp"
            android:textColor="@color/voice_setting_text"
            android:gravity="center"
            android:id="@+id/tv_btn_command3"
            android:background="@mipmap/command_background"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginEnd="48dp"/>
        <com.byd.vrsettings.view.AppTextView
            android:textSize="18dp"
            android:textColor="@color/voice_setting_text"
            android:gravity="center"
            android:id="@+id/tv_btn_command4"
            android:background="@mipmap/command_background"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>
    </com.google.android.flexbox.FlexboxLayout>
    <View
        android:id="@+id/v_bottomLine"
        android:background="@color/popup_bottomLine_8155"
        android:layout_width="wrap_content"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="27dp"
        android:layout_marginEnd="27dp"
        app:layout_constraintBottom_toBottomOf="@+id/cl_popup"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fbl_popup"
        app:layout_goneMarginTop="10dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
