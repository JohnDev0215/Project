<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_version"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="locale">
    <View
        android:id="@+id/v_versionBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/version_backView"
        android:background="@mipmap/view_dialog_background"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="@dimen/version_backView_width_8155"
        android:layout_height="@dimen/version_backView_height_8155"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_version_back"
        android:layout_width="@dimen/icon_back_width_height_8155"
        android:layout_height="@dimen/icon_back_width_height_8155"
        android:src="@mipmap/dialog_icon_back"
        android:layout_marginStart="@dimen/custom_title_margin_start_8155"
        app:layout_constraintBottom_toBottomOf="@+id/tv_version_title"
        app:layout_constraintStart_toStartOf="@+id/version_backView"
        app:layout_constraintTop_toTopOf="@+id/tv_version_title"/>
    <com.byd.vrsettings.view.AppTextView
        android:textSize="@dimen/text_size_title"
        android:textStyle="bold"
        android:textColor="@color/dialog_titleTextColor"
        android:id="@+id/tv_version_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="@string/text_voice_version"
        app:layout_constraintEnd_toEndOf="@+id/version_backView"
        app:layout_constraintStart_toStartOf="@+id/version_backView"
        app:layout_constraintTop_toTopOf="@+id/version_backView"/>
    <View
        android:id="@+id/setting_voice_line"
        android:background="@color/diglog_line_backColor_8155"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="79dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="@+id/version_backView"
        app:layout_constraintStart_toStartOf="@+id/version_backView"
        app:layout_constraintTop_toTopOf="@+id/version_backView"/>
    <ImageView
        android:id="@+id/iv_smart_voice"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginTop="40dp"
        android:src="@mipmap/img_light_voice_144"
        app:layout_constraintEnd_toEndOf="@+id/version_backView"
        app:layout_constraintStart_toStartOf="@+id/version_backView"
        app:layout_constraintTop_toBottomOf="@+id/setting_voice_line"/>
    <com.byd.vrsettings.view.AppTextView
        android:textSize="@dimen/text_size_title"
        android:textColor="@color/dialog_contentTextColor"
        android:id="@+id/tv_smart_voice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        android:text="@string/app_name"
        app:layout_constraintEnd_toEndOf="@+id/iv_smart_voice"
        app:layout_constraintStart_toStartOf="@+id/iv_smart_voice"
        app:layout_constraintTop_toBottomOf="@+id/iv_smart_voice"/>
    <TextView
        android:textSize="@dimen/text_size_27"
        android:textColor="@color/voice_setting_tip_8155"
        android:id="@+id/tv_smart_voice_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/text_smart_voice_version"
        android:layout_marginEnd="10dp"
        app:layout_constraintEnd_toStartOf="@+id/tv"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/version_backView"
        app:layout_constraintTop_toBottomOf="@+id/tv_smart_voice"/>
    <TextView
        android:textSize="@dimen/text_size_24"
        android:textColor="@color/smart_voice"
        android:id="@+id/tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="|"
        android:layout_marginStart="10dp"
        app:layout_constraintEnd_toStartOf="@+id/tv_setting_version"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/tv_smart_voice_version"
        app:layout_constraintTop_toBottomOf="@+id/tv_smart_voice"/>
    <TextView
        android:textSize="@dimen/text_size_27"
        android:textColor="@color/voice_setting_tip_8155"
        android:id="@+id/tv_setting_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/text_smart_voice_version"
        android:layout_marginStart="10dp"
        app:layout_constraintEnd_toStartOf="@+id/tv3"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/tv"
        app:layout_constraintTop_toTopOf="@+id/tv"/>
    <TextView
        android:textSize="@dimen/text_size_24"
        android:textColor="@color/smart_voice"
        android:id="@+id/tv3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="|"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_setting_version"
        app:layout_constraintEnd_toStartOf="@+id/tv_download_version"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/tv_setting_version"
        app:layout_constraintTop_toTopOf="@+id/tv_setting_version"/>
    <TextView
        android:textSize="@dimen/text_size_27"
        android:textColor="@color/voice_setting_tip_8155"
        android:id="@+id/tv_download_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/text_smart_voice_version"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv3"
        app:layout_constraintEnd_toStartOf="@+id/tv4"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/tv3"
        app:layout_constraintTop_toTopOf="@+id/tv3"/>
    <TextView
        android:textSize="@dimen/text_size_24"
        android:textColor="@color/smart_voice"
        android:id="@+id/tv4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="|"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_setting_version"
        app:layout_constraintEnd_toStartOf="@+id/tv_settingSDK_version3"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/tv_download_version"
        app:layout_constraintTop_toTopOf="@+id/tv_setting_version"/>
    <TextView
        android:textSize="@dimen/text_size_27"
        android:textColor="@color/voice_setting_tip_8155"
        android:id="@+id/tv_settingSDK_version3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/text_smart_voice_version"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv4"
        app:layout_constraintEnd_toEndOf="@+id/version_backView"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/tv4"
        app:layout_constraintTop_toTopOf="@+id/tv4"/>
    <com.byd.vrsettings.view.AppTextView
        android:textSize="@dimen/text_size_21"
        android:textColor="@color/voice_setting_text_selected"
        android:gravity="center"
        android:autoLink="all"
        android:id="@+id/tv_btn_disclaimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="@string/text_smart_voice_disclaimer"
        app:layout_constraintBottom_toTopOf="@+id/tv_copyright"
        app:layout_constraintEnd_toEndOf="@+id/tv_copyright"
        app:layout_constraintStart_toStartOf="@+id/tv_copyright"/>
    <com.byd.vrsettings.view.AppTextView
        android:textSize="@dimen/text_size_24"
        android:textColor="@color/voice_setting_tip_8155"
        android:id="@+id/tv_copyright"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/tv_copyright_bottom_8155"
        android:text="@string/text_smart_voice_copyright"
        app:layout_constraintBottom_toBottomOf="@+id/version_backView"
        app:layout_constraintEnd_toEndOf="@+id/version_backView"
        app:layout_constraintStart_toStartOf="@+id/version_backView"/>
</androidx.constraintlayout.widget.ConstraintLayout>
