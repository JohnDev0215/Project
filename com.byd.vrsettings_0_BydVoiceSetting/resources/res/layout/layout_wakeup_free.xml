<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sv_wakeup_free"
    android:background="@android:color/transparent"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="ifContentScrolls"
    android:layoutDirection="locale"> &gt; 
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_wakeup_free"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/v_wakeup_free"
            android:layout_width="match_parent"
            android:layout_height="@dimen/custom_title_height_size"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_wakeup_free_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@mipmap/btn_back_n"
            app:layout_constraintBottom_toBottomOf="@+id/v_wakeup_free"
            app:layout_constraintStart_toStartOf="@+id/cspv_home_command"
            app:layout_constraintTop_toTopOf="@+id/v_wakeup_free"/>
        <com.byd.vrsettings.view.AppTextView
            android:textSize="@dimen/text_size_title"
            android:textColor="@color/voice_setting_title_8155"
            android:id="@+id/tv_wakeup_free_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_wakeup_free_title"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toBottomOf="@+id/iv_wakeup_free_back"
            app:layout_constraintStart_toEndOf="@+id/iv_wakeup_free_back"
            app:layout_constraintTop_toTopOf="@+id/iv_wakeup_free_back"/>
        <com.byd.vrsettings.view.CustomSettingPopupView
            android:id="@+id/cspv_home_command"
            android:background="@drawable/bg_setting_popup"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginEnd="40dp"
            android:elevation="@dimen/v_popup_elevation"
            app:command1="@string/text_home_commands_command1"
            app:command2=""
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_wakeup_free_back"
            app:text="@string/text_home_commands"
            app:text_hint="@string/text_home_commands_tip"/>
        <com.byd.vrsettings.view.CustomSettingPopupView
            android:id="@+id/cspv_music_player"
            android:background="@drawable/bg_setting_popup"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:elevation="@dimen/v_popup_elevation"
            app:command1="@string/text_music_player_command1"
            app:command2="@string/text_music_player_command2"
            app:command3="@string/text_music_player_command3"
            app:command4="@string/text_music_player_command4"
            app:layout_constraintEnd_toEndOf="@+id/cspv_home_command"
            app:layout_constraintStart_toStartOf="@+id/cspv_home_command"
            app:layout_constraintTop_toBottomOf="@+id/cspv_home_command"
            app:text="@string/text_music_player"
            app:text_hint="@string/text_music_player_tip"/>
        <com.byd.vrsettings.view.CustomSettingPopupView
            android:id="@+id/cspv_ac_control"
            android:background="@drawable/bg_setting_popup"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:elevation="@dimen/v_popup_elevation"
            app:command1="@string/text_ac_control_command1"
            app:command2="@string/text_ac_control_command2"
            app:layout_constraintEnd_toEndOf="@+id/cspv_home_command"
            app:layout_constraintStart_toStartOf="@+id/cspv_home_command"
            app:layout_constraintTop_toBottomOf="@+id/cspv_music_player"
            app:text="@string/text_ac_control"
            app:text_hint="@string/text_ac_control_tip"/>
        <com.byd.vrsettings.view.CustomSettingPopupView
            android:id="@+id/cspv_volume_control"
            android:background="@drawable/bg_setting_popup"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:elevation="@dimen/v_popup_elevation"
            app:command1="@string/text_volume_control_command1"
            app:command2="@string/text_volume_control_command2"
            app:layout_constraintEnd_toEndOf="@+id/cspv_home_command"
            app:layout_constraintStart_toStartOf="@+id/cspv_home_command"
            app:layout_constraintTop_toBottomOf="@+id/cspv_ac_control"
            app:text="@string/text_volume_control"
            app:text_hint="@string/text_volume_control_tip"/>
        <com.byd.vrsettings.view.CustomSettingPopupView
            android:id="@+id/cspv_map_nav"
            android:background="@drawable/bg_setting_popup"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:elevation="@dimen/v_popup_elevation"
            app:command1="@string/text_map_nav_command1"
            app:command2="@string/text_map_nav_command2"
            app:command3="@string/text_map_nav_command3"
            app:command4="@string/text_map_nav_command4"
            app:layout_constraintEnd_toEndOf="@+id/cspv_home_command"
            app:layout_constraintStart_toStartOf="@+id/cspv_home_command"
            app:layout_constraintTop_toBottomOf="@+id/cspv_volume_control"
            app:text="@string/text_map_nav"
            app:text_hint="@string/text_map_nav_tip"/>
        <com.byd.vrsettings.view.CustomSettingPopupView
            android:id="@+id/cspv_tel_control"
            android:background="@drawable/bg_setting_popup"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:elevation="@dimen/v_popup_elevation"
            app:command1="@string/text_tel_control_command1"
            app:command2="@string/text_tel_control_command2"
            app:layout_constraintEnd_toEndOf="@+id/cspv_home_command"
            app:layout_constraintStart_toStartOf="@+id/cspv_home_command"
            app:layout_constraintTop_toBottomOf="@+id/cspv_map_nav"
            app:text="@string/text_tel_control"
            app:text_hint="@string/text_tel_control_tip"/>
        <View
            android:id="@+id/view"
            android:layout_width="match_parent"
            android:layout_height="@dimen/wakeup_free_placeholder"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cspv_tel_control"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
