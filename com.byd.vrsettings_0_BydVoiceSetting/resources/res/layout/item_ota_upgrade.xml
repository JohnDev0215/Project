<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_root"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:layoutDirection="locale">
    <ImageView
        android:id="@+id/imageview_select"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@mipmap/btn_radio_off"
        android:layout_marginStart="70dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.byd.vrsettings.view.AppTextView
        android:textSize="16sp"
        android:textColor="@color/color8c24313F"
        android:id="@+id/textview_language"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="English"
        android:layout_marginStart="18dp"
        app:layout_constraintStart_toEndOf="@+id/imageview_select"
        app:layout_constraintTop_toBottomOf="@+id/guideline_language"/>
    <com.byd.vrsettings.view.AppTextView
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/voice_setting_title"
        android:id="@+id/textview_country"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="1dp"
        android:text="America"
        android:layout_marginStart="18dp"
        app:layout_constraintBottom_toTopOf="@+id/guideline_language"
        app:layout_constraintStart_toEndOf="@+id/imageview_select"/>
    <View
        android:id="@+id/view_update_point"
        android:background="@drawable/shape_point"
        android:visibility="gone"
        android:layout_width="4dp"
        android:layout_height="4dp"
        android:layout_margin="4dp"
        android:layout_marginStart="4dp"
        android:elevation="3dp"
        app:layout_constraintStart_toEndOf="@+id/textview_country"
        app:layout_constraintTop_toTopOf="@+id/textview_country"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideline_language"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <View
        android:id="@+id/view_hot_click"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline_data"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_version"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/guideline_data"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:textSize="18sp"
            android:id="@+id/textview_update_label"
            android:background="@mipmap/ota_update_light"
            android:layout_width="16dp"
            android:layout_height="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/textview_update_version_and_size"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/textview_update_version_and_size"/>
        <com.byd.vrsettings.view.AppTextView
            android:textSize="18sp"
            android:textColor="@color/color8c24313F"
            android:id="@+id/textview_update_version_and_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="1dp"
            android:maxLines="1"
            android:layout_marginStart="5dp"
            app:layout_constraintBottom_toTopOf="@+id/guideline_version"
            app:layout_constraintStart_toEndOf="@+id/textview_update_label"
            app:layout_goneMarginStart="0dp"/>
        <com.byd.vrsettings.view.AppTextView
            android:textSize="18sp"
            android:textColor="@color/color8c24313F"
            android:id="@+id/textview_local_version_and_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/guideline_version"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/guideline_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.5"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.byd.vrsettings.view.AppTextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/view_desc"
        android:background="@drawable/shape_update_tip"
        android:visibility="visible"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:text="i"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/cl_version"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline_data"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintGuide_percent="0.33"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.73"/>
    <com.byd.vrsettings.view.MultiFunProgressBar
        android:id="@+id/multifun_progressbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/guideline_state"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/imageview_delete"
        android:padding="10dp"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/icon_delete_selector_light"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/view_line"
        android:background="@color/bg_guideline"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_alignParentBottom="true"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
