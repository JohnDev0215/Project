<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_guide"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="locale">
    <View
        android:id="@+id/v_guide"
        android:background="@mipmap/view_dialog_background"
        android:layout_width="608dp"
        android:layout_height="568dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.byd.vrsettings.view.AppTextView
        android:textSize="@dimen/text_size_30"
        android:textStyle="bold"
        android:textColor="@color/voice_setting_title"
        android:id="@+id/tv_title_guide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="@string/text_first_privacy_policy"
        app:layout_constraintEnd_toEndOf="@+id/v_guide"
        app:layout_constraintStart_toStartOf="@+id/v_guide"
        app:layout_constraintTop_toTopOf="@+id/v_guide"/>
    <View
        android:id="@+id/privacy_line"
        android:background="@color/diglog_line_backColor_8155"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="79dp"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp"
        app:layout_constraintEnd_toEndOf="@+id/v_guide"
        app:layout_constraintStart_toStartOf="@+id/v_guide"
        app:layout_constraintTop_toTopOf="@+id/v_guide"/>
    <ScrollView
        android:scrollbarThumbVertical="@drawable/bg_scrollbar"
        android:id="@+id/sv_guide"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="65dp"
        android:layout_marginBottom="45dp"
        android:layout_marginStart="70dp"
        android:layout_marginEnd="70dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_yes"
        app:layout_constraintEnd_toEndOf="@+id/v_guide"
        app:layout_constraintStart_toStartOf="@+id/v_guide"
        app:layout_constraintTop_toBottomOf="@+id/tv_title_guide">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/privacy_context"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.byd.vrsettings.view.AppTextView
                android:textSize="@dimen/text_size_30"
                android:textColor="@color/dialog_contentTextColor"
                android:id="@+id/tv_text_guide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/auth_text"
                android:layoutDirection="locale"
                android:paddingEnd="5dp"
                android:letterSpacing="0"
                android:lineHeight="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/UserImprovementButton"
                android:background="@mipmap/user_improve_on_night"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="20dp"
                android:layout_marginStart="0dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_text_guide"/>
            <com.byd.vrsettings.view.AppTextView
                android:textSize="@dimen/text_size_30"
                android:textColor="@color/dialog_contentTextColor"
                android:id="@+id/UserImprovementContext"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/text_privacy_content"
                android:paddingEnd="5dp"
                android:layout_marginStart="10dp"
                android:letterSpacing="0"
                android:lineHeight="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/UserImprovementButton"
                app:layout_constraintTop_toBottomOf="@+id/tv_text_guide"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <com.byd.vrsettings.view.AppTextView
        android:textSize="@dimen/text_size_24"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/tv_yes"
        android:background="@drawable/bg_setting_btn_yes"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginBottom="78dp"
        android:text="@string/text_first_privacy_allow"
        android:layout_marginStart="104dp"
        android:layout_marginEnd="48dp"
        app:layout_constraintBottom_toBottomOf="@+id/v_guide"
        app:layout_constraintEnd_toStartOf="@+id/tv_no"
        app:layout_constraintStart_toStartOf="@+id/v_guide"/>
    <com.byd.vrsettings.view.AppTextView
        android:textSize="@dimen/text_size_24"
        android:textColor="@color/dialog_button_cancel_textColor"
        android:gravity="center"
        android:id="@+id/tv_no"
        android:background="@drawable/bg_setting_btn_no"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="@string/text_first_privacy_notAllow"
        android:layout_marginEnd="104dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_yes"
        app:layout_constraintEnd_toEndOf="@+id/v_guide"
        app:layout_constraintStart_toEndOf="@+id/tv_yes"/>
</androidx.constraintlayout.widget.ConstraintLayout>
