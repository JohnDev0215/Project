<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/privacy_policy_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/v_privacyBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/privacy"
        android:background="@mipmap/view_dialog_background"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="608dp"
        android:layout_height="448dp"
        app:layout_constraintBottom_toBottomOf="@+id/privacy_policy_layout"
        app:layout_constraintEnd_toEndOf="@+id/privacy_policy_layout"
        app:layout_constraintStart_toStartOf="@+id/privacy_policy_layout"
        app:layout_constraintTop_toTopOf="@+id/privacy_policy_layout"/>
    <com.byd.vrsettings.view.AppTextView
        android:textSize="@dimen/text_size_title"
        android:textStyle="bold"
        android:textColor="@color/voice_setting_title_8155"
        android:gravity="center"
        android:id="@+id/tv_title_privacy"
        android:layout_width="516dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="@string/text_join_userimprove_title"
        android:maxLines="2"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="@+id/privacy"
        app:layout_constraintStart_toStartOf="@+id/privacy"
        app:layout_constraintTop_toTopOf="@+id/privacy"/>
    <View
        android:id="@+id/privacy_line"
        android:background="@color/diglog_line_backColor_8155"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="79dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="@+id/privacy"
        app:layout_constraintStart_toStartOf="@+id/privacy"
        app:layout_constraintTop_toTopOf="@+id/privacy"/>
    <com.byd.vrsettings.view.AppTextView
        android:textSize="@dimen/text_size_30"
        android:textColor="@color/dialog_contentTextColor"
        android:id="@+id/tv_privacy_policy"
        android:layout_width="@dimen/dp_0"
        android:layout_height="0dp"
        android:layout_marginTop="70dp"
        android:layout_marginBottom="40dp"
        android:text="@string/user_privacy_improvement_text"
        android:layout_marginStart="70dp"
        android:layout_marginEnd="70dp"
        android:letterSpacing="0.04"
        android:lineHeight="32px"
        app:layout_constraintBottom_toTopOf="@+id/tv_btn_confirm_privacy"
        app:layout_constraintEnd_toEndOf="@+id/privacy"
        app:layout_constraintStart_toStartOf="@+id/privacy"
        app:layout_constraintTop_toBottomOf="@+id/tv_title_privacy"/>
    <com.byd.vrsettings.view.AppTextView
        android:textSize="@dimen/text_size_30"
        android:textColor="@color/view_dialog_btn_ok_8155"
        android:gravity="center"
        android:id="@+id/tv_btn_confirm_privacy"
        android:background="@drawable/bg_setting_btn_yes"
        android:layout_width="@dimen/dp_0"
        android:layout_height="48dp"
        android:layout_marginBottom="@dimen/tv_btn_yes_wakeup_bottom_8155"
        android:text="@string/text_btn_Agree"
        android:layout_marginStart="@dimen/tv_btn_yes_wakeup_left_8155"
        app:layout_constraintBottom_toBottomOf="@+id/privacy"
        app:layout_constraintEnd_toStartOf="@+id/tv_btn_cancel_privacy"
        app:layout_constraintStart_toStartOf="@+id/privacy"/>
    <com.byd.vrsettings.view.AppTextView
        android:textSize="@dimen/text_size_30"
        android:textColor="@color/voice_setting_title_8155"
        android:gravity="center"
        android:id="@+id/tv_btn_cancel_privacy"
        android:background="@drawable/bg_setting_btn_no"
        android:layout_width="@dimen/dp_0"
        android:layout_height="48dp"
        android:text="@string/text_btn_Disagree"
        android:layout_marginStart="@dimen/tv_btn_yes_wakeup_padding_8155"
        android:layout_marginEnd="@dimen/tv_btn_yes_wakeup_left_8155"
        app:layout_constraintBottom_toBottomOf="@+id/tv_btn_confirm_privacy"
        app:layout_constraintEnd_toEndOf="@+id/privacy"
        app:layout_constraintStart_toEndOf="@+id/tv_btn_confirm_privacy"/>
</androidx.constraintlayout.widget.ConstraintLayout>
