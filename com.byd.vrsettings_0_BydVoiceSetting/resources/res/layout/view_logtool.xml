<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_logTool"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/v_logToolBackground"
        android:background="@drawable/bg_setting_dialog"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="@dimen/cl_wake_word_width"
        android:layout_height="@dimen/v_language_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="20dp"
        android:textColor="@color/black"
        android:id="@+id/logToolTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="LogTool"
        app:layout_constraintEnd_toEndOf="@+id/v_logToolBackground"
        app:layout_constraintStart_toStartOf="@+id/v_logToolBackground"
        app:layout_constraintTop_toTopOf="@+id/v_logToolBackground"/>
    <Button
        android:id="@+id/log_beginBtn"
        android:background="@drawable/bg_hiddendoor_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="ON"
        app:layout_constraintEnd_toStartOf="@+id/log_endBtn"
        app:layout_constraintStart_toStartOf="@+id/v_logToolBackground"
        app:layout_constraintTop_toBottomOf="@+id/logToolTitle"/>
    <Button
        android:id="@+id/log_packBtn"
        android:background="@drawable/bg_hiddendoor_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="Start packaging"
        app:layout_constraintEnd_toEndOf="@+id/v_logToolBackground"
        app:layout_constraintStart_toStartOf="@+id/v_logToolBackground"
        app:layout_constraintTop_toBottomOf="@+id/log_beginBtn"/>
    <Button
        android:id="@+id/log_endBtn"
        android:background="@drawable/bg_hiddendoor_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="OFF"
        app:layout_constraintEnd_toEndOf="@+id/v_logToolBackground"
        app:layout_constraintStart_toEndOf="@+id/log_beginBtn"
        app:layout_constraintTop_toTopOf="@+id/log_beginBtn"/>
    <TextView
        android:textSize="18dp"
        android:textColor="@color/bg_dialog_grey"
        android:id="@+id/log_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="packing。。。"
        app:layout_constraintEnd_toEndOf="@+id/v_logToolBackground"
        app:layout_constraintStart_toStartOf="@+id/v_logToolBackground"
        app:layout_constraintTop_toBottomOf="@+id/log_packBtn"/>
    <ImageView
        android:id="@+id/iv_close"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@mipmap/close"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toStartOf="@+id/v_logToolBackground"
        app:layout_constraintTop_toTopOf="@+id/logToolTitle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
