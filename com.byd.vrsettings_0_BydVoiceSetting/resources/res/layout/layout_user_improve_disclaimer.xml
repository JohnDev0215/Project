<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_disclaimer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/v_disclaimer"
        android:background="@drawable/bg_setting_dialog"
        android:layout_width="@dimen/cl_cerence_privacy_width"
        android:layout_height="@dimen/cl_cerence_privacy_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_close_disclaimer"
        android:layout_width="@dimen/iv_close_width_height"
        android:layout_height="@dimen/iv_close_width_height"
        android:src="@mipmap/close"
        android:layout_marginStart="@dimen/iv_close_margin_start"
        app:layout_constraintBottom_toBottomOf="@+id/tv_title_disclaimer"
        app:layout_constraintStart_toStartOf="@+id/v_disclaimer"
        app:layout_constraintTop_toTopOf="@+id/tv_title_disclaimer"/>
    <TextView
        android:textSize="@dimen/text_size_36"
        android:textColor="@color/voice_setting_title"
        android:id="@+id/tv_title_disclaimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/custom_title_margin_top"
        android:text="@string/text_disclaimer"
        app:layout_constraintEnd_toEndOf="@+id/v_disclaimer"
        app:layout_constraintStart_toStartOf="@+id/v_disclaimer"
        app:layout_constraintTop_toTopOf="@+id/v_disclaimer"/>
    <com.byd.vrsettings.utils.MyWebView
        android:id="@+id/disclaimer_webView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/tv_cerence_privacy_margin_top"
        android:layout_marginBottom="@dimen/tv_cerence_privacy_margin_bottom"
        android:layout_marginStart="@dimen/tv_cerence_privacy_margin_start_end"
        android:layout_marginEnd="@dimen/tv_cerence_privacy_margin_start_end"
        app:layout_constraintBottom_toBottomOf="@+id/v_disclaimer"
        app:layout_constraintEnd_toEndOf="@+id/v_disclaimer"
        app:layout_constraintStart_toStartOf="@+id/v_disclaimer"
        app:layout_constraintTop_toBottomOf="@+id/tv_title_disclaimer"/>
</androidx.constraintlayout.widget.ConstraintLayout>
