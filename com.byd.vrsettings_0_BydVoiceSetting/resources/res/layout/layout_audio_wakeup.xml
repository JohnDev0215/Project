<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_audio_wakeup"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/v_audioBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/v_audio"
        android:background="@mipmap/view_dialog_background"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="608dp"
        android:layout_height="376dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.byd.vrsettings.view.AppTextView
        android:textSize="@dimen/text_size_title"
        android:textStyle="bold"
        android:textColor="@color/voice_setting_title_8155"
        android:id="@+id/tv_title_audio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/custom_title_margin_top_8155"
        android:text="@string/text_wakeup_voice"
        app:layout_constraintEnd_toEndOf="@+id/v_audio"
        app:layout_constraintStart_toStartOf="@+id/v_audio"
        app:layout_constraintTop_toTopOf="@+id/v_audio"/>
    <View
        android:id="@+id/audio_wakeup_line"
        android:background="@color/diglog_line_backColor_8155"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="79dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="@+id/v_audio"
        app:layout_constraintStart_toStartOf="@+id/v_audio"
        app:layout_constraintTop_toTopOf="@+id/v_audio"/>
    <com.byd.vrsettings.view.AppTextView
        android:textSize="@dimen/text_size_30"
        android:textColor="@color/voice_setting_text"
        android:id="@+id/tv_audio_wakeup"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/tv_audio_wakeup_top_8155"
        android:text="@string/text_audio_wakeup"
        android:layout_marginStart="70dp"
        android:layout_marginEnd="70dp"
        app:layout_constraintEnd_toEndOf="@+id/v_audio"
        app:layout_constraintStart_toStartOf="@+id/v_audio"
        app:layout_constraintTop_toBottomOf="@+id/tv_title_audio"/>
    <com.byd.vrsettings.view.AppTextView
        android:textSize="@dimen/text_size_30"
        android:textColor="@color/view_dialog_btn_ok_8155"
        android:gravity="center"
        android:id="@+id/tv_btn_yes_audio"
        android:background="@drawable/bg_setting_btn_yes"
        android:layout_width="@dimen/dp_0"
        android:layout_height="48dp"
        android:layout_marginBottom="@dimen/tv_btn_yes_wakeup_bottom_8155"
        android:text="@string/text_btn_yes"
        android:layout_marginStart="@dimen/tv_btn_yes_wakeup_left_8155"
        app:layout_constraintBottom_toBottomOf="@+id/v_audio"
        app:layout_constraintEnd_toStartOf="@+id/tv_btn_no_audio"
        app:layout_constraintStart_toStartOf="@+id/v_audio"/>
    <com.byd.vrsettings.view.AppTextView
        android:textSize="@dimen/text_size_30"
        android:textColor="@color/dialog_button_cancel_textColor"
        android:gravity="center"
        android:id="@+id/tv_btn_no_audio"
        android:background="@drawable/bg_setting_btn_no"
        android:layout_width="@dimen/dp_0"
        android:layout_height="48dp"
        android:text="@string/text_btn_no"
        android:layout_marginStart="@dimen/tv_btn_yes_wakeup_padding_8155"
        android:layout_marginEnd="@dimen/tv_btn_yes_wakeup_left_8155"
        app:layout_constraintBottom_toBottomOf="@+id/tv_btn_yes_audio"
        app:layout_constraintEnd_toEndOf="@+id/v_audio"
        app:layout_constraintStart_toEndOf="@+id/tv_btn_yes_audio"/>
</androidx.constraintlayout.widget.ConstraintLayout>
