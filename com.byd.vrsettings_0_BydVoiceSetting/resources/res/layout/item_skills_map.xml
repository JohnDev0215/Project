<?xml version="1.0" encoding="utf-8"?>
<com.byd.vrsettings.view.CustomScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sv_map"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="ifContentScrolls">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/customSkills"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.byd.vrsettings.view.CustomSkillsPopupView
            android:id="@+id/cspv_destination"
            android:layout_width="0dp"
            android:layout_height="@dimen/customSkillsPopupView_height_8155"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toStartOf="@+id/cspv_navigating"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.byd.vrsettings.view.CustomSkillsPopupView
            android:id="@+id/cspv_navigating"
            android:layout_width="0dp"
            android:layout_height="@dimen/customSkillsPopupView_height_8155"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/cspv_destination"
            app:layout_constraintTop_toTopOf="@+id/cspv_destination"/>
        <com.byd.vrsettings.view.CustomSkillsPopupView
            android:id="@+id/cspv_nearby"
            android:layout_width="0dp"
            android:layout_height="@dimen/customSkillsPopupView_height_8155"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toStartOf="@+id/cspv_map_control"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cspv_navigating"/>
        <com.byd.vrsettings.view.CustomSkillsPopupView
            android:id="@+id/cspv_map_control"
            android:layout_width="0dp"
            android:layout_height="@dimen/customSkillsPopupView_height_8155"
            app:layout_constraintEnd_toEndOf="@+id/cspv_navigating"
            app:layout_constraintStart_toEndOf="@+id/cspv_nearby"
            app:layout_constraintTop_toTopOf="@+id/cspv_nearby"/>
        <com.byd.vrsettings.view.CustomSkillsPopupView
            android:id="@+id/navigation_volume"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="@dimen/customSkillsPopupView_height_8155"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="@+id/cspv_nearby"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cspv_map_control"/>
        <View
            android:id="@+id/map_bottom"
            android:layout_width="match_parent"
            android:layout_height="@dimen/wakeup_free_placeholder"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/navigation_volume"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.byd.vrsettings.view.CustomScrollView>
