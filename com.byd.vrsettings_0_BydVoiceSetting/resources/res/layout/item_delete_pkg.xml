<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_root"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="72dp">
    <ImageView
        android:id="@+id/imageview_select"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@mipmap/btn_radio_off"
        android:layout_marginStart="70dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.byd.vrsettings.view.AppTextView
        android:textSize="16sp"
        android:textColor="@color/color8c24313F"
        android:id="@+id/textview_language"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="18dp"
        android:layout_marginTop="1dp"
        android:text="English"
        app:layout_constraintStart_toEndOf="@+id/imageview_select"
        app:layout_constraintTop_toBottomOf="@+id/guideline_language"/>
    <com.byd.vrsettings.view.AppTextView
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/voice_setting_title"
        android:id="@+id/textview_country"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="18dp"
        android:layout_marginBottom="1dp"
        android:text="America"
        app:layout_constraintBottom_toTopOf="@+id/guideline_language"
        app:layout_constraintStart_toEndOf="@+id/imageview_select"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideline_language"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <com.byd.vrsettings.view.AppTextView
        android:textSize="18sp"
        android:textColor="@color/color8c24313F"
        android:id="@+id/textview_size_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:text="@string/text_size"
        app:layout_constraintBaseline_toBaselineOf="@+id/textview_country"
        app:layout_constraintStart_toEndOf="@+id/guideline_data"/>
    <com.byd.vrsettings.view.AppTextView
        android:textSize="18sp"
        android:textColor="@color/color8c24313F"
        android:id="@+id/textview_size_data"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="90dp"
        android:maxLines="1"
        android:layout_marginStart="5dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/textview_size_label"
        app:layout_constraintStart_toEndOf="@+id/textview_size_label"/>
    <com.byd.vrsettings.view.AppTextView
        android:textSize="18sp"
        android:textColor="@color/color8c24313F"
        android:id="@+id/textview_version_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/text_version"
        app:layout_constraintBaseline_toBaselineOf="@+id/textview_language"
        app:layout_constraintStart_toEndOf="@+id/guideline_data"/>
    <com.byd.vrsettings.view.AppTextView
        android:textSize="18sp"
        android:textColor="@color/color8c24313F"
        android:id="@+id/textview_version_data"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/textview_version_label"
        app:layout_constraintStart_toEndOf="@+id/textview_version_label"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline_data"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintGuide_percent="0.33"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.73"/>
    <com.byd.vrsettings.view.MultiFunProgressBar
        android:id="@+id/multifun_progressbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/guideline_state"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/imageview_delete"
        android:padding="10dp"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/icon_delete_selector_light"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/view_line"
        android:background="@color/bg_guideline"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_alignParentBottom="true"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
