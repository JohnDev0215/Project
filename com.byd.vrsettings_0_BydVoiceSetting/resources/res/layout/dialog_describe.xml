<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dialog_bg"
        android:background="#b8000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:id="@+id/layout_root"
            android:background="@drawable/shape_corner_8dp"
            android:layout_width="560dp"
            android:layout_height="340dp"
            android:minHeight="264dp"
            android:layout_centerInParent="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="20sp"
                android:textColor="@color/color262d33"
                android:gravity="center"
                android:id="@+id/textview_title"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:text="@string/text_update_info"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/view_line"
                android:background="@color/color121F2326"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                app:layout_constraintTop_toBottomOf="@+id/textview_title"/>
            <androidx.core.widget.NestedScrollView
                android:paddingLeft="48dp"
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_0"
                android:layout_marginTop="40dp"
                android:layout_marginBottom="40dp"
                android:paddingStart="48dp"
                android:paddingEnd="48dp"
                app:layout_constraintBottom_toTopOf="@+id/text_positive"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view_line">
                <TextView
                    android:textSize="20sp"
                    android:textColor="@color/color70black"
                    android:id="@+id/textview_content"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text=""
                    android:lineSpacingExtra="6dp"/>
            </androidx.core.widget.NestedScrollView>
            <com.byd.vrsettings.view.AppTextView
                android:textSize="16sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/text_positive"
                android:background="@drawable/bg_setting_btn_yes"
                android:visibility="visible"
                android:layout_width="160dp"
                android:layout_height="48dp"
                android:layout_marginTop="55dp"
                android:layout_marginBottom="28dp"
                android:text="@string/text_btn_yes"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>
