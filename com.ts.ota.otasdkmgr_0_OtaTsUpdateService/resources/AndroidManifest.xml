        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:defaultToDeviceProtectedStorage="true"
        android:directBootAware="false"
        android:usesNonSdkApi="true">
        <service
            android:name="com.ts.ota.otasdkmgr.OtaTsUpdateService"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.Otasdk.OtaTsUpdateService"/>
            </intent-filter>
        </service>
        <receiver
            android:name="com.ts.ota.otasdkmgr.impl.AlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.ACTION_NEXT_WAKEUP"/>
            </intent-filter>
        </receiver>
        <uses-library android:name="ts.framework"/>
        <uses-library android:name="byd.ota.master"/>
    </application>
</manifest>
