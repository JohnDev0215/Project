<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@mipmap/img_app_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/sp_32"
        android:textStyle="bold"
        android:textColor="@color/color_warning_content"
        android:id="@+id/tv_safety_warning_title"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_70"
        android:text="@string/user_agreement"
        android:layout_centerHorizontal="true"/>
    <FrameLayout
        android:id="@+id/fl_content"
        android:background="@color/transparent_00"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/privacy_policy_margin_top"
        android:layout_marginBottom="@dimen/dp_2"
        android:layout_above="@+id/ll_check"
        android:layout_below="@+id/tv_safety_warning_title"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="@dimen/dp_40"
        android:layout_marginEnd="@dimen/dp_40"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/ll_check"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_40"
        android:layout_marginRight="@dimen/dp_40"
        android:layout_marginBottom="@dimen/privacy_policy_margin_bottom"
        android:layout_above="@+id/tv_privacy_policy_sure">
        <CheckBox
            android:id="@+id/checkbox"
            android:background="@drawable/selector_safety_warning_check_box"
            android:layout_width="@dimen/dp_40"
            android:layout_height="@dimen/dp_40"
            android:button="@null"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/selector_color_agreement_tips"
            android:gravity="center"
            android:id="@+id/tv_agree_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sysui_safety_warning_no_reminders"/>
    </LinearLayout>
    <com.android.provision.widget.ToneGeneratorButton
        android:textColor="@color/selector_safety_warning_sure_btn_text"
        android:id="@+id/tv_privacy_policy_sure"
        android:background="@drawable/selector_safety_warning_sure_btn_bg"
        android:layout_marginBottom="@dimen/dp_70"
        android:text="@string/agree"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        style="@style/btn_style_common"/>
</RelativeLayout>
