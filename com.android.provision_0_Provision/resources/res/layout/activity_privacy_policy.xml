<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@mipmap/img_app_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/sp_24"
        android:textStyle="bold"
        android:textColor="@color/color_warning_content"
        android:id="@+id/tv_safety_warning_title"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_68"
        android:text="@string/privacy_policy"
        android:layout_centerHorizontal="true"/>
    <FrameLayout
        android:id="@+id/fl_content"
        android:background="@color/transparent_00"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dp_32"
        android:layout_marginBottom="@dimen/dp_30"
        android:layout_above="@+id/tv_privacy_policy_sure"
        android:layout_below="@+id/tv_safety_warning_title"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="@dimen/dp_40"
        android:layout_marginEnd="@dimen/dp_40"/>
    <com.android.provision.widget.ToneGeneratorButton
        android:textColor="@color/btn_text_color_policy_sure"
        android:id="@+id/tv_privacy_policy_sure"
        android:background="@drawable/shape_warning_sure_bg"
        android:layout_marginBottom="@dimen/dp_70"
        android:text="@string/confirm"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        style="@style/btn_style_common"/>
    <Space
        android:id="@+id/space"
        android:visibility="gone"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_2"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
    <com.android.provision.widget.ToneGeneratorButton
        android:textColor="@color/btn_text_color_policy_cancel"
        android:id="@+id/tv_privacy_policy_skip"
        android:background="@drawable/shape_warning_sure_bg_unselected"
        android:visibility="gone"
        android:layout_marginBottom="@dimen/dp_70"
        android:text="@string/skip"
        android:layout_alignParentBottom="true"
        android:layout_toEndOf="@+id/space"
        style="@style/btn_style_common"/>
</RelativeLayout>
