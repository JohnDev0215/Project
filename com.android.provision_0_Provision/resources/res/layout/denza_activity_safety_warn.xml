<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@mipmap/img_app_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/safety_warning_margin_top"
        android:layout_centerHorizontal="true">
        <ImageView
            android:layout_width="@dimen/dp_138"
            android:layout_height="@dimen/dp_30"
            android:src="@mipmap/img_boot_process_boot_process_left"
            android:layout_toLeftOf="@+id/tv_safety_warning_title"
            android:layout_marginEnd="@dimen/dp_6"/>
        <TextView
            android:textSize="@dimen/sp_32"
            android:textStyle="bold"
            android:textColor="@color/color_warning_title"
            android:id="@+id/tv_safety_warning_title"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/warning"/>
        <ImageView
            android:layout_width="@dimen/dp_138"
            android:layout_height="@dimen/dp_30"
            android:src="@mipmap/img_boot_process_boot_process_right"
            android:layout_toRightOf="@+id/tv_safety_warning_title"
            android:layout_marginStart="@dimen/dp_6"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="@color/color_warning_content"
        android:gravity="center"
        android:id="@+id/tv_safety_warning_content"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_32"
        android:text="@string/warning_content"
        android:layout_below="@+id/ll_title"
        android:layout_centerHorizontal="true"
        android:paddingStart="@dimen/dp_25"
        android:paddingEnd="@dimen/dp_25"/>
    <com.android.provision.widget.ToneGeneratorButton
        android:textColor="@color/denza_sure_btn_text"
        android:id="@+id/tv_ok"
        android:background="@drawable/denza_sure_btn_bg"
        android:layout_marginTop="@dimen/dp_64"
        android:text="@string/agree"
        android:layout_below="@+id/tv_safety_warning_content"
        android:layout_centerHorizontal="true"
        style="@style/btn_style_common"/>
</RelativeLayout>
