<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/view_root"
    android:background="#00000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_centerInParent="true">
    <RelativeLayout
        android:background="@drawable/system_ui_hvac_dialog_background"
        android:clickable="true"
        android:layout_width="@dimen/dp_560"
        android:layout_height="@dimen/dp_348"
        android:layout_centerInParent="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/text_color_policy_content"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_70"
            android:text="@string/sure_skip"
            android:layout_centerHorizontal="true"/>
        <View
            android:id="@+id/title_line"
            android:background="@color/dialog_system_line_color"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:layout_below="@+id/title"/>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/dp_32"
            android:layout_marginBottom="@dimen/dp_16"
            android:fillViewport="true"
            android:layout_above="@+id/tv_sure_policy"
            android:layout_below="@+id/title_line"
            android:overScrollMode="never"
            android:layout_marginStart="@dimen/dp_48"
            android:layout_marginEnd="@dimen/dp_48">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_policy_content"
                android:gravity="start"
                android:id="@+id/message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sure_skip_tips"
                android:layout_centerHorizontal="true"
                android:paddingStart="@dimen/dp_15"
                android:paddingEnd="@dimen/dp_15"/>
        </ScrollView>
        <com.android.provision.widget.ToneGeneratorButton
            android:textColor="@color/btn_text_color_policy_sure"
            android:id="@+id/tv_sure_policy"
            android:background="@drawable/shape_warning_sure_bg"
            android:layout_marginBottom="@dimen/dp_28"
            android:text="@string/sure"
            android:layout_alignParentBottom="true"
            android:layout_toStartOf="@+id/space"
            style="@style/btn_style_common"/>
        <Space
            android:id="@+id/space"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_2"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"/>
        <com.android.provision.widget.ToneGeneratorButton
            android:textColor="@color/btn_text_color_policy_cancel"
            android:id="@+id/tv_cancel_policy"
            android:background="@drawable/shape_warning_sure_bg_unselected"
            android:layout_marginBottom="@dimen/dp_28"
            android:text="@string/cancel"
            android:layout_alignParentBottom="true"
            android:layout_toEndOf="@+id/space"
            style="@style/btn_style_common"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
