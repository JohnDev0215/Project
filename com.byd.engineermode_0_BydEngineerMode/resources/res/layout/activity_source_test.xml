<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/hint"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_25"
        android:layout_marginBottom="@dimen/dp_15"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/dp_15"
        android:layout_marginEnd="@dimen/dp_15">
        <TextView
            android:textSize="@dimen/sp_30"
            android:textColor="@color/black"
            android:layout_gravity="center"
            android:id="@+id/tv_current_play_music"
            android:background="@color/dark_grey"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_50"
            android:text="@string/source_test_current_source"
            android:layout_marginStart="@dimen/dp_10"/>
        <TextView
            android:textSize="@dimen/sp_25"
            android:layout_gravity="center"
            android:id="@+id/tv_fm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_80"
            android:text="FM"
            android:layout_below="@+id/tv_current_play_music"
            android:layout_marginStart="@dimen/dp_10"/>
        <Button
            android:textSize="@dimen/sp_20"
            android:id="@+id/btn_fm_play"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:text="@string/source_test_play_fm"
            android:layout_below="@+id/tv_fm"
            android:onClick="OnButtonClick"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/dp_10"/>
        <TextView
            android:textSize="@dimen/sp_25"
            android:layout_gravity="center"
            android:id="@+id/tv_bt_music"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_80"
            android:text="@string/source_test_bt_music"
            android:layout_below="@+id/tv_current_play_music"
            android:layout_marginStart="@dimen/dp_180"/>
        <Button
            android:textSize="@dimen/sp_20"
            android:id="@+id/btn_bt_music_play"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:text="@string/source_test_play_bt_music"
            android:layout_below="@+id/tv_fm"
            android:onClick="OnButtonClick"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/dp_180"/>
        <TextView
            android:textSize="@dimen/sp_25"
            android:layout_gravity="center"
            android:id="@+id/tv_usb_music"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_80"
            android:text="@string/source_test_usb_music"
            android:layout_below="@+id/tv_current_play_music"
            android:layout_marginStart="@dimen/dp_360"/>
        <Button
            android:textSize="@dimen/sp_20"
            android:id="@+id/btn_usb_music_play"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:text="@string/source_test_play_usb_music"
            android:layout_below="@+id/tv_fm"
            android:onClick="OnButtonClick"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/dp_360"/>
        <TextView
            android:textSize="@dimen/sp_25"
            android:layout_gravity="center"
            android:id="@+id/tv_bt_phone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_80"
            android:text="@string/source_test_bt_phone"
            android:layout_below="@+id/tv_current_play_music"
            android:layout_marginStart="@dimen/dp_540"/>
        <Button
            android:textSize="@dimen/sp_20"
            android:id="@+id/btn_bt_phone_play"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:text="@string/source_test_call_bt_phone"
            android:layout_below="@+id/tv_bt_phone"
            android:onClick="OnButtonClick"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/dp_540"/>
    </RelativeLayout>
    <include
        android:layout_gravity="bottom"
        android:id="@+id/layout_bottom"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="@dimen/dp_60"
        android:layout_marginStart="@dimen/dp_15"
        android:layout_marginEnd="@dimen/dp_15"
        layout="@layout/layout_function_button"/>
</LinearLayout>
