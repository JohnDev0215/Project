<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/dp_20"
            android:id="@+id/gps_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gps_status"
            android:layout_marginStart="@dimen/dp_10"/>
        <TextView
            android:textSize="@dimen/dp_20"
            android:id="@+id/text_message"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:text="@string/gps_test_data"
            android:layout_below="@+id/gps_state"
            android:layout_marginStart="@dimen/dp_10"/>
        <Button
            android:id="@+id/gps_open"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/start_record"
            android:layout_below="@+id/text_message"
            android:onClick="OnButtonClick"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/dp_10"/>
        <Button
            android:id="@+id/gps_close"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:text="@string/stop_record"
            android:layout_below="@+id/gps_open"
            android:onClick="OnButtonClick"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/dp_10"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/tv_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/gps_title_msg"
            android:layout_marginStart="@dimen/dp_100"
            android:layout_marginEnd="@dimen/dp_100"/>
        <TextView
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/tv_location_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/gps_status_msg"
            android:layout_below="@+id/tv_location"
            android:layout_marginStart="@dimen/dp_100"
            android:layout_marginEnd="@dimen/dp_100"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/tv_location_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/gps_type_msg"
            android:layout_below="@+id/tv_location_title"
            android:layout_marginStart="@dimen/dp_100"
            android:layout_marginEnd="@dimen/dp_100"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp">
        <ListView
            android:id="@+id/id_review"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:divider="@null"
            android:layout_weight="8"/>
        <ListView
            android:id="@+id/id_recyclerview"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@null"
            android:layout_weight="4"/>
        <ListView
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:divider="@null"
            android:layout_weight="8"/>
    </LinearLayout>
    <include
        android:layout_gravity="bottom"
        android:id="@+id/layout_bottom"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="@dimen/dp_60"
        android:layout_marginStart="@dimen/dp_15"
        android:layout_marginEnd="@dimen/dp_15"
        layout="@layout/layout_function_button"/>
</LinearLayout>
