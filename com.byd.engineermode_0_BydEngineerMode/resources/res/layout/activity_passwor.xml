<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/ll_password"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="@dimen/dp_32"
            android:textColor="@color/text_default_color"
            android:id="@+id/imei_tv"
            android:visibility="gone"
            android:layout_width="@dimen/dp_368"
            android:layout_height="wrap_content"
            android:text="@string/imei"/>
        <EditText
            android:textSize="@dimen/sp_32"
            android:id="@+id/et_password"
            android:visibility="gone"
            android:layout_width="@dimen/dp_368"
            android:layout_height="@dimen/dp_100"
            android:layout_marginTop="@dimen/dp_40"
            android:hint="@string/str_please_enter_password"/>
        <Button
            android:textSize="@dimen/sp_28"
            android:id="@+id/ok_btn"
            android:layout_width="@dimen/dp_300"
            android:layout_height="@dimen/dp_70"
            android:layout_marginTop="@dimen/dp_40"
            android:text="@string/confirm"/>
    </LinearLayout>
    <ScrollView
        android:id="@+id/sv_secretview"
        android:visibility="gone"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dp_30"
        android:layout_marginBottom="@dimen/dp_30">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/dp_30">
            <TextView
                android:textSize="@dimen/sp_30"
                android:textColor="@color/black"
                android:id="@+id/tbox_upgrade"
                android:background="@color/button_bg_start_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_usb_upgrade_tbox"/>
            <TextView
                android:textSize="@dimen/sp_30"
                android:textColor="@color/black"
                android:id="@+id/ivi_upgrade"
                android:background="@color/button_bg_start_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_30"
                android:text="@string/str_usb_upgrade_ivi"/>
            <TextView
                android:textSize="@dimen/sp_30"
                android:textColor="@color/black"
                android:id="@+id/tp_or_screen_fw_upgrade"
                android:background="@color/button_bg_start_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_30"
                android:text="@string/str_usb_upgrade_tp_or_screen_fw"/>
            <TextView
                android:textSize="@dimen/sp_30"
                android:textColor="@color/black"
                android:id="@+id/export_tbox_upgrade_log"
                android:background="@color/button_bg_start_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_30"
                android:text="@string/str_export_tbox_upgrade_log_msg"/>
            <TextView
                android:textSize="@dimen/sp_30"
                android:textColor="@color/black"
                android:id="@+id/clear_tbox_log"
                android:background="@color/button_bg_start_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_30"
                android:text="@string/str_clear_tbox_log_msg"/>
            <TextView
                android:textSize="@dimen/sp_30"
                android:textColor="@color/black"
                android:id="@+id/tbox_reboot"
                android:background="@color/button_bg_start_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_30"
                android:text="@string/str_reboot_tbox_msg"/>
            <TextView
                android:textSize="@dimen/sp_30"
                android:textColor="@color/black"
                android:id="@+id/desay_engmode"
                android:background="@color/button_bg_start_color"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_30"
                android:text="@string/str_desay_engmode_msg"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
