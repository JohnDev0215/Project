<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/hint"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <Button
            android:id="@+id/btn_avm"
            android:background="@color/dark_grey"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_50"
            android:text="AVM"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/dp_50"/>
        <Button
            android:id="@+id/btn_lane_departure_assist_cancel"
            android:background="@color/dark_grey"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_50"
            android:text="@string/adaptive_cruise_cancellation"
            android:layout_below="@+id/btn_avm"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/dp_50"/>
        <Button
            android:id="@+id/btn_adaptive_cruise_add"
            android:background="@color/dark_grey"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_50"
            android:text="@string/adaptive_cruise_add_msg"
            android:layout_below="@+id/btn_lane_departure_assist_cancel"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/dp_50"/>
        <Button
            android:id="@+id/btn_adaptive_cruise_subtract"
            android:background="@color/dark_grey"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_50"
            android:text="@string/adaptive_cruise_subtract_msg"
            android:layout_below="@+id/btn_adaptive_cruise_add"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/dp_50"/>
        <Button
            android:id="@+id/btn_screen_rotation"
            android:background="@color/dark_grey"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_50"
            android:text="@string/screen_rotation_msg"
            android:layout_alignLeft="@+id/btn_avm"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/dp_150"/>
        <Button
            android:id="@+id/btn_increase_vehicle_spacing"
            android:background="@color/dark_grey"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_50"
            android:text="@string/increase_vehicle_spacing_msg"
            android:layout_below="@+id/btn_screen_rotation"
            android:layout_alignLeft="@+id/btn_lane_departure_assist_cancel"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/dp_150"/>
        <Button
            android:id="@+id/btn_trolley_distance_reduction"
            android:background="@color/dark_grey"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_50"
            android:text="@string/reduce_vehicle_spacing_msg"
            android:layout_below="@+id/btn_increase_vehicle_spacing"
            android:layout_alignLeft="@+id/btn_adaptive_cruise_add"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/dp_150"/>
        <Button
            android:id="@+id/btn_bt_phone"
            android:background="@color/dark_grey"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_50"
            android:text="@string/bluetooth_phone_msg"
            android:layout_alignLeft="@+id/btn_screen_rotation"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/dp_180"/>
        <Button
            android:id="@+id/btn_back_mute"
            android:background="@color/dark_grey"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_50"
            android:text="@string/back_mute_msg"
            android:layout_below="@+id/btn_bt_phone"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/dp_50"/>
        <Button
            android:id="@+id/btn_mode"
            android:background="@color/dark_grey"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_50"
            android:text="@string/mode_key_msg"
            android:layout_below="@+id/btn_back_mute"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/dp_50"/>
        <Button
            android:id="@+id/btn_voice"
            android:background="@color/dark_grey"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_50"
            android:text="Voice"
            android:layout_alignLeft="@+id/btn_bt_phone"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/dp_150"/>
        <Button
            android:id="@+id/btn_last_song"
            android:background="@color/dark_grey"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_50"
            android:text="@string/previous_song_msg"
            android:layout_below="@+id/btn_voice"
            android:layout_alignLeft="@+id/btn_avm"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/dp_150"/>
        <Button
            android:id="@+id/btn_nest_song"
            android:background="@color/dark_grey"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_50"
            android:text="@string/next_song_msg"
            android:layout_below="@+id/btn_last_song"
            android:layout_alignLeft="@+id/btn_avm"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/dp_150"/>
    </RelativeLayout>
    <include
        android:layout_gravity="bottom"
        android:id="@+id/layout_bottom"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="@dimen/dp_60"
        android:layout_marginStart="@dimen/dp_15"
        android:layout_marginEnd="@dimen/dp_15"
        layout="@layout/layout_function_button"/>
</LinearLayout>
