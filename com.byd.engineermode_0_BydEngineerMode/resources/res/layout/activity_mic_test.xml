<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/hint"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_25"
        android:layout_marginBottom="@dimen/dp_15"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/dp_15"
        android:layout_marginEnd="@dimen/dp_15">
        <TextView
            android:textSize="@dimen/sp_25"
            android:layout_gravity="center"
            android:id="@+id/test_mic1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_50"
            android:text="@string/str_mic_test"
            android:layout_marginStart="@dimen/dp_50"/>
        <Button
            android:textSize="@dimen/sp_20"
            android:id="@+id/btn_mic1_record"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:text="@string/start_record"
            android:layout_weight="1"
            android:layout_below="@+id/test_mic1"
            android:onClick="OnButtonClick"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/dp_50"/>
        <Button
            android:textSize="@dimen/sp_20"
            android:id="@+id/btn_mic1_play"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:text="@string/start_play"
            android:layout_weight="1"
            android:layout_below="@+id/btn_mic1_record"
            android:onClick="OnButtonClick"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/dp_50"/>
    </RelativeLayout>
    <include
        android:layout_gravity="bottom"
        android:id="@+id/layout_bottom"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="@dimen/dp_60"
        android:layout_marginStart="@dimen/dp_15"
        android:layout_marginEnd="@dimen/dp_15"
        layout="@layout/layout_function_button"/>
</LinearLayout>
