<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="@dimen/dp_560"
    android:layout_height="@dimen/dp_312">
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="@color/text_main"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_25"
        android:layout_centerHorizontal="true"/>
    <View
        android:id="@+id/divider_top"
        android:background="@color/divider"
        android:visibility="visible"
        android:layout_width="@dimen/dp_560"
        android:layout_height="@dimen/dp_1"
        android:layout_marginTop="@dimen/dp_25"/>
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="@color/text_main"
        android:gravity="center"
        android:id="@+id/tv_message"
        android:layout_width="@dimen/dp_560"
        android:layout_height="@dimen/dp_79"
        android:layout_marginTop="@dimen/dp_30"
        android:text="@string/dialog_test_pass"/>
    <RelativeLayout
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_104"
        android:layout_marginTop="@dimen/dp_20">
        <Button
            android:textSize="@dimen/sp_18"
            android:textColor="@color/dialog_button_upload_text_color"
            android:id="@+id/btn_confirm"
            android:background="@drawable/dialog_button_bg_selector"
            android:visibility="visible"
            android:layout_width="@dimen/dp_176"
            android:layout_height="@dimen/dp_48"
            android:text="@string/dialog_test_pass"
            android:layout_alignRight="@+id/divider_center_line"
            android:layout_centerVertical="true"
            android:textAllCaps="false"
            android:layout_marginEnd="@dimen/dp_40"/>
        <View
            android:id="@+id/divider_center_line"
            android:background="@color/divider"
            android:visibility="visible"
            android:layout_width="@dimen/dp_1"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/dp_280"/>
        <Button
            android:textSize="@dimen/sp_18"
            android:textColor="@color/dialog_button_upload_text_color"
            android:id="@+id/btn_cancel"
            android:background="@drawable/dialog_exit_button_bg"
            android:layout_width="@dimen/dp_176"
            android:layout_height="@dimen/dp_48"
            android:text="@string/dialog_test_fail"
            android:layout_alignLeft="@+id/divider_center_line"
            android:layout_centerVertical="true"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/dp_40"/>
    </RelativeLayout>
</LinearLayout>
