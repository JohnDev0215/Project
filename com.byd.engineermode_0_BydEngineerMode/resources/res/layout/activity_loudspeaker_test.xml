<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/hint"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_25"
        android:layout_marginBottom="@dimen/dp_15"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/dp_15"
        android:layout_marginEnd="@dimen/dp_15">
        <TextView
            android:textSize="@dimen/sp_25"
            android:textColor="@color/black"
            android:layout_gravity="center"
            android:id="@+id/test_Loudspeaker_fl"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_50"
            android:text="Loudspeaker FL"
            android:layout_marginStart="@dimen/dp_50"/>
        <Button
            android:textSize="@dimen/sp_20"
            android:id="@+id/btn_Loudspeaker_fl"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:text="@string/start_play"
            android:layout_weight="1"
            android:layout_below="@+id/test_Loudspeaker_fl"
            android:onClick="OnButtonClick"
            android:layout_marginStart="@dimen/dp_50"/>
        <TextView
            android:textSize="@dimen/sp_25"
            android:textColor="@color/black"
            android:layout_gravity="center"
            android:id="@+id/test_Loudspeaker_fr"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_50"
            android:text="Loudspeaker FR"
            android:layout_marginStart="@dimen/dp_300"/>
        <Button
            android:textSize="@dimen/sp_20"
            android:id="@+id/btn_Loudspeaker_fr"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:text="@string/start_play"
            android:layout_below="@+id/test_Loudspeaker_fr"
            android:onClick="OnButtonClick"
            android:layout_marginStart="@dimen/dp_300"/>
        <TextView
            android:textSize="@dimen/sp_25"
            android:textColor="@color/black"
            android:layout_gravity="center"
            android:id="@+id/test_Loudspeaker_RL"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_50"
            android:text="Loudspeaker RL"
            android:layout_below="@+id/btn_Loudspeaker_fl"
            android:layout_marginStart="@dimen/dp_50"/>
        <Button
            android:textSize="@dimen/sp_20"
            android:id="@+id/btn_Loudspeaker_RL"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:text="@string/start_play"
            android:layout_weight="1"
            android:layout_below="@+id/test_Loudspeaker_RL"
            android:onClick="OnButtonClick"
            android:layout_marginStart="@dimen/dp_50"/>
        <TextView
            android:textSize="@dimen/sp_25"
            android:textColor="@color/black"
            android:layout_gravity="center"
            android:id="@+id/test_Loudspeaker_Rr"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_50"
            android:text="Loudspeaker Rr"
            android:layout_below="@+id/btn_Loudspeaker_fr"
            android:layout_marginStart="@dimen/dp_300"/>
        <Button
            android:textSize="@dimen/sp_20"
            android:id="@+id/btn_Loudspeaker_Rr"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:text="@string/start_play"
            android:layout_below="@+id/test_Loudspeaker_Rr"
            android:onClick="OnButtonClick"
            android:layout_marginStart="@dimen/dp_300"/>
        <TextView
            android:textSize="@dimen/sp_25"
            android:textColor="@color/black"
            android:layout_gravity="center"
            android:id="@+id/test_Loudspeaker_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_50"
            android:text="Loudspeaker All"
            android:layout_below="@+id/btn_Loudspeaker_RL"
            android:layout_marginStart="@dimen/dp_50"/>
        <Button
            android:textSize="@dimen/sp_20"
            android:id="@+id/btn_Loudspeaker_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:text="@string/start_play"
            android:layout_below="@+id/test_Loudspeaker_all"
            android:onClick="OnButtonClick"
            android:layout_marginStart="@dimen/dp_50"/>
    </RelativeLayout>
    <include
        android:layout_gravity="bottom"
        android:id="@+id/layout_bottom"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="@dimen/dp_60"
        android:layout_marginStart="@dimen/dp_15"
        android:layout_marginEnd="@dimen/dp_15"
        layout="@layout/layout_function_button"/>
</LinearLayout>
