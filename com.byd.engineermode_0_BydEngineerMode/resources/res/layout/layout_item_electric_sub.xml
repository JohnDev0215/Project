<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/dp_60">
    <View
        android:background="@color/divider"
        android:layout_width="@dimen/dp_1"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textColor="@color/text_color"
        android:gravity="center"
        android:id="@+id/tv_name"
        android:layout_width="@dimen/dp_185"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:background="@color/divider"
        android:layout_width="@dimen/dp_1"
        android:layout_height="match_parent"
        app:layout_constraintStart_toEndOf="@+id/tv_name"/>
    <TextView
        android:textColor="@color/text_color"
        android:gravity="center"
        android:id="@+id/tv_supplier"
        android:layout_width="@dimen/dp_150"
        android:layout_height="match_parent"
        app:layout_constraintStart_toEndOf="@+id/tv_name"/>
    <View
        android:background="@color/divider"
        android:layout_width="@dimen/dp_1"
        android:layout_height="match_parent"
        app:layout_constraintStart_toEndOf="@+id/tv_supplier"/>
    <TextView
        android:textColor="@color/text_color"
        android:gravity="center"
        android:id="@+id/tv_short"
        android:background="@drawable/item_normal_selector"
        android:layout_width="@dimen/dp_110"
        android:layout_height="match_parent"
        app:layout_constraintStart_toEndOf="@+id/tv_supplier"/>
    <View
        android:background="@color/divider"
        android:visibility="gone"
        android:layout_width="@dimen/dp_1"
        android:layout_height="match_parent"
        app:layout_constraintStart_toEndOf="@+id/tv_short"/>
    <TextView
        android:textColor="@color/text_color"
        android:gravity="center"
        android:id="@+id/tv_break"
        android:background="@drawable/item_normal_selector"
        android:visibility="gone"
        android:layout_width="@dimen/dp_80"
        android:layout_height="match_parent"
        app:layout_constraintStart_toEndOf="@+id/tv_short"/>
    <View
        android:background="@color/divider"
        android:layout_width="@dimen/dp_1"
        android:layout_height="match_parent"
        app:layout_constraintStart_toEndOf="@+id/tv_break"/>
    <TextView
        android:textColor="@color/text_color"
        android:gravity="center"
        android:id="@+id/tv_connect"
        android:background="@drawable/item_normal_selector"
        android:layout_width="@dimen/dp_110"
        android:layout_height="match_parent"
        app:layout_constraintStart_toEndOf="@+id/tv_break"/>
    <View
        android:background="@color/divider"
        android:layout_width="@dimen/dp_1"
        android:layout_height="match_parent"
        app:layout_constraintStart_toEndOf="@+id/tv_connect"/>
    <androidx.appcompat.widget.AppCompatButton
        android:gravity="center"
        android:id="@+id/btn_test"
        android:layout_width="@dimen/dp_80"
        android:layout_height="match_parent"
        android:text="@string/test"
        android:textAllCaps="false"
        app:layout_constraintStart_toEndOf="@+id/tv_connect"/>
    <View
        android:background="@color/divider"
        android:layout_width="@dimen/dp_1"
        android:layout_height="match_parent"
        app:layout_constraintStart_toEndOf="@+id/btn_test"/>
    <View
        android:background="@color/divider"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/btn_test"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
