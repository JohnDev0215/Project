<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/dialog_bg_shape"
    android:layout_width="@dimen/dp_560"
    android:layout_height="@dimen/dp_312">
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="@color/text_main"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        app:layout_constraintBottom_toBottomOf="@+id/divider_top"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/divider_top"
        android:background="@color/divider"
        android:visibility="visible"
        android:layout_width="@dimen/dp_560"
        android:layout_height="@dimen/dp_1"
        android:layout_marginTop="@dimen/dp_61"
        app:layout_constraintBottom_toTopOf="@+id/ly_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ly_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/divider_bottom"
        app:layout_constraintTop_toBottomOf="@+id/divider_top"
        app:layout_constraintVertical_weight="1"/>
    <View
        android:id="@+id/divider_bottom"
        android:background="@color/divider"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_marginBottom="@dimen/dp_94"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ly_content"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_confirm"
        android:visibility="invisible"
        android:layout_width="@dimen/dp_98"
        android:layout_height="@dimen/dp_60"
        android:text="@string/btn_ok"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/divider_bottom"/>
    <androidx.appcompat.widget.AppCompatButton
        android:textSize="@dimen/sp_18"
        android:textColor="@color/dialog_button_upload_text_color"
        android:id="@+id/btn_ok"
        android:background="@drawable/dialog_button_bg_selector"
        android:layout_width="@dimen/dp_176"
        android:layout_height="@dimen/dp_48"
        android:text="@string/btn_ok"
        android:layout_marginEnd="@dimen/dp_15"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline"
        app:layout_constraintTop_toTopOf="@+id/divider_bottom"/>
    <androidx.appcompat.widget.AppCompatButton
        android:textSize="@dimen/sp_18"
        android:textColor="@color/dialog_button_upload_text_color"
        android:id="@+id/btn_cancel"
        android:background="@drawable/dialog_button_bg_selector"
        android:layout_width="@dimen/dp_176"
        android:layout_height="@dimen/dp_48"
        android:text="@string/btn_cancel"
        android:layout_marginEnd="@dimen/dp_15"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/guideline"
        app:layout_constraintTop_toTopOf="@+id/divider_bottom"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_two"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="btn_ok,btn_cancel"/>
</androidx.constraintlayout.widget.ConstraintLayout>
