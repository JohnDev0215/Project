<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/hint"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_25"
        android:layout_marginBottom="@dimen/dp_15"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/dp_15"
        android:layout_marginEnd="@dimen/dp_15">
        <TextView
            android:textSize="@dimen/sp_25"
            android:textColor="@color/text_default_color"
            android:layout_gravity="center"
            android:id="@+id/test_uDisk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_50"
            android:text="@string/usb_test_udisk"
            android:layout_marginStart="@dimen/dp_10"/>
        <Button
            android:textSize="@dimen/sp_20"
            android:id="@+id/btn_uDisk"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:text="@string/disconnect"
            android:layout_below="@+id/test_uDisk"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/dp_10"/>
        <TextView
            android:textSize="@dimen/sp_25"
            android:textColor="@color/text_default_color"
            android:layout_gravity="center"
            android:id="@+id/test_sdcard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_50"
            android:text="@string/usb_test_sdcard"
            android:layout_marginStart="@dimen/dp_200"/>
        <Button
            android:textSize="@dimen/sp_20"
            android:id="@+id/btn_sdcard"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:text="@string/disconnect"
            android:layout_below="@+id/test_sdcard"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/dp_200"/>
        <TextView
            android:textSize="@dimen/sp_25"
            android:textColor="@color/text_default_color"
            android:layout_gravity="center"
            android:id="@+id/test_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_50"
            android:text="@string/usb_test_play_title"
            android:layout_below="@+id/btn_uDisk"
            android:layout_marginStart="@dimen/dp_10"/>
        <TextView
            android:textSize="@dimen/sp_15"
            android:textColor="@color/text_default_color"
            android:layout_gravity="center"
            android:id="@+id/test_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/usb_test_limit_message"
            android:layout_below="@+id/test_message"
            android:layout_marginStart="@dimen/dp_10"/>
        <Button
            android:textSize="@dimen/sp_20"
            android:id="@+id/btn_play_music"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:text="@string/usb_test_play_audio"
            android:layout_below="@+id/test_hint"
            android:onClick="OnButtonClick"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/dp_10"/>
        <TextView
            android:textSize="@dimen/sp_15"
            android:textColor="@color/text_default_color"
            android:id="@+id/mp3_play"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:layout_below="@+id/test_hint"
            android:layout_marginStart="@dimen/dp_150"/>
        <Button
            android:textSize="@dimen/sp_20"
            android:id="@+id/btn_play_video"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:text="@string/usb_test_play_video"
            android:layout_below="@+id/btn_play_music"
            android:onClick="OnButtonClick"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/dp_10"/>
    </RelativeLayout>
    <include
        android:layout_gravity="bottom"
        android:id="@+id/layout_bottom"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="@dimen/dp_60"
        android:layout_marginStart="@dimen/dp_15"
        android:layout_marginEnd="@dimen/dp_15"
        layout="@layout/layout_function_button"/>
</LinearLayout>
