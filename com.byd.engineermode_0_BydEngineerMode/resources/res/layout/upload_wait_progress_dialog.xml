<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/dialog_bg_shape"
    android:layout_width="@dimen/dp_560"
    android:layout_height="@dimen/dp_312">
    <com.byd.engineermode.ui.dialog.HorizontalProgressView
        android:layout_gravity="center_horizontal"
        android:id="@+id/progress_bar"
        android:visibility="visible"
        android:layout_width="@dimen/dp_400"
        android:layout_height="@dimen/dp_50"
        android:layout_marginTop="@dimen/dp_87"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="@color/dialog_button_upload_text_color"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/text_view"
        android:layout_width="@dimen/dp_560"
        android:layout_height="@dimen/dp_51"
        android:layout_marginTop="@dimen/dp_40"
        android:layout_marginBottom="@dimen/dp_77"
        android:text="logtools_wait_upload_message_string"/>
</LinearLayout>
