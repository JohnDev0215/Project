<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/anim_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_power_abnomal_view_all"
        android:layout_width="@dimen/ll_power_abnomal_view_all_width"
        android:layout_height="@dimen/ll_power_abnomal_view_all_heigth"
        android:layout_marginLeft="@dimen/ll_power_abnomal_view_all_marginleft"
        android:layout_marginTop="@dimen/ll_power_abnomal_view_all_margintop">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_power_abnomal_view_contxt_all"
            android:background="@drawable/bg_pop_login"
            android:clickable="true"
            android:layout_width="@dimen/ll_power_abnomal_view_contxt_all_width"
            android:layout_height="@dimen/ll_power_abnomal_view_contxt_all_height"
            android:layout_margin="@dimen/ll_power_abnomal_view_contxt_all_margin">
            <TextView
                android:textSize="@dimen/tv_login_title"
                android:textStyle="bold"
                android:textColor="@color/color_white"
                android:gravity="center"
                android:id="@+id/tv_power_abnomal_view_title"
                android:layout_width="@dimen/tv_power_abnomal_view_title_width"
                android:layout_height="@dimen/tv_power_abnomal_view_title_height"
                android:layout_marginLeft="@dimen/tv_power_abnomal_view_title_marginleft"
                android:layout_marginTop="@dimen/tv_power_abnomal_view_title_margintop"
                android:text="@string/power_abnomal_temperature"
                android:contentDescription="主机温度异常!"/>
            <TextView
                android:textSize="@dimen/tv_bigger"
                android:textColor="@color/color_white"
                android:gravity="center"
                android:id="@+id/tv_power_abnomal_view_tip"
                android:layout_width="@dimen/tv_power_abnomal_view_tip_widht"
                android:layout_height="@dimen/tv_power_abnomal_view_tip_height"
                android:layout_marginLeft="@dimen/tv_power_abnomal_view_tip_marginleft"
                android:layout_marginTop="@dimen/tv_power_abnomal_view_tip_margintop"
                android:text="@string/power_abnomal_tip"
                android:contentDescription="倒计时结束后会进入待机模式"/>
            <View
                android:id="@+id/power_abnomal_view_interval"
                android:layout_width="match_parent"
                android:layout_height="@dimen/power_abnomal_view_interval_height"/>
            <View style="@style/v_line"/>
            <TextView
                android:textSize="@dimen/tv_bigger"
                android:textColor="@color/color_white"
                android:gravity="center"
                android:id="@+id/tv_power_abnomal_view_time"
                android:layout_width="@dimen/tv_power_abnomal_view_time_width"
                android:layout_height="@dimen/tv_power_abnomal_view_time_height"
                android:layout_marginLeft="@dimen/tv_power_abnomal_view_time_marginleft"
                android:layout_marginTop="@dimen/tv_power_abnomal_view_time_margintop"
                android:layout_marginRight="@dimen/tv_power_abnomal_view_time_marginright"
                android:text="(“%1$d”秒)"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
