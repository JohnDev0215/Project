<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rl_tab_container"
        android:paddingTop="@dimen/dp_72"
        android:layout_width="@dimen/dp_220"
        android:layout_height="match_parent"
        android:layout_alignParentLeft="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ll_ac_control_container"
            android:layout_width="@dimen/dp_208"
            android:layout_height="@dimen/dp_64"
            android:layout_alignParentLeft="true">
            <ImageView
                android:id="@+id/iv_ac_control_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/cc_left_bar_btn_text_selector_denza"
                android:ellipsize="end"
                android:gravity="right"
                android:id="@+id/tv_ac_control"
                android:layout_width="@dimen/dp_150"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/dp_3"
                android:text="@string/app_name"
                android:maxLines="2"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/iv_ac_control"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/iv_ac_control"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:layout_marginRight="@dimen/dp_8"
                android:src="@mipmap/icon_air_conditioning_module"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ll_seat_control_container"
            android:layout_width="@dimen/dp_208"
            android:layout_height="@dimen/dp_64"
            android:layout_below="@+id/ll_ac_control_container"
            android:layout_alignParentLeft="true">
            <ImageView
                android:id="@+id/iv_seat_control_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/cc_left_bar_btn_text_selector_denza"
                android:ellipsize="end"
                android:gravity="right"
                android:id="@+id/tv_seat_control"
                android:layout_width="@dimen/dp_150"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/dp_3"
                android:text="@string/seat_heat_ventilation"
                android:maxLines="2"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/iv_seat_control"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/iv_seat_control"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:layout_marginRight="@dimen/dp_8"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ll_green_control_container"
            android:layout_width="@dimen/dp_208"
            android:layout_height="@dimen/dp_64"
            android:layout_below="@+id/ll_seat_control_container"
            android:layout_alignParentLeft="true">
            <ImageView
                android:id="@+id/iv_green_control_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/cc_left_bar_btn_text_selector_denza"
                android:ellipsize="end"
                android:gravity="right"
                android:id="@+id/tv_green_control"
                android:layout_width="@dimen/dp_150"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/dp_3"
                android:text="@string/green"
                android:maxLines="2"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/iv_green_control"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/iv_green_control"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:layout_marginRight="@dimen/dp_8"
                android:src="@mipmap/icon_green_clean"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ll_fragrance_control_container"
            android:layout_width="@dimen/dp_208"
            android:layout_height="@dimen/dp_64"
            android:layout_below="@+id/ll_green_control_container"
            android:layout_alignParentLeft="true">
            <ImageView
                android:id="@+id/iv_fragrance_control_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/cc_left_bar_btn_text_selector_denza"
                android:ellipsize="end"
                android:gravity="right"
                android:id="@+id/tv_fragrance_control"
                android:layout_width="@dimen/dp_150"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/dp_3"
                android:text="@string/fragrance"
                android:maxLines="2"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/iv_fragrance_control"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/iv_fragrance_control"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:layout_marginRight="@dimen/dp_8"
                android:src="@mipmap/icon_fragrance"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ll_set_control_container"
            android:layout_width="@dimen/dp_208"
            android:layout_height="@dimen/dp_64"
            android:layout_below="@+id/ll_fragrance_control_container"
            android:layout_alignParentLeft="true">
            <ImageView
                android:id="@+id/iv_set_control_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/cc_left_bar_btn_text_selector_denza"
                android:ellipsize="end"
                android:gravity="right"
                android:id="@+id/tv_set_control"
                android:layout_width="@dimen/dp_150"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/dp_3"
                android:text="@string/set"
                android:maxLines="2"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/iv_set_control"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/iv_set_control"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:layout_marginRight="@dimen/dp_8"
                android:src="@mipmap/icon_set_up"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/cc_right_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/dp_224"/>
</RelativeLayout>
