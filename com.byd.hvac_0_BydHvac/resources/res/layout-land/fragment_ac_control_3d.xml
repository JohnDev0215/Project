<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">
    <FrameLayout
        android:id="@+id/car_bg_3d_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <TextView
        android:textSize="@dimen/sp_22"
        android:textColor="@color/text_tem_white"
        android:gravity="center"
        android:id="@+id/tv_double_click_to_operate"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_84"
        android:maxWidth="@dimen/dp_800"
        android:text="@string/electric_tuyere_double_click_to_operate"
        android:maxLines="2"
        android:layout_alignTop="@+id/car_bg_3d_layout"
        android:layout_centerHorizontal="true"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vp_ac_control"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dp_16"/>
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tl_ac_control"
        android:background="@null"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_72"
        app:tabGravity="start"
        app:tabIndicatorColor="@color/left_bar_btn_text_color_s"
        app:tabSelectedTextColor="@color/left_bar_btn_text_color_s"
        app:tabTextColor="@color/left_bar_btn_text_color_n"
        style="@style/tablayout_style"/>
</RelativeLayout>
