<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="@dimen/dp_56"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_green_car_bg"
        android:layout_width="@dimen/dp_910"
        android:layout_height="@dimen/dp_392"
        android:layout_marginTop="@dimen/dp_185"
        android:rotationY="180"
        android:layout_marginEnd="@dimen/dp_104"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_green_car_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:id="@+id/iv_green_line_nothing_to_exit"
            android:visibility="gone"
            android:layout_width="@dimen/dp_255"
            android:layout_height="@dimen/dp_206"
            android:layout_marginTop="@dimen/dp_94"
            android:layout_marginStart="@dimen/dp_360"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/iv_green_anion_nothing_to_exit"
            android:visibility="gone"
            android:layout_width="@dimen/dp_255"
            android:layout_height="@dimen/dp_206"
            android:layout_marginStart="@dimen/dp_360"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:lottie_loop="true"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/iv_green_leaf_nothing_to_exit"
            android:visibility="gone"
            android:layout_width="@dimen/dp_255"
            android:layout_height="@dimen/dp_206"
            android:layout_marginStart="@dimen/dp_360"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:lottie_loop="true"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_in_car_pm25_level"
            android:background="@mipmap/img_dark_air_green_net_mild_denza"
            android:layout_width="@dimen/dp_245"
            android:layout_height="@dimen/dp_245"
            android:rotationY="180"
            android:layout_marginStart="@dimen/dp_190"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <RelativeLayout
                android:id="@+id/rl_in_pm25_value_container"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="@dimen/sp_21"
                    android:textColor="@color/white"
                    android:ellipsize="end"
                    android:gravity="center_horizontal"
                    android:id="@+id/tv_inside_pm25_level"
                    android:layout_width="@dimen/dp_100"
                    android:layout_height="wrap_content"
                    android:text="@string/pm25_level_heavy"
                    android:maxLines="2"
                    android:layout_centerHorizontal="true"/>
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textColor="@color/white"
                    android:id="@+id/tv_inside_pm25_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_1"
                    android:text="@string/in_car"
                    android:layout_below="@+id/tv_inside_pm25_level"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>
            <TextView
                android:textSize="@dimen/sp_28"
                android:textColor="@color/white"
                android:id="@+id/tv_in_pm25_close_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="- - -"
                android:layout_centerHorizontal="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:id="@+id/ll_top_ac_front_control_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_44"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/left_bar_btn_text_color_n"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/ib_pm25_dual_channel_state"
            android:background="@drawable/shape_btn_selector"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:maxWidth="@dimen/dp_230"
            android:minWidth="@dimen/dp_144"
            android:minHeight="@dimen/dp_40"
            android:text="@string/pm2_5_check"
            android:paddingStart="@dimen/dp_24"
            android:paddingEnd="@dimen/dp_24"
            android:layout_marginEnd="@dimen/dp_24"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/left_bar_btn_text_color_n"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/ib_pm25_in_car_state"
            android:background="@drawable/shape_btn_selector"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:maxWidth="@dimen/dp_230"
            android:minWidth="@dimen/dp_144"
            android:minHeight="@dimen/dp_40"
            android:text="@string/pm2_5_in_car"
            android:paddingStart="@dimen/dp_5"
            android:paddingEnd="@dimen/dp_5"
            android:layout_marginEnd="@dimen/dp_24"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/left_bar_btn_text_color_n"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/ib_pm25_out_car_state"
            android:background="@drawable/shape_btn_selector"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:maxWidth="@dimen/dp_230"
            android:minWidth="@dimen/dp_144"
            android:minHeight="@dimen/dp_40"
            android:text="@string/pm2_5_out_car"
            android:paddingStart="@dimen/dp_5"
            android:paddingEnd="@dimen/dp_5"
            android:layout_marginEnd="@dimen/dp_24"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/left_bar_btn_text_color_n"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/ib_rapid_green_state"
            android:background="@drawable/shape_btn_selector"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:maxWidth="@dimen/dp_230"
            android:minWidth="@dimen/dp_144"
            android:minHeight="@dimen/dp_40"
            android:text="@string/rapid_green"
            android:paddingStart="@dimen/dp_24"
            android:paddingEnd="@dimen/dp_24"
            android:layout_marginEnd="@dimen/dp_24"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/left_bar_btn_text_color_n"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/ib_anion_state"
            android:background="@drawable/shape_btn_selector"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:maxWidth="@dimen/dp_230"
            android:minWidth="@dimen/dp_144"
            android:minHeight="@dimen/dp_40"
            android:text="@string/anion"
            android:paddingStart="@dimen/dp_24"
            android:paddingEnd="@dimen/dp_24"
            android:layout_marginEnd="@dimen/dp_24"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_out_car_pm25_level"
        android:background="@mipmap/img_dark_air_green_net_mild_denza"
        android:layout_width="@dimen/dp_245"
        android:layout_height="@dimen/dp_245"
        android:layout_marginTop="@dimen/dp_64"
        android:layout_marginEnd="@dimen/dp_37"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <RelativeLayout
            android:id="@+id/rl_out_pm25_value_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="@dimen/sp_21"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:id="@+id/tv_out_pm25_level"
                android:layout_width="@dimen/dp_100"
                android:layout_height="wrap_content"
                android:text="@string/pm25_level_heavy"
                android:maxLines="2"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/white"
                android:id="@+id/tv_out_pm25_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_1"
                android:text="@string/outside_car"
                android:layout_below="@+id/tv_out_pm25_level"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <TextView
            android:textSize="@dimen/sp_28"
            android:textColor="@color/white"
            android:id="@+id/tv_out_pm25_close_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tv_pm25_invalid"
            android:layout_centerHorizontal="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
