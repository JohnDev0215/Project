<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">
    <LinearLayout
        android:gravity="center_horizontal"
        android:id="@+id/ll_top_ac_front_control_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.byd.hvac.view.tintimageview.TintLottieAnimationView
            android:id="@+id/ib_air_condition_off"
            android:background="@drawable/shape_btn_selector"
            android:layout_width="@dimen/dp_100"
            android:layout_height="@dimen/dp_40"
            android:src="@mipmap/icon_ac_off"
            app:drawable_close="@mipmap/icon_ac_off"
            app:drawable_open="@mipmap/icon_ac_on"/>
        <com.byd.hvac.view.tintimageview.TintLottieAnimationView
            android:id="@+id/ib_air_auto"
            android:background="@drawable/shape_btn_selector"
            android:layout_width="@dimen/dp_100"
            android:layout_height="@dimen/dp_40"
            android:src="@mipmap/icon_ac_auto"
            android:layout_marginStart="@dimen/dp_16"
            app:drawable_close="@mipmap/icon_ac_auto"
            app:drawable_open="@mipmap/icon_ac_auto"/>
        <com.byd.hvac.view.tintimageview.TintLottieAnimationView
            android:id="@+id/ib_air_ac_snowflake"
            android:background="@drawable/shape_btn_selector"
            android:layout_width="@dimen/dp_100"
            android:layout_height="@dimen/dp_40"
            android:layout_marginStart="@dimen/dp_16"/>
        <com.byd.hvac.view.tintimageview.TintLottieAnimationView
            android:id="@+id/ib_air_ac_snowflake_max"
            android:background="@drawable/shape_btn_selector"
            android:layout_width="@dimen/dp_100"
            android:layout_height="@dimen/dp_40"
            android:src="@mipmap/icon_ac_cool_max"
            android:layout_marginStart="@dimen/dp_16"
            app:drawable_close="@mipmap/icon_ac_cool_max"
            app:drawable_open="@mipmap/icon_ac_cool_max"/>
        <com.byd.hvac.view.tintimageview.TintLottieAnimationView
            android:id="@+id/ib_air_ac_heat"
            android:background="@drawable/shape_btn_selector"
            android:layout_width="@dimen/dp_100"
            android:layout_height="@dimen/dp_40"
            android:src="@mipmap/icon_ac_heat_state"
            android:layout_marginStart="@dimen/dp_16"
            app:drawable_close="@mipmap/icon_ac_heat_state"
            app:drawable_open="@mipmap/icon_ac_heat_state"/>
        <com.byd.hvac.view.tintimageview.TintLottieAnimationView
            android:id="@+id/ib_air_before_defrost"
            android:background="@drawable/shape_btn_yellow_selector"
            android:layout_width="@dimen/dp_100"
            android:layout_height="@dimen/dp_40"
            android:src="@mipmap/icon_front_defrosting"
            android:layout_marginStart="@dimen/dp_16"
            app:drawable_close="@mipmap/icon_front_defrosting"
            app:drawable_open="@mipmap/icon_front_defrosting"/>
        <com.byd.hvac.view.tintimageview.TintLottieAnimationView
            android:id="@+id/ib_air_after_defrost"
            android:background="@drawable/shape_btn_yellow_selector"
            android:layout_width="@dimen/dp_100"
            android:layout_height="@dimen/dp_40"
            android:layout_marginStart="@dimen/dp_16"/>
        <com.byd.hvac.view.tintimageview.TintLottieAnimationView
            android:id="@+id/ib_air_loop_mode"
            android:background="@drawable/shape_btn_selector"
            android:layout_width="@dimen/dp_100"
            android:layout_height="@dimen/dp_40"
            android:src="@mipmap/icon_internal"
            android:layout_marginStart="@dimen/dp_16"
            app:drawable_close="@mipmap/icon_internal"
            app:drawable_open="@mipmap/icon_internal"/>
        <com.byd.hvac.view.tintimageview.TintLottieAnimationView
            android:id="@+id/ib_air_ventilation"
            android:background="@drawable/shape_btn_selector"
            android:layout_width="@dimen/dp_100"
            android:layout_height="@dimen/dp_40"
            android:src="@mipmap/icon_ventilate"
            android:layout_marginStart="@dimen/dp_16"
            app:drawable_close="@mipmap/icon_ventilate"
            app:drawable_open="@mipmap/icon_ventilate"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/sp_24"
        android:textColor="@color/text_brake_and_start_vehicle_color"
        android:id="@+id/tv_tips_start_vehicle"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_35"
        android:text="@string/hvac_brake_and_start_vehicle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_top_ac_front_control_container"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/cl_left_temp_control"
        android:layout_width="@dimen/dp_150"
        android:layout_height="@dimen/dp_319"
        android:layout_marginTop="@dimen/dp_84"
        android:layout_marginStart="@dimen/dp_20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageButton
            android:id="@+id/ib_left_temp_rise"
            android:background="@mipmap/icon_dark_air_temperature_rise_72"
            android:layout_width="@dimen/dp_72"
            android:layout_height="@dimen/dp_72"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.byd.hvac.view.datapickview.WheelView
            android:gravity="center_horizontal"
            android:layout_gravity="center"
            android:id="@+id/left_wheel_view"
            android:layout_width="@dimen/dp_150"
            android:layout_height="@dimen/dp_175"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ib_left_temp_rise"
            app:wh_max_text_size="@dimen/sp_60"
            app:wh_min_text_size="@dimen/sp_32"
            app:wh_selected_text_color="@color/text_tem_white"
            app:wh_text_color="@color/text_tem_gray"
            app:wh_text_space_ratio="2"/>
        <ImageButton
            android:id="@+id/ib_left_temp_reduce"
            android:background="@mipmap/icon_dark_air_temperature_reduction_72"
            android:layout_width="@dimen/dp_72"
            android:layout_height="@dimen/dp_72"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/tv_left_temp_unit"
        android:layout_width="@dimen/dp_26"
        android:layout_height="@dimen/dp_26"
        android:layout_marginTop="@dimen/dp_3"
        android:src="@mipmap/icon_temperature_unit_c"
        android:layout_marginStart="@dimen/dp_120"
        app:layout_constraintBottom_toBottomOf="@+id/cl_left_temp_control"
        app:layout_constraintStart_toStartOf="@+id/cl_left_temp_control"
        app:layout_constraintTop_toTopOf="@+id/cl_left_temp_control"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/cl_right_temp_control"
        android:layout_width="@dimen/dp_150"
        android:layout_height="@dimen/dp_319"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/cl_left_temp_control"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cl_left_temp_control">
        <ImageButton
            android:id="@+id/ib_right_temp_rise"
            android:background="@mipmap/icon_dark_air_temperature_rise_72"
            android:layout_width="@dimen/dp_72"
            android:layout_height="@dimen/dp_72"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.byd.hvac.view.datapickview.WheelView
            android:gravity="center_horizontal"
            android:layout_gravity="center"
            android:id="@+id/right_wheel_view"
            android:layout_width="@dimen/dp_150"
            android:layout_height="@dimen/dp_175"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ib_right_temp_rise"
            app:wh_max_text_size="@dimen/sp_60"
            app:wh_min_text_size="@dimen/sp_32"
            app:wh_selected_text_color="@color/text_tem_white"
            app:wh_text_color="@color/text_tem_gray"
            app:wh_text_space_ratio="2"/>
        <ImageButton
            android:id="@+id/ib_right_temp_reduce"
            android:background="@mipmap/icon_dark_air_temperature_reduction_72"
            android:layout_width="@dimen/dp_72"
            android:layout_height="@dimen/dp_72"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/tv_right_temp_unit"
        android:layout_width="@dimen/dp_26"
        android:layout_height="@dimen/dp_26"
        android:layout_marginTop="@dimen/dp_3"
        android:src="@mipmap/icon_temperature_unit_c"
        android:layout_marginStart="@dimen/dp_120"
        app:layout_constraintBottom_toBottomOf="@+id/cl_right_temp_control"
        app:layout_constraintStart_toStartOf="@+id/cl_right_temp_control"
        app:layout_constraintTop_toTopOf="@+id/cl_right_temp_control"/>
    <com.byd.hvac.view.tintimageview.TintImageView
        android:id="@+id/ib_air_synchronous_state"
        android:background="@drawable/shape_btn_selector"
        android:layout_width="@dimen/dp_100"
        android:layout_height="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_42"
        android:src="@mipmap/icon_dark_air_synchronous_40"
        app:color_close_state="@color/btn_close_bg_gray_a"
        app:color_open_state="@color/btn_open_bg_blue"
        app:layout_constraintEnd_toEndOf="@+id/cl_left_temp_control"
        app:layout_constraintStart_toStartOf="@+id/cl_left_temp_control"
        app:layout_constraintTop_toBottomOf="@+id/cl_left_temp_control"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_air_wind_level_container"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_80"
        android:layout_marginTop="@dimen/dp_22"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_left_temp_control">
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/ib_air_level_small"
            android:layout_width="@dimen/dp_60"
            android:layout_height="@dimen/dp_60"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.byd.hvac.view.WindLevelButton
            android:id="@+id/sb_air_wind_level"
            android:paddingTop="@dimen/dp_23"
            android:paddingBottom="@dimen/dp_23"
            android:layout_width="@dimen/dp_500"
            android:layout_height="@dimen/dp_80"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ib_air_level_small"
            app:layout_constraintTop_toTopOf="parent"
            app:maxLevel="7"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/ib_air_level_big"
            android:layout_width="@dimen/dp_60"
            android:layout_height="@dimen/dp_60"
            android:layout_marginStart="@dimen/dp_10"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/sb_air_wind_level"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="@dimen/dp_609"
        android:layout_height="@dimen/dp_280"
        android:layout_marginStart="@dimen/dp_53"
        app:layout_constraintBottom_toBottomOf="@+id/cl_left_temp_control"
        app:layout_constraintStart_toEndOf="@+id/cl_left_temp_control"
        app:layout_constraintTop_toTopOf="@+id/cl_left_temp_control">
        <ImageButton
            android:id="@+id/ib_air_anion_state"
            android:background="@mipmap/img_dark_air_anion_off"
            android:visibility="invisible"
            android:layout_width="@dimen/dp_80"
            android:layout_height="@dimen/dp_80"
            android:layout_marginStart="@dimen/dp_5"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/iv_anion_animation"
            android:background="@android:color/transparent"
            android:visibility="invisible"
            android:layout_width="@dimen/dp_80"
            android:layout_height="@dimen/dp_80"
            android:layout_marginStart="@dimen/dp_5"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/animation_particle"/>
        <ImageView
            android:id="@+id/iv_top_ribbon_nothing_to_exit"
            android:layout_width="@dimen/dp_440"
            android:layout_height="@dimen/dp_94"
            android:src="@mipmap/img_dark_air_up_wind_off"
            android:layout_marginStart="@dimen/dp_19"
            app:layout_constraintStart_toStartOf="@+id/ib_air_defrost_state"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/iv_top_particle_nothing_to_exit"
            android:background="@android:color/transparent"
            android:visibility="gone"
            android:layout_width="@dimen/dp_440"
            android:layout_height="@dimen/dp_94"
            android:src="@mipmap/img_dark_air_up_wind_off"
            android:layout_marginStart="@dimen/dp_19"
            app:layout_constraintStart_toStartOf="@+id/ib_air_defrost_state"
            app:layout_constraintTop_toTopOf="parent"
            app:lottie_loop="true"/>
        <ImageView
            android:id="@+id/iv_mid_ribbon_nothing_to_exit"
            android:layout_width="@dimen/dp_440"
            android:layout_height="@dimen/dp_94"
            android:layout_marginTop="@dimen/dp_94"
            android:src="@mipmap/img_dark_air_middle_wind_off"
            android:layout_marginStart="@dimen/dp_19"
            app:layout_constraintStart_toStartOf="@+id/ib_air_defrost_state"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/iv_mid_particle_nothing_to_exit"
            android:background="@android:color/transparent"
            android:visibility="gone"
            android:layout_width="@dimen/dp_440"
            android:layout_height="@dimen/dp_94"
            android:layout_marginTop="@dimen/dp_94"
            android:layout_marginStart="@dimen/dp_19"
            app:layout_constraintStart_toStartOf="@+id/ib_air_defrost_state"
            app:layout_constraintTop_toTopOf="parent"
            app:lottie_loop="true"/>
        <ImageView
            android:id="@+id/iv_bottom_ribbon_nothing_to_exit"
            android:layout_width="@dimen/dp_440"
            android:layout_height="@dimen/dp_94"
            android:layout_marginTop="@dimen/dp_188"
            android:src="@mipmap/img_dark_air_down_wind_off"
            android:layout_marginStart="@dimen/dp_19"
            app:layout_constraintStart_toStartOf="@+id/ib_air_defrost_state"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/iv_bottom_particle_nothing_to_exit"
            android:background="@android:color/transparent"
            android:visibility="gone"
            android:layout_width="@dimen/dp_440"
            android:layout_height="@dimen/dp_94"
            android:layout_marginTop="@dimen/dp_188"
            android:layout_marginStart="@dimen/dp_19"
            app:layout_constraintStart_toStartOf="@+id/ib_air_defrost_state"
            app:layout_constraintTop_toTopOf="parent"
            app:lottie_loop="true"/>
        <ImageView
            android:id="@+id/ib_air_defrost_state"
            android:background="@mipmap/icon_dark_air_defrost_48"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:layout_marginTop="@dimen/dp_68"
            android:layout_marginStart="@dimen/dp_85"
            android:tintMode="src_in"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/ib_air_wind_blow_face"
            android:background="@mipmap/icon_dark_air_face_48"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:layout_marginStart="@dimen/dp_85"
            android:tintMode="src_in"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ib_air_defrost_state"/>
        <ImageView
            android:id="@+id/ib_air_wind_blow_foot"
            android:background="@mipmap/icon_dark_air_foot_48"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:layout_marginStart="@dimen/dp_85"
            android:tintMode="src_in"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ib_air_wind_blow_face"/>
        <ImageView
            android:id="@+id/iv_air_people"
            android:layout_width="@dimen/dp_263"
            android:layout_height="@dimen/dp_273"
            android:layout_marginTop="@dimen/dp_7"
            android:src="@mipmap/img_dark_air_people_h"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
