<?xml version="1.0" encoding="utf-8"?>
<com.byd.hvac.view.dialog.AcStartVehicleTipsLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/common_dialog_background"
    android:layout_width="@dimen/dp_560"
    android:layout_height="@dimen/dp_312"
    android:layoutDirection="ltr">
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="@color/dialog_common_text_title"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_22"
        android:text="@string/pm2p5_system"
        android:layout_centerHorizontal="true"/>
    <View
        android:id="@+id/divider"
        android:background="@color/dialog_divider_line_color"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_marginTop="@dimen/dp_20"
        android:layout_below="@+id/tv_title"/>
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="@color/dialog_common_text_content"
        android:gravity="center_horizontal"
        android:id="@+id/tv_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_65"
        android:text="@string/green_online_tips"
        android:layout_below="@+id/divider"
        android:layout_centerHorizontal="true"
        android:paddingStart="@dimen/dp_48"
        android:paddingEnd="@dimen/dp_48"/>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_btn_container"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_76"
        android:layout_marginTop="@dimen/dp_55"
        android:layout_below="@+id/tv_content"
        android:layout_centerHorizontal="true">
        <com.byd.hvac.view.dialog.CountDownTimerTextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/dialog_cancle_textcolor"
            android:gravity="center"
            android:id="@+id/tv_yes"
            android:background="@drawable/shape_bg_cancle_radio_button"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_48"
            android:minWidth="@dimen/dp_176"
            android:stateListAnimator="@drawable/anim_btn_alpha"
            app:duration="8"
            app:text="@string/text_cancle"/>
    </LinearLayout>
</com.byd.hvac.view.dialog.AcStartVehicleTipsLayout>
