<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/white"
    android:paddingTop="@dimen/dp_22"
    android:paddingBottom="@dimen/dp_16"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/dp_50"
    android:paddingStart="@dimen/dp_32"
    android:paddingEnd="@dimen/dp_32">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="@dimen/sp_18"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/back"
            android:background="@color/text_air_green_net_fine"
            android:layout_width="@dimen/dp_100"
            android:layout_height="@dimen/dp_40"
            android:text="退出"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_5">
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@android:color/holo_red_light"
                android:textColorHint="@color/gray_middle_text_color"
                android:gravity="center_horizontal"
                android:id="@+id/text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="显示获取的值"
                android:paddingStart="@dimen/dp_15"
                android:paddingEnd="@dimen/dp_15"/>
            <EditText
                android:textSize="@dimen/sp_12"
                android:textColor="@color/black"
                android:textColorHint="@color/gray_middle_text_color"
                android:gravity="center_vertical"
                android:layout_gravity="center_horizontal"
                android:id="@+id/get_edittext1"
                android:layout_width="@dimen/dp_200"
                android:layout_height="@dimen/dp_40"
                android:hint="get接口参数1"/>
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/get_recyclerview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_15"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_5">
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@android:color/holo_red_light"
                android:textColorHint="@color/gray_middle_text_color"
                android:gravity="center_horizontal"
                android:id="@+id/set_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="显示设置的值"
                android:paddingStart="@dimen/dp_15"
                android:paddingEnd="@dimen/dp_15"/>
            <EditText
                android:textSize="@dimen/sp_12"
                android:textColor="@color/black"
                android:textColorHint="@color/gray_middle_text_color"
                android:gravity="center_vertical"
                android:layout_gravity="center_horizontal"
                android:id="@+id/set_edittext1"
                android:layout_width="@dimen/dp_200"
                android:layout_height="@dimen/dp_40"
                android:hint="set接口参数1"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_15">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/set_recyclerview"
                android:paddingBottom="@dimen/dp_50"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/dp_50"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/callback_recyclerview"
                android:paddingBottom="@dimen/dp_50"
                android:layout_width="@dimen/dp_250"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dp_20"/>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
