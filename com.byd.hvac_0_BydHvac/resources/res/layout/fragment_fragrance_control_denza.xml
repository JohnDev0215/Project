<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="@dimen/dp_56"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">
    <com.byd.hvac.view.segmentedbutton.SegmentedButtonGroup
        android:id="@+id/sbg_fragrance_switch"
        android:layout_width="@dimen/dp_440"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_32"
        android:maxHeight="@dimen/dp_65"
        android:minHeight="@dimen/dp_40"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/carsetting_segment_button_group_style">
        <com.byd.hvac.view.segmentedbutton.SegmentedButton
            android:layout_gravity="center"
            android:paddingTop="@dimen/dp_3"
            android:paddingBottom="@dimen/dp_3"
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:sb_text="@string/close"
            app:sb_textColor="@color/fragrance_concentrat_text_unselect_color"
            app:sb_textColor_onSelection="@color/fragrance_concentrat_text_select_color"
            app:sb_textSize="@dimen/sp_20"/>
        <com.byd.hvac.view.segmentedbutton.SegmentedButton
            android:layout_gravity="center"
            android:paddingTop="@dimen/dp_3"
            android:paddingBottom="@dimen/dp_3"
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:sb_text="@string/fragrance_thin"
            app:sb_textColor="@color/fragrance_concentrat_text_unselect_color"
            app:sb_textColor_onSelection="@color/fragrance_concentrat_text_select_color"
            app:sb_textSize="@dimen/sp_20"/>
        <com.byd.hvac.view.segmentedbutton.SegmentedButton
            android:layout_gravity="center"
            android:paddingTop="@dimen/dp_3"
            android:paddingBottom="@dimen/dp_3"
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:sb_text="@string/fragrance_mid"
            app:sb_textColor="@color/fragrance_concentrat_text_unselect_color"
            app:sb_textColor_onSelection="@color/fragrance_concentrat_text_select_color"
            app:sb_textSize="@dimen/sp_20"/>
        <com.byd.hvac.view.segmentedbutton.SegmentedButton
            android:layout_gravity="center"
            android:paddingTop="@dimen/dp_3"
            android:paddingBottom="@dimen/dp_3"
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:sb_text="@string/fragrance_thick"
            app:sb_textColor="@color/fragrance_concentrat_text_unselect_color"
            app:sb_textColor_onSelection="@color/fragrance_concentrat_text_select_color"
            app:sb_textSize="@dimen/sp_20"/>
    </com.byd.hvac.view.segmentedbutton.SegmentedButtonGroup>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/text_tem_gray"
        android:id="@+id/tv_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_43"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sbg_fragrance_switch"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_fragrance_summer_wind_sea_salt"
        android:layout_width="@dimen/dp_300"
        android:layout_height="@dimen/dp_450"
        android:layout_marginTop="@dimen/dp_42"
        app:layout_constraintEnd_toEndOf="@+id/sbg_fragrance_switch"
        app:layout_constraintStart_toStartOf="@+id/sbg_fragrance_switch"
        app:layout_constraintTop_toBottomOf="@+id/sbg_fragrance_switch">
        <ImageView
            android:id="@+id/iv_fragrance_summer_wind_sea_salt"
            android:layout_width="@dimen/dp_300"
            android:layout_height="@dimen/dp_450"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_fragrance_summer_wind_sea_salt_residue"
            android:visibility="gone"
            android:layout_width="@dimen/dp_240"
            android:layout_height="@dimen/dp_380"
            android:src="@mipmap/fragrance_residue_25_0"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_fragrance_summer_wind_sea_salt_bg"
            android:background="@drawable/fragrance_bg_selector_denza"
            android:layout_width="@dimen/dp_300"
            android:layout_height="@dimen/dp_450"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/white"
            android:gravity="center_horizontal"
            android:id="@+id/tv_fragrance_summer_wind_sea_salt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_74"
            android:maxWidth="@dimen/dp_230"
            android:maxLines="2"
            app:layout_constraintBottom_toBottomOf="@+id/iv_fragrance_summer_wind_sea_salt"
            app:layout_constraintEnd_toEndOf="@+id/iv_fragrance_summer_wind_sea_salt"
            app:layout_constraintStart_toStartOf="@+id/iv_fragrance_summer_wind_sea_salt"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/iv_fragrance_summer_wind_sea_salt_animation"
            android:background="@android:color/transparent"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/fragrance_dan"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_fragrance_mountain_rain"
        android:layout_width="@dimen/dp_300"
        android:layout_height="@dimen/dp_450"
        android:layout_marginTop="@dimen/dp_42"
        android:layout_marginEnd="@dimen/dp_12"
        app:layout_constraintEnd_toStartOf="@+id/cl_fragrance_summer_wind_sea_salt"
        app:layout_constraintTop_toBottomOf="@+id/sbg_fragrance_switch">
        <ImageView
            android:id="@+id/iv_fragrance_mountain_rain"
            android:layout_width="@dimen/dp_300"
            android:layout_height="@dimen/dp_450"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_fragrance_mountain_rain_residue"
            android:visibility="gone"
            android:layout_width="@dimen/dp_240"
            android:layout_height="@dimen/dp_380"
            android:src="@mipmap/fragrance_residue_25_0"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_fragrance_mountain_rain_bg"
            android:background="@drawable/fragrance_bg_selector_denza"
            android:layout_width="@dimen/dp_300"
            android:layout_height="@dimen/dp_450"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/white"
            android:gravity="center_horizontal"
            android:id="@+id/tv_fragrance_mountain_rain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_74"
            android:maxWidth="@dimen/dp_230"
            android:maxLines="2"
            app:layout_constraintBottom_toBottomOf="@+id/iv_fragrance_mountain_rain"
            app:layout_constraintEnd_toEndOf="@+id/iv_fragrance_mountain_rain"
            app:layout_constraintStart_toStartOf="@+id/iv_fragrance_mountain_rain"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/iv_fragrance_mountain_rain_animation"
            android:background="@android:color/transparent"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/fragrance_dan"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_fragrance_beautiful"
        android:layout_width="@dimen/dp_300"
        android:layout_height="@dimen/dp_450"
        android:layout_marginTop="@dimen/dp_42"
        android:layout_marginStart="@dimen/dp_12"
        app:layout_constraintStart_toEndOf="@+id/cl_fragrance_summer_wind_sea_salt"
        app:layout_constraintTop_toBottomOf="@+id/sbg_fragrance_switch">
        <ImageView
            android:id="@+id/iv_fragrance_beautiful"
            android:layout_width="@dimen/dp_300"
            android:layout_height="@dimen/dp_450"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_fragrance_beautiful_residue"
            android:visibility="gone"
            android:layout_width="@dimen/dp_240"
            android:layout_height="@dimen/dp_380"
            android:src="@mipmap/fragrance_residue_25_0"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_fragrance_beautiful_bg"
            android:background="@drawable/fragrance_bg_selector_denza"
            android:layout_width="@dimen/dp_300"
            android:layout_height="@dimen/dp_450"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/white"
            android:gravity="center_horizontal"
            android:id="@+id/tv_fragrance_beautiful"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_74"
            android:maxWidth="@dimen/dp_230"
            android:maxLines="2"
            app:layout_constraintBottom_toBottomOf="@+id/iv_fragrance_beautiful"
            app:layout_constraintEnd_toEndOf="@+id/iv_fragrance_beautiful"
            app:layout_constraintStart_toStartOf="@+id/iv_fragrance_beautiful"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/iv_fragrance_beautiful_animation"
            android:background="@android:color/transparent"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/fragrance_dan"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
