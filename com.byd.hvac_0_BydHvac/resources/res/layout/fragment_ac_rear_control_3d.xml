<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">
    <LinearLayout
        android:gravity="center_horizontal"
        android:id="@+id/ll_top_ac_front_control_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_103"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/ib_air_condition_off"
            android:background="@drawable/shape_btn_selector"
            android:layout_width="@dimen/dp_100"
            android:layout_height="@dimen/dp_40"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/ib_air_auto"
            android:background="@drawable/shape_btn_selector"
            android:layout_width="@dimen/dp_100"
            android:layout_height="@dimen/dp_40"
            android:layout_marginStart="@dimen/dp_24"/>
        <com.byd.hvac.view.tintimageview.TintImageView
            android:id="@+id/tv_ac_rear_button_lock"
            android:background="@drawable/shape_btn_selector"
            android:layout_width="@dimen/dp_100"
            android:layout_height="@dimen/dp_40"
            android:src="@mipmap/icon_dark_air_rear_lock"
            android:layout_marginStart="@dimen/dp_24"
            app:color_close_state="@color/btn_close_bg_gray_a"
            app:color_open_state="@color/btn_open_bg_blue"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/sp_24"
        android:textColor="@color/text_brake_and_start_vehicle_color"
        android:id="@+id/tv_tips_start_vehicle"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_33"
        android:text="@string/hvac_brake_and_start_vehicle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_top_ac_front_control_container"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/cl_left_temp_control"
        android:layout_width="@dimen/dp_134"
        android:layout_height="@dimen/dp_319"
        android:layout_marginTop="@dimen/dp_313"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageButton
            android:id="@+id/ib_left_temp_rise"
            android:background="@mipmap/icon_dark_air_temperature_rise_72"
            android:layout_width="@dimen/dp_72"
            android:layout_height="@dimen/dp_72"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.byd.hvac.view.datapickview.WheelView
            android:gravity="center_horizontal"
            android:layout_gravity="center"
            android:id="@+id/left_wheel_view"
            android:layout_width="@dimen/dp_134"
            android:layout_height="@dimen/dp_175"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ib_left_temp_rise"
            app:wh_max_text_size="@dimen/sp_60"
            app:wh_min_text_size="@dimen/sp_32"
            app:wh_selected_text_color="@color/text_tem_white"
            app:wh_text_color="@color/text_tem_gray"
            app:wh_text_space_ratio="2"/>
        <ImageButton
            android:id="@+id/ib_left_temp_reduce"
            android:background="@mipmap/icon_dark_air_temperature_reduction_72"
            android:layout_width="@dimen/dp_72"
            android:layout_height="@dimen/dp_72"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/tv_left_temp_unit"
        android:layout_width="@dimen/dp_26"
        android:layout_height="@dimen/dp_26"
        android:layout_marginTop="@dimen/dp_3"
        android:src="@mipmap/icon_temperature_unit_c"
        android:layout_marginStart="@dimen/dp_100"
        app:layout_constraintBottom_toBottomOf="@+id/cl_left_temp_control"
        app:layout_constraintStart_toStartOf="@+id/cl_left_temp_control"
        app:layout_constraintTop_toTopOf="@+id/cl_left_temp_control"/>
    <ImageView
        android:id="@+id/iv_no_rear_ac_wind_mode"
        android:visibility="gone"
        android:layout_width="@dimen/dp_248"
        android:layout_height="@dimen/dp_250"
        android:src="@mipmap/no_rear_ac_wind_mode"
        app:layout_constraintBottom_toBottomOf="@+id/cl_left_temp_control"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cl_left_temp_control"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/cl_right_temp_control"
        android:layout_width="@dimen/dp_134"
        android:layout_height="@dimen/dp_319"
        app:layout_constraintBottom_toBottomOf="@+id/cl_left_temp_control"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cl_left_temp_control">
        <ImageButton
            android:id="@+id/ib_right_temp_rise"
            android:background="@mipmap/icon_dark_air_temperature_rise_72"
            android:layout_width="@dimen/dp_72"
            android:layout_height="@dimen/dp_72"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.byd.hvac.view.datapickview.WheelView
            android:gravity="center_horizontal"
            android:layout_gravity="center"
            android:id="@+id/right_wheel_view"
            android:layout_width="@dimen/dp_134"
            android:layout_height="@dimen/dp_175"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ib_right_temp_rise"
            app:wh_max_text_size="@dimen/sp_60"
            app:wh_min_text_size="@dimen/sp_32"
            app:wh_selected_text_color="@color/text_tem_white"
            app:wh_text_color="@color/text_tem_gray"
            app:wh_text_space_ratio="2"/>
        <ImageButton
            android:id="@+id/ib_right_temp_reduce"
            android:background="@mipmap/icon_dark_air_temperature_reduction_72"
            android:layout_width="@dimen/dp_72"
            android:layout_height="@dimen/dp_72"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/tv_right_temp_unit"
        android:layout_width="@dimen/dp_26"
        android:layout_height="@dimen/dp_26"
        android:layout_marginTop="@dimen/dp_3"
        android:src="@mipmap/icon_temperature_unit_c"
        android:layout_marginStart="@dimen/dp_100"
        app:layout_constraintBottom_toBottomOf="@+id/cl_right_temp_control"
        app:layout_constraintStart_toStartOf="@+id/cl_right_temp_control"
        app:layout_constraintTop_toTopOf="@+id/cl_right_temp_control"/>
    <RelativeLayout
        android:id="@+id/rl_wind_mode_layout_container"
        android:background="@drawable/mc_shape_btn_selector"
        android:layout_width="@dimen/dp_280"
        android:layout_height="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_781"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/ib_air_wind_blow_face"
            android:background="@mipmap/icon_electric_ac_wind_mode_face"
            android:layout_width="@dimen/dp_40"
            android:layout_height="@dimen/dp_40"
            android:layout_centerInParent="true"
            android:layout_marginStart="@dimen/dp_57"
            android:layout_alignParentStart="true"
            android:tintMode="src_in"/>
        <View
            android:background="@color/mc_wind_mode_divider_color"
            android:layout_width="@dimen/dp_1"
            android:layout_height="@dimen/dp_18"
            android:layout_centerInParent="true"
            android:layout_centerHorizontal="true"/>
        <ImageView
            android:id="@+id/ib_air_wind_blow_foot"
            android:background="@mipmap/icon_electric_ac_wind_mode_foot"
            android:layout_width="@dimen/dp_40"
            android:layout_height="@dimen/dp_40"
            android:layout_marginEnd="@dimen/dp_57"
            android:layout_alignParentEnd="true"
            android:tintMode="src_in"/>
    </RelativeLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_air_wind_level_container"
        android:layout_width="@dimen/dp_504"
        android:layout_height="@dimen/dp_60"
        android:layout_marginTop="@dimen/dp_845"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/ib_air_level_small"
            android:layout_width="@dimen/dp_60"
            android:layout_height="@dimen/dp_60"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.byd.hvac.view.WindLevelButton
            android:id="@+id/sb_air_wind_level"
            android:layout_width="@dimen/dp_380"
            android:layout_height="@dimen/dp_34"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ib_air_level_small"
            app:layout_constraintTop_toTopOf="parent"
            app:maxLevel="7"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/ib_air_level_big"
            android:layout_width="@dimen/dp_60"
            android:layout_height="@dimen/dp_60"
            android:layout_marginStart="@dimen/dp_3"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/sb_air_wind_level"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
