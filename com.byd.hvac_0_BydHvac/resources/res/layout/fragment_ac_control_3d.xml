<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/dp_16"
    android:layoutDirection="ltr">
    <FrameLayout
        android:id="@+id/car_bg_3d_layout"
        android:layout_width="@dimen/dp_720"
        android:layout_height="@dimen/dp_405"
        android:layout_marginTop="@dimen/dp_308"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_22"
        android:textColor="@color/text_tem_white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_double_click_to_operate"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_197"
        android:maxWidth="@dimen/dp_500"
        android:text="@string/electric_tuyere_double_click_to_operate"
        android:maxLines="2"
        app:layout_constraintBottom_toTopOf="@+id/car_bg_3d_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.google.android.material.tabs.TabLayout
        android:layout_gravity="center"
        android:id="@+id/tl_ac_control"
        android:background="@null"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tabIndicatorColor="@color/left_bar_btn_text_color_s"
        app:tabSelectedTextColor="@color/left_bar_btn_text_color_s"
        app:tabTextColor="@color/left_bar_btn_text_color_n"
        style="@style/tablayout_style"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vp_ac_control"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
