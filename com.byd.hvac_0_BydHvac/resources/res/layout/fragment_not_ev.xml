<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="@dimen/dp_70"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="top|center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/rl_tab_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_102">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ll_ac_control_container"
            android:layout_width="@dimen/dp_128"
            android:layout_height="@dimen/dp_102"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/iv_ac_control_bg"
                android:layout_width="@dimen/dp_128"
                android:layout_height="@dimen/dp_96"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/iv_ac_control"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:src="@mipmap/icon_air_conditioning_module"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/cc_left_bar_btn_text_selector"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:id="@+id/tv_ac_control"
                android:layout_width="@dimen/dp_128"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:maxLines="2"
                android:lineSpacingMultiplier="0.85"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iv_ac_control"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ll_seat_control_container"
            android:layout_width="@dimen/dp_128"
            android:layout_height="@dimen/dp_102"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/iv_seat_control_bg"
                android:layout_width="@dimen/dp_128"
                android:layout_height="@dimen/dp_96"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/iv_seat_control"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/cc_left_bar_btn_text_selector"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:id="@+id/tv_seat_control"
                android:layout_width="@dimen/dp_128"
                android:layout_height="wrap_content"
                android:text="@string/seat_heat_ventilation"
                android:maxLines="2"
                android:lineSpacingMultiplier="0.85"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iv_seat_control"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ll_green_control_container"
            android:layout_width="@dimen/dp_128"
            android:layout_height="@dimen/dp_102"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/iv_green_control_bg"
                android:layout_width="@dimen/dp_128"
                android:layout_height="@dimen/dp_96"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/iv_green_control"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:src="@mipmap/icon_green_clean"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/cc_left_bar_btn_text_selector"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:id="@+id/tv_green_control"
                android:layout_width="@dimen/dp_128"
                android:layout_height="wrap_content"
                android:text="@string/green"
                android:maxLines="2"
                android:lineSpacingMultiplier="0.85"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iv_green_control"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ll_fragrance_control_container"
            android:layout_width="@dimen/dp_128"
            android:layout_height="@dimen/dp_102"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/iv_fragrance_control_bg"
                android:layout_width="@dimen/dp_128"
                android:layout_height="@dimen/dp_96"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/iv_fragrance_control"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:src="@mipmap/icon_fragrance"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/cc_left_bar_btn_text_selector"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:id="@+id/tv_fragrance_control"
                android:layout_width="@dimen/dp_128"
                android:layout_height="wrap_content"
                android:text="@string/fragrance"
                android:maxLines="2"
                android:lineSpacingMultiplier="0.85"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iv_fragrance_control"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ll_set_control_container"
            android:layout_width="@dimen/dp_128"
            android:layout_height="@dimen/dp_102"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/iv_set_control_bg"
                android:layout_width="@dimen/dp_128"
                android:layout_height="@dimen/dp_96"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/iv_set_control"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:src="@mipmap/icon_set_up"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/cc_left_bar_btn_text_selector"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:id="@+id/tv_set_control"
                android:layout_width="@dimen/dp_128"
                android:layout_height="wrap_content"
                android:text="@string/set"
                android:maxLines="2"
                android:lineSpacingMultiplier="0.85"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iv_set_control"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/cc_right_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/rl_tab_container"/>
</RelativeLayout>
