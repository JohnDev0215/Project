<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:background="@drawable/dialog_main_bg"
    android:layout_width="590dp"
    android:layout_height="339dp">
    <TextView
        android:textSize="20sp"
        android:textColor="@color/battery_text"
        android:gravity="center"
        android:id="@+id/battery_tv_title"
        android:layout_width="512dp"
        android:layout_height="29dp"
        android:layout_marginTop="22dp"
        android:text="@string/battery_title"
        android:layout_marginStart="22dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/tv_line"
        android:background="@drawable/common_dialog_line"
        android:layout_width="556dp"
        android:layout_height="1dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="18dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/battery_tv_title"/>
    <LinearLayout
        android:id="@+id/battery_ll"
        android:layout_width="match_parent"
        android:layout_height="135dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_line">
        <TextView
            android:textSize="20sp"
            android:textColor="@color/battery_text"
            android:gravity="center_horizontal"
            android:id="@+id/battery_tv_message"
            android:layout_width="420dp"
            android:layout_height="87dp"
            android:layout_marginTop="16dp"
            android:text="@string/battery_message"
            android:fontFamily="sans-serif"
            android:layout_marginStart="80dp"/>
    </LinearLayout>
    <Button
        android:textSize="18sp"
        android:textColor="@color/btn_ok_font"
        android:id="@+id/battery_btn"
        android:background="@drawable/dialog_positive_btn_bg"
        android:layout_width="176dp"
        android:layout_height="48dp"
        android:layout_marginTop="15dp"
        android:text="@string/btn_ok"
        android:layout_marginStart="192dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/battery_ll"/>
</androidx.constraintlayout.widget.ConstraintLayout>
