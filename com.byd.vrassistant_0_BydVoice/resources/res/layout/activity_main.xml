<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingBottom="80dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="0dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Spinner
                android:textSize="40dp"
                android:id="@+id/language"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:spinnerMode="dropdown"/>
            <Button
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_gravity="left"
                android:id="@+id/appevent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="appevent"
                android:layout_below="@+id/language"/>
            <Spinner
                android:textSize="40dp"
                android:id="@+id/voice_zone"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_below="@+id/appevent"
                android:spinnerMode="dropdown"/>
            <Button
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_gravity="left"
                android:id="@+id/dialogcancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="cancel"
                android:layout_below="@+id/appevent"/>
            <Button
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_gravity="left"
                android:id="@+id/cartype"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GetCarType"
                android:layout_below="@+id/appevent"/>
            <Button
                android:textSize="20dp"
                android:textColor="@color/white"
                android:id="@+id/light"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="light"/>
            <Button
                android:textSize="20dp"
                android:textColor="@color/white"
                android:id="@+id/dark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="dark"/>
            <Button
                android:textSize="20dp"
                android:textColor="@color/white"
                android:id="@+id/left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="left"/>
            <Button
                android:textSize="20dp"
                android:textColor="@color/white"
                android:id="@+id/right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="german"/>
            <Button
                android:textSize="15dp"
                android:textColor="@color/white"
                android:layout_gravity="left"
                android:id="@+id/phone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:text="PHONE"
                android:layout_toRightOf="@+id/dialogcancel"
                android:layout_below="@+id/appevent"/>
            <Button
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_gravity="left"
                android:id="@+id/prompter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="prompt"
                android:layout_below="@+id/dialogcancel"/>
            <Button
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_gravity="left"
                android:id="@+id/stop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="stop"
                android:layout_below="@+id/prompter"/>
            <Button
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_gravity="left"
                android:id="@+id/ac"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:text="AC"
                android:layout_toRightOf="@+id/stop"
                android:layout_below="@+id/prompter"/>
            <Button
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_gravity="left"
                android:id="@+id/musicstop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="musicstop"
                android:layout_below="@+id/stop"/>
            <Button
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_gravity="left"
                android:id="@+id/musicplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="musicplay"
                android:layout_below="@+id/musicstop"/>
            <Button
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_gravity="left"
                android:id="@+id/spotifyplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="spotifyplay"
                android:layout_below="@+id/musicplay"/>
            <Button
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_gravity="left"
                android:id="@+id/spotifystop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="spotifystop"
                android:layout_below="@+id/spotifyplay"/>
            <Button
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_gravity="left"
                android:id="@+id/spotifypause"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="spotifypause"
                android:layout_below="@+id/spotifystop"/>
            <Button
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_gravity="left"
                android:id="@+id/spotifyopen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="spotifyopen"
                android:layout_below="@+id/spotifypause"/>
            <Button
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_gravity="left"
                android:id="@+id/spotifydestroy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="spotifydestroy"
                android:layout_below="@+id/spotifyopen"/>
            <Button
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_gravity="left"
                android:id="@+id/spotifyadd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="spotifyadd"
                android:layout_below="@+id/spotifydestroy"/>
            <Button
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_gravity="left"
                android:id="@+id/spotifyremove"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="spotifyremove"
                android:layout_below="@+id/spotifyadd"/>
            <Button
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_gravity="left"
                android:id="@+id/spotifyrepeat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="spotifyrepeat"
                android:layout_below="@+id/spotifyremove"/>
            <Button
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_gravity="left"
                android:id="@+id/spotifyshuffle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="spotifyshuffle"
                android:layout_below="@+id/spotifyremove"/>
            <Button
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_gravity="left"
                android:id="@+id/spotifynext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="spotifynext"
                android:layout_below="@+id/spotifyshuffle"/>
            <Button
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_gravity="left"
                android:id="@+id/spotifyprev"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="spotifyprev"
                android:layout_below="@+id/spotifynext"/>
            <Button
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_gravity="left"
                android:id="@+id/volumnup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="volumnup"
                android:layout_below="@+id/spotifyprev"/>
            <Button
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_gravity="left"
                android:id="@+id/volumndown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="volumndown"
                android:layout_below="@+id/volumnup"/>
            <Button
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_gravity="left"
                android:id="@+id/mute"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="mute"
                android:layout_below="@+id/volumndown"/>
            <Button
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_gravity="left"
                android:id="@+id/bootguide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="bootguide"
                android:layout_below="@+id/mute"/>
            <Button
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_gravity="left"
                android:id="@+id/gears_r"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="gears_r"
                android:layout_below="@+id/bootguide"/>
            <Button
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_gravity="left"
                android:id="@+id/gears_auto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="gears_auto"
                android:layout_below="@+id/gears_r"/>
            <Button
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_gravity="left"
                android:id="@+id/home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="home"
                android:layout_below="@+id/gears_auto"/>
            <Button
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_gravity="left"
                android:id="@+id/unmute"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="unmute"
                android:layout_below="@+id/home"/>
            <Button
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_gravity="left"
                android:id="@+id/openvoice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="openvoice"
                android:layout_below="@+id/unmute"/>
            <Button
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_gravity="left"
                android:id="@+id/closevoice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="closevoice"
                android:layout_below="@+id/openvoice"/>
            <Button
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_gravity="left"
                android:id="@+id/subwuw"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="subwuw"
                android:layout_below="@+id/closevoice"/>
            <Button
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_gravity="left"
                android:id="@+id/shortcut"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="shortcut"
                android:layout_below="@+id/subwuw"/>
            <Button
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_gravity="left"
                android:id="@+id/delshort"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="delshort"
                android:layout_below="@+id/shortcut"/>
            <Button
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_gravity="left"
                android:id="@+id/opencdr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="opencdr"
                android:layout_below="@+id/delshort"/>
            <Button
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_gravity="left"
                android:id="@+id/searchmedia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="searchmedia"
                android:layout_below="@+id/opencdr"/>
            <Button
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_gravity="left"
                android:id="@+id/playusb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="playusb"
                android:layout_below="@+id/searchmedia"/>
            <Button
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_gravity="left"
                android:id="@+id/getmeida"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="getmeida"
                android:layout_below="@+id/playusb"/>
            <Button
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_gravity="left"
                android:id="@+id/openusb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="openusb"
                android:layout_below="@+id/getmeida"/>
            <Button
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_gravity="left"
                android:id="@+id/openbt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="openbt"
                android:layout_below="@+id/openusb"/>
            <Button
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_gravity="left"
                android:id="@+id/help"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="help"
                android:layout_below="@+id/openbt"/>
            <Button
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_gravity="left"
                android:id="@+id/killApp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="killApp"
                android:layout_below="@+id/help"/>
            <Button
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_gravity="left"
                android:id="@+id/getVolumeTest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="getVolumeTest"
                android:layout_below="@+id/killApp"/>
            <Button
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_gravity="left"
                android:id="@+id/onLowMemory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="onLowMemory"
                android:layout_below="@+id/killApp"/>
            <Button
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_gravity="left"
                android:id="@+id/amazon_browser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="amazon_browser"
                android:layout_below="@+id/onLowMemory"/>
            <Button
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_gravity="left"
                android:id="@+id/amazon_play"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="amazon_play"
                android:layout_below="@+id/amazon_browser"/>
            <Button
                android:textSize="20dp"
                android:textColor="@color/white"
                android:layout_gravity="left"
                android:id="@+id/amazon_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="amazon_search"
                android:layout_below="@+id/amazon_play"/>
        </LinearLayout>
    </ScrollView>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="200dp">
        <TextView
            android:textSize="12dp"
            android:textColor="@color/white"
            android:layout_gravity="center"
            android:id="@+id/test_msg"
            android:scrollbars="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="hello world!\10"
            android:singleLine="false"/>
    </ScrollView>
</RelativeLayout>
