<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_net_err"
        android:layout_width="312dp"
        android:layout_height="209dp"
        android:src="@mipmap/img_net_err"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/px_24"
        android:id="@+id/tv_net_err"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="@string/net_connect_tips"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_net_err"/>
    <TextView
        android:textSize="@dimen/px_24"
        android:gravity="center"
        android:id="@+id/btn_go_setting"
        android:layout_width="144dp"
        android:layout_height="40dp"
        android:layout_marginTop="@dimen/px_24"
        android:layout_marginBottom="@dimen/px_36"
        android:text="@string/net_connect"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_net_err"/>
</androidx.constraintlayout.widget.ConstraintLayout>
