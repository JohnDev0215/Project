<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_prog"
    android:background="#60000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/pb_bg"
        android:background="@drawable/usb_copy_pb_pop"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.55"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="1"/>
    <TextView
        android:textSize="30sp"
        android:textColor="#ffffffff"
        android:id="@+id/tx_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="30dp"
        android:maxLines="1"
        app:layout_constraintLeft_toLeftOf="@+id/pb_bg"
        app:layout_constraintRight_toRightOf="@+id/pb_bg"
        app:layout_constraintTop_toTopOf="@+id/pb_bg"/>
    <TextView
        android:textSize="24sp"
        android:textColor="#ffffffff"
        android:ellipsize="start"
        android:id="@+id/tx_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="16dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:textAlignment="textStart"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tx_state"/>
    <ProgressBar
        android:id="@+id/pb_copy"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="70dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="70dp"
        android:progressDrawable="@drawable/usb_pb_bar"
        app:layout_constraintLeft_toLeftOf="@+id/pb_bg"
        app:layout_constraintRight_toRightOf="@+id/pb_bg"
        app:layout_constraintTop_toBottomOf="@+id/tx_title"
        style="@android:style/Widget.ProgressBar.Horizontal"/>
    <TextView
        android:textSize="28sp"
        android:textColor="#ffffffff"
        android:ellipsize="marquee"
        android:id="@+id/tx_state2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginRight="30dp"
        android:layout_marginBottom="40dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:textAlignment="textStart"
        app:layout_constraintBottom_toBottomOf="@+id/pb_bg"
        app:layout_constraintEnd_toEndOf="@+id/pb_bg"
        app:layout_constraintStart_toStartOf="@+id/pb_bg"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_start"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tx_title,pb_copy,tx_state2"/>
    <Button
        android:id="@+id/bt_start"
        android:background="@drawable/bg_usb_btn"
        android:layout_width="200dp"
        android:layout_height="50dp"
        android:layout_marginTop="80dp"
        android:layout_marginRight="100dp"
        android:text="start"
        app:layout_constraintBottom_toBottomOf="@+id/pb_bg"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toLeftOf="@+id/pb_bg"
        app:layout_constraintRight_toLeftOf="@+id/bt_cancel"
        app:layout_constraintTop_toTopOf="@+id/pb_bg"/>
    <Button
        android:id="@+id/bt_cancel"
        android:background="@drawable/bg_usb_btn"
        android:layout_width="200dp"
        android:layout_height="50dp"
        android:layout_marginLeft="100dp"
        android:layout_marginTop="80dp"
        android:text="cancel"
        app:layout_constraintBottom_toBottomOf="@+id/pb_bg"
        app:layout_constraintLeft_toRightOf="@+id/bt_start"
        app:layout_constraintRight_toRightOf="@+id/pb_bg"
        app:layout_constraintTop_toTopOf="@+id/pb_bg"/>
</androidx.constraintlayout.widget.ConstraintLayout>
