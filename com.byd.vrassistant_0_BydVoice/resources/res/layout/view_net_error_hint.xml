<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/px_24"
        android:textColor="#45a2ff"
        android:id="@+id/tv_net_error_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/px_12"
        android:layout_marginBottom="@dimen/px_36"
        android:text="@string/net_connect_tips"
        android:scrollHorizontally="false"
        android:layout_marginStart="@dimen/px_36"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="328dp"/>
    <com.byd.vrassistant.base.DirectionAwareImageView
        android:id="@+id/iv_arrow"
        android:layout_width="@dimen/px_36"
        android:layout_height="@dimen/px_36"
        android:src="@mipmap/icon_right_arrow"
        android:layout_marginEnd="@dimen/px_36"
        app:layout_constraintBottom_toBottomOf="@+id/tv_net_error_hint"
        app:layout_constraintStart_toEndOf="@+id/tv_net_error_hint"
        app:layout_constraintTop_toTopOf="@+id/tv_net_error_hint"/>
</androidx.constraintlayout.widget.ConstraintLayout>
