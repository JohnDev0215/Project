<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/cl_voice_bar_list"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="@dimen/px_473">
    <TextView
        android:textSize="@dimen/px_21"
        android:gravity="center"
        android:id="@+id/tv_result_from"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/px_6"
        android:text="@string/result_from"
        android:includeFontPadding="false"
        android:drawableRight="@drawable/info"
        android:drawablePadding="@dimen/px_6"
        android:layout_marginStart="@dimen/px_36"
        android:lineHeight="@dimen/px_30"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:layout_gravity="center_horizontal"
        android:id="@+id/rv_voice_bar_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/px_8"
        android:layout_marginStart="@dimen/px_36"
        android:layout_marginEnd="@dimen/px_36"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_result_from"
        app:layout_goneMarginTop="@dimen/px_13"/>
    <ImageView
        android:id="@+id/iv_img"
        android:layout_width="@dimen/px_72"
        android:layout_height="@dimen/px_72"
        android:layout_marginTop="@dimen/px_36"
        android:layout_marginBottom="@dimen/px_24"
        android:src="@mipmap/iv_voice_img"
        android:layout_marginStart="@dimen/px_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rv_voice_bar_list"/>
    <TextView
        android:textSize="@dimen/text_24"
        android:textColor="@color/tv_voice_btn"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_first"
        android:background="@mipmap/bg_voice_btn"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/px_42"
        android:minWidth="@dimen/px_108"
        android:text="@string/text_first"
        android:maxLines="1"
        android:fontFamily="@font/robotoregular14"
        android:layout_marginStart="@dimen/px_8"
        app:layout_constraintBottom_toBottomOf="@+id/iv_img"
        app:layout_constraintStart_toEndOf="@+id/iv_img"
        app:layout_constraintTop_toTopOf="@+id/iv_img"/>
    <TextView
        android:textSize="@dimen/text_24"
        android:textColor="@color/tv_voice_btn"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_next"
        android:background="@mipmap/bg_voice_btn"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/px_42"
        android:minWidth="@dimen/px_108"
        android:text="@string/text_next"
        android:maxLines="1"
        android:singleLine="true"
        android:fontFamily="@font/robotoregular14"
        android:layout_marginStart="@dimen/px_18"
        app:layout_constraintBottom_toBottomOf="@+id/iv_img"
        app:layout_constraintStart_toEndOf="@+id/tv_first"
        app:layout_constraintTop_toTopOf="@+id/iv_img"/>
    <TextView
        android:textSize="@dimen/text_24"
        android:textColor="@color/tv_voice_btn"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_exit"
        android:background="@mipmap/bg_voice_btn"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/px_42"
        android:minWidth="@dimen/px_108"
        android:text="@string/text_exit"
        android:maxLines="1"
        android:singleLine="true"
        android:fontFamily="@font/robotoregular14"
        android:layout_marginStart="@dimen/px_18"
        app:layout_constraintBottom_toBottomOf="@+id/iv_img"
        app:layout_constraintStart_toEndOf="@+id/tv_next"
        app:layout_constraintTop_toTopOf="@+id/iv_img"/>
    <TextView
        android:textSize="@dimen/text_24"
        android:textColor="@color/tv_page_num"
        android:gravity="end|center_vertical"
        android:layout_gravity="center"
        android:id="@+id/tv_page"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="@font/robotoregular14"
        android:layout_marginEnd="@dimen/px_36"
        app:layout_constraintBottom_toBottomOf="@+id/iv_img"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_img"/>
    <TextView
        android:textSize="@dimen/text_30"
        android:textColor="@color/tv_first_next_exit"
        android:gravity="center"
        android:id="@+id/btn_ok"
        android:background="@mipmap/bg_ok"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/px_42"
        android:minWidth="@dimen/px_192"
        android:text="@string/text_ok"
        android:maxLines="1"
        android:singleLine="true"
        android:fontFamily="@font/robotoregular14"
        android:layout_marginStart="@dimen/px_28"
        app:layout_constraintBottom_toBottomOf="@+id/iv_img"
        app:layout_constraintStart_toEndOf="@+id/iv_img"
        app:layout_constraintTop_toTopOf="@+id/iv_img"/>
    <TextView
        android:textSize="@dimen/text_30"
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/btn_cancel"
        android:background="@mipmap/bg_cancel"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/px_42"
        android:layout_marginLeft="@dimen/px_36"
        android:minWidth="@dimen/px_192"
        android:text="@string/text_cancel"
        android:maxLines="1"
        android:singleLine="true"
        android:fontFamily="@font/robotoregular14"
        app:layout_constraintBottom_toBottomOf="@+id/iv_img"
        app:layout_constraintStart_toEndOf="@+id/btn_ok"
        app:layout_constraintTop_toTopOf="@+id/iv_img"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_three"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tv_exit,tv_first,tv_next,tv_page"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_two"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="btn_cancel,btn_ok"/>
</androidx.constraintlayout.widget.ConstraintLayout>
