<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/view_weather"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/weather_bg_big"
        android:layout_width="@dimen/px_600"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/today_weather"
        app:layout_constraintCircleRadius="@dimen/px_12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/weather_bg_small"
        android:visibility="gone"
        android:layout_width="@dimen/px_600"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/view_line"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/location_Image"
        android:layout_width="@dimen/px_36"
        android:layout_height="@dimen/px_36"
        android:layout_marginTop="@dimen/px_8"
        android:src="@mipmap/weather_location"
        android:layout_marginStart="@dimen/px_28"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/px_21"
        android:textColor="@color/list_text_85_light"
        android:id="@+id/location_name"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/px_32"
        android:layout_marginTop="@dimen/px_4"
        android:layout_marginStart="@dimen/px_6"
        app:layout_constraintBottom_toBottomOf="@+id/location_Image"
        app:layout_constraintStart_toEndOf="@+id/location_Image"/>
    <View
        android:id="@+id/view_line_vertical"
        android:background="#b3262d33"
        android:layout_width="2px"
        android:layout_height="@dimen/px_18"
        android:layout_marginStart="@dimen/px_13"
        app:layout_constraintBottom_toBottomOf="@+id/location_name"
        app:layout_constraintStart_toEndOf="@+id/location_name"
        app:layout_constraintTop_toTopOf="@+id/location_name"/>
    <TextView
        android:textSize="@dimen/px_21"
        android:textColor="@color/list_text_85_light"
        android:id="@+id/weather_date"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/px_36"
        android:layout_marginStart="@dimen/px_13"
        android:layout_marginEnd="@dimen/px_36"
        app:layout_constraintBaseline_toBaselineOf="@+id/location_name"
        app:layout_constraintStart_toEndOf="@+id/view_line_vertical"/>
    <ImageView
        android:id="@+id/weather_image"
        android:layout_width="@dimen/px_118"
        android:layout_height="@dimen/px_118"
        app:layout_constraintBottom_toBottomOf="@+id/hours_weather"
        app:layout_constraintEnd_toEndOf="@+id/weather_bg_big"
        app:layout_constraintStart_toEndOf="@+id/hours_weather"
        app:layout_constraintTop_toTopOf="@+id/hours_weather"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_temp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/px_8"
        app:layout_constraintBottom_toTopOf="@+id/weather_name"
        app:layout_constraintStart_toStartOf="@+id/location_Image"
        app:layout_constraintTop_toTopOf="@+id/hours_weather"
        app:layout_constraintVertical_chainStyle="packed">
        <TextView
            android:textSize="@dimen/px_60"
            android:textColor="#30353b"
            android:gravity="center_horizontal"
            android:id="@+id/tv_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/px_60"
            android:textColor="#30353b"
            android:id="@+id/tv_temp_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/tv_temp"
            app:layout_constraintLeft_toRightOf="@+id/tv_temp"
            app:layout_constraintTop_toTopOf="@+id/tv_temp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="@dimen/px_21"
        android:textColor="@color/list_text_70_light"
        android:gravity="center_horizontal"
        android:id="@+id/weather_name"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:minHeight="44dp"
        app:layout_constraintBottom_toBottomOf="@+id/hours_weather"
        app:layout_constraintEnd_toEndOf="@+id/cl_temp"
        app:layout_constraintStart_toStartOf="@+id/cl_temp"
        app:layout_constraintTop_toBottomOf="@+id/cl_temp"/>
    <View
        android:id="@+id/view_line"
        android:background="#121f2326"
        android:layout_width="0dp"
        android:layout_height="1.5px"
        android:layout_marginTop="@dimen/px_24"
        android:layout_marginEnd="@dimen/px_4"
        app:layout_constraintBottom_toBottomOf="@+id/weather_name"
        app:layout_constraintEnd_toEndOf="@+id/weather_image"
        app:layout_constraintStart_toStartOf="@+id/cl_temp"
        app:layout_constraintTop_toBottomOf="@+id/hours_weather"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/today_weather"
        android:paddingBottom="@dimen/px_24"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/px_24"
        app:layout_constraintEnd_toEndOf="@+id/view_line"
        app:layout_constraintStart_toStartOf="@+id/view_line"
        app:layout_constraintTop_toBottomOf="@+id/view_line">
        <androidx.constraintlayout.widget.Group
            android:id="@+id/one_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="weather_One_bg,weekOne,weekOneDate,weekOneImage,weekOneName"/>
        <View
            android:id="@+id/weather_One_bg"
            android:background="@drawable/bg_weather_today_bg"
            android:layout_width="@dimen/px_132"
            android:layout_height="@dimen/px_231"
            app:layout_constraintBottom_toBottomOf="@+id/weekOneName"
            app:layout_constraintCircleRadius="@dimen/px_12"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/weekOne"/>
        <TextView
            android:textSize="@dimen/px_18"
            android:textColor="@color/list_text_55_light"
            android:gravity="center"
            android:id="@+id/weekOne"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/px_27"
            android:layout_marginTop="@dimen/px_12"
            android:text="@string/weather_today"
            app:layout_constraintEnd_toEndOf="@+id/weather_One_bg"
            app:layout_constraintStart_toStartOf="@+id/weather_One_bg"
            app:layout_constraintTop_toTopOf="@+id/weather_One_bg"/>
        <TextView
            android:textSize="@dimen/px_18"
            android:textColor="@color/list_text_55_light"
            android:gravity="center"
            android:id="@+id/weekOneDate"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/px_27"
            android:text="--/--"
            app:layout_constraintEnd_toEndOf="@+id/weekOne"
            app:layout_constraintStart_toStartOf="@+id/weekOne"
            app:layout_constraintTop_toBottomOf="@+id/weekOne"/>
        <ImageView
            android:id="@+id/weekOneImage"
            android:layout_width="@dimen/px_55"
            android:layout_height="@dimen/px_53"
            android:layout_marginTop="@dimen/px_21"
            app:layout_constraintEnd_toEndOf="@+id/weekOne"
            app:layout_constraintStart_toStartOf="@+id/weekOne"
            app:layout_constraintTop_toBottomOf="@+id/weekOneDate"/>
        <TextView
            android:textSize="@dimen/px_18"
            android:textColor="@color/list_text_55_light"
            android:id="@+id/weekOneWeather"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/px_8"
            android:textAlignment="center"
            app:layout_constraintEnd_toEndOf="@+id/weekOneImage"
            app:layout_constraintStart_toStartOf="@+id/weekOneImage"
            app:layout_constraintTop_toBottomOf="@+id/weekOneImage"/>
        <TextView
            android:textSize="@dimen/px_18"
            android:textColor="@color/list_text_70_light"
            android:id="@+id/weekOneName"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/px_36"
            android:layout_marginTop="@dimen/px_6"
            android:textAlignment="center"
            app:layout_constraintEnd_toEndOf="@+id/weekOneImage"
            app:layout_constraintStart_toStartOf="@+id/weekOneImage"
            app:layout_constraintTop_toBottomOf="@+id/weekOneWeather"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/two_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="weather_Two_bg,weekTwo,weekTwoDate,weekTwoImage,weekTwoName"/>
        <View
            android:id="@+id/weather_Two_bg"
            android:layout_width="@dimen/px_132"
            android:layout_height="@dimen/px_231"
            app:layout_constraintBottom_toBottomOf="@+id/weather_One_bg"
            app:layout_constraintCircleRadius="@dimen/px_12"
            app:layout_constraintEnd_toStartOf="@+id/weather_Three_bg"
            app:layout_constraintStart_toEndOf="@+id/weather_One_bg"
            app:layout_constraintTop_toTopOf="@+id/weather_One_bg"/>
        <TextView
            android:textSize="@dimen/px_18"
            android:textColor="@color/list_text_55_light"
            android:gravity="center"
            android:id="@+id/weekTwo"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/px_27"
            android:layout_marginTop="@dimen/px_12"
            app:layout_constraintEnd_toEndOf="@+id/weather_Two_bg"
            app:layout_constraintStart_toStartOf="@+id/weather_Two_bg"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/px_18"
            android:textColor="@color/list_text_55_light"
            android:gravity="center"
            android:id="@+id/weekTwoDate"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/px_27"
            app:layout_constraintEnd_toEndOf="@+id/weekTwo"
            app:layout_constraintStart_toStartOf="@+id/weekTwo"
            app:layout_constraintTop_toBottomOf="@+id/weekTwo"/>
        <ImageView
            android:id="@+id/weekTwoImage"
            android:layout_width="@dimen/px_55"
            android:layout_height="@dimen/px_53"
            android:layout_marginTop="@dimen/px_21"
            app:layout_constraintEnd_toEndOf="@+id/weekTwo"
            app:layout_constraintStart_toStartOf="@+id/weekTwo"
            app:layout_constraintTop_toBottomOf="@+id/weekTwoDate"/>
        <TextView
            android:textSize="@dimen/px_18"
            android:textColor="@color/list_text_55_light"
            android:id="@+id/weekTwoWeather"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/px_8"
            android:textAlignment="center"
            app:layout_constraintEnd_toEndOf="@+id/weekTwoImage"
            app:layout_constraintStart_toStartOf="@+id/weekTwoImage"
            app:layout_constraintTop_toBottomOf="@+id/weekTwoImage"/>
        <TextView
            android:textSize="@dimen/px_18"
            android:textColor="@color/list_text_70_light"
            android:id="@+id/weekTwoName"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/px_36"
            android:layout_marginTop="@dimen/px_6"
            android:textAlignment="center"
            app:layout_constraintEnd_toEndOf="@+id/weekTwoImage"
            app:layout_constraintStart_toStartOf="@+id/weekTwoImage"
            app:layout_constraintTop_toBottomOf="@+id/weekTwoWeather"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/three_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="weather_Three_bg,weekThree,weekThreeDate,weekThreeImage,weekThreeName"/>
        <View
            android:id="@+id/weather_Three_bg"
            android:layout_width="@dimen/px_132"
            android:layout_height="@dimen/px_231"
            app:layout_constraintBottom_toBottomOf="@+id/weather_One_bg"
            app:layout_constraintCircleRadius="@dimen/px_12"
            app:layout_constraintEnd_toStartOf="@+id/weather_Four_bg"
            app:layout_constraintStart_toEndOf="@+id/weather_Two_bg"
            app:layout_constraintTop_toTopOf="@+id/weather_One_bg"/>
        <TextView
            android:textSize="@dimen/px_18"
            android:textColor="@color/list_text_55_light"
            android:gravity="center"
            android:id="@+id/weekThree"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/px_27"
            android:layout_marginTop="@dimen/px_12"
            app:layout_constraintEnd_toEndOf="@+id/weather_Three_bg"
            app:layout_constraintStart_toStartOf="@+id/weather_Three_bg"
            app:layout_constraintTop_toTopOf="@+id/weather_One_bg"/>
        <TextView
            android:textSize="@dimen/px_18"
            android:textColor="@color/list_text_55_light"
            android:gravity="center"
            android:id="@+id/weekThreeDate"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/px_27"
            app:layout_constraintEnd_toEndOf="@+id/weekThree"
            app:layout_constraintStart_toStartOf="@+id/weekThree"
            app:layout_constraintTop_toBottomOf="@+id/weekThree"/>
        <ImageView
            android:id="@+id/weekThreeImage"
            android:layout_width="@dimen/px_55"
            android:layout_height="@dimen/px_53"
            android:layout_marginTop="@dimen/px_21"
            app:layout_constraintEnd_toEndOf="@+id/weekThree"
            app:layout_constraintStart_toStartOf="@+id/weekThree"
            app:layout_constraintTop_toBottomOf="@+id/weekThreeDate"/>
        <TextView
            android:textSize="@dimen/px_18"
            android:textColor="@color/list_text_55_light"
            android:id="@+id/weekThreeWeather"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/px_8"
            android:textAlignment="center"
            app:layout_constraintEnd_toEndOf="@+id/weekThree"
            app:layout_constraintStart_toStartOf="@+id/weekThree"
            app:layout_constraintTop_toBottomOf="@+id/weekThreeImage"/>
        <TextView
            android:textSize="@dimen/px_18"
            android:textColor="@color/list_text_70_light"
            android:id="@+id/weekThreeName"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/px_36"
            android:layout_marginTop="@dimen/px_6"
            android:textAlignment="center"
            app:layout_constraintEnd_toEndOf="@+id/weekThree"
            app:layout_constraintStart_toStartOf="@+id/weekThree"
            app:layout_constraintTop_toBottomOf="@+id/weekThreeWeather"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/four_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="weather_Four_bg,weekFour,weekFourDate,weekFourImage,weekFourName"/>
        <View
            android:id="@+id/weather_Four_bg"
            android:layout_width="@dimen/px_132"
            android:layout_height="@dimen/px_231"
            app:layout_constraintBottom_toBottomOf="@+id/weather_One_bg"
            app:layout_constraintCircleRadius="@dimen/px_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/weather_Three_bg"
            app:layout_constraintTop_toTopOf="@+id/weather_One_bg"/>
        <TextView
            android:textSize="@dimen/px_18"
            android:textColor="@color/list_text_55_light"
            android:gravity="center"
            android:id="@+id/weekFour"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/px_27"
            android:layout_marginTop="@dimen/px_12"
            app:layout_constraintEnd_toEndOf="@+id/weather_Four_bg"
            app:layout_constraintStart_toStartOf="@+id/weather_Four_bg"
            app:layout_constraintTop_toTopOf="@+id/weather_One_bg"/>
        <TextView
            android:textSize="@dimen/px_18"
            android:textColor="@color/list_text_55_light"
            android:gravity="center"
            android:id="@+id/weekFourDate"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/px_27"
            app:layout_constraintEnd_toEndOf="@+id/weekFour"
            app:layout_constraintStart_toStartOf="@+id/weekFour"
            app:layout_constraintTop_toBottomOf="@+id/weekFour"/>
        <ImageView
            android:id="@+id/weekFourImage"
            android:layout_width="@dimen/px_55"
            android:layout_height="@dimen/px_53"
            android:layout_marginTop="@dimen/px_18"
            app:layout_constraintEnd_toEndOf="@+id/weekFour"
            app:layout_constraintStart_toStartOf="@+id/weekFour"
            app:layout_constraintTop_toBottomOf="@+id/weekFourDate"/>
        <TextView
            android:textSize="@dimen/px_18"
            android:textColor="@color/list_text_55_light"
            android:id="@+id/weekFourWeather"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/px_8"
            android:textAlignment="center"
            app:layout_constraintEnd_toEndOf="@+id/weekFour"
            app:layout_constraintStart_toStartOf="@+id/weekFour"
            app:layout_constraintTop_toBottomOf="@+id/weekFourImage"/>
        <TextView
            android:textSize="@dimen/px_18"
            android:textColor="@color/list_text_70_light"
            android:id="@+id/weekFourName"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/px_36"
            android:layout_marginTop="@dimen/px_6"
            android:textAlignment="center"
            app:layout_constraintEnd_toEndOf="@+id/weekFour"
            app:layout_constraintStart_toStartOf="@+id/weekFour"
            app:layout_constraintTop_toBottomOf="@+id/weekFourWeather"/>
        <ImageView
            android:id="@+id/UV_image"
            android:visibility="gone"
            android:layout_width="@dimen/px_48"
            android:layout_height="@dimen/px_48"
            android:layout_marginTop="@dimen/px_24"
            android:layout_marginStart="@dimen/px_38"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/weekOneName"/>
        <TextView
            android:textSize="@dimen/px_30"
            android:textColor="#30353b"
            android:id="@+id/UV_index"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/px_36"
            android:layout_marginTop="@dimen/px_30"
            android:text="@string/weather_UV_index"
            android:layout_marginStart="@dimen/px_12"
            app:layout_constraintStart_toEndOf="@+id/UV_image"
            app:layout_constraintTop_toBottomOf="@+id/today_weather"/>
        <TextView
            android:textSize="@dimen/px_30"
            android:textStyle="bold"
            android:textColor="#30353b"
            android:id="@+id/today_UV_value"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/px_30"
            android:layout_marginStart="@dimen/px_6"
            app:layout_constraintStart_toEndOf="@+id/UV_index"
            app:layout_constraintTop_toBottomOf="@+id/weekOneName"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/hours_weather"
        android:visibility="visible"
        android:layout_width="@dimen/px_210"
        android:layout_height="@dimen/px_156"
        android:layout_marginTop="@dimen/px_27"
        app:layout_constraintEnd_toStartOf="@+id/weather_image"
        app:layout_constraintStart_toEndOf="@+id/cl_temp"
        app:layout_constraintTop_toBottomOf="@+id/location_name">
        <ImageView
            android:id="@+id/hours_UV"
            android:layout_width="@dimen/px_40"
            android:layout_height="@dimen/px_40"
            android:src="@mipmap/weatheruv48x48"
            app:layout_constraintBottom_toTopOf="@+id/hours_Wind"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="spread_inside"/>
        <TextView
            android:textSize="@dimen/px_21"
            android:textColor="@color/list_text_70_light"
            android:gravity="center_vertical"
            android:id="@+id/hours_UV_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/weather_UV_index"
            android:layout_marginStart="@dimen/px_27"
            app:layout_constraintBottom_toBottomOf="@+id/hours_UV"
            app:layout_constraintStart_toEndOf="@+id/hours_UV"
            app:layout_constraintTop_toTopOf="@+id/hours_UV"/>
        <TextView
            android:textSize="@dimen/px_21"
            android:textStyle="bold"
            android:textColor="@color/list_text_light"
            android:gravity="center_vertical"
            android:id="@+id/hours_UV_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:layout_marginStart="@dimen/px_12"
            app:layout_constraintBottom_toBottomOf="@+id/hours_UV"
            app:layout_constraintStart_toEndOf="@+id/hours_UV_text"
            app:layout_constraintTop_toTopOf="@+id/hours_UV"/>
        <ImageView
            android:id="@+id/hours_Wind"
            android:layout_width="@dimen/px_40"
            android:layout_height="@dimen/px_40"
            android:src="@mipmap/weatherwind48x48"
            app:layout_constraintBottom_toTopOf="@+id/hours_Humi"
            app:layout_constraintEnd_toEndOf="@+id/hours_UV"
            app:layout_constraintStart_toStartOf="@+id/hours_UV"
            app:layout_constraintTop_toBottomOf="@+id/hours_UV"/>
        <TextView
            android:textSize="@dimen/px_21"
            android:textColor="@color/list_text_70_light"
            android:gravity="center_vertical"
            android:id="@+id/hours_wind_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/weather_wind"
            app:layout_constraintBottom_toBottomOf="@+id/hours_Wind"
            app:layout_constraintStart_toStartOf="@+id/hours_UV_text"
            app:layout_constraintTop_toTopOf="@+id/hours_Wind"/>
        <TextView
            android:textSize="@dimen/px_21"
            android:textStyle="bold"
            android:textColor="@color/list_text_light"
            android:gravity="center_vertical"
            android:id="@+id/hours_wind_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:layout_marginStart="@dimen/px_12"
            app:layout_constraintBottom_toBottomOf="@+id/hours_Wind"
            app:layout_constraintStart_toEndOf="@+id/hours_wind_text"
            app:layout_constraintTop_toTopOf="@+id/hours_Wind"/>
        <ImageView
            android:id="@+id/hours_Humi"
            android:layout_width="@dimen/px_40"
            android:layout_height="@dimen/px_40"
            android:src="@mipmap/weatherhumidity48x48"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/hours_UV"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/hours_Wind"/>
        <TextView
            android:textSize="@dimen/px_21"
            android:textColor="@color/list_text_70_light"
            android:gravity="center_vertical"
            android:id="@+id/hours_Humi_text"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/px_36"
            android:text="@string/weather_Humidity"
            app:layout_constraintBottom_toBottomOf="@+id/hours_Humi"
            app:layout_constraintStart_toStartOf="@+id/hours_UV_text"
            app:layout_constraintTop_toTopOf="@+id/hours_Humi"/>
        <TextView
            android:textSize="@dimen/px_21"
            android:textStyle="bold"
            android:textColor="@color/list_text_70_light"
            android:gravity="center_vertical"
            android:id="@+id/hours_Humi_value"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/px_36"
            android:maxLines="2"
            android:layout_marginStart="@dimen/px_12"
            app:layout_constraintBottom_toBottomOf="@+id/hours_Humi"
            app:layout_constraintStart_toEndOf="@+id/hours_Humi_text"
            app:layout_constraintTop_toTopOf="@+id/hours_Humi"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
