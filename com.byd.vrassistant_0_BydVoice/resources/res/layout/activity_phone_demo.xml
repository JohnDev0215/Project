<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <Button
        android:id="@+id/btn_loadState"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="20dp"
        android:text="通信录同步状态接口"/>
    <Button
        android:id="@+id/btn_contact_data"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="20dp"
        android:text="获取联系人数据接口"/>
    <Button
        android:id="@+id/btn_calllog_data"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="20dp"
        android:text="获取通话记录数据接口"/>
    <Button
        android:id="@+id/btn_openBTPhone"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="20dp"
        android:text="打开蓝牙电话"/>
    <Button
        android:id="@+id/btn_openBTPhoneSearch"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="20dp"
        android:text="打开联系人查找页面"/>
    <Button
        android:id="@+id/btn_openBTPhoneConTacts"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="20dp"
        android:text="打开联系人列表页面"/>
    <Button
        android:id="@+id/btn_openBTPhoneAllHistory"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="20dp"
        android:text="打开通话记录页面"/>
    <Button
        android:id="@+id/btn_openBTPhoneMissHistory"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="20dp"
        android:text="打开未接来电页面"/>
    <Button
        android:id="@+id/btn_dial"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="20dp"
        android:text="拨打电话接口"/>
    <Button
        android:id="@+id/btn_hungup"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="20dp"
        android:text="挂断电话接口"/>
    <Button
        android:id="@+id/btn_accept"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="20dp"
        android:text="接听电话接口"/>
    <Button
        android:id="@+id/btn_enable"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="20dp"
        android:text="蓝牙打开、关闭状态"/>
    <Button
        android:id="@+id/btn_searchdevice"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="20dp"
        android:text="蓝牙启动、停止搜索"/>
    <Button
        android:id="@+id/btn_connectionState"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="20dp"
        android:text="蓝牙链接状态"/>
    <Button
        android:id="@+id/btn_openbluebooth"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="20dp"
        android:text="打开蓝牙"/>
    <Button
        android:id="@+id/btn_openblueboothSet"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="20dp"
        android:text="打开蓝牙配对弹窗"/>
    <Button
        android:id="@+id/btn_blueboothConnect"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="20dp"
        android:text="蓝牙设备是否连接"/>
    <Button
        android:id="@+id/btn_blueboothSearch"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="20dp"
        android:text="搜索蓝牙"/>
    <Button
        android:id="@+id/btn_phoneConnectState"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="20dp"
        android:text="判断电话音频开关是否打开"/>
</LinearLayout>
