<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/constraint_layout"
    android:layout_width="@dimen/px_600"
    android:layout_height="wrap_content"
    android:maxWidth="@dimen/px_600"
    android:animateLayoutChanges="true">
    <com.byd.vrassistant.view.IvTaiji
        android:id="@+id/iv_taiji"
        android:padding="@dimen/px_4"
        android:layout_width="@dimen/px_72"
        android:layout_height="@dimen/px_72"
        android:src="@drawable/anim_taiji_normal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.byd.vrassistant.view.IvWave
        android:id="@+id/iv_txt_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/px_10"
        app:layout_constraintBottom_toBottomOf="@+id/iv_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.byd.vrassistant.view.VrTextView
        android:textSize="@dimen/px_28"
        android:textColor="@color/voice_bar_text"
        android:ellipsize="marquee"
        android:gravity="start"
        android:id="@+id/tv_input"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="@dimen/px_399"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:singleLine="true"
        android:marqueeRepeatLimit="marquee_forever"
        android:fontFamily="@font/robotoregular14"
        app:layout_constraintBottom_toBottomOf="@+id/iv_taiji"
        app:layout_constraintStart_toEndOf="@+id/iv_taiji"
        app:layout_constraintTop_toTopOf="@+id/iv_taiji"/>
    <ImageView
        android:id="@+id/iv_notice"
        android:layout_width="@dimen/px_36"
        android:layout_height="@dimen/px_36"
        android:src="@mipmap/icon_audio_left_top_light"
        android:layout_marginEnd="@dimen/px_15"
        app:layout_constraintBottom_toBottomOf="@+id/iv_taiji"
        app:layout_constraintEnd_toStartOf="@+id/view_divider"
        app:layout_constraintTop_toTopOf="@+id/iv_taiji"/>
    <View
        android:id="@+id/view_divider"
        android:background="@color/view_divider"
        android:layout_width="2px"
        android:layout_height="@dimen/px_18"
        app:layout_constraintBottom_toBottomOf="@+id/iv_taiji"
        app:layout_constraintEnd_toStartOf="@+id/iv_close"
        app:layout_constraintTop_toTopOf="@+id/iv_taiji"/>
    <ImageView
        android:id="@+id/iv_close"
        android:padding="@dimen/px_16"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:layout_width="@dimen/px_72"
        android:layout_height="@dimen/px_72"
        android:src="@drawable/icon_close_light"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/v_click"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_response"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.byd.vrassistant.view.ResTextView
        android:textSize="@dimen/px_24"
        android:textColor="@color/voice_bar_text_85"
        android:ellipsize="end"
        android:id="@+id/tv_response"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/px_8"
        android:maxLines="2"
        android:fontFamily="@font/robotoregular14"
        android:layout_marginStart="@dimen/px_36"
        android:layout_marginEnd="@dimen/px_36"
        android:lineHeight="@dimen/px_36"
        app:layout_constraintBottom_toTopOf="@+id/fl_net_err"
        app:layout_constraintTop_toBottomOf="@+id/iv_taiji"
        app:layout_goneMarginBottom="@dimen/px_40"/>
    <FrameLayout
        android:id="@+id/fl_net_err"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/fl_container"
        app:layout_constraintTop_toBottomOf="@+id/tv_response"
        app:layout_goneMarginTop="@dimen/px_24"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/fl_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fl_net_err"
        app:layout_goneMarginTop="@dimen/px_8"/>
</androidx.constraintlayout.widget.ConstraintLayout>
