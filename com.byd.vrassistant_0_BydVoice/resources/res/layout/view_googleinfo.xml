<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bg_gi"
    android:background="@color/bg_pop"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/bg_dialog"
        android:background="@mipmap/bg_dialog"
        android:layout_width="@dimen/px_864"
        android:layout_height="@dimen/px_636"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_default="wrap"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/px_30"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/px_40"
        android:text="@string/g_title"
        android:lineHeight="@dimen/px_45"
        app:layout_constraintEnd_toEndOf="@+id/bg_dialog"
        app:layout_constraintStart_toStartOf="@+id/bg_dialog"
        app:layout_constraintTop_toTopOf="@+id/bg_dialog"/>
    <View
        android:id="@+id/v_divider"
        android:background="@color/v_g_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/px_118"
        android:layout_marginStart="@dimen/px_12"
        android:layout_marginEnd="@dimen/px_12"
        app:layout_constraintEnd_toEndOf="@+id/bg_dialog"
        app:layout_constraintStart_toStartOf="@+id/bg_dialog"
        app:layout_constraintTop_toTopOf="@+id/bg_dialog"/>
    <TextView
        android:textSize="30px"
        android:gravity="center_vertical"
        android:id="@+id/tv_content"
        android:layout_width="@dimen/px_696"
        android:layout_height="0dp"
        android:text="@string/g_content"
        android:layout_marginStart="@dimen/px_54"
        android:layout_marginEnd="@dimen/px_54"
        android:lineHeight="35px"
        app:layout_constraintBottom_toTopOf="@+id/v_bg_ok"
        app:layout_constraintEnd_toEndOf="@+id/bg_dialog"
        app:layout_constraintStart_toStartOf="@+id/bg_dialog"
        app:layout_constraintTop_toBottomOf="@+id/v_divider"
        app:layout_constraintWidth_default="wrap"/>
    <View
        android:id="@+id/v_bg_ok"
        android:background="@drawable/bg_ok"
        android:layout_width="@dimen/px_312"
        android:layout_height="@dimen/px_72"
        android:layout_marginBottom="@dimen/px_56"
        android:layout_marginStart="@dimen/px_84"
        app:layout_constraintBottom_toBottomOf="@+id/bg_dialog"
        app:layout_constraintStart_toStartOf="@+id/bg_dialog"/>
    <TextView
        android:textSize="@dimen/px_36"
        android:textColor="@color/tv_g_ok"
        android:gravity="center"
        android:id="@+id/tv_ok"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/g_ok"
        android:lineHeight="@dimen/px_42"
        app:layout_constraintBottom_toBottomOf="@+id/v_bg_ok"
        app:layout_constraintEnd_toEndOf="@+id/v_bg_ok"
        app:layout_constraintStart_toStartOf="@+id/v_bg_ok"
        app:layout_constraintTop_toTopOf="@+id/v_bg_ok"/>
    <View
        android:id="@+id/v_bg_more"
        android:background="@drawable/bg_more"
        android:layout_width="@dimen/px_312"
        android:layout_height="@dimen/px_72"
        android:layout_marginBottom="@dimen/px_56"
        android:layout_marginEnd="@dimen/px_84"
        app:layout_constraintBottom_toBottomOf="@+id/bg_dialog"
        app:layout_constraintEnd_toEndOf="@+id/bg_dialog"/>
    <TextView
        android:textSize="@dimen/px_36"
        android:textColor="@color/tv_g_more"
        android:gravity="center"
        android:id="@+id/tv_more"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/g_more"
        android:lineHeight="@dimen/px_42"
        app:layout_constraintBottom_toBottomOf="@+id/v_bg_more"
        app:layout_constraintEnd_toEndOf="@+id/v_bg_more"
        app:layout_constraintStart_toStartOf="@+id/v_bg_more"
        app:layout_constraintTop_toTopOf="@+id/v_bg_more"/>
</androidx.constraintlayout.widget.ConstraintLayout>
