<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_item"
    android:layout_width="@dimen/px_528"
    android:layout_height="@dimen/px_111">
    <View
        android:id="@+id/v_num_bg"
        android:background="@mipmap/bg_list_num"
        android:layout_width="@dimen/px_27"
        android:layout_height="@dimen/px_21"
        android:layout_marginTop="@dimen/px_31"
        android:layout_marginStart="@dimen/px_24"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/px_21"
        android:textColor="@color/tv_page_num"
        android:gravity="center"
        android:id="@+id/tv_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/robotoregular14"
        android:layout_alignParentStart="true"
        app:layout_constraintBottom_toBottomOf="@+id/v_num_bg"
        app:layout_constraintEnd_toEndOf="@+id/v_num_bg"
        app:layout_constraintStart_toStartOf="@+id/v_num_bg"
        app:layout_constraintTop_toTopOf="@+id/v_num_bg"/>
    <com.byd.vrassistant.view.MarqueeTxtView
        android:textSize="@dimen/text_27"
        android:textColor="@color/tv_list_top"
        android:ellipsize="marquee"
        android:gravity="start"
        android:id="@+id/tv_top"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/px_19"
        android:singleLine="true"
        android:fontFamily="@font/robotoregular14"
        android:layout_marginStart="@dimen/px_63"
        android:layout_marginEnd="@dimen/px_24"
        android:lineHeight="@dimen/px_42"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/px_21"
        android:textColor="@color/tv_list_bot"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tv_bottom"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/px_19"
        android:singleLine="true"
        android:layout_below="@+id/tv_top"
        android:fontFamily="@font/robotoregular14"
        android:layout_marginStart="@dimen/px_63"
        android:lineHeight="@dimen/px_30"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_end"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="@dimen/text_27"
        android:textColor="@color/tv_list_bot"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/px_19"
        android:singleLine="true"
        android:fontFamily="@font/robotoregular14"
        android:layout_marginEnd="@dimen/px_24"
        android:lineHeight="@dimen/px_36"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <View
        android:background="@color/view_divider_list"
        android:layout_width="@dimen/px_480"
        android:layout_height="2px"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
