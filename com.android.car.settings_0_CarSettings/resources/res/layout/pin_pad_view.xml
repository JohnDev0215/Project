<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <Button
        android:id="@+id/key1"
        android:tag="1"
        android:layout_width="@dimen/pin_pad_key_width"
        android:layout_height="@dimen/pin_pad_key_height"
        android:layout_margin="@dimen/pin_pad_key_margin"
        android:text="@string/one"
        style="@style/PinPadKey"/>
    <Button
        android:id="@+id/key2"
        android:tag="2"
        android:layout_width="@dimen/pin_pad_key_width"
        android:layout_height="@dimen/pin_pad_key_height"
        android:layout_margin="@dimen/pin_pad_key_margin"
        android:text="@string/two"
        style="@style/PinPadKey"/>
    <Button
        android:id="@+id/key3"
        android:tag="3"
        android:layout_width="@dimen/pin_pad_key_width"
        android:layout_height="@dimen/pin_pad_key_height"
        android:layout_margin="@dimen/pin_pad_key_margin"
        android:text="@string/three"
        style="@style/PinPadKey"/>
    <Button
        android:id="@+id/key4"
        android:tag="4"
        android:layout_width="@dimen/pin_pad_key_width"
        android:layout_height="@dimen/pin_pad_key_height"
        android:layout_margin="@dimen/pin_pad_key_margin"
        android:text="@string/four"
        style="@style/PinPadKey"/>
    <Button
        android:id="@+id/key5"
        android:tag="5"
        android:layout_width="@dimen/pin_pad_key_width"
        android:layout_height="@dimen/pin_pad_key_height"
        android:layout_margin="@dimen/pin_pad_key_margin"
        android:text="@string/five"
        style="@style/PinPadKey"/>
    <Button
        android:id="@+id/key6"
        android:tag="6"
        android:layout_width="@dimen/pin_pad_key_width"
        android:layout_height="@dimen/pin_pad_key_height"
        android:layout_margin="@dimen/pin_pad_key_margin"
        android:text="@string/six"
        style="@style/PinPadKey"/>
    <Button
        android:id="@+id/key7"
        android:tag="7"
        android:layout_width="@dimen/pin_pad_key_width"
        android:layout_height="@dimen/pin_pad_key_height"
        android:layout_margin="@dimen/pin_pad_key_margin"
        android:text="@string/seven"
        style="@style/PinPadKey"/>
    <Button
        android:id="@+id/key8"
        android:tag="8"
        android:layout_width="@dimen/pin_pad_key_width"
        android:layout_height="@dimen/pin_pad_key_height"
        android:layout_margin="@dimen/pin_pad_key_margin"
        android:text="@string/eight"
        style="@style/PinPadKey"/>
    <Button
        android:id="@+id/key9"
        android:tag="9"
        android:layout_width="@dimen/pin_pad_key_width"
        android:layout_height="@dimen/pin_pad_key_height"
        android:layout_margin="@dimen/pin_pad_key_margin"
        android:text="@string/nine"
        style="@style/PinPadKey"/>
    <ImageButton
        android:id="@+id/key_backspace"
        android:layout_width="@dimen/pin_pad_key_width"
        android:layout_height="@dimen/pin_pad_key_height"
        android:layout_margin="@dimen/pin_pad_key_margin"
        android:src="@drawable/ic_backspace"
        android:contentDescription="@string/backspace_key"
        style="@style/PinPadKey"/>
    <Button
        android:id="@+id/key0"
        android:tag="0"
        android:layout_width="@dimen/pin_pad_key_width"
        android:layout_height="@dimen/pin_pad_key_height"
        android:layout_margin="@dimen/pin_pad_key_margin"
        android:text="@string/zero"
        style="@style/PinPadKey"/>
    <ImageButton
        android:id="@+id/key_enter"
        android:layout_width="@dimen/pin_pad_key_width"
        android:layout_height="@dimen/pin_pad_key_height"
        android:layout_margin="@dimen/pin_pad_key_margin"
        android:src="@drawable/ic_check"
        android:contentDescription="@string/enter_key"
        style="@style/PinPadKey"/>
</merge>
