    <string name="Registration.Agreement">אני מבין ומסכים שסטינגריי תשלח את מידע הרישום של המוצר הזה, כולל המידע האישי שלי, לשותפה, חברת Singing Machine.</string>
    <string name="Registration.AgreementError">לפני שתמשיך, אתה חייב להסכים שהמידע הזה ישותף בין סטינגריי לחברת Singing Machine.</string>
