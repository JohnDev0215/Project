<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content"
    android:tag="layout-port/activity_notification_0"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="18dp">
    <TextView
        android:textSize="24sp"
        android:textColor="@color/text_color_title"
        android:gravity="center_vertical"
        android:id="@+id/tv_msg"
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        android:text="@string/notification_msg"
        android:layout_marginStart="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="20sp"
        android:textColor="@color/text_color_sub_title"
        android:gravity="center_vertical"
        android:id="@+id/tv_manage"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        android:text="@string/personal_main_manage"
        android:drawableEnd="@drawable/ic_more"
        android:paddingStart="16dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rvParent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_clear_msg"
        app:layout_constraintTop_toBottomOf="@+id/tv_msg">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_msg"
            android:tag="binding_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="32dp"
            android:overScrollMode="never"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginBottom="100dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_empty_msg"
        android:tag="binding_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="542dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="28sp"
            android:textColor="@color/no_msg"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/personal_main_no_msg"/>
    </LinearLayout>
    <ImageView
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tv_clear_msg"
        android:tag="binding_4"
        android:background="@drawable/bg_clear_msg"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginBottom="66dp"
        android:src="@drawable/ic_delete_all_msg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/rvParent"
        app:layout_constraintStart_toStartOf="@+id/rvParent"/>
    <View
        android:background="@drawable/bg_bottom_close"
        android:layout_width="34dp"
        android:layout_height="4dp"
        android:layout_marginBottom="33dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
