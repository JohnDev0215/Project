<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/item_view"
    android:tag="layout/item_notify_msg_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="190dp">
    <View
        android:id="@+id/top_margin"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="7dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/msg_item_body"
        android:tag="binding_2"
        android:background="@drawable/bg_msg_item"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp">
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_icon"
            android:tag="binding_3"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/roundedCornerStyle4"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/color_text_content"
            android:id="@+id/tv_pkg_name"
            android:tag="binding_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            app:layout_constraintBottom_toBottomOf="@+id/iv_icon"
            app:layout_constraintStart_toEndOf="@+id/iv_icon"
            app:layout_constraintTop_toTopOf="@+id/iv_icon"/>
        <TextView
            android:textSize="20sp"
            android:textColor="@color/color_text_second"
            android:id="@+id/tv_title"
            android:tag="binding_5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:singleLine="true"
            android:layout_marginStart="2dp"
            app:layout_constraintStart_toStartOf="@+id/iv_icon"
            app:layout_constraintTop_toBottomOf="@+id/iv_icon"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/color_text_content"
            android:id="@+id/tv_time"
            android:tag="binding_6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/iv_icon"
            app:layout_constraintStart_toEndOf="@+id/tv_pkg_name"
            app:layout_constraintTop_toTopOf="@+id/iv_icon"/>
        <ImageView
            android:id="@+id/iv_switch"
            android:tag="binding_7"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_time"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_time"
            app:tint="@color/color_text_second"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/color_text_content"
            android:id="@+id/tv_content"
            android:tag="binding_8"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="1dp"
            android:maxEms="24"
            android:singleLine="true"
            android:layout_marginStart="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/tv_title"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
        <ProgressBar
            android:id="@+id/pb_progress_bar"
            android:tag="binding_9"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:progressDrawable="@drawable/msg_progress_drawable"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_content"
            app:layout_constraintEnd_toEndOf="@+id/tv_content"
            app:layout_constraintStart_toStartOf="@+id/tv_content"
            app:layout_constraintTop_toTopOf="@+id/tv_content"
            style="?android:attr/progressBarStyleHorizontal"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/bottom_margin"
        android:tag="binding_10"
        android:layout_width="match_parent"
        android:layout_height="7dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</LinearLayout>
