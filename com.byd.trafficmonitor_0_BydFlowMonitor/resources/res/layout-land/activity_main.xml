<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_WaveView_bg"
        android:layout_width="@dimen/dp_208"
        android:layout_height="@dimen/dp_208"
        android:layout_marginTop="@dimen/dp_48"
        android:src="@drawable/img_dark_personal_housekeeper_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.byd.trafficmonitor.view.FlowDataView
        android:id="@+id/flow_view"
        android:layout_width="@dimen/dp_192"
        android:layout_height="@dimen/dp_192"
        android:layout_marginTop="@dimen/dp_56"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="@color/flow_sub_title_color"
        android:id="@+id/tv_today_use"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_26"
        android:text="@string/flow_today_use"
        android:includeFontPadding="false"
        android:layout_marginEnd="@dimen/dp_119"
        app:layout_constraintEnd_toStartOf="@+id/iv_WaveView_bg"
        app:layout_constraintTop_toBottomOf="@+id/iv_WaveView_bg"/>
    <com.byd.trafficmonitor.widget.MultiSizeTextView
        android:textSize="@dimen/sp_36"
        android:id="@+id/current_day_used_flow_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_6"
        android:text="--"
        app:layout_constraintEnd_toEndOf="@+id/tv_today_use"
        app:layout_constraintStart_toStartOf="@+id/tv_today_use"
        app:layout_constraintTop_toBottomOf="@+id/tv_today_use"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="@color/flow_sub_title_color"
        android:id="@+id/tv_month_use"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_26"
        android:text="@string/flow_month_use"
        android:includeFontPadding="false"
        app:layout_constraintEnd_toEndOf="@+id/iv_WaveView_bg"
        app:layout_constraintStart_toStartOf="@+id/iv_WaveView_bg"
        app:layout_constraintTop_toBottomOf="@+id/iv_WaveView_bg"/>
    <com.byd.trafficmonitor.widget.MultiSizeTextView
        android:textSize="@dimen/sp_36"
        android:id="@+id/current_month_used_flow_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_6"
        android:text="--"
        app:layout_constraintEnd_toEndOf="@+id/tv_month_use"
        app:layout_constraintStart_toStartOf="@+id/tv_month_use"
        app:layout_constraintTop_toBottomOf="@+id/tv_month_use"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="@color/flow_sub_title_color"
        android:id="@+id/tv_total_use"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_26"
        android:text="@string/flow_month_total"
        android:includeFontPadding="false"
        android:layout_marginStart="@dimen/dp_108"
        app:layout_constraintStart_toEndOf="@+id/iv_WaveView_bg"
        app:layout_constraintTop_toBottomOf="@+id/iv_WaveView_bg"/>
    <com.byd.trafficmonitor.widget.MultiSizeTextView
        android:textSize="@dimen/sp_36"
        android:id="@+id/current_total_flow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_6"
        android:text="--"
        app:layout_constraintEnd_toEndOf="@+id/tv_total_use"
        app:layout_constraintStart_toStartOf="@+id/tv_total_use"
        app:layout_constraintTop_toBottomOf="@+id/tv_total_use"/>
    <ImageView
        android:background="@color/flow_divider_color"
        android:layout_width="@dimen/dp_1"
        android:layout_height="@dimen/dp_72"
        android:layout_marginTop="@dimen/dp_291"
        android:layout_marginStart="@dimen/dp_500"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:background="@color/flow_divider_color"
        android:layout_width="@dimen/dp_1"
        android:layout_height="@dimen/dp_72"
        android:layout_marginTop="@dimen/dp_291"
        android:layout_marginEnd="@dimen/dp_520"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatButton
        android:textSize="@dimen/sp_18"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/btn_flow_usage"
        android:background="@drawable/flow_common_sure_btn_bg"
        android:layout_width="@dimen/dp_240"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_418"
        android:text="@string/flow_quxiang"
        android:textAllCaps="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/flow_date_text_tip_color"
        android:id="@+id/tv_flow_des"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_570"
        android:text="@string/flow_5g_des"
        android:includeFontPadding="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
