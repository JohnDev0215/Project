<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:id="@+id/ll_dialog_masks"
    android:background="@color/base_dialog_masks"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:alpha="0">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/cl_dialog_container"
        android:background="@drawable/bg_frame_dialog_gradient"
        android:clickable="true"
        android:layout_width="@dimen/dp_560"
        android:layout_height="@dimen/dp_340"
        android:alpha="0"
        android:scaleX="0.9"
        android:scaleY="0.9">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textStyle="bold"
            android:textColor="@color/common_dialog_title"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_22"
            android:layout_marginBottom="@dimen/dp_20"
            android:text="@string/text_privacy_title"
            android:maxLines="1"/>
        <View
            android:background="@color/flow_divider_color"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"/>
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/common_dialog_title"
            android:layout_width="@dimen/dp_464"
            android:layout_height="@dimen/dp_100"
            android:layout_marginTop="@dimen/dp_35"
            android:text="@string/smarttravel_privacy"/>
        <Button
            android:textSize="@dimen/sp_18"
            android:textColor="@color/white"
            android:layout_gravity="center"
            android:id="@+id/btn_ok"
            android:background="@drawable/shape_bg_blue_button"
            android:layout_width="@dimen/dp_176"
            android:layout_height="@dimen/dp_48"
            android:layout_marginTop="@dimen/dp_65"
            android:text="@string/text_ok"
            android:stateListAnimator="@animator/pressed_state_list"/>
    </LinearLayout>
</LinearLayout>
