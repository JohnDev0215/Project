<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rcrl_root_layout"
    android:background="@drawable/dialog_corn8"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/common_dialog_title"
            android:gravity="center"
            android:id="@+id/tv_dialog_title"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_12"
            android:layout_marginTop="@dimen/dp_22"
            android:layout_marginRight="@dimen/dp_12"
            android:layout_marginBottom="@dimen/dp_20"
            android:layout_centerHorizontal="true"/>
        <View
            android:id="@+id/divider_line"
            android:background="@color/common_dialog_divider_line"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:layout_below="@+id/tv_dialog_title"/>
        <LinearLayout
            android:id="@+id/ll_dialog_center_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/divider_line">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/common_dialog_title"
                android:gravity="center"
                android:id="@+id/tv_dialog_message"
                android:paddingLeft="@dimen/dp_18"
                android:paddingTop="@dimen/dp_10"
                android:paddingRight="@dimen/dp_18"
                android:paddingBottom="@dimen/dp_10"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:lineSpacingExtra="@dimen/dp_3"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/ll_dialog_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_70"
            android:layout_marginBottom="@dimen/dp_28"
            android:layout_below="@+id/ll_dialog_center_group">
            <TextView
                android:textSize="@dimen/sp_15"
                android:textColor="@color/dialog_sure_btn_text"
                android:gravity="center"
                android:id="@+id/tv_dialog_confirm"
                android:background="@drawable/common_dialog_gray_btn_bg"
                android:layout_width="@dimen/dp_176"
                android:layout_height="@dimen/dp_48"
                android:text="@string/common_dialog_btn_ok"/>
            <View
                android:id="@+id/divider_view"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_1"/>
            <TextView
                android:textSize="@dimen/sp_15"
                android:textColor="@color/common_dialog_cancel_btn"
                android:gravity="center"
                android:id="@+id/tv_dialog_cancel"
                android:background="@drawable/common_dialog_gray_btn_bg"
                android:layout_width="@dimen/dp_176"
                android:layout_height="@dimen/dp_48"
                android:text="@string/common_dialog_btn_cancel"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/iv_dialog_close"
            android:visibility="gone"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:layout_marginLeft="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_12"
            android:src="@drawable/icon_public_close"
            android:layout_alignParentLeft="true"/>
    </RelativeLayout>
</RelativeLayout>
