<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/app_common_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.byd.trafficmonitor.widget.CustomToolBar
        android:id="@+id/tb_pro"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/protocol_title"
        style="@style/NoSpaceToolbar"/>
    <androidx.core.widget.NestedScrollView
        android:scrollbarStyle="outsideInset"
        android:id="@+id/scrollview"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_68"
        android:layout_marginRight="@dimen/dp_40"
        android:layout_marginBottom="@dimen/dp_26"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tb_pro">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:paddingBottom="@dimen/dp_135"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/protocol_text_color"
                android:id="@+id/tv_protocol"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_40"
                android:layout_marginTop="@dimen/dp_70"
                app:layout_constraintTop_toBottomOf="@+id/tv_protocol">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_check"
                    android:layout_width="@dimen/dp_40"
                    android:layout_height="match_parent"
                    android:src="@mipmap/icon_uncheck_protocol"
                    app:layout_constraintLeft_toLeftOf="parent"/>
                <TextView
                    android:textSize="@dimen/sp_18"
                    android:textColor="@color/protocol_text_color"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/protocol_agree_tip"
                    android:includeFontPadding="false"
                    android:layout_marginStart="-7dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@+id/iv_check"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <Button
        android:textSize="@dimen/sp_18"
        android:textColor="@color/protocol_next_step_text_color"
        android:gravity="center"
        android:id="@+id/btn_next"
        android:background="@drawable/bg_btn_corn36_color_fa"
        android:layout_width="@dimen/dp_176"
        android:layout_height="@dimen/dp_48"
        android:layout_marginBottom="@dimen/dp_25"
        android:text="@string/protocol_next_step"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
