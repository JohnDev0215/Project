<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_74">
    <ImageView
        android:id="@+id/iv_app_icon"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        android:layout_marginStart="@dimen/dp_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="@color/flow_item_app_name_color"
        android:ellipsize="end"
        android:id="@+id/tv_app_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxEms="4"
        android:singleLine="true"
        android:layout_marginStart="@dimen/dp_14"
        app:layout_constraintBottom_toBottomOf="@+id/iv_app_icon"
        app:layout_constraintStart_toEndOf="@+id/iv_app_icon"
        app:layout_constraintTop_toTopOf="@+id/iv_app_icon"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="@color/flow_item_value_color"
        android:gravity="center"
        android:id="@+id/tv_flow_up"
        android:layout_width="@dimen/dp_82"
        android:layout_height="@dimen/dp_26"
        android:layout_marginStart="@dimen/dp_130"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_app_icon"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="@color/flow_item_value_color"
        android:gravity="center"
        android:id="@+id/tv_flow_down"
        android:layout_width="@dimen/dp_82"
        android:layout_height="@dimen/dp_26"
        android:layout_marginStart="@dimen/dp_236"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_app_icon"
        app:layout_constraintTop_toTopOf="parent"/>
    <Switch
        android:id="@+id/digital_key_set_switch"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_48"
        android:thumb="@drawable/img_switch_bg_point"
        android:track="@drawable/selector_switch_track"
        android:switchMinWidth="@dimen/dp_56"
        android:layout_marginStart="@dimen/dp_358"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_app_icon"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:background="@color/flow_item_divider_color"
        android:layout_width="@dimen/dp_460"
        android:layout_height="@dimen/dp_1"
        android:layout_marginStart="@dimen/dp_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
