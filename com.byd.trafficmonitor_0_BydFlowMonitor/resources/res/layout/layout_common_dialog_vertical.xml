<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rcrl_root_layout"
    android:background="@drawable/dialog_corn8"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <TextView
            android:textSize="20sp"
            android:textColor="@color/common_dialog_title"
            android:gravity="center"
            android:id="@+id/tv_dialog_title"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="22dp"
            android:layout_marginRight="12dp"
            android:layout_centerHorizontal="true"/>
        <LinearLayout
            android:id="@+id/ll_dialog_center_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="14dp"
            android:layout_below="@+id/tv_dialog_title">
            <TextView
                android:textSize="20sp"
                android:textColor="@color/common_dialog_title"
                android:gravity="center"
                android:id="@+id/tv_dialog_message"
                android:paddingLeft="18dp"
                android:paddingTop="10dp"
                android:paddingRight="18dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:lineSpacingExtra="3dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_dialog_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:layout_below="@+id/ll_dialog_center_group">
            <TextView
                android:textSize="15sp"
                android:gravity="center"
                android:id="@+id/tv_dialog_confirm"
                android:background="@drawable/common_dialog_gray_btn_bg"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginRight="24dp"
                android:layout_weight="1"/>
            <View
                android:layout_width="24dp"
                android:layout_height="1dp"/>
            <TextView
                android:textSize="15sp"
                android:gravity="center"
                android:id="@+id/tv_dialog_cancel"
                android:background="@drawable/common_dialog_gray_btn_bg"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginLeft="24dp"
                android:layout_weight="1"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/iv_dialog_close"
            android:visibility="gone"
            android:layout_width="39dp"
            android:layout_height="49dp"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
</RelativeLayout>
