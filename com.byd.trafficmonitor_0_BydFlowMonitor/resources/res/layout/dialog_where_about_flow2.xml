<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:id="@+id/ll_dialog_masks"
    android:background="@color/base_dialog_masks"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:alpha="0">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:id="@+id/cl_dialog_container"
        android:background="@drawable/common_dialog_background"
        android:clickable="true"
        android:layout_width="@dimen/dp_560"
        android:layout_height="@dimen/dp_560"
        android:alpha="0"
        android:scaleX="0.9"
        android:scaleY="0.9"
        android:elevation="@dimen/dp_3">
        <Button
            android:id="@+id/close"
            android:background="@drawable/icon_public_close_48"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:layout_marginTop="@dimen/dp_12"
            android:layout_marginStart="@dimen/dp_16"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/divider"
            android:background="@color/flow_dialog_divider_color"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:layout_marginTop="@dimen/dp_71"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/common_dialog_title"
            android:gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/flow_quxiang"
            app:layout_constraintBottom_toBottomOf="@+id/divider"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/flow_head_title_color"
            android:gravity="start|center_vertical"
            android:id="@+id/tv_app"
            android:layout_width="@dimen/dp_123"
            android:layout_height="@dimen/dp_48"
            android:layout_marginTop="@dimen/dp_76"
            android:text="@string/flow_where_app"
            android:layout_marginStart="@dimen/dp_48"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/flow_head_title_color"
            android:gravity="center"
            android:id="@+id/tv_up"
            android:layout_width="@dimen/dp_110"
            android:layout_height="@dimen/dp_48"
            android:text="@string/flow_where_app_up"
            android:layout_marginStart="@dimen/dp_40"
            app:layout_constraintBottom_toBottomOf="@+id/tv_app"
            app:layout_constraintStart_toEndOf="@+id/tv_app"
            app:layout_constraintTop_toTopOf="@+id/tv_app"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/flow_head_title_color"
            android:gravity="center"
            android:id="@+id/tv_down"
            android:layout_width="@dimen/dp_110"
            android:layout_height="@dimen/dp_48"
            android:text="@string/flow_where_app_down"
            android:layout_marginStart="@dimen/dp_144"
            app:layout_constraintBottom_toBottomOf="@+id/tv_up"
            app:layout_constraintStart_toEndOf="@+id/tv_app"
            app:layout_constraintTop_toTopOf="@+id/tv_up"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/flow_head_title_color"
            android:gravity="center"
            android:layout_width="@dimen/dp_120"
            android:layout_height="@dimen/dp_48"
            android:text="@string/flow_switch"
            android:layout_marginStart="@dimen/dp_250"
            app:layout_constraintBottom_toBottomOf="@+id/tv_down"
            app:layout_constraintStart_toEndOf="@+id/tv_app"
            app:layout_constraintTop_toTopOf="@+id/tv_down"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_394"
            android:layout_marginTop="@dimen/dp_54"
            app:layout_constraintTop_toBottomOf="@+id/divider">
            <com.byd.trafficmonitor.view.MyRecyclerView
                android:scrollbarThumbVertical="@drawable/shape_scrollbar_thumb"
                android:scrollbarTrackVertical="@drawable/shape_scrollbar_track"
                android:scrollbarStyle="insideOverlay"
                android:id="@+id/rv_flow_where"
                android:scrollbars="vertical"
                android:fadingEdgeLength="@dimen/dp_34"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:requiresFadingEdge="vertical"
                android:layout_marginStart="@dimen/dp_28"
                android:layout_marginEnd="@dimen/dp_10"
                app:layout_constraintHeight_max="@dimen/dp_444"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
