<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/common_page_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/dp_28"
        android:paddingRight="@dimen/dp_40"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_60">
        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:src="@drawable/base_icon_arrow"/>
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/color_title"
            android:gravity="left"
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/menu1_lay"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_menu1"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/color_title"
                android:id="@+id/tv_menu1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/menu2_lay"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_menu2"
                android:visibility="visible"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/color_title"
                android:id="@+id/tv_menu2"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/base_fl"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
