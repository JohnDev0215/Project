<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/flow_content_head"/>
    <com.byd.trafficmonitor.widget.RotateLinearLayout
        app:customOrientation="horizontal"
        app:landscapeWidth="@dimen/dp_642"
        style="@style/flow_portrait_5g_style">
        <com.byd.trafficmonitor.widget.RotateLinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_344"
            app:landscapeWidth="@dimen/dp_642">
            <include layout="@layout/flow_content_used_detail"/>
        </com.byd.trafficmonitor.widget.RotateLinearLayout>
        <com.byd.trafficmonitor.widget.RotateLinearLayout
            android:id="@+id/ll_5g"
            android:background="@drawable/flow_5g_bg_2"
            style="@style/flow_btn_group_style">
            <LinearLayout
                android:id="@+id/fl_jihuo"
                android:visibility="gone"
                style="@style/flow_buy_group_style">
                <ImageView
                    android:layout_width="@dimen/dp_48"
                    android:layout_height="@dimen/dp_48"
                    android:src="@drawable/icon_dark_activation_48"/>
                <TextView
                    android:textSize="@dimen/sp_18"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp_48"
                    android:text="@string/flow_jihuo"/>
            </LinearLayout>
            <com.byd.trafficmonitor.widget.RotateLinearLayout
                android:id="@+id/fl_flow_buy"
                android:visibility="gone"
                app:isHorizontalMarginTop="true"
                style="@style/flow_buy_group_style">
                <ImageView
                    android:layout_width="@dimen/dp_48"
                    android:layout_height="@dimen/dp_48"
                    android:src="@drawable/icon_dark_buy_48"/>
                <TextView
                    android:text="@string/flow_bug"
                    style="@style/flow_btn_text_horizontal_style"/>
            </com.byd.trafficmonitor.widget.RotateLinearLayout>
            <com.byd.trafficmonitor.widget.RotateLinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/ll_5g_whereabouts"
                android:background="@drawable/bg_btn_corn36_color_fa"
                android:layout_width="@dimen/dp_160"
                android:layout_height="@dimen/dp_48"
                app:customOrientation="horizontal"
                app:isHorizontalMarginTop="true">
                <ImageView
                    android:layout_width="@dimen/dp_48"
                    android:layout_height="@dimen/dp_48"
                    android:src="@drawable/icon_dark_whereabouts_48"/>
                <TextView
                    android:text="@string/flow_quxiang"
                    style="@style/flow_btn_text_horizontal_style"/>
            </com.byd.trafficmonitor.widget.RotateLinearLayout>
        </com.byd.trafficmonitor.widget.RotateLinearLayout>
    </com.byd.trafficmonitor.widget.RotateLinearLayout>
    <com.byd.trafficmonitor.widget.RotateLinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        app:horizontal_marginStart="@dimen/dp_16"
        app:layout_marginStart="@dimen/dp_0"
        app:layout_marginTop="@dimen/dp_80">
        <TextView
            android:id="@+id/dead_line_tv"
            android:text="@string/flow_5g_des"
            style="@style/flow_remind_expire_style"/>
    </com.byd.trafficmonitor.widget.RotateLinearLayout>
</LinearLayout>
