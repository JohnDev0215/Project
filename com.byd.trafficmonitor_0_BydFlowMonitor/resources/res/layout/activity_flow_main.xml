<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/app_common_bg"
    android:paddingTop="@dimen/dp_56"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.byd.trafficmonitor.widget.CustomToolBar
        android:id="@+id/toolbar"
        style="@style/NoSpaceToolbar"/>
    <LinearLayout
        android:id="@+id/ll_left_menu"
        style="@style/icon_head_style">
        <LinearLayout
            android:id="@+id/service_5g_ll"
            style="@style/icon_head_item_style">
            <ImageView
                android:id="@+id/iv_5g"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:src="@drawable/selector_icon_5g"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/flow_tab_text_color_selector"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/service_5g"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/service_icall_ll"
            android:layout_marginStart="@dimen/dp_80"
            style="@style/icon_head_item_style">
            <ImageView
                android:id="@+id/iv_icall"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:src="@drawable/selector_icon_icall"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/flow_tab_text_color_selector"
                android:text="@string/service_icall"
                style="@style/wrap_content"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/flow_fl_container"
        android:paddingStart="@dimen/dp_40"
        style="@style/match_parent"/>
</LinearLayout>
