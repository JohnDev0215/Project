<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="@dimen/dp_1"
    android:paddingBottom="@dimen/dp_10"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_50">
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/flow_head_title_color"
        android:gravity="center"
        android:id="@+id/tv_app"
        android:layout_width="@dimen/dp_42"
        android:layout_height="@dimen/dp_24"
        android:layout_marginLeft="@dimen/dp_38"
        android:layout_marginTop="@dimen/dp_16"
        android:text="@string/flow_where_app"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/flow_head_title_color"
        android:gravity="center"
        android:id="@+id/tv_up"
        android:layout_width="@dimen/dp_100"
        android:layout_height="@dimen/dp_24"
        android:layout_marginLeft="@dimen/dp_207"
        android:text="@string/flow_where_app_up"
        app:layout_constraintBottom_toBottomOf="@+id/tv_app"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_app"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/flow_head_title_color"
        android:gravity="center"
        android:id="@+id/tv_down"
        android:layout_width="@dimen/dp_100"
        android:layout_height="@dimen/dp_24"
        android:layout_marginLeft="@dimen/dp_326"
        android:text="@string/flow_where_app_down"
        app:layout_constraintBottom_toBottomOf="@+id/tv_up"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_up"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/flow_head_title_color"
        android:gravity="center"
        android:layout_width="@dimen/dp_120"
        android:layout_height="@dimen/dp_24"
        android:layout_marginLeft="@dimen/dp_400"
        android:text="@string/flow_switch"
        app:layout_constraintBottom_toBottomOf="@+id/tv_down"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_down"/>
</androidx.constraintlayout.widget.ConstraintLayout>
