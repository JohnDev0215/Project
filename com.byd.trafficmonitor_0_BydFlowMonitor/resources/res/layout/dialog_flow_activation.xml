<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_450">
    <androidx.core.widget.NestedScrollView
        android:scrollbarStyle="outsideInset"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_375"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingLeft="@dimen/dp_48"
            android:paddingBottom="@dimen/dp_20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/activation_phone_text_color"
                android:id="@+id/tv_phone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_55"
                android:text="@string/phone_num"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <EditText
                android:textSize="@dimen/sp_18"
                android:textColor="@color/activation_phone_text_color"
                android:textColorHint="@color/activation_phone_text_color"
                android:gravity="center"
                android:id="@+id/et_phone"
                android:background="@drawable/shape_activation_input_bg"
                android:layout_width="@dimen/dp_221"
                android:layout_height="@dimen/dp_48"
                android:hint="@string/activation_input_phone_tip"
                android:layout_marginStart="@dimen/dp_8"
                app:layout_constraintBottom_toBottomOf="@+id/tv_phone"
                app:layout_constraintLeft_toRightOf="@+id/tv_phone"
                app:layout_constraintTop_toTopOf="@+id/tv_phone"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/activation_phone_text_color"
                android:id="@+id/tv_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_38"
                android:text="@string/activation_verify_code"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_phone"/>
            <EditText
                android:textSize="@dimen/sp_18"
                android:textColor="@color/activation_phone_text_color"
                android:textColorHint="@color/activation_phone_text_color"
                android:gravity="center"
                android:id="@+id/et_code"
                android:background="@drawable/shape_activation_input_bg"
                android:layout_width="@dimen/dp_221"
                android:layout_height="@dimen/dp_48"
                android:hint="@string/activation_input_code_tip"
                android:layout_marginStart="@dimen/dp_8"
                app:layout_constraintBottom_toBottomOf="@+id/tv_code"
                app:layout_constraintLeft_toRightOf="@+id/tv_code"
                app:layout_constraintTop_toTopOf="@+id/tv_code"/>
            <Button
                android:textSize="@dimen/sp_18"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:background="@drawable/bg_btn_corn36_color_fa"
                android:layout_width="@dimen/dp_160"
                android:layout_height="@dimen/dp_48"
                android:layout_marginLeft="@dimen/dp_20"
                android:text="发送验证码"
                app:layout_constraintBottom_toBottomOf="@+id/et_code"
                app:layout_constraintLeft_toRightOf="@+id/et_code"
                app:layout_constraintTop_toTopOf="@+id/et_code"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/activation_car_device_text_color"
                android:id="@+id/tv_machine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_27"
                android:text="@string/activation_car_params"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_code"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/activation_phone_text_color"
                android:id="@+id/tv_iccid_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:text="@string/iccid"
                android:includeFontPadding="false"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_machine"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/activation_phone_text_color"
                android:id="@+id/tv_iccid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_128"
                android:text="89860118775400476096"
                android:includeFontPadding="false"
                app:layout_constraintBottom_toBottomOf="@+id/tv_iccid_title"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_iccid_title"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/activation_phone_text_color"
                android:id="@+id/tv_car_num_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_42"
                android:text="@string/car_frame_num"
                android:includeFontPadding="false"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_machine"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/activation_phone_text_color"
                android:id="@+id/tv_car_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_128"
                android:layout_marginTop="@dimen/dp_8"
                android:text="LGXC76C32J0189028"
                android:includeFontPadding="false"
                app:layout_constraintBottom_toBottomOf="@+id/tv_car_num_title"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_car_num_title"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/activation_car_device_text_color"
                android:id="@+id/tv_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_92"
                android:text="@string/activation_warm_tip"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_machine"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/activation_phone_text_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:text="1.如果现在开通，至本月26日为第一个月；\102.当月未使用的流量在当月26日24:00清零。\103.当月未使用的流量在当月26日24:00清零。"
                android:includeFontPadding="false"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_tip"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <Button
        android:textSize="@dimen/sp_18"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:background="@drawable/bg_btn_corn36_color_fa"
        android:layout_width="@dimen/dp_279"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_396"
        android:text="申请开通"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
