<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/app_common_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.byd.trafficmonitor.widget.CustomToolBar
        android:id="@+id/toolbar"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/flow_title_menu"
        style="@style/NoSpaceToolbar"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="@color/buy_for_friend_phone_text"
        android:id="@+id/tv_phone_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_159"
        android:text="@string/phone_num"
        android:includeFontPadding="false"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/et_phone"
        app:layout_constraintTop_toTopOf="parent"/>
    <EditText
        android:textSize="@dimen/sp_18"
        android:textColor="@color/activation_phone_text_color"
        android:textColorHint="@color/activation_phone_text_color"
        android:gravity="center"
        android:id="@+id/et_phone"
        android:background="@drawable/shape_activation_input_bg"
        android:layout_width="@dimen/dp_366"
        android:layout_height="@dimen/dp_48"
        android:layout_marginLeft="@dimen/dp_18"
        android:hint="@string/buy_for_friend_phone_tip"
        android:includeFontPadding="false"
        android:inputType="number"
        app:layout_constraintBaseline_toBaselineOf="@+id/tv_phone_num"
        app:layout_constraintLeft_toRightOf="@+id/tv_phone_num"
        app:layout_constraintRight_toRightOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="@color/buy_for_friend_phone_text"
        android:id="@+id/tv_car_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_223"
        android:text="@string/car_frame_num"
        android:includeFontPadding="false"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/et_car_frame"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="@color/activation_phone_text_color"
        android:gravity="center"
        android:id="@+id/et_car_frame"
        android:background="@drawable/shape_activation_input_bg"
        android:layout_width="@dimen/dp_366"
        android:layout_height="@dimen/dp_48"
        android:layout_marginLeft="@dimen/dp_18"
        android:includeFontPadding="false"
        app:layout_constraintBaseline_toBaselineOf="@+id/tv_car_frame"
        app:layout_constraintLeft_toRightOf="@+id/tv_car_frame"
        app:layout_constraintRight_toRightOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_car_list"
        android:background="@drawable/shape_car_list_bg"
        android:layout_width="@dimen/dp_366"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        app:layout_constraintLeft_toLeftOf="@+id/et_car_frame"
        app:layout_constraintRight_toRightOf="@+id/et_car_frame"
        app:layout_constraintTop_toBottomOf="@+id/et_car_frame"/>
    <ImageView
        android:id="@+id/iv_qr"
        android:background="@drawable/shape_qr_bg"
        android:visibility="gone"
        android:layout_width="@dimen/dp_144"
        android:layout_height="@dimen/dp_144"
        android:layout_marginTop="@dimen/dp_336"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="@color/wx_scan_tip"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_50"
        android:text="@string/buy_for_friend_wx_scan_tip"
        app:layout_constraintLeft_toLeftOf="@+id/iv_qr"
        app:layout_constraintRight_toRightOf="@+id/iv_qr"
        app:layout_constraintTop_toBottomOf="@+id/iv_qr"/>
</androidx.constraintlayout.widget.ConstraintLayout>
