<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dp_12"
    android:layout_marginBottom="@dimen/dp_12">
    <CheckBox
        android:id="@+id/cb_oil"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_40"
        android:button="@drawable/checkbox_bg_selector"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/dp_31"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="?attr/text_color_main"
        android:gravity="center"
        android:id="@+id/tv_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/carhealthy_oil_not_hint"
        android:layout_toLeftOf="@+id/cb_oil"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/dp_18"/>
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="?attr/text_color_main"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toLeftOf="@+id/tv_hint"
        android:layout_marginStart="@dimen/dp_48"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="?attr/text_color_main"
        android:id="@+id/tv_life_remain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_2"
        android:text="@string/carhealthy_oil_life_remain"
        android:layout_toLeftOf="@+id/tv_hint"
        android:layout_below="@+id/tv_title"
        android:layout_marginStart="@dimen/dp_48"/>
</RelativeLayout>
