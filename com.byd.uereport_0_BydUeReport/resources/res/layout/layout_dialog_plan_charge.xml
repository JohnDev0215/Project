<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/ll_dialog_masks"
    android:background="?attr/dialog_masks"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_dialog_content"
        android:background="@drawable/common_dialog_background"
        android:clickable="true"
        android:layout_width="@dimen/dp_560"
        android:layout_height="wrap_content"
        android:elevation="@dimen/dp_3">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textStyle="bold"
            android:textColor="?attr/dialog_title"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_69"
            android:layout_marginTop="@dimen/dp_2"
            android:text="@string/title_tips"
            android:maxLines="2"
            android:layout_marginStart="@dimen/dp_24"
            android:layout_marginEnd="@dimen/dp_24"/>
        <View
            android:background="?attr/dialog_divider_common"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"/>
        <RelativeLayout
            android:orientation="vertical"
            android:layout_width="@dimen/dp_560"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="?attr/dialog_text_color_main"
                android:id="@+id/tv_gun_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_40"
                android:paddingStart="@dimen/dp_58"
                android:paddingEnd="@dimen/dp_208"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="?attr/dialog_text_color_tips"
                android:gravity="center_vertical"
                android:id="@+id/tv_gun_desc"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_56"
                android:layout_marginBottom="@dimen/dp_17"
                android:layout_below="@+id/tv_gun_title"
                android:paddingStart="@dimen/dp_58"
                android:paddingEnd="@dimen/dp_208"/>
            <ImageView
                android:layout_width="@dimen/dp_120"
                android:layout_height="@dimen/dp_120"
                android:layout_marginTop="@dimen/dp_20"
                android:layout_marginBottom="@dimen/dp_20"
                android:src="@drawable/img_empty_wisdom_120_light"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/dp_58"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_104">
            <Button
                android:textSize="@dimen/sp_18"
                android:textColor="@color/dialog_btn_text_white_selector"
                android:gravity="center"
                android:id="@+id/btn_ok"
                android:background="@drawable/selector_dialog_blue"
                android:layout_width="@dimen/dp_208"
                android:layout_height="@dimen/dp_48"
                android:text="@string/smarttravel_keep_plan"
                android:textAllCaps="false"
                android:paddingStart="@dimen/dp_2"
                android:paddingEnd="@dimen/dp_2"
                android:layout_marginEnd="@dimen/dp_24"
                android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"/>
            <Button
                android:textSize="@dimen/sp_18"
                android:textColor="@color/dialog_btn_text_gray_selector"
                android:id="@+id/btn_plan_charge"
                android:background="@drawable/selector_dialog_white"
                android:layout_width="@dimen/dp_208"
                android:layout_height="@dimen/dp_48"
                android:text="@string/smarttravel_charge_now"
                android:textAllCaps="false"
                android:paddingStart="@dimen/dp_2"
                android:paddingEnd="@dimen/dp_2"
                android:layout_marginStart="@dimen/dp_24"
                android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
