<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/include_dialog_mask"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="@dimen/dp_560"
        android:layout_height="@dimen/dp_319"
        style="@style/dialog_content">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textStyle="bold"
            android:textColor="@color/dialog_aa_notice_text_color"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="@dimen/dp_512"
            android:layout_height="@dimen/dp_29"
            android:layout_marginTop="@dimen/dp_22"
            android:text="@string/aa_low_battery_tip"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:background="@color/dialog_divider_line_color"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:layout_marginTop="@dimen/dp_71"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.byd.uereport.widget.BydDialogTextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/dialog_aa_notice_text_color"
            android:gravity="center"
            android:id="@+id/tv_content"
            android:layout_width="@dimen/dp_464"
            android:layout_height="wrap_content"
            android:text="@string/aa_notice_content"
            android:lineSpacingExtra="@dimen/sp_10"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_ok"
            android:background="@drawable/shape_bg_blue_button"
            android:layout_width="@dimen/dp_176"
            android:layout_height="@dimen/dp_48"
            android:layout_marginTop="@dimen/dp_243"
            android:text="@string/dilink_yes"
            android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>
