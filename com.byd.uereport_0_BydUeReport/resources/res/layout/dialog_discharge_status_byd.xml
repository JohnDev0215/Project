<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/ll_dialog_masks"
    android:background="?attr/dialog_masks"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/ll_dialog_content"
        android:background="@drawable/common_dialog_background"
        android:clickable="true"
        android:layout_width="@dimen/dp_560"
        android:layout_height="wrap_content"
        android:elevation="@dimen/dp_3">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_68"
            android:layout_marginTop="@dimen/dp_30"
            android:layout_marginStart="@dimen/dp_38"
            android:layout_marginEnd="@dimen/dp_38">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="?attr/dialog_text_color_main"
                android:gravity="center"
                android:id="@+id/tv_title"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_68"
                android:text="@string/newenergy_discharge_mps_charge_abnormal"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/iv_title"
                android:layout_width="@dimen/dp_30"
                android:layout_height="@dimen/dp_30"
                android:layout_marginLeft="5dp"
                android:src="@drawable/icon_light_public_redx_center_48"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="?attr/dialog_text_color_main"
            android:gravity="center"
            android:id="@+id/tv_message"
            android:paddingTop="@dimen/dp_8"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/newenergy_discharge_mps_discharge_time_and_quantity"
            android:layout_marginStart="@dimen/dp_48"
            android:layout_marginEnd="@dimen/dp_48"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_168">
            <ImageView
                android:layout_width="@dimen/dp_168"
                android:layout_height="@dimen/dp_120"
                android:layout_marginTop="@dimen/dp_8"
                android:src="@drawable/img_dark_carsetting_newenergy_charge_power_station_remaining_battery"
                android:layout_marginStart="@dimen/dp_80"/>
            <ImageView
                android:layout_width="@dimen/dp_168"
                android:layout_height="@dimen/dp_120"
                android:layout_marginTop="@dimen/dp_8"
                android:src="@drawable/img_dark_carsetting_newenergy_charge_power_station_remaining_battery"
                android:layout_marginStart="@dimen/dp_312"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="?attr/dialog_text_color_main"
                android:gravity="center_horizontal"
                android:layout_width="@dimen/dp_184"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/dp_44"
                android:text="@string/newenergy_discharge_mps_discharge_car_title"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="@dimen/dp_72"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="?attr/dialog_text_color_main"
                android:gravity="center_horizontal"
                android:layout_width="@dimen/dp_184"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/dp_44"
                android:text="@string/newenergy_discharge_mps_charge_car_title"
                android:layout_alignParentBottom="true"
                android:layout_marginEnd="@dimen/dp_72"
                android:layout_alignParentEnd="true"/>
            <ProgressBar
                android:id="@+id/progressbar_own_car"
                android:layout_width="@dimen/dp_136"
                android:layout_height="@dimen/dp_20"
                android:layout_marginTop="@dimen/dp_94"
                android:max="100"
                android:progressDrawable="@drawable/progress_background_discharge"
                android:layout_marginStart="@dimen/dp_96"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textStyle="bold"
                android:textColor="?attr/movestation_black"
                android:gravity="center"
                android:id="@+id/tv_progress_own_car"
                android:layout_width="@dimen/dp_168"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_68"
                android:text="--%"
                android:layout_marginStart="@dimen/dp_80"/>
            <ProgressBar
                android:id="@+id/progressbar_charge_car"
                android:layout_width="@dimen/dp_136"
                android:layout_height="@dimen/dp_20"
                android:layout_marginTop="@dimen/dp_94"
                android:max="100"
                android:progressDrawable="@drawable/progress_background_discharge"
                android:layout_marginEnd="@dimen/dp_96"
                android:layout_alignParentEnd="true"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textStyle="bold"
                android:textColor="?attr/movestation_black"
                android:gravity="center"
                android:id="@+id/tv_progress_charge_car"
                android:layout_width="@dimen/dp_168"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_68"
                android:text="--%"
                android:layout_marginStart="@dimen/dp_312"/>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_104">
            <Button
                android:textSize="@dimen/sp_18"
                android:textColor="@color/dialog_btn_text_white_selector"
                android:id="@+id/btn_ok"
                android:background="@drawable/selector_dialog_blue"
                android:layout_width="@dimen/dp_176"
                android:layout_height="@dimen/dp_48"
                android:text="@string/dialog_btn_ok"
                android:textAllCaps="false"
                android:layout_marginStart="@dimen/dp_24"
                android:layout_marginEnd="@dimen/dp_24"
                android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
