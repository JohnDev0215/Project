<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/include_dialog_mask"/>
    <LinearLayout
        android:orientation="vertical"
        android:clickable="true"
        android:layout_width="@dimen/dp_560"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        style="@style/vehicle_setting_dialog_background_container">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_71">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textStyle="bold"
                android:textColor="@color/dialog_title"
                android:gravity="center"
                android:id="@+id/tv_title_dialog_hint_1_btn"
                android:layout_width="@dimen/dp_512"
                android:layout_height="@dimen/dp_29"
                android:text="@string/cp_guide"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <View
            android:background="@color/bg_color_line"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"/>
        <com.bydux.api.common.views.window.DampingScrollView
            android:scrollbarSize="@dimen/dp_4"
            android:scrollbarThumbVertical="@drawable/bar_thumb"
            android:scrollbarTrackVertical="@drawable/bar_track"
            android:scrollbarStyle="outsideInset"
            android:id="@+id/dampingScrollView_dialog_text"
            android:visibility="visible"
            android:scrollbars="vertical"
            android:fadingEdge="vertical"
            android:fadingEdgeLength="@dimen/dp_24"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/dp_40"
            android:requiresFadingEdge="vertical"
            android:paddingStart="@dimen/dp_30"
            android:paddingEnd="@dimen/dp_30"
            android:layout_marginStart="@dimen/dp_9"
            android:layout_marginEnd="@dimen/dp_9"
            app:maxHeight="@dimen/dp_288">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="@dimen/sp_20"
                    android:textColor="@color/text_color_main_dilink_pagers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cp_tisp_1"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/dp_8"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:paddingTop="@dimen/dp_8"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/shape_circle_tips_dot"
                        android:paddingEnd="@dimen/dp_12"/>
                    <TextView
                        android:textSize="@dimen/sp_20"
                        android:textColor="@color/text_color_main_dilink_pagers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/cp_tisp_2"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/dp_8"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:paddingTop="@dimen/dp_8"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/shape_circle_tips_dot"
                        android:paddingEnd="@dimen/dp_12"/>
                    <TextView
                        android:textSize="@dimen/sp_20"
                        android:textColor="@color/text_color_main_dilink_pagers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/cp_tisp_3"/>
                </LinearLayout>
            </LinearLayout>
        </com.bydux.api.common.views.window.DampingScrollView>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_104">
            <com.byd.mvp.ui.widget.BydInvalidButton
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_checked_dilink_pagers"
                android:gravity="center"
                android:id="@+id/btn_ok_dialog_hint_1_btn"
                android:background="@drawable/shape_bg_blue_button"
                android:layout_width="@dimen/dp_160"
                android:layout_height="@dimen/dp_48"
                android:text="@string/dialog_btn_ok"
                android:layout_centerInParent="true"
                android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"/>
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>
