<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/car_set_massage_tip_dialog"
    android:layout_width="@dimen/dp_151"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/dp_142">
    <ImageView
        android:id="@+id/ue_report_massage_mode_img"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ue_report_massage_title_tv"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_16"
        android:layout_marginStart="@dimen/dp_15"
        android:layout_marginEnd="@dimen/dp_15"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ue_report_massage_mode_img">
        <TextView
            android:textSize="@dimen/sp_15"
            android:textColor="@color/carsetting_text_color_white"
            android:id="@+id/ue_report_massage_mode_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:layout_centerHorizontal="true"
            android:textDirection="locale"
            android:textAlignment="center"/>
        <TextView
            android:textSize="@dimen/sp_15"
            android:textColor="@color/carsetting_text_color_blue"
            android:id="@+id/ue_report_massage_level_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_2"
            android:maxLines="2"
            android:layout_below="@+id/ue_report_massage_mode_tv"
            android:layout_centerHorizontal="true"
            android:textDirection="locale"
            android:textAlignment="center"/>
    </RelativeLayout>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="@color/carsetting_text_color_white"
        android:id="@+id/ue_report_massage_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:textDirection="locale"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
