<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/ll_dialog_masks"
    android:background="?attr/dialog_masks"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_dialog_content"
        android:background="@drawable/common_dialog_background"
        android:clickable="true"
        android:layout_width="@dimen/dp_560"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr"
        android:elevation="@dimen/dp_3">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textStyle="bold"
            android:textColor="?attr/dialog_title"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_69"
            android:layout_marginTop="@dimen/dp_2"
            android:text="@string/electricity_external_discharge_single"
            android:maxLines="2"
            android:layout_marginStart="@dimen/dp_24"
            android:layout_marginEnd="@dimen/dp_24"/>
        <View
            android:background="?attr/dialog_divider_common"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"/>
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_56"
            android:layout_marginTop="@dimen/dp_25"
            android:layout_marginStart="@dimen/dp_48"
            android:layout_marginEnd="@dimen/dp_48">
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="?attr/text_color_main"
                android:gravity="center"
                android:id="@+id/tv_h"
                android:layout_width="@dimen/dp_100"
                android:layout_height="match_parent"
                android:text="@string/newenergy_discharge_mps_hour"
                android:maxLines="1"
                android:layout_marginStart="@dimen/dp_116"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="?attr/text_color_main"
                android:gravity="center"
                android:id="@+id/tv_m"
                android:layout_width="@dimen/dp_100"
                android:layout_height="match_parent"
                android:text="@string/electricity_discharge_min"
                android:maxLines="1"
                android:layout_marginStart="@dimen/dp_248"/>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_width="@dimen/dp_560"
            android:layout_height="@dimen/dp_192"
            android:layout_marginBottom="@dimen/dp_16"
            android:paddingStart="@dimen/dp_48"
            android:paddingEnd="@dimen/dp_48">
            <com.byd.uereport.widget.WheelView
                android:id="@+id/wheelView_h"
                android:layout_width="@dimen/dp_232"
                android:layout_height="match_parent"
                app:itemNumber="3"
                app:lineColor="?attr/dialog_divider_common"
                app:lineHeight="@dimen/dp_1"
                app:marginStart="@dimen/dp_166"
                app:noEmpty="true"
                app:normalTextColor="?attr/text_color_main_gray"
                app:normalTextSize="@dimen/sp_24"
                app:selectedTextColor="?attr/text_color_btn_blue"
                app:selectedTextSize="@dimen/sp_24"
                app:unitHeight="@dimen/dp_64"/>
            <com.byd.uereport.widget.WheelView
                android:id="@+id/wheelView_m"
                android:layout_width="@dimen/dp_232"
                android:layout_height="match_parent"
                app:itemNumber="3"
                app:lineColor="?attr/dialog_divider_common"
                app:lineHeight="@dimen/dp_1"
                app:marginStart="@dimen/dp_66"
                app:noEmpty="true"
                app:normalTextColor="?attr/text_color_main_gray"
                app:normalTextSize="@dimen/sp_24"
                app:selectedTextColor="?attr/text_color_btn_blue"
                app:selectedTextSize="@dimen/sp_24"
                app:unitHeight="@dimen/dp_64"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_104">
            <Button
                android:textSize="@dimen/sp_18"
                android:textColor="@color/dialog_btn_text_white_selector"
                android:gravity="center"
                android:id="@+id/btn_ok"
                android:background="@drawable/selector_dialog_blue"
                android:layout_width="@dimen/dp_176"
                android:layout_height="@dimen/dp_48"
                android:text="@string/dialog_btn_ok"
                android:textAllCaps="false"
                android:layout_marginStart="@dimen/dp_24"
                android:layout_marginEnd="@dimen/dp_24"
                android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"/>
            <Button
                android:textSize="@dimen/sp_18"
                android:textColor="@color/dialog_btn_text_gray_selector"
                android:gravity="center"
                android:id="@+id/btn_cancel"
                android:background="@drawable/selector_dialog_white"
                android:layout_width="@dimen/dp_176"
                android:layout_height="@dimen/dp_48"
                android:text="@string/dialog_btn_cancel"
                android:textAllCaps="false"
                android:layout_marginStart="@dimen/dp_24"
                android:layout_marginEnd="@dimen/dp_24"
                android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
