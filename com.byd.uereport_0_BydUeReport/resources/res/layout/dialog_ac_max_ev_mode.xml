<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/common_dialog_background"
    android:layout_width="@dimen/dp_560"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="@color/dialog_common_text_content"
        android:gravity="start"
        android:id="@+id/tv_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_50"
        android:text="@string/ac_max_ev_mode_tips"
        android:layout_marginStart="@dimen/dp_48"
        android:layout_marginEnd="@dimen/dp_48"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/ll_check"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_below="@+id/tv_content"
        android:layout_marginStart="@dimen/dp_48">
        <CheckBox
            android:id="@+id/cb_no_longer_prompt"
            android:background="@drawable/selector_check_box"
            android:layout_width="@dimen/dp_40"
            android:layout_height="@dimen/dp_40"
            android:button="@null"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/text_color_main_gray"
            android:id="@+id/tv_agree_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_longer_prompt"/>
    </LinearLayout>
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@+id/ll_btn_container"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_104"
        android:layout_marginTop="@dimen/dp_55"
        android:layout_below="@+id/tv_content"
        android:layout_centerHorizontal="true">
        <com.byd.uereport.widget.CountDownTimerTextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_yes"
            android:background="@drawable/shape_bg_sure_radio_button"
            android:layout_width="@dimen/dp_176"
            android:layout_height="@dimen/dp_48"
            android:layout_centerVertical="true"
            android:stateListAnimator="@drawable/anim_btn_alpha"
            app:duration="8"
            app:text="@string/text_sure"/>
    </RelativeLayout>
</RelativeLayout>
