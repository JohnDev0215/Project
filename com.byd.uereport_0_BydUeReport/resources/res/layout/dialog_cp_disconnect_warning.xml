<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="@dimen/dp_560"
    android:layout_height="@dimen/dp_312"
    style="@style/vehicle_setting_dialog_background_container">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_71">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textStyle="bold"
            android:textColor="@color/text_color_main_dilink_pagers"
            android:gravity="center"
            android:id="@+id/tv_title_identification"
            android:layout_width="@dimen/dp_512"
            android:layout_height="match_parent"
            android:text="@string/cp_disconnect_warning_title"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <View
        android:background="@color/bg_color_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_24">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/text_color_main_dilink_pagers"
            android:gravity="center"
            android:id="@+id/tv_msg_identification"
            android:paddingTop="@dimen/dp_16"
            android:paddingBottom="@dimen/dp_28"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cp_disconnect_warning_des"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_40"
            android:layout_marginStart="@dimen/dp_40">
            <CheckBox
                android:id="@+id/cb_not_show"
                android:background="@drawable/checkbox_style"
                android:layout_width="@dimen/dp_40"
                android:layout_height="@dimen/dp_40"
                android:checked="true"
                android:button="@null"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/text_color_main_dilink_pagers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cast_not_show_text"/>
        </LinearLayout>
    </LinearLayout>
    <include
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_104"
        layout="@layout/dialog_bottom_2btn_left_hight_light"/>
</LinearLayout>
