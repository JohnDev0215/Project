<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_vertical"
    android:background="@drawable/common_dialog_background"
    android:layout_width="@dimen/dp_560"
    android:layout_height="@dimen/dp_544">
    <RelativeLayout
        android:id="@+id/carsetting_dialog_head"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_72"
        android:layout_alignParentTop="true">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textStyle="bold"
            android:textColor="@color/carlights_guest_color"
            android:id="@+id/carsetting_dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vehiclesettings_trailer_title"
            android:layout_centerInParent="true"
            android:textDirection="locale"/>
        <View
            android:id="@+id/carsetting_dialog_line"
            android:background="@color/ambient_dialog_line_bg"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/dp_16"
        android:layout_above="@+id/carsetting_dialog_bottom"
        android:layout_below="@+id/carsetting_dialog_head">
        <androidx.core.widget.NestedScrollView
            android:scrollbarThumbVertical="@drawable/setting_bar_thumb"
            android:scrollbarTrackVertical="@drawable/setting_bar_track"
            android:scrollbarStyle="insideOverlay"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/dp_40"
            android:overScrollMode="never">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/dp_48"
                android:layout_marginEnd="@dimen/dp_48">
                <ImageView
                    android:id="@+id/carsetting_dialog_image_content"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_centerInParent="true"/>
                <TextView
                    android:textSize="@dimen/sp_20"
                    android:textColor="@color/carlights_guest_color"
                    android:id="@+id/carsetting_dialog_main_content"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/vehiclesettings_trailer_signal_all_message_reminder"
                    android:textDirection="locale"/>
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textColor="@color/aircondition_second_text"
                    android:id="@+id/carsetting_dialog_second_content"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_below="@+id/carsetting_dialog_main_content"
                    android:layout_alignParentBottom="true"
                    android:textDirection="locale"/>
            </RelativeLayout>
        </androidx.core.widget.NestedScrollView>
    </RelativeLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/carsetting_dialog_bottom"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_104"
        android:layout_alignParentBottom="true">
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <Button
                android:textSize="@dimen/sp_18"
                android:textColor="@color/white"
                android:id="@+id/carsetting_dialog_btn_confirm"
                android:background="@drawable/selector_dialog_blue"
                android:visibility="visible"
                android:layout_width="@dimen/dp_176"
                android:layout_height="@dimen/dp_48"
                android:layout_marginTop="@dimen/dp_28"
                android:layout_marginBottom="@dimen/dp_28"
                android:text="@string/vehiclesettings_button_confirm"
                android:textDirection="locale"
                android:elevation="@dimen/dp_3"
                android:stateListAnimator="@drawable/anim_btn_scale"/>
        </RelativeLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>
