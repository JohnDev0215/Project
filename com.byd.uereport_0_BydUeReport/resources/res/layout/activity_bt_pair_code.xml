<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/bt_pair_code_bg"
    android:layout_width="@dimen/dp_560"
    android:layout_height="@dimen/dp_357"
    style="@style/vehicle_setting_dialog_background_container">
    <include
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_72"
        layout="@layout/dialog_common_title"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <com.byd.mvp.ui.widget.LengthMaxTextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/text_color_main_dilink_pagers"
            android:gravity="center"
            android:id="@+id/tv_bt_name_bt_pair_code"
            android:layout_width="@dimen/dp_464"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_40"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/text_color_gray_bt"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_77"
            android:maxWidth="@dimen/dp_500"
            android:text="@string/confirm_bt_pair_code"
            android:layout_centerHorizontal="true"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_10"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true">
            <TextView
                android:id="@+id/tv_bt_pair_code_0"
                style="@style/tv_bt_pair_code"/>
            <TextView
                android:id="@+id/tv_bt_pair_code_1"
                android:layout_marginStart="@dimen/dp_12"
                style="@style/tv_bt_pair_code"/>
            <TextView
                android:id="@+id/tv_bt_pair_code_2"
                android:layout_marginStart="@dimen/dp_12"
                style="@style/tv_bt_pair_code"/>
            <TextView
                android:id="@+id/tv_bt_pair_code_3"
                android:layout_marginStart="@dimen/dp_12"
                style="@style/tv_bt_pair_code"/>
            <TextView
                android:id="@+id/tv_bt_pair_code_4"
                android:layout_marginStart="@dimen/dp_12"
                style="@style/tv_bt_pair_code"/>
            <TextView
                android:id="@+id/tv_bt_pair_code_5"
                android:layout_marginStart="@dimen/dp_12"
                style="@style/tv_bt_pair_code"/>
        </LinearLayout>
    </RelativeLayout>
    <include
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_104"
        layout="@layout/dialog_bottom_2btn_left_hight_light"/>
</LinearLayout>
