<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/include_dialog_mask"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="@dimen/dp_560"
        android:layout_height="@dimen/dp_375"
        style="@style/dialog_content">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textStyle="bold"
            android:textColor="@color/dialog_cp_need_text_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_22"
            android:text="@string/cp_start_dialog_title"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:background="@color/dialog_divider_line_color"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:layout_marginTop="@dimen/dp_71"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bydux.api.common.views.window.DampingScrollView
            android:scrollbarSize="@dimen/dp_4"
            android:scrollbarThumbVertical="@drawable/bar_thumb"
            android:scrollbarTrackVertical="@drawable/bar_track"
            android:scrollbarStyle="outsideInset"
            android:id="@+id/scrollview"
            android:scrollbars="vertical"
            android:fadingEdge="vertical"
            android:fadingEdgeLength="@dimen/dp_30"
            android:layout_width="@dimen/dp_464"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_112"
            android:requiresFadingEdge="vertical"
            android:paddingEnd="@dimen/dp_5"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:maxHeight="@dimen/dp_140">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/dialog_cp_start_content_text_color"
                android:gravity="start"
                android:id="@+id/tv_content"
                android:paddingBottom="@dimen/dp_10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cp_data_protection_notice_content"
                android:breakStrategy="simple"/>
        </com.bydux.api.common.views.window.DampingScrollView>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_299"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tv_confirm"
                android:background="@drawable/shape_bg_blue_button"
                android:layout_width="@dimen/dp_176"
                android:layout_height="@dimen/dp_48"
                android:minWidth="@dimen/dp_176"
                android:text="@string/dilink_yes"
                android:paddingStart="@dimen/dp_10"
                android:paddingEnd="@dimen/dp_10"
                android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/dialog_cp_need_text_color"
                android:gravity="center"
                android:id="@+id/tv_cancel"
                android:background="@drawable/shape_bg_white_button"
                android:layout_width="@dimen/dp_176"
                android:layout_height="@dimen/dp_48"
                android:text="@string/dilink_no"
                android:layout_marginStart="@dimen/dp_48"
                android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>
