<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/ll_dialog_masks"
    android:background="?attr/dialog_masks"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_dialog_content"
        android:background="@drawable/common_dialog_background"
        android:clickable="true"
        android:layout_width="@dimen/dp_560"
        android:layout_height="wrap_content"
        android:elevation="@dimen/dp_3">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textStyle="bold"
            android:textColor="?attr/dialog_title"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_69"
            android:layout_marginTop="@dimen/dp_2"
            android:text="@string/carhealthy_oil_replace"
            android:maxLines="2"
            android:layout_marginStart="@dimen/dp_24"
            android:layout_marginEnd="@dimen/dp_24"/>
        <View
            android:background="?attr/dialog_divider_common"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"/>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="@dimen/dp_560"
            android:layout_height="wrap_content">
            <com.byd.uereport.widget.MaxHeightRecyclerView
                android:scrollbarSize="@dimen/dp_4"
                android:scrollbarThumbVertical="@drawable/bar_thumb"
                android:scrollbarTrackVertical="@drawable/bar_track"
                android:id="@+id/recyclerView"
                android:paddingTop="@dimen/dp_20"
                android:paddingBottom="@dimen/dp_20"
                android:scrollbars="vertical"
                android:fadingEdge="vertical"
                android:fadingEdgeLength="@dimen/dp_24"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:overScrollMode="never"
                android:requiresFadingEdge="vertical"
                android:paddingEnd="@dimen/dp_9"
                app:maxHeight="@dimen/dp_265"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="?attr/text_color_btn_blue"
                android:gravity="center"
                android:id="@+id/tv_replace_reset"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_38"
                android:text="@string/carhealthy_oil_replace_reset"
                android:layout_marginStart="@dimen/dp_48"
                android:layout_marginEnd="@dimen/dp_48"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_104">
            <Button
                android:textSize="@dimen/sp_18"
                android:textColor="@color/dialog_btn_text_white_selector"
                android:gravity="center"
                android:id="@+id/btn_ok"
                android:background="@drawable/selector_dialog_blue"
                android:layout_width="@dimen/dp_176"
                android:layout_height="@dimen/dp_48"
                android:text="@string/dialog_btn_ok"
                android:textAllCaps="false"
                android:layout_marginStart="@dimen/dp_24"
                android:layout_marginEnd="@dimen/dp_24"
                android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
