<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@drawable/common_dialog_background"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/dp_38"
    android:layout_marginTop="@dimen/dp_64"
    android:layout_marginRight="@dimen/dp_38"
    android:layout_marginBottom="@dimen/dp_64"
    android:elevation="@dimen/dp_3">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_72">
        <ImageView
            android:id="@+id/iv_title"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:layout_marginRight="@dimen/dp_12"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="@dimen/sp_20"
            android:textStyle="bold"
            android:textColor="?attr/dialog_title"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/carhealthy_epb"
            android:maxLines="2"
            android:layout_centerInParent="true"
            android:layout_marginStart="@dimen/dp_72"
            android:layout_marginEnd="@dimen/dp_72"/>
        <View
            android:background="?attr/dialog_divider_common"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <com.bydux.api.common.views.window.DampingScrollView
        android:scrollbarSize="@dimen/dp_4"
        android:scrollbarThumbVertical="@drawable/bar_thumb"
        android:scrollbarTrackVertical="@drawable/bar_track"
        android:id="@+id/dampingScrollView"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_8"
        android:layout_weight="1"
        android:requiresFadingEdge="vertical"
        android:paddingStart="@dimen/dp_8"
        android:paddingEnd="@dimen/dp_8">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/dp_8"
            android:paddingEnd="@dimen/dp_8">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="?attr/text_color_main"
                android:id="@+id/tv_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:text="@string/carhealthy_epb_desc"
                android:layout_marginStart="@dimen/dp_40"
                android:layout_marginEnd="@dimen/dp_40"/>
            <ImageView
                android:layout_gravity="center_horizontal"
                android:layout_width="@dimen/dp_268"
                android:layout_height="@dimen/dp_154"
                android:layout_marginTop="@dimen/dp_16"
                android:src="@drawable/img_epb"/>
        </LinearLayout>
    </com.bydux.api.common.views.window.DampingScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_content2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="@dimen/dp_8"
        android:paddingEnd="@dimen/dp_8">
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="?attr/text_color_main"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_24"
            android:text="@string/carhealthy_epb_exit_p"
            android:layout_marginStart="@dimen/dp_12"
            android:layout_marginEnd="@dimen/dp_12"/>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="@dimen/dp_268"
            android:layout_height="@dimen/dp_154"
            android:layout_marginTop="@dimen/dp_16"
            android:src="@drawable/img_epb"/>
    </LinearLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_128">
        <ProgressBar
            android:id="@+id/progress_time_longclick"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_4"
            android:layout_marginTop="@dimen/dp_22"
            android:max="100"
            android:progressDrawable="@drawable/progressbar_background_drawable"
            android:layout_marginStart="@dimen/dp_48"
            android:layout_marginEnd="@dimen/dp_48"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_epb_ok"
            android:background="@drawable/selector_dialog_blue"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_48"
            android:layout_marginTop="@dimen/dp_52"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="@dimen/dp_30"
            android:layout_marginEnd="@dimen/dp_30"
            android:stateListAnimator="@drawable/anim_btn_scale">
            <ProgressBar
                android:id="@+id/progressbar"
                android:visibility="gone"
                android:layout_width="@dimen/dp_36"
                android:layout_height="@dimen/dp_36"
                android:indeterminateDrawable="@drawable/progressbar_bg"
                android:layout_marginStart="@dimen/dp_10"
                android:layout_marginEnd="@dimen/dp_2"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/dialog_btn_text_white_selector"
                android:gravity="center"
                android:id="@+id/tv_ok"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_48"
                android:text="@string/carhealthy_epb_btn"
                android:paddingStart="@dimen/dp_24"
                android:paddingEnd="@dimen/dp_24"/>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
