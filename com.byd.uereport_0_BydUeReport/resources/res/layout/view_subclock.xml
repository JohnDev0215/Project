<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:id="@+id/tv_clock_month"
        android:background="@drawable/img_screensaver_classics_month"
        android:layout_width="@dimen/dp_84"
        android:layout_height="@dimen/dp_84"
        android:layout_marginTop="@dimen/dp_2"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:id="@+id/tv_clock_week"
        android:background="@drawable/img_screensaver_classics_week"
        android:layout_width="@dimen/dp_84"
        android:layout_height="@dimen/dp_84"
        android:layout_marginTop="@dimen/dp_31"
        android:layout_below="@+id/tv_clock_month"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="@color/text_color_gray_1"
        android:gravity="end"
        android:id="@+id/tv_clock_day"
        android:paddingBottom="@dimen/dp_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:paddingEnd="@dimen/dp_82"/>
</RelativeLayout>
