<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/common_dialog_background"
    android:layout_width="@dimen/dp_560"
    android:layout_height="wrap_content"
    android:layoutDirection="ltr">
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="@color/dialog_common_text_content"
        android:gravity="center_horizontal"
        android:id="@+id/tv_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_50"
        android:text="@string/auto_clean_tips"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="@dimen/dp_48"
        android:layout_marginEnd="@dimen/dp_48"/>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_btn_container"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_55"
        android:layout_marginBottom="@dimen/dp_28"
        android:layout_below="@+id/tv_content"
        android:layout_centerHorizontal="true">
        <com.byd.uereport.widget.CountDownTimerTextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/dialog_cancle_textcolor"
            android:gravity="center"
            android:id="@+id/tv_no"
            android:background="@drawable/shape_bg_cancle_radio_button"
            android:layout_width="@dimen/dp_176"
            android:layout_height="@dimen/dp_48"
            android:stateListAnimator="@drawable/anim_btn_alpha"
            app:duration="3"
            app:text="@string/text_cancle"/>
    </LinearLayout>
</RelativeLayout>
