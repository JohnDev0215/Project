<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/include_dialog_mask"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="@dimen/dp_560"
        android:layout_height="@dimen/dp_312"
        style="@style/dialog_content">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textStyle="bold"
            android:textColor="@color/dialog_open_back_door"
            android:gravity="center"
            android:layout_width="@dimen/dp_512"
            android:layout_height="@dimen/dp_29"
            android:layout_marginTop="@dimen/dp_22"
            android:text="@string/text_dialog_open_backdoor_title"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:background="@color/dialog_divider_line_color"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:layout_marginTop="@dimen/dp_71"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.byd.uereport.widget.BydDialogTextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/dialog_open_back_door"
            android:id="@+id/tv_content"
            android:layout_width="@dimen/dp_464"
            android:layout_height="wrap_content"
            android:text="@string/text_dialog_open_backdoor_tip"
            android:lineSpacingExtra="@dimen/sp_10"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.42"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_yes"
            android:background="@drawable/shape_bg_blue_button"
            android:layout_width="@dimen/dp_176"
            android:layout_height="@dimen/dp_48"
            android:layout_marginBottom="@dimen/dp_28"
            android:text="@string/text_button_open_backdoor"
            android:layout_marginStart="@dimen/dp_80"
            android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/dialog_cp_need_text_color"
            android:gravity="center"
            android:id="@+id/tv_no"
            android:background="@drawable/shape_bg_white_button"
            android:layout_width="@dimen/dp_176"
            android:layout_height="@dimen/dp_48"
            android:text="@string/text_button_cancel_backdoor"
            android:layout_marginStart="@dimen/dp_48"
            android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"
            app:layout_constraintBottom_toBottomOf="@+id/tv_yes"
            app:layout_constraintLeft_toRightOf="@+id/tv_yes"
            app:layout_constraintTop_toTopOf="@+id/tv_yes"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>
