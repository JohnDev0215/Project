<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/include_dialog_mask"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="@dimen/dp_560"
        android:layout_height="@dimen/dp_348"
        style="@style/dialog_content">
        <com.bydux.api.common.views.window.DampingScrollView
            android:scrollbarSize="@dimen/dp_4"
            android:scrollbarThumbVertical="@drawable/bar_thumb"
            android:scrollbarTrackVertical="@drawable/bar_track"
            android:scrollbarStyle="outsideInset"
            android:id="@+id/scrollview"
            android:scrollbars="vertical"
            android:fadingEdge="vertical"
            android:fadingEdgeLength="@dimen/dp_30"
            android:layout_width="@dimen/dp_464"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_48"
            android:requiresFadingEdge="vertical"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:maxHeight="@dimen/dp_144">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/dialog_cast_data_protection_notice_text_color"
                android:gravity="start"
                android:id="@+id/tv_content"
                android:paddingBottom="@dimen/dp_10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cp_data_protection_notice_content"
                android:lineSpacingExtra="@dimen/sp_12"
                android:breakStrategy="simple"/>
        </com.bydux.api.common.views.window.DampingScrollView>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_check"
            android:layout_width="@dimen/dp_40"
            android:layout_height="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_12"
            android:src="@mipmap/check_pitch_regular"
            app:layout_constraintStart_toStartOf="@+id/scrollview"
            app:layout_constraintTop_toBottomOf="@+id/scrollview"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/dialog_cast_data_protection_text_not_show_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cast_not_show_text"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toBottomOf="@+id/iv_check"
            app:layout_constraintStart_toEndOf="@+id/iv_check"
            app:layout_constraintTop_toTopOf="@+id/iv_check"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_confirm"
            android:background="@drawable/shape_bg_blue_button"
            android:layout_width="@dimen/dp_176"
            android:layout_height="@dimen/dp_48"
            android:layout_marginBottom="@dimen/dp_28"
            android:text="@string/dilink_yes"
            android:layout_marginStart="@dimen/dp_80"
            android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/dialog_cp_need_text_color"
            android:gravity="center"
            android:id="@+id/tv_cancel"
            android:background="@drawable/shape_bg_white_button"
            android:layout_width="@dimen/dp_176"
            android:layout_height="@dimen/dp_48"
            android:text="@string/dilink_no"
            android:layout_marginStart="@dimen/dp_48"
            android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"
            app:layout_constraintBottom_toBottomOf="@+id/tv_confirm"
            app:layout_constraintLeft_toRightOf="@+id/tv_confirm"
            app:layout_constraintTop_toTopOf="@+id/tv_confirm"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>
