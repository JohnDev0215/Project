<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:background="@drawable/common_dialog_background"
    android:layout_width="@dimen/dp_560"
    android:layout_height="@dimen/dp_312">
    <Button
        android:textSize="@dimen/sp_18"
        android:textColor="@color/white"
        android:id="@+id/refrigerator_dialog_btn_confirm"
        android:background="@drawable/selector_dialog_blue"
        android:layout_width="@dimen/dp_160"
        android:layout_height="@dimen/dp_48"
        android:layout_marginBottom="@dimen/dp_28"
        android:text="@string/dialog_btn_ok"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:textDirection="locale"
        android:elevation="@dimen/dp_3"
        android:stateListAnimator="@drawable/anim_btn_scale"/>
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="@color/carsetting_text_color_white"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_22"
        android:text="@string/vehiclesettings_refrigerator_something_left"
        android:layout_centerHorizontal="true"
        android:textDirection="locale"/>
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="@color/carsetting_text_color_white"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="@string/vehiclesettings_refrigerator_something_left"
        android:layout_above="@+id/refrigerator_dialog_btn_confirm"
        android:textDirection="locale"/>
</RelativeLayout>
