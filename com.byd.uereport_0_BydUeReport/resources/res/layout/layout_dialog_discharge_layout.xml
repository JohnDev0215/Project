<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/ll_dialog_masks"
    android:background="?attr/dialog_masks"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_dialog_content"
        android:background="@drawable/common_dialog_background"
        android:clickable="true"
        android:layout_width="@dimen/dp_560"
        android:layout_height="wrap_content"
        android:elevation="@dimen/dp_3">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_cancel"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:layout_marginTop="@dimen/dp_12"
                android:layout_marginBottom="@dimen/dp_11"
                android:src="@drawable/icon_dark_public_close_48"
                android:layout_marginStart="@dimen/dp_15"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textStyle="bold"
                android:textColor="?attr/dialog_title"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/newenergy_discharge_vtol_setting"
                android:maxLines="1"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/dp_65"
                android:layout_marginEnd="@dimen/dp_65"/>
        </RelativeLayout>
        <View
            android:background="?attr/dialog_divider_common"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_48">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_32"
                android:layout_marginBottom="@dimen/dp_13"
                android:layout_marginEnd="@dimen/dp_48">
                <com.byd.uereport.widget.BydSwitch
                    android:id="@+id/sw_dis_charge"
                    android:background="@drawable/selector_switch"
                    android:layout_width="@dimen/dp_64"
                    android:layout_height="?attr/sw_height"
                    android:textOn=""
                    android:textOff=""
                    android:thumb="@null"/>
                <TextView
                    android:textSize="@dimen/sp_20"
                    android:textColor="?attr/text_color_main"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/electricity_external_discharge"
                    android:layout_marginStart="@dimen/dp_16"/>
            </LinearLayout>
            <View
                android:background="?attr/dialog_divider_common"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_1"
                android:layout_marginEnd="@dimen/dp_48"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_9"
                android:layout_marginBottom="@dimen/dp_9"
                android:layout_marginEnd="@dimen/dp_48">
                <com.byd.uereport.widget.BydSwitch
                    android:id="@+id/sw_low_power"
                    android:background="@drawable/selector_switch"
                    android:layout_width="@dimen/dp_64"
                    android:layout_height="?attr/sw_height"
                    android:textOn=""
                    android:textOff=""
                    android:thumb="@null"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_16">
                    <TextView
                        android:textSize="@dimen/sp_20"
                        android:textColor="?attr/text_color_main"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/electricity_low_hint"/>
                    <TextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="?attr/text_color_main_gray"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_2"
                        android:text="@string/electricity_ait_hint"/>
                </LinearLayout>
            </LinearLayout>
            <View
                android:background="?attr/dialog_divider_common"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_1"
                android:layout_marginEnd="@dimen/dp_48"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/dp_8">
                    <TextView
                        android:textSize="@dimen/sp_20"
                        android:textColor="?attr/text_color_main"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_18"
                        android:text="@string/electricity_single_discharge_time"/>
                    <TextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="?attr/text_color_main_gray"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_2"
                        android:text="@string/electricity_external_discharge_single_5min"/>
                </LinearLayout>
                <Button
                    android:textSize="@dimen/sp_18"
                    android:textColor="?attr/dialog_text_button_text"
                    android:gravity="center"
                    android:id="@+id/btn_set"
                    android:background="@drawable/selector_dialog_white"
                    android:layout_width="@dimen/dp_176"
                    android:layout_height="@dimen/dp_48"
                    android:layout_marginTop="@dimen/dp_21"
                    android:layout_marginBottom="@dimen/dp_21"
                    android:text="@string/electricity_set"
                    android:textAllCaps="false"
                    android:layout_marginEnd="@dimen/dp_48"
                    android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_40"
                android:layout_marginEnd="@dimen/dp_48">
                <TextView
                    android:textSize="@dimen/sp_34"
                    android:textStyle="bold"
                    android:textColor="?attr/text_color_main"
                    android:id="@+id/tv_time_h"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_5"
                    android:layout_marginRight="@dimen/dp_5"
                    android:text="--"/>
                <TextView
                    android:textSize="@dimen/sp_20"
                    android:textColor="?attr/text_color_main"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/newenergy_discharge_mps_hour"/>
                <TextView
                    android:textSize="@dimen/sp_34"
                    android:textStyle="bold"
                    android:textColor="?attr/text_color_main"
                    android:id="@+id/tv_time_min"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_5"
                    android:layout_marginRight="@dimen/dp_5"
                    android:text="--"/>
                <TextView
                    android:textSize="@dimen/sp_20"
                    android:textColor="?attr/text_color_main"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/electricity_discharge_min"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
