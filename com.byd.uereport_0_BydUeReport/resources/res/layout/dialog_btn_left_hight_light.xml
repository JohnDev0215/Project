<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="@dimen/dp_560"
    android:layout_height="@dimen/dp_312"
    style="@style/vehicle_setting_dialog_background_container">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_71">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textStyle="bold"
            android:textColor="@color/text_color_main_dilink_pagers"
            android:gravity="center"
            android:id="@+id/tv_title_dialog_btn_left_hight_light"
            android:layout_width="@dimen/dp_512"
            android:layout_height="@dimen/dp_29"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <View
        android:background="@color/bg_color_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_112"
        android:layout_marginTop="@dimen/dp_24">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/text_color_main_dilink_pagers"
            android:gravity="center"
            android:id="@+id/tv_msg_dialog_btn_left_hight_light"
            android:layout_width="@dimen/dp_464"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <include
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_104"
        layout="@layout/dialog_bottom_2btn_left_hight_light"/>
</LinearLayout>
