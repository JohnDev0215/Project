<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:paddingStart="@dimen/dp_14"
        android:paddingEnd="@dimen/dp_24">
        <com.byd.systemsettings.ui.widget.LeftRightItem
            android:id="@+id/item_title_wifi_name_pager_wifi_info"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_60"
            android:layout_marginTop="@dimen/dp_16"
            app:textLeft="@string/wifi_name_wireless"/>
        <com.byd.systemsettings.ui.widget.LeftRightItem
            android:id="@+id/item_title_wifi_state_pager_wifi_info"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_60"
            app:textLeft="@string/wifi_state_wireless"/>
        <com.byd.systemsettings.ui.widget.LeftRightItem
            android:id="@+id/item_title_wifi_rssi_pager_wifi_info"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_60"
            app:textLeft="@string/wifi_rssi_wireless"/>
        <com.byd.systemsettings.ui.widget.LeftRightItem
            android:id="@+id/item_title_wifi_security_pager_wifi_info"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_60"
            app:textLeft="@string/wifi_security_wireless"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_bottom_operation_wifi_info"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_104"
        android:layout_alignParentBottom="true">
        <com.byd.mvp.ui.widget.BydInvalidButton
            android:id="@+id/btn_connect_pager_wifi_info"
            android:text="@string/connect_wireless"
            style="@style/dialog_btn_ok_dilink_bt"/>
        <com.byd.mvp.ui.widget.BydInvalidButton
            android:id="@+id/btn_remove_pager_wifi_info"
            android:text="@string/remove_wireless"
            android:layout_marginStart="@dimen/dp_40"
            style="@style/dialog_btn_cancel_dilink_bt"/>
    </LinearLayout>
</RelativeLayout>
