<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/background"
        android:background="#b8000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_content"
        android:background="@drawable/shape_bg_cpd_dialog"
        android:layout_width="@dimen/dp_560"
        android:layout_height="@dimen/dp_264"
        android:layout_centerInParent="true"
        android:layoutDirection="ltr">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="#d9dae1eb"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:paddingLeft="@dimen/dp_48"
            android:paddingRight="@dimen/dp_48"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_135"
            android:layout_marginTop="@dimen/dp_24"
            android:text="@string/text_cpd_dialog_exit_tip"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_confirm"
            android:background="@drawable/shape_bg_cpd_dialog_ensure"
            android:layout_width="@dimen/dp_176"
            android:layout_height="@dimen/dp_48"
            android:layout_marginTop="@dimen/dp_188"
            android:text="@string/text_cpd_dialog_btn_ensure"
            android:layout_marginStart="@dimen/dp_80"
            android:stateListAnimator="@animator/pressed_state_list"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="#d9dae1eb"
            android:gravity="center"
            android:id="@+id/tv_cancel"
            android:background="@drawable/shape_bg_cpd_dialog_cancel"
            android:layout_width="@dimen/dp_176"
            android:layout_height="@dimen/dp_48"
            android:text="@string/text_cpd_dialog_btn_cancel"
            android:layout_marginStart="@dimen/dp_48"
            android:stateListAnimator="@animator/pressed_state_list"
            app:layout_constraintBottom_toBottomOf="@+id/tv_confirm"
            app:layout_constraintStart_toEndOf="@+id/tv_confirm"
            app:layout_constraintTop_toTopOf="@+id/tv_confirm"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>
