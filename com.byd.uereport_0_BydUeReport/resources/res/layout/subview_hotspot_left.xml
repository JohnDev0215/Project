<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:paddingEnd="@dimen/dp_10">
    <com.byd.mvp.ui.widget.BydRadioGroup
        android:orientation="vertical"
        android:id="@+id/rg_hotshpot_left"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.byd.systemsettings.ui.widget.CheckLinearItem
            android:id="@+id/item_pwd_hotspot_left"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_60"
            app:bottomLineMargin="@dimen/dp_24"
            app:showBottomLine="true"
            app:textLeft="@string/title_add_pwd_wireless"/>
        <com.byd.systemsettings.ui.widget.CheckLinearItem
            android:id="@+id/item_security_hotspot_left"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_60"
            app:bottomLineMargin="@dimen/dp_24"
            app:showBottomLine="true"
            app:textLeft="@string/security_hotspot"/>
        <com.byd.systemsettings.ui.widget.CheckLinearItem
            android:id="@+id/item_freq_band_hotspot_left"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_60"
            app:bottomLineMargin="@dimen/dp_24"
            app:showBottomLine="true"
            app:textLeft="@string/freq_band_hotspot"/>
        <com.byd.systemsettings.ui.widget.CheckLinearItem
            android:id="@+id/item_flow_limited_hotspot_left"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_60"
            app:bottomLineMargin="@dimen/dp_24"
            app:showImgRight="true"
            app:textLeft="@string/flow_limited_for_one_time_hotspot"/>
    </com.byd.mvp.ui.widget.BydRadioGroup>
    <com.byd.systemsettings.ui.widget.CheckLinearItem
        android:id="@+id/item_connected_count_hotspot_left"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_60"
        app:contentMarginLeft="@dimen/dp_16"
        app:contentMarginRight="@dimen/dp_16"
        app:showImgRight="false"
        app:textLeft="@string/connected_count_hotspot"
        app:textLeftColor="@color/text_color_item_right_dilink_link"
        app:textLeftSize="@dimen/sp_16"/>
</LinearLayout>
