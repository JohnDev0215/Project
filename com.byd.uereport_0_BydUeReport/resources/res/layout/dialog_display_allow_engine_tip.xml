<?xml version="1.0" encoding="utf-8"?>
<widget.DialogTouchLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/dialog_corn8"
    android:layout_width="@dimen/dp_560"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/tv_content"
        android:text="@string/allow_engine_start_under_show_car_mode_msg"
        style="@style/remind_title_display_style"/>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/ll_btn_container"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_67"
        android:layout_marginBottom="@dimen/dp_28">
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_engine_allow_yes"
            android:background="@drawable/shape_bg_sure_radio_button"
            android:layout_width="@dimen/dp_186"
            android:layout_height="match_parent"
            android:text="@string/display_start_the_engine"/>
        <com.byd.uereport.widget.DelayDismissTextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/dialog_cancle_textcolor"
            android:gravity="center"
            android:id="@+id/tv_engine_forbid_no"
            android:background="@drawable/shape_display_bg_white_button"
            android:layout_width="@dimen/dp_186"
            android:layout_height="match_parent"
            android:text="@string/display_not_start_the_engine"
            android:layout_marginStart="@dimen/dp_48"/>
    </LinearLayout>
</widget.DialogTouchLinearLayout>
