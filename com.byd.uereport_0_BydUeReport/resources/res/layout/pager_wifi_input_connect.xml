<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:paddingStart="@dimen/dp_32">
        <RelativeLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_56">
            <com.byd.mvp.ui.widget.LengthMaxTextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/text_color_main"
                android:id="@+id/tv_wifi_name_pager_wifi_input_connect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/dp_277"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_bg_wifi_pwd_pager_wifi_input_connect"
            android:background="@drawable/bg_et_frame_gray_normal"
            android:layout_width="@dimen/dp_277"
            android:layout_height="@dimen/dp_48"
            android:layout_marginTop="@dimen/dp_10">
            <com.byd.mvp.ui.widget.NoMenuEditText
                android:textSize="@dimen/sp_18"
                android:textColor="@color/text_color_main_gray"
                android:textColorHint="@color/text_color_main_gray"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/et_wifi_pwd_pager_wifi_input_connect"
                android:background="@color/transparent_00"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/dp_3"
                android:layout_marginBottom="@dimen/dp_3"
                android:hint="@string/hint_input_pwd_wireless"
                android:singleLine="true"
                android:maxLength="64"
                android:layout_weight="1"
                android:inputType="textPassword"
                android:imeOptions="actionDone"
                android:layout_marginStart="@dimen/dp_8"/>
            <ImageView
                android:id="@+id/iv_wifi_pwd_type_pager_wifi_input_connect"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:src="@drawable/icon_public_closeeeye_48"
                android:layout_marginEnd="@dimen/dp_8"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/text_color_red"
            android:id="@+id/tv_pwd_err_pager_wifi_input_connect"
            android:visibility="gone"
            android:layout_width="@dimen/dp_277"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:text="@string/pwd_err_8_wireless"
            android:paddingStart="@dimen/dp_8"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_bottom_operation_wifi_input_connect"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_104"
        android:layout_alignParentBottom="true">
        <com.byd.mvp.ui.widget.BydInvalidButton
            android:id="@+id/btn_ok_pager_wifi_input_connect"
            android:text="@string/dialog_btn_ok"
            style="@style/dialog_btn_ok_dilink_bt"/>
        <com.byd.mvp.ui.widget.BydInvalidButton
            android:id="@+id/btn_cancel_pager_wifi_input_connect"
            android:text="@string/dialog_btn_cancel"
            android:layout_marginStart="@dimen/dp_40"
            style="@style/dialog_btn_cancel_dilink_bt"/>
    </LinearLayout>
</RelativeLayout>
