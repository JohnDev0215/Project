<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/include_dialog_mask"/>
    <LinearLayout
        android:orientation="vertical"
        android:clickable="true"
        android:layout_width="@dimen/dp_560"
        android:layout_height="@dimen/dp_312"
        android:layout_centerInParent="true"
        style="@style/vehicle_setting_dialog_background_container">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_71">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textStyle="bold"
                android:textColor="@color/text_color_main_dilink_pagers"
                android:gravity="center"
                android:id="@+id/tv_title_identification"
                android:layout_width="@dimen/dp_512"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <View
            android:background="@color/bg_color_line"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_112"
            android:layout_marginTop="@dimen/dp_24">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/ll_action_title_identification"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_11"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true">
                <ImageView
                    android:id="@+id/iv_type_identification"
                    android:layout_width="@dimen/dp_48"
                    android:layout_height="@dimen/dp_48"/>
                <TextView
                    android:textSize="@dimen/sp_18"
                    android:textColor="@color/text_color_main_dilink_pagers"
                    android:ellipsize="middle"
                    android:gravity="start"
                    android:id="@+id/tv_name_identification"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="@dimen/dp_416"
                    android:singleLine="true"
                    android:paddingEnd="@dimen/dp_22"/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_main_dilink_pagers"
                android:gravity="center"
                android:id="@+id/tv_msg_identification"
                android:layout_width="@dimen/dp_464"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_6"
                android:layout_below="@+id/ll_action_title_identification"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <include
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_104"
            layout="@layout/dialog_bottom_2btn_left_hight_light"/>
    </LinearLayout>
</RelativeLayout>
