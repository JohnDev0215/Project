<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_frame_blue_content_daynight"
    android:layout_width="@dimen/dp_330"
    android:layout_height="@dimen/dp_180">
    <androidx.recyclerview.widget.RecyclerView
        android:scrollbarSize="@dimen/dp_4"
        android:scrollbarThumbVertical="@color/bg_color_scrollbar_thumb"
        android:scrollbarTrackVertical="@color/bg_color_scrollbar_track"
        android:id="@+id/rcv_ppw_list"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:paddingStart="@dimen/dp_24"
        android:paddingEnd="@dimen/dp_13"/>
</LinearLayout>
