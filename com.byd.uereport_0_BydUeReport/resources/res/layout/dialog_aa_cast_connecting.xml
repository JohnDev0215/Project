<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/include_dialog_mask"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="@dimen/dp_560"
        android:layout_height="@dimen/dp_294"
        style="@style/dialog_content">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textStyle="bold"
            android:textColor="@color/dialog_connecting_color"
            android:gravity="center"
            android:id="@+id/tv_connect_title"
            android:layout_width="@dimen/dp_512"
            android:layout_height="@dimen/dp_29"
            android:layout_marginTop="@dimen/dp_22"
            android:text="@string/aa_connecting_dialog_title"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/divider"
            android:background="@color/dialog_divider_line_color"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:layout_marginTop="@dimen/dp_71"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/dialog_connecting_color"
            android:gravity="center"
            android:id="@+id/tv_connect_tip"
            android:layout_width="@dimen/dp_464"
            android:layout_height="@dimen/dp_134"
            android:layout_marginTop="@dimen/dp_112"
            android:text="@string/cp_connecting_content_text"
            android:textDirection="locale"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>
