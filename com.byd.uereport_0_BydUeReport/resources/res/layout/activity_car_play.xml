<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/vehicle_setting_dialog_background_container">
    <RelativeLayout
        android:id="@+id/rl_title_car_play"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_71">
        <ImageView
            android:id="@+id/iv_back_car_play"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:src="@drawable/icon_public_close_48"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/text_color_main"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_29"
            android:text="@string/carplay_link"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/dp_2"
            android:layout_toStartOf="@+id/iv_cp_tips"
            android:layout_toEndOf="@+id/iv_back_car_play"/>
        <ImageView
            android:id="@+id/iv_cp_tips"
            android:background="@drawable/icon_public_cp_tips"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp_16"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <View
        android:background="@color/bg_color_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"/>
    <RelativeLayout
        android:paddingBottom="@dimen/dp_10"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:scrollbarSize="@dimen/dp_4"
            android:scrollbarThumbVertical="@drawable/bar_thumb"
            android:scrollbarTrackVertical="@drawable/bar_track"
            android:id="@+id/rcv_connected_device_list_car_play"
            android:paddingTop="@dimen/dp_2"
            android:scrollbars="vertical"
            android:fadingEdgeLength="@dimen/dp_44"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="@dimen/dp_28"
            android:requiresFadingEdge="vertical"
            android:layout_marginStart="@dimen/dp_20"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_no_data_car_play"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <ImageView
                android:layout_width="@dimen/dp_312"
                android:layout_height="@dimen/dp_208"
                android:src="@drawable/img_no_data_carplay"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/text_color_main_gray"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_24"
                android:text="@string/no_data_carplay"/>
        </LinearLayout>
    </RelativeLayout>
    <com.byd.mvp.ui.widget.BydInvalidButton
        android:textSize="@dimen/sp_18"
        android:textColor="@drawable/selector_btn_text_blue_press_mian_color"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/btn_add_new_device_car_play"
        android:background="@drawable/selector_btn_bg_gray_press_blue"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_48"
        android:layout_marginBottom="@dimen/dp_28"
        android:minWidth="@dimen/dp_176"
        android:text="@string/add_new_device_carplay"
        android:textAllCaps="false"
        android:stateListAnimator="@drawable/anim_btn_scale"/>
</LinearLayout>
