<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_60"
    android:minHeight="@dimen/dp_60"
    android:paddingStart="@dimen/dp_8"
    android:paddingEnd="@dimen/dp_8">
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="@color/text_color_main_dilink_pagers"
        android:id="@+id/tv_name_item_wifi_security_list"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true"/>
    <ImageView
        android:id="@+id/iv_check_status_item_wifi_security_list"
        android:background="@drawable/icon_public_check_blue_48"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"/>
    <View
        android:background="@color/bg_color_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
