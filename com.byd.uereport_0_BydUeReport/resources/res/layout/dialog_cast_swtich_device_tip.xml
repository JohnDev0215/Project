<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/include_dialog_mask"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="@dimen/dp_560"
        android:layout_height="@dimen/dp_312"
        style="@style/dialog_content">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textStyle="bold"
            android:textColor="@color/dialog_connecting_color"
            android:gravity="center"
            android:id="@+id/tv_connect_title"
            android:layout_width="@dimen/dp_512"
            android:layout_height="@dimen/dp_29"
            android:layout_marginTop="@dimen/dp_22"
            android:text="@string/title_swtich_device"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:background="@color/dialog_divider_line_color"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:layout_marginTop="@dimen/dp_71"
            app:layout_constraintTop_toTopOf="parent"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/dialog_cp_need_text_color"
                android:gravity="center"
                android:id="@+id/tv_switch_tip"
                android:layout_width="@dimen/dp_464"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_yes"
            android:background="@drawable/shape_bg_blue_button"
            android:layout_width="@dimen/dp_176"
            android:layout_height="@dimen/dp_48"
            android:layout_marginTop="@dimen/dp_235"
            android:text="@string/dilink_yes"
            android:layout_marginStart="@dimen/dp_80"
            android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/dialog_cp_need_text_color"
            android:gravity="center"
            android:id="@+id/tv_no"
            android:background="@drawable/shape_bg_white_button"
            android:layout_width="@dimen/dp_176"
            android:layout_height="@dimen/dp_48"
            android:text="@string/dilink_no"
            android:layout_marginStart="@dimen/dp_48"
            android:stateListAnimator="@drawable/anim_btn_scale_alpha_enable"
            app:layout_constraintBottom_toBottomOf="@+id/tv_yes"
            app:layout_constraintLeft_toRightOf="@+id/tv_yes"
            app:layout_constraintTop_toTopOf="@+id/tv_yes"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>
