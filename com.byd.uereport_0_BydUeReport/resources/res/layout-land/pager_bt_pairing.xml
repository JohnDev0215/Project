<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/dp_14"
    android:paddingEnd="@dimen/dp_24">
    <com.byd.mvp.ui.widget.LengthMaxTextView
        android:textSize="@dimen/sp_18"
        android:textColor="@color/text_color_main"
        android:id="@+id/tv_bt_name_pager_bt_pairing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_14"
        android:maxWidth="@dimen/dp_390"
        android:layout_marginStart="@dimen/dp_24"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <ImageView
            android:id="@+id/iv_pairing_pager_bt_pairing"
            android:background="@drawable/icon_public_loading_72"
            android:layout_width="@dimen/dp_72"
            android:layout_height="@dimen/dp_72"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/text_color_rbtn_main"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bt_pairing"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_104"
        android:layout_alignParentBottom="true">
        <com.byd.mvp.ui.widget.BydInvalidButton
            android:id="@+id/btn_cancel_pager_bt_pairing"
            android:text="@string/dialog_btn_cancel"
            style="@style/dialog_btn_cancel_dilink"/>
    </LinearLayout>
</RelativeLayout>
