<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/dp_14"
    android:paddingEnd="@dimen/dp_24">
    <com.byd.mvp.ui.widget.LengthMaxTextView
        android:textSize="@dimen/sp_18"
        android:textColor="@color/text_color_main"
        android:id="@+id/tv_bt_name_pager_bt_pair_code"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_14"
        android:maxWidth="@dimen/dp_390"
        android:layout_marginStart="@dimen/dp_24"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/text_color_gray_bt"
        android:id="@+id/tv_hint_pager_bt_pair_code"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4"
        android:text="@string/confirm_bt_pair_code"
        android:layout_below="@+id/tv_bt_name_pager_bt_pair_code"
        android:layout_centerHorizontal="true"
        android:layout_alignStart="@+id/tv_bt_name_pager_bt_pair_code"/>
    <View
        android:background="@color/bg_color_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_marginTop="@dimen/dp_10"
        android:layout_below="@+id/tv_hint_pager_bt_pair_code"
        android:layout_marginStart="@dimen/dp_24"
        android:layout_marginEnd="@dimen/dp_24"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/text_color_main"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bt_pair_code"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_5">
            <TextView
                android:id="@+id/tv_pager_bt_pair_code_0"
                style="@style/tv_bt_pair_code"/>
            <TextView
                android:id="@+id/tv_pager_bt_pair_code_1"
                android:layout_marginStart="@dimen/dp_12"
                style="@style/tv_bt_pair_code"/>
            <TextView
                android:id="@+id/tv_pager_bt_pair_code_2"
                android:layout_marginStart="@dimen/dp_12"
                style="@style/tv_bt_pair_code"/>
            <TextView
                android:id="@+id/tv_pager_bt_pair_code_3"
                android:layout_marginStart="@dimen/dp_12"
                style="@style/tv_bt_pair_code"/>
            <TextView
                android:id="@+id/tv_pager_bt_pair_code_4"
                android:layout_marginStart="@dimen/dp_12"
                style="@style/tv_bt_pair_code"/>
            <TextView
                android:id="@+id/tv_pager_bt_pair_code_5"
                android:layout_marginStart="@dimen/dp_12"
                style="@style/tv_bt_pair_code"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_104"
        android:layout_alignParentBottom="true">
        <com.byd.mvp.ui.widget.BydInvalidButton
            android:id="@+id/btn_cancel_pager_bt_pair_code"
            android:text="@string/dialog_btn_cancel"
            style="@style/dialog_btn_cancel_dilink"/>
    </LinearLayout>
</RelativeLayout>
