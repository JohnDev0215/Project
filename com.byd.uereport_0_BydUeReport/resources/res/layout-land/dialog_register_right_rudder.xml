<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/include_dialog_mask"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/icon_register_dialog_register_landscape_bg"
        android:layout_width="@dimen/dp_848"
        android:layout_height="@dimen/dp_564"
        style="@style/dialog_content_no_bg">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/container_bind"
            android:layout_width="@dimen/dp_300"
            android:layout_height="@dimen/dp_516"
            android:layout_marginLeft="@dimen/dp_24"
            android:layout_marginTop="@dimen/dp_8"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_qr"
                android:background="@drawable/shape_bg_register_qr"
                android:padding="@dimen/dp_5"
                android:layout_width="@dimen/dp_160"
                android:layout_height="@dimen/dp_160"
                android:layout_marginTop="@dimen/dp_104"
                android:elevation="25dp"
                android:outlineSpotShadowColor="@color/transparent"
                android:outlineAmbientShadowColor="#b309101d"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/container_qr_expire"
                android:background="@drawable/shape_bg_qr_expire"
                android:visibility="gone"
                android:layout_width="@dimen/dp_160"
                android:layout_height="@dimen/dp_160"
                android:layout_marginTop="@dimen/dp_104"
                android:elevation="26dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="@dimen/dp_32"
                    android:layout_height="@dimen/dp_32"
                    android:layout_marginTop="@dimen/dp_50"
                    android:src="@drawable/icon_register_qr_refresh"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/color_dialog_register_qr_refresh_tip"
                    android:gravity="center_horizontal"
                    android:id="@+id/tv_refresh_qr_tip"
                    android:layout_width="@dimen/dp_150"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_90"
                    android:text="@string/register_bind_qr_refresh_tip"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/color_dialog_register_scan_qr_bind_tip"
                android:gravity="center_horizontal"
                android:id="@+id/tv_qr_tip"
                android:layout_width="@dimen/dp_260"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_29"
                android:text="@string/register_bind_qr_tip"
                app:layout_constraintEnd_toEndOf="@+id/iv_qr"
                app:layout_constraintStart_toStartOf="@+id/iv_qr"
                app:layout_constraintTop_toBottomOf="@+id/iv_qr"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_dialog_register_check_bind_tip"
                android:gravity="center_horizontal"
                android:layout_width="@dimen/dp_230"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:text="@string/register_open_setting_tip"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_qr_tip"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_check"
                android:layout_width="@dimen/dp_40"
                android:layout_height="@dimen/dp_40"
                android:layout_marginTop="@dimen/dp_458"
                android:src="@mipmap/check_normal_regular"
                app:layout_constraintEnd_toStartOf="@+id/tv_remind_later"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/color_dialog_register_remind_later_tip"
                android:id="@+id/tv_remind_later"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/register_remind_later"
                app:layout_constraintBottom_toBottomOf="@+id/iv_check"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iv_check"
                app:layout_constraintTop_toTopOf="@+id/iv_check"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/container_setting_process"
            android:visibility="visible"
            android:layout_width="@dimen/dp_300"
            android:layout_height="@dimen/dp_516"
            android:layout_marginLeft="@dimen/dp_24"
            android:layout_marginTop="@dimen/dp_8"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ProgressBar
                android:id="@+id/pb"
                android:layout_width="@dimen/dp_72"
                android:layout_height="@dimen/dp_72"
                android:layout_marginTop="@dimen/dp_204"
                android:indeterminateDrawable="@drawable/shape_register_loading"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_status"
                android:layout_width="@dimen/dp_72"
                android:layout_height="@dimen/dp_72"
                android:layout_marginTop="@dimen/dp_204"
                android:progressDrawable="@drawable/icon_register_success"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/color_dialog_register_progress_text"
                android:gravity="center_horizontal"
                android:id="@+id/tv_status"
                android:layout_width="@dimen/dp_128"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_290"
                android:text="@string/register_status_loading"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/container_setting_bind"
            android:visibility="visible"
            android:layout_width="@dimen/dp_300"
            android:layout_height="@dimen/dp_516"
            android:layout_marginLeft="@dimen/dp_24"
            android:layout_marginTop="@dimen/dp_8"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_qr3"
                android:background="@drawable/shape_bg_register_qr"
                android:padding="@dimen/dp_5"
                android:layout_width="@dimen/dp_160"
                android:layout_height="@dimen/dp_160"
                android:layout_marginTop="@dimen/dp_151"
                android:elevation="25dp"
                android:outlineSpotShadowColor="@color/transparent"
                android:outlineAmbientShadowColor="#b309101d"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/container_qr3_expire"
                android:background="@drawable/shape_bg_qr_expire"
                android:visibility="invisible"
                android:layout_width="@dimen/dp_160"
                android:layout_height="@dimen/dp_160"
                android:layout_marginTop="@dimen/dp_151"
                android:elevation="26dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="@dimen/dp_32"
                    android:layout_height="@dimen/dp_32"
                    android:layout_marginTop="@dimen/dp_50"
                    android:src="@drawable/icon_register_qr_refresh"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/color_dialog_register_qr_refresh_tip"
                    android:gravity="center_horizontal"
                    android:layout_width="@dimen/dp_150"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_90"
                    android:text="@string/register_bind_qr_refresh_tip"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/color_dialog_register_title"
                android:gravity="center_horizontal"
                android:id="@+id/tv_qr3_tip"
                android:layout_width="@dimen/dp_260"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_28"
                android:text="@string/register_bind_qr_tip"
                app:layout_constraintEnd_toEndOf="@+id/iv_qr3"
                app:layout_constraintStart_toStartOf="@+id/iv_qr3"
                app:layout_constraintTop_toBottomOf="@+id/iv_qr3"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_22"
            android:textColor="@color/color_dialog_register_scan_qr_bind_tip"
            android:gravity="center_vertical"
            android:id="@+id/tv_title"
            android:layout_width="@dimen/dp_400"
            android:layout_height="@dimen/dp_110"
            android:layout_marginLeft="@dimen/dp_372"
            android:layout_marginTop="@dimen/dp_68"
            android:layout_marginRight="@dimen/dp_105"
            android:text="@string/register_title"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.byd.uereport.widget.MaxHeightNestedScrollView
            android:scrollbarStyle="outsideInset"
            android:scrollbars="vertical"
            android:fadingEdge="vertical"
            android:fadingEdgeLength="@dimen/dp_30"
            android:layout_width="@dimen/dp_410"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_372"
            android:layout_marginTop="@dimen/dp_197"
            android:layout_marginRight="@dimen/dp_76"
            android:requiresFadingEdge="vertical"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:maxScrollViewHeight="@dimen/dp_231">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:orientation="vertical"
                android:paddingBottom="@dimen/dp_35"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/sp_18"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/tv_step1"
                    android:background="@drawable/shape_bg_register_step"
                    android:layout_width="@dimen/dp_26"
                    android:layout_height="@dimen/dp_26"
                    android:text="1"
                    android:includeFontPadding="false"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/sp_18"
                    android:textColor="@color/color_dialog_register_step_text"
                    android:id="@+id/tv_step1_content"
                    android:layout_width="@dimen/dp_360"
                    android:layout_height="wrap_content"
                    android:text="@string/register_step1_bind_text"
                    android:includeFontPadding="false"
                    android:layout_marginStart="@dimen/dp_14"
                    app:layout_constraintStart_toEndOf="@+id/tv_step1"
                    app:layout_constraintTop_toTopOf="@+id/tv_step1"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/sp_18"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/tv_step2"
                    android:background="@drawable/shape_bg_register_step"
                    android:layout_width="@dimen/dp_26"
                    android:layout_height="@dimen/dp_26"
                    android:layout_marginTop="@dimen/dp_46"
                    android:text="2"
                    android:includeFontPadding="false"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_step1_content"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/sp_18"
                    android:textColor="@color/color_dialog_register_step_text"
                    android:id="@+id/tv_step2_content"
                    android:layout_width="@dimen/dp_360"
                    android:layout_height="wrap_content"
                    android:text="@string/register_step2_bind_text"
                    android:includeFontPadding="false"
                    android:layout_marginStart="@dimen/dp_14"
                    app:layout_constraintStart_toEndOf="@+id/tv_step2"
                    app:layout_constraintTop_toTopOf="@+id/tv_step2"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/sp_18"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/tv_step3"
                    android:background="@drawable/shape_bg_register_step"
                    android:layout_width="@dimen/dp_26"
                    android:layout_height="@dimen/dp_26"
                    android:layout_marginTop="@dimen/dp_46"
                    android:text="3"
                    android:includeFontPadding="false"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_step2_content"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/sp_18"
                    android:textColor="@color/color_dialog_register_step_text"
                    android:id="@+id/tv_step3_content"
                    android:layout_width="@dimen/dp_360"
                    android:layout_height="wrap_content"
                    android:text="@string/register_step3_landscape_bind_text"
                    android:includeFontPadding="false"
                    android:layout_marginStart="@dimen/dp_14"
                    app:layout_constraintStart_toEndOf="@+id/tv_step3"
                    app:layout_constraintTop_toTopOf="@+id/tv_step3"/>
                <androidx.constraintlayout.widget.Group
                    android:id="@+id/group_step3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:constraint_referenced_ids="tv_step3,tv_step3_content"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.byd.uereport.widget.MaxHeightNestedScrollView>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_divider"
            android:background="@color/color_dialog_register_divider_line"
            android:layout_width="@dimen/dp_500"
            android:layout_height="@dimen/dp_1"
            android:layout_marginTop="@dimen/dp_448"
            android:layout_marginRight="@dimen/dp_24"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_bottom_qr2"
            android:background="@drawable/shape_bg_register_bottom_qr"
            android:padding="@dimen/dp_4"
            android:layout_width="@dimen/dp_52"
            android:layout_height="@dimen/dp_52"
            android:layout_marginRight="@dimen/dp_52"
            android:layout_marginBottom="@dimen/dp_52"
            android:elevation="25dp"
            android:outlineSpotShadowColor="@color/transparent"
            android:outlineAmbientShadowColor="#b309101d"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/color_dialog_register_scan_qr_bind_tip"
            android:gravity="center"
            android:id="@+id/tv_bottom_download_tip"
            android:layout_width="@dimen/dp_352"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/dp_20"
            android:text="@string/register_download_tip"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toBottomOf="@+id/iv_bottom_qr2"
            app:layout_constraintRight_toLeftOf="@+id/iv_bottom_qr2"
            app:layout_constraintTop_toTopOf="@+id/iv_bottom_qr2"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/group_bottom_download_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="iv_divider,iv_bottom_qr2,tv_bottom_download_tip"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_close"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:layout_marginTop="@dimen/dp_20"
            android:layout_marginRight="@dimen/dp_40"
            android:src="@drawable/icon_register_close"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>
