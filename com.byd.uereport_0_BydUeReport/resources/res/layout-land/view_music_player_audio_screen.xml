<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/view_music_player_audio_screen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_player_logo_name_audio_screen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_202">
            <ImageView
                android:id="@+id/iv_player_logo_audio_screen"
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_24"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/text_color_screensaver"
                android:id="@+id/tv_player_name_audio_screen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/dp_12"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/sp_32"
            android:textColor="@color/text_color_screensaver"
            android:ellipsize="marquee"
            android:gravity="center_horizontal"
            android:id="@+id/tv_song_name_audio_screen"
            android:layout_width="@dimen/dp_540"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:singleLine="true"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/text_color_screensaver"
            android:ellipsize="marquee"
            android:gravity="center_horizontal"
            android:id="@+id/tv_singer_name_audio_screen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_4"
            android:singleLine="true"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_operation_player_audio_screen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_50">
            <ImageView
                android:id="@+id/iv_previous_song_player_audio_screen"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:src="@drawable/icon_card_previous_48"/>
            <ImageView
                android:id="@+id/iv_stop_or_start_player_audio_screen"
                android:layout_width="@dimen/dp_60"
                android:layout_height="@dimen/dp_60"
                android:src="@drawable/icon_card_play_60"
                android:layout_marginStart="@dimen/dp_64"/>
            <ImageView
                android:id="@+id/iv_next_song_player_audio_screen"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:src="@drawable/icon_card_next_48"
                android:layout_marginStart="@dimen/dp_64"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
