<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:paddingStart="@dimen/dp_14">
        <RelativeLayout
            android:orientation="horizontal"
            android:layout_width="@dimen/dp_422"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_18"
            android:paddingStart="@dimen/dp_24">
            <com.byd.mvp.ui.widget.LengthMaxTextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_main"
                android:id="@+id/tv_setting_bt_name_bt_connected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_6"
                android:maxWidth="@dimen/dp_372"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/text_color_main_gray"
                android:id="@+id/tv_tips_no_contacts_bt_connected"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_2"
                android:text="@string/tips_bt_settings"
                android:layout_below="@+id/tv_setting_bt_name_bt_connected"
                android:layout_alignStart="@+id/tv_setting_bt_name_bt_connected"/>
        </RelativeLayout>
        <View
            android:background="@color/bg_color_line"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:layout_marginTop="@dimen/dp_10"
            android:layout_marginStart="@dimen/dp_24"
            android:layout_marginEnd="@dimen/dp_48"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_phone_audio_bt_connected"
            android:layout_width="@dimen/dp_422"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_14"
            android:minHeight="@dimen/dp_74"
            android:paddingStart="@dimen/dp_24"
            android:paddingEnd="@dimen/dp_24">
            <com.byd.base.view.BydSwitch
                android:id="@+id/switch_phone_audio_bt_connected"
                style="@style/byd_switch_on_service"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/ll_title_phone_audio_name_bt_connected"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                android:layout_marginBottom="@dimen/dp_10"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/dp_16">
                <TextView
                    android:textSize="@dimen/sp_20"
                    android:textColor="@color/text_color_main"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_9"
                    android:text="@string/phone_audio_name_bt"/>
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textColor="@color/text_color_main_gray"
                    android:id="@+id/tv_phone_audio_description_bt_connected"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_2"
                    android:text="@string/phone_audio_description_bt"/>
            </LinearLayout>
        </LinearLayout>
        <View
            android:background="@color/bg_color_line"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:layout_marginStart="@dimen/dp_24"
            android:layout_marginEnd="@dimen/dp_48"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_media_bt_connected"
            android:layout_width="@dimen/dp_422"
            android:layout_height="@dimen/dp_74"
            android:layout_marginTop="@dimen/dp_4"
            android:paddingStart="@dimen/dp_24"
            android:paddingEnd="@dimen/dp_24">
            <com.byd.base.view.BydSwitch
                android:id="@+id/switch_media_bt_connected"
                style="@style/byd_switch_on_service"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/ll_title_media_name_bt_connected"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/dp_16">
                <TextView
                    android:textSize="@dimen/sp_20"
                    android:textColor="@color/text_color_main"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/media_name_bt"/>
            </LinearLayout>
        </LinearLayout>
        <View
            android:background="@color/bg_color_line"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:layout_marginStart="@dimen/dp_24"
            android:layout_marginEnd="@dimen/dp_48"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_net_share_bt_connected"
            android:layout_width="@dimen/dp_422"
            android:layout_height="@dimen/dp_74"
            android:layout_marginTop="@dimen/dp_4"
            android:paddingStart="@dimen/dp_24">
            <com.byd.base.view.BydSwitch
                android:id="@+id/switch_net_share_bt_connected"
                style="@style/byd_switch_on_service"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/ll_title_net_share_name_bt_connected"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/dp_16">
                <TextView
                    android:textSize="@dimen/sp_20"
                    android:textColor="@color/text_color_main"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_9"
                    android:text="@string/net_share_name_bt"/>
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textColor="@color/text_color_main_gray"
                    android:id="@+id/tv_net_share_description_bt_connected"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_2"
                    android:text="@string/net_share_description_bt"/>
            </LinearLayout>
        </LinearLayout>
        <View
            android:background="@color/bg_color_line"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:layout_marginStart="@dimen/dp_24"
            android:layout_marginEnd="@dimen/dp_48"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_operation_bottom_bt_connected"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_104"
        android:layout_marginRight="@dimen/dp_10"
        android:layout_alignParentBottom="true">
        <TextView
            android:id="@+id/btn_disconnect_bt_connected"
            android:padding="0dp"
            android:text="@string/disconnect_bt"
            style="@style/dialog_btn_cancel_dilink_bt"/>
        <TextView
            android:id="@+id/btn_remove_bt_connected"
            android:padding="0dp"
            android:text="@string/remove_bt"
            android:layout_marginStart="@dimen/dp_40"
            style="@style/dialog_btn_cancel_dilink_bt"/>
    </LinearLayout>
</RelativeLayout>
