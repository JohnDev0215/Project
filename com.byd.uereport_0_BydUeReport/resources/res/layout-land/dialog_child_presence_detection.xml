<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_width="@dimen/dp_427"
        android:layout_height="@dimen/dp_533"
        android:layout_marginLeft="@dimen/dp_88"
        android:layout_marginTop="@dimen/dp_147"
        android:src="@drawable/icon_child_seat"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_warning"
        android:layout_width="@dimen/dp_120"
        android:layout_height="@dimen/dp_120"
        android:layout_marginLeft="@dimen/dp_826"
        android:layout_marginTop="@dimen/dp_114"
        android:src="@drawable/icon_warning"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_28"
        android:textColor="@color/text_color_cpd_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:text="@string/text_cpd_warning_title"
        app:layout_constraintEnd_toEndOf="@+id/iv_warning"
        app:layout_constraintStart_toStartOf="@+id/iv_warning"
        app:layout_constraintTop_toBottomOf="@+id/iv_warning"/>
    <TextView
        android:textSize="@dimen/sp_32"
        android:textColor="@color/text_color_cpd_tip"
        android:gravity="center_horizontal"
        android:layout_width="@dimen/dp_588"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_352"
        android:layout_marginRight="@dimen/dp_100"
        android:text="@string/text_cpd_tip"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <Button
        android:textSize="@dimen/sp_18"
        android:textColor="@color/text_color_cpd_exit"
        android:gravity="center"
        android:id="@+id/btn_exit"
        android:background="@drawable/shape_bg_cpd_text_exit"
        android:paddingLeft="@dimen/dp_10"
        android:paddingRight="@dimen/dp_10"
        android:focusable="true"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_60"
        android:layout_marginTop="@dimen/dp_568"
        android:text="@string/text_cpd_exit"
        android:textAllCaps="false"
        app:layout_constraintLeft_toLeftOf="@+id/iv_warning"
        app:layout_constraintRight_toRightOf="@+id/iv_warning"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
