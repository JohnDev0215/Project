<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:paddingStart="@dimen/dp_14"
        android:paddingEnd="@dimen/dp_24">
        <RelativeLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_56"
            android:paddingStart="@dimen/dp_9">
            <com.byd.mvp.ui.widget.LengthMaxTextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/text_color_main"
                android:id="@+id/tv_wifi_name_pager_wifi_connecting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/dp_390"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_320"
            android:layout_marginTop="@dimen/dp_25">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true">
                <ImageView
                    android:id="@+id/iv_connecting_pager_wifi_connecting"
                    android:background="@drawable/icon_public_loading_72"
                    android:layout_width="@dimen/dp_72"
                    android:layout_height="@dimen/dp_72"/>
                <TextView
                    android:textSize="@dimen/sp_18"
                    android:textColor="@color/text_color_rbtn_main"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:text="@string/connecting_wireless"/>
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_104"
        android:layout_alignParentBottom="true">
        <com.byd.mvp.ui.widget.BydInvalidButton
            android:id="@+id/btn_cancel_pager_wifi_connecting"
            android:text="@string/dialog_btn_cancel"
            style="@style/dialog_btn_cancel_dilink"/>
    </LinearLayout>
</RelativeLayout>
