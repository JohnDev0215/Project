<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_connected_device_wifi_left"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_60">
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/text_color_gray_bt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/connected_wireless"
            android:layout_marginStart="@dimen/dp_24"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/rl_connected_device_wifi_left"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_60">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/iv_icon_connected_device_wifi_left"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/dp_16"
                android:layout_alignParentStart="true"/>
            <com.byd.mvp.ui.widget.LengthMaxTextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/text_color_main"
                android:id="@+id/tv_name_connected_device_wifi_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/dp_200"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@+id/iv_icon_connected_device_wifi_left"/>
            <ImageView
                android:id="@+id/iv_detail_connected_device_wifi_left"
                android:background="@drawable/icon_public_details_48"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/dp_16"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <View
            android:id="@+id/v_item_bg_item_connected_device_wifi_left"
            android:background="@drawable/bg_frame_blue_content_transparent_00"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </RelativeLayout>
</LinearLayout>
