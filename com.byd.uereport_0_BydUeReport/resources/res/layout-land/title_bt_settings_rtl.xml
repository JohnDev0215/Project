<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_back_bt"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        android:src="@drawable/icon_public_close_48"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="@color/text_color_main"
        android:gravity="end|center_vertical"
        android:id="@+id/tv_title_bt"
        android:layout_width="@dimen/dp_176"
        android:layout_height="@dimen/dp_29"
        android:text="@string/bluetooth_link"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/dp_2"
        android:layout_toEndOf="@+id/iv_back_bt"/>
    <com.byd.base.view.BydSwitch
        android:id="@+id/switch_title_bt_state_bt"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/dp_360"
        android:layout_alignParentStart="true"
        style="@style/byd_switch_on_service"/>
    <com.byd.mvp.ui.widget.TintImageView
        android:id="@+id/iv_right_local_device_bt"
        android:background="@drawable/icon_public_edit_48"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/dp_16"
        android:layout_alignParentEnd="true"
        app:color_close_state="@color/text_color_main_gray"
        app:color_open_state="@color/text_color_main"/>
    <RelativeLayout
        android:id="@+id/rl_title_bt_name_bt"
        android:background="@drawable/bg_frame_blue_content_transparent_00"
        android:visibility="gone"
        android:layout_width="@dimen/dp_310"
        android:layout_height="@dimen/dp_48"
        android:layout_centerVertical="true"
        android:layoutDirection="rtl"
        android:layout_toStartOf="@+id/iv_right_local_device_bt">
        <com.byd.mvp.ui.widget.NoMenuEditText
            android:textSize="@dimen/sp_18"
            android:textColor="@color/text_color_main"
            android:textColorHint="@color/text_color_main_gray"
            android:id="@+id/et_local_device_bt_name_bt"
            android:background="@color/transparent_00"
            android:layout_width="@dimen/dp_310"
            android:layout_height="@dimen/dp_42"
            android:singleLine="true"
            android:maxLength="30"
            android:layout_centerVertical="true"
            android:imeOptions="actionDone"
            android:paddingStart="@dimen/dp_18"
            android:paddingEnd="@dimen/dp_56"
            android:layout_alignParentStart="true"/>
        <ImageView
            android:id="@+id/iv_close_edit_bt"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:src="@drawable/icon_public_close_edit_48"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp_6"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <com.byd.mvp.ui.widget.LengthMaxTextView
        android:textSize="@dimen/sp_22"
        android:textColor="@color/text_color_main"
        android:gravity="end"
        android:id="@+id/tv_local_device_bt_name_bt"
        android:layout_width="@dimen/dp_310"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@+id/iv_right_local_device_bt"/>
</RelativeLayout>
