<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_60"
    android:minHeight="@dimen/dp_60">
    <RelativeLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_alignParentStart="true">
        <ImageView
            android:id="@+id/iv_bt_type_item_bond_bt_list"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_toEndOf="@+id/iv_bt_type_item_bond_bt_list">
            <com.byd.mvp.ui.widget.LengthMaxTextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/text_color_main_dilink_pagers"
                android:gravity="start"
                android:id="@+id/tv_bt_name_item_bond_bt_list"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/dp_200"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/text_color_main_dilink_pagers"
                android:gravity="start"
                android:id="@+id/tv_bt_connect_state_item_bond_bt_list"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </RelativeLayout>
    <ImageView
        android:id="@+id/iv_delete_connected_item_bond_bt_list"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/dp_16"
        android:layout_alignParentEnd="true"/>
    <ImageView
        android:id="@+id/iv_bg_item_bond_bt_list"
        android:background="@drawable/bg_frame_blue_content_transparent_00"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:background="@color/bg_color_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/dp_24"
        android:layout_marginEnd="@dimen/dp_24"/>
</RelativeLayout>
