<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/img_high_temp_sterilization_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">
    <TextView
        android:textSize="@dimen/sp_60"
        android:textColor="@color/dialog_common_text_title"
        android:gravity="center_horizontal"
        android:id="@+id/tv_title_high_temp_sterilization"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_108"
        android:text="@string/title_high_temp_sterilization_ing"
        android:maxLines="2"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="@dimen/dp_48"
        android:layout_marginEnd="@dimen/dp_48"/>
    <TextView
        android:textSize="@dimen/sp_28"
        android:textColor="@color/dialog_common_text_tips"
        android:id="@+id/tv_remain_time_tips"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_60"
        android:text="@string/high_temp_sterilization_remain_time"
        android:layout_below="@+id/tv_title_high_temp_sterilization"
        android:layout_centerHorizontal="true"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_remain_time_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_63"
        android:layout_below="@+id/tv_title_high_temp_sterilization"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="@dimen/sp_120"
            android:textColor="@color/dialog_cancle_textcolor"
            android:id="@+id/tv_remain_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10"/>
        <TextView
            android:textSize="@dimen/sp_28"
            android:textColor="@color/dialog_cancle_textcolor"
            android:id="@+id/tv_remain_time_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_25"
            android:text="@string/high_temp_sterilization_remain_time_minute"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/sp_30"
        android:textColor="@color/dialog_common_text_title"
        android:id="@+id/tv_content"
        android:layout_width="@dimen/dp_845"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_271"
        android:text="@string/high_temp_sterilization_content"
        android:layout_below="@+id/tv_title_high_temp_sterilization"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
