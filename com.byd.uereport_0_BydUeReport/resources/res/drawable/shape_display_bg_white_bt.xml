<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <padding android:top="@dimen/dp_1"/>
            <solid android:color="@color/display_dialog_stroke_color"/>
            <corners android:radius="@dimen/dp_8"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <padding android:left="@dimen/dp_1"/>
            <solid android:color="@color/display_dialog_stroke_color"/>
            <corners android:radius="@dimen/dp_8"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <padding android:right="@dimen/dp_1"/>
            <solid android:color="@color/display_dialog_stroke_color"/>
            <corners android:radius="@dimen/dp_8"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <padding android:bottom="@dimen/dp_1"/>
            <solid android:color="@color/display_dialog_stroke_color"/>
            <corners android:radius="@dimen/dp_8"/>
        </shape>
    </item>
    <item>
        <shape
            android:shape="rectangle"
            android:useLevel="false">
            <solid android:color="@color/display_dialog_solid_color"/>
            <padding
                android:left="@dimen/dp_10"
                android:top="@dimen/dp_10"
                android:right="@dimen/dp_10"
                android:bottom="@dimen/dp_10"/>
            <corners android:radius="@dimen/dp_8"/>
        </shape>
    </item>
