<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/usb_shape_dialog_bg"
    android:layout_width="@dimen/dp_800"
    android:layout_height="@dimen/dp_544">
    <TextView
        android:id="@+id/dialog_title"
        android:text="@string/usb_title_upgrade"
        style="@style/usb_dialog_title"/>
    <TextView style="@style/usb_dialog_title_divider"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="?attr/usb_normal_text_color"
        android:id="@+id/tv_tip1"
        android:layout_width="@dimen/dp_416"
        android:layout_height="@dimen/dp_195"
        android:layout_marginTop="@dimen/dp_112"
        android:text="@string/usb_upgrade_tip_land"
        android:layout_marginStart="@dimen/dp_48"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="?attr/usb_normal_text_color"
        android:gravity="center_vertical"
        android:id="@+id/tv_tip2"
        android:layout_width="@dimen/dp_416"
        android:layout_height="@dimen/dp_52"
        android:layout_marginTop="@dimen/dp_268"
        android:text="@string/usb_upgrade_pad_tip_land"
        android:layout_alignStart="@+id/tv_tip1"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="?attr/usb_update_info_time_color"
        android:id="@+id/tv_tip3"
        android:layout_width="@dimen/dp_416"
        android:layout_height="@dimen/dp_52"
        android:layout_marginTop="@dimen/dp_312"
        android:text="@string/usb_update_time_take_land"
        android:layout_alignStart="@+id/tv_tip1"/>
    <ImageView
        android:id="@+id/iv_icon"
        android:layout_width="@dimen/dp_120"
        android:layout_height="@dimen/dp_120"
        android:layout_marginTop="@dimen/dp_112"
        android:layout_marginStart="@dimen/dp_402"/>
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="?attr/usb_normal_text_color"
        android:gravity="center"
        android:id="@+id/tv_thanks"
        android:layout_width="@dimen/dp_80"
        android:layout_height="@dimen/dp_29"
        android:layout_marginTop="@dimen/dp_256"
        android:text="@string/usb_upgrade_thanks"
        android:layout_marginStart="@dimen/dp_600"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="?attr/usb_dialog_text_color_gray"
        android:gravity="center_horizontal"
        android:id="@+id/tv_thanks_detail"
        android:layout_width="@dimen/dp_224"
        android:layout_height="@dimen/dp_80"
        android:layout_marginTop="@dimen/dp_285"
        android:text="@string/usb_version_from_land"
        android:layout_marginStart="@dimen/dp_528"/>
    <Button
        android:id="@+id/upgrade_immediately"
        android:layout_width="@dimen/dp_160"
        android:text="@string/usb_upgrade_immediately"
        android:layout_marginStart="@dimen/dp_46"
        style="@style/two_actionBtn"/>
    <Button
        android:id="@+id/upgrade_order"
        android:layout_width="@dimen/dp_160"
        android:text="@string/usb_upgrade_order"
        android:layout_centerHorizontal="true"
        style="@style/two_actionBtn_cancel"/>
    <Button
        android:id="@+id/not_update_now"
        android:layout_width="@dimen/dp_160"
        android:text="@string/usb_not_update_now"
        android:layout_marginEnd="@dimen/dp_46"
        android:layout_alignParentEnd="true"
        style="@style/two_actionBtn_cancel"/>
</RelativeLayout>
