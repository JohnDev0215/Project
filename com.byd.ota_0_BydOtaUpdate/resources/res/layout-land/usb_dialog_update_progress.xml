<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/usb_shape_dialog_bg"
    android:layout_width="@dimen/dp_1280"
    android:layout_height="@dimen/dp_652">
    <TextView
        android:textSize="@dimen/sp_30"
        android:textColor="?attr/usb_sub_normal_text_color"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_46"
        android:layout_marginTop="@dimen/dp_190"
        android:text="@string/usb_update"
        android:layout_centerHorizontal="true"/>
    <ProgressBar
        android:id="@+id/update_progress_bar"
        android:layout_width="@dimen/dp_830"
        android:layout_height="@dimen/dp_6"
        android:layout_marginTop="@dimen/dp_265"
        android:indeterminate="false"
        android:indeterminateDrawable="@drawable/usb_progressbar_indeterminate_update"
        android:layout_centerHorizontal="true"
        style="@style/progressBar_horizontal_update"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_278"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="@dimen/sp_24"
            android:textColor="?attr/usb_update_progress_head"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/usb_update_info1_head"/>
        <TextView
            android:textSize="@dimen/sp_24"
            android:textColor="?attr/usb_update_progress_num"
            android:gravity="center"
            android:id="@+id/update_progress_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="@dimen/sp_24"
            android:textColor="?attr/usb_update_progress_head"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/usb_update_info1_tail"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="?attr/usb_update_progress_info_color"
        android:gravity="left"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_360"
        android:text="@string/usb_update_info3"
        android:layout_marginStart="@dimen/dp_280"/>
</RelativeLayout>
