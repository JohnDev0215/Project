<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/file_bg"
    android:background="@drawable/usb_shape_dialog_bg"
    android:layout_width="@dimen/dp_640"
    android:layout_height="@dimen/dp_72">
    <ImageView
        android:id="@+id/state_check"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/usb_choice_update_file_image"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/dp_16"/>
    <ImageView
        android:id="@+id/state_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_8"
        android:layout_toRightOf="@+id/state_check"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="?attr/usb_normal_text_color"
        android:id="@+id/file_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_toRightOf="@+id/state_image"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="?attr/usb_sub_normal_text_color"
        android:id="@+id/file_size"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/dp_23"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
</RelativeLayout>
