<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.byd.ota.view.widget.FlowRadioGroup
        android:orientation="horizontal"
        android:id="@+id/ota_print_file_radio_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <Button
        android:id="@+id/ota_print_file_confirm_btn"
        android:layout_marginTop="@dimen/dp_10"
        android:text="打印"
        android:textAllCaps="false"
        android:layout_marginStart="@dimen/dp_20"
        style="@style/confirmTestBtn"/>
    <ScrollView
        android:scrollbarSize="@dimen/dp_4"
        android:scrollbarThumbVertical="@drawable/scrollbar_thumb_vertical"
        android:scrollbarTrackVertical="@drawable/scrollbar_track_vertical"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_20"
        android:fadeScrollbars="false">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="?attr/normal_text_color"
                android:gravity="left"
                android:id="@+id/ota_print_file_result_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
