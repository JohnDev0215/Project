<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/shape_dialog_bg"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/sp_12"
        android:textStyle="bold"
        android:textColor="?attr/normal_text_color"
        android:gravity="center"
        android:id="@+id/dialog_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_39"
        android:text="循环升级"/>
    <View
        android:id="@+id/dialog_title_divider"
        style="@style/dialog_title_divider"/>
    <TextView
        android:textSize="@dimen/sp_10"
        android:textColor="?attr/normal_text_color"
        android:gravity="center"
        android:id="@+id/dialog_message"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_60"
        android:text="result"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_60">
        <Button
            android:textSize="@dimen/sp_10"
            android:textColor="?attr/confirm_btn_text_color"
            android:id="@+id/action_left_btn"
            android:background="@drawable/selector_confirm_btn"
            android:layout_width="@dimen/dp_105"
            android:layout_height="@dimen/dp_30"
            android:text="停止循环"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/dp_20"
            android:layout_alignParentStart="true"
            android:stateListAnimator="@drawable/anim_btn_scale"/>
        <Button
            android:textSize="@dimen/sp_10"
            android:textColor="?attr/confirm_btn_text_color"
            android:id="@+id/action_right_btn"
            android:background="@drawable/selector_confirm_btn"
            android:layout_width="@dimen/dp_105"
            android:layout_height="@dimen/dp_30"
            android:text="关闭弹框"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp_20"
            android:layout_alignParentEnd="true"
            android:stateListAnimator="@drawable/anim_btn_scale"/>
    </RelativeLayout>
</LinearLayout>
