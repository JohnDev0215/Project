<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <Button
                android:id="@+id/button1"
                android:background="@drawable/button_select"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="进入OTA模式测试"
                android:layout_marginStart="10dp"/>
            <Button
                android:id="@+id/button2"
                android:background="@drawable/button_select"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="非OTA模式测试"
                android:layout_marginStart="10dp"/>
            <Button
                android:id="@+id/button3"
                android:background="@drawable/button_select"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="筛选ECU"
                android:layout_marginStart="10dp"/>
            <Button
                android:id="@+id/button4"
                android:background="@drawable/button_select"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="筛选ECU同步最新策略文件"
                android:layout_marginStart="10dp"/>
            <Button
                android:id="@+id/button100"
                android:background="@drawable/button_select"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="打开跳过解密测试升级"
                android:layout_marginStart="10dp"/>
            <Button
                android:id="@+id/button101"
                android:background="@drawable/button_select"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="关闭跳过解密测试升级"
                android:layout_marginStart="10dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <Button
                android:id="@+id/button5"
                android:background="@drawable/button_select"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="进入测试模式"
                android:layout_marginStart="20dp"/>
            <Button
                android:id="@+id/button6"
                android:background="@drawable/button_select"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="退出进入测试模式"
                android:layout_marginStart="10dp"/>
            <Button
                android:id="@+id/button7"
                android:background="@drawable/button_select"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="调出OTA应用测试界面"
                android:layout_marginStart="10dp"/>
            <Button
                android:id="@+id/button8"
                android:background="@drawable/button_select"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="打开调试"
                android:layout_marginStart="10dp"/>
            <Button
                android:id="@+id/button9"
                android:background="@drawable/button_select"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="关闭调试"
                android:layout_marginStart="10dp"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
