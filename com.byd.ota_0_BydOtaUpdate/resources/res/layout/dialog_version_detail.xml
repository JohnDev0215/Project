<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/shape_dialog_bg"
    android:layout_width="@dimen/dp_656"
    android:layout_height="@dimen/dp_544">
    <TextView
        android:id="@+id/dialog_title"
        android:text="@string/version_detail_title"
        style="@style/dialog_title"/>
    <View
        android:id="@+id/dialog_title_divider"
        style="@style/dialog_title_divider"/>
    <ScrollView
        android:scrollbarSize="@dimen/dp_4"
        android:scrollbarThumbVertical="@drawable/scrollbar_thumb_vertical"
        android:scrollbarTrackVertical="@drawable/scrollbar_track_vertical"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_312"
        android:fadeScrollbars="false"
        android:layout_marginEnd="@dimen/dp_9">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="?attr/normal_text_color"
                android:id="@+id/function_addition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_40"
                android:text="@string/function_addition"
                android:layout_marginStart="@dimen/dp_39"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="?attr/notice_text_color"
                android:id="@+id/function_addition_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/dp_39"
                android:paddingVertical="@dimen/dp_6"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="?attr/normal_text_color"
                android:id="@+id/function_optimization"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:text="@string/function_optimization"
                android:layout_marginStart="@dimen/dp_39"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="?attr/notice_text_color"
                android:id="@+id/function_optimization_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/dp_39"
                android:paddingVertical="@dimen/dp_6"/>
        </LinearLayout>
    </ScrollView>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_104"
        android:layout_marginTop="@dimen/dp_36"
        android:layout_marginBottom="@dimen/dp_20">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/have_read"
            android:text="@string/have_read"
            android:layout_centerInParent="true"
            style="@style/confirmBtn"/>
    </RelativeLayout>
</LinearLayout>
