<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/usb_shape_dialog_bg"
    android:layout_width="@dimen/dp_560"
    android:layout_height="@dimen/dp_312">
    <TextView
        android:id="@+id/dialog_title"
        android:text="@string/usb_upgrade_interrupt"
        style="@style/usb_dialog_title"/>
    <TextView
        android:layout_below="@+id/dialog_title"
        style="@style/usb_dialog_title_divider"/>
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="?attr/usb_dialog_text_color_gray"
        android:gravity="center"
        android:id="@+id/dialog_message_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_26"
        android:layout_marginTop="@dimen/dp_112"
        android:text="@string/usb_upgrade_interrupt_condition"
        android:layout_marginStart="@dimen/dp_48"/>
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="?attr/usb_normal_text_color"
        android:gravity="center"
        android:id="@+id/dialog_message_detail"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_70"
        android:layout_marginTop="@dimen/dp_146"
        android:text="@string/usb_upgrade_interrupt_detail"
        android:layout_marginStart="@dimen/dp_48"/>
    <Button
        android:id="@+id/normal_dialog_i_know"
        android:layout_width="160dp"
        style="@style/actionBtn"/>
</RelativeLayout>
