<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/shape_dialog_bg"
    android:layout_width="@dimen/dp_656"
    android:layout_height="@dimen/dp_544">
    <TextView
        android:id="@+id/dialog_title"
        android:text="@string/update_info_title"
        style="@style/dialog_title"/>
    <View
        android:id="@+id/dialog_title_divider"
        style="@style/dialog_title_divider"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/content_ll"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_300"
        android:layout_marginTop="@dimen/dp_40">
        <ScrollView
            android:scrollbarSize="@dimen/dp_4"
            android:scrollbarThumbVertical="@drawable/scrollbar_thumb_vertical"
            android:scrollbarTrackVertical="@drawable/scrollbar_track_vertical"
            android:scrollbars="vertical"
            android:layout_width="@dimen/dp_409"
            android:layout_height="match_parent"
            android:fadeScrollbars="false">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/content_left_ll"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textColor="?attr/normal_text_color"
                    android:id="@+id/tv_tip1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/update_info_tips_EV_DM"
                    android:layout_marginStart="@dimen/dp_36"/>
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textColor="?attr/notice_text_color"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_tip2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:text="@string/update_info_pad_tips"
                    android:layout_marginStart="@dimen/dp_36"/>
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textColor="?attr/update_info_time_color"
                    android:id="@+id/tv_tip3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:text="@string/update_info_time_take"
                    android:layout_marginStart="@dimen/dp_36"/>
            </LinearLayout>
        </ScrollView>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/content_right_ll"
            android:layout_width="@dimen/dp_247"
            android:layout_height="match_parent">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_icon"
                android:layout_width="@dimen/dp_148"
                android:layout_height="@dimen/dp_148"
                android:src="@mipmap/img_ota_update_info"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="?attr/normal_text_color"
                android:layout_gravity="center"
                android:id="@+id/tv_thanks"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_29"
                android:layout_marginTop="@dimen/dp_12"
                android:text="@string/update_info_thanks"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="?attr/notice_text_color"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/tv_thanks_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_6"
                android:text="@string/update_info_version_from"/>
        </LinearLayout>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/container_btn_rl"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_104"
        android:layout_marginTop="20dp">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/upgrade_immediately"
            android:text="@string/immediately_update"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/dp_40"
            android:layout_alignParentStart="true"
            style="@style/confirmBtn"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/upgrade_order"
            android:text="@string/appointment_update"
            android:layout_centerInParent="true"
            android:layout_centerVertical="true"
            style="@style/cancelBtn"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/not_update_now"
            android:text="@string/not_now_update"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp_40"
            android:layout_alignParentEnd="true"
            style="@style/cancelBtn"/>
    </RelativeLayout>
</LinearLayout>
