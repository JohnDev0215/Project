<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/usb_shape_dialog_bg"
    android:layout_width="@dimen/dp_560"
    android:layout_height="@dimen/dp_312">
    <TextView
        android:id="@+id/dialog_title"
        android:text="@string/usb_checked_update_file"
        style="@style/usb_dialog_title"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RadioGroup
            android:id="@+id/update_file_radio_group"
            android:background="?attr/usb_red_tips"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="?attr/usb_normal_text_color"
        android:gravity="center"
        android:id="@+id/dialog_message"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_70"
        android:layout_centerInParent="true"/>
    <Button
        android:id="@+id/action_confirm"
        android:text="@string/update"
        android:layout_marginStart="@dimen/dp_80"
        android:layout_alignParentStart="true"
        style="@style/two_actionBtn"/>
    <Button
        android:id="@+id/action_cancel"
        android:text="@string/usb_cancel"
        android:layout_marginEnd="@dimen/dp_80"
        android:layout_alignParentEnd="true"
        style="@style/two_actionBtn_cancel"/>
</RelativeLayout>
