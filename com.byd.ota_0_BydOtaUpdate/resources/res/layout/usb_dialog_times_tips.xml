<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/usb_shape_dialog_bg"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="?attr/usb_normal_text_color"
        android:gravity="center"
        android:id="@+id/dialog_message"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_50"
        android:text="@string/usb_auto_upgrade"/>
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="?attr/usb_update_info_time_color"
        android:gravity="center"
        android:id="@+id/dialog_close"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_50"
        android:text="@string/usb_cancel"
        android:layout_toRightOf="@+id/dialog_message"/>
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="?attr/usb_normal_text_color"
        android:gravity="center"
        android:id="@+id/dialog_end"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_50"
        android:text="@string/usb_end_upgrade"
        android:layout_toRightOf="@+id/dialog_close"/>
</RelativeLayout>
