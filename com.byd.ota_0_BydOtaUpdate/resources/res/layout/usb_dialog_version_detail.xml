<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/usb_shape_dialog_bg"
    android:layout_width="@dimen/dp_560"
    android:layout_height="@dimen/dp_312">
    <TextView
        android:id="@+id/dialog_title"
        android:text="@string/usb_version_detail_title"
        style="@style/usb_dialog_title"/>
    <TextView
        android:layout_below="@+id/dialog_title"
        style="@style/usb_dialog_title_divider"/>
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="?attr/usb_normal_text_color"
        android:gravity="left"
        android:id="@+id/dialog_message"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_70"
        android:layout_centerInParent="true"
        android:fadeScrollbars="false"
        android:paddingStart="@dimen/dp_48"/>
    <Button
        android:id="@+id/have_read"
        android:text="@string/usb_have_read"
        style="@style/actionBtn"/>
</RelativeLayout>
