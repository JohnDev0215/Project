<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/usb_shape_dialog_bg"
    android:layout_width="@dimen/dp_560"
    android:layout_height="@dimen/dp_312">
    <TextView
        android:id="@+id/dialog_title"
        android:text="@string/usb_checked_update_file"
        style="@style/usb_dialog_title"/>
    <TextView
        android:layout_below="@+id/dialog_title"
        style="@style/usb_dialog_title_divider"/>
    <RadioGroup
        android:id="@+id/update_file_radio_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_104">
        <RadioButton
            android:textSize="@dimen/sp_18"
            android:textColor="@color/radio_button"
            android:id="@+id/otaItem"
            android:paddingLeft="@dimen/dp_4"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_40"
            android:button="@drawable/usb_check_update_file_radio_btn"
            android:text="@string/usb_ota_update"
            android:layout_marginStart="@dimen/dp_48"/>
        <RadioButton
            android:textSize="@dimen/sp_18"
            android:textColor="@color/radio_button"
            android:id="@+id/usbItem"
            android:paddingLeft="@dimen/dp_4"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_40"
            android:button="@drawable/usb_check_update_file_radio_btn"
            android:text="@string/usb_update"
            android:layout_marginStart="@dimen/dp_48"/>
    </RadioGroup>
    <Button
        android:id="@+id/action_confirm"
        android:text="@string/usb_confirm"
        android:layout_marginStart="@dimen/dp_80"
        android:layout_alignParentStart="true"
        style="@style/two_actionBtn"/>
    <Button
        android:id="@+id/action_cancel"
        android:text="@string/usb_cancel"
        android:layout_marginEnd="@dimen/dp_80"
        android:layout_alignParentEnd="true"
        style="@style/two_actionBtn_cancel"/>
</RelativeLayout>
