<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/shape_dialog_bg"
    android:layout_width="@dimen/dp_560"
    android:layout_height="@dimen/dp_312">
    <TextView
        android:textStyle="bold"
        android:id="@+id/dialog_title"
        android:text="@string/normal_title"
        style="@style/dialog_title"/>
    <View
        android:id="@+id/dialog_title_divider"
        style="@style/dialog_title_divider"/>
    <ScrollView
        android:scrollbarSize="@dimen/dp_4"
        android:scrollbarThumbVertical="@drawable/scrollbar_thumb_vertical"
        android:scrollbarTrackVertical="@drawable/scrollbar_track_vertical"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_112"
        android:layout_marginTop="@dimen/dp_24"
        android:fillViewport="true"
        android:fadeScrollbars="false"
        android:layout_marginEnd="@dimen/dp_9">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="?attr/normal_text_color"
                android:gravity="center"
                android:id="@+id/dialog_message"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="@dimen/dp_48"/>
        </LinearLayout>
    </ScrollView>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_104">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/dialog_confirm_btn"
            android:text="@string/confirm"
            android:layout_centerInParent="true"
            style="@style/confirmBtn"/>
    </RelativeLayout>
</LinearLayout>
