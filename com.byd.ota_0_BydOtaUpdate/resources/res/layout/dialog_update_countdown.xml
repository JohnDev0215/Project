<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/shape_dialog_bg"
    android:layout_width="@dimen/dp_560"
    android:layout_height="@dimen/dp_352">
    <TextView
        android:id="@+id/dialog_title"
        android:text="@string/update_deadline_title"
        style="@style/dialog_title"/>
    <View
        android:id="@+id/dialog_title_divider"
        style="@style/dialog_title_divider"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_152"
        android:layout_marginTop="@dimen/dp_24">
        <TextView
            android:textSize="@dimen/sp_32"
            android:textColor="?attr/update_info_time_color"
            android:gravity="center"
            android:id="@+id/dialog_time"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_35"
            android:layout_marginTop="@dimen/dp_48"
            android:paddingHorizontal="@dimen/dp_64"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="?attr/red_tips"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_14"
            android:text="@string/update_deadline_tips"
            android:paddingHorizontal="@dimen/dp_48"/>
    </LinearLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_104">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/upgrade_immediately"
            android:text="@string/immediately_update"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/dp_80"
            android:layout_alignParentStart="true"
            style="@style/confirmBtn"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/cancel_update"
            android:text="@string/cancel_update"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp_80"
            android:layout_alignParentEnd="true"
            style="@style/cancelBtn"/>
    </RelativeLayout>
</LinearLayout>
