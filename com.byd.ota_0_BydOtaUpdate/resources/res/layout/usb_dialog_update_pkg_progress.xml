<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/usb_shape_dialog_bg"
    android:layout_width="@dimen/dp_560"
    android:layout_height="@dimen/dp_312">
    <TextView
        android:id="@+id/dialog_title"
        android:text="@string/usb_normal_title"
        style="@style/usb_dialog_title"/>
    <TextView
        android:layout_below="@+id/dialog_title"
        style="@style/usb_dialog_title_divider"/>
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="?attr/usb_normal_text_color"
        android:gravity="center"
        android:id="@+id/dialog_message_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_112"
        android:text="@string/usb_upgrade_download"/>
    <TextView
        android:textSize="@dimen/sp_22"
        android:textColor="?attr/usb_normal_text_color"
        android:gravity="center"
        android:id="@+id/download_progress_number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_158"/>
    <ProgressBar
        android:id="@+id/download_progress_bar"
        android:layout_width="@dimen/dp_464"
        android:layout_height="@dimen/dp_6"
        android:layout_marginTop="@dimen/dp_198"
        android:progress="28"
        android:layout_centerHorizontal="true"
        style="@style/progressBar_horizontal"/>
    <Button
        android:id="@+id/action_detail"
        android:text="@string/usb_detail"
        android:layout_alignParentLeft="true"
        android:layout_marginStart="@dimen/dp_80"
        style="@style/two_actionBtn"/>
    <Button
        android:id="@+id/action_download_bg"
        android:text="@string/usb_download_background"
        android:layout_alignParentRight="true"
        android:layout_marginEnd="@dimen/dp_80"
        style="@style/two_actionBtn_cancel"/>
</RelativeLayout>
