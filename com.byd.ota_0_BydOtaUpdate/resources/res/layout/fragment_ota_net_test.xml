<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textStyle="bold"
        android:id="@+id/ota_net_test_date_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_20"
        android:text="date"/>
    <RadioGroup
        android:orientation="horizontal"
        android:id="@+id/ota_net_test_rg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_20">
        <RadioButton
            android:id="@+id/ota_net_test_apn1_rb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="apn1"/>
        <RadioButton
            android:id="@+id/ota_net_test_apn3_rb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="apn3"
            android:layout_marginStart="@dimen/dp_20"/>
    </RadioGroup>
    <Button
        android:id="@+id/ota_net_test_confirm_btn"
        android:layout_marginTop="@dimen/dp_20"
        android:text="@string/confirm"
        android:textAllCaps="false"
        style="@style/confirmTestBtn"/>
    <TextView
        android:id="@+id/ota_net_test_result_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_20"
        android:text="result"/>
    <ToggleButton
        android:id="@+id/ota_net_test_env_tb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_20"
        android:textOn="OTA服务器-&gt;测试环境"
        android:textOff="OTA服务器-&gt;正式环境"/>
</LinearLayout>
