<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/usb_shape_dialog_bg"
    android:layout_width="@dimen/dp_560"
    android:layout_height="@dimen/dp_352">
    <TextView
        android:id="@+id/dialog_title"
        android:text="@string/usb_upgrade_deadline"
        style="@style/usb_dialog_title"/>
    <TextView
        android:layout_below="@+id/dialog_title"
        style="@style/usb_dialog_title_divider"/>
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="?attr/usb_normal_text_color"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_29"
        android:layout_marginTop="@dimen/dp_112"
        android:text="@string/usb_upgrade_will_start"/>
    <TextView
        android:textSize="@dimen/sp_30"
        android:textColor="?attr/usb_update_info_time_color"
        android:gravity="center"
        android:id="@+id/dialog_time"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_35"
        android:layout_marginTop="@dimen/dp_157"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="?attr/usb_red_tips"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_24"
        android:layout_marginTop="@dimen/dp_208"
        android:text="@string/usb_upgrade_not_drive"/>
    <Button
        android:id="@+id/upgrade_immediately"
        android:text="@string/usb_upgrade_immediately"
        android:layout_alignParentLeft="true"
        android:layout_marginStart="@dimen/dp_80"
        style="@style/two_actionBtn"/>
    <Button
        android:id="@+id/cancel_update"
        android:text="@string/usb_cancel_update"
        android:layout_alignParentRight="true"
        android:layout_marginEnd="@dimen/dp_80"
        style="@style/two_actionBtn_cancel"/>
</RelativeLayout>
