<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/root_ll"
    android:background="?attr/fullscreen_dialog_bg"
    android:layout_width="@dimen/dp_720"
    android:layout_height="@dimen/dp_1280">
    <ImageView
        android:layout_gravity="center_horizontal"
        android:layout_width="@dimen/dp_556"
        android:layout_height="@dimen/dp_468"
        android:layout_marginTop="@dimen/dp_146"
        android:src="@mipmap/img_update_fullscreen"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/content_ll"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_35"
        android:layout_marginTop="@dimen/dp_120">
        <TextView
            android:textSize="@dimen/sp_24"
            android:textColor="?attr/fullscreen_normal_text_color"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/installing_system_updates"
            android:layout_marginStart="@dimen/dp_151"/>
        <TextView
            android:textSize="@dimen/sp_28"
            android:textColor="?attr/fullscreen_normal_text_color"
            android:gravity="center_vertical"
            android:id="@+id/install_progress_number"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:textDirection="ltr"
            android:layout_marginStart="@dimen/dp_24"/>
    </LinearLayout>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/install_progress_bar"
        android:layout_width="@dimen/dp_418"
        android:layout_height="@dimen/dp_6"
        android:layout_marginTop="@dimen/dp_16"
        android:progress="0"
        style="@style/fullscreen_progressBar_horizontal"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="?attr/normal_text_color"
        android:id="@+id/tv_tips1"
        android:layout_width="@dimen/dp_426"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_48"
        android:text="@string/installing_system_updates_tips1"
        android:layout_marginStart="@dimen/dp_151"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="?attr/normal_text_color"
        android:id="@+id/tv_tips2"
        android:layout_width="@dimen/dp_426"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_5"
        android:text="@string/installing_system_updates_tips2"
        android:layout_marginStart="@dimen/dp_151"/>
</LinearLayout>
