<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10">
        <Button
            android:id="@+id/loginIn_btn"
            android:text="loginIn"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/dp_20"
            style="@style/confirmTestBtn"/>
        <Button
            android:id="@+id/show_dialog_btn"
            android:text="showDialog"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/dp_20"
            style="@style/confirmTestBtn"/>
        <Button
            android:id="@+id/remote_presenter_btn"
            android:text="remote"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/dp_20"
            style="@style/confirmTestBtn"/>
        <Button
            android:id="@+id/control_presenter_btn"
            android:text="control"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/dp_20"
            style="@style/confirmTestBtn"/>
        <Button
            android:id="@+id/get_ecu_info_btn"
            android:text="getECUInfo"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/dp_20"
            style="@style/confirmTestBtn"/>
        <Button
            android:id="@+id/get_dtc_btn"
            android:text="getDTC"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/dp_20"
            style="@style/confirmTestBtn"/>
        <Button
            android:id="@+id/clear_dtc_btn"
            android:text="clearDTC"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/dp_20"
            style="@style/confirmTestBtn"/>
        <Button
            android:id="@+id/delete_ota_dir_btn"
            android:text="deleteOtaDir"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/dp_20"
            style="@style/confirmTestBtn"/>
        <Button
            android:id="@+id/reboot_btn"
            android:text="reboot"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/dp_20"
            style="@style/confirmTestBtn"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10">
        <Button
            android:id="@+id/test_get_can_btn"
            android:text="get"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/dp_5"
            style="@style/cancelTestBtn"/>
        <Button
            android:id="@+id/test_set_can_btn"
            android:text="set"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/dp_10"
            style="@style/cancelTestBtn"/>
        <TextView
            android:textColor="@color/colorPrimaryDark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="传参:"
            android:layout_marginStart="@dimen/dp_10"/>
        <EditText
            android:id="@+id/param_et"
            android:layout_width="@dimen/dp_100"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_5"/>
        <TextView
            android:textColor="@color/colorPrimaryDark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="返回值:"
            android:layout_marginStart="@dimen/dp_10"/>
        <TextView
            android:id="@+id/result_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_5"/>
    </LinearLayout>
    <com.byd.ota.view.widget.FlowRadioGroup
        android:orientation="horizontal"
        android:id="@+id/radio_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RadioButton
            android:id="@+id/rb_0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="获取EPB状态"/>
        <RadioButton
            android:id="@+id/rb_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="获取车辆类型"/>
        <RadioButton
            android:id="@+id/rb_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="获取整车电源状态"/>
        <RadioButton
            android:id="@+id/rb_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="获取防盗状态"/>
        <RadioButton
            android:id="@+id/rb_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="获取档位"/>
        <RadioButton
            android:id="@+id/rb_5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="获取前舱盖状态"/>
        <RadioButton
            android:id="@+id/rb_6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="获取动力电池管理器与外接充电设备当前状态"/>
        <RadioButton
            android:id="@+id/rb_7"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="获取车速"/>
        <RadioButton
            android:id="@+id/rb_8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="获取退电状态"/>
        <RadioButton
            android:id="@+id/rb_9"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="获取电池温度"/>
        <RadioButton
            android:id="@+id/rb_10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="获取是否有智能发电功能"/>
        <RadioButton
            android:id="@+id/rb_11"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="获取智能发电状态"/>
        <RadioButton
            android:id="@+id/rb_12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="获取智能发电异常原因"/>
        <RadioButton
            android:id="@+id/rb_13"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="获取DC工作状态"/>
        <RadioButton
            android:id="@+id/rb_14"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="获取SOC值"/>
        <RadioButton
            android:id="@+id/rb_15"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="获取蓄电池电压"/>
        <RadioButton
            android:id="@+id/rb_16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="获取整车放电状态"/>
        <RadioButton
            android:id="@+id/rb_17"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="获取充放电系统工作状态"/>
        <RadioButton
            android:id="@+id/rb_18"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="获取智能充电状态"/>
        <RadioButton
            android:id="@+id/rb_19"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="获取放电主接触器状态"/>
        <RadioButton
            android:id="@+id/rb_20"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="获取IG1继电器状态"/>
        <RadioButton
            android:id="@+id/rb_21"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="获取IG3继电器状态"/>
        <RadioButton
            android:id="@+id/rb_22"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="获取IG4继电器状态"/>
        <RadioButton
            android:id="@+id/rb_23"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="获取BCM自身OTA状态"/>
        <RadioButton
            android:id="@+id/rb_24"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="获取禁止上电状态"/>
        <RadioButton
            android:id="@+id/rb_25"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="获取左前门门锁状态"/>
        <RadioButton
            android:id="@+id/rb_26"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="获取7DF(功能寻址地址)是否存在"/>
        <RadioButton
            android:id="@+id/rb_27"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设置智能发电请求"/>
        <RadioButton
            android:id="@+id/rb_28"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设置ECL供电请求"/>
        <RadioButton
            android:id="@+id/rb_29"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设置退出智能充电请求"/>
        <RadioButton
            android:id="@+id/rb_30"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设置退出对外充放电请求"/>
        <RadioButton
            android:id="@+id/rb_31"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设置OTA模式"/>
        <RadioButton
            android:id="@+id/rb_32"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设置OTA配电请求(请求BCM上电/退电)"/>
        <RadioButton
            android:id="@+id/rb_33"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设置OTA终端（多媒体）自更新需求"/>
        <RadioButton
            android:id="@+id/rb_34"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设置OTA高压模块进程控制指令"/>
        <RadioButton
            android:id="@+id/rb_35"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设置备份区下载状态"/>
        <RadioButton
            android:id="@+id/rb_36"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设置背光状态"/>
        <RadioButton
            android:id="@+id/rb_37"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="获取背光状态"/>
        <RadioButton
            android:id="@+id/rb_38"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设置升级标志"/>
        <RadioButton
            android:id="@+id/rb_39"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设置qnx OTA状态"/>
        <RadioButton
            android:id="@+id/rb_40"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设置android OTA状态"/>
        <RadioButton
            android:id="@+id/rb_41"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="切换AQ分区"/>
        <RadioButton
            android:id="@+id/rb_42"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="获取当前AQ分区"/>
        <RadioButton
            android:id="@+id/rb_43"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="循环升级不删升级包"/>
    </com.byd.ota.view.widget.FlowRadioGroup>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="@color/colorAccent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="方法名:"
            android:layout_marginStart="@dimen/dp_10"/>
        <TextView
            android:id="@+id/method_name_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_5"/>
        <TextView
            android:textColor="@color/colorAccent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="传参说明:"
            android:layout_marginStart="@dimen/dp_10"/>
        <TextView
            android:id="@+id/param_description_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_5"/>
        <TextView
            android:textColor="@color/colorAccent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="返回值说明:"
            android:layout_marginStart="@dimen/dp_10"/>
        <TextView
            android:id="@+id/result_description_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_5"/>
    </LinearLayout>
</LinearLayout>
