<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/shape_dialog_bg"
    android:layout_width="@dimen/dp_560"
    android:layout_height="@dimen/dp_510">
    <TextView
        android:id="@+id/dialog_title"
        android:text="@string/appointment_time_title"
        style="@style/dialog_title"/>
    <View
        android:id="@+id/dialog_title_divider"
        style="@style/dialog_title_divider"/>
    <RelativeLayout
        android:id="@+id/content_rl"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_310"
        android:layout_marginTop="@dimen/dp_24">
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="?attr/notice_text_color"
            android:gravity="center"
            android:id="@+id/tv_date"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_6"
            android:text="2021年06月15日 星期三"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="?attr/normal_text_color"
            android:id="@+id/month_tv"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_26"
            android:layout_marginTop="@dimen/dp_15"
            android:minWidth="@dimen/dp_28"
            android:text="@string/month"
            android:layout_below="@+id/tv_date"
            android:layout_marginStart="@dimen/dp_80"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="?attr/normal_text_color"
            android:id="@+id/day_tv"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_26"
            android:layout_marginTop="@dimen/dp_15"
            android:minWidth="@dimen/dp_28"
            android:text="@string/day"
            android:layout_below="@+id/tv_date"
            android:layout_marginStart="@dimen/dp_180"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="?attr/normal_text_color"
            android:id="@+id/hour_tv"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_26"
            android:layout_marginTop="@dimen/dp_15"
            android:minWidth="@dimen/dp_28"
            android:text="@string/hour"
            android:layout_below="@+id/tv_date"
            android:layout_marginEnd="@dimen/dp_180"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="?attr/normal_text_color"
            android:id="@+id/minute_tv"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_26"
            android:layout_marginTop="@dimen/dp_15"
            android:minWidth="@dimen/dp_28"
            android:text="@string/minute"
            android:layout_below="@+id/tv_date"
            android:layout_marginEnd="@dimen/dp_80"
            android:layout_alignParentEnd="true"/>
        <View
            android:background="#262e3e4d"
            android:layout_width="@dimen/dp_464"
            android:layout_height="@dimen/dp_1"
            android:layout_marginTop="@dimen/dp_172"
            android:layout_centerHorizontal="true"/>
        <View
            android:background="#262e3e4d"
            android:layout_width="@dimen/dp_464"
            android:layout_height="@dimen/dp_1"
            android:layout_marginTop="@dimen/dp_235"
            android:layout_centerHorizontal="true"/>
        <com.byd.ota.view.widget.DatePicker
            android:id="@+id/number_picker_month"
            android:descendantFocusability="blocksDescendants"
            android:layout_width="@dimen/dp_28"
            android:layout_height="@dimen/dp_190"
            android:layout_marginTop="@dimen/dp_20"
            android:layout_below="@+id/month_tv"
            android:layout_alignStart="@+id/month_tv"
            android:layout_alignEnd="@+id/month_tv"/>
        <com.byd.ota.view.widget.DatePicker
            android:id="@+id/number_picker_day"
            android:descendantFocusability="blocksDescendants"
            android:layout_width="@dimen/dp_28"
            android:layout_height="@dimen/dp_190"
            android:layout_marginTop="@dimen/dp_20"
            android:layout_below="@+id/day_tv"
            android:layout_alignStart="@+id/day_tv"
            android:layout_alignEnd="@+id/day_tv"/>
        <com.byd.ota.view.widget.DatePicker
            android:id="@+id/number_picker_ap"
            android:descendantFocusability="blocksDescendants"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_190"
            android:layout_marginTop="@dimen/dp_107"
            android:minWidth="@dimen/dp_44"
            android:layout_centerHorizontal="true"/>
        <com.byd.ota.view.widget.DatePicker
            android:id="@+id/number_picker_hour"
            android:descendantFocusability="blocksDescendants"
            android:layout_width="@dimen/dp_28"
            android:layout_height="@dimen/dp_190"
            android:layout_marginTop="@dimen/dp_20"
            android:layout_below="@+id/hour_tv"
            android:layout_alignStart="@+id/hour_tv"
            android:layout_alignEnd="@+id/hour_tv"/>
        <com.byd.ota.view.widget.DatePicker
            android:id="@+id/number_picker_minute"
            android:descendantFocusability="blocksDescendants"
            android:layout_width="@dimen/dp_28"
            android:layout_height="@dimen/dp_190"
            android:layout_marginTop="@dimen/dp_20"
            android:layout_below="@+id/minute_tv"
            android:layout_alignStart="@+id/minute_tv"
            android:layout_alignEnd="@+id/minute_tv"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/container_btn_rl"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_104">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/action_confirm"
            android:text="@string/confirm"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/dp_80"
            android:layout_alignParentStart="true"
            style="@style/confirmBtn"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/action_cancel"
            android:text="@string/cancel"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp_80"
            android:layout_alignParentEnd="true"
            style="@style/cancelBtn"/>
    </RelativeLayout>
</LinearLayout>
