<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/shape_dialog_bg"
    android:layout_width="@dimen/dp_560"
    android:layout_height="@dimen/dp_342">
    <TextView
        android:textStyle="bold"
        android:id="@+id/dialog_title"
        android:text="@string/normal_title"
        style="@style/dialog_title"/>
    <View
        android:id="@+id/dialog_title_divider"
        style="@style/dialog_title_divider"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_142"
        android:layout_marginTop="@dimen/dp_24">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="?attr/normal_text_color"
            android:gravity="center"
            android:id="@+id/dialog_message_title"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_28"
            android:layout_marginTop="@dimen/dp_16"
            android:text="@string/upgrade_download"
            android:paddingHorizontal="@dimen/dp_48"/>
        <TextView
            android:textSize="@dimen/sp_22"
            android:textColor="?attr/normal_text_color"
            android:gravity="center"
            android:id="@+id/download_progress_number"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_32"
            android:layout_marginTop="@dimen/dp_18"
            android:paddingHorizontal="@dimen/dp_48"/>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/download_progress_bar"
            android:layout_width="@dimen/dp_464"
            android:layout_height="@dimen/dp_6"
            android:layout_marginTop="@dimen/dp_12"
            style="@style/progressBar_horizontal"/>
    </LinearLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_104">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/action_detail"
            android:text="@string/detail"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/dp_80"
            android:layout_alignParentStart="true"
            style="@style/confirmBtn"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/action_download_bg"
            android:text="@string/download_background"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp_80"
            android:layout_alignParentEnd="true"
            style="@style/cancelBtn"/>
    </RelativeLayout>
</LinearLayout>
