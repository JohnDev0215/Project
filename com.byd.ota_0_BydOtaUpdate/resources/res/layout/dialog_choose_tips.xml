<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/shape_dialog_bg"
    android:layout_width="@dimen/dp_560"
    android:layout_height="@dimen/dp_312">
    <TextView
        android:textStyle="bold"
        android:id="@+id/dialog_title"
        android:text="@string/normal_title"
        style="@style/dialog_title"/>
    <View
        android:id="@+id/dialog_title_divider"
        style="@style/dialog_title_divider"/>
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="?attr/normal_text_color"
        android:gravity="center"
        android:id="@+id/dialog_message"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_112"
        android:layout_marginTop="@dimen/dp_24"
        android:paddingHorizontal="@dimen/dp_48"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_104">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/action_confirm"
            android:text="@string/confirm"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/dp_80"
            android:layout_alignParentStart="true"
            style="@style/confirmBtn"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/action_cancel"
            android:text="@string/cancel"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp_80"
            android:layout_alignParentEnd="true"
            style="@style/cancelBtn"/>
    </RelativeLayout>
</LinearLayout>
