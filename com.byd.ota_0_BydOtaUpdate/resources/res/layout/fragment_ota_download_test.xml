<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_20">
        <Button
            android:id="@+id/ota_download_test_start_btn"
            android:text="@string/ota_tool_download_test_start_cycle"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/dp_20"
            style="@style/confirmTestBtn"/>
        <Button
            android:id="@+id/ota_download_test_stop_btn"
            android:text="@string/ota_tool_download_test_stop_cycle"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/dp_20"
            style="@style/confirmTestBtn"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/sp_16"
        android:id="@+id/ota_download_test_address_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_20"
        android:text="@string/ota_tool_download_test_address"/>
    <com.byd.ota.view.widget.TextProgressBar
        android:id="@+id/ota_download_test_progress_bar"
        android:layout_width="@dimen/dp_600"
        android:layout_height="@dimen/dp_10"
        android:layout_marginTop="@dimen/dp_20"
        style="@style/progressBar_horizontal"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:id="@+id/ota_download_test_result_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_20"/>
</LinearLayout>
