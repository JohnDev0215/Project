<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/usb_shape_dialog_bg"
    android:layout_width="@dimen/dp_720"
    android:layout_height="@dimen/dp_1200">
    <TextView
        android:id="@+id/dialog_title"
        android:text="@string/usb_package_choice"
        style="@style/usb_dialog_title"/>
    <TextView
        android:textSize="@dimen/sp_32"
        android:textColor="?attr/usb_normal_text_color"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_80"
        android:text="@string/usb_central_choice"
        android:layout_marginStart="@dimen/dp_80"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="?attr/usb_sub_normal_text_color"
        android:gravity="center_vertical"
        android:id="@+id/current_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_141"
        android:layout_marginStart="@dimen/dp_80"/>
    <ImageView
        android:gravity="center_vertical"
        android:layout_width="@dimen/dp_32"
        android:layout_height="@dimen/dp_32"
        android:layout_marginTop="@dimen/dp_138"
        android:src="@drawable/arrow"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="?attr/usb_normal_text_color"
        android:gravity="center_vertical"
        android:id="@+id/update_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_186"
        android:layout_marginStart="@dimen/dp_80"/>
    <TextView
        android:background="?attr/usb_dialog_divider_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_marginTop="@dimen/dp_238"
        android:layout_marginStart="@dimen/dp_80"
        android:layout_marginEnd="@dimen/dp_80"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/file_recyclerview"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_330"
        android:layout_marginTop="@dimen/dp_271"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="@dimen/dp_80"
        android:layout_marginEnd="@dimen/dp_80"/>
    <RelativeLayout
        android:id="@+id/co_driver_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="@dimen/sp_32"
            android:textColor="?attr/usb_normal_text_color"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_607"
            android:text="@string/usb_co_driver"
            android:layout_marginStart="@dimen/dp_80"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="?attr/usb_sub_normal_text_color"
            android:gravity="center_vertical"
            android:id="@+id/co_driver_current_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_668"
            android:layout_marginStart="@dimen/dp_80"/>
        <ImageView
            android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_32"
            android:layout_marginTop="@dimen/dp_668"
            android:src="@drawable/arrow"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="?attr/usb_normal_text_color"
            android:gravity="center"
            android:id="@+id/co_driver_update_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_668"
            android:layout_marginEnd="@dimen/dp_80"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:background="?attr/usb_dialog_divider_bg"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:layout_marginTop="@dimen/dp_725"
            android:layout_marginStart="@dimen/dp_80"
            android:layout_marginEnd="@dimen/dp_80"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/co_driver_recyclerview"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_330"
            android:layout_marginTop="@dimen/dp_740"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="@dimen/dp_80"
            android:layout_marginEnd="@dimen/dp_80"/>
    </RelativeLayout>
    <Button
        android:id="@+id/action_confirm"
        android:layout_width="@dimen/dp_144"
        android:layout_marginBottom="@dimen/dp_50"
        android:text="@string/usb_confirm"
        android:layout_marginStart="@dimen/dp_204"
        android:layout_alignParentStart="true"
        style="@style/two_actionBtn"/>
    <Button
        android:id="@+id/action_cancel"
        android:layout_width="@dimen/dp_144"
        android:layout_marginBottom="@dimen/dp_50"
        android:text="@string/usb_cancel"
        android:layout_marginEnd="@dimen/dp_204"
        android:layout_alignParentEnd="true"
        style="@style/two_actionBtn_cancel"/>
</RelativeLayout>
