<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/popup_background_color"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="@dimen/popup_layout_width"
        android:layout_height="@dimen/popup_layout_height">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/close_button_layout_margin_top">
            <ImageView
                android:id="@+id/close_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_close"
                android:layout_marginStart="@dimen/close_button_margin_start"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/message_text_layout_height"
            android:layout_marginTop="@dimen/button_message_text_layout_margin_top">
            <TextView
                android:textSize="@dimen/message_text_size"
                android:textColor="@color/popup_light_text_color"
                android:gravity="center"
                android:id="@+id/two_btn_message"
                android:layout_width="@dimen/message_text_width"
                android:layout_height="wrap_content"
                android:singleLine="false"
                android:layout_marginStart="@dimen/message_text_margin_start"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_layout_height"
            android:layout_marginTop="@dimen/button_layout_margin_top">
            <Button
                android:textSize="@dimen/button_text_size"
                android:textColor="@color/popup_light_text_color"
                android:gravity="center"
                android:id="@+id/two_btn_button1"
                android:background="@drawable/popup_two_button_one_shape"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/popup_two_button_yes"
                android:textAlignment="center"
                android:layout_marginStart="@dimen/two_button_one_layout_margin_start"/>
            <Button
                android:textSize="@dimen/button_text_size"
                android:textColor="@color/popup_dark_text_color"
                android:gravity="center"
                android:id="@+id/two_btn_button2"
                android:background="@drawable/popup_two_button_two_shape"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/popup_two_button_no"
                android:textAlignment="center"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
