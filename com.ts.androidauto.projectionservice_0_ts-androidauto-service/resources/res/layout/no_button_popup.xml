<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/popup_background_color"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="@dimen/popup_layout_width"
        android:layout_height="@dimen/popup_layout_height">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/close_button_layout_margin_top">
            <ImageView
                android:id="@+id/close_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_close"
                android:layout_marginStart="@dimen/close_button_margin_start"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/message_text_layout_height"
            android:layout_marginTop="@dimen/no_button_message_text_layout_margin_top">
            <TextView
                android:textSize="@dimen/message_text_size"
                android:textColor="@color/popup_light_text_color"
                android:gravity="center"
                android:id="@+id/no_btn_message"
                android:layout_width="@dimen/message_text_width"
                android:layout_height="wrap_content"
                android:singleLine="false"
                android:layout_marginStart="@dimen/message_text_margin_start"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
