<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <Space
        android:id="@+id/s_uninstall_app_top_start"
        android:layout_width="@dimen/dp_20"
        android:layout_height="@dimen/dp_20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <Space
        android:id="@+id/s_uninstall_app_bottom_end"
        android:layout_width="@dimen/dp_20"
        android:layout_height="@dimen/dp_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/s_uninstall_app_panel"/>
    <Space
        android:id="@+id/s_uninstall_app_panel"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_56"
        app:layout_constraintBottom_toTopOf="@+id/s_uninstall_app_bottom_end"
        app:layout_constraintEnd_toStartOf="@+id/s_uninstall_app_bottom_end"
        app:layout_constraintStart_toEndOf="@+id/s_uninstall_app_top_start"
        app:layout_constraintTop_toBottomOf="@+id/s_uninstall_app_top_start"/>
    <ImageView
        android:id="@+id/iv_uninstall_app_icon"
        android:layout_marginStart="@dimen/dp_24"
        app:layout_constraintBottom_toBottomOf="@+id/s_uninstall_app_panel"
        app:layout_constraintStart_toStartOf="@+id/s_uninstall_app_panel"
        app:layout_constraintTop_toTopOf="@+id/s_uninstall_app_panel"
        style="@style/DetailIconSize"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinAppCompatTextView
        android:textSize="@dimen/sp_20"
        android:id="@+id/tv_uninstall_app_name"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_28"
        android:layout_marginStart="@dimen/dp_16"
        app:layout_constraintBottom_toTopOf="@+id/tv_uninstall_app_theme"
        app:layout_constraintStart_toEndOf="@+id/iv_uninstall_app_icon"
        app:layout_constraintTop_toTopOf="@+id/s_uninstall_app_panel"
        app:styleTextColor="@color/management_item_title"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinAppCompatTextView
        android:textSize="@dimen/sp_16"
        android:gravity="center"
        android:id="@+id/tv_uninstall_app_theme"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_28"
        app:layout_constraintBottom_toBottomOf="@+id/s_uninstall_app_panel"
        app:layout_constraintStart_toStartOf="@+id/tv_uninstall_app_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_uninstall_app_name"
        app:styleTextColor="@color/management_item_subtitle"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinView
        android:id="@+id/v_uninstall_line"
        android:layout_width="@dimen/dp_1"
        android:layout_height="@dimen/dp_20"
        android:layout_marginStart="@dimen/dp_6"
        app:layout_constraintBottom_toBottomOf="@+id/tv_uninstall_app_theme"
        app:layout_constraintStart_toEndOf="@+id/tv_uninstall_app_theme"
        app:layout_constraintTop_toTopOf="@+id/tv_uninstall_app_theme"
        app:styleBackground="@color/management_item_subtitle"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinAppCompatTextView
        android:textSize="@dimen/sp_16"
        android:gravity="start|center_vertical"
        android:id="@+id/tv_uninstall_app_size"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_28"
        android:layout_marginStart="@dimen/dp_6"
        app:layout_constraintStart_toEndOf="@+id/v_uninstall_line"
        app:layout_constraintTop_toTopOf="@+id/tv_uninstall_app_theme"
        app:styleTextColor="@color/management_item_subtitle"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinAppCompatTextView
        android:gravity="center"
        android:id="@+id/tv_uninstall_app_button"
        android:layout_width="@dimen/dp_128"
        android:layout_height="@dimen/dp_40"
        android:text="@string/button_state_uninstall"
        android:layout_marginStart="@dimen/dp_364"
        android:paddingHorizontal="@dimen/dp_8"
        app:layout_constraintBottom_toBottomOf="@+id/s_uninstall_app_panel"
        app:layout_constraintStart_toEndOf="@+id/iv_uninstall_app_icon"
        app:layout_constraintTop_toTopOf="@+id/s_uninstall_app_panel"
        app:styleBackground="@drawable/bg_clickable_colored_button_open_install_uninstall"
        app:styleTextColor="@color/common_normal_button_text"
        style="@style/OperateButtonTextAutoStyle"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinView
        android:id="@+id/v_uninstall_app_divider"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_1"
        app:layout_constraintEnd_toEndOf="@+id/tv_uninstall_app_button"
        app:layout_constraintStart_toStartOf="@+id/iv_uninstall_app_icon"
        app:layout_constraintTop_toBottomOf="@+id/s_uninstall_app_bottom_end"
        app:styleBackground="@color/management_item_divide_line"/>
</androidx.constraintlayout.widget.ConstraintLayout>
