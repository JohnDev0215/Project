<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/dp_48">
    <com.byd.overseaappstore.ui.view.custom.skin.SkinAppCompatImageView
        android:id="@+id/iv_management_title_icon"
        android:visibility="gone"
        android:layout_width="@dimen/dp_28"
        android:layout_height="@dimen/dp_28"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_management_title_text"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinAppCompatTextView
        android:textSize="@dimen/sp_20"
        android:id="@+id/tv_management_title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_management_title_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:styleTextColor="@color/management_tab_unselected"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinView
        android:id="@+id/v_management_red_point"
        android:visibility="invisible"
        android:layout_width="@dimen/dp_8"
        android:layout_height="@dimen/dp_8"
        app:layout_constraintStart_toEndOf="@+id/tv_management_title_text"
        app:layout_constraintTop_toTopOf="@+id/tv_management_title_text"
        app:styleBackground="@drawable/bg_common_red_point"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinAppCompatImageView
        android:id="@+id/iv_management_title_indicator"
        android:visibility="gone"
        android:layout_width="@dimen/dp_30"
        android:layout_height="@dimen/dp_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:styleBackground="@drawable/bg_tab_indicator"/>
</androidx.constraintlayout.widget.ConstraintLayout>
