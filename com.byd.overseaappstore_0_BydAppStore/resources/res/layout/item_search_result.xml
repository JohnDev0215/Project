<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/selector_list_item_select"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <android.widget.Space
        android:id="@+id/s_search_result_app_top_start"
        android:layout_width="@dimen/dp_50"
        android:layout_height="@dimen/dp_12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <android.widget.Space
        android:id="@+id/s_search_result_app_bottom_end"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_22"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_theme"/>
    <ImageView
        android:id="@+id/iv_icon"
        app:layout_constraintStart_toStartOf="@+id/s_search_result_app_top_start"
        app:layout_constraintTop_toBottomOf="@+id/s_search_result_app_top_start"
        style="@style/DetailIconSize"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinAppCompatTextView
        android:textSize="@dimen/sp_20"
        android:id="@+id/tv_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_17"
        app:layout_constraintBottom_toTopOf="@+id/tv_theme"
        app:layout_constraintStart_toEndOf="@+id/iv_icon"
        app:layout_constraintTop_toTopOf="@+id/iv_icon"
        app:styleTextColor="@color/search_result_title"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinAppCompatTextView
        android:id="@+id/tv_theme"
        android:layout_marginTop="@dimen/dp_6"
        app:layout_constraintBottom_toBottomOf="@+id/iv_icon"
        app:layout_constraintStart_toStartOf="@+id/tv_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_name"
        app:styleTextColor="@color/common_secondary_text"
        style="@style/SoftwareDescribeStyle"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinView
        android:id="@+id/v_topic_detail_app_theme_boundary"
        android:layout_width="@dimen/dp_1"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/dp_6"
        app:layout_constraintBottom_toBottomOf="@+id/tv_theme"
        app:layout_constraintStart_toEndOf="@+id/tv_theme"
        app:layout_constraintTop_toTopOf="@+id/tv_theme"
        app:styleBackground="@drawable/line_text_short_boundary"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinAppCompatTextView
        android:id="@+id/tv_size"
        android:layout_margin="@dimen/dp_6"
        app:layout_constraintBottom_toBottomOf="@+id/tv_theme"
        app:layout_constraintStart_toEndOf="@+id/v_topic_detail_app_theme_boundary"
        app:layout_constraintTop_toTopOf="@+id/tv_theme"
        app:styleTextColor="@color/common_secondary_text"
        style="@style/SoftwareDescribeStyle"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinView
        android:id="@+id/v_search_result_app_click_hot_spot"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="@dimen/dp_4"
        app:layout_constraintBottom_toBottomOf="@+id/s_search_result_app_bottom_end"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/s_search_result_app_top_start"/>
    <com.byd.overseaappstore.ui.view.custom.DownloadProgressButtonView
        android:id="@+id/dpb_operate"
        android:layout_width="@dimen/dp_128"
        android:layout_height="@dimen/dp_40"
        android:layout_marginEnd="@dimen/dp_4"
        app:layout_constraintBottom_toBottomOf="@+id/iv_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_icon"/>
</androidx.constraintlayout.widget.ConstraintLayout>
