<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingBottom="@dimen/dp_15"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_60">
    <com.byd.overseaappstore.ui.view.custom.skin.SkinImageView
        android:id="@+id/iv_refresh_loading_pic"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        app:styleBackground="@drawable/ic_pull_down_loading"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinProgressBar
        android:id="@+id/pb_refresh_loading_bar"
        android:visibility="gone"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        android:indeterminate="true"
        android:indeterminateDuration="@integer/loading_duration"
        app:styleIndeterminateDrawable="@drawable/ic_rotate_progress_bar_pull_down"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinTextView
        android:textSize="@dimen/sp_18"
        android:gravity="center"
        android:id="@+id/tv_refresh_loading_text"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_24"
        android:text="@string/pull_down_refreshing"
        app:styleTextColor="@color/common_primary_item_title_text"/>
</LinearLayout>
