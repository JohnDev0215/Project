<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="@dimen/dp_20"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <android.widget.Space
        android:id="@+id/s_top_state_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/top_state_bar_height"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <Space
        android:id="@+id/s_top_left_space"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_12"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/s_top_state_bar"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinTextView
        android:textSize="@dimen/sp_18"
        android:gravity="start|center_vertical"
        android:id="@+id/tv_enter_search"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_48"
        android:text="@string/search_input_bar_hint"
        android:paddingStart="@dimen/dp_60"
        android:paddingEnd="@dimen/dp_8"
        app:layout_constraintLeft_toRightOf="@+id/s_top_left_space"
        app:layout_constraintRight_toLeftOf="@+id/s_between_search_and_download"
        app:layout_constraintTop_toBottomOf="@+id/s_top_left_space"
        app:styleBackground="@drawable/bg_top_bar_view_background_normal"
        app:styleTextColor="@color/search_input_bar_hint"/>
    <Space
        android:id="@+id/s_between_search_and_download"
        android:layout_width="@dimen/dp_24"
        android:layout_height="0dp"
        app:layout_constraintRight_toLeftOf="@+id/v_down_load_area"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinAppCompatImageView
        android:id="@+id/iv_enter_search"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        android:layout_marginStart="@dimen/dp_6"
        app:layout_constraintBottom_toBottomOf="@+id/tv_enter_search"
        app:layout_constraintStart_toStartOf="@+id/tv_enter_search"
        app:layout_constraintTop_toTopOf="@+id/tv_enter_search"
        app:styleBackground="@drawable/ic_overall_search"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinView
        android:id="@+id/v_down_load_area"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        android:layout_marginRight="@dimen/dp_26"
        app:layout_constraintBottom_toBottomOf="@+id/tv_enter_search"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_enter_search"
        app:styleBackground="@drawable/bg_top_bar_downloade_button_background"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinView
        android:id="@+id/v_feature_download_red_point"
        android:visibility="gone"
        android:layout_width="@dimen/dp_10"
        android:layout_height="@dimen/dp_10"
        android:layout_marginBottom="@dimen/dp_28"
        android:layout_marginStart="@dimen/dp_28"
        app:layout_constraintBottom_toBottomOf="@+id/v_down_load_area"
        app:layout_constraintLeft_toLeftOf="@+id/v_down_load_area"
        app:styleBackground="@drawable/bg_common_red_point"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinTextView
        android:textSize="@dimen/sp_14"
        android:gravity="center"
        android:id="@+id/tv_feature_download_red_point"
        android:paddingTop="@dimen/dp_1"
        android:paddingBottom="@dimen/dp_1"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_28"
        android:includeFontPadding="false"
        android:paddingStart="@dimen/dp_5"
        android:paddingEnd="@dimen/dp_5"
        android:layout_marginStart="@dimen/dp_28"
        app:layout_constraintBottom_toBottomOf="@+id/v_down_load_area"
        app:layout_constraintLeft_toLeftOf="@+id/v_down_load_area"
        app:styleBackground="@drawable/bg_common_red_point"
        app:styleTextColor="@color/common_red_point_text"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinAppCompatImageView
        android:id="@+id/iv_down_load"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        app:layout_constraintBottom_toBottomOf="@+id/v_down_load_area"
        app:layout_constraintEnd_toEndOf="@+id/v_down_load_area"
        app:layout_constraintStart_toStartOf="@+id/v_down_load_area"
        app:layout_constraintTop_toTopOf="@+id/v_down_load_area"
        app:styleBackground="@drawable/ic_overall_download"/>
</androidx.constraintlayout.widget.ConstraintLayout>
