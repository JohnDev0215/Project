<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_iuu_success_dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.byd.overseaappstore.ui.view.custom.skin.SkinView
        android:id="@+id/v_iuu_success_dialog"
        android:layout_width="@dimen/dp_560"
        android:layout_height="@dimen/dp_264"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:styleBackground="@drawable/bg_setting_dialog"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinProgressBar
        android:id="@+id/pb_loading_bar"
        android:layout_width="@dimen/dp_72"
        android:layout_height="@dimen/dp_72"
        android:layout_marginTop="@dimen/dp_65"
        android:indeterminateDuration="@integer/loading_duration"
        app:layout_constraintEnd_toEndOf="@+id/v_iuu_success_dialog"
        app:layout_constraintStart_toStartOf="@+id/v_iuu_success_dialog"
        app:layout_constraintTop_toTopOf="@+id/v_iuu_success_dialog"
        app:styleIndeterminateDrawable="@drawable/ic_rotate_progress_bar"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinTextView
        android:textSize="@dimen/sp_18"
        android:gravity="center"
        android:id="@+id/tv_process_content"
        android:layout_width="@dimen/dp_532"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_30"
        android:layout_marginBottom="@dimen/dp_43"
        android:text="@string/workWifi_dialog_content"
        android:lineHeight="@dimen/sp_30"
        app:layout_constraintBottom_toBottomOf="@+id/v_iuu_success_dialog"
        app:layout_constraintEnd_toEndOf="@+id/v_iuu_success_dialog"
        app:layout_constraintStart_toStartOf="@+id/v_iuu_success_dialog"
        app:layout_constraintTop_toBottomOf="@+id/pb_loading_bar"
        app:styleTextColor="@color/setting_text_color"/>
</androidx.constraintlayout.widget.ConstraintLayout>
