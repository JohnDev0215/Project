<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_fragment_setting"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.byd.overseaappstore.ui.view.custom.skin.SkinView
        android:id="@+id/v_setting_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:styleBackground="@drawable/bg_common_background"/>
    <android.widget.Space
        android:id="@+id/s_top_state_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/top_state_bar_height"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <android.widget.Space
        android:id="@+id/s_bottom_state_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/bottom_state_bar_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <Space
        android:id="@+id/s_anchor_top_start"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/s_top_state_bar"
        style="@style/CommonCornerSpace"/>
    <Space
        android:id="@+id/s_anchor_bottom_end"
        app:layout_constraintBottom_toTopOf="@+id/s_bottom_state_bar"
        app:layout_constraintEnd_toEndOf="parent"
        style="@style/CommonCornerSpace"/>
    <include layout="@layout/include_top_bar_merge"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinView
        android:id="@+id/v_setting_only_wifi"
        android:layout_width="@dimen/dp_700"
        android:layout_height="@dimen/dp_88"
        android:layout_marginTop="@dimen/dp_2"
        android:layout_marginStart="@dimen/dp_40"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_include_back"
        app:styleBackground="@drawable/bg_setting_select"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinImageView
        android:id="@+id/iv_setting_button_only_wifi"
        android:layout_width="@dimen/dp_64"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_24"
        app:layout_constraintBottom_toBottomOf="@+id/v_setting_only_wifi"
        app:layout_constraintLeft_toLeftOf="@+id/v_setting_only_wifi"
        app:layout_constraintTop_toTopOf="@+id/v_setting_only_wifi"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinTextView
        android:textSize="@dimen/sp_20"
        android:gravity="start|center_vertical"
        android:id="@+id/tv_setting_only_wifi"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_28"
        android:layout_marginRight="@dimen/dp_24"
        android:text="@string/setting_fragment_only_wifi"
        android:layout_marginStart="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/iv_setting_button_only_wifi"
        app:layout_constraintLeft_toRightOf="@+id/iv_setting_button_only_wifi"
        app:layout_constraintRight_toRightOf="@+id/v_setting_only_wifi"
        app:layout_constraintTop_toTopOf="@+id/iv_setting_button_only_wifi"
        app:styleTextColor="@color/setting_title"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinImageView
        android:id="@+id/iv_setting_double"
        android:layout_width="@dimen/dp_700"
        android:layout_height="@dimen/dp_176"
        android:layout_marginTop="@dimen/dp_16"
        app:layout_constraintStart_toStartOf="@+id/v_setting_only_wifi"
        app:layout_constraintTop_toBottomOf="@+id/v_setting_only_wifi"
        app:styleBackground="@drawable/bg_setting_select"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinView
        android:id="@+id/v_setting_clear_cache"
        android:layout_width="@dimen/dp_700"
        android:layout_height="@dimen/dp_88"
        app:layout_constraintEnd_toEndOf="@+id/iv_setting_double"
        app:layout_constraintStart_toStartOf="@+id/iv_setting_double"
        app:layout_constraintTop_toTopOf="@+id/iv_setting_double"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinTextView
        android:textSize="@dimen/sp_20"
        android:gravity="start|center_vertical"
        android:id="@+id/tv_setting_clear_cache"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_28"
        android:layout_marginTop="@dimen/dp_16"
        android:text="@string/setting_fragment_clean_cache"
        android:layout_marginStart="@dimen/dp_24"
        app:layout_constraintStart_toStartOf="@+id/v_setting_clear_cache"
        app:layout_constraintTop_toTopOf="@+id/v_setting_clear_cache"
        app:styleTextColor="@color/setting_other_title"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinTextView
        android:textSize="@dimen/sp_16"
        android:gravity="start|center_vertical"
        android:id="@+id/tv_setting_clear_cache2"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_20"
        android:text="@string/setting_fragment_clean_cache2"
        app:layout_constraintStart_toStartOf="@+id/tv_setting_clear_cache"
        app:layout_constraintTop_toBottomOf="@+id/tv_setting_clear_cache"
        app:styleTextColor="@color/setting_clear_cache_text"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinImageView
        android:id="@+id/iv_setting_clear_cache"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        android:layout_marginEnd="@dimen/dp_8"
        app:layout_constraintBottom_toBottomOf="@+id/v_setting_clear_cache"
        app:layout_constraintEnd_toEndOf="@+id/v_setting_clear_cache"
        app:layout_constraintTop_toTopOf="@+id/v_setting_clear_cache"
        app:styleSrc="@drawable/ic_overall_enter_arrow"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinTextView
        android:textSize="@dimen/sp_20"
        android:id="@+id/tv_cache_size"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_28"
        app:layout_constraintBottom_toBottomOf="@+id/v_setting_clear_cache"
        app:layout_constraintEnd_toStartOf="@+id/iv_setting_clear_cache"
        app:layout_constraintTop_toTopOf="@+id/v_setting_clear_cache"
        app:styleTextColor="@color/setting_clear_cache_text"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinView
        android:id="@+id/v_setting_protocol"
        android:layout_width="@dimen/dp_700"
        android:layout_height="@dimen/dp_88"
        app:layout_constraintBottom_toBottomOf="@+id/iv_setting_double"
        app:layout_constraintEnd_toEndOf="@+id/iv_setting_double"
        app:layout_constraintStart_toStartOf="@+id/iv_setting_double"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinTextView
        android:textSize="@dimen/sp_20"
        android:gravity="start|center_vertical"
        android:id="@+id/tv_setting_check_update"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_28"
        android:text="@string/setting_fragment_service"
        android:layout_marginStart="@dimen/dp_24"
        app:layout_constraintBottom_toBottomOf="@+id/v_setting_protocol"
        app:layout_constraintStart_toStartOf="@+id/v_setting_protocol"
        app:layout_constraintTop_toTopOf="@+id/v_setting_protocol"
        app:styleTextColor="@color/setting_other_title"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinImageView
        android:id="@+id/im_setting_check_update"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        android:layout_marginEnd="@dimen/dp_8"
        app:layout_constraintBottom_toBottomOf="@+id/v_setting_protocol"
        app:layout_constraintEnd_toEndOf="@+id/v_setting_protocol"
        app:layout_constraintTop_toTopOf="@+id/v_setting_protocol"
        app:styleSrc="@drawable/ic_overall_enter_arrow"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinImageView
        android:id="@+id/iv_setting_app_icon"
        android:layout_width="@dimen/dp_80"
        android:layout_height="@dimen/dp_80"
        android:layout_marginTop="@dimen/dp_46"
        app:layout_constraintLeft_toRightOf="@+id/v_setting_clear_cache"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_setting_double"
        app:styleSrc="@mipmap/ic_launcher"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinTextView
        android:textSize="@dimen/sp_20"
        android:gravity="center"
        android:id="@+id/tv_setting_app_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:text="@string/app_name"
        app:layout_constraintBottom_toTopOf="@+id/tv_setting_app_version"
        app:layout_constraintEnd_toEndOf="@+id/iv_setting_app_icon"
        app:layout_constraintStart_toStartOf="@+id/iv_setting_app_icon"
        app:layout_constraintTop_toBottomOf="@+id/iv_setting_app_icon"
        app:styleTextColor="@color/setting_title"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinTextView
        android:textSize="@dimen/sp_16"
        android:gravity="center"
        android:id="@+id/tv_setting_app_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        app:layout_constraintBottom_toTopOf="@+id/tv_setting_app_power"
        app:layout_constraintEnd_toEndOf="@+id/tv_setting_app_name"
        app:layout_constraintStart_toStartOf="@+id/tv_setting_app_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_setting_app_name"
        app:styleTextColor="@color/setting_clear_cache_text"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinTextView
        android:textSize="@dimen/sp_12"
        android:gravity="center"
        android:id="@+id/tv_setting_app_power"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_18"
        android:text="@string/setting_fragment_app_power"
        app:layout_constraintEnd_toEndOf="@+id/tv_setting_app_version"
        app:layout_constraintStart_toStartOf="@+id/tv_setting_app_version"
        app:layout_constraintTop_toBottomOf="@+id/tv_setting_app_version"
        app:styleTextColor="@color/setting_clear_cache_text"/>
</androidx.constraintlayout.widget.ConstraintLayout>
