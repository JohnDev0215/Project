<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.byd.overseaappstore.ui.view.custom.skin.SkinContentLoadingProgressBar
        android:id="@+id/pb_view_download_progress_bar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:max="100"
        android:progress="30"
        android:indeterminateOnly="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:styleProgressDrawable="@drawable/view_download_progress_bar_pb_drawable"
        style="?android:attr/progressBarStyleHorizontal"/>
    <View
        android:id="@+id/v_view_download_progress_bar_state_background"
        android:background="@drawable/bg_clickable_colored_button_wait"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinAppCompatTextView
        android:id="@+id/tv_view_download_progress_bar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:includeFontPadding="false"
        android:layout_marginHorizontal="@dimen/dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/OperateButtonTextAutoStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
