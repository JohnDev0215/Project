<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_dialog_two_button_confirm"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.byd.overseaappstore.ui.view.custom.skin.SkinView
        android:id="@+id/dialog_background"
        android:layout_width="@dimen/dp_560"
        android:layout_height="@dimen/dp_346"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:styleBackground="@drawable/bg_confirm_dialog_background"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinAppCompatTextView
        android:textSize="@dimen/sp_20"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_70"
        app:layout_constraintEnd_toEndOf="@+id/dialog_background"
        app:layout_constraintStart_toStartOf="@+id/dialog_background"
        app:layout_constraintTop_toTopOf="@+id/dialog_background"
        app:styleTextColor="@color/dialog_content_text"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinAppCompatTextView
        android:textSize="@dimen/sp_20"
        android:gravity="start"
        android:id="@+id/content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_14"
        android:layout_marginStart="@dimen/dp_48"
        android:layout_marginEnd="@dimen/dp_48"
        app:layout_constraintBottom_toBottomOf="@+id/dialog_background"
        app:layout_constraintEnd_toEndOf="@+id/dialog_background"
        app:layout_constraintStart_toStartOf="@+id/dialog_background"
        app:layout_constraintTop_toTopOf="@+id/dialog_background"
        app:styleTextColor="@color/dialog_content_text"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinView
        android:id="@+id/v_dialog_two_button_positive_button"
        android:layout_width="@dimen/dp_176"
        android:layout_height="@dimen/dp_48"
        android:layout_marginBottom="@dimen/dp_28"
        android:layout_marginStart="@dimen/dp_80"
        app:layout_constraintBottom_toBottomOf="@+id/dialog_background"
        app:layout_constraintLeft_toLeftOf="@+id/dialog_background"
        app:styleBackground="@drawable/common_dialog_start_button"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinView
        android:id="@+id/v_dialog_two_button_negative_button"
        android:layout_width="@dimen/dp_176"
        android:layout_height="0dp"
        android:layout_marginEnd="@dimen/dp_80"
        app:layout_constraintBottom_toBottomOf="@+id/v_dialog_two_button_positive_button"
        app:layout_constraintRight_toRightOf="@+id/dialog_background"
        app:layout_constraintTop_toTopOf="@+id/v_dialog_two_button_positive_button"
        app:styleBackground="@drawable/bg_confirm_dialog_right_button"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinAppCompatTextView
        android:textSize="@dimen/sp_18"
        android:gravity="center"
        android:id="@+id/positive"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/v_dialog_two_button_positive_button"
        app:layout_constraintEnd_toEndOf="@+id/v_dialog_two_button_positive_button"
        app:layout_constraintStart_toStartOf="@+id/v_dialog_two_button_positive_button"
        app:layout_constraintTop_toTopOf="@+id/v_dialog_two_button_positive_button"
        app:styleTextColor="@color/positive_protocol_dialog_positive_enable"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinAppCompatTextView
        android:textSize="@dimen/sp_18"
        android:gravity="center"
        android:id="@+id/negative"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/v_dialog_two_button_negative_button"
        app:layout_constraintEnd_toEndOf="@+id/v_dialog_two_button_negative_button"
        app:layout_constraintStart_toStartOf="@+id/v_dialog_two_button_negative_button"
        app:layout_constraintTop_toTopOf="@+id/v_dialog_two_button_negative_button"
        app:styleTextColor="@color/dialog_negative_text"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinView
        android:id="@+id/view_horizontal_line"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_1"
        app:layout_constraintEnd_toEndOf="@+id/dialog_background"
        app:layout_constraintStart_toStartOf="@+id/dialog_background"
        app:layout_constraintTop_toBottomOf="@+id/title"
        app:styleBackground="@color/setting_over_line"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinView
        android:id="@+id/view_vertical_line"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="@+id/dialog_background"
        app:layout_constraintStart_toStartOf="@+id/dialog_background"
        app:layout_constraintTop_toTopOf="@+id/dialog_background"/>
</androidx.constraintlayout.widget.ConstraintLayout>
