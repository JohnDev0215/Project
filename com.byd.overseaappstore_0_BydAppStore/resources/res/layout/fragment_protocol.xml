<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <android.widget.Space
        android:id="@+id/s_top_state_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/top_state_bar_height"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <android.widget.Space
        android:id="@+id/s_bottom_state_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/bottom_state_bar_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinView
        android:id="@+id/v_protocol_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:styleBackground="@drawable/bg_common_background"/>
    <include layout="@layout/include_top_bar_merge"/>
    <androidx.core.widget.NestedScrollView
        android:scrollbarThumbVertical="@drawable/scroll_bar_thumb"
        android:scrollbarTrackVertical="@drawable/scroll_bar_track"
        android:id="@+id/nsv_string"
        android:scrollbars="vertical"
        android:fadingEdgeLength="@dimen/dp_40"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_42"
        android:requiresFadingEdge="vertical"
        android:layout_marginStart="@dimen/dp_60"
        android:layout_marginEnd="@dimen/dp_28"
        app:layout_constraintBottom_toTopOf="@+id/b_buttons_top_barrier"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_include_text">
        <WebView
            android:id="@+id/wv_protocol_content"
            android:background="@color/transparent"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dp_28"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.core.widget.NestedScrollView>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/b_buttons_top_barrier"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:barrierDirection="top"
        app:constraint_referenced_ids="s_checkbox_top_space, s_reset_button_top_space"/>
    <androidx.legacy.widget.Space
        android:id="@+id/s_checkbox_top_space"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_16"
        app:layout_constraintBottom_toTopOf="@+id/v_checkbox_bg"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinView
        android:id="@+id/v_checkbox_bg"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_40"
        app:layout_constraintBottom_toTopOf="@+id/s_button_top_space"
        app:layout_constraintEnd_toEndOf="@+id/nsv_string"
        app:layout_constraintStart_toStartOf="@+id/nsv_string"
        app:styleBackground="@color/dialog_protocol_checkbox_background"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinCheckBox
        android:textSize="@dimen/sp_18"
        android:gravity="start|center_vertical"
        android:id="@+id/cb_checkbox"
        android:background="@color/transparent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:checked="false"
        android:button="@null"
        android:text="@string/protocol_dialog_check_box_text"
        app:layout_constraintBottom_toBottomOf="@+id/v_checkbox_bg"
        app:layout_constraintEnd_toEndOf="@+id/v_checkbox_bg"
        app:layout_constraintStart_toStartOf="@+id/v_checkbox_bg"
        app:layout_constraintTop_toTopOf="@+id/v_checkbox_bg"
        app:styleIndeterminateDrawable="@drawable/selector_dialog_protocol_check_box_icon"
        app:styleTextColor="@drawable/selector_dialog_protocol_checkbox_text"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/g_checkbox"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="         v_checkbox_bg,         cb_checkbox,         s_checkbox_top_space,         s_button_top_space"/>
    <android.widget.Space
        android:id="@+id/s_button_top_space"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_28"
        app:layout_constraintBottom_toTopOf="@+id/v_positive_button_bg"
        app:layout_constraintStart_toStartOf="@+id/v_positive_button_bg"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinView
        android:id="@+id/v_positive_button_bg"
        android:layout_width="@dimen/dp_176"
        android:layout_height="@dimen/dp_48"
        android:layout_marginBottom="@dimen/dp_32"
        app:layout_constraintBottom_toTopOf="@+id/s_bottom_state_bar"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/s_between_two_button"
        app:styleBackground="@drawable/selector_fragment_protocol_positive_button"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinTextView
        android:textSize="@dimen/sp_18"
        android:gravity="center"
        android:id="@+id/tv_positive_button_text"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/protocol_dialog_start_button_confirm"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toBottomOf="@+id/v_positive_button_bg"
        app:layout_constraintEnd_toEndOf="@+id/v_positive_button_bg"
        app:layout_constraintStart_toStartOf="@+id/v_positive_button_bg"
        app:layout_constraintTop_toTopOf="@+id/v_positive_button_bg"
        app:styleTextColor="@drawable/selector_fragment_protocol_positive_text"/>
    <android.widget.Space
        android:id="@+id/s_between_two_button"
        android:layout_width="@dimen/dp_48"
        android:layout_height="0dp"
        app:layout_constraintLeft_toRightOf="@+id/v_positive_button_bg"
        app:layout_constraintRight_toLeftOf="@+id/v_negative_button_bg"
        app:layout_constraintTop_toTopOf="@+id/v_positive_button_bg"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinView
        android:id="@+id/v_negative_button_bg"
        android:layout_width="@dimen/dp_176"
        android:layout_height="@dimen/dp_48"
        app:layout_constraintBottom_toBottomOf="@+id/v_positive_button_bg"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toRightOf="@+id/s_between_two_button"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/v_positive_button_bg"
        app:styleBackground="@drawable/bg_confirm_dialog_right_button"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinTextView
        android:textSize="@dimen/sp_18"
        android:gravity="center"
        android:id="@+id/tv_negative_button_text"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/protocol_dialog_end_button_exit"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toBottomOf="@+id/v_negative_button_bg"
        app:layout_constraintEnd_toEndOf="@+id/v_negative_button_bg"
        app:layout_constraintStart_toStartOf="@+id/v_negative_button_bg"
        app:layout_constraintTop_toTopOf="@+id/v_negative_button_bg"
        app:styleTextColor="@color/protocol_negative_button_stroke_text"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/g_start_up_fragment_buttons"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="         v_positive_button_bg,         tv_positive_button_text,         v_negative_button_bg,         tv_negative_button_text,         s_between_two_button         "/>
    <android.widget.Space
        android:id="@+id/s_reset_button_top_space"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_32"
        app:layout_constraintBottom_toTopOf="@+id/s_setting_fragment_reset_button"
        app:layout_constraintStart_toStartOf="@+id/s_setting_fragment_reset_button"/>
    <androidx.legacy.widget.Space
        android:id="@+id/s_setting_fragment_reset_button"
        android:layout_width="@dimen/dp_176"
        android:layout_height="@dimen/dp_48"
        android:layout_marginBottom="@dimen/dp_32"
        app:layout_constraintBottom_toTopOf="@+id/s_bottom_state_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/b_setting_fragment_reset_button_start"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:barrierDirection="start"
        app:constraint_referenced_ids="s_setting_fragment_reset_button, tv_setting_fragment_reset_button"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/b_setting_fragment_reset_button_end"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:barrierDirection="end"
        app:constraint_referenced_ids="s_setting_fragment_reset_button, tv_setting_fragment_reset_button"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinView
        android:id="@+id/v_setting_fragment_reset_button_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/s_setting_fragment_reset_button"
        app:layout_constraintEnd_toEndOf="@+id/b_setting_fragment_reset_button_end"
        app:layout_constraintStart_toStartOf="@+id/b_setting_fragment_reset_button_start"
        app:layout_constraintTop_toTopOf="@+id/s_setting_fragment_reset_button"
        app:styleBackground="@drawable/selector_fragment_protocol_positive_button"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinTextView
        android:textSize="@dimen/sp_18"
        android:gravity="center"
        android:id="@+id/tv_setting_fragment_reset_button"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:text="@string/protocol_dialog_end_button_reset"
        android:includeFontPadding="false"
        android:paddingHorizontal="@dimen/dp_24"
        app:layout_constraintBottom_toBottomOf="@+id/s_setting_fragment_reset_button"
        app:layout_constraintEnd_toEndOf="@+id/s_setting_fragment_reset_button"
        app:layout_constraintStart_toStartOf="@+id/s_setting_fragment_reset_button"
        app:layout_constraintTop_toTopOf="@+id/s_setting_fragment_reset_button"
        app:styleTextColor="@color/protocol_positive_button_text"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/g_setting_fragment_reset_button"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="         s_setting_fragment_reset_button,         tv_setting_fragment_reset_button,         v_setting_fragment_reset_button_bg,         s_reset_button_top_space"/>
</androidx.constraintlayout.widget.ConstraintLayout>
