<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.byd.overseaappstore.ui.view.custom.skin.SkinView
        android:id="@+id/v_topic_detaile_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:styleBackground="@drawable/bg_common_background"/>
    <android.widget.Space
        android:id="@+id/s_top_state_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/top_state_bar_height"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <android.widget.Space
        android:id="@+id/s_bottom_state_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/bottom_state_bar_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <Space
        android:id="@+id/s_anchor_top_start"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_44"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/s_top_state_bar"/>
    <Space
        android:id="@+id/s_anchor_bottom_end"
        android:layout_width="@dimen/dp_40"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/s_bottom_state_bar"
        app:layout_constraintEnd_toEndOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_topic_detail"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_10"
        app:layout_constraintBottom_toTopOf="@+id/s_anchor_bottom_end"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_include_back"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinProgressBar
        android:id="@+id/pb_loading_bar"
        android:layout_width="@dimen/dp_72"
        android:layout_height="@dimen/dp_72"
        android:indeterminateDuration="@integer/loading_duration"
        app:layout_constraintBottom_toTopOf="@+id/s_anchor_bottom_end"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_include_back"
        app:styleIndeterminateDrawable="@drawable/ic_rotate_progress_bar"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinTextView
        android:textSize="@dimen/sp_18"
        android:gravity="center"
        android:id="@+id/tv_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:text="@string/loading"
        app:layout_constraintEnd_toEndOf="@+id/pb_loading_bar"
        app:layout_constraintStart_toStartOf="@+id/pb_loading_bar"
        app:layout_constraintTop_toBottomOf="@+id/pb_loading_bar"
        app:styleTextColor="@color/no_data_text"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinAppCompatImageView
        android:id="@+id/iv_topic_detail_net_error"
        android:visibility="gone"
        android:layout_width="@dimen/dp_312"
        android:layout_height="@dimen/dp_208"
        app:layout_constraintBottom_toTopOf="@+id/s_anchor_bottom_end"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_include_back"
        app:styleSrc="@drawable/ic_net_error"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinAppCompatTextView
        android:textSize="@dimen/sp_18"
        android:gravity="center"
        android:id="@+id/tv_topic_detail_net_error"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_14"
        android:text="@string/net_no_connect"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_topic_detail_net_error"
        app:styleTextColor="@color/no_data_text"/>
    <include layout="@layout/include_top_bar_merge"/>
</androidx.constraintlayout.widget.ConstraintLayout>
