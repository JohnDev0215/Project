<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_dialog_protocol"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/v_protocol_dialog"
        android:background="@drawable/bg_common_dialog"
        android:layout_width="@dimen/dp_560"
        android:layout_height="@dimen/dp_524"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/sp_20"
        android:textColor="@color/dialog_content_text"
        android:gravity="center_vertical"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_70"
        android:text="@string/protocol_dialog_title"
        app:layout_constraintEnd_toEndOf="@+id/v_protocol_dialog"
        app:layout_constraintStart_toStartOf="@+id/v_protocol_dialog"
        app:layout_constraintTop_toTopOf="@+id/v_protocol_dialog"/>
    <View
        android:id="@+id/v_horizontal_line"
        android:background="@color/setting_over_line"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_1"
        app:layout_constraintEnd_toEndOf="@+id/v_protocol_dialog"
        app:layout_constraintStart_toStartOf="@+id/v_protocol_dialog"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <androidx.core.widget.NestedScrollView
        android:scrollbarSize="@dimen/dp_4"
        android:scrollbarThumbVertical="@drawable/scroll_bar_thumb"
        android:scrollbarTrackVertical="@drawable/scroll_bar_track"
        android:id="@+id/nsv_content"
        android:scrollbars="vertical"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_107"
        android:layout_marginBottom="@dimen/dp_160"
        android:layout_marginStart="@dimen/dp_48"
        android:layout_marginEnd="@dimen/dp_9"
        app:layout_constraintBottom_toBottomOf="@+id/v_protocol_dialog"
        app:layout_constraintEnd_toEndOf="@+id/v_protocol_dialog"
        app:layout_constraintStart_toStartOf="@+id/v_protocol_dialog"
        app:layout_constraintTop_toTopOf="@+id/v_protocol_dialog">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/dialog_content_text"
            android:gravity="start|center_vertical"
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/protocol_dialog_content"
            android:layout_marginEnd="@dimen/dp_39"/>
    </androidx.core.widget.NestedScrollView>
    <CheckBox
        android:textSize="@dimen/sp_18"
        android:textColor="@drawable/selector_dialog_protocol_checkbox_text"
        android:gravity="start|center_vertical"
        android:id="@+id/checkbox"
        android:background="@color/transparent"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_24"
        android:checked="false"
        android:button="@null"
        android:text="@string/protocol_dialog_check_box_text"
        android:drawableStart="@drawable/selector_dialog_protocol_check_box_icon"
        android:layout_marginStart="@dimen/dp_40"
        android:layout_marginEnd="@dimen/dp_40"
        app:layout_constraintEnd_toEndOf="@+id/v_protocol_dialog"
        app:layout_constraintStart_toStartOf="@+id/v_protocol_dialog"
        app:layout_constraintTop_toBottomOf="@+id/nsv_content"/>
    <View
        android:id="@+id/v_dialog_protocol_confirm_button"
        android:background="@drawable/bg_confirm_dialog_left_button_not"
        android:layout_width="@dimen/dp_176"
        android:layout_height="@dimen/dp_48"
        android:layout_marginBottom="@dimen/dp_28"
        android:layout_marginStart="@dimen/dp_80"
        app:layout_constraintBottom_toBottomOf="@+id/v_protocol_dialog"
        app:layout_constraintLeft_toLeftOf="@+id/v_protocol_dialog"/>
    <View
        android:id="@+id/v_dialog_protocol_exit_button"
        android:background="@drawable/bg_confirm_dialog_right_button"
        android:layout_width="@dimen/dp_176"
        android:layout_height="@dimen/dp_48"
        android:layout_marginEnd="@dimen/dp_80"
        app:layout_constraintRight_toRightOf="@+id/v_protocol_dialog"
        app:layout_constraintTop_toTopOf="@+id/v_dialog_protocol_confirm_button"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:enabled="false"
        android:textSize="@dimen/sp_18"
        android:textColor="@drawable/selector_dialog_protocol_positive_text"
        android:gravity="center"
        android:id="@+id/positive"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/protocol_dialog_start_button_confirm"
        app:layout_constraintBottom_toBottomOf="@+id/v_dialog_protocol_confirm_button"
        app:layout_constraintEnd_toEndOf="@+id/v_dialog_protocol_confirm_button"
        app:layout_constraintStart_toStartOf="@+id/v_dialog_protocol_confirm_button"
        app:layout_constraintTop_toTopOf="@+id/v_dialog_protocol_confirm_button"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/sp_18"
        android:textColor="@color/dialog_negative_text"
        android:gravity="center"
        android:id="@+id/negative"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/protocol_dialog_end_button_exit"
        app:layout_constraintBottom_toBottomOf="@+id/v_dialog_protocol_exit_button"
        app:layout_constraintEnd_toEndOf="@+id/v_dialog_protocol_exit_button"
        app:layout_constraintStart_toStartOf="@+id/v_dialog_protocol_exit_button"
        app:layout_constraintTop_toTopOf="@+id/v_dialog_protocol_exit_button"/>
</androidx.constraintlayout.widget.ConstraintLayout>
