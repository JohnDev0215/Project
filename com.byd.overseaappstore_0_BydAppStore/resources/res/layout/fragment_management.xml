<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_fg_download_mgr"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.byd.overseaappstore.ui.view.custom.skin.SkinView
        android:id="@+id/v_management_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:styleBackground="@drawable/bg_common_background"/>
    <android.widget.Space
        android:id="@+id/s_top_state_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/top_state_bar_height"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <android.widget.Space
        android:id="@+id/s_bottom_state_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/bottom_state_bar_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <Space
        android:id="@+id/s_anchor_top_start"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_40"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/s_top_state_bar"/>
    <Space
        android:id="@+id/s_anchor_top_end"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_40"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/s_top_state_bar"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinImageView
        android:id="@+id/iv_setting"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        android:layout_marginEnd="@dimen/dp_28"
        app:layout_constraintBottom_toBottomOf="@+id/iv_include_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_include_back"
        app:styleSrc="@drawable/ic_setting"/>
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tl_manager"
        android:background="@color/transparent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_20"
        android:layout_marginTop="@dimen/dp_9"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_include_back"
        app:tabBackground="@color/transparent"
        app:tabGravity="center"
        app:tabIndicatorColor="@color/custom_blue"
        app:tabIndicatorHeight="0dp"
        app:tabMode="scrollable"
        app:tabPaddingEnd="@dimen/dp_20"
        app:tabPaddingStart="@dimen/dp_20"
        app:tabRippleColor="@android:color/transparent"
        app:tabTextAppearance="@style/DownloadManagerSheetTextSize"
        app:tabTextColor="@color/white"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vp_manager_container"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        app:layout_constraintBottom_toTopOf="@+id/s_bottom_state_bar"
        app:layout_constraintEnd_toStartOf="@+id/s_anchor_top_end"
        app:layout_constraintStart_toEndOf="@+id/s_anchor_top_start"
        app:layout_constraintTop_toBottomOf="@+id/tl_manager"/>
    <include layout="@layout/include_top_bar_merge"/>
</androidx.constraintlayout.widget.ConstraintLayout>
