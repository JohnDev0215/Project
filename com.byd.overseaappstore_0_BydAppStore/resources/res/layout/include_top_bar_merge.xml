<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <Space
        android:id="@+id/s_title_top_start"
        android:layout_width="@dimen/dp_28"
        android:layout_height="@dimen/dp_12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/s_top_state_bar"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinImageView
        android:id="@+id/iv_include_back"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        app:layout_constraintStart_toEndOf="@+id/s_title_top_start"
        app:layout_constraintTop_toBottomOf="@+id/s_title_top_start"
        app:styleSrc="@drawable/ic_overall_back_arrow"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinTextView
        android:textSize="@dimen/sp_20"
        android:typeface="sans"
        android:textStyle="bold"
        android:gravity="start"
        android:id="@+id/tv_include_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/software_detail_top_title"
        app:layout_constraintBottom_toBottomOf="@+id/iv_include_back"
        app:layout_constraintStart_toEndOf="@+id/iv_include_back"
        app:layout_constraintTop_toTopOf="@+id/iv_include_back"
        app:styleTextColor="@color/common_primary_title_text"
        app:tabGravity="center"
        app:tabMode="fixed"/>
</merge>
