<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_dialog_work_only_wifi"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.byd.overseaappstore.ui.view.custom.skin.SkinView
        android:id="@+id/v_setting_dialog"
        android:layout_width="@dimen/dp_560"
        android:layout_height="@dimen/dp_312"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:styleBackground="@drawable/bg_common_dialog"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinTextView
        android:textSize="@dimen/sp_20"
        android:gravity="center"
        android:id="@+id/tv_setting_dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_70"
        android:layout_marginTop="0dp"
        android:text="@string/workWifi_dialog_title"
        app:layout_constraintEnd_toEndOf="@+id/v_setting_dialog"
        app:layout_constraintStart_toStartOf="@+id/v_setting_dialog"
        app:layout_constraintTop_toTopOf="@+id/v_setting_dialog"
        app:styleTextColor="@color/dialog_content_text"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinTextView
        android:textSize="@dimen/sp_20"
        android:id="@+id/tv_setting_dialog_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_14"
        android:text="@string/workWifi_dialog_content"
        android:layout_marginStart="@dimen/dp_48"
        android:layout_marginEnd="@dimen/dp_48"
        app:layout_constraintBottom_toBottomOf="@+id/v_setting_dialog"
        app:layout_constraintEnd_toEndOf="@+id/v_setting_dialog"
        app:layout_constraintStart_toStartOf="@+id/v_setting_dialog"
        app:layout_constraintTop_toTopOf="parent"
        app:styleTextColor="@color/dialog_content_text"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinView
        android:id="@+id/v_dialog_setting_clean_button"
        android:layout_width="@dimen/dp_176"
        android:layout_height="@dimen/dp_48"
        android:layout_marginLeft="@dimen/dp_80"
        android:layout_marginBottom="@dimen/dp_28"
        app:layout_constraintBottom_toBottomOf="@+id/v_setting_dialog"
        app:layout_constraintLeft_toLeftOf="parent"
        app:styleBackground="@drawable/common_dialog_start_button"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinView
        android:id="@+id/v_dialog_setting_cancel_button"
        android:layout_width="@dimen/dp_176"
        android:layout_height="0dp"
        android:layout_marginRight="@dimen/dp_80"
        app:layout_constraintBottom_toBottomOf="@+id/tv_dialog_setting_clean_button"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_dialog_setting_clean_button"
        app:styleBackground="@drawable/bg_confirm_dialog_right_button"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinTextView
        android:textSize="@dimen/sp_18"
        android:gravity="center"
        android:id="@+id/tv_dialog_setting_clean_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/workWifi_dialog_continue"
        app:layout_constraintBottom_toBottomOf="@+id/v_dialog_setting_clean_button"
        app:layout_constraintEnd_toEndOf="@+id/v_dialog_setting_clean_button"
        app:layout_constraintStart_toStartOf="@+id/v_dialog_setting_clean_button"
        app:layout_constraintTop_toTopOf="@+id/v_dialog_setting_clean_button"
        app:styleTextColor="@color/dialog_positive_text_enable"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinTextView
        android:textSize="@dimen/sp_18"
        android:gravity="center"
        android:id="@+id/tv_dialog_setting_cancel_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/workWifi_dialog_cancel"
        app:layout_constraintBottom_toBottomOf="@+id/v_dialog_setting_cancel_button"
        app:layout_constraintEnd_toEndOf="@+id/v_dialog_setting_cancel_button"
        app:layout_constraintStart_toStartOf="@+id/v_dialog_setting_cancel_button"
        app:layout_constraintTop_toTopOf="@+id/v_dialog_setting_cancel_button"
        app:styleTextColor="@color/dialog_negative_text"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinView
        android:id="@+id/v_horizontal_line"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_1"
        app:layout_constraintEnd_toEndOf="@+id/v_setting_dialog"
        app:layout_constraintStart_toStartOf="@+id/v_setting_dialog"
        app:layout_constraintTop_toBottomOf="@+id/tv_setting_dialog_title"
        app:styleBackground="@color/setting_over_line"/>
</androidx.constraintlayout.widget.ConstraintLayout>
