<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_dialog_protocol"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.byd.overseaappstore.ui.view.custom.skin.SkinView
        android:id="@+id/v_protocol_dialog"
        android:layout_width="@dimen/dp_560"
        android:layout_height="@dimen/dp_524"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:styleBackground="@drawable/bg_common_dialog"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinAppCompatTextView
        android:textSize="@dimen/sp_20"
        android:gravity="center_vertical"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_70"
        android:text="@string/protocol_dialog_title"
        app:layout_constraintEnd_toEndOf="@+id/v_protocol_dialog"
        app:layout_constraintStart_toStartOf="@+id/v_protocol_dialog"
        app:layout_constraintTop_toTopOf="@+id/v_protocol_dialog"
        app:styleTextColor="@color/dialog_content_text"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinView
        android:id="@+id/v_horizontal_line"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_1"
        app:layout_constraintEnd_toEndOf="@+id/v_protocol_dialog"
        app:layout_constraintStart_toStartOf="@+id/v_protocol_dialog"
        app:layout_constraintTop_toBottomOf="@+id/title"
        app:styleBackground="@color/setting_over_line"/>
    <androidx.core.widget.NestedScrollView
        android:scrollbarSize="@dimen/dp_4"
        android:scrollbarThumbVertical="@drawable/scroll_bar_thumb"
        android:scrollbarTrackVertical="@drawable/scroll_bar_track"
        android:id="@+id/nsv_content"
        android:scrollbars="vertical"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_107"
        android:layout_marginBottom="@dimen/dp_110"
        android:layout_marginStart="@dimen/dp_48"
        android:layout_marginEnd="@dimen/dp_9"
        app:layout_constraintBottom_toBottomOf="@+id/v_protocol_dialog"
        app:layout_constraintEnd_toEndOf="@+id/v_protocol_dialog"
        app:layout_constraintStart_toStartOf="@+id/v_protocol_dialog"
        app:layout_constraintTop_toTopOf="@+id/v_protocol_dialog">
        <com.byd.overseaappstore.ui.view.custom.skin.SkinAppCompatTextView
            android:textSize="@dimen/sp_18"
            android:gravity="start|center_vertical"
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/protocol_dialog_content"
            android:layout_marginEnd="@dimen/dp_39"
            app:styleTextColor="@color/dialog_content_text"/>
    </androidx.core.widget.NestedScrollView>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinView
        android:id="@+id/v_dialog_protocol_confirm_button"
        android:layout_width="@dimen/dp_176"
        android:layout_height="@dimen/dp_48"
        android:layout_marginBottom="@dimen/dp_28"
        android:layout_marginStart="@dimen/dp_80"
        app:layout_constraintBottom_toBottomOf="@+id/v_protocol_dialog"
        app:layout_constraintLeft_toLeftOf="@+id/v_protocol_dialog"
        app:styleBackground="@drawable/common_dialog_start_button"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinView
        android:id="@+id/v_dialog_protocol_exit_button"
        android:layout_width="@dimen/dp_176"
        android:layout_height="@dimen/dp_48"
        android:layout_marginEnd="@dimen/dp_80"
        app:layout_constraintRight_toRightOf="@+id/v_protocol_dialog"
        app:layout_constraintTop_toTopOf="@+id/v_dialog_protocol_confirm_button"
        app:styleBackground="@drawable/bg_confirm_dialog_right_button"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinAppCompatTextView
        android:textSize="@dimen/sp_18"
        android:gravity="center"
        android:id="@+id/positive"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/protocol_dialog_start_button_confirm"
        app:layout_constraintBottom_toBottomOf="@+id/v_dialog_protocol_confirm_button"
        app:layout_constraintEnd_toEndOf="@+id/v_dialog_protocol_confirm_button"
        app:layout_constraintStart_toStartOf="@+id/v_dialog_protocol_confirm_button"
        app:layout_constraintTop_toTopOf="@+id/v_dialog_protocol_confirm_button"
        app:styleTextColor="@color/positive_protocol_dialog_positive_enable"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinAppCompatTextView
        android:textSize="@dimen/sp_18"
        android:gravity="center"
        android:id="@+id/negative"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/protocol_dialog_end_button_reset"
        app:layout_constraintBottom_toBottomOf="@+id/v_dialog_protocol_exit_button"
        app:layout_constraintEnd_toEndOf="@+id/v_dialog_protocol_exit_button"
        app:layout_constraintStart_toStartOf="@+id/v_dialog_protocol_exit_button"
        app:layout_constraintTop_toTopOf="@+id/v_dialog_protocol_exit_button"
        app:styleTextColor="@color/positive_protocol_dialog_checkbox_not_checked"/>
</androidx.constraintlayout.widget.ConstraintLayout>
