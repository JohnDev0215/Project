<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_panel"
    app:startDestination="@+id/featureFragment">
    <fragment
        android:label="fragment_feature"
        android:name="com.byd.overseaappstore.ui.view.fragment.FeatureFragment"
        android:id="@+id/featureFragment">
        <argument
            android:name="software_id"
            android:defaultValue="0"
            app:argType="integer"/>
        <action
            android:id="@+id/action_feature_to_software_detail"
            app:destination="@+id/softwareDetailFragment"/>
        <action
            android:id="@+id/action_feature_to_topicDetail"
            app:destination="@+id/topicDetailFragment"/>
    </fragment>
    <fragment
        android:label="fragment_management"
        android:name="com.byd.overseaappstore.ui.view.fragment.manage.ManagementFragment"
        android:id="@+id/managementFragment">
        <action
            android:id="@+id/action_management_to_software_detail"
            app:destination="@+id/softwareDetailFragment"/>
        <action
            android:id="@+id/action_management_to_setting"
            app:destination="@+id/settingFragment"/>
    </fragment>
    <fragment
        android:label="fragment_search_active"
        android:name="com.byd.overseaappstore.ui.view.fragment.SearchActiveFragment"
        android:id="@+id/searchActiveFragment">
        <action
            android:id="@+id/action_search_active_to_software_detail"
            app:destination="@+id/softwareDetailFragment"/>
    </fragment>
    <fragment
        android:label="fragment_setting"
        android:name="com.byd.overseaappstore.ui.view.fragment.SettingFragment"
        android:id="@+id/settingFragment">
        <action
            android:id="@+id/action_setting_to_setting_protocol"
            app:destination="@+id/protocol_Fragment"/>
    </fragment>
    <fragment
        android:label="SoftwareDetailFragment"
        android:name="com.byd.overseaappstore.ui.view.fragment.SoftwareDetailFragment"
        android:id="@+id/softwareDetailFragment">
        <argument
            android:name="software_id"
            android:defaultValue="0"
            app:argType="integer"/>
        <action
            android:id="@+id/action_software_detail_to_software_detail_preview"
            app:destination="@+id/softwareDetailPreviewFragment"/>
    </fragment>
    <fragment
        android:label="TopicDetailFragment"
        android:name="com.byd.overseaappstore.ui.view.fragment.TopicDetailFragment"
        android:id="@+id/topicDetailFragment">
        <argument
            android:name="topic_group_id"
            android:defaultValue="0"
            app:argType="integer"/>
        <argument
            android:name="topic_group_title"
            android:defaultValue=""
            app:argType="string"/>
        <action
            android:id="@+id/action_topic_detail_to_software_detail"
            app:destination="@+id/softwareDetailFragment"/>
    </fragment>
    <fragment
        android:label="SoftwareDetailPreviewFragment"
        android:name="com.byd.overseaappstore.ui.view.fragment.SoftwareDetailPreviewImageFragment"
        android:id="@+id/softwareDetailPreviewFragment">
        <argument
            android:name="image_position"
            android:defaultValue="0"
            app:argType="integer"/>
        <argument
            android:name="images_path"
            android:defaultValue="@null"
            app:argType="com.byd.overseaappstore.module.ability.data.upper.SoftwareDetailPreviewImages"
            app:nullable="true"/>
    </fragment>
    <fragment
        android:label="ProtocolFragment"
        android:name="com.byd.overseaappstore.ui.view.fragment.ProtocolFragment"
        android:id="@+id/protocol_Fragment">
        <argument
            android:name="protocol_type"
            android:defaultValue=""
            app:argType="string"/>
    </fragment>
</navigation>
