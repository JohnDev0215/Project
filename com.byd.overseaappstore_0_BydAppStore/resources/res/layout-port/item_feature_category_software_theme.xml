<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <Space
        android:id="@+id/s_software_theme_anchor_top_start"
        android:layout_width="@dimen/dp_32"
        android:layout_height="@dimen/dp_32"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <Space
        android:id="@+id/s_software_theme_item_panel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintStart_toEndOf="@+id/s_software_theme_anchor_top_start"
        app:layout_constraintTop_toBottomOf="@+id/s_software_theme_anchor_top_start"/>
    <Space
        android:id="@+id/s_software_theme_anchor_bottom_end"
        android:layout_width="@dimen/dp_32"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="@+id/s_software_theme_item_panel"
        app:layout_constraintTop_toBottomOf="@+id/rv_software_theme_apps"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinAppCompatTextView
        android:textSize="@dimen/sp_20"
        android:id="@+id/tv_feature_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxEms="@integer/feature_fragment_theme_title_limit"
        android:singleLine="true"
        app:layout_constraintStart_toStartOf="@+id/s_software_theme_item_panel"
        app:layout_constraintTop_toTopOf="@+id/s_software_theme_item_panel"
        app:styleTextColor="@color/feature_software_theme_title"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinAppCompatImageView
        android:id="@+id/iv_feature_more_icon"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        app:layout_constraintBottom_toBottomOf="@+id/tv_feature_title"
        app:layout_constraintEnd_toEndOf="@+id/s_software_theme_item_panel"
        app:layout_constraintTop_toTopOf="@+id/tv_feature_title"
        app:styleSrc="@drawable/ic_overall_enter_arrow"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinAppCompatTextView
        android:textSize="@dimen/sp_20"
        android:id="@+id/tv_feature_more_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/feature_category_more_text"
        app:layout_constraintBottom_toBottomOf="@+id/tv_feature_title"
        app:layout_constraintEnd_toStartOf="@+id/iv_feature_more_icon"
        app:layout_constraintTop_toTopOf="@+id/tv_feature_title"
        app:styleTextColor="@color/feature_software_theme_more_text"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinView
        android:id="@+id/v_feature_more_hot_click"
        android:layout_width="@dimen/dp_80"
        android:layout_height="@dimen/dp_40"
        app:layout_constraintBottom_toBottomOf="@+id/iv_feature_more_icon"
        app:layout_constraintEnd_toEndOf="@+id/iv_feature_more_icon"
        app:layout_constraintStart_toStartOf="@+id/tv_feature_more_text"
        app:layout_constraintTop_toTopOf="@+id/iv_feature_more_icon"/>
    <ImageView
        android:id="@+id/iv_feature_detail_img"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_192"
        android:layout_marginTop="20dp"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:layout_constraintEnd_toEndOf="@+id/s_software_theme_item_panel"
        app:layout_constraintStart_toStartOf="@+id/s_software_theme_item_panel"
        app:layout_constraintTop_toBottomOf="@+id/tv_feature_title"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_software_theme_apps"
        android:paddingBottom="@dimen/dp_30"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_feature_detail_img"/>
</androidx.constraintlayout.widget.ConstraintLayout>
