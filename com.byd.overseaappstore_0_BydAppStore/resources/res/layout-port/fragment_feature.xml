<?xml version="1.0" encoding="utf-8"?>
<com.byd.overseaappstore.ui.view.custom.skin.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_fg_feature"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:styleBackground="@drawable/bg_common_background">
    <android.widget.Space
        android:id="@+id/s_top_state_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/top_state_bar_height"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <android.widget.Space
        android:id="@+id/s_bottom_state_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/bottom_state_bar_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <Space
        android:id="@+id/s_feature_anchor_bottom_end"
        android:layout_width="@dimen/dp_40"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/s_bottom_state_bar"
        app:layout_constraintEnd_toEndOf="parent"/>
    <include
        android:id="@+id/i_feature_head"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/layout_feature_fragment_head"/>
    <com.byd.overseaappstore.ui.view.custom.PullToRefreshView
        android:id="@+id/prsv_feature"
        android:scrollbars="none"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/s_feature_anchor_bottom_end"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/i_feature_head">
        <androidx.core.widget.NestedScrollView
            android:orientation="vertical"
            android:id="@+id/ll_feature_item"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_feature_wrap"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.byd.overseaappstore.ui.view.custom.CustomViewPager
                    android:id="@+id/vp_banner"
                    android:clipChildren="false"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_226"
                    android:layout_marginStart="@dimen/dp_40"
                    android:layout_marginEnd="@dimen/dp_40"
                    android:paddingHorizontal="@dimen/dp_250"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:orientation="horizontal"
                    android:id="@+id/rv_feature_center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_28"
                    android:overScrollMode="never"
                    android:layout_marginStart="@dimen/dp_23"
                    android:layout_marginEnd="@dimen/dp_23"/>
                <com.byd.overseaappstore.ui.view.custom.skin.SkinAppCompatImageView
                    android:id="@+id/iv_mid_cut_line"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_1"
                    android:layout_marginStart="@dimen/dp_40"
                    android:layout_marginEnd="@dimen/dp_40"
                    app:styleBackground="@color/common_boundary_line"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_feature_category"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_4"
                    android:overScrollMode="never"
                    android:layout_marginStart="@dimen/dp_40"
                    android:layout_marginEnd="@dimen/dp_40"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </com.byd.overseaappstore.ui.view.custom.PullToRefreshView>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinAppCompatImageView
        android:id="@+id/iv_feature_error"
        android:visibility="gone"
        android:layout_marginBottom="@dimen/dp_31"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:styleSrc="@drawable/ic_net_error"
        style="@style/ErrorImageStyle"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinTextView
        android:gravity="center"
        android:id="@+id/tv_feature_error"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_14"
        android:text="@string/net_connect_out_time"
        app:layout_constraintEnd_toEndOf="@+id/iv_feature_error"
        app:layout_constraintStart_toStartOf="@+id/iv_feature_error"
        app:layout_constraintTop_toBottomOf="@+id/iv_feature_error"
        app:styleTextColor="@color/net_error_text"
        style="@style/ErrorTextStyle"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinProgressBar
        android:id="@+id/pb_loading_bar"
        android:layout_width="@dimen/dp_30"
        android:layout_height="@dimen/dp_30"
        android:indeterminateDuration="@integer/loading_duration"
        app:layout_constraintBottom_toTopOf="@+id/s_feature_anchor_bottom_end"
        app:layout_constraintEnd_toStartOf="@+id/tv_loading"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/i_feature_head"
        app:styleIndeterminateDrawable="@drawable/ic_rotate_progress_bar"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinTextView
        android:textSize="@dimen/sp_18"
        android:gravity="center"
        android:id="@+id/tv_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/loading"
        android:layout_marginStart="@dimen/dp_20"
        app:layout_constraintBottom_toBottomOf="@+id/pb_loading_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/pb_loading_bar"
        app:layout_constraintTop_toTopOf="@+id/pb_loading_bar"
        app:styleTextColor="@color/no_data_text"/>
</com.byd.overseaappstore.ui.view.custom.skin.SkinConstraintLayout>
