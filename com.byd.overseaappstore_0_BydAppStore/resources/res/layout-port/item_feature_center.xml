<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dp_36">
    <ImageView
        android:id="@+id/iv_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/CommonIconSize"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinTextView
        android:ellipsize="end"
        android:id="@+id/tv_name"
        android:layout_marginTop="@dimen/dp_12"
        android:maxLines="1"
        android:maxEms="@integer/feature_fragment_center_app_name"
        app:layout_constraintEnd_toEndOf="@+id/iv_icon"
        app:layout_constraintStart_toStartOf="@+id/iv_icon"
        app:layout_constraintTop_toBottomOf="@+id/iv_icon"
        app:styleTextColor="@color/feature_title_text"
        style="@style/CenterSoftwareTitleStyle"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinTextView
        android:id="@+id/tv_size"
        app:layout_constraintEnd_toEndOf="@+id/tv_name"
        app:layout_constraintStart_toStartOf="@+id/tv_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_name"
        app:styleTextColor="@color/feature_size_text"
        style="@style/CenterSoftwareDescribeStyle"/>
    <com.byd.overseaappstore.ui.view.custom.DownloadProgressButtonView
        android:id="@+id/iv_down_load"
        android:layout_width="@dimen/dp_128"
        android:layout_height="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_19"
        app:layout_constraintEnd_toEndOf="@+id/tv_size"
        app:layout_constraintStart_toStartOf="@+id/tv_size"
        app:layout_constraintTop_toBottomOf="@+id/tv_size"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinView
        android:id="@+id/v_click_hot_spot"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_size"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_icon"/>
</androidx.constraintlayout.widget.ConstraintLayout>
