<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <Space
        android:id="@+id/s_topic_detail_app_top_start"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <Space
        android:id="@+id/s_topic_detail_app_bottom_end"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_22"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_topic_detail_app_theme"/>
    <ImageView
        android:id="@+id/iv_topic_detail_app_icon"
        app:layout_constraintStart_toEndOf="@+id/s_topic_detail_app_top_start"
        app:layout_constraintTop_toBottomOf="@+id/s_topic_detail_app_top_start"
        style="@style/DetailIconSize"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinAppCompatTextView
        android:id="@+id/tv_topic_detail_app_name"
        android:layout_marginStart="@dimen/dp_16"
        app:layout_constraintBottom_toTopOf="@+id/tv_topic_detail_app_theme"
        app:layout_constraintStart_toEndOf="@+id/iv_topic_detail_app_icon"
        app:layout_constraintTop_toTopOf="@+id/iv_topic_detail_app_icon"
        app:styleTextColor="@color/common_primary_item_title_text"
        style="@style/DetailTitleStyle"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinAppCompatTextView
        android:id="@+id/tv_topic_detail_app_theme"
        app:layout_constraintBottom_toBottomOf="@+id/iv_topic_detail_app_icon"
        app:layout_constraintStart_toStartOf="@+id/tv_topic_detail_app_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_topic_detail_app_name"
        app:styleTextColor="@color/common_secondary_text"
        style="@style/DetailDescribeStyle"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinView
        android:id="@+id/v_topic_detail_app_theme_boundary"
        android:layout_width="@dimen/dp_1"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/dp_6"
        app:layout_constraintBottom_toBottomOf="@+id/tv_topic_detail_app_theme"
        app:layout_constraintStart_toEndOf="@+id/tv_topic_detail_app_theme"
        app:layout_constraintTop_toTopOf="@+id/tv_topic_detail_app_theme"
        app:styleBackground="@drawable/line_text_short_boundary"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinAppCompatTextView
        android:id="@+id/tv_topic_detail_app_size"
        android:layout_marginStart="@dimen/dp_6"
        app:layout_constraintBottom_toBottomOf="@+id/tv_topic_detail_app_theme"
        app:layout_constraintStart_toEndOf="@+id/v_topic_detail_app_theme_boundary"
        app:layout_constraintTop_toTopOf="@+id/tv_topic_detail_app_theme"
        app:styleTextColor="@color/common_secondary_text"
        style="@style/DetailDescribeStyle"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinView
        android:id="@+id/v_topic_detail_app_click_hot_spot"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/s_topic_detail_app_bottom_end"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/s_topic_detail_app_top_start"/>
    <com.byd.overseaappstore.ui.view.custom.DownloadProgressButtonView
        android:id="@+id/pb_topic_detail_app_button"
        android:layout_width="@dimen/dp_128"
        android:layout_height="@dimen/dp_40"
        app:layout_constraintBottom_toBottomOf="@+id/iv_topic_detail_app_icon"
        app:layout_constraintEnd_toStartOf="@+id/s_topic_detail_app_bottom_end"
        app:layout_constraintTop_toTopOf="@+id/iv_topic_detail_app_icon"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinView
        android:id="@+id/v_topic_detail_app_boundary"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_1"
        app:layout_constraintEnd_toStartOf="@+id/s_topic_detail_app_bottom_end"
        app:layout_constraintStart_toEndOf="@+id/s_topic_detail_app_top_start"
        app:layout_constraintTop_toBottomOf="@+id/s_topic_detail_app_bottom_end"
        app:styleBackground="@drawable/line_recyclerview_horizontal_boundary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
