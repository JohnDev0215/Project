<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_fg_software_detail_preview_image"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <android.widget.Space
        android:id="@+id/s_top_state_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/top_state_bar_height"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <android.widget.Space
        android:id="@+id/s_bottom_state_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/bottom_state_bar_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinView
        android:id="@+id/v_detail_preview_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:styleBackground="@drawable/bg_common_background"/>
    <android.widget.Space
        android:id="@+id/s_app_detail_anchor_top_start"
        android:layout_width="@dimen/dp_30"
        android:layout_height="@dimen/dp_30"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/s_top_state_bar"/>
    <android.widget.Space
        android:id="@+id/s_app_detail_anchor_bottom_end"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/s_bottom_state_bar"
        app:layout_constraintEnd_toEndOf="parent"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vp_app_detail_preview_images"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/s_bottom_state_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/s_top_state_bar"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinAppCompatImageView
        android:id="@+id/iv_app_detail_preview_back"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_40"
        android:layout_marginLeft="@dimen/dp_30"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/s_app_detail_anchor_top_start"
        app:styleBackground="@drawable/ic_overall_back_cross"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_app_detail_bottom_page_number_view"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_52"
        android:layout_alignParentBottom="true"
        app:layout_constraintBottom_toTopOf="@+id/s_bottom_state_bar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
