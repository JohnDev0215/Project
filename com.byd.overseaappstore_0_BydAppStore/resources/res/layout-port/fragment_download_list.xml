<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_fg_download_list"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <Space
        android:id="@+id/s_anchor_top_start"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_14"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <Space
        android:id="@+id/s_anchor_top_end"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_14"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinAppCompatImageView
        android:id="@+id/iv_all_start"
        android:layout_width="@dimen/dp_32"
        android:layout_height="@dimen/dp_32"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/s_anchor_top_start"
        app:styleSrc="@drawable/ic_all_start"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinTextView
        android:textSize="@dimen/sp_18"
        android:gravity="center"
        android:id="@+id/tv_all_start"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_24"
        android:layout_marginLeft="@dimen/dp_4"
        android:text="@string/all_start"
        app:layout_constraintBottom_toBottomOf="@+id/iv_all_start"
        app:layout_constraintLeft_toRightOf="@+id/iv_all_start"
        app:layout_constraintTop_toTopOf="@+id/iv_all_start"
        app:styleTextColor="@color/management_all_start"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinAppCompatImageView
        android:id="@+id/iv_all_stop"
        android:layout_width="@dimen/dp_32"
        android:layout_height="@dimen/dp_32"
        android:layout_marginLeft="@dimen/dp_44"
        app:layout_constraintBottom_toBottomOf="@+id/iv_all_start"
        app:layout_constraintLeft_toRightOf="@+id/tv_all_start"
        app:layout_constraintTop_toTopOf="@+id/iv_all_start"
        app:styleSrc="@drawable/ic_all_stop"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinTextView
        android:textSize="@dimen/sp_18"
        android:gravity="center"
        android:id="@+id/tv_all_stop"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_24"
        android:layout_marginLeft="@dimen/dp_4"
        android:text="@string/all_stop"
        app:layout_constraintBottom_toBottomOf="@+id/iv_all_start"
        app:layout_constraintLeft_toRightOf="@+id/iv_all_stop"
        app:layout_constraintTop_toTopOf="@+id/iv_all_start"
        app:styleTextColor="@color/management_all_start"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_download_list"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_all_start"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinAppCompatImageView
        android:id="@+id/iv_download_null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="@dimen/error_view_bias_for_download_manage"
        app:styleSrc="@drawable/ic_no_data"
        style="@style/ErrorImageStyle"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinAppCompatTextView
        android:id="@+id/tv_download_reminder"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_24"
        android:text="@string/download_list_null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_download_null"
        app:styleTextColor="@color/no_data_text"
        style="@style/ErrorTextStyle"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/g_start_pause_all"
        android:visibility="gone"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        app:constraint_referenced_ids="tv_all_start,tv_all_stop,iv_all_start,iv_all_stop"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/g_error"
        android:visibility="gone"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        app:constraint_referenced_ids="iv_download_null,tv_download_reminder"/>
</androidx.constraintlayout.widget.ConstraintLayout>
