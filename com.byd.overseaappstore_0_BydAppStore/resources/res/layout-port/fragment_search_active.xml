<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_fragment_search_active"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/v_blank"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinView
        android:id="@+id/v_search_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:styleBackground="@drawable/bg_common_background"/>
    <android.widget.Space
        android:id="@+id/s_top_state_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/top_state_bar_height"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <android.widget.Space
        android:id="@+id/s_bottom_state_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/bottom_state_bar_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <android.widget.Space
        android:id="@+id/s_anchor_top_start"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/s_top_state_bar"
        style="@style/CommonCornerSpace"/>
    <android.widget.Space
        android:id="@+id/s_anchor_top_right"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/s_top_state_bar"
        style="@style/CommonCornerSpace"/>
    <android.widget.Space
        android:id="@+id/s_anchor_bottom_left"
        app:layout_constraintBottom_toTopOf="@+id/s_bottom_state_bar"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/CommonCornerSpace"/>
    <android.widget.Space
        android:id="@+id/s_anchor_bottom_end"
        app:layout_constraintBottom_toTopOf="@+id/s_bottom_state_bar"
        app:layout_constraintEnd_toEndOf="parent"
        style="@style/CommonCornerSpace"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinAppCompatImageView
        android:id="@+id/iv_back"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginStart="@dimen/dp_28"
        app:layout_constraintStart_toStartOf="@+id/s_anchor_top_start"
        app:layout_constraintTop_toTopOf="@+id/s_anchor_top_start"
        app:styleSrc="@drawable/ic_overall_back_arrow"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinAppCompatImageView
        android:id="@+id/iv_edit_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_48"
        android:layout_marginStart="@dimen/dp_24"
        app:layout_constraintBottom_toBottomOf="@+id/iv_back"
        app:layout_constraintEnd_toStartOf="@+id/s_anchor_top_right"
        app:layout_constraintStart_toEndOf="@+id/iv_back"
        app:layout_constraintTop_toTopOf="@+id/iv_back"
        app:styleBackground="@drawable/bg_top_bar_view_background_search_bar"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinAppCompatImageView
        android:id="@+id/iv_search_icon"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        android:layout_marginStart="@dimen/dp_6"
        app:layout_constraintBottom_toBottomOf="@+id/iv_edit_bar"
        app:layout_constraintStart_toStartOf="@+id/iv_edit_bar"
        app:layout_constraintTop_toTopOf="@+id/iv_edit_bar"
        app:styleBackground="@drawable/ic_overall_search"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinAppCompatImageView
        android:id="@+id/iv_delete_icon"
        android:visibility="gone"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        android:layout_marginEnd="@dimen/dp_6"
        app:layout_constraintBottom_toBottomOf="@+id/iv_edit_bar"
        app:layout_constraintEnd_toEndOf="@+id/iv_edit_bar"
        app:layout_constraintTop_toTopOf="@+id/iv_edit_bar"
        app:styleBackground="@drawable/ic_search_delete"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:textSize="@dimen/sp_18"
        android:id="@+id/edit_bar"
        android:background="@null"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_40"
        android:hint="@string/search_query_hint"
        android:lines="1"
        android:singleLine="true"
        android:maxLength="255"
        android:imeOptions="actionSearch"
        android:textCursorDrawable="@drawable/edit_line"
        android:textDirection="locale"
        android:layout_marginStart="@dimen/dp_56"
        android:layout_marginEnd="@dimen/dp_56"
        app:layout_constraintBottom_toBottomOf="@+id/iv_edit_bar"
        app:layout_constraintEnd_toEndOf="@+id/iv_edit_bar"
        app:layout_constraintStart_toStartOf="@+id/iv_edit_bar"
        app:layout_constraintTop_toTopOf="@+id/iv_edit_bar"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinTextView
        android:textSize="@dimen/sp_16"
        android:gravity="center_vertical"
        android:id="@+id/tv_search_result_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:text="@string/search_init_count"
        android:layout_marginStart="@dimen/dp_40"
        app:layout_constraintStart_toStartOf="@+id/s_anchor_top_start"
        app:layout_constraintTop_toBottomOf="@+id/iv_edit_bar"
        app:styleTextColor="@color/search_result_tip_color"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinTextView
        android:textSize="@dimen/sp_16"
        android:gravity="center_vertical"
        android:id="@+id/tv_search_hot_search"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_22"
        android:text="@string/hot_search_text"
        android:layout_marginStart="@dimen/dp_40"
        app:layout_constraintStart_toStartOf="@+id/s_anchor_top_start"
        app:layout_constraintTop_toBottomOf="@+id/iv_edit_bar"
        app:styleTextColor="@color/hot_search_title_color"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/rv_search_hot_search_tag"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_20"
        android:overScrollMode="never"
        app:layout_constraintEnd_toEndOf="@+id/iv_edit_bar"
        app:layout_constraintStart_toStartOf="@+id/tv_search_hot_search"
        app:layout_constraintTop_toBottomOf="@+id/tv_search_hot_search"/>
    <com.byd.overseaappstore.ui.view.custom.PullToRefreshView
        android:id="@+id/pull_to_refresh_view"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        android:layout_marginTop="@dimen/dp_6"
        android:layout_marginStart="@dimen/dp_40"
        app:layout_constraintBottom_toTopOf="@+id/s_anchor_bottom_end"
        app:layout_constraintEnd_toStartOf="@+id/s_anchor_top_right"
        app:layout_constraintStart_toStartOf="@+id/s_anchor_top_start"
        app:layout_constraintTop_toBottomOf="@+id/tv_search_result_tip">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSearchResult"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.byd.overseaappstore.ui.view.custom.PullToRefreshView>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinAppCompatImageView
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/ic_no_search_results"
        app:layout_constraintBottom_toBottomOf="@+id/s_anchor_bottom_left"
        app:layout_constraintEnd_toEndOf="@+id/s_anchor_top_right"
        app:layout_constraintStart_toStartOf="@+id/s_anchor_top_start"
        app:layout_constraintTop_toTopOf="@+id/s_anchor_top_start"
        app:styleSrc="@drawable/ic_no_search_results"
        style="@style/ErrorImageStyle"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinTextView
        android:gravity="center"
        android:id="@+id/tv_no_search_results"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/search_no_result"
        app:layout_constraintEnd_toEndOf="@+id/ic_no_search_results"
        app:layout_constraintStart_toStartOf="@+id/ic_no_search_results"
        app:layout_constraintTop_toBottomOf="@+id/ic_no_search_results"
        app:styleTextColor="@color/no_data_text"
        style="@style/ErrorTextStyle"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/g_search_hot_search"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="tv_search_hot_search, rv_search_hot_search_tag"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/g_search_search_result"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="tv_search_result_tip,pull_to_refresh_view"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/g_search_error"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="ic_no_search_results,tv_no_search_results"/>
</androidx.constraintlayout.widget.ConstraintLayout>
