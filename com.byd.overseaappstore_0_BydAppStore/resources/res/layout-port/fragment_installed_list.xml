<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <Space
        android:id="@+id/s_anchor_top_start"
        android:layout_width="@dimen/dp_8"
        android:layout_height="@dimen/dp_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <Space
        android:id="@+id/s_anchor_top_end"
        android:layout_width="@dimen/dp_8"
        android:layout_height="@dimen/dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_installed_list"
        android:visibility="gone"
        android:layout_width="@dimen/dp_0"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/s_anchor_top_end"
        app:layout_constraintStart_toEndOf="@+id/s_anchor_top_start"
        app:layout_constraintTop_toBottomOf="@+id/s_anchor_top_start"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinAppCompatImageView
        android:id="@+id/iv_un_install_app_null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="@dimen/error_view_bias_for_download_manage"
        app:styleSrc="@drawable/ic_no_data"
        style="@style/ErrorImageStyle"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinAppCompatTextView
        android:id="@+id/tv_un_install_reminder"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_24"
        android:text="@string/uninstall_list_null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_un_install_app_null"
        app:styleTextColor="@color/no_data_text"
        style="@style/ErrorTextStyle"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/g_error"
        android:visibility="gone"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        app:constraint_referenced_ids="iv_un_install_app_null,tv_un_install_reminder"/>
</androidx.constraintlayout.widget.ConstraintLayout>
