<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <Space
        android:id="@+id/s_download_start_top"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <Space
        android:id="@+id/s_download_panel"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_62"
        app:layout_constraintBottom_toTopOf="@+id/s_download_end_bottom"
        app:layout_constraintEnd_toStartOf="@+id/s_download_end_bottom"
        app:layout_constraintStart_toEndOf="@+id/s_download_start_top"
        app:layout_constraintTop_toBottomOf="@+id/s_download_start_top"/>
    <Space
        android:id="@+id/s_download_end_bottom"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_18"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/s_download_panel"/>
    <ImageView
        android:id="@+id/iv_download_icon"
        app:layout_constraintBottom_toBottomOf="@+id/s_download_panel"
        app:layout_constraintStart_toStartOf="@+id/s_download_panel"
        app:layout_constraintTop_toTopOf="@+id/s_download_panel"
        style="@style/DetailIconSize"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinAppCompatTextView
        android:textSize="@dimen/sp_20"
        android:id="@+id/tv_download_name"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_28"
        android:layout_marginStart="@dimen/dp_16"
        app:layout_constraintBottom_toTopOf="@+id/tv_download_info_area"
        app:layout_constraintStart_toEndOf="@+id/iv_download_icon"
        app:layout_constraintTop_toTopOf="@+id/s_download_panel"
        app:styleTextColor="@color/management_item_title"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinAppCompatTextView
        android:textSize="@dimen/sp_16"
        android:gravity="center"
        android:id="@+id/tv_download_info_area"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_28"
        app:layout_constraintBottom_toTopOf="@+id/pb_download_progress"
        app:layout_constraintStart_toStartOf="@+id/tv_download_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_download_name"
        app:styleTextColor="@color/management_item_subtitle"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/g_download_state_show"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="v_download_line,tv_download_size"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinView
        android:id="@+id/v_download_line"
        android:layout_width="@dimen/dp_1"
        android:layout_height="20dp"
        android:layout_marginStart="@dimen/dp_6"
        app:layout_constraintBottom_toBottomOf="@+id/tv_download_info_area"
        app:layout_constraintStart_toEndOf="@+id/tv_download_info_area"
        app:layout_constraintTop_toTopOf="@+id/tv_download_info_area"
        app:styleBackground="@color/management_item_subtitle"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinAppCompatTextView
        android:textSize="@dimen/sp_16"
        android:gravity="start|center_vertical"
        android:id="@+id/tv_download_size"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_28"
        android:layout_marginStart="@dimen/dp_6"
        app:layout_constraintStart_toEndOf="@+id/v_download_line"
        app:layout_constraintTop_toTopOf="@+id/tv_download_info_area"
        app:styleTextColor="@color/management_item_subtitle"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/g_download_state_working"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="pb_download_progress,iv_download_cancel"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/g_download_progressbar"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="pb_download_progress"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinContentLoadingProgressBar
        android:id="@+id/pb_download_progress"
        android:visibility="visible"
        android:layout_width="@dimen/dp_364"
        android:layout_height="@dimen/dp_6"
        android:max="100"
        android:progress="1"
        app:layout_constraintBottom_toBottomOf="@+id/s_download_panel"
        app:layout_constraintStart_toStartOf="@+id/tv_download_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_download_info_area"
        app:styleProgressDrawable="@drawable/view_download_progress_bar_manager_drawable"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
    <com.byd.overseaappstore.ui.view.custom.DownloadProgressButtonView
        android:id="@+id/pb_manager_download_button"
        android:layout_width="@dimen/dp_128"
        android:layout_height="@dimen/dp_40"
        app:layout_constraintBottom_toBottomOf="@+id/s_download_panel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/s_download_panel"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinAppCompatImageView
        android:id="@+id/iv_download_cancel"
        android:visibility="visible"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        android:layout_marginStart="@dimen/dp_372"
        app:layout_constraintBottom_toBottomOf="@+id/s_download_panel"
        app:layout_constraintStart_toStartOf="@+id/tv_download_name"
        app:layout_constraintTop_toTopOf="@+id/s_download_panel"
        app:styleBackground="@drawable/ic_overall_download_cancel"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinView
        android:id="@+id/v_download_divider"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/s_download_panel"
        app:layout_constraintStart_toStartOf="@+id/s_download_panel"
        app:styleBackground="@color/management_item_divide_line"/>
</androidx.constraintlayout.widget.ConstraintLayout>
