<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.byd.overseaappstore.ui.view.custom.skin.SkinView
        android:id="@+id/v_detail_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:styleBackground="@drawable/bg_common_background"/>
    <android.widget.Space
        android:id="@+id/s_top_state_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/top_state_bar_height"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <android.widget.Space
        android:id="@+id/s_bottom_state_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/bottom_state_bar_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <Space
        android:id="@+id/s_anchor_top_start"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_44"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/s_top_state_bar"/>
    <Space
        android:id="@+id/s_anchor_bottom_end"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/s_bottom_state_bar"
        app:layout_constraintEnd_toEndOf="parent"/>
    <com.byd.overseaappstore.ui.view.custom.DownloadProgressButtonView
        android:id="@+id/pb_app_detail_download_progress_button_top"
        android:visibility="invisible"
        android:layout_width="@dimen/dp_128"
        android:layout_height="@dimen/dp_40"
        android:layout_marginEnd="@dimen/dp_40"
        app:layout_constraintBottom_toBottomOf="@+id/iv_include_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_include_back"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/rsv_detail"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_16"
        app:layout_constraintBottom_toTopOf="@+id/s_anchor_bottom_end"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_include_back">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_wrap"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/iv_icon"
                android:layout_width="@dimen/dp_94"
                android:layout_height="@dimen/dp_94"
                android:layout_marginTop="@dimen/dp_6"
                android:layout_marginStart="@dimen/dp_40"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.byd.overseaappstore.ui.view.custom.skin.SkinTextView
                android:id="@+id/tv_name"
                android:layout_marginStart="@dimen/dp_20"
                app:layout_constraintBottom_toTopOf="@+id/tv_size_tip"
                app:layout_constraintStart_toEndOf="@+id/iv_icon"
                app:layout_constraintTop_toTopOf="@+id/iv_icon"
                app:styleTextColor="@color/software_detail_title_text"
                style="@style/DetailTitleStyle"/>
            <com.byd.overseaappstore.ui.view.custom.skin.SkinTextView
                android:textSize="@dimen/sp_14"
                android:id="@+id/tv_software_detail_theme_name"
                android:paddingTop="@dimen/dp_2"
                android:paddingBottom="@dimen/dp_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/dp_10"
                android:paddingEnd="@dimen/dp_10"
                android:layout_marginStart="@dimen/dp_10"
                app:layout_constraintBottom_toBottomOf="@+id/tv_name"
                app:layout_constraintStart_toEndOf="@+id/tv_name"
                app:layout_constraintTop_toTopOf="@+id/tv_name"
                app:styleBackground="@drawable/bg_software_detail_theme"
                app:styleTextColor="@color/software_detail_theme_area_text"/>
            <com.byd.overseaappstore.ui.view.custom.skin.SkinTextView
                android:id="@+id/tv_size_tip"
                android:layout_marginTop="@dimen/dp_6"
                app:layout_constraintBottom_toTopOf="@+id/pb_app_detail_download_progress_button"
                app:layout_constraintStart_toStartOf="@+id/tv_name"
                app:layout_constraintTop_toBottomOf="@+id/tv_name"
                app:styleTextColor="@color/software_detail_subtitle_text"
                style="@style/DetailDescribeStyle"/>
            <com.byd.overseaappstore.ui.view.custom.skin.SkinImageView
                android:id="@+id/detail_short_line_1"
                android:layout_width="@dimen/dp_1"
                android:layout_height="0dp"
                android:layout_marginStart="@dimen/dp_6"
                app:layout_constraintBottom_toBottomOf="@+id/tv_size_tip"
                app:layout_constraintStart_toEndOf="@+id/tv_size_tip"
                app:layout_constraintTop_toTopOf="@+id/tv_size_tip"
                app:styleBackground="@color/common_boundary_line"/>
            <com.byd.overseaappstore.ui.view.custom.skin.SkinTextView
                android:id="@+id/tv_version_tip"
                android:layout_marginStart="@dimen/dp_6"
                app:layout_constraintBottom_toBottomOf="@+id/tv_size_tip"
                app:layout_constraintStart_toEndOf="@+id/detail_short_line_1"
                app:layout_constraintTop_toTopOf="@+id/tv_size_tip"
                app:styleTextColor="@color/software_detail_subtitle_text"
                style="@style/DetailDescribeStyle"/>
            <com.byd.overseaappstore.ui.view.custom.skin.SkinImageView
                android:id="@+id/detail_short_line_2"
                android:layout_width="@dimen/dp_1"
                android:layout_height="0dp"
                android:layout_marginStart="@dimen/dp_6"
                app:layout_constraintBottom_toBottomOf="@+id/tv_size_tip"
                app:layout_constraintStart_toEndOf="@+id/tv_version_tip"
                app:layout_constraintTop_toTopOf="@+id/tv_size_tip"
                app:styleBackground="@color/common_boundary_line"/>
            <com.byd.overseaappstore.ui.view.custom.skin.SkinTextView
                android:id="@+id/tv_update_time_tip"
                android:layout_marginStart="@dimen/dp_6"
                app:layout_constraintBottom_toBottomOf="@+id/tv_version_tip"
                app:layout_constraintStart_toEndOf="@+id/detail_short_line_2"
                app:layout_constraintTop_toTopOf="@+id/tv_version_tip"
                app:styleTextColor="@color/software_detail_subtitle_text"
                style="@style/DetailDescribeStyle"/>
            <com.byd.overseaappstore.ui.view.custom.DownloadProgressButtonView
                android:id="@+id/pb_app_detail_download_progress_button"
                android:layout_width="@dimen/dp_128"
                android:layout_height="@dimen/dp_40"
                android:layout_marginTop="@dimen/dp_10"
                app:layout_constraintBottom_toBottomOf="@+id/iv_icon"
                app:layout_constraintStart_toStartOf="@+id/tv_name"
                app:layout_constraintTop_toBottomOf="@+id/tv_size_tip"/>
            <com.byd.overseaappstore.ui.view.custom.skin.SkinTextView
                android:id="@+id/tv_app_orientation"
                android:layout_marginStart="@dimen/dp_16"
                app:layout_constraintBottom_toBottomOf="@+id/pb_app_detail_download_progress_button"
                app:layout_constraintStart_toEndOf="@+id/pb_app_detail_download_progress_button"
                app:layout_constraintTop_toTopOf="@+id/pb_app_detail_download_progress_button"
                app:styleTextColor="@color/common_secondary_text"
                style="@style/DetailDescribeStyle"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/common_primary_item_title_text"
                android:id="@+id/tv_version_introduction_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_26"
                android:text="@string/software_detail_version_introduction_title"
                app:layout_constraintStart_toStartOf="@+id/iv_icon"
                app:layout_constraintTop_toBottomOf="@+id/iv_icon"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/software_detail_description_text"
                android:gravity="start|center_vertical"
                android:id="@+id/tv_version_introduction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:layout_marginEnd="@dimen/dp_80"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/iv_icon"
                app:layout_constraintTop_toBottomOf="@+id/tv_version_introduction_title"/>
            <ImageView
                android:id="@+id/iv_version_introduction_fold_button"
                android:layout_width="@dimen/dp_32"
                android:layout_height="@dimen/dp_32"
                android:src="@drawable/ic_overall_unfold"
                app:layout_constraintEnd_toEndOf="@+id/tv_version_introduction"
                app:layout_constraintTop_toBottomOf="@+id/tv_version_introduction"/>
            <com.byd.overseaappstore.ui.view.custom.skin.SkinTextView
                android:textSize="@dimen/sp_20"
                android:id="@+id/tv_introduction_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_32"
                android:text="@string/software_detail_introduction_title"
                app:layout_constraintStart_toStartOf="@+id/iv_icon"
                app:layout_constraintTop_toBottomOf="@+id/tv_version_introduction"
                app:styleTextColor="@color/common_primary_item_title_text"/>
            <com.byd.overseaappstore.ui.view.custom.skin.SkinTextView
                android:textSize="@dimen/sp_18"
                android:gravity="start|center_vertical"
                android:id="@+id/tv_introduction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:layout_marginEnd="@dimen/dp_80"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/iv_icon"
                app:layout_constraintTop_toBottomOf="@+id/tv_introduction_title"
                app:styleTextColor="@color/software_detail_description_text"/>
            <com.byd.overseaappstore.ui.view.custom.skin.SkinImageView
                android:id="@+id/iv_introduction_fold_button"
                android:layout_width="@dimen/dp_32"
                android:layout_height="@dimen/dp_32"
                app:layout_constraintEnd_toEndOf="@+id/tv_introduction"
                app:layout_constraintTop_toBottomOf="@+id/tv_introduction"
                app:styleSrc="@drawable/ic_overall_unfold"/>
            <com.byd.overseaappstore.ui.view.custom.HorizontalRecycleView
                android:id="@+id/rv_software_detail_preview_images"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_26"
                android:layout_marginStart="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/iv_icon"
                app:layout_constraintTop_toBottomOf="@+id/iv_introduction_fold_button"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinProgressBar
        android:id="@+id/pb_loading_bar"
        android:layout_width="@dimen/dp_30"
        android:layout_height="@dimen/dp_30"
        android:indeterminateDuration="@integer/loading_duration"
        app:layout_constraintBottom_toTopOf="@+id/s_anchor_bottom_end"
        app:layout_constraintEnd_toStartOf="@+id/tv_loading"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_include_back"
        app:styleIndeterminateDrawable="@drawable/ic_rotate_progress_bar"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinTextView
        android:textSize="@dimen/sp_18"
        android:gravity="center"
        android:id="@+id/tv_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/loading"
        android:layout_marginStart="@dimen/dp_20"
        app:layout_constraintBottom_toBottomOf="@+id/pb_loading_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/pb_loading_bar"
        app:layout_constraintTop_toTopOf="@+id/pb_loading_bar"
        app:styleTextColor="@color/no_data_text"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinAppCompatImageView
        android:id="@+id/iv_detail_error"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/s_anchor_bottom_end"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_include_back"
        app:styleSrc="@drawable/ic_net_error"
        style="@style/ErrorImageStyle"/>
    <com.byd.overseaappstore.ui.view.custom.skin.SkinTextView
        android:textSize="@dimen/sp_14"
        android:gravity="center"
        android:id="@+id/tv_detail_error"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_18"
        android:text="@string/net_connect_out_time"
        app:layout_constraintEnd_toEndOf="@+id/iv_detail_error"
        app:layout_constraintStart_toStartOf="@+id/iv_detail_error"
        app:layout_constraintTop_toBottomOf="@+id/iv_detail_error"
        app:styleTextColor="@color/no_data_text"/>
    <include layout="@layout/include_top_bar_merge"/>
</androidx.constraintlayout.widget.ConstraintLayout>
