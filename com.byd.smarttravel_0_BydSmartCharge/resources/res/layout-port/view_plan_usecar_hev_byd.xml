<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="layout-port/view_plan_usecar_hev_byd_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.byd.widget.BydSwitch
        android:id="@+id/sbg_charge"
        android:layout_marginTop="@dimen/dp_71"
        android:layout_marginRight="@dimen/dp_32"
        android:layout_alignParentRight="true"
        style="@style/bydswitch_style"/>
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="?attr/dialog_title"
        android:gravity="center"
        android:id="@+id/tv_fun_name"
        android:layout_width="wrap_content"
        android:layout_height="?attr/dp_title_height"
        android:layout_marginTop="@dimen/dp_66"
        android:layout_marginRight="@dimen/dp_111"
        android:maxWidth="@dimen/dp_300"
        android:text="@string/plan_use_car"
        android:layout_alignParentRight="true"/>
    <ImageView
        android:id="@+id/iv_bg"
        android:layout_width="@dimen/dp_656"
        android:layout_height="@dimen/dp_388"
        android:layout_marginTop="@dimen/dp_236"
        android:src="@drawable/usercar_img_light_wisdom_car_bg"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="?attr/charge_text_white"
        android:gravity="center_vertical"
        android:id="@+id/tv_usecar"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_336"
        android:text="@string/use_car"
        android:layout_centerHorizontal="true"
        android:drawableEnd="@drawable/icon_light_public_edit_48"
        android:layout_marginStart="@dimen/dp_15"
        android:layout_toEndOf="@+id/tv_start_time"
        android:drawableTint="?attr/edit_time_blue"/>
    <TextView
        android:textSize="@dimen/sp_64"
        android:textColor="?attr/charge_text_white"
        android:gravity="center"
        android:id="@+id/tv_start_time"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_75"
        android:layout_marginTop="@dimen/dp_313"
        android:text=""
        android:layout_marginStart="@dimen/dp_31"
        android:layout_alignStart="@+id/iv_bg"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="?attr/charge_text_white"
        android:id="@+id/tv_week"
        android:layout_width="@dimen/dp_594"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_400"
        android:layout_marginStart="@dimen/dp_31"
        android:layout_alignStart="@+id/iv_bg"/>
    <TextView
        android:textSize="@dimen/sp_24"
        android:textColor="?attr/charge_text_white"
        android:id="@+id/tv_price_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_503"
        android:layout_marginBottom="@dimen/dp_6"
        android:text="@string/discount_price_zone"
        android:layout_marginStart="@dimen/dp_31"
        android:layout_alignStart="@+id/iv_bg"/>
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="?attr/charge_text_white"
        android:gravity="center_vertical"
        android:id="@+id/tv_price_time"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_48"
        android:text="00:00-07:00"
        android:layout_below="@+id/tv_price_title"
        android:layout_marginStart="@dimen/dp_31"
        android:layout_alignStart="@+id/iv_bg"/>
    <ImageView
        android:id="@+id/iv_price_time"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        android:src="@drawable/icon_light_public_edit_48"
        android:tint="?attr/edit_time_blue"
        android:layout_below="@+id/tv_price_title"
        android:layout_toEndOf="@+id/tv_price_time"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_28"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="?attr/text_color_gray"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/dp_32"
            android:text="@string/smart_temp_tips"
            android:drawableStart="@drawable/icon_light_public_electricity_32"
            android:drawableTint="?attr/text_color_gray"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="?attr/text_color_gray"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/dp_32"
            android:text="@string/item_hot_title"
            android:drawableStart="@drawable/icon_light_public_dashboard_32"
            android:drawableTint="?attr/text_color_gray"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="?attr/price_time_blue"
            android:gravity="center"
            android:id="@+id/tv_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/learn_more"
            android:drawableEnd="@drawable/icon_light_public_rightarrow_s_24"
            android:drawableTint="?attr/text_color_blue"/>
    </LinearLayout>
    <com.byd.widget.ChargeAnimView
        android:id="@+id/charge_anim_view"
        android:layout_width="@dimen/dp_460"
        android:layout_height="@dimen/dp_315"
        android:layout_marginBottom="@dimen/dp_89"
        android:src="@drawable/usercar_img_light_wisdom_car_bg"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
    <RelativeLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_92"
        android:layout_marginLeft="@dimen/dp_150"
        android:layout_marginRight="@dimen/dp_150"
        android:layout_marginBottom="@dimen/dp_355"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <ImageView
            android:id="@+id/ic_chargegun_highlight"
            android:layout_width="@dimen/dp_72"
            android:layout_height="@dimen/dp_72"
            android:layout_marginRight="@dimen/dp_8"
            android:src="@drawable/icon_chargegun_highlight"/>
        <TextView
            android:textSize="@dimen/sp_24"
            android:textColor="?attr/usecar_chargegun_gray"
            android:id="@+id/tv_charge_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gun_already_plug"
            android:layout_marginStart="@dimen/dp_80"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="?attr/usecar_chargegun_time_gray"
            android:id="@+id/tv_remain_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_6"
            android:text="@string/state_charging_width_end"
            android:layout_below="@+id/tv_charge_status"
            android:layout_marginStart="@dimen/dp_80"/>
    </RelativeLayout>
</RelativeLayout>
