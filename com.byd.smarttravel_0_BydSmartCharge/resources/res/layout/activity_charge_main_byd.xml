<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="layout/activity_charge_main_byd_0"
    android:paddingTop="@dimen/dp_56"
    android:paddingBottom="@dimen/dp_60"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/sp_20"
        android:textStyle="bold"
        android:textColor="?attr/text_color_main"
        android:gravity="center_vertical"
        android:id="@+id/tv_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_20"
        android:text="@string/app_name"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="?attr/text_color_main"
        android:gravity="center"
        android:id="@+id/tv_setting"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginRight="@dimen/dp_40"
        android:text="@string/settings"
        android:layout_alignParentRight="true"
        android:drawableStart="@drawable/icon_light_navigation_setting_48"/>
    <View
        android:background="?attr/bg_color_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_marginTop="@dimen/dp_61"
        android:layout_marginStart="@dimen/dp_40"
        android:layout_marginEnd="@dimen/dp_40"/>
    <FrameLayout
        android:id="@+id/fr_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dp_62"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="?attr/dialog_text_color_tips"
        android:gravity="center"
        android:id="@+id/tv_mode"
        android:background="@drawable/bg_switch_mode"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_48"
        android:layout_marginLeft="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_93"
        android:minWidth="@dimen/dp_192"
        android:text="@string/mode_use_car"
        android:drawablePadding="@dimen/dp_2"
        android:layout_alignParentLeft="true"
        android:drawableStart="@drawable/icon_light_public_switch_48"
        android:paddingStart="@dimen/dp_10"
        android:paddingEnd="@dimen/dp_24"
        android:drawableTint="?attr/dialog_text_color_tips"/>
</RelativeLayout>
