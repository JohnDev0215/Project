<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="layout/anim_charge_view_0"
    android:layout_width="@dimen/dp_460"
    android:layout_height="@dimen/dp_315"
    android:layoutDirection="ltr">
    <ImageView
        android:id="@+id/iv_car"
        android:layout_width="@dimen/dp_460"
        android:layout_height="@dimen/dp_315"
        android:src="@drawable/car_suv_bg"/>
    <ImageView
        android:id="@+id/iv_battery_progress"
        android:layout_width="@dimen/dp_169"
        android:layout_height="@dimen/dp_82"
        android:layout_marginTop="@dimen/dp_119"
        android:src="@drawable/battery_progress_000"
        android:layout_marginStart="@dimen/dp_155"/>
    <ImageView
        android:id="@+id/iv_scan"
        android:layout_width="@dimen/dp_169"
        android:layout_height="@dimen/dp_82"
        android:layout_marginTop="@dimen/dp_119"
        android:src="@drawable/battery_scan_011"
        android:layout_marginStart="@dimen/dp_155"/>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_92">
        <TextView
            android:textSize="@dimen/sp_40"
            android:textStyle="bold"
            android:textColor="?attr/usecar_battery_gray"
            android:id="@+id/tv_battery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:paddingStart="@dimen/dp_18"/>
        <TextView
            android:textSize="@dimen/sp_24"
            android:textStyle="bold"
            android:textColor="?attr/usecar_battery_gray"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="%"
            android:layout_marginStart="@dimen/dp_4"/>
    </LinearLayout>
</FrameLayout>
