<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="@dimen/dp_560"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="@dimen/dp_560"
        android:layout_height="@dimen/dp_192">
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_wheelview"
            android:layout_width="@dimen/dp_464"
            android:layout_height="@dimen/dp_192"
            android:layout_marginStart="@dimen/dp_48"
            android:layout_marginEnd="@dimen/dp_48">
            <com.byd.widget.WheelView
                android:id="@+id/wheelView_h"
                android:layout_width="@dimen/dp_116"
                android:layout_height="match_parent"
                app:itemNumber="3"
                app:lineColor="?attr/dialog_divider_common"
                app:lineHeight="@dimen/dp_1"
                app:noEmpty="true"
                app:normalTextColor="?attr/text_color_main_gray"
                app:normalTextSize="@dimen/sp_24"
                app:selectedTextColor="?attr/text_color_btn_blue"
                app:selectedTextSize="@dimen/sp_24"
                app:unitHeight="@dimen/dp_64"/>
            <com.byd.widget.WheelView
                android:id="@+id/wheelView_m"
                android:layout_width="@dimen/dp_116"
                android:layout_height="match_parent"
                app:itemNumber="3"
                app:lineColor="?attr/dialog_divider_common"
                app:lineHeight="@dimen/dp_1"
                app:marginStart="@dimen/dp_20"
                app:noEmpty="true"
                app:normalTextColor="?attr/text_color_main_gray"
                app:normalTextSize="@dimen/sp_24"
                app:selectedTextColor="?attr/text_color_btn_blue"
                app:selectedTextSize="@dimen/sp_24"
                app:unitHeight="@dimen/dp_64"/>
            <com.byd.widget.WheelView
                android:id="@+id/wheelView_h_e"
                android:layout_width="@dimen/dp_116"
                android:layout_height="match_parent"
                app:itemNumber="3"
                app:lineColor="?attr/dialog_divider_common"
                app:lineHeight="@dimen/dp_1"
                app:marginStart="@dimen/dp_96"
                app:noEmpty="true"
                app:normalTextColor="?attr/text_color_main_gray"
                app:normalTextSize="@dimen/sp_24"
                app:selectedTextColor="?attr/text_color_btn_blue"
                app:selectedTextSize="@dimen/sp_24"
                app:unitHeight="@dimen/dp_64"/>
            <com.byd.widget.WheelView
                android:id="@+id/wheelView_m_e"
                android:layout_width="@dimen/dp_116"
                android:layout_height="match_parent"
                app:itemNumber="3"
                app:lineColor="?attr/dialog_divider_common"
                app:lineHeight="@dimen/dp_1"
                app:noEmpty="true"
                app:normalTextColor="?attr/text_color_main_gray"
                app:normalTextSize="@dimen/sp_24"
                app:selectedTextColor="?attr/text_color_btn_blue"
                app:selectedTextSize="@dimen/sp_24"
                app:unitHeight="@dimen/dp_64"/>
        </LinearLayout>
        <View
            android:background="?attr/text_color_blue"
            android:layout_width="@dimen/dp_12"
            android:layout_height="@dimen/dp_2"
            android:layout_centerInParent="true"/>
        <TextView
            android:textSize="@dimen/sp_24"
            android:textStyle="bold"
            android:textColor="?attr/text_color_blue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=":"
            android:includeFontPadding="false"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/dp_144"/>
        <TextView
            android:textSize="@dimen/sp_24"
            android:textStyle="bold"
            android:textColor="?attr/text_color_blue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=":"
            android:includeFontPadding="false"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp_144"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="?attr/text_color_blue"
            android:gravity="center"
            android:id="@+id/tv_next_day"
            android:paddingTop="@dimen/dp_3"
            android:visibility="gone"
            android:layout_width="@dimen/dp_70"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/dp_80"
            android:text="@string/next_day"
            android:includeFontPadding="false"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/dp_290"/>
    </RelativeLayout>
    <CheckBox
        android:textSize="@dimen/sp_18"
        android:textColor="?attr/color_checked_charge_full"
        android:layout_gravity="end"
        android:id="@+id/cb_full"
        android:background="@null"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_40"
        android:button="@null"
        android:text="@string/charge_to_full"
        android:drawableStart="@drawable/checkbox_circle_bg_selector"
        android:layout_marginEnd="@dimen/dp_42"/>
    <View
        android:background="?attr/dialog_divider_common"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:paddingStart="@dimen/dp_48"
        android:paddingEnd="@dimen/dp_48"/>
    <com.byd.widget.segmentedbutton.SegmentedButtonGroup
        android:layout_gravity="start|center_vertical"
        android:id="@+id/rg_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_19"
        android:layout_marginRight="@dimen/dp_40"
        android:layout_marginBottom="@dimen/dp_17"
        app:sbg_animateSelector="fastOutSlowIn"
        app:sbg_animateSelectorDuration="1000"
        app:sbg_backgroundColor="?attr/carlights_segcontrolbutton_background"
        app:sbg_dividerPadding="@dimen/dp_10"
        app:sbg_dividerRadius="@dimen/dp_10"
        app:sbg_position="0"
        app:sbg_radius="@dimen/dp_24"
        app:sbg_ripple="true"
        app:sbg_selectorGradient_endColor="?attr/carsetting_text_color_blue"
        app:sbg_selectorGradient_startColor="?attr/carsetting_text_color_blue2">
        <com.byd.widget.segmentedbutton.SegmentedButton
            android:paddingTop="@dimen/dp_3"
            android:paddingBottom="@dimen/dp_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:minHeight="@dimen/dp_40"
            android:layout_weight="1"
            app:sb_text="@string/ont_shot"
            app:sb_textColor="?attr/carlights_guest_color"
            app:sb_textColor_onSelection="?attr/byd_button_selected_text_color"
            app:sb_textSize="@dimen/sp_20"/>
        <com.byd.widget.segmentedbutton.SegmentedButton
            android:paddingTop="@dimen/dp_3"
            android:paddingBottom="@dimen/dp_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:minHeight="@dimen/dp_40"
            android:layout_weight="1"
            app:sb_text="@string/every_day"
            app:sb_textColor="?attr/carlights_guest_color"
            app:sb_textColor_onSelection="?attr/byd_button_selected_text_color"
            app:sb_textSize="@dimen/sp_20"/>
        <com.byd.widget.segmentedbutton.SegmentedButton
            android:paddingTop="@dimen/dp_3"
            android:paddingBottom="@dimen/dp_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:minHeight="@dimen/dp_40"
            android:layout_weight="1"
            app:sb_text="@string/custom"
            app:sb_textColor="?attr/carlights_guest_color"
            app:sb_textColor_onSelection="?attr/byd_button_selected_text_color"
            app:sb_textSize="@dimen/sp_20"/>
    </com.byd.widget.segmentedbutton.SegmentedButtonGroup>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_cb_1"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dp_40"
        android:paddingEnd="@dimen/dp_40">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <CheckBox
                android:textSize="@dimen/sp_18"
                android:textColor="?attr/cb_dialog_btn_text_selector"
                android:id="@+id/cb_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_7"
                android:button="@drawable/checkbox_bg_selector"
                android:minHeight="@dimen/dp_40"
                android:text="@string/monday"/>
            <CheckBox
                android:textSize="@dimen/sp_18"
                android:textColor="?attr/cb_dialog_btn_text_selector"
                android:id="@+id/cb_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:button="@drawable/checkbox_bg_selector"
                android:minHeight="@dimen/dp_40"
                android:text="@string/friday"/>
        </LinearLayout>
        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/dp_87">
            <CheckBox
                android:textSize="@dimen/sp_18"
                android:textColor="?attr/cb_dialog_btn_text_selector"
                android:id="@+id/cb_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_7"
                android:button="@drawable/checkbox_bg_selector"
                android:minHeight="@dimen/dp_40"
                android:text="@string/tuesday"/>
            <CheckBox
                android:textSize="@dimen/sp_18"
                android:textColor="?attr/cb_dialog_btn_text_selector"
                android:id="@+id/cb_6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:button="@drawable/checkbox_bg_selector"
                android:minHeight="@dimen/dp_40"
                android:text="@string/saturday"/>
        </LinearLayout>
        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/dp_87">
            <CheckBox
                android:textSize="@dimen/sp_18"
                android:textColor="?attr/cb_dialog_btn_text_selector"
                android:id="@+id/cb_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_7"
                android:button="@drawable/checkbox_bg_selector"
                android:minHeight="@dimen/dp_40"
                android:text="@string/wednesday"/>
            <CheckBox
                android:textSize="@dimen/sp_18"
                android:textColor="?attr/cb_dialog_btn_text_selector"
                android:id="@+id/cb_7"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:button="@drawable/checkbox_bg_selector"
                android:minHeight="@dimen/dp_40"
                android:text="@string/sunday"/>
        </LinearLayout>
        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/dp_87">
            <CheckBox
                android:textSize="@dimen/sp_18"
                android:textColor="?attr/cb_dialog_btn_text_selector"
                android:id="@+id/cb_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_7"
                android:button="@drawable/checkbox_bg_selector"
                android:minHeight="@dimen/dp_40"
                android:text="@string/thursday"/>
            <CheckBox
                android:textSize="@dimen/sp_18"
                android:textColor="?attr/cb_dialog_btn_text_selector"
                android:id="@+id/cb_8"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:button="@drawable/checkbox_bg_selector"
                android:minHeight="@dimen/dp_40"
                android:text="@string/thursday"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="?attr/dialog_text_color_tips"
        android:gravity="center"
        android:id="@+id/tv_date_select_tips"
        android:paddingLeft="@dimen/dp_48"
        android:paddingRight="@dimen/dp_48"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_87"
        android:text="@string/day_select_tips_oneshot"/>
</LinearLayout>
