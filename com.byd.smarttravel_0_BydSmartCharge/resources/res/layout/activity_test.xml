<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:tag="layout/activity_test_0"
    android:paddingTop="@dimen/dp_56"
    android:paddingBottom="@dimen/dp_60"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <RelativeLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:id="@+id/btn_get"
                android:layout_width="@dimen/dp_80"
                android:layout_height="@dimen/dp_80"
                android:text="关键数据"
                android:layout_marginStart="@dimen/dp_20"/>
            <Button
                android:id="@+id/btn_timer"
                android:layout_width="@dimen/dp_80"
                android:layout_height="@dimen/dp_80"
                android:text="定时器"
                android:layout_marginStart="@dimen/dp_120"/>
            <Button
                android:id="@+id/btn_mcu"
                android:layout_width="@dimen/dp_80"
                android:layout_height="@dimen/dp_80"
                android:text="MCU闹钟"
                android:layout_marginStart="@dimen/dp_220"/>
            <Button
                android:id="@+id/btn_charge_invalid"
                android:layout_width="@dimen/dp_80"
                android:layout_height="@dimen/dp_80"
                android:text="充电无效"
                android:layout_marginStart="@dimen/dp_320"
                android:layout_marginEnd="@dimen/dp_20"/>
            <Button
                android:id="@+id/btn_charge_start"
                android:layout_width="@dimen/dp_80"
                android:layout_height="@dimen/dp_80"
                android:layout_marginTop="@dimen/dp_100"
                android:text="充电开始"
                android:layout_marginStart="@dimen/dp_20"/>
            <Button
                android:id="@+id/btn_wait"
                android:layout_width="@dimen/dp_80"
                android:layout_height="@dimen/dp_80"
                android:layout_marginTop="@dimen/dp_200"
                android:text="充电等待"
                android:layout_marginStart="@dimen/dp_20"/>
            <Button
                android:id="@+id/btn_end"
                android:layout_width="@dimen/dp_80"
                android:layout_height="@dimen/dp_80"
                android:layout_marginTop="@dimen/dp_300"
                android:text="充电结束"
                android:layout_marginStart="@dimen/dp_20"/>
            <Button
                android:id="@+id/btn_gun_now"
                android:layout_width="@dimen/dp_80"
                android:layout_height="@dimen/dp_80"
                android:layout_marginTop="@dimen/dp_300"
                android:text="插枪提醒"
                android:layout_marginStart="@dimen/dp_120"/>
            <Button
                android:id="@+id/btn_plan_change"
                android:layout_width="@dimen/dp_80"
                android:layout_height="@dimen/dp_80"
                android:layout_marginTop="@dimen/dp_300"
                android:text="计划修改"
                android:layout_marginStart="@dimen/dp_220"/>
            <Button
                android:id="@+id/btn_cloud_1"
                android:layout_width="@dimen/dp_80"
                android:layout_height="@dimen/dp_80"
                android:layout_marginTop="@dimen/dp_200"
                android:text="云控630应答"
                android:layout_marginStart="@dimen/dp_220"/>
            <Button
                android:id="@+id/btn_cloud_2"
                android:layout_width="@dimen/dp_80"
                android:layout_height="@dimen/dp_80"
                android:layout_marginTop="@dimen/dp_100"
                android:text="云控631应答"
                android:layout_marginStart="@dimen/dp_220"/>
            <Button
                android:id="@+id/btn_cloud_3"
                android:layout_width="@dimen/dp_80"
                android:layout_height="@dimen/dp_80"
                android:layout_marginTop="@dimen/dp_100"
                android:text="云控632计划"
                android:layout_marginStart="@dimen/dp_120"/>
            <Button
                android:id="@+id/btn_cloud_4"
                android:layout_width="@dimen/dp_80"
                android:layout_height="@dimen/dp_80"
                android:layout_marginTop="@dimen/dp_200"
                android:text="云控632时区"
                android:layout_marginStart="@dimen/dp_120"/>
            <Button
                android:id="@+id/btn_cloud_5"
                android:layout_width="@dimen/dp_80"
                android:layout_height="@dimen/dp_80"
                android:layout_marginTop="@dimen/dp_200"
                android:text="云控633"
                android:layout_marginStart="@dimen/dp_320"/>
            <Button
                android:id="@+id/btn_cloud_6"
                android:layout_width="@dimen/dp_80"
                android:layout_height="@dimen/dp_80"
                android:layout_marginTop="@dimen/dp_100"
                android:text="云控请求获取"
                android:layout_marginStart="@dimen/dp_320"/>
            <Button
                android:id="@+id/btn_cloud_7"
                android:layout_width="@dimen/dp_80"
                android:layout_height="@dimen/dp_80"
                android:layout_marginTop="@dimen/dp_300"
                android:text="云控X期版本"
                android:layout_marginStart="@dimen/dp_320"/>
            <Button
                android:id="@+id/btn_time_zone"
                android:layout_width="@dimen/dp_80"
                android:layout_height="@dimen/dp_80"
                android:layout_marginTop="@dimen/dp_400"
                android:text="时区转换"
                android:layout_marginStart="@dimen/dp_320"/>
            <Button
                android:id="@+id/btn_clear"
                android:layout_width="@dimen/dp_80"
                android:layout_height="@dimen/dp_80"
                android:layout_marginTop="@dimen/dp_400"
                android:text="清除内容"
                android:layout_marginStart="@dimen/dp_220"/>
            <Button
                android:id="@+id/btn_ele_price"
                android:layout_width="@dimen/dp_80"
                android:layout_height="@dimen/dp_80"
                android:layout_marginTop="@dimen/dp_400"
                android:text="优惠电价"
                android:layout_marginStart="@dimen/dp_120"/>
            <Button
                android:id="@+id/btn_usecar_time"
                android:layout_width="@dimen/dp_80"
                android:layout_height="@dimen/dp_80"
                android:layout_marginTop="@dimen/dp_400"
                android:text="预约用车时间"
                android:layout_marginStart="@dimen/dp_20"/>
            <Button
                android:id="@+id/btn_usecar_on"
                android:layout_width="@dimen/dp_80"
                android:layout_height="@dimen/dp_80"
                android:layout_marginTop="@dimen/dp_500"
                android:text="预约用车开启"
                android:layout_marginStart="@dimen/dp_120"/>
            <Button
                android:id="@+id/btn_usecar_off"
                android:layout_width="@dimen/dp_80"
                android:layout_height="@dimen/dp_80"
                android:layout_marginTop="@dimen/dp_500"
                android:text="预约用车关闭"
                android:layout_marginStart="@dimen/dp_20"/>
            <Button
                android:id="@+id/btn_ele_price2"
                android:layout_width="@dimen/dp_80"
                android:layout_height="@dimen/dp_80"
                android:layout_marginTop="@dimen/dp_500"
                android:text="优惠电价2"
                android:layout_marginStart="@dimen/dp_220"/>
            <View
                android:background="@color/bg_color_line"
                android:layout_width="@dimen/dp_400"
                android:layout_height="@dimen/dp_1"
                android:layout_marginTop="@dimen/dp_590"
                android:layout_centerHorizontal="true"/>
            <Button
                android:id="@+id/btn_dm_charge_set"
                android:layout_width="@dimen/dp_80"
                android:layout_height="@dimen/dp_80"
                android:layout_marginTop="@dimen/dp_600"
                android:text="设置预约充电"
                android:layout_marginStart="@dimen/dp_20"/>
            <Button
                android:id="@+id/btn_dm_charge_setfull"
                android:layout_width="@dimen/dp_80"
                android:layout_height="@dimen/dp_80"
                android:layout_marginTop="@dimen/dp_600"
                android:text="设置预约充电（充满）"
                android:layout_marginStart="@dimen/dp_120"/>
            <Button
                android:id="@+id/btn_dm_charge_close"
                android:layout_width="@dimen/dp_80"
                android:layout_height="@dimen/dp_80"
                android:layout_marginTop="@dimen/dp_600"
                android:text="仅关闭预约充电"
                android:layout_marginStart="@dimen/dp_220"/>
            <Button
                android:id="@+id/btn_dm_charge_now"
                android:layout_width="@dimen/dp_80"
                android:layout_height="@dimen/dp_80"
                android:layout_marginTop="@dimen/dp_600"
                android:text="改为立即充电"
                android:layout_marginStart="@dimen/dp_320"/>
        </RelativeLayout>
    </ScrollView>
    <View
        android:background="@color/black"
        android:layout_width="@dimen/dp_1"
        android:layout_height="match_parent"/>
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="?attr/text_color_main"
                android:id="@+id/tv_power_msg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dp_10"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="?attr/text_color_main"
                android:id="@+id/tv_msg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dp_10"/>
            <ImageView
                android:id="@+id/iv_msg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dp_10"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
