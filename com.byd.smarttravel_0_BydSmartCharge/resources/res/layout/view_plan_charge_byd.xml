<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="layout/view_plan_charge_byd_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.byd.widget.BydSwitch
        android:id="@+id/sbg_charge"
        android:layout_marginTop="@dimen/dp_37"
        android:layout_marginRight="@dimen/dp_40"
        android:layout_alignParentRight="true"
        style="@style/bydswitch_style"/>
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="?attr/dialog_title"
        android:gravity="center_vertical"
        android:id="@+id/tv_fun_name"
        android:layout_width="wrap_content"
        android:layout_height="?attr/dp_switch_height"
        android:layout_marginTop="@dimen/dp_37"
        android:layout_marginRight="@dimen/dp_128"
        android:text="@string/plan_charge"
        android:layout_alignParentRight="true"/>
    <ImageView
        android:id="@+id/iv_bg"
        android:layout_width="@dimen/dp_780"
        android:layout_height="@dimen/dp_354"
        android:layout_marginTop="@dimen/dp_114"
        android:src="?attr/bg_charge_img"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="?attr/charge_text_white"
        android:gravity="center_vertical"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_195"
        android:text="@string/time_with_end"
        android:layout_centerHorizontal="true"
        android:drawableEnd="@drawable/icon_light_public_edit_48"
        android:drawableTint="?attr/charge_text_blue"/>
    <View
        android:gravity="center"
        android:id="@+id/tv_time_interval"
        android:background="?attr/charge_text_blue"
        android:layout_width="@dimen/dp_37"
        android:layout_height="@dimen/dp_5"
        android:layout_marginTop="@dimen/dp_300"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="@dimen/sp_60"
        android:textColor="?attr/charge_text_blue"
        android:gravity="center"
        android:id="@+id/tv_start_time"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_71"
        android:layout_marginTop="@dimen/dp_263"
        android:text=""
        android:layout_centerHorizontal="true"
        android:layout_marginEnd="@dimen/dp_30"
        android:layout_toStartOf="@+id/tv_time_interval"/>
    <TextView
        android:textSize="@dimen/sp_60"
        android:textColor="?attr/charge_text_blue"
        android:gravity="center"
        android:id="@+id/tv_end_time"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_71"
        android:layout_marginTop="@dimen/dp_263"
        android:text=""
        android:layout_centerHorizontal="true"
        android:layout_marginStart="@dimen/dp_30"
        android:layout_toEndOf="@+id/tv_time_interval"/>
    <TextView
        android:textSize="@dimen/sp_24"
        android:textColor="?attr/charge_text_blue"
        android:gravity="bottom"
        android:id="@+id/tv_end_time_tag"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_71"
        android:layout_marginTop="@dimen/dp_263"
        android:maxWidth="@dimen/dp_190"
        android:layout_centerHorizontal="true"
        android:layout_toEndOf="@+id/tv_end_time"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="?attr/charge_text_white"
        android:gravity="center"
        android:id="@+id/tv_week"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_352"
        android:layout_centerHorizontal="true"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_17"
        android:layout_below="@+id/iv_bg"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="?attr/text_color_gray"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/slow_charge_available_tips"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="?attr/price_time_blue"
            android:gravity="center"
            android:id="@+id/tv_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/learn_more"
            android:drawableEnd="@drawable/icon_light_public_rightarrow_s_24"
            android:drawableTint="?attr/text_color_blue"/>
    </LinearLayout>
</RelativeLayout>
