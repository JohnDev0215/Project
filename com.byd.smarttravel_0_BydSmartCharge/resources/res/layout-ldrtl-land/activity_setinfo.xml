<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="layout-ldrtl-land/activity_setinfo_0"
    android:paddingTop="@dimen/dp_56"
    android:paddingBottom="@dimen/dp_60"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/sp_20"
        android:textStyle="bold"
        android:textColor="?attr/text_color_main"
        android:gravity="center_vertical"
        android:id="@+id/tv_back"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_12"
        android:text="@string/settings"
        android:drawableStart="@drawable/icon_light_public_leftarrow_48"
        android:layout_marginStart="@dimen/dp_28"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_tips"
        android:background="@drawable/carlights_background"
        android:layout_width="@dimen/dp_700"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_2"
        android:layout_below="@+id/tv_back"
        android:layout_alignParentLeft="true">
        <RelativeLayout
            android:gravity="start|center_vertical"
            android:orientation="horizontal"
            android:id="@+id/view_acc_off"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_72"
            android:layout_margin="@dimen/dp_8">
            <com.byd.widget.BydSwitch
                android:id="@+id/switch_acc_off"
                android:layout_marginLeft="@dimen/dp_16"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                style="@style/bydswitch_style"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="?attr/text_color_main"
                android:gravity="right"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_16"
                android:layout_marginRight="@dimen/dp_16"
                android:text="@string/acc_off"
                android:layout_toRightOf="@+id/switch_acc_off"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_72"
            android:layout_margin="@dimen/dp_8">
            <com.byd.widget.BydSwitch
                android:id="@+id/switch_charge_gun"
                android:layout_marginLeft="@dimen/dp_16"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                style="@style/bydswitch_style"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="?attr/text_color_main"
                android:gravity="right"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_16"
                android:layout_marginRight="@dimen/dp_16"
                android:text="@string/connect_charge_gun"
                android:layout_toRightOf="@+id/switch_charge_gun"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/rl_statement"
        android:background="@drawable/carlights_background"
        android:layout_width="@dimen/dp_700"
        android:layout_height="@dimen/dp_88"
        android:layout_marginLeft="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_below="@+id/ll_tips"
        android:layout_alignParentLeft="true"
        android:paddingStart="@dimen/dp_24"
        android:paddingEnd="@dimen/dp_8">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="?attr/text_color_main"
            android:gravity="start|center_vertical"
            android:id="@+id/tv_statement"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_88"
            android:text="@string/statement"
            android:layout_alignParentStart="true"/>
        <ImageView
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:src="@drawable/icon_light_public_rightarrow_48"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toRightOf="@+id/rl_statement">
        <ImageView
            android:layout_width="@dimen/dp_120"
            android:layout_height="@dimen/dp_120"
            android:layout_marginTop="@dimen/dp_194"
            android:src="?attr/bg_plan_logo"/>
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="?attr/text_color_main"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_26"
            android:text="@string/app_name"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="?attr/text_color_gray"
            android:id="@+id/tv_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</RelativeLayout>
