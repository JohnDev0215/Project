<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.android.launcher3.home.banner.Banner
        android:id="@+id/banner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:layout_gravity="left"
        android:id="@+id/img_setting"
        android:layout_width="@dimen/setting_width"
        android:layout_height="@dimen/setting_height"
        android:layout_marginLeft="@dimen/setting_marginStart"
        android:layout_marginTop="@dimen/dp_416"
        android:scaleType="fitXY"/>
    <ImageView
        android:layout_gravity="left"
        android:id="@+id/img_map"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/setting_height"
        android:layout_marginLeft="@dimen/setting_marginStart"
        android:layout_marginTop="@dimen/dp_480"
        android:scaleType="fitXY"/>
</FrameLayout>
