<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rl_folder_apps"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:background="#ffffffff"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="50dp">
        <TextView
            android:textSize="18sp"
            android:gravity="center_horizontal"
            android:id="@+id/tv_folder_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/launcher_add_to_folder"/>
        <RelativeLayout
            android:id="@+id/ll_operation_menu"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="20dp"
            android:layout_alignParentBottom="true">
            <Space
                android:id="@+id/space"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:layout_centerHorizontal="true"/>
            <Button
                android:id="@+id/btn_confirm"
                android:layout_width="120dp"
                android:layout_height="match_parent"
                android:text="@string/launcher_add"
                android:layout_toStartOf="@+id/space"/>
            <Button
                android:id="@+id/btn_cancel"
                android:layout_width="120dp"
                android:layout_height="match_parent"
                android:text="@string/launcher_cancel"
                android:layout_toEndOf="@+id/space"/>
        </RelativeLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_folder_apps"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="20dp"
            android:layout_above="@+id/ll_operation_menu"
            android:layout_below="@+id/tv_folder_title"/>
    </RelativeLayout>
</RelativeLayout>
