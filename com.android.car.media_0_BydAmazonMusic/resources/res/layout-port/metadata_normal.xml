<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:id="@+id/album_art_card"
        android:layout_width="@dimen/playback_album_art_size"
        android:layout_height="@dimen/playback_album_art_size"
        android:layout_marginStart="@dimen/auto_dimen2_38"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="@dimen/auto_dimen2_16"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toTopOf="@+id/title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed">
        <ImageView
            android:id="@+id/album_art"
            android:background="@color/album_art_background"
            android:layout_width="@dimen/playback_album_art_size"
            android:layout_height="@dimen/playback_album_art_size"
            android:scaleType="centerCrop"
            android:contentDescription="@string/album_art"
            android:transitionName="@string/album_art"/>
    </androidx.cardview.widget.CardView>
    <TextView
        android:gravity="start"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/art_metadata_margin"
        android:textAlignment="textStart"
        android:layout_marginStart="@dimen/auto_dimen2_38"
        app:layout_constraintBottom_toTopOf="@+id/album_title_ll"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/album_art_card"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/MetadataPlaybackTitleStyle"/>
    <TextView
        android:gravity="start"
        android:id="@+id/artist"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/metadata_title_subtitle_margin"
        android:textAlignment="textStart"
        android:layout_marginStart="@dimen/auto_dimen2_38"
        app:layout_constraintBottom_toTopOf="@+id/album_title_ll"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"
        style="@style/MetadataPlaybackSubtitleStyle"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/album_title_ll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/car_ui_padding_7"
        android:layout_marginStart="@dimen/auto_dimen2_38"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/artist"
        app:layout_goneMarginTop="@dimen/car_ui_padding_7">
        <com.android.car.media.view.MarqueeText
            android:ellipsize="marquee"
            android:id="@+id/album_title"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="365dp"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:marqueeRepeatLimit="marquee_forever"
            style="@style/MetadataPlaybackSubtitleStyle"/>
        <include
            android:id="@+id/progress_text_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            layout="@layout/time_progress_text"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
