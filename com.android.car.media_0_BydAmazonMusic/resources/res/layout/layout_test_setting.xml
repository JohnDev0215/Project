<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/test_setting_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/bg_error_dialog"
        android:layout_width="@dimen/auto_dimen2_564"
        android:layout_height="@dimen/auto_dimen2_564"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.core.widget.NestedScrollView
            android:id="@+id/test_ns"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/auto_dimen2_28"
            android:layout_marginBottom="@dimen/auto_dimen2_10"
            android:layout_marginHorizontal="@dimen/auto_dimen2_28"
            app:layout_constraintBottom_toTopOf="@+id/test_setting_close"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <CheckBox
                    android:textColor="@color/test_setting_checked_box_color"
                    android:id="@+id/log_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <CheckBox
                    android:textColor="@color/test_setting_checked_box_color"
                    android:id="@+id/gear_box"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.core.widget.NestedScrollView>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/auto_dimen2_18"
            android:textColor="@color/dialog_confirm_seconds_color"
            android:gravity="center"
            android:id="@+id/test_setting_close"
            android:background="@drawable/bg_error_dialog_bottom"
            android:layout_width="@dimen/auto_dimen2_176"
            android:layout_height="@dimen/auto_dimen2_48"
            android:layout_marginBottom="@dimen/auto_dimen2_28"
            android:text="@string/dialog_confirm"
            android:maxLines="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
