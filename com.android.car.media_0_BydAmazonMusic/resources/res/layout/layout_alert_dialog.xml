<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/bg_error_dialog"
        android:layout_width="@dimen/auto_dimen2_560"
        android:layout_height="@dimen/byd_alert_dialog_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/auto_dimen2_27"
            android:textColor="@color/dialog_message_color"
            android:gravity="center"
            android:id="@+id/tv_dialog_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auto_dimen2_40"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/auto_dimen2_22"
            android:textColor="@color/dialog_message_color"
            android:gravity="center"
            android:id="@+id/tv_dialog_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auto_dimen2_20"
            android:layout_marginBottom="@dimen/auto_dimen2_20"
            android:text=""
            android:lineSpacingExtra="@dimen/auto_dimen2_3"
            android:layout_marginStart="@dimen/auto_dimen2_48"
            android:layout_marginEnd="@dimen/auto_dimen2_48"
            app:layout_constraintBottom_toTopOf="@+id/tv_dialog_confirm"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_dialog_title"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/auto_dimen2_18"
            android:textColor="@color/dialog_button_text_confirm_color"
            android:gravity="center"
            android:id="@+id/tv_dialog_confirm"
            android:background="@drawable/bg_dialog_button_confirm"
            android:layout_width="@dimen/auto_dimen2_176"
            android:layout_height="@dimen/auto_dimen2_48"
            android:layout_marginBottom="@dimen/auto_dimen2_28"
            android:maxLines="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tv_dialog_cancel"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/auto_dimen2_18"
            android:textColor="@color/dialog_button_text_cancel_color"
            android:gravity="center"
            android:id="@+id/tv_dialog_cancel"
            android:background="@drawable/bg_dialog_button_cancel"
            android:layout_width="@dimen/auto_dimen2_176"
            android:layout_height="@dimen/auto_dimen2_48"
            android:layout_marginBottom="@dimen/auto_dimen2_28"
            android:maxLines="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_dialog_confirm"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
