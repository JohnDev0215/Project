<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/bg_error_dialog_denza"
        android:layout_width="@dimen/auto_dimen2_560"
        android:layout_height="@dimen/auto_dimen2_300"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/auto_dimen2_20"
            android:textColor="@color/dialog_message_color"
            android:gravity="center"
            android:id="@+id/tv_dialog_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auto_dimen2_48"
            android:text="@string/dialog_traffic_notice_title"
            android:lineSpacingExtra="@dimen/auto_dimen2_3"
            android:layout_marginStart="@dimen/auto_dimen2_48"
            android:layout_marginEnd="@dimen/auto_dimen2_48"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/auto_dimen2_20"
            android:textColor="@color/dialog_message_color"
            android:gravity="center"
            android:id="@+id/tv_dialog_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auto_dimen2_48"
            android:text="@string/dialog_traffic_notice_content"
            android:lineSpacingExtra="@dimen/auto_dimen2_3"
            android:layout_marginStart="@dimen/auto_dimen2_48"
            android:layout_marginEnd="@dimen/auto_dimen2_48"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_dialog_title"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_dialog_bottom_enough"
            android:background="@drawable/bg_dialog_button_confirm_denza"
            android:layout_width="@dimen/auto_dimen2_176"
            android:layout_height="@dimen/auto_dimen2_48"
            android:layout_marginBottom="@dimen/auto_dimen2_28"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/cl_dialog_bottom_know"
            app:layout_constraintStart_toStartOf="parent">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/auto_dimen2_18"
                android:textColor="@color/dialog_button_text_confirm_color"
                android:gravity="center"
                android:id="@+id/tv_dialog_confirm_enough"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dialog_traffic_notice_enough"
                android:maxLines="1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_dialog_bottom_know"
            android:background="@drawable/bg_dialog_button_cancel_denza"
            android:layout_width="@dimen/auto_dimen2_176"
            android:layout_height="@dimen/auto_dimen2_48"
            android:layout_marginBottom="@dimen/auto_dimen2_28"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/cl_dialog_bottom_enough">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/auto_dimen2_18"
                android:textColor="@color/dialog_button_text_cancel_color"
                android:gravity="center"
                android:id="@+id/tv_dialog_confirm_know"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <CheckBox
            android:textSize="@dimen/auto_dimen2_20"
            android:textColor="@color/dialog_message_color"
            android:id="@+id/checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/auto_dimen2_10"
            android:text="@string/dialog_traffic_notice_not_remind"
            app:layout_constraintBottom_toTopOf="@+id/cl_dialog_bottom_enough"
            app:layout_constraintLeft_toLeftOf="@+id/cl_dialog_bottom_enough"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
