<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/img_app_bg"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_back"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_10"
        android:src="@drawable/icon_public_leftarrow_48"
        android:layout_marginStart="@dimen/dp_28"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:id="@+id/et_search_ly"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_48"
        android:layout_marginStart="@dimen/dp_100"
        android:layout_marginEnd="@dimen/dp_40"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_back">
        <com.byd.filemanager.ui.view.AppEditText
            android:textSize="@dimen/sp_18"
            android:textColor="@color/text_main"
            android:textColorHint="@color/text_tip"
            android:gravity="start|center_vertical"
            android:id="@+id/et_search"
            android:background="@drawable/selector_search_edit"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="@string/search"
            android:lines="@integer/one"
            android:maxLength="255"
            android:inputType="textCapWords"
            android:imeOptions="actionSearch"
            android:textCursorDrawable="@drawable/edit_cursor"
            android:textAlignment="viewStart"
            android:layoutDirection="locale"
            android:paddingStart="@dimen/dp_58"
            android:paddingEnd="@dimen/dp_58"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/iv_search"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        android:src="@drawable/icon_public_search_48"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/dp_8"
        app:layout_constraintStart_toStartOf="@+id/et_search_ly"
        app:layout_constraintTop_toTopOf="@+id/et_search_ly"
        app:tint="@color/color_tint_selector"/>
    <ImageView
        android:id="@+id/iv_delete"
        android:visibility="invisible"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        android:src="@drawable/icon_public_clear_48"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/dp_8"
        android:layout_alignParentEnd="true"
        app:layout_constraintEnd_toEndOf="@+id/et_search_ly"
        app:layout_constraintTop_toTopOf="@+id/et_search_ly"/>
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_back"
        app:layout_constraintVertical_weight="1"/>
</androidx.constraintlayout.widget.ConstraintLayout>
