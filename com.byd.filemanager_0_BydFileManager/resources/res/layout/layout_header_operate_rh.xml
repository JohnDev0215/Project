<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/ly_operate"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_60">
    <com.byd.filemanager.ui.view.TextImageView
        android:id="@+id/tv_cancel"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_40"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/dp_28"
        app:image_height="@dimen/dp_40"
        app:image_width="@dimen/dp_40"
        app:src="@drawable/icon_public_close_s_40"
        app:text="@string/cancel"
        app:textColor="@color/color_text_selector"
        app:textSize="@dimen/sp_18"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="@color/selected_count_text_color"
        android:id="@+id/tv_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/file_counts"
        android:layout_marginStart="@dimen/dp_17"/>
    <HorizontalScrollView
        android:scrollbars="none"
        android:fadingEdgeLength="@dimen/dp_48"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:layout_alignTop="@+id/tv_count"
        android:overScrollMode="never"
        android:requiresFadingEdge="horizontal"
        android:layout_marginStart="@dimen/dp_32">
        <LinearLayout
            android:gravity="end|center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatCheckBox
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@+id/cb_select_all"
                android:background="@drawable/selector_checkbox"
                android:layout_width="@dimen/dp_40"
                android:layout_height="@dimen/dp_40"
                android:button="@null"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/text_main"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_select"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/all"
                android:layout_marginEnd="@dimen/dp_32"/>
            <com.byd.filemanager.ui.view.TextImageView
                android:id="@+id/tv_copy"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_40"
                android:minWidth="@dimen/dp_84"
                android:layout_marginEnd="@dimen/dp_32"
                app:image_height="@dimen/dp_40"
                app:image_width="@dimen/dp_40"
                app:src="@drawable/icon_public_copy_40"
                app:text="@string/copy"
                app:textColor="@color/color_text_selector"
                app:textSize="@dimen/sp_18"/>
            <com.byd.filemanager.ui.view.TextImageView
                android:id="@+id/tv_delete"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_40"
                android:minWidth="@dimen/dp_84"
                android:layout_marginEnd="@dimen/dp_32"
                app:image_height="@dimen/dp_40"
                app:image_width="@dimen/dp_40"
                app:src="@drawable/icon_public_delete_s_40"
                app:text="@string/delete"
                app:textColor="@color/color_text_selector"
                app:textSize="@dimen/sp_18"/>
            <com.byd.filemanager.ui.view.TextImageView
                android:id="@+id/tv_more"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_40"
                android:layout_marginEnd="@dimen/dp_32"
                app:image_height="@dimen/dp_40"
                app:image_width="@dimen/dp_40"
                app:src="@drawable/icon_public_more_40"
                app:text="@string/more"
                app:textColor="@color/color_text_selector"
                app:textSize="@dimen/sp_18"/>
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
