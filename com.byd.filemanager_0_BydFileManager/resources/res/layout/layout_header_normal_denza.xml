<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ly_normal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_tab"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_44"
        android:layout_marginTop="@dimen/dp_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_list"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        android:src="@drawable/icon_public_list_48"
        android:layout_marginEnd="@dimen/dp_32"
        app:layout_constraintEnd_toStartOf="@+id/iv_search"
        app:layout_constraintTop_toTopOf="@+id/iv_search"/>
    <ImageView
        android:id="@+id/iv_search"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_14"
        android:src="@drawable/icon_public_search_48"
        android:layout_marginEnd="@dimen/dp_32"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_sort"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_8"
        android:src="@drawable/icon_file_sort_48"
        android:layout_marginEnd="@dimen/dp_32"
        app:layout_constraintStart_toStartOf="@+id/iv_search"
        app:layout_constraintTop_toBottomOf="@+id/iv_search"/>
    <ImageView
        android:id="@+id/iv_folder"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        android:src="@drawable/icon_file_folder_48"
        android:layout_marginEnd="@dimen/dp_32"
        app:layout_constraintEnd_toStartOf="@+id/iv_sort"
        app:layout_constraintTop_toTopOf="@+id/iv_sort"/>
    <com.byd.filemanager.ui.view.CapacityView
        android:id="@+id/scaleView"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_48"
        android:minWidth="@dimen/dp_126"
        android:layout_marginEnd="@dimen/dp_36"
        app:color_background="@color/solid_sizeView_denza"
        app:color_gradient_end="@color/tab_indicator_header_color_denza"
        app:color_gradient_start="@color/tab_indicator_header_color_denza"
        app:color_used="@color/tab_indicator_header_color_denza"
        app:layout_constraintEnd_toStartOf="@+id/iv_folder"
        app:layout_constraintTop_toTopOf="@+id/iv_sort"
        app:text="@string/default_capacity"
        app:textColor="@color/text_main_denza"
        app:textSize="@dimen/sp_18"/>
</androidx.constraintlayout.widget.ConstraintLayout>
