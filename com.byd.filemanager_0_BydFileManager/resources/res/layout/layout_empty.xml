<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ly_empty"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_icon_empty"
        android:layout_width="@dimen/dp_312"
        android:layout_height="@dimen/dp_208"
        android:layout_marginTop="@dimen/dp_233"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/text_tip"
        android:id="@+id/tv_desc_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/no_content"
        android:layout_below="@+id/iv_icon_empty"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
