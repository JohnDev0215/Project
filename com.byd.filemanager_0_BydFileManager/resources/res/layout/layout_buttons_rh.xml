<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <View
        android:id="@+id/guideline"
        android:layout_width="@dimen/dp_48"
        android:layout_height="match_parent"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="@color/text_button"
        android:gravity="center"
        android:id="@+id/btn_cancel"
        android:background="@drawable/bg_button_normal"
        android:layout_width="@dimen/dp_176"
        android:layout_height="@dimen/dp_48"
        android:text="@string/cancel"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@+id/guideline"
        android:elevation="@dimen/dp_1"
        android:stateListAnimator="@animator/pressed_state_list"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="@color/text_button_highlight"
        android:gravity="center"
        android:id="@+id/btn_ok"
        android:background="@drawable/bg_button_default_selector"
        android:layout_width="@dimen/dp_176"
        android:layout_height="@dimen/dp_48"
        android:text="@string/ok"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@+id/guideline"
        android:elevation="@dimen/dp_1"
        android:stateListAnimator="@animator/pressed_state_list"/>
</merge>
