<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_footer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline"
        android:layout_width="@dimen/dp_1"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="@color/text_button_paste_confirm_color_denza"
        android:gravity="center"
        android:id="@+id/btn_paste"
        android:background="@drawable/bg_button_paste_selector_denza"
        android:visibility="gone"
        android:layout_width="@dimen/dp_160"
        android:layout_height="@dimen/dp_48"
        android:text="@string/paste"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/dp_49"
        android:layout_toStartOf="@+id/guideline"
        android:elevation="@dimen/dp_1"
        android:stateListAnimator="@animator/pressed_state_list"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="@color/text_button_paste_cancel_color_denza"
        android:gravity="center"
        android:id="@+id/btn_paste_cancel"
        android:background="@drawable/bg_button_paste_cancel_denza"
        android:visibility="gone"
        android:layout_width="@dimen/dp_160"
        android:layout_height="@dimen/dp_48"
        android:text="@string/cancel"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/dp_49"
        android:layout_toEndOf="@+id/guideline"
        android:elevation="@dimen/dp_1"
        android:stateListAnimator="@animator/pressed_state_list"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/guideline"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
