<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/compact_detail_template_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/compact_detail_template_header_image"
        android:layout_width="@dimen/compact_detail_template_header_image_dimension"
        android:layout_height="@dimen/compact_detail_template_header_image_dimension"
        android:layout_marginBottom="@dimen/podcast_spacer_large"
        android:layout_alignParentStart="true"/>
    <RelativeLayout
        android:id="@+id/compact_detail_template_metadata_and_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignBottom="@+id/compact_detail_template_header_image"
        android:layout_marginStart="@dimen/podcast_spacer_giant"
        android:layout_toEndOf="@+id/compact_detail_template_header_image">
        <com.amazon.podcast.views.EmberTextView
            android:gravity="start"
            android:id="@+id/compact_detail_template_header_primary_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="3"
            android:layout_centerHorizontal="true"
            style="@style/PodcastAppTheme.TextView.Headline3"/>
        <RelativeLayout
            android:id="@+id/podcast_compact_detail_template_header_secondary_text_touch_target"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/podcast_spacer_micro"
            android:minWidth="@dimen/podcast_compact_detail_template_header_secondary_text_touch_target_dimension"
            android:layout_below="@+id/compact_detail_template_header_primary_text">
            <com.amazon.podcast.views.EmberTextView
                android:id="@+id/compact_detail_template_header_secondary_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_centerInParent="true"
                style="@style/PodcastAppTheme.TextView.Primary"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/podcast_compact_detail_template_header_tertiary_text_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/podcast_spacer_mini"
            android:layout_below="@+id/podcast_compact_detail_template_header_secondary_text_touch_target">
            <com.amazon.podcast.views.EmberTextView
                android:id="@+id/compact_detail_template_header_tertiary_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textAllCaps="true"
                style="@style/PodcastAppTheme.TextView.Tertiary"/>
            <com.amazon.podcast.views.EmberTextView
                android:id="@+id/compact_detail_template_header_tertiary_following_text"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textAllCaps="true"
                android:layout_toEndOf="@+id/compact_detail_template_header_tertiary_text"
                style="@style/PodcastAppTheme.TextView.Tertiary"/>
        </RelativeLayout>
        <androidx.appcompat.widget.AppCompatButton
            android:textSize="@dimen/podcast_text_size_t4"
            android:textColor="@color/secondary"
            android:gravity="center"
            android:id="@+id/podcast_compact_detail_template_header_badge"
            android:background="@drawable/redhood_plus_regular_badge_background"
            android:paddingLeft="@dimen/podcast_spacer_micro"
            android:paddingTop="@dimen/podcast_spacer_nano"
            android:paddingRight="@dimen/podcast_spacer_micro"
            android:paddingBottom="@dimen/podcast_spacer_nano"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/podcast_spacer_small"
            android:maxLines="2"
            android:layout_below="@+id/podcast_compact_detail_template_header_tertiary_text_group"
            android:textAllCaps="true"
            android:paddingHorizontal="@dimen/podcast_spacer_micro"
            android:paddingVertical="@dimen/podcast_spacer_nano"/>
        <RelativeLayout
            android:id="@+id/header_buttons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/podcast_spacer_medium"
            android:layout_below="@+id/podcast_compact_detail_template_header_badge">
            <ImageButton
                android:id="@+id/compact_detail_template_header_view_play_button"
                android:background="@drawable/button_solid_background"
                android:visibility="gone"
                android:layout_width="@dimen/podcast_spacer_epic"
                android:layout_height="@dimen/podcast_spacer_epic"
                android:adjustViewBounds="true"
                android:tint="@color/secondary"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/podcast_spacer_nano"
                android:layout_marginEnd="@dimen/podcast_spacer_small"
                android:layout_alignParentStart="true"/>
            <ProgressBar
                android:id="@+id/compact_detail_template_header_view_progress_bar"
                android:visibility="gone"
                android:layout_width="@dimen/podcast_compact_detail_template_header_circular_progress_bar_dimension"
                android:layout_height="@dimen/podcast_compact_detail_template_header_circular_progress_bar_dimension"
                android:indeterminate="false"
                android:progressDrawable="@drawable/circular_progressbar_view"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                style="?android:attr/progressBarStyleHorizontal"/>
            <ProgressBar
                android:id="@+id/compact_detail_template_header_view_inner_progress_bar"
                android:visibility="gone"
                android:layout_width="@dimen/podcast_compact_detail_template_header_circular_progress_bar_dimension"
                android:layout_height="@dimen/podcast_compact_detail_template_header_circular_progress_bar_dimension"
                android:indeterminate="false"
                android:progressDrawable="@drawable/circular_inner_progressbar_view"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                style="?android:attr/progressBarStyleHorizontal"/>
            <com.amazon.podcast.views.DownloadButtonMedium
                android:id="@+id/compact_detail_template_header_view_download_button"
                android:background="@color/transparent"
                android:visibility="gone"
                android:layout_width="@dimen/podcast_spacer_epic"
                android:layout_height="@dimen/podcast_spacer_epic"
                android:adjustViewBounds="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/podcast_spacer_micro"
                android:layout_marginEnd="@dimen/podcast_spacer_micro"
                android:layout_toEndOf="@+id/compact_detail_template_header_view_play_button"/>
            <ImageButton
                android:id="@+id/podcast_share_button"
                android:background="@color/transparent"
                android:visibility="gone"
                android:layout_width="@dimen/podcast_spacer_epic"
                android:layout_height="@dimen/podcast_spacer_epic"
                android:layout_marginTop="@dimen/podcast_spacer_nano"
                android:src="@drawable/ic_share"
                android:adjustViewBounds="true"
                android:layout_marginEnd="@dimen/podcast_spacer_micro"
                android:layout_toEndOf="@+id/compact_detail_template_header_view_download_button"/>
            <ImageButton
                android:id="@+id/podcast_compact_detail_template_header_view_save_button"
                android:background="@color/transparent"
                android:visibility="gone"
                android:layout_width="@dimen/podcast_spacer_epic"
                android:layout_height="@dimen/podcast_spacer_epic"
                android:src="@drawable/ic_action_add"
                android:adjustViewBounds="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/podcast_spacer_micro"
                android:layout_toEndOf="@+id/podcast_share_button"/>
            <ImageButton
                android:id="@+id/podcast_compact_detail_template_header_view_overflow_button"
                android:background="@color/transparent"
                android:visibility="gone"
                android:layout_width="@dimen/podcast_spacer_epic"
                android:layout_height="@dimen/podcast_spacer_epic"
                android:layout_marginTop="@dimen/podcast_spacer_nano"
                android:src="@drawable/podcast_ic_action_overflow_horizontal"
                android:adjustViewBounds="true"
                android:layout_toEndOf="@+id/podcast_compact_detail_template_header_view_save_button"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/podcast_compact_detail_template_header_upsell_text_no_button_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/header_buttons">
            <com.amazon.podcast.views.EmberTextView
                android:id="@+id/podcast_compact_detail_template_header_upsell_text_no_button_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/podcast_spacer_medium"
                style="@style/PodcastAppTheme.TextView.UpsellText"/>
        </RelativeLayout>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/compact_detail_template_header_image"
        android:layout_alignStart="@+id/compact_detail_template_header_image"
        android:layout_alignEnd="@+id/compact_detail_template_header_image">
        <com.amazon.podcast.views.EmberTextView
            android:id="@+id/podcast_compact_detail_template_header_upsell_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/podcast_spacer_mini"
            android:layout_centerHorizontal="true"
            style="@style/PodcastAppTheme.TextView.UpsellText"/>
        <com.amazon.podcast.views.LargeUpsellButton
            android:id="@+id/podcast_compact_detail_template_header_upsell_button"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/podcast_spacer_medium"
            android:layout_below="@+id/podcast_compact_detail_template_header_upsell_text"/>
    </RelativeLayout>
</RelativeLayout>
