<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:gravity="center"
            android:id="@+id/tooltip_text"
            android:background="@drawable/tooltip_top"
            android:padding="@dimen/podcast_spacer_small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/podcast_spacer_base"
            android:maxWidth="@dimen/tool_tip_max_width"
            android:layout_marginEnd="@dimen/podcast_spacer_mini"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/PodcastAppTheme.TextView.Primary"/>
        <ImageView
            android:gravity="center"
            android:id="@+id/exit_view"
            android:background="@drawable/onboarding_tooltip_close_button"
            android:padding="@dimen/podcast_spacer_micro"
            android:visibility="visible"
            android:layout_width="@dimen/podcast_spacer_large"
            android:layout_height="@dimen/podcast_spacer_large"
            android:layout_marginTop="@dimen/podcast_spacer_mini"
            android:src="@drawable/ic_podcast_action_cancel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/PodcastAppTheme.TextView.Primary"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/arrow"
        android:background="@drawable/onboarding_arrow_top"
        android:layout_width="@dimen/tool_tip_arrow_width"
        android:layout_height="@dimen/tool_tip_arrow_height"
        android:layout_marginTop="@dimen/tool_tip_overlap_margin"
        android:scaleType="center"/>
</LinearLayout>
