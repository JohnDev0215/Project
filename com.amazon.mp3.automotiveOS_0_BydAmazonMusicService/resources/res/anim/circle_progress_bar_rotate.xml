<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android">
    <rotate
        android:interpolator="@android:anim/linear_interpolator"
        android:duration="@integer/semi_circle_progress_bar_rotate_duration"
        android:fromDegrees="@integer/semi_circle_progress_bar_from_degree"
        android:toDegrees="@integer/semi_circle_progress_bar_to_degree"
