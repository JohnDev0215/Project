<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="bottom"
    android:orientation="vertical"
    android:background="@drawable/listview_item_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/listview_row_height">
        <ImageView
            android:id="@+id/Gripper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/gripper"
            android:scaleType="centerInside"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/library_edit_playlist_row_gripper_left_margin"/>
        <ImageView
            android:id="@+id/AlbumArtwork"
            android:layout_width="@dimen/default_listview_art_size"
            android:layout_height="@dimen/default_listview_art_size"
            android:layout_marginTop="@dimen/listview_vertical_padding"
            android:layout_marginBottom="@dimen/listview_vertical_padding"
            android:src="@drawable/placeholder_sm"
            android:scaleType="center"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/library_edit_playlist_row_picture_sides_margin"
            android:layout_marginEnd="@dimen/library_edit_playlist_row_picture_sides_margin"
            android:layout_toEndOf="@+id/Gripper"/>
        <ImageView
            android:id="@+id/DeleteIcon"
            android:padding="@dimen/library_edit_playlist_row_delete_padding"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/library_edit_playlist_drag_gripper_size"
            android:src="@drawable/playlist_btn_clear"
            android:scaleType="center"
            android:minWidth="@dimen/minimum_button_width"
            android:layout_centerVertical="true"
            android:contentDescription="@string/dmusic_playlist_remove_from_playlist"
            android:layout_alignParentEnd="true"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/listview_row_padding_left_of_text"
            android:layout_toStartOf="@+id/DeleteIcon"
            android:layout_toEndOf="@+id/AlbumArtwork">
            <TextView
                android:id="@+id/TrackTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:drawablePadding="@dimen/large_padding"
                android:paddingEnd="@dimen/tablet_padding"
                style="@style/LibraryListItemPrimaryText"/>
            <TextView
                android:id="@+id/ArtistName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                style="@style/LibraryListItemSecondaryText"/>
        </LinearLayout>
        <View
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/library_detail_padding"
            android:layout_marginEnd="@dimen/divider_right_padding"
            style="@style/HorizontalSeparator"/>
    </RelativeLayout>
</LinearLayout>
