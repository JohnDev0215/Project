<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/MiniPlayerExtraControl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8dp"
            android:layout_marginBottom="@dimen/spacing_8dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/spacing_8dp"
            android:layout_alignParentEnd="true"
            android:layout_marginVertical="@dimen/spacing_8dp">
            <ImageButton
                android:id="@+id/MiniPlayerQueueButton"
                android:background="@color/transparent"
                android:padding="@dimen/spacing_12dp"
                android:visibility="gone"
                android:layout_width="@dimen/icon_standard_size"
                android:layout_height="@dimen/icon_standard_size"
                android:src="@drawable/ic_playback_playqueue"
                android:layout_marginEnd="@dimen/spacing_4dp"/>
            <ImageButton
                android:id="@+id/MiniPlayerCastingButton"
                android:background="@color/transparent"
                android:padding="@dimen/spacing_12dp"
                android:visibility="gone"
                android:layout_width="@dimen/icon_standard_size"
                android:layout_height="@dimen/icon_standard_size"
                android:src="@drawable/ic_casting_inactive"
                android:layout_marginStart="@dimen/spacing_4dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/MiniPlayerControl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8dp"
            android:layout_marginBottom="@dimen/spacing_8dp"
            android:layout_centerInParent="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/icon_standard_size"
            android:layout_marginVertical="@dimen/spacing_8dp">
            <ImageButton
                android:id="@+id/MiniPlayerThumbsDownButton"
                android:background="@color/transparent"
                android:padding="@dimen/spacing_12dp"
                android:visibility="gone"
                android:layout_width="@dimen/icon_standard_size"
                android:layout_height="@dimen/icon_standard_size"
                android:src="@drawable/ic_action_dislike"
                android:layout_marginEnd="@dimen/spacing_4dp"/>
            <ImageButton
                android:id="@+id/MiniPlayerRepeatButton"
                android:background="@color/transparent"
                android:padding="@dimen/spacing_12dp"
                android:visibility="gone"
                android:layout_width="@dimen/icon_standard_size"
                android:layout_height="@dimen/icon_standard_size"
                android:src="@drawable/ic_playback_repeat"
                android:layout_marginEnd="@dimen/spacing_4dp"/>
            <ImageButton
                android:id="@+id/MiniPlayerPrevButton"
                android:background="@color/transparent"
                android:padding="@dimen/spacing_12dp"
                android:visibility="gone"
                android:layout_width="@dimen/icon_standard_size"
                android:layout_height="@dimen/icon_standard_size"
                android:layout_marginLeft="@dimen/spacing_4dp"
                android:layout_marginRight="@dimen/spacing_4dp"
                android:src="@drawable/mini_player_btn_previous_tray"
                android:layout_marginHorizontal="@dimen/spacing_4dp"/>
            <ImageButton
                android:id="@+id/MiniPlayerPlayButton"
                android:background="@color/transparent"
                android:padding="@dimen/spacing_12dp"
                android:visibility="gone"
                android:layout_width="@dimen/icon_standard_size"
                android:layout_height="@dimen/icon_standard_size"
                android:layout_marginLeft="@dimen/spacing_4dp"
                android:layout_marginRight="@dimen/spacing_4dp"
                android:src="@drawable/mini_player_btn_pause_tray"
                android:layout_marginHorizontal="@dimen/spacing_4dp"/>
            <com.amazon.ui.foundations.views.BaseButton
                android:id="@+id/MiniPlayerNextButton"
                android:background="@color/transparent"
                android:padding="@dimen/spacing_12dp"
                android:visibility="gone"
                android:layout_width="@dimen/icon_standard_size"
                android:layout_height="@dimen/icon_standard_size"
                android:layout_marginLeft="@dimen/spacing_4dp"
                android:layout_marginRight="@dimen/spacing_4dp"
                android:src="@drawable/mini_player_btn_next_tray"
                android:layout_marginHorizontal="@dimen/spacing_4dp"/>
            <ImageButton
                android:id="@+id/MiniPlayerShuffleButton"
                android:background="@color/transparent"
                android:padding="@dimen/spacing_12dp"
                android:visibility="gone"
                android:layout_width="@dimen/icon_standard_size"
                android:layout_height="@dimen/icon_standard_size"
                android:src="@drawable/ic_playback_shuffle"
                android:layout_marginStart="@dimen/spacing_4dp"/>
            <ImageButton
                android:id="@+id/MiniPlayerThumbsUpButton"
                android:background="@color/transparent"
                android:padding="@dimen/spacing_12dp"
                android:visibility="gone"
                android:layout_width="@dimen/icon_standard_size"
                android:layout_height="@dimen/icon_standard_size"
                android:src="@drawable/ic_action_like"
                android:layout_marginStart="@dimen/spacing_4dp"/>
        </LinearLayout>
        <com.amazon.mp3.view.TooltipView
            android:layout_gravity="end"
            android:id="@+id/TooltipDisplayerContainer"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacer_2"/>
        <RelativeLayout
            android:id="@+id/MiniPlayerContentView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8dp"
            android:layout_marginBottom="@dimen/spacing_8dp"
            android:layout_centerVertical="true"
            android:paddingEnd="@dimen/icon_standard_size"
            android:layout_marginStart="@dimen/spacing_16dp"
            android:layout_toStartOf="@+id/MiniPlayerControl"
            android:layout_alignParentStart="true"
            android:layout_marginVertical="@dimen/spacing_8dp">
            <ImageButton
                android:id="@+id/MiniPlayerContextMenuButton"
                android:background="@color/transparent"
                android:padding="@dimen/spacing_12dp"
                android:visibility="gone"
                android:layout_width="@dimen/icon_standard_size"
                android:layout_height="@dimen/icon_standard_size"
                android:src="@drawable/mini_player_btn_overflow_tray"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/spacing_4dp"
                android:layout_alignParentEnd="true"/>
            <ImageButton
                android:id="@+id/MiniPlayerAddToLibraryButton"
                android:background="@color/transparent"
                android:padding="@dimen/spacing_12dp"
                android:visibility="gone"
                android:layout_width="@dimen/icon_standard_size"
                android:layout_height="@dimen/icon_standard_size"
                android:src="@drawable/ic_action_add"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/spacing_4dp"
                android:layout_toStartOf="@+id/MiniPlayerContextMenuButton"/>
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/spacing_8dp"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/MiniPlayerAddToLibraryButton"
                android:layout_alignParentStart="true">
                <com.amazon.mp3.view.MiniPlayerContentView
                    android:id="@+id/MiniPlayerContentCurrent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <com.amazon.mp3.view.MiniPlayerContentView
                    android:id="@+id/MiniPlayerContentPrev"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <com.amazon.mp3.view.MiniPlayerContentView
                    android:id="@+id/MiniPlayerContentNext"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </FrameLayout>
        </RelativeLayout>
    </RelativeLayout>
</FrameLayout>
