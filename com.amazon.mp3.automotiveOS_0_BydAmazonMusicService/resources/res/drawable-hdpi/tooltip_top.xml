<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/onboarding_background"/>
            <corners
                android:topLeftRadius="@dimen/podcast_spacer_micro"
                android:topRightRadius="@dimen/podcast_spacer_micro"/>
        </shape>
    </item>
    <item
        android:left="@dimen/tool_tip_side_margin"
        android:top="@dimen/tool_tip_side_margin"
        android:right="@dimen/tool_tip_side_margin">
        <shape android:shape="rectangle">
            <stroke
                android:width="2dp"
                android:color="@color/onboarding_outline"/>
            <solid android:color="#00000000"/>
            <corners
                android:topLeftRadius="@dimen/podcast_spacer_micro"
                android:topRightRadius="@dimen/podcast_spacer_micro"/>
        </shape>
    </item>
</layer-list>
