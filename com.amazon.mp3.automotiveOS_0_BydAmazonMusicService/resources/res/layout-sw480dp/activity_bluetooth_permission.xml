<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bt_permission_container"
    android:background="@drawable/background_gradient"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/spacer_20"
    android:paddingEnd="@dimen/spacer_20">
    <com.amazon.ui.foundations.views.BaseButton
        android:id="@+id/bt_permission_close_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacer_32"
        android:layout_marginEnd="@dimen/spacer_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/bt_permission_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacer_32"
        android:layout_marginBottom="@dimen/spacer_32"
        android:adjustViewBounds="true"
        android:layout_marginVertical="@dimen/spacer_32"
        app:layout_constraintBottom_toTopOf="@+id/bt_permission_icon_car"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/ic_amazon_music_logo"/>
    <ImageView
        android:id="@+id/bt_permission_icon_bluetooth"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_bluetooth_white"
        android:layout_marginEnd="@dimen/spacer_28"
        app:layout_constraintEnd_toStartOf="@+id/bt_permission_icon_car"
        app:layout_constraintTop_toTopOf="@+id/bt_permission_icon_car"/>
    <ImageView
        android:id="@+id/bt_permission_icon_car"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacer_32"
        android:layout_marginBottom="@dimen/spacer_32"
        android:src="@drawable/ic_car_white"
        android:layout_marginVertical="@dimen/spacer_32"
        app:layout_constraintBottom_toTopOf="@+id/bt_permission_text"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <ImageView
        android:id="@+id/bt_permission_icon_headset"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_headset_white"
        android:layout_marginStart="@dimen/spacer_28"
        app:layout_constraintStart_toEndOf="@+id/bt_permission_icon_car"
        app:layout_constraintTop_toTopOf="@+id/bt_permission_icon_car"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/content_guideline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.4"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/bt_permission_text"
        android:layout_width="@dimen/alexa_onboarding_tablet_content_width"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/content_guideline"/>
    <com.amazon.ui.foundations.views.BaseButton
        android:id="@+id/bt_permission_positive_button"
        android:layout_width="@dimen/bt_permission_coachmark_button_width"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacer_24"
        app:layout_constraintBottom_toTopOf="@+id/bt_permission_negative_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.amazon.ui.foundations.views.BaseButton
        android:id="@+id/bt_permission_negative_button"
        android:layout_width="@dimen/bt_permission_coachmark_button_width"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/buttons_guideline"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/buttons_guideline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.8"/>
</androidx.constraintlayout.widget.ConstraintLayout>
