<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/background_gradient"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/spacer_20"
    android:paddingEnd="@dimen/spacer_20">
    <ImageView
        android:id="@+id/alexa_onboarding_image"
        android:layout_width="@dimen/alexa_onboarding_ongoing_image_size"
        android:layout_height="@dimen/alexa_onboarding_ongoing_image_size"
        android:layout_marginTop="@dimen/spacer_32"
        app:layout_constraintBottom_toTopOf="@+id/alexa_permission_message_scroll_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/alexa_explain_permission_title"
        app:srcCompat="@drawable/ic_alexa_onboarding_ongoing"/>
    <TextView
        android:gravity="center"
        android:id="@+id/alexa_explain_permission_title"
        android:layout_width="@dimen/alexa_onboarding_tablet_content_width"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacer_36"
        app:layout_constraintBottom_toTopOf="@+id/alexa_onboarding_image"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/alexa_permission_message_scroll_view"
        android:layout_width="@dimen/alexa_onboarding_tablet_content_width"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacer_32"
        android:layout_marginBottom="@dimen/spacer_36"
        app:layout_constraintBottom_toTopOf="@+id/alexa_explain_permission_positive_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/alexa_onboarding_image"
        style="@style/AlexaTouScrollView">
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="@dimen/alexa_onboarding_tablet_content_width"
            android:layout_height="wrap_content">
            <TextView
                android:gravity="center"
                android:id="@+id/alexa_explain_permission_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/alexa_explain_permission_message"/>
            <TextView
                android:gravity="center"
                android:id="@+id/alexa_explain_permission_settings_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/alexa_explain_permission_settings_message"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.amazon.mp3.voice.onboarding.view.OnboardingNegativeButton
        android:id="@+id/alexa_explain_permission_negative_button"
        android:layout_width="@dimen/alexa_onboarding_tablet_content_width"
        android:layout_height="@dimen/spacer_36"
        android:layout_marginBottom="@dimen/spacer_36"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/alexa_explain_permission_positive_button"/>
    <com.amazon.mp3.voice.onboarding.view.OnboardingPositiveButton
        android:id="@+id/alexa_explain_permission_positive_button"
        android:layout_width="@dimen/alexa_onboarding_tablet_content_width"
        android:layout_height="@dimen/spacer_36"
        android:layout_marginTop="@dimen/spacer_36"
        app:layout_constraintBottom_toTopOf="@+id/alexa_explain_permission_negative_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/alexa_permission_message_scroll_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
