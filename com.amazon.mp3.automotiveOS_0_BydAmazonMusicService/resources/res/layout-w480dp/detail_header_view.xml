<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="start|bottom"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacer_huge">
    <ImageView
        android:id="@+id/playlist_image"
        android:layout_marginEnd="@dimen/spacer_huge"
        style="@style/DetailPageThumbnail"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/detail_header_text_and_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:gravity="center"
            android:id="@+id/label_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            style="@style/LabelText"/>
        <TextView
            android:gravity="center"
            android:id="@+id/headline_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacer_micro"
            android:maxLines="2"
            android:textAlignment="center"
            style="@style/Headline2Text"/>
        <TextView
            android:gravity="center"
            android:id="@+id/primary_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacer_mini"
            android:textAlignment="center"
            style="@style/PrimaryText"/>
        <TextView
            android:gravity="center"
            android:id="@+id/secondary_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacer_mini"
            android:textAlignment="center"
            style="@style/SecondaryText"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tertiary_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacer_mini"
            android:textAlignment="center"
            style="@style/SecondaryText"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacer_large">
            <ImageView
                android:id="@+id/play_button"
                android:src="@drawable/ic_playback_play"
                android:layout_marginEnd="@dimen/spacer_small_half"
                style="@style/PrimaryIconMedium"/>
            <ImageView
                android:id="@+id/shuffle_button"
                android:src="@drawable/ic_playback_shuffle"
                android:layout_marginStart="@dimen/spacer_small_half"
                android:layout_marginEnd="@dimen/spacer_small_half"
                style="@style/PrimaryIconMedium"/>
            <ImageView
                android:id="@+id/download_button"
                android:src="@drawable/ic_action_download"
                android:layout_marginStart="@dimen/spacer_small_half"
                android:layout_marginEnd="@dimen/spacer_small_half"
                style="@style/PrimaryIconMedium"/>
            <ImageView
                android:id="@+id/edit_button"
                android:src="@drawable/ic_action_edit"
                android:layout_marginStart="@dimen/spacer_small_half"
                android:layout_marginEnd="@dimen/spacer_small_half"
                style="@style/PrimaryIconMedium"/>
            <ImageView
                android:id="@+id/station_button"
                android:src="@drawable/ic_playback_station"
                android:layout_marginStart="@dimen/spacer_small_half"
                style="@style/PrimaryIconMedium"/>
            <ImageView
                android:id="@+id/share_button"
                android:src="@drawable/ic_action_share"
                android:layout_marginStart="@dimen/spacer_small_half"
                android:layout_marginEnd="@dimen/spacer_small_half"
                style="@style/PrimaryIconMedium"/>
            <ImageView
                android:id="@+id/more_button"
                android:src="@drawable/ic_action_more"
                android:layout_marginStart="@dimen/spacer_small_half"
                style="@style/PrimaryIconMedium"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
