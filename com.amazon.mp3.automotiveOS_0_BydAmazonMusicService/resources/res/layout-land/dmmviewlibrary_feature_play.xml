<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/merch_slot"
    android:clickable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/background_images"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.amazon.music.views.library.views.TransparentGradientImageView
            android:id="@+id/background_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/artistImageContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.amazon.music.views.library.views.TransparentGradientImageView
                android:id="@+id/tv_background_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <com.amazon.music.views.library.views.TransparentGradientImageView
                android:id="@+id/hero_image"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintWidth_default="percent"
                app:layout_constraintWidth_percent="0.5"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.amazon.music.views.library.views.TransparentGradientImageView
            android:id="@+id/tv_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/play_equalizer_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/feature_play_play_equalizer_box_margin_bottom"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_elements">
        <LinearLayout
            android:id="@+id/play_equalizer"
            android:background="@layout/dmmviewlibrary_equalizer_container_oval"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="@dimen/spacer_16"
            android:paddingEnd="@dimen/spacer_12">
            <com.amazon.music.views.library.views.PlayNotificationIcon
                android:gravity="start"
                android:id="@+id/PlaystateIcon"
                android:visibility="visible"
                android:clickable="false"
                android:layout_width="@dimen/spacer_24"
                android:layout_height="@dimen/spacer_24"
                android:layout_marginTop="@dimen/spacer_12"
                android:layout_marginBottom="@dimen/spacer_12"
                android:tint="@android:color/white"/>
            <TextView
                android:layout_gravity="center_vertical"
                android:id="@+id/internal_storage_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/spacer_12"
                android:layout_marginRight="@dimen/spacer_12"/>
        </LinearLayout>
        <com.amazon.ui.foundations.views.BaseButton
            android:id="@+id/PlayIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/text_elements"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/feature_play_large_text_elements_margin_top"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:ellipsize="end"
            android:id="@+id/label"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="@integer/feature_play_label_max_lines"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:ellipsize="end"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/small_spacing"
            android:maxLines="@integer/feature_play_title_max_lines"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/label"/>
        <TextView
            android:ellipsize="end"
            android:id="@+id/primary_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/small_spacing"
            android:maxLines="@integer/feature_play_primary_text_max_lines"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
        <TextView
            android:ellipsize="end"
            android:id="@+id/secondary_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gutter_half"
            android:maxLines="@integer/feature_play_secondary_text_max_lines"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/primary_text"/>
        <TextView
            android:ellipsize="end"
            android:id="@+id/tertiary_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gutter_half"
            android:maxLines="@integer/feature_play_tertiary_text_max_lines"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/secondary_text"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
