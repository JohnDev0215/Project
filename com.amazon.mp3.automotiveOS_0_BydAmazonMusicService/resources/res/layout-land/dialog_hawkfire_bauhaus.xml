<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/background_view"
        android:background="@drawable/bauhaus_gradient_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/dialog_outside_margin_landscape"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true">
        <ImageButton
            android:id="@+id/closeButton"
            android:layout_width="@dimen/spacing_24dp"
            android:layout_height="@dimen/spacing_24dp"
            android:layout_marginLeft="@dimen/upsell_dialog_margin_left"
            android:src="@drawable/ic_dialog_close_dark"
            style="@style/BauhausCloseButton"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/unlimitedImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/music_unlimited_logo_white"
            android:scaleType="fitXY"/>
        <TextView
            android:textSize="@dimen/dialog_title_text_size_nightwing"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/bauhausNowPlayingNonBlockingTitle"
            android:paddingTop="@dimen/dialog_text_top_padding_landscape"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dmusic_hawkfire_account_nightwing_upsell_dialog_title"
            android:textAlignment="center"
            style="@style/DialogTitleText"/>
        <TextView
            android:textSize="@dimen/dialog_subtitle_text_size_nightwing"
            android:textColor="@color/pure_white"
            android:textColorLink="@color/upsell_dialog_link_color"
            android:gravity="center"
            android:id="@+id/unlimitedIconList"
            android:paddingTop="@dimen/dialog_text_top_padding_landscape"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dialog_subtitle_margin"
            android:layout_marginRight="@dimen/dialog_subtitle_margin"
            android:text="@string/dmusic_hawkfire_account_nightwing_upsell_dialog_message"
            android:textAlignment="center"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/dialog_text_top_padding_landscape"/>
        <Button
            android:textColor="@color/black"
            android:id="@+id/signupButton"
            android:text="@string/dmusic_hawkfire_accoun_nightwing_upsell_dialog_positive_btn"
            android:textAlignment="center"
            style="@style/BauhausSignupButton"/>
        <TextView
            android:textSize="@dimen/dialog_comfort_text_size_nightwing"
            android:textColor="@color/grant_sdcard_permission_tab_indicator_grey"
            android:textColorLink="@color/upsell_dialog_signup_button"
            android:gravity="center"
            android:layout_gravity="end"
            android:id="@+id/comfortText"
            android:paddingBottom="@dimen/dialog_text_top_padding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dmusic_hawkfire_account_nightwing_upsell_dialog_comfort_text"
            android:textAlignment="center"/>
        <include
            android:id="@+id/loading_view"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            layout="@layout/blank_loading_activity"/>
    </LinearLayout>
</RelativeLayout>
