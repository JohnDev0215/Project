<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="@dimen/player_artwork_padding"
        android:paddingTop="@dimen/player_artwork_padding"
        android:paddingRight="@dimen/player_artwork_padding"
        android:paddingBottom="@dimen/player_artwork_padding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.amazon.music.widget.nowplaying.SquareImageView
            android:id="@+id/PlayerArtworkImage"
            android:background="@color/primo_blue_light"
            android:layout_width="@dimen/player_artwork_width"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@string/dmusic_cover_album_art"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="@dimen/player_text_top_padding"
        android:paddingRight="@dimen/player_text_top_padding"
        android:paddingBottom="@dimen/player_text_bottom_padding"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textColor="@color/white"
            android:ellipsize="marquee"
            android:id="@+id/PlayerTitle"
            android:paddingBottom="@dimen/player_title_text_bottom_padding"
            android:layout_centerHorizontal="true"
            android:marqueeRepeatLimit="marquee_forever"
            style="@style/NowPlayingDetailPrimary"/>
        <TextView
            android:textColor="@color/now_playing_artist_name_text_color"
            android:id="@+id/PlayerSubtitle"
            android:drawablePadding="@dimen/tiny_padding"
            android:layout_centerHorizontal="true"
            style="@style/NowPlayingDetailSecondary"/>
        <com.amazon.music.widget.nowplaying.NowPlayingSeekBar
            android:id="@+id/PlayerSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/player_seekbar_top_padding"
            style="@style/NowPlayingSeekBar"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true">
            <ImageButton
                android:id="@+id/PlayerPrevButton"
                android:background="@drawable/ripple_background_no_mask"
                android:padding="@dimen/small_padding"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/player_btn_prev"
                android:contentDescription="@string/dmusic_player_previous_button_description"/>
            <Space
                android:background="@color/transparent"
                android:layout_width="@dimen/now_playing_controls_spacing"
                android:layout_height="match_parent"/>
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ProgressBar
                    android:id="@+id/PlayerProgressBar"
                    android:padding="@dimen/small_padding"
                    android:visibility="invisible"
                    android:layout_width="@dimen/player_play_icon_height"
                    android:layout_height="@dimen/player_play_icon_height"/>
                <ImageButton
                    android:id="@+id/PlayerPlayButton"
                    android:background="@drawable/ripple_background_no_mask"
                    android:layout_width="@dimen/player_play_icon_height"
                    android:layout_height="@dimen/player_play_icon_height"
                    android:src="@drawable/player_btn_play"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/dmusic_player_btn_play_description"/>
                <include layout="@layout/upsell_layout"/>
            </FrameLayout>
            <Space
                android:background="@color/transparent"
                android:layout_width="@dimen/now_playing_controls_spacing"
                android:layout_height="match_parent"/>
            <ImageButton
                android:id="@+id/PlayerNextButton"
                android:background="@drawable/ripple_background_no_mask"
                android:padding="@dimen/small_padding"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/player_btn_next"
                android:contentDescription="@string/dmusic_player_btn_next_description"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
