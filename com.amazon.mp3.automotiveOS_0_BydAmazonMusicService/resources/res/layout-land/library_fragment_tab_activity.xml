<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/TabLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.amazon.mp3.view.GradientBackgroundView
        android:layout_width="match_parent"
        android:layout_height="@dimen/gradient_background_height"/>
    <FrameLayout
        android:id="@+id/HeaderBarContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"/>
    <FrameLayout
        android:id="@+id/HackyFrameLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_below="@+id/HeaderBarContainer"/>
    <ViewStub
        android:id="@+id/PlaylistHeaderViewStub"
        android:visibility="gone"
        android:inflatedId="@+id/PlaylistHeaderViewStub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/HackyFrameLayout"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_above="@+id/PersistentPlayerContainer"
        android:layout_below="@+id/PlaylistHeaderViewStub">
        <ViewStub
            android:id="@+id/DetailViewStub"
            android:inflatedId="@+id/DetailViewStub"
            android:layout_width="@dimen/detail_view_width"
            android:layout_height="match_parent"/>
        <View
            android:id="@+id/vertical_seperator"
            android:visibility="gone"
            style="@style/VerticalSeparator"/>
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <com.amazon.mp3.view.ArrowHorizontalScrollView
                android:id="@+id/TabLayoutHorizontalScroller"
                android:fadingEdgeLength="@dimen/headerbar_tabs_fade_length"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/headerbar_tabs_left_margin"
                android:layout_marginRight="@dimen/headerbar_tabs_right_margin"
                android:fillViewport="false"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                style="@style/LibraryHorizontalTabWidgetContainer">
                <com.amazon.mp3.fragment.FragmentTabWidget
                    android:id="@+id/TabLayoutTabWidget"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/headerbar_tabs_height"/>
            </com.amazon.mp3.view.ArrowHorizontalScrollView>
            <ImageView
                android:id="@+id/LeftArrow"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/horizontal_scrollview_arrow_margin_left"
                android:layout_marginTop="@dimen/horizontal_scrollview_arrow_margin_top"
                android:src="@drawable/ic_nav_arrow_left"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true"/>
            <ImageView
                android:id="@+id/RightArrow"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/horizontal_scrollview_arrow_margin_top"
                android:layout_marginRight="@dimen/horizontal_scrollview_arrow_margin_right"
                android:src="@drawable/ic_nav_arrow_right"
                android:layout_alignParentTop="true"
                android:layout_alignParentRight="true"/>
            <FrameLayout
                android:id="@+id/TabContentView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/TabLayoutHorizontalScroller"/>
        </RelativeLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/PersistentPlayerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
