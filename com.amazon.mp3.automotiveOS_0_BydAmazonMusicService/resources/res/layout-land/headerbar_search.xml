<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/large_text_size"
        android:textColor="@color/white"
        android:id="@+id/HeaderTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/standard_padding"
        android:layout_marginEnd="@dimen/standard_padding"/>
    <com.amazon.mp3.view.MusicSourceToggle
        android:id="@+id/ActionBarSourceToggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:paddingEnd="4dp"
        android:layout_alignParentEnd="true"/>
    <com.amazon.mp3.view.HeaderBarSearch
        android:textColor="@android:color/white"
        android:id="@+id/FilterEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/library_add_to_playlist_filter_land_vertical_padding"
        android:layout_marginBottom="@dimen/library_add_to_playlist_filter_land_vertical_padding"
        android:singleLine="true"
        android:completionThreshold="1"
        android:layout_centerVertical="true"
        android:inputType="textNoSuggestions"
        android:imeOptions="actionSearch"
        android:layout_marginStart="@dimen/library_add_to_playlist_filter_horiz_padding"
        android:layout_marginEnd="@dimen/library_add_to_playlist_filter_horiz_padding"
        android:layout_toStartOf="@+id/HeaderBarFilterCancelButton"
        android:layout_toEndOf="@+id/HeaderTitle"/>
    <Button
        android:id="@+id/HeaderBarFilterCancelButton"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dmusic_button_cancel"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/small_padding"
        android:layout_toStartOf="@+id/ActionBarSourceToggle"/>
</RelativeLayout>
