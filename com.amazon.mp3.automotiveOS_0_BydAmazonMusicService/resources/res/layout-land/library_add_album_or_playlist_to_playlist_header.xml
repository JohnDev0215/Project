<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/library_playlist_header_sides_margin"
    android:paddingEnd="@dimen/library_playlist_header_sides_margin">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/TopRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/library_playlist_title_textview_top_margin"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true">
        <TextView
            android:ellipsize="end"
            android:id="@+id/PlaylistName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            style="@style/DetailViewContentName"/>
        <TextView
            android:id="@+id/TrackCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/ListItem.Secondary"/>
    </LinearLayout>
    <Button
        android:id="@+id/DoneButton"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/headerbar_library_height"
        android:layout_marginTop="@dimen/library_playlist_title_textview_top_margin"
        android:text="@string/dmusic_button_done"
        android:layout_centerVertical="true"
        android:paddingStart="@dimen/library_playlist_button_padding"
        android:paddingEnd="@dimen/library_playlist_button_padding"
        android:layout_alignParentEnd="true"
        style="@style/Widget.AmazonMP3.Button.Done"/>
</RelativeLayout>
