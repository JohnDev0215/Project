<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/secondary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/podcast_alert_view_root"
        android:padding="@dimen/gutter"
        android:layout_width="@dimen/podcast_dialog_width_land"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <ImageButton
            android:id="@+id/podcast_alert_view_close"
            android:background="@drawable/button_circle"
            android:layout_width="@dimen/podcast_spacer_epic"
            android:layout_height="@dimen/podcast_spacer_epic"
            android:src="@drawable/ic_podcast_action_cancel"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"/>
        <ImageView
            android:id="@+id/podcast_alert_view_image"
            android:layout_width="@dimen/podcast_spacer_epic"
            android:layout_height="@dimen/podcast_spacer_epic"
            android:layout_marginTop="@dimen/podcast_spacer_base"
            android:layout_below="@+id/podcast_alert_view_close"
            android:layout_centerHorizontal="true"/>
        <com.amazon.podcast.views.EmberTextView
            android:id="@+id/podcast_alert_view_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/podcast_spacer_base"
            android:layout_below="@+id/podcast_alert_view_image"
            android:layout_centerHorizontal="true"
            style="@style/PodcastAppTheme.TextView.Headline4"/>
        <com.amazon.podcast.views.EmberTextView
            android:gravity="center"
            android:id="@+id/podcast_alert_view_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/podcast_spacer_base"
            android:layout_marginBottom="@dimen/podcast_spacer_base"
            android:layout_below="@+id/podcast_alert_view_title"
            android:layout_centerHorizontal="true"
            style="@style/PodcastAppTheme.TextView.Primary"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/podcast_spacer_base"
            android:layout_below="@+id/podcast_alert_view_subtitle">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/podcast_alert_view_negative_button"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/podcast_spacer_small"
                style="@style/PodcastAppTheme.ButtonOutline"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/refresh_podcast_alert_view_negative_button"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/podcast_spacer_small"
                style="@style/PodcastAppTheme.RefreshButtonOutline"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/podcast_alert_view_positive_button"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/PodcastAppTheme.ButtonSolid"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/refresh_podcast_alert_view_positive_button"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/PodcastAppTheme.RefreshButtonSolid"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
