<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/background_gradient"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/PlaylistAlbumImage"
        android:visibility="gone"
        android:layout_width="@dimen/playlist_detail_image_width_landscape"
        android:layout_height="@dimen/playlist_detail_image_height_landscape"
        android:layout_marginLeft="@dimen/small_padding"
        android:layout_marginRight="@dimen/small_padding"/>
    <RelativeLayout
        android:gravity="center"
        android:id="@+id/ArtworkPlayerControlsFragment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/PlaylistAlbumImage"
        android:layout_alignEnd="@+id/PlaylistAlbumImage"
        style="@style/DetailPlayerControlsContainer"/>
    <LinearLayout
        android:orientation="vertical"
        android:padding="@dimen/playlist_detail_album_art_padding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@+id/PlaylistAlbumImage">
        <ViewStub
            android:id="@+id/HeaderViewStub"
            android:inflatedId="@+id/HeaderViewStub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.amazon.mp3.view.DragDropListView
            android:id="@+id/ListView"
            android:layout_width="match_parent"
            android:layout_height="@dimen/playlist_detail_drag_drop_listView_height"
            android:layout_weight="1"
            android:headerDividersEnabled="false"
            style="@style/ListView"/>
    </LinearLayout>
    <include
        android:layout_width="match_parent"
        android:layout_height="@dimen/libary_loading_footer_height"
        android:layout_alignParentBottom="true"
        layout="@layout/library_listview_loading_footer"/>
    <include
        android:id="@+id/feature_banner"
        android:layout_width="match_parent"
        android:layout_height="@dimen/browse_banner_height"
        android:layout_alignParentBottom="true"
        layout="@layout/feature_banner"/>
</RelativeLayout>
