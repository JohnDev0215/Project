<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.amazon.music.skyfire.ui.views.RoundedRecyclerView
        android:id="@+id/carousel_images"
        android:background="@color/primary"
        android:layout_width="@dimen/retail_header_carousel_image_size"
        android:layout_height="@dimen/retail_header_carousel_image_size"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/start_guideline"
        app:layout_constraintTop_toTopOf="@+id/top_guideline"/>
    <ImageView
        android:id="@+id/image"
        android:layout_width="@dimen/spacer_28"
        android:layout_height="@dimen/spacer_28"
        android:layout_marginBottom="@dimen/spacer_mini"
        app:layout_constraintBottom_toTopOf="@+id/primary_text"
        app:layout_constraintStart_toStartOf="@+id/call_to_action_button"/>
    <TextView
        android:id="@+id/label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/spacer_small"
        app:layout_constraintBottom_toBottomOf="@+id/image"
        app:layout_constraintEnd_toEndOf="@+id/end_guideline"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/image"
        app:layout_constraintTop_toTopOf="@+id/image"/>
    <TextView
        android:id="@+id/primary_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacer_mini"
        app:layout_constraintBottom_toTopOf="@+id/secondary_text"
        app:layout_constraintEnd_toEndOf="@+id/end_guideline"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/call_to_action_button"
        app:layout_constraintWidth_max="@dimen/retail_header_primary_text_max_width"/>
    <TextView
        android:id="@+id/secondary_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacer_small"
        android:maxLines="1"
        app:layout_constraintBottom_toTopOf="@+id/call_to_action_button"
        app:layout_constraintStart_toStartOf="@+id/call_to_action_button"/>
    <ImageView
        android:id="@+id/primary_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacer_micro"
        app:layout_constraintBottom_toBottomOf="@+id/secondary_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/secondary_text"
        app:layout_constraintTop_toTopOf="@+id/secondary_text"/>
    <com.amazon.ui.foundations.views.BaseButton
        android:id="@+id/call_to_action_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/retail_header_horizontal_padding"
        app:layout_constraintBottom_toBottomOf="@+id/carousel_images"
        app:layout_constraintEnd_toEndOf="@+id/end_guideline"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/carousel_images"
        app:layout_constraintWidth_max="@dimen/retail_header_cta_max_width"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/split_start_guideline"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintGuide_begin="@dimen/spacer_medium"/>
    <View
        android:background="@color/primary_glass_2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/spacer_medium"
        app:layout_constraintEnd_toEndOf="@+id/end_guideline"
        app:layout_constraintStart_toStartOf="@+id/start_guideline"
        app:layout_constraintTop_toBottomOf="@+id/carousel_images"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/top_guideline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="@dimen/action_bar_height"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/start_guideline"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintGuide_begin="@dimen/retail_header_horizontal_padding"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/end_guideline"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintGuide_end="@dimen/retail_header_horizontal_padding"/>
</androidx.constraintlayout.widget.ConstraintLayout>
