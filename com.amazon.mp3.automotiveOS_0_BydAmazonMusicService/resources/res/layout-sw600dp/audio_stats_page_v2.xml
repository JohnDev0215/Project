<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nerd_stats_signal_flow_layout"
    android:background="@drawable/nerd_stats_signal_flow_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/nerd_stats_signal_flow_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/nerd_stats_signal_flow_layout_images"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/nerd_stats_signal_flow_image"
            android:layout_width="match_parent"
            android:layout_height="@dimen/nerd_stats_image_header_size"
            android:layout_marginTop="@dimen/spacer_10"
            android:layout_marginBottom="@dimen/spacer_20"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/podcast_equalizer_primary"/>
        <TextView
            android:textSize="@dimen/text_size_bauhaus_t1"
            android:textColor="@color/primary"
            android:id="@+id/nerd_stats_signal_flow_quality_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacer_6"
            android:text="@string/dmusic_nerd_stats_quality_message"
            android:drawablePadding="@dimen/spacer_small"
            android:fontFamily="@font/ember_regular"
            android:layout_marginStart="@dimen/spacer_base"
            app:drawableEndCompat="@drawable/ic_help_tiny"/>
        <TextView
            android:textSize="@dimen/bauhaus_typography_t2_touch"
            android:textColor="@color/primary_glass_4"
            android:ellipsize="end"
            android:id="@+id/nerd_stats_signal_flow_info_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dmusic_nerd_stats_quality_info_message"
            android:maxLines="2"
            android:fontFamily="@font/ember_regular"
            android:layout_marginStart="@dimen/spacer_base"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/nerd_stats_signal_flow_layout_images"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacer_large"
        android:layout_marginStart="@dimen/spacer_base"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/nerd_stats_signal_flow_header">
        <ImageView
            android:id="@+id/nerd_stats_signal_flow_node1_image"
            android:background="@drawable/nerd_stats_signal_node_border"
            android:layout_width="@dimen/spacer_40"
            android:layout_height="@dimen/spacer_40"
            android:scaleType="centerCrop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_other_song"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/node1_text"
            android:layout_width="@dimen/spacing_0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/nerd_stats_signal_flow_node1_image"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/nerd_stats_signal_flow_node1_image"
            app:layout_constraintTop_toTopOf="@+id/nerd_stats_signal_flow_node1_image">
            <TextView
                android:textSize="@dimen/text_size_bauhaus_t1"
                android:textColor="@color/primary"
                android:ellipsize="end"
                android:id="@+id/nerd_stats_signal_flow_node1_primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dmusic_nerd_stats_track_quality"
                android:maxLines="1"
                android:fontFamily="@font/ember_regular"
                android:layout_marginStart="@dimen/spacer_mini"
                android:layout_marginEnd="@dimen/spacer_base"/>
            <TextView
                android:textSize="@dimen/bauhaus_typography_t2_touch"
                android:textColor="@color/primary_glass_4"
                android:id="@+id/nerd_stats_signal_flow_node1_secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacer_4"
                android:fontFamily="@font/ember_regular"
                android:layout_marginStart="@dimen/spacer_mini"
                android:layout_marginEnd="@dimen/spacer_base"/>
        </LinearLayout>
        <ProgressBar
            android:id="@+id/nerd_stats_signal_flow_divider"
            android:background="@drawable/nerd_stats_vertical_divider"
            android:layout_width="@dimen/nerd_stats_vertical_divider_width"
            android:layout_height="@dimen/nerd_stats_vertical_divider_height"
            android:indeterminate="false"
            android:layout_centerHorizontal="true"
            app:layout_constraintEnd_toEndOf="@+id/nerd_stats_signal_flow_node1_image"
            app:layout_constraintStart_toStartOf="@+id/nerd_stats_signal_flow_node1_image"
            app:layout_constraintTop_toBottomOf="@+id/nerd_stats_signal_flow_node1_image"
            style="?android:attr/progressBarStyleHorizontal"/>
        <TextView
            android:textSize="@dimen/bauhaus_typography_t2_touch"
            android:textColor="@color/primary_glass_4"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/nerd_stats_signal_flow_signal_message1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/nerd_stats_half_vertical_divider_height"
            android:layout_marginBottom="@dimen/nerd_stats_half_vertical_divider_height"
            android:text="@string/dmusic_nerd_stats_signal_message"
            android:maxLines="2"
            android:drawablePadding="@dimen/spacer_20"
            android:fontFamily="@font/ember_regular"
            android:layout_marginStart="@dimen/nerd_stats_signal_message_spacer"
            android:layout_marginEnd="@dimen/spacer_base"
            app:drawableEndCompat="@drawable/ic_chevron_right_grey"
            app:drawableStartCompat="@drawable/ic_error_inline"
            app:layout_constraintBottom_toTopOf="@+id/nerd_stats_signal_flow_node2_image"
            app:layout_constraintStart_toStartOf="@+id/nerd_stats_signal_flow_node1_image"
            app:layout_constraintTop_toBottomOf="@+id/nerd_stats_signal_flow_node1_image"/>
        <ImageView
            android:id="@+id/nerd_stats_signal_flow_node2_image"
            android:background="@drawable/nerd_stats_signal_node_border"
            android:layout_width="@dimen/spacer_40"
            android:layout_height="@dimen/spacer_40"
            android:scaleType="centerInside"
            android:layout_below="@+id/nerd_stats_signal_flow_divider"
            app:layout_constraintBottom_toTopOf="@+id/nerd_stats_signal_flow_node3_image"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/nerd_stats_signal_flow_node1_image"
            app:srcCompat="@drawable/ic_phone"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/node2_text"
            android:layout_width="@dimen/spacing_0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/nerd_stats_signal_flow_node2_image"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/nerd_stats_signal_flow_node2_image"
            app:layout_constraintTop_toTopOf="@+id/nerd_stats_signal_flow_node2_image">
            <TextView
                android:textSize="@dimen/text_size_bauhaus_t1"
                android:textColor="@color/primary"
                android:ellipsize="end"
                android:id="@+id/nerd_stats_signal_flow_node2_primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dmusic_nerd_stats_device"
                android:maxLines="1"
                android:fontFamily="@font/ember_regular"
                android:layout_marginStart="@dimen/spacer_mini"
                android:layout_marginEnd="@dimen/spacer_base"/>
            <TextView
                android:textSize="@dimen/bauhaus_typography_t2_touch"
                android:textColor="@color/primary_glass_4"
                android:id="@+id/nerd_stats_signal_flow_node2_secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacer_4"
                android:fontFamily="@font/ember_regular"
                android:layout_marginStart="@dimen/spacer_mini"
                android:layout_marginEnd="@dimen/spacer_base"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/bauhaus_typography_t2_touch"
            android:textColor="@color/primary_glass_4"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/nerd_stats_signal_flow_signal_message2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/nerd_stats_half_vertical_divider_height"
            android:layout_marginBottom="@dimen/nerd_stats_half_vertical_divider_height"
            android:text="@string/dmusic_nerd_stats_signal_message"
            android:maxLines="2"
            android:drawablePadding="@dimen/spacer_20"
            android:fontFamily="@font/ember_regular"
            android:layout_marginStart="@dimen/nerd_stats_signal_message_spacer"
            android:layout_marginEnd="@dimen/spacer_base"
            app:drawableStartCompat="@drawable/ic_error_inline"
            app:layout_constraintBottom_toTopOf="@+id/nerd_stats_signal_flow_node3_image"
            app:layout_constraintStart_toStartOf="@+id/nerd_stats_signal_flow_node2_image"
            app:layout_constraintTop_toBottomOf="@+id/nerd_stats_signal_flow_node2_image"/>
        <ImageView
            android:id="@+id/nerd_stats_signal_flow_node3_image"
            android:background="@drawable/nerd_stats_signal_node_border"
            android:layout_width="@dimen/spacer_40"
            android:layout_height="@dimen/spacer_40"
            android:layout_marginBottom="@dimen/spacer_giant"
            android:scaleType="centerInside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/nerd_stats_signal_flow_divider"
            app:srcCompat="@drawable/ic_other_song"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/node3_text"
            android:layout_width="@dimen/spacing_0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/nerd_stats_signal_flow_node3_image"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/nerd_stats_signal_flow_node3_image"
            app:layout_constraintTop_toTopOf="@+id/nerd_stats_signal_flow_node3_image">
            <TextView
                android:textSize="@dimen/text_size_bauhaus_t1"
                android:textColor="@color/primary"
                android:ellipsize="end"
                android:id="@+id/nerd_stats_signal_flow_node3_primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dmusic_nerd_stats_output"
                android:maxLines="1"
                android:fontFamily="@font/ember_regular"
                android:layout_marginStart="@dimen/spacer_mini"
                android:layout_marginEnd="@dimen/spacer_base"/>
            <TextView
                android:textSize="@dimen/bauhaus_typography_t2_touch"
                android:textColor="@color/primary_glass_4"
                android:id="@+id/nerd_stats_signal_flow_node3_secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacer_4"
                android:fontFamily="@font/ember_regular"
                android:layout_marginStart="@dimen/spacer_mini"
                android:layout_marginEnd="@dimen/spacer_base"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
