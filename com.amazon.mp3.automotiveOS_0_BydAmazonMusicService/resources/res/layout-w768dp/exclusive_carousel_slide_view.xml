<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/exclusive_carousel_header_height">
    <ImageView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:ellipsize="end"
        android:gravity="bottom"
        android:id="@+id/label"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:maxLines="1"
        android:layout_marginStart="@dimen/spacer_huge"
        android:layout_marginEnd="@dimen/spacer_huge"
        app:layout_constraintBottom_toTopOf="@+id/headline"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacer_micro"
        android:layout_marginStart="@dimen/spacer_huge"
        android:layout_marginEnd="@dimen/spacer_huge"
        app:layout_constraintBottom_toTopOf="@+id/description"
        app:layout_constraintTop_toBottomOf="@+id/label"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacer_small"
        android:layout_marginStart="@dimen/spacer_huge"
        android:layout_marginEnd="@dimen/spacer_huge"
        app:layout_constraintBottom_toTopOf="@+id/call_to_action_button"
        app:layout_constraintTop_toBottomOf="@+id/headline"/>
    <com.amazon.ui.foundations.views.BaseButton
        android:id="@+id/call_to_action_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacer_small"
        android:layout_marginBottom="@dimen/spacer_large"
        android:layout_marginStart="@dimen/spacer_huge"
        android:layout_marginEnd="@dimen/spacer_huge"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/description"/>
</androidx.constraintlayout.widget.ConstraintLayout>
