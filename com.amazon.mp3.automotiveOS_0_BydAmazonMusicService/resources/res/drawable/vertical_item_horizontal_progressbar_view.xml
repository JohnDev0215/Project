<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners
                android:topLeftRadius="@dimen/zero_dp"
                android:topRightRadius="@dimen/zero_dp"
                android:bottomLeftRadius="@dimen/podcast_spacer_mini"
                android:bottomRightRadius="@dimen/podcast_spacer_mini"/>
            <solid android:color="@color/horizontal_progress_bar_base"/>
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners
                    android:topLeftRadius="@dimen/zero_dp"
                    android:topRightRadius="@dimen/zero_dp"
                    android:bottomLeftRadius="@dimen/podcast_spacer_mini"
                    android:bottomRightRadius="@dimen/podcast_spacer_mini"/>
                <solid android:color="@color/horizontal_progress_bar_progress"/>
            </shape>
        </clip>
    </item>
</layer-list>
