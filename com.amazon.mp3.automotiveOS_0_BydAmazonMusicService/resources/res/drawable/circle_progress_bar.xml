    android:toDegrees="@integer/circle_progress_bar_to_degree">
    <shape
        android:shape="ring"
        android:useLevel="true"
        android:thickness="@dimen/circle_progress_bar_thickness">
        <solid android:color="@color/progress_bar_stroke"/>
    </shape>
