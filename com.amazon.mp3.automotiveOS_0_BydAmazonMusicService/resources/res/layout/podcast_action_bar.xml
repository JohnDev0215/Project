<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="@dimen/podcast_action_bar_height">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/podcast_action_bar_constraint_layout"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="@dimen/podcast_action_bar_height">
        <ImageButton
            android:id="@+id/podcast_action_bar_back"
            android:background="@color/transparent"
            android:layout_width="@dimen/podcast_action_bar_button"
            android:layout_height="@dimen/podcast_action_bar_button"
            android:foreground="@drawable/ripple"
            android:src="@drawable/ic_navigation_goback"
            android:scaleType="center"
            android:contentDescription="@string/podcast_back_button_label"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/podcast_action_bar_placeholder_button"
            android:layout_width="@dimen/podcast_action_bar_button"
            android:layout_height="@dimen/podcast_action_bar_button"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.amazon.podcast.views.EmberTextView
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/podcast_action_bar_header"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/podcast_action_bar_placeholder_button"
            app:layout_constraintStart_toEndOf="@+id/podcast_action_bar_back"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/PodcastAppTheme.TextView.Headline4"/>
        <ImageView
            android:id="@+id/podcast_action_bar_mini_header"
            android:visibility="gone"
            android:layout_width="@dimen/podcast_medium_icon_button"
            android:layout_height="@dimen/podcast_medium_icon_button"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/podcast_action_bar_placeholder_button"
            app:layout_constraintStart_toEndOf="@+id/podcast_action_bar_back"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/filter_button"
        android:background="@drawable/button_background_glass_medium_corner"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/podcast_button_medium"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/gutter"
        android:layout_alignParentEnd="true">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/filter_icon"
            android:layout_width="@dimen/podcast_icon_button_tiny"
            android:layout_height="@dimen/podcast_icon_button_tiny"
            android:src="@drawable/ic_other_filter1"
            android:scaleType="centerInside"
            android:layout_marginStart="@dimen/podcast_spacer_small"/>
        <TextView
            android:textSize="@dimen/podcast_text_size_t2"
            android:textColor="@color/primary"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/podcast_filter_button_text"
            android:layout_marginStart="@dimen/podcast_spacer_mini"
            android:layout_marginEnd="@dimen/podcast_spacer_base"/>
    </LinearLayout>
</RelativeLayout>
