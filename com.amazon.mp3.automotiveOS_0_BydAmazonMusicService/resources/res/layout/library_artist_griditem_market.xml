<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:background="@drawable/selector_item_background_color"
        android:paddingBottom="@dimen/tile_bottom_padding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/ArtistArtworkFrame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true">
            <com.amazon.mp3.view.BadgeableView
                android:id="@+id/cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <View
                android:id="@+id/AlbumArtTouchOverlay"
                android:background="@drawable/selector_artwork_mask"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <ImageView
                android:id="@+id/DimAlbumArtOverlay"
                android:background="@color/dimmed"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/PlaystateIcon"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/mp3_icon_songplaying_paused"/>
        </FrameLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/ArtistArtworkFrame"
            android:layout_toStartOf="@+id/RightViews">
            <TextView
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:id="@+id/ArtistName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tile_primary_text_top_margin"
                android:singleLine="true"
                android:layout_marginStart="@dimen/tile_text_indent"
                style="@style/GridTilePrimaryText"/>
            <TextView
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:id="@+id/Counts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tile_secondary_text_top_margin"
                android:singleLine="true"
                android:layout_marginStart="@dimen/tile_text_indent"
                style="@style/TileSecondaryText"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/RightViews"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/ArtistArtworkFrame"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true">
            <com.amazon.mp3.view.DownloadProgressBadgeView
                android:id="@+id/DownloadProgress"
                android:visibility="gone"
                android:layout_width="@dimen/download_circular_progress_bar_width"
                android:layout_height="@dimen/download_circular_progress_bar_width"
                android:layout_margin="@dimen/standard_padding"
                android:layout_marginEnd="@dimen/listview_horizontal_padding"/>
            <ImageButton
                android:id="@+id/AddAllButton"
                android:background="@null"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tiny_padding"
                android:src="@drawable/playlist_btn_add"
                android:minWidth="@dimen/minimum_button_width"
                android:contentDescription="@string/add_all_content_description"/>
            <include layout="@layout/overflow_button"/>
        </FrameLayout>
    </RelativeLayout>
</FrameLayout>
