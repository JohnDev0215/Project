<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:amazonmp3="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/grid_tile_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.amazon.mp3.view.FixedWidthAspectImageView
            android:id="@+id/artwork"
            android:background="@color/placeholder_grey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/placeholder_sm"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"/>
        <ImageView
            android:id="@+id/PrimeSash"
            android:visibility="gone"
            android:layout_width="@dimen/medium_prime_sash_size"
            android:layout_height="@dimen/medium_prime_sash_size"
            android:src="@drawable/prime_sash"
            android:scaleType="fitCenter"/>
        <FrameLayout
            android:layout_gravity="start|bottom"
            android:paddingBottom="@dimen/standard_padding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/standard_padding">
            <ImageView
                android:id="@+id/PlayIcon"
                android:visibility="gone"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:scaleType="center"/>
            <com.amazon.mp3.view.DownloadProgressBadgeView
                android:layout_gravity="center"
                android:id="@+id/DownloadBadge"
                android:padding="@dimen/recently_played_download_tap_target_spacing"
                android:visibility="gone"
                android:layout_width="@dimen/recently_played_download_circular_progress_bar_width"
                android:layout_height="@dimen/recently_played_download_circular_progress_bar_width"/>
        </FrameLayout>
        <com.amazon.mp3.view.PlayNotificationIcon
            android:layout_gravity="center"
            android:id="@+id/PlaystateIcon"
            android:background="@color/dimmed"
            android:visibility="gone"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="center"
            amazonmp3:useLargeIcons="true"/>
        <com.amazon.mp3.view.FixedWidthAspectImageView
            android:background="@drawable/selector_artwork_mask"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <RelativeLayout
        android:id="@+id/detail_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:paddingTop="@dimen/grid_title_top_padding"
            android:paddingBottom="@dimen/grid_tile_bottom_padding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_marginStart="@dimen/grid_tile_text_indent"
            android:layout_toStartOf="@+id/overflow_button_open"
            android:layout_alignParentStart="true">
            <TextView
                android:id="@+id/title"
                android:paddingBottom="@dimen/grid_title_bottom_padding_no_reason"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_alignParentTop="true"
                style="@style/GridTilePrimaryText"/>
            <TextView
                android:id="@+id/subtitle"
                android:paddingBottom="@dimen/grid_tile_artist_bottom_padding"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_below="@+id/title"
                android:layout_marginEnd="@dimen/grid_tile_text_indent"
                style="@style/SecondaryText"/>
            <TextView
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/recommendation_reason"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lines="2"
                android:layout_below="@+id/subtitle"
                style="@style/ReasonText"/>
            <com.amazon.mp3.view.BadgeView
                android:id="@+id/ContentEncodingBadgeTile"
                android:layout_below="@+id/recommendation_reason"
                android:layout_marginEnd="@dimen/spacing_4dp"
                style="@style/ContentEncodingBadge"/>
            <com.amazon.mp3.view.BadgeView
                android:id="@+id/ImmersiveBadgeTile"
                android:layout_below="@+id/recommendation_reason"
                android:layout_toEndOf="@+id/ContentEncodingBadgeTile"
                style="@style/ContentEncodingBadge"/>
        </RelativeLayout>
        <ImageView
            android:id="@+id/overflow_button_open"
            android:background="@drawable/ripple_background_no_mask"
            android:paddingTop="@dimen/grid_tile_overflow_padding"
            android:paddingBottom="@dimen/grid_tile_overflow_padding"
            android:focusable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/action_bar_overflow_open"
            android:scaleType="center"
            android:layout_alignParentTop="true"
            android:contentDescription="@string/overflow_button_content_description"
            android:layout_alignParentEnd="true"
            layout="@layout/overflow_button"/>
    </RelativeLayout>
</LinearLayout>
