<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/overflow_menu_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/overflow_menu_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_weight="1">
        <TextView
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/overflow_menu_now_playing"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacer_32"
            app:layout_constrainedHeight="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/AmazonMusic.EmberRegularText"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/add_to_playlist_shoveler_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/text_size_18"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:id="@+id/add_to_playlist_shoveler_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/bauhaus_spacer_base"
                android:layout_marginTop="@dimen/spacer_36"
                android:layout_marginRight="@dimen/bauhaus_spacer_base"
                android:layout_marginBottom="@dimen/spacer_16"
                android:text="@string/dmusic_context_add_to_playlist"
                android:layout_marginHorizontal="@dimen/bauhaus_spacer_base"
                app:layout_constraintEnd_toStartOf="@+id/see_all_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/add_to_playlist_shoveler_container"
                style="@style/AmazonMusic.EmberRegularText"/>
            <ImageView
                android:id="@+id/see_all_button"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:src="@drawable/ic_chevron_caretright"
                android:layout_marginEnd="@dimen/bauhaus_spacer_base"
                app:layout_constraintBottom_toBottomOf="@+id/add_to_playlist_shoveler_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1"
                app:layout_constraintStart_toEndOf="@+id/add_to_playlist_shoveler_title"
                app:layout_constraintTop_toTopOf="@+id/add_to_playlist_shoveler_title"/>
            <FrameLayout
                android:id="@+id/add_to_playlist_shoveler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacer_16"
                app:layout_constraintTop_toBottomOf="@+id/add_to_playlist_shoveler_title"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/more_section_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/bauhaus_spacer_base"
            android:layout_marginRight="@dimen/bauhaus_spacer_base"
            android:layout_marginHorizontal="@dimen/bauhaus_spacer_base">
            <TextView
                android:textSize="@dimen/text_size_18"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:id="@+id/more_section_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacer_36"
                android:layout_marginBottom="@dimen/spacer_16"
                android:text="@string/dmusic_context_more"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/AmazonMusic.EmberRegularText"/>
            <FrameLayout
                android:id="@+id/more_buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacer_16"
                app:layout_constrainedHeight="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/more_section_title"/>
            <FrameLayout
                android:id="@+id/more_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacer_16"
                app:layout_constrainedHeight="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/more_buttons"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
