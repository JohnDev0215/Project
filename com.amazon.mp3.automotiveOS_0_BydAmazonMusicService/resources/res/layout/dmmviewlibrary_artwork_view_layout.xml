<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.amazon.ui.foundations.views.BaseImage
        android:layout_gravity="center"
        android:id="@+id/artwork"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/Sash"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="fitCenter"/>
    <ImageView
        android:id="@+id/DimmedArtworkOverlay"
        android:background="@color/dimmed"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.amazon.music.views.library.views.PlayNotificationIcon
        android:layout_gravity="center"
        android:id="@+id/PlaystateIcon"
        android:background="@color/dimmed"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="@dimen/spacer_48"
        android:layout_height="@dimen/spacer_48"
        android:scaleType="fitCenter"/>
    <com.amazon.ui.foundations.views.BaseButton
        android:layout_gravity="start|bottom"
        android:id="@+id/play_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <ImageView
        android:enabled="false"
        android:layout_gravity="start|bottom"
        android:id="@+id/artwork_station_badge"
        android:paddingBottom="4dp"
        android:focusable="false"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/station_thumb_outline"
        android:scaleType="center"
        android:paddingStart="4dp"/>
</FrameLayout>
