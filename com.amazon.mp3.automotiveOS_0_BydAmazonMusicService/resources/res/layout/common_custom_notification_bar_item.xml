<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center_vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:gravity="center"
        android:id="@+id/notification_bar_icon"
        android:layout_width="@dimen/notification_icon_width"
        android:layout_height="match_parent"
        android:src="@drawable/ic_notification_tray_loading"
        android:scaleType="center"
        android:layout_alignParentLeft="true"/>
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@+id/notification_bar_icon"
        android:layout_centerInParent="true">
        <TextView
            android:ellipsize="end"
            android:id="@+id/notification_bar_time"
            android:paddingLeft="@dimen/spacing_4dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_alignBaseline="@+id/notification_bar_title"
            android:layout_alignParentRight="true"
            style="@style/DetailViewBodyText.Tertiary"/>
        <TextView
            android:ellipsize="marquee"
            android:id="@+id/notification_bar_title"
            android:fadingEdge="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_toLeftOf="@+id/notification_bar_time"
            style="@style/NotificationTitle"/>
        <TextView
            android:ellipsize="marquee"
            android:id="@+id/notification_bar_text"
            android:fadingEdge="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_below="@+id/notification_bar_title"
            style="@style/NotificationText"/>
    </RelativeLayout>
</RelativeLayout>
