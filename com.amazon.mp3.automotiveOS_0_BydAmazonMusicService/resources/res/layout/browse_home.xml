<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/loading_screen_small_t1r"
        android:background="@color/transparent"
        android:paddingTop="@dimen/spacing_60dp"
        android:visibility="gone"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/animation_view_small_t1r"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:lottie_autoPlay="true"
            app:lottie_fileName="page-loader-shell-small-t1r.json"
            app:lottie_loop="true"/>
    </ScrollView>
    <ScrollView
        android:id="@+id/loading_screen_big_t1r"
        android:background="@color/transparent"
        android:visibility="gone"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/animation_view_big_t1r"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:lottie_autoPlay="true"
            app:lottie_fileName="page-loader-shell-big-t1r.json"
            app:lottie_loop="true"/>
    </ScrollView>
    <FrameLayout
        android:id="@+id/frame"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/artwork"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="matrix"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/artworkOverlayLayout"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/gradientBackground"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scaleType="matrix"/>
        <ImageView
            android:id="@+id/lockableGradientBackground"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scaleType="matrix"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/music_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>
    <com.amazon.music.views.library.views.OverlayLoadingView
        android:id="@+id/browse_overlay_loading_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"/>
    <ProgressBar
        android:id="@+id/loading_spinner"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        style="@style/dmmviewlibrary_progress_bar_large"/>
    <include
        android:layout_gravity="center"
        android:id="@+id/empty_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/browse_empty_layout_top_margin"
        layout="@layout/prime_service_error_layout"/>
</RelativeLayout>
