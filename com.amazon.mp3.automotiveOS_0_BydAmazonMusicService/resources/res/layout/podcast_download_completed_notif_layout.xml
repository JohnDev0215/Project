<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/podcast_download_notif_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:gravity="start|center_vertical"
            android:id="@+id/podcast_imgv_download_icon"
            android:layout_width="@dimen/podcast_download_notification_icon_width"
            android:layout_height="match_parent"
            android:src="@drawable/podcast_ic_notification_tray_downloading"
            android:scaleType="center"
            android:layout_alignParentStart="true"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/podcast_download_notification_text_groups_margin_right"
            android:layout_toEndOf="@+id/podcast_imgv_download_icon">
            <TextView
                android:textAppearance="@style/PodcastDownloadNotificationTitle"
                android:id="@+id/podcast_download_title"
                android:paddingTop="@dimen/podcast_download_notification_text_padding_top"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/podcast_download_completed_notif_title"
                android:singleLine="true"
                android:textIsSelectable="false"/>
            <TextView
                android:textAppearance="@style/PodcastDownloadNotificationProgressStatus"
                android:id="@+id/podcast_download_message"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/podcast_download_completed_notif_message"
                android:textIsSelectable="false"/>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
