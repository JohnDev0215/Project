<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/transparent"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.amazon.podcast.views.ActionBarView
        android:id="@+id/action_bar_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"/>
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/chrome_template_view_view_pager"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/action_bar_view">
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/chrome_template_view_tab_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/podcast_spacer_large"
            android:layout_below="@+id/action_bar_view"
            android:paddingStart="@dimen/gutter"
            android:paddingEnd="@dimen/gutter"
            style="@style/PodcastAppTheme.Tabs"/>
    </androidx.viewpager.widget.ViewPager>
</RelativeLayout>
