<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ViewStub
        android:id="@+id/PlaylistHeaderViewStub"
        android:inflatedId="@+id/PlaylistHeaderViewStub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:id="@+id/ImageFrameLayoutContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/bkgPlaylistImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerInside"/>
        <com.amazon.mp3.view.PlaylistAndGenreDetailImageContainer
            android:orientation="horizontal"
            android:id="@+id/PlaylistDetailImageGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/PlaylistDetailImage"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/PlaylistAlbumImage"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:layout_weight="1"/>
        </com.amazon.mp3.view.PlaylistAndGenreDetailImageContainer>
        <ImageView
            android:id="@+id/PlaylistDetailPlaceHolder"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/playlist_placeholder_detail"
            android:scaleType="center"/>
    </FrameLayout>
    <RelativeLayout
        android:gravity="center"
        android:id="@+id/DetailPlayerControlsFragment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/DetailPlayerControlsContainer"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/DescriptionContainer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/small_text_size"
            android:textColor="@color/grey"
            android:gravity="center"
            android:id="@+id/PlaylistDescription"
            android:padding="@dimen/medium_padding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="@dimen/browse_secondary_text_line_spacing"/>
        <View
            android:layout_marginStart="@dimen/divider_left_padding"
            android:layout_marginEnd="@dimen/divider_right_padding"
            style="@style/HorizontalSeparator"/>
    </LinearLayout>
</LinearLayout>
