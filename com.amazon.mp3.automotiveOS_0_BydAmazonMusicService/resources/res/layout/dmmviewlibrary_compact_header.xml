<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/library_compact_navigator_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.amazon.ui.foundations.views.BaseImage
        android:id="@+id/image"
        android:layout_width="@dimen/compact_header_image_radius"
        android:layout_height="@dimen/compact_header_image_radius"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/label_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAllCaps="true"
        app:layout_constraintBottom_toTopOf="@+id/primary_text"
        app:layout_constraintStart_toStartOf="@+id/primary_text"
        app:layout_constraintTop_toTopOf="@+id/image"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/primary_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="@+id/image"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/image"
        app:layout_constraintTop_toBottomOf="@+id/label_text"/>
</androidx.constraintlayout.widget.ConstraintLayout>
