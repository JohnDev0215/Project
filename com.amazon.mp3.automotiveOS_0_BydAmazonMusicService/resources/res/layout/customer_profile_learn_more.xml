<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:card_view="http://schemas.android.com/apk/res-auto" xmlns:aapt="http://schemas.android.com/aapt"
    android:background="@drawable/edit_profile_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dialog_content_margin"
            android:layout_marginBottom="@dimen/dialog_content_margin"
            android:layout_centerInParent="true"
            android:layout_marginStart="@dimen/dialog_content_margin"
            android:layout_marginEnd="@dimen/dialog_content_margin">
            <ImageView
                android:layout_gravity="end"
                android:id="@+id/edit_profile_close_button"
                android:background="@drawable/rounded_close_btn"
                android:clickable="true"
                android:layout_width="@dimen/button_corner_radius"
                android:layout_height="@dimen/button_corner_radius"
                android:src="@drawable/ic_action_cancel"
                android:scaleType="centerCrop"
                android:adjustViewBounds="true"/>
            <ImageView
                android:id="@+id/edit_profile_avatar"
                android:background="@drawable/ic_navigation_profile"
                android:layout_width="@dimen/edit_profile_avatar_size"
                android:layout_height="@dimen/edit_profile_avatar_size"
                android:layout_marginTop="@dimen/edit_profile_large_field_spacing"
                android:scaleType="centerCrop"
                android:adjustViewBounds="true"/>
            <TextView
                android:textSize="@dimen/dialog_title_text_size"
                android:textStyle="bold"
                android:textColor="@color/transparent_white_80"
                android:gravity="center"
                android:id="@+id/learn_more_profile_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/edit_profile_middle_field_spacing"
                android:layout_marginBottom="@dimen/edit_profile_middle_field_spacing"
                android:textAlignment="center"/>
            <TextView
                android:textSize="@dimen/dialog_regular_text_size"
                android:textColor="@color/transparent_white_70"
                android:gravity="center"
                android:id="@+id/learn_more_profile_name_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/edit_profile_middle_field_spacing"/>
            <RelativeLayout
                android:gravity="top"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dialog_content_margin">
                <androidx.appcompat.widget.AppCompatButton
                    android:textColor="@color/black"
                    android:id="@+id/edit_profile_got_it_button"
                    android:background="@drawable/edit_profile_save_button"
                    android:layout_width="@dimen/edit_profile_save_button_width"
                    android:layout_height="@dimen/edit_profile_save_button_height"
                    android:layout_marginTop="@dimen/edit_profile_very_large_field_spacing"
                    android:text="@string/dmusic_edit_profile_got_it_button_text"
                    android:textAllCaps="false"
                    android:backgroundTint="@null"/>
            </RelativeLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
