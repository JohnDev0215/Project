<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/edit_profile_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dialog_content_margin"
        android:layout_marginBottom="@dimen/dialog_content_margin"
        android:layout_centerInParent="true"
        android:layout_marginStart="@dimen/dialog_content_margin"
        android:layout_marginEnd="@dimen/dialog_content_margin">
        <ImageView
            android:layout_gravity="end"
            android:id="@+id/edit_profile_close_button"
            android:background="@drawable/rounded_close_btn"
            android:clickable="true"
            android:layout_width="@dimen/button_corner_radius"
            android:layout_height="@dimen/button_corner_radius"
            android:src="@drawable/ic_action_cancel"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"/>
        <TextView
            android:textSize="@dimen/dialog_regular_text_size"
            android:textStyle="bold"
            android:textColor="@color/transparent_white_80"
            android:gravity="center"
            android:id="@+id/customer_profile_dialog_fragment_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/edit_profile_standard_field_spacing"
            android:layout_marginBottom="@dimen/edit_profile_standard_field_spacing"
            android:text="@string/dmusic_profile_dialog_message"
            android:textAlignment="center"/>
        <RelativeLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/edit_profile_standard_field_spacing"
            android:layout_marginBottom="@dimen/edit_profile_standard_field_spacing">
            <androidx.appcompat.widget.AppCompatButton
                android:textColor="@color/black"
                android:id="@+id/edit_profile_confirmation_button"
                android:background="@drawable/edit_profile_save_button"
                android:layout_width="@dimen/profile_dialog_confirmation_button_width"
                android:layout_height="@dimen/profile_dialog_confirmation_button_height"
                android:layout_marginTop="@dimen/edit_profile_very_large_field_spacing"
                android:text="@string/dmusic_profile_dialog_make_private_button_text"
                android:textAllCaps="false"/>
            <ProgressBar
                android:id="@+id/edit_profile_progress_bar"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/edit_profile_very_large_field_spacing"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>
