<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/search_row_background"
    android:layout_width="match_parent"
    android:layout_height="@dimen/song_tile_detail_height">
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="@dimen/song_tile_art_size"
        android:layout_height="@dimen/song_tile_art_size"
        android:src="@drawable/artist_placeholder"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/song_tile_text_indent"
        android:layout_alignParentStart="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@+id/imageView">
        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            style="@style/PrimaryText"/>
        <TextView
            android:id="@+id/counts"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/listview_item_secondary_text_padding_top"
            android:singleLine="true"
            style="@style/SecondaryText"/>
    </LinearLayout>
</RelativeLayout>
