<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <Button
        android:id="@+id/HeaderBarFilterCancelButton"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dmusic_button_cancel"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/small_padding"
        android:layout_alignParentEnd="true"/>
    <com.amazon.mp3.view.HeaderBarSearch
        android:textSize="@dimen/text_size_small"
        android:textColor="@android:color/white"
        android:id="@+id/FilterEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/dmusic_action_bar_search_store"
        android:singleLine="true"
        android:completionThreshold="1"
        android:layout_centerVertical="true"
        android:inputType="textNoSuggestions"
        android:imeOptions="actionSearch"
        android:layout_marginStart="@dimen/small_padding"
        android:layout_marginEnd="@dimen/small_padding"
        android:layout_toStartOf="@+id/HeaderBarFilterCancelButton"
        android:layout_alignParentStart="true"/>
</RelativeLayout>
