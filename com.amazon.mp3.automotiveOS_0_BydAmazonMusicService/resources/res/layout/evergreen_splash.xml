<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/backgroundView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_default="wrap"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/contentView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="1">
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/left_base_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="0.05"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/topSpacer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:layout_constraintBottom_toTopOf="@+id/musicLogo"/>
            <ImageView
                android:layout_gravity="left"
                android:id="@+id/musicLogo"
                android:layout_width="wrap_content"
                android:layout_height="60dp"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"
                app:layout_constraintBottom_toTopOf="@+id/headline"
                app:layout_constraintStart_toStartOf="@+id/left_base_line"
                app:layout_constraintVertical_chainStyle="packed"/>
            <TextView
                android:textSize="64sp"
                android:textStyle="bold"
                android:gravity="left"
                android:id="@+id/headline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/bauhaus_spacer_base"
                android:textAlignment="textStart"
                app:layout_constraintEnd_toEndOf="@+id/right_base_line"
                app:layout_constraintStart_toStartOf="@+id/left_base_line"
                app:layout_constraintTop_toBottomOf="@+id/musicLogo"/>
            <TextView
                android:id="@+id/byline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/bauhaus_spacer_base"
                android:textAlignment="textStart"
                app:layout_constraintEnd_toEndOf="@+id/right_base_line"
                app:layout_constraintStart_toStartOf="@+id/left_base_line"
                app:layout_constraintTop_toBottomOf="@+id/headline"/>
            <TextView
                android:id="@+id/copy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/bauhaus_spacer_small"
                android:textAlignment="textStart"
                app:layout_constraintEnd_toEndOf="@+id/right_base_line"
                app:layout_constraintStart_toStartOf="@+id/left_base_line"
                app:layout_constraintTop_toBottomOf="@+id/byline"/>
            <TextView
                android:gravity="center"
                android:id="@+id/primaryButton"
                android:background="@drawable/rounded_edges"
                android:paddingTop="@dimen/bauhaus_spacer_small"
                android:paddingBottom="@dimen/bauhaus_spacer_small"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/bauhaus_spacer_small"
                android:textAlignment="center"
                app:layout_constraintEnd_toEndOf="@+id/right_base_line"
                app:layout_constraintStart_toStartOf="@+id/left_base_line"
                app:layout_constraintTop_toBottomOf="@+id/copy"/>
            <TextView
                android:gravity="center"
                android:id="@+id/secondaryButtonText"
                android:paddingTop="@dimen/bauhaus_spacer_small"
                android:paddingBottom="@dimen/bauhaus_spacer_base"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                app:layout_constraintEnd_toEndOf="@+id/right_base_line"
                app:layout_constraintStart_toStartOf="@+id/left_base_line"
                app:layout_constraintTop_toBottomOf="@+id/primaryButton"/>
            <TextView
                android:id="@+id/termsOfUseText"
                android:paddingBottom="@dimen/bauhaus_spacer_base"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="@+id/right_base_line"
                app:layout_constraintStart_toStartOf="@+id/left_base_line"
                app:layout_constraintTop_toBottomOf="@+id/secondaryButtonText"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/right_base_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="0.95"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <com.amazon.ui.foundations.views.BaseButton
        android:layout_gravity="center"
        android:id="@+id/closeButton"
        android:layout_width="@dimen/dialog_button_layout_height"
        android:layout_height="@dimen/dialog_button_layout_height"
        android:layout_marginTop="@dimen/bauhaus_spacer_giant"
        android:layout_marginRight="@dimen/bauhaus_spacer_small"
        android:layout_marginBottom="@dimen/bauhaus_spacer_small"
        android:src="@drawable/ic_dialog_close_dark"
        android:scaleType="fitXY"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/backgroundImage"/>
</androidx.constraintlayout.widget.ConstraintLayout>
