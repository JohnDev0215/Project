<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/action_bar_layout"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="@dimen/action_bar_height">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/headerNavigationView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/left_button_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.amazon.ui.foundations.views.BaseButton
            android:id="@+id/Action_Button_Back"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <include
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            layout="@layout/feed_button"/>
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:id="@+id/toggle_view_container"
        android:paddingLeft="@dimen/gutter"
        android:paddingRight="@dimen/gutter"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/ingress_pill_height"
        android:paddingHorizontal="@dimen/gutter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/right_button_container"
        app:layout_constraintStart_toEndOf="@+id/left_button_container"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:id="@+id/ingress_button_container"
        android:paddingLeft="@dimen/gutter"
        android:paddingRight="@dimen/gutter"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ingress_pill_height"
        android:paddingHorizontal="@dimen/gutter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/right_button_container"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:id="@+id/music_ingress_button"
            android:background="@drawable/ingress_button_background"
            android:visibility="gone"
            android:text="Music"
            style="@style/IngressPillButtonStyle"/>
        <View
            android:layout_gravity="center_horizontal"
            android:id="@+id/ingress_view"
            android:layout_width="@dimen/bauhaus_spacer_micro"
            android:layout_height="wrap_content"/>
        <TextView
            android:id="@+id/podcast_ingress_button"
            android:background="@drawable/ingress_button_background"
            android:visibility="gone"
            android:text="Podcasts"
            style="@style/IngressPillButtonStyle"/>
    </LinearLayout>
    <RelativeLayout
        android:gravity="center"
        android:id="@+id/center_text_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/right_button_container"
        app:layout_constraintStart_toEndOf="@+id/left_button_container"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:ellipsize="end"
            android:id="@+id/Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_centerHorizontal="true"
            android:textAlignment="center"/>
        <TextView
            android:ellipsize="end"
            android:id="@+id/Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_below="@+id/Title"
            android:layout_centerHorizontal="true"
            android:textAlignment="center"/>
        <ImageView
            android:id="@+id/Logo_Image"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/spacer_24"
            android:src="@drawable/logo_animation_00034"/>
    </RelativeLayout>
    <com.amazon.mp3.actionbar.view.ActionBarRightButton
        android:id="@+id/Action_Button_Profile"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/casting_button"
        app:layout_constraintTop_toTopOf="parent"
        app:style="profile"
        style="@style/ActionBarProfileButtonStyle"/>
    <com.amazon.ui.foundations.views.BaseImage
        android:id="@+id/album_artwork"
        android:visibility="gone"
        android:layout_width="@dimen/spacer_40"
        android:layout_height="@dimen/spacer_40"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/right_button_container"
        app:layout_constraintStart_toEndOf="@+id/left_button_container"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/right_button_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.amazon.mp3.actionbar.view.ActionBarRightButton
            android:id="@+id/Action_Button_Overflow"
            android:visibility="gone"
            app:style="overflow"
            style="@style/ActionBarStoreButtonStyle"/>
        <com.amazon.ui.foundations.views.BaseButton
            android:id="@+id/context_menu_overflow_button"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.amazon.ui.foundations.views.BaseImage
            android:layout_gravity="center"
            android:id="@+id/profile_bar_right_image"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:maxWidth="@dimen/spacing_28"
            android:maxHeight="@dimen/spacing_28"
            android:layout_weight="1"/>
    </FrameLayout>
    <com.amazon.mp3.casting.CastingBaseButton
        android:id="@+id/casting_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/right_button_container"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.amazon.ui.foundations.views.BaseButton
        android:id="@+id/filter_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/standard_padding"
        android:layout_marginBottom="@dimen/standard_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.amazon.ui.foundations.views.BaseButton
        android:id="@+id/action_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:textColor="@android:color/white"
        android:layout_gravity="center_vertical"
        android:id="@+id/filter_badge"
        android:background="@drawable/blue_circle"
        android:visibility="gone"
        android:layout_width="@dimen/prime_filter_badge_size"
        android:layout_height="@dimen/prime_filter_badge_size"
        app:layout_constraintBottom_toTopOf="@+id/filter_view"
        app:layout_constraintEnd_toEndOf="@+id/filter_view"
        app:layout_constraintStart_toEndOf="@+id/filter_view"
        app:layout_constraintTop_toTopOf="@+id/filter_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
