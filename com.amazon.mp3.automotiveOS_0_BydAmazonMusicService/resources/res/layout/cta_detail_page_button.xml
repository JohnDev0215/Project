<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:layout_gravity="center_horizontal"
    android:orientation="horizontal"
    android:id="@+id/MainButtonContainer"
    android:background="@drawable/follow_outline"
    android:paddingTop="@dimen/follow_container_top_padding"
    android:paddingBottom="@dimen/follow_container_bottom_padding"
    android:visibility="gone"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/follow_container_start_padding"
    android:paddingEnd="@dimen/follow_container_end_padding">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/MainButtonShuffle"
        android:background="@android:color/transparent"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_playback_shuffle"
        android:contentDescription="@string/turn_on_shuffle_content_description"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/MainButtonStation"
        android:background="@android:color/transparent"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_playback_station_svg"
        android:contentDescription="@string/start_station_from_anything"/>
    <TextView
        android:textSize="@dimen/follow_text_size"
        android:textColor="@android:color/white"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/MainButtonTextView"
        android:background="@android:color/transparent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/follow_text_bottom_margin"
        android:text="Shuffle"
        android:maxLines="1"
        android:layout_marginStart="@dimen/follow_text_start_margin"/>
</LinearLayout>
