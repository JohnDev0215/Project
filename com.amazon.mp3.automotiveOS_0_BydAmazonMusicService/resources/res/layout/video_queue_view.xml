<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/video_queue_preview_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <TextureView
        android:id="@+id/video_queue_texture_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/video_queue_overlay"/>
    <RelativeLayout
        android:id="@+id/video_queue_interface_container"
        android:padding="@dimen/spacer_medium"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/video_queue_primary_text"
            android:paddingBottom="@dimen/spacer_micro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/video_queue_secondary_text"
            android:layout_alignParentStart="true"
            style="@style/VideoStoryPrimaryText"/>
        <TextView
            android:id="@+id/video_queue_secondary_text"
            android:paddingBottom="@dimen/spacer_mini"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/video_queue_tertiary_text"
            android:layout_alignParentStart="true"
            style="@style/VideoStorySecondaryText"/>
        <TextView
            android:id="@+id/video_queue_tertiary_text"
            android:paddingBottom="@dimen/video_queue_tertiary_text_padding_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/video_queue_actions_container"
            android:layout_alignParentStart="true"
            style="@style/VideoStoryTertiaryText"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/video_queue_actions_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentStart="true"/>
    </RelativeLayout>
</FrameLayout>
