<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="start"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/title"
        android:background="@color/primo_blue"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/source_toggle_dialog_title_height"
        android:text="@string/dmusic_library_source_dialog_header"
        android:paddingStart="@dimen/source_toggle_dialog_item_padding"
        style="@style/DialogTitleText"/>
    <View
        android:background="@color/divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/spacing_1dp"/>
    <RelativeLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/cloudContainer"
        android:background="@drawable/source_toggle_row_color"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/source_toggle_dialog_row_height">
        <View
            android:id="@+id/cloudSelectedBar"
            android:background="@color/vivace_blue"
            android:layout_width="@dimen/source_toggle_selected_bar_width"
            android:layout_height="match_parent"/>
        <TextView
            android:id="@+id/cloudToggleHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dmusic_library_source_cirrus_header"
            android:layout_centerVertical="true"
            android:paddingStart="@dimen/source_toggle_dialog_item_padding"
            android:layout_toEndOf="@+id/cloudToggleImage"
            android:layout_alignParentStart="true"
            style="@style/MusicSourceToggleHeader"/>
        <ImageView
            android:id="@+id/cloudToggleImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_cloud_done"
            android:layout_centerVertical="true"
            android:paddingEnd="@dimen/source_toggle_dialog_item_padding"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <View
        android:background="@color/divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/spacing_1dp"/>
    <RelativeLayout
        android:id="@+id/deviceContainer"
        android:background="@drawable/source_toggle_row_color"
        android:layout_width="match_parent"
        android:layout_height="@dimen/source_toggle_dialog_row_height">
        <View
            android:id="@+id/deviceSelectedBar"
            android:background="@color/vivace_blue"
            android:layout_width="@dimen/source_toggle_selected_bar_width"
            android:layout_height="match_parent"/>
        <RelativeLayout
            android:id="@+id/deviceToggleContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:paddingStart="@dimen/source_toggle_dialog_item_padding"
            android:layout_toStartOf="@+id/deviceToggleImage"
            android:layout_alignParentStart="true">
            <TextView
                android:id="@+id/deviceToggle"
                android:paddingBottom="@dimen/spacing_2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dmusic_library_source_local_header"
                style="@style/MusicSourceToggleHeader"/>
            <TextView
                android:paddingTop="@dimen/spacing_2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dmusic_library_source_local_popup_description"
                android:layout_below="@+id/deviceToggle"
                style="@style/MusicSourceToggleDescription"/>
        </RelativeLayout>
        <ImageView
            android:id="@+id/deviceToggleImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_cloud_off"
            android:layout_centerVertical="true"
            android:paddingEnd="@dimen/source_toggle_dialog_item_padding"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</LinearLayout>
