<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@+id/upsell_badge"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.amazon.music.views.library.views.DescriptiveHeaderContainer
            android:id="@+id/header_container"
            android:layout_width="@dimen/spacer_24"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toStartOf="@+id/primary_text_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.amazon.music.views.library.views.DescriptivePrimaryTextContainer
            android:id="@+id/primary_text_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/secondary_text1_lg"
            app:layout_constraintStart_toEndOf="@+id/header_container"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/secondary_text1_lg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:layout_constraintEnd_toStartOf="@+id/secondary_text2_lg"
            app:layout_constraintStart_toEndOf="@+id/primary_text_container"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/secondary_text2_lg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:layout_constraintEnd_toStartOf="@+id/descriptive_date_container"
            app:layout_constraintStart_toEndOf="@+id/secondary_text1_lg"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.amazon.music.views.library.views.DescriptiveDateContainer
            android:id="@+id/descriptive_date_container"
            android:layout_width="@dimen/size_100"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toStartOf="@+id/time"
            app:layout_constraintStart_toEndOf="@+id/secondary_text2_lg"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/time"
            android:layout_width="@dimen/spacer_64"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:layout_constraintEnd_toStartOf="@+id/add_container"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.amazon.ui.foundations.views.BaseButton
            android:id="@+id/missing_sd_card"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/overflow_container"
            app:layout_constraintEnd_toStartOf="@+id/overflow_container"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.amazon.ui.foundations.views.BaseButton
            android:id="@+id/station_icon"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/overflow_container"
            app:layout_constraintEnd_toStartOf="@+id/overflow_container"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/add_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toStartOf="@+id/overflow_container"
            app:layout_constraintTop_toTopOf="parent">
            <com.amazon.ui.foundations.views.BaseButton
                android:id="@+id/add_icon"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <com.amazon.ui.foundations.views.BaseButton
                android:id="@+id/add_complete_icon"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/download_button_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/primary_text_container"
            app:layout_constraintEnd_toStartOf="@+id/overflow_container"
            app:layout_constraintTop_toTopOf="parent">
            <com.amazon.ui.foundations.views.BaseButton
                android:id="@+id/download_button_icon"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <com.amazon.ui.foundations.views.BaseButton
                android:id="@+id/download_button_complete_icon"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/overflow_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.amazon.ui.foundations.views.BaseButton
                android:id="@+id/overflow_icon"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/action_bar_overflow_open"
                android:contentDescription="@string/content_description_overflow_button"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/upsell_badge"
        android:background="@drawable/ripple_background_no_mask"
        android:focusable="false"
        android:visibility="gone"
        android:layout_width="@dimen/horizontal_tile_music_unlimited_logo_width"
        android:layout_height="@dimen/horizontal_tile_music_unlimited_logo_height"
        android:src="@drawable/ic__logo_upsell"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/content_view"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
