<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/audio_stats_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/nerd_stats_toolbar_layout"
        layout="@layout/nerd_stats_toolbar"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/nerd_stats_toolbar_layout">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="top"
                android:orientation="vertical"
                android:id="@+id/nerd_stats_audio_info_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacer_medium"
                android:layout_marginStart="@dimen/spacer_large"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <TextView
                        android:textSize="@dimen/text_h3"
                        android:textColor="@color/primary"
                        android:layout_gravity="top"
                        android:id="@+id/nerd_stats_steam_quality_header"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dmusic_nerd_stats_audio_quality"
                        android:textAllCaps="true"
                        android:fontFamily="@font/ember_display_condensed_heavy"/>
                    <TextView
                        android:textSize="@dimen/text_h3"
                        android:textColor="@color/bauhaus_hd"
                        android:layout_gravity="top"
                        android:id="@+id/nerd_stats_steam_quality_header_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dmusic_nerd_stats_hd_quality"
                        android:textAllCaps="true"
                        android:fontFamily="@font/ember_display_condensed_heavy"
                        android:layout_marginStart="@dimen/spacer_10"/>
                </LinearLayout>
                <TextView
                    android:textSize="@dimen/text_size_bauhaus_t1"
                    android:textColor="@color/primary"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/nerd_stats_steam_quality_header_info"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacer_medium"
                    android:maxLines="3"
                    android:drawablePadding="@dimen/spacer_15"
                    android:fontFamily="@font/ember_regular"
                    android:layout_marginEnd="@dimen/spacer_15"
                    app:drawableStartCompat="@drawable/ic_error_inline"/>
                <TextView
                    android:textSize="@dimen/text_size_bauhaus_t1"
                    android:textColor="@color/primary"
                    android:gravity="center_vertical"
                    android:id="@+id/nerd_stats_loudness_message"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacer_medium"
                    android:text="@string/dmusic_nerd_stats_loudness_message"
                    android:drawablePadding="@dimen/spacer_15"
                    android:fontFamily="@font/ember_regular"
                    android:layout_marginEnd="@dimen/spacer_15"
                    app:drawableEndCompat="@drawable/ic_chevron_caretright"
                    app:drawableStartCompat="@drawable/ic_error_inline"/>
            </LinearLayout>
            <FrameLayout
                android:id="@+id/signal_flow_container"
                android:layout_width="match_parent"
                android:layout_height="@dimen/nerd_stats_signal_flow_xs_height"
                android:layout_marginTop="@dimen/spacer_large"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/nerd_stats_audio_info_view">
                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/nerd_stats_signal_flow_pager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>
            </FrameLayout>
            <RadioGroup
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:id="@+id/nerd_stats_toggle_group"
                android:background="@drawable/button_background_selector_glass"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/nerd_stats_toggle_button_size"
                android:layout_marginTop="@dimen/spacer_large"
                android:layout_marginBottom="@dimen/spacer_base"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/signal_flow_container">
                <RadioButton
                    android:textSize="@dimen/nerd_stats_text_message_size"
                    android:gravity="center"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/atmos_toggle"
                    android:background="@drawable/radio_button_background_selector"
                    android:layout_width="@dimen/size_100"
                    android:layout_height="@dimen/nerd_stats_toggle_button_size"
                    android:button="@android:color/transparent"
                    android:text="@string/dmusic_nerd_stats_atmos_quality"
                    android:textAllCaps="true"
                    android:fontFamily="@font/amazon_ember_display_bold"/>
                <RadioButton
                    android:textSize="@dimen/nerd_stats_text_message_size"
                    android:gravity="center"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/hd_toggle"
                    android:background="@drawable/radio_button_background_selector"
                    android:layout_width="@dimen/size_100"
                    android:layout_height="@dimen/nerd_stats_toggle_button_size"
                    android:button="@android:color/transparent"
                    android:text="@string/dmusic_nerd_stats_hd_quality"
                    android:textAllCaps="true"
                    android:fontFamily="@font/amazon_ember_display_bold"/>
            </RadioGroup>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <ProgressBar
        android:id="@+id/nerd_stats_progress_bar"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
