<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/podcast_ribbon_notification"
    android:layout_width="match_parent"
    android:layout_height="@dimen/podcast_ribbon_notification_height"
    android:layout_margin="@dimen/podcast_spacer_small">
    <ImageView
        android:background="@drawable/podcast_ribbon_notification_background_layer1"
        android:layout_width="match_parent"
        android:layout_height="@dimen/podcast_ribbon_notification_height"/>
    <ImageView
        android:id="@+id/podcast_ribbon_notification_background_layer2"
        android:background="@drawable/podcast_ribbon_notification_background_layer2"
        android:layout_width="match_parent"
        android:layout_height="@dimen/podcast_ribbon_notification_height"/>
    <ImageButton
        android:id="@+id/podcast_ribbon_notification_close_button"
        android:background="@color/transparent"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_action_cancel_inline"
        android:scaleType="fitCenter"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/podcast_spacer_small"
        android:layout_alignParentStart="true"/>
    <com.amazon.podcast.views.EmberTextView
        android:textColor="@color/primary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/podcast_ribbon_notification_message"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:maxLines="2"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="@dimen/podcast_spacer_base"
        android:layout_marginEnd="@dimen/podcast_spacer_base"
        style="@style/PodcastAppTheme.TextView.Secondary"/>
    <ImageView
        android:id="@+id/podcast_ribbon_notification_forward_button"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:src="@drawable/ic_chevron_right"
        android:layout_marginEnd="@dimen/podcast_spacer_small"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
