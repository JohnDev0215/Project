<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/eux_side_margin"
        android:layout_marginRight="@dimen/eux_side_margin">
        <ImageView
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/eux_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eux_image_top_margin"
            android:layout_marginBottom="@dimen/eux_image_margin"
            android:src="@drawable/eux_headphones_andante_blue"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="@dimen/eux_text_size_large"
            android:gravity="center_horizontal"
            android:id="@+id/eux_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HEADER"
            android:layout_below="@+id/eux_image"
            style="@style/TextStyle"/>
        <TextView
            android:textSize="@dimen/eux_text_size_small"
            android:gravity="center_horizontal"
            android:id="@+id/eux_subtext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eux_text_margin"
            android:text="subtext"
            android:layout_below="@+id/eux_header"
            style="@style/TextStyle"/>
        <TextView
            android:textSize="@dimen/eux_text_size_medium"
            android:gravity="center"
            android:id="@+id/eux_button"
            android:background="@drawable/rounded_button"
            android:paddingLeft="@dimen/eux_button_margin"
            android:paddingRight="@dimen/eux_button_margin"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/eux_button_height"
            android:layout_marginTop="@dimen/eux_button_margin"
            android:layout_marginBottom="@dimen/eux_button_bottom_margin"
            android:text="Click here"
            android:layout_below="@+id/eux_subtext"
            android:layout_centerHorizontal="true"
            style="@style/TextStyle"/>
    </RelativeLayout>
</ScrollView>
