<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/automotive_legal_text_size"
        android:id="@+id/disclaimer_text"
        android:layout_width="@dimen/spacing_0dp"
        android:layout_height="wrap_content"
        android:text="@string/dmusic_automotive_disclaimer_text"
        android:maxLines="3"
        android:fontFamily="@font/amazon_ember"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/automotive_legal_text_size"
        android:textColor="@color/prime_blue"
        android:id="@+id/conditions_of_use"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacer_16"
        android:text="@string/dmusic_automotive_conditions_of_use"
        android:fontFamily="@font/amazon_ember"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/disclaimer_text"/>
    <TextView
        android:textSize="@dimen/automotive_legal_text_size"
        android:textColor="@color/prime_blue"
        android:id="@+id/privacy_notice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacer_16"
        android:text="@string/dmusic_automotive_privacy"
        android:fontFamily="@font/amazon_ember"
        app:layout_constraintEnd_toEndOf="@+id/disclaimer_text"
        app:layout_constraintStart_toEndOf="@+id/conditions_of_use"
        app:layout_constraintTop_toBottomOf="@+id/disclaimer_text"/>
    <TextView
        android:textSize="@dimen/automotive_settings_subscription_text_size"
        android:textStyle="bold"
        android:gravity="bottom"
        android:id="@+id/safety_note_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/dmusic_automotive_legal_safety_note_title"
        android:fontFamily="@font/amazon_ember_bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/conditions_of_use"/>
    <TextView
        android:textSize="@dimen/automotive_settings_subscription_text_size"
        android:gravity="top"
        android:id="@+id/safety_note"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dmusic_automotive_legal_safety_note"
        android:fontFamily="@font/amazon_ember"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/safety_note_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
