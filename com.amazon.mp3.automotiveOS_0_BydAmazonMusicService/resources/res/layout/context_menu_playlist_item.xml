<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/background"
        android:background="@drawable/descriptive_shoveler_focused_tile_background"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/playlist_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/bauhaus_spacer_micro"
        android:src="@drawable/playlist_placeholder"
        android:adjustViewBounds="true"
        android:maxWidth="@dimen/default_listview_art_size"
        android:maxHeight="@dimen/default_listview_art_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/bauhaus_typography_t1_touch"
        android:textColor="@color/pure_white"
        android:ellipsize="end"
        android:id="@+id/playlist_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/bauhaus_spacer_mini"
        android:layout_marginRight="@dimen/bauhaus_spacer_mini"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_weight="1"
        android:layout_marginHorizontal="@dimen/bauhaus_spacer_mini"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/playlist_image"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/playlist_image"
        app:layout_constraintTop_toTopOf="@+id/playlist_image"/>
</androidx.constraintlayout.widget.ConstraintLayout>
