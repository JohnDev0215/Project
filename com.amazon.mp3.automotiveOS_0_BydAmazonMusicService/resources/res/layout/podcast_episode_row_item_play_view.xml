<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/podcast_episode_row_item_play_button"
        android:background="@drawable/episode_row_item_play_button_background"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="@dimen/podcast_icon_button_tiny"
        android:layout_height="@dimen/podcast_icon_button_tiny"
        android:scaleType="centerInside"
        android:adjustViewBounds="true"
        android:layout_centerInParent="true"
        app:layout_constraintBottom_toBottomOf="@+id/podcast_episode_row_item_circular_progress_bar"
        app:layout_constraintEnd_toEndOf="@+id/podcast_episode_row_item_circular_progress_bar"
        app:layout_constraintStart_toStartOf="@+id/podcast_episode_row_item_circular_progress_bar"
        app:layout_constraintTop_toTopOf="@+id/podcast_episode_row_item_circular_progress_bar"/>
    <ProgressBar
        android:id="@+id/podcast_episode_row_item_circular_progress_bar"
        android:background="@drawable/circular_progressbar_background"
        android:visibility="invisible"
        android:layout_width="@dimen/podcast_episode_row_item_circular_progress_bar_dimension"
        android:layout_height="@dimen/podcast_episode_row_item_circular_progress_bar_dimension"
        android:indeterminate="false"
        android:progressDrawable="@drawable/episode_row_item_circular_progress_bar"
        android:layout_centerInParent="true"
        android:importantForAccessibility="no"
        android:layout_marginStart="@dimen/podcast_spacer_mini"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="?android:attr/progressBarStyleHorizontal"/>
    <com.amazon.podcast.views.EmberTextView
        android:layout_gravity="center_vertical"
        android:id="@+id/podcast_episode_row_item_remaining_duration"
        android:focusable="false"
        android:visibility="invisible"
        android:layout_width="@dimen/podcast_episode_row_item_remaining_duration_width"
        android:layout_height="wrap_content"
        android:text="Remaining duration"
        android:maxLines="2"
        android:importantForAccessibility="no"
        android:layout_marginStart="@dimen/podcast_spacer_mini"
        app:layout_constraintBottom_toBottomOf="@+id/podcast_episode_row_item_circular_progress_bar"
        app:layout_constraintStart_toEndOf="@+id/podcast_episode_row_item_circular_progress_bar"
        app:layout_constraintTop_toTopOf="@+id/podcast_episode_row_item_circular_progress_bar"
        style="@style/PodcastAppTheme.TextView.TertiaryItalic"/>
</androidx.constraintlayout.widget.ConstraintLayout>
