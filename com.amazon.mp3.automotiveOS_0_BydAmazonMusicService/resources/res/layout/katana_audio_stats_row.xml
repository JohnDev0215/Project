<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_12dp">
    <TextView
        android:textAppearance="@style/NerdStatsDialogPropertyText"
        android:id="@+id/current_property_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textAppearance="@style/NerdStatsDialogPropertyText"
        android:gravity="end"
        android:id="@+id/current_property_value"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@+id/current_property_title"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
