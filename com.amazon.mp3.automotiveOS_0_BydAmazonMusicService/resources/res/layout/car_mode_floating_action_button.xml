<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.amazon.mp3.auto.carmode.DraggableFloatingActionButton
        android:layout_gravity="end|bottom"
        android:id="@+id/home_ic_car_mode_fab"
        android:visibility="visible"
        android:layout_width="@dimen/fab_btn_width"
        android:layout_height="@dimen/fab_btn_height"
        android:layout_marginBottom="150dp"
        android:src="@drawable/ic_car"
        android:scaleType="fitXY"
        android:layout_marginEnd="@dimen/spacer_base"
        android:backgroundTint="@color/bauhaus_accent"
        app:fabCustomSize="@dimen/fab_btn_width"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
