<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/horizontal_tile_view"
    android:paddingTop="@dimen/podcast_spacer_small"
    android:paddingBottom="@dimen/podcast_spacer_small"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="@drawable/ripple"
    android:paddingStart="@dimen/margin"
    android:paddingEnd="@dimen/margin">
    <com.amazon.podcast.views.EmberTextView
        android:gravity="center"
        android:id="@+id/podcast_row_item_index"
        android:layout_width="@dimen/podcast_spacer_large"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_alignTop="@+id/image_view"
        android:layout_alignBottom="@+id/image_view"
        android:layout_marginStart="@dimen/gutter"
        android:autoSizeTextType="uniform"
        android:autoSizeStepGranularity="2sp"
        android:autoSizeMinTextSize="@dimen/podcast_text_size_t2"
        android:autoSizeMaxTextSize="@dimen/podcast_text_size_t1"
        app:layout_constraintBottom_toBottomOf="@+id/image_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/image_view"
        style="@style/PodcastAppTheme.TextView.Index"/>
    <ImageView
        android:id="@+id/image_view"
        android:layout_width="@dimen/podcast_horizontal_row_item_image_dimension"
        android:layout_height="@dimen/podcast_horizontal_row_item_image_dimension"
        android:layout_marginStart="@dimen/podcast_spacer_mini"
        app:layout_constraintStart_toEndOf="@+id/podcast_row_item_index"/>
    <LinearLayout
        android:id="@+id/podcast_horizontal_row_item_follow_button_container"
        android:padding="@dimen/podcast_horizontal_item_follow_button_padding"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/podcast_spacer_mini"
        android:layout_marginEnd="@dimen/gutter"
        app:layout_constraintBottom_toBottomOf="@+id/text_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/text_container"
        app:layout_constraintTop_toTopOf="@+id/text_container">
        <ImageView
            android:id="@+id/podcast_row_item_follow_button"
            android:layout_width="@dimen/podcast_spacer_medium"
            android:layout_height="@dimen/podcast_spacer_medium"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/text_container"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="@dimen/podcast_spacer_base"
        app:layout_constraintBottom_toBottomOf="@+id/image_view"
        app:layout_constraintEnd_toStartOf="@+id/podcast_horizontal_row_item_follow_button_container"
        app:layout_constraintStart_toEndOf="@+id/image_view"
        app:layout_constraintTop_toTopOf="@+id/image_view">
        <com.amazon.podcast.views.EmberTextView
            android:gravity="start|center_vertical"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            style="@style/PodcastAppTheme.TextView.Primary"/>
        <com.amazon.podcast.views.EmberTextView
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/podcast_spacer_nano"
            android:maxLines="1"
            style="@style/PodcastAppTheme.TextView.Secondary"/>
        <com.amazon.podcast.views.EmberTextView
            android:textStyle="italic"
            android:id="@+id/podcast_row_item_tertiary_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/podcast_spacer_nano"
            android:maxLines="1"
            style="@style/PodcastAppTheme.TextView.Tertiary"/>
        <com.amazon.podcast.views.horizontalRowItemsListView.HorizontalRowItemBadge
            android:textSize="@dimen/podcast_text_size_t4"
            android:textColor="@color/secondary"
            android:gravity="center"
            android:id="@+id/podcast_horizontal_row_item_badge"
            android:background="@drawable/redhood_plus_regular_badge_background"
            android:paddingLeft="@dimen/podcast_spacer_micro"
            android:paddingTop="@dimen/podcast_spacer_nano"
            android:paddingRight="@dimen/podcast_spacer_micro"
            android:paddingBottom="@dimen/podcast_spacer_nano"
            android:visibility="gone"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/podcast_spacer_micro"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:maxLines="1"
            android:textAllCaps="true"
            android:paddingHorizontal="@dimen/podcast_spacer_micro"
            android:paddingVertical="@dimen/podcast_spacer_nano"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
