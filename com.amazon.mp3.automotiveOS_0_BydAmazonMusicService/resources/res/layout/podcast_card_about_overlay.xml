<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    app:cardBackgroundColor="@color/transparent"
    app:cardCornerRadius="@dimen/podcast_corner_radius_large"
    app:cardElevation="0dp"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <ImageView
        android:background="@drawable/card_about_background_gradient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:layout_centerVertical="true"/>
    <RelativeLayout
        android:orientation="horizontal"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/podcast_spacer_large"
        android:layout_marginBottom="@dimen/podcast_card_play_controller_height"
        android:layout_marginStart="@dimen/podcast_spacer_medium"
        android:layout_marginEnd="@dimen/podcast_spacer_medium">
        <RelativeLayout
            android:id="@+id/podcast_card_about_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageButton
                android:id="@+id/podcast_card_now_playing_about_view_dismiss_button"
                android:background="@color/transparent"
                android:layout_width="@dimen/podcast_icon_button_tiny"
                android:layout_height="@dimen/podcast_icon_button_tiny"
                android:src="@drawable/ic_chevron_caretdown"
                android:scaleType="centerInside"
                android:layout_centerVertical="true"
                android:contentDescription="@string/podcast_card_now_playing_about_view_dismiss_button"/>
            <com.amazon.podcast.views.EmberTextView
                android:id="@+id/podcast_card_now_playing_about_view_title_label"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pocast_card_now_playing_about_the_episode"
                android:layout_centerInParent="true"
                android:contentDescription="@string/podcast_card_now_playing_about_view_title_label"
                android:importantForAccessibility="yes"
                style="@style/PodcastAppTheme.TextView.Headline4"/>
        </RelativeLayout>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/podcast_spacer_small"
            android:layout_below="@+id/podcast_card_about_header"
            android:layout_centerVertical="true">
            <com.amazon.podcast.views.EmberTextView
                android:textColor="@color/white"
                android:id="@+id/podcast_card_now_playing_about_view_description"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/podcast_card_now_playing_about_view_description"
                android:importantForAccessibility="yes"
                style="@style/PodcastAppTheme.TextView.Primary"/>
        </ScrollView>
    </RelativeLayout>
</androidx.cardview.widget.CardView>
