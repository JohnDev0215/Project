<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/bauhaus_spacer_medium"
    android:paddingEnd="@dimen/bauhaus_spacer_medium">
    <TextView
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:id="@+id/message_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/bauhaus_spacer_base"
        style="@style/Headline4Text"/>
    <TextView
        android:textColor="@color/primary"
        android:id="@+id/message_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/amazon_ember_regular"
        android:textAlignment="center"
        style="@style/AppTheme.TextAppearance.T1"/>
</LinearLayout>
