<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/AlbumArtworkFrame"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/screen_margin"
    android:layout_centerVertical="true">
    <com.amazon.ui.foundations.views.BaseImage
        android:layout_gravity="center_vertical"
        android:id="@+id/AlbumArtwork"
        android:layout_width="@dimen/default_listview_art_size"
        android:layout_height="@dimen/default_listview_art_size"
        android:src="@drawable/album_placeholder"/>
    <View
        android:id="@+id/AlbumArtTouchOverlay"
        android:background="@drawable/selector_artwork_mask"
        android:layout_width="@dimen/default_listview_art_size"
        android:layout_height="@dimen/default_listview_art_size"/>
    <ImageView
        android:id="@+id/DimAlbumArtOverlay"
        android:background="@color/dimmed"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/PlaystateIcon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:src="@drawable/mp3_icon_songplaying_paused"/>
    <TextView
        android:layout_gravity="center_vertical"
        android:id="@+id/TrackCount"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:paddingEnd="@dimen/standard_padding"
        style="@style/LibraryListItemPrimaryTextDim"/>
</FrameLayout>
