<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/custom_scrollbar"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guidelineRightEndForTrack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="@dimen/constraint_guide_end_for_scroll_bar_track"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guidelineRightEndForThumb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="@dimen/constraint_guide_end_for_scroll_bar_thumb"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guidelineTop25"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.25"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guidelineBottom25"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.75"/>
    <View
        android:id="@+id/scrollTrack"
        android:background="@drawable/scrollbar_vertical_track"
        android:layout_width="@dimen/swipeable_pages_scroll_track_width"
        android:layout_height="@dimen/swipeable_pages_scroll_track_height"
        app:layout_constraintBottom_toTopOf="@+id/guidelineBottom25"
        app:layout_constraintEnd_toStartOf="@+id/guidelineRightEndForTrack"
        app:layout_constraintTop_toTopOf="@+id/guidelineTop25"/>
    <View
        android:id="@+id/scrollThumb"
        android:background="@drawable/scrollbar_vertical_thumb"
        android:layout_width="@dimen/swipeable_pages_scroll_thumb_width"
        android:layout_height="@dimen/swipeable_pages_scroll_thumb_height"
        app:layout_constraintBottom_toTopOf="@+id/guidelineBottom25"
        app:layout_constraintRight_toLeftOf="@+id/guidelineRightEndForThumb"
        app:layout_constraintTop_toTopOf="@+id/scrollTrack"/>
    <TextView
        android:textSize="@dimen/swipeable_pages_scroll_bar_page_label_size"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:id="@+id/scrollBarPageLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/swipeable_pages_scroll_bar_page_label_margin_right"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toBottomOf="@+id/scrollThumb"
        app:layout_constraintRight_toLeftOf="@+id/scrollThumb"
        app:layout_constraintTop_toTopOf="@+id/scrollThumb"/>
</androidx.constraintlayout.widget.ConstraintLayout>
