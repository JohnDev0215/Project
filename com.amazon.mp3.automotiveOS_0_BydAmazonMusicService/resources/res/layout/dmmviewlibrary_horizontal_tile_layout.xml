<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/rankMovementUp"
        android:focusable="false"
        android:visibility="gone"
        android:layout_width="@dimen/spacing_12"
        android:layout_height="@dimen/spacing_12"
        android:layout_marginLeft="@dimen/spacer_6"
        android:layout_marginBottom="@dimen/spacing_24"
        android:src="@drawable/ic_rank_movement_up"
        app:layout_constraintBottom_toBottomOf="@+id/number_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/artwork_frame_view"/>
    <TextView
        android:gravity="center_horizontal"
        android:id="@+id/number_text"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/artwork_frame_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/artwork_frame_view"/>
    <ImageView
        android:id="@+id/rankMovementDown"
        android:focusable="false"
        android:visibility="gone"
        android:layout_width="@dimen/spacing_12"
        android:layout_height="@dimen/spacing_12"
        android:layout_marginLeft="@dimen/spacer_6"
        android:layout_marginTop="@dimen/spacing_24"
        android:src="@drawable/ic_rank_movement_down"
        app:layout_constraintBottom_toBottomOf="@+id/artwork_frame_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/number_text"/>
    <com.amazon.music.views.library.views.ArtworkFrameView
        android:id="@+id/artwork_frame_view"
        android:layout_width="@dimen/artwork_default_dimen"
        android:layout_height="@dimen/artwork_default_dimen"
        app:layout_constraintStart_toEndOf="@+id/number_text"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.amazon.ui.foundations.views.BaseButton
        android:id="@+id/navigation_icon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/artwork_frame_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/artwork_frame_view"/>
    <com.amazon.ui.foundations.views.BaseButton
        android:id="@+id/right_icon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/action_bar_overflow_open"
        android:contentDescription="@string/content_description_overflow_button"
        app:layout_constraintBottom_toBottomOf="@+id/text_container"
        app:layout_constraintEnd_toStartOf="@+id/navigation_icon"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/add_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/text_container"
        app:layout_constraintEnd_toStartOf="@+id/right_icon"
        app:layout_constraintTop_toTopOf="parent">
        <com.amazon.ui.foundations.views.BaseButton
            android:id="@+id/add_icon"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/content_description_add_song_to_library_button"/>
        <com.amazon.ui.foundations.views.BaseButton
            android:id="@+id/add_complete_icon"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0"/>
        <com.amazon.ui.foundations.views.BaseButton
            android:id="@+id/left_icon"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <ImageView
        android:id="@+id/upsell_badge"
        android:background="@drawable/ripple_background_no_mask"
        android:focusable="false"
        android:visibility="gone"
        android:layout_width="@dimen/horizontal_tile_music_unlimited_logo_width"
        android:layout_height="@dimen/horizontal_tile_music_unlimited_logo_height"
        android:src="@drawable/ic__logo_upsell"
        app:layout_constraintBottom_toBottomOf="@+id/artwork_frame_view"
        app:layout_constraintEnd_toStartOf="@+id/add_container"
        app:layout_constraintTop_toTopOf="@+id/artwork_frame_view"/>
    <com.amazon.music.views.library.views.HotSpotPulse
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/hotspot_pulse"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="@dimen/spacer_24"
        android:layout_height="@dimen/spacer_24"
        app:layout_constraintBottom_toBottomOf="@+id/text_container"
        app:layout_constraintEnd_toStartOf="@+id/add_container"
        app:layout_constraintStart_toEndOf="@+id/text_container"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/text_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@+id/upsell_badge"
        app:layout_constraintStart_toEndOf="@+id/artwork_frame_view"
        app:layout_constraintTop_toTopOf="@+id/artwork_frame_view">
        <TextView
            android:ellipsize="end"
            android:id="@+id/label"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
        <TextView
            android:ellipsize="end"
            android:id="@+id/labels"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:layout_constraintBottom_toTopOf="@+id/title_container"
            app:layout_constraintTop_toTopOf="@+id/parent"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/title_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:ellipsize="end"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <TextView
                android:id="@+id/duration_text"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <TextView
            android:ellipsize="end"
            android:id="@+id/subtitle"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
        <TextView
            android:ellipsize="end"
            android:id="@+id/recommendation_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/badge_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@+id/text_container"
        app:layout_constraintTop_toBottomOf="@+id/text_container">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/lop_badge_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.amazon.ui.foundations.views.BaseButton
            android:id="@+id/audio_quality_badge"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.amazon.ui.foundations.views.BaseButton
            android:id="@+id/immersive_badge"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.amazon.ui.foundations.views.BaseButton
            android:id="@+id/immersive_album_extra_badge"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.amazon.ui.foundations.views.BaseButton
            android:id="@+id/branding_icon"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
