<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="@dimen/podcast_spacer_micro"
    android:focusable="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/podcast_spacer_small"
    android:layout_marginBottom="@dimen/podcast_spacer_micro"
    android:importantForAccessibility="no"
    android:layout_marginStart="@dimen/gutter_and_margin"
    android:layout_marginEnd="@dimen/gutter_and_margin"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <ImageView
        android:id="@+id/podcast_episode_row_item_image"
        android:focusable="false"
        android:layout_width="@dimen/podcast_visual_row_item_image_dimension"
        android:layout_height="@dimen/podcast_visual_row_item_image_dimension"
        android:src="@drawable/podcast_episode_row_item_artwork_overlay_rounded_corner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/podcast_episode_row_item_image_overlay"
        android:focusable="false"
        android:visibility="invisible"
        android:layout_width="@dimen/podcast_visual_row_item_image_dimension"
        android:layout_height="@dimen/podcast_visual_row_item_image_dimension"
        android:src="@drawable/podcast_episode_row_item_artwork_overlay_rounded_corner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/podcast_episode_row_item_completed_indicator"
        android:focusable="false"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/podcast_spacer_micro"
        android:src="@drawable/ic_action_doneinline"
        android:layout_marginStart="@dimen/podcast_spacer_micro"
        android:layout_marginEnd="@dimen/gutter"
        app:layout_constraintBottom_toBottomOf="@+id/podcast_episode_row_item_image"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/podcast_episode_row_item_image_equalizer"
        android:focusable="false"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/podcast_transcript_equalizer_primary"
        android:scaleType="center"
        app:layout_constraintBottom_toBottomOf="@+id/podcast_episode_row_item_image"
        app:layout_constraintEnd_toEndOf="@+id/podcast_episode_row_item_image"
        app:layout_constraintStart_toStartOf="@+id/podcast_episode_row_item_image"
        app:layout_constraintTop_toTopOf="@+id/podcast_episode_row_item_image"/>
    <ImageView
        android:id="@+id/refresh_podcast_episode_row_item_image_equalizer"
        android:focusable="false"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/refresh_podcast_transcript_equalizer_primary"
        android:scaleType="center"
        app:layout_constraintBottom_toBottomOf="@+id/podcast_episode_row_item_image"
        app:layout_constraintEnd_toEndOf="@+id/podcast_episode_row_item_image"
        app:layout_constraintStart_toStartOf="@+id/podcast_episode_row_item_image"
        app:layout_constraintTop_toTopOf="@+id/podcast_episode_row_item_image"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:id="@+id/podcast_episode_row_item_text_view"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/podcast_spacer_base"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/podcast_episode_row_item_image"
        app:layout_constraintTop_toTopOf="parent">
        <com.amazon.podcast.views.EmberTextView
            android:id="@+id/podcast_episode_row_item_publish_date_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/PodcastAppTheme.TextView.Label"/>
        <com.amazon.podcast.views.EmberTextView
            android:ellipsize="end"
            android:id="@+id/podcast_episode_row_item_primary_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/podcast_spacer_nano"
            android:maxLines="2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/podcast_episode_row_item_publish_date_label"
            style="@style/PodcastAppTheme.TextView.Primary"/>
        <com.amazon.podcast.views.EmberTextView
            android:ellipsize="end"
            android:id="@+id/podcast_episode_row_item_secondary_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/podcast_spacer_nano"
            android:maxLines="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/podcast_episode_row_item_primary_text"
            style="@style/PodcastAppTheme.TextView.Secondary"/>
        <com.amazon.podcast.views.EmberTextView
            android:textColor="@color/primary_glass_5"
            android:ellipsize="end"
            android:id="@+id/podcast_episode_row_item_description"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/podcast_spacer_milli"
            android:maxLines="2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/podcast_episode_row_item_secondary_text"
            style="@style/PodcastAppTheme.TextView.Secondary"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.amazon.podcast.views.episodeRowItemsListView.PlayView
        android:id="@+id/podcast_episode_row_item_play_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/podcast_spacer_micro"
        android:importantForAccessibility="no"
        android:layout_marginStart="@dimen/podcast_spacer_mini"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/podcast_episode_row_item_image"
        app:layout_constraintTop_toBottomOf="@+id/podcast_episode_row_item_description_badge"/>
    <com.amazon.podcast.views.episodeRowItemsListView.DownloadView
        android:id="@+id/podcast_episode_row_item_download_view"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="@dimen/podcast_icon_button_small"
        android:layout_height="@dimen/podcast_icon_button_small"
        android:layout_marginTop="@dimen/podcast_spacer_micro"
        android:layout_marginStart="@dimen/podcast_spacer_mini"
        app:layout_constraintEnd_toStartOf="@+id/podcast_episode_row_item_context_menu"
        app:layout_constraintTop_toBottomOf="@+id/podcast_episode_row_item_description_badge"/>
    <ImageButton
        android:id="@+id/podcast_episode_row_item_context_menu"
        android:background="@color/transparent"
        android:layout_width="@dimen/podcast_icon_button_small"
        android:layout_height="@dimen/podcast_icon_button_small"
        android:layout_marginTop="@dimen/podcast_spacer_micro"
        android:src="@drawable/ic_action_more"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/podcast_episode_row_item_description_badge"/>
    <com.amazon.podcast.views.episodeRowItemsListView.EpisodeRowItemImageBadge
        android:gravity="center"
        android:id="@+id/podcast_episode_row_item_image_badge"
        android:paddingLeft="@dimen/podcast_spacer_nano"
        android:paddingTop="@dimen/podcast_spacer_nano"
        android:paddingRight="@dimen/podcast_spacer_nano"
        android:paddingBottom="@dimen/podcast_spacer_nano"
        android:visibility="gone"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/podcast_spacer_micro"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:maxLines="2"
        android:paddingHorizontal="@dimen/podcast_spacer_nano"
        android:paddingVertical="@dimen/podcast_spacer_nano"
        app:layout_constraintEnd_toEndOf="@+id/podcast_episode_row_item_image"
        app:layout_constraintStart_toStartOf="@+id/podcast_episode_row_item_image"
        app:layout_constraintTop_toBottomOf="@+id/podcast_episode_row_item_image"
        style="@style/PodcastAppTheme.TextView.ImageBadge"/>
    <com.amazon.podcast.views.episodeRowItemsListView.EpisodeRowItemDescriptionBadge
        android:textSize="@dimen/podcast_text_size_t4"
        android:textStyle="bold"
        android:textColor="@color/primary_glass_5"
        android:gravity="center"
        android:id="@+id/podcast_episode_row_item_description_badge"
        android:background="@drawable/redhood_plus_bordered_badge_background"
        android:paddingLeft="@dimen/podcast_spacer_micro"
        android:paddingTop="@dimen/podcast_spacer_nano"
        android:paddingRight="@dimen/podcast_spacer_micro"
        android:paddingBottom="@dimen/podcast_spacer_nano"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/podcast_spacer_mini"
        android:layout_marginBottom="@dimen/podcast_spacer_nano"
        android:minWidth="16dp"
        android:minHeight="0dp"
        android:textAllCaps="true"
        android:paddingHorizontal="@dimen/podcast_spacer_micro"
        android:paddingVertical="@dimen/podcast_spacer_nano"
        app:layout_constraintStart_toStartOf="@+id/podcast_episode_row_item_text_view"
        app:layout_constraintTop_toBottomOf="@+id/podcast_episode_row_item_text_view"/>
    <com.amazon.podcast.views.SmallUpsellButton
        android:id="@+id/podcast_episode_row_item_upsell_button"
        android:paddingTop="@dimen/podcast_spacer_small"
        android:paddingBottom="@dimen/podcast_spacer_mini"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/podcast_episode_row_item_text_view"
        app:layout_constraintTop_toBottomOf="@+id/podcast_episode_row_item_text_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
