<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/selector_item_background_color"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="@dimen/library_list_view_item_height_2_lines"
    android:baselineAligned="false">
    <FrameLayout
        android:id="@+id/ArtistArtworkFrame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/screen_margin"
        style="@style/LibraryListItemAlbumArt">
        <ImageView
            android:id="@+id/ArtistArtwork"
            android:layout_width="@dimen/default_listview_art_size"
            android:layout_height="@dimen/default_listview_art_size"/>
        <View
            android:background="@drawable/selector_artwork_mask"
            android:layout_width="@dimen/default_listview_art_size"
            android:layout_height="@dimen/default_listview_art_size"/>
        <ImageView
            android:id="@+id/DimAlbumArtOverlay"
            android:background="@color/dimmed"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/PlaystateIcon"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/mp3_icon_songplaying_paused"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@+id/RightViews"
        android:layout_toEndOf="@+id/ArtistArtworkFrame">
        <TextView
            android:id="@+id/ArtistName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            style="@style/PrimaryText"/>
        <TextView
            android:id="@+id/Counts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/listview_item_secondary_text_padding_top"
            android:singleLine="true"
            style="@style/SecondaryText"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/RightViews"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_alignWithParentIfMissing="true"
        android:layout_toStartOf="@+id/overflow_button_open">
        <com.amazon.mp3.view.DownloadProgressBadgeView
            android:id="@+id/DownloadProgress"
            android:visibility="gone"
            android:layout_width="@dimen/download_circular_progress_bar_width"
            android:layout_height="@dimen/download_circular_progress_bar_width"
            android:layout_margin="@dimen/standard_padding"
            android:layout_marginEnd="@dimen/listview_horizontal_padding"/>
        <ImageButton
            android:id="@+id/AddAllButton"
            android:background="@null"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tiny_padding"
            android:src="@drawable/playlist_btn_add"
            android:minWidth="@dimen/minimum_button_width"
            android:contentDescription="@string/add_all_content_description"/>
    </FrameLayout>
    <include
        android:id="@+id/overflow_button_open"
        android:layout_width="@dimen/overflow_button_clickable_size"
        android:layout_height="@dimen/overflow_button_clickable_size"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/screen_margin"
        android:layout_alignParentEnd="true"
        layout="@layout/overflow_button"/>
</RelativeLayout>
