<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/visual_row_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/index_text"
        android:layout_width="@dimen/spacer_medium"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/thumbnail_image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/thumbnail_image"
        style="@style/IndexText"/>
    <ImageView
        android:id="@+id/thumbnail_image"
        android:background="@color/color_secondary_glass_2"
        android:layout_width="@dimen/visual_row_item_thumbnail_size"
        android:layout_height="@dimen/visual_row_item_thumbnail_size"
        android:layout_marginTop="@dimen/spacer_small"
        android:layout_marginBottom="@dimen/spacer_small"
        android:tint="@drawable/thumbnail_tint_selector"
        android:layout_marginStart="@dimen/spacer_mini"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/index_text"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/primary_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:layout_marginStart="@dimen/spacer_base"
        android:layout_marginEnd="@dimen/spacer_mini"
        app:layout_constraintEnd_toStartOf="@+id/download_status_icon"
        app:layout_constraintStart_toEndOf="@+id/thumbnail_image"
        app:layout_constraintTop_toTopOf="@+id/thumbnail_image"
        style="@style/PrimaryText"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/secondary_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="@+id/thumbnail_image"
        app:layout_constraintEnd_toEndOf="@+id/primary_text"
        app:layout_constraintStart_toStartOf="@+id/primary_text"
        app:layout_constraintTop_toBottomOf="@+id/primary_text"
        style="@style/SecondaryText"/>
    <ImageView
        android:id="@+id/download_status_icon"
        android:background="@color/transparent"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="center"
        app:layout_constraintBottom_toBottomOf="@+id/thumbnail_image"
        app:layout_constraintEnd_toStartOf="@+id/add_button"
        app:layout_constraintTop_toTopOf="@+id/thumbnail_image"
        style="@style/SmallButton"/>
    <ImageView
        android:id="@+id/add_button"
        android:background="@color/transparent"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="center"
        app:layout_constraintBottom_toBottomOf="@+id/thumbnail_image"
        app:layout_constraintEnd_toStartOf="@+id/more_button"
        app:layout_constraintTop_toTopOf="@+id/thumbnail_image"
        style="@style/SmallButton"/>
    <ImageView
        android:id="@+id/more_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_action_more"
        android:scaleType="center"
        app:layout_constraintBottom_toBottomOf="@+id/thumbnail_image"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/thumbnail_image"/>
</androidx.constraintlayout.widget.ConstraintLayout>
