<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/prime_categories_section_padding"
    android:paddingEnd="@dimen/prime_categories_section_padding">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/prime_search_overlay_search_box"
        android:background="@drawable/prime_search_overlay_search_box_background"
        android:layout_width="match_parent"
        android:layout_height="@dimen/prime_search_overlay_search_box_height"
        android:layout_marginBottom="@dimen/prime_search_overlay_section_margin">
        <ImageView
            android:id="@+id/category_nav_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/search_pressed"/>
        <TextView
            android:textSize="@dimen/prime_search_overlay_search_box_font_size"
            android:textColor="@color/black"
            android:id="@+id/prime_search_overlay_search_box_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/prime_search_overlay_search_box_text"/>
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/prime_categories"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
