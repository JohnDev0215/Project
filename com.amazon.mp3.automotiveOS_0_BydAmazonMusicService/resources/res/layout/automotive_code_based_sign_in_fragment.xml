<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/left_base_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.13"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/right_base_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.91"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/top_base_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.09"/>
    <TextView
        android:textSize="@dimen/text_size_40"
        android:id="@+id/sign_in_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dmusic_automotive_sign_in_options"
        android:fontFamily="@font/amazon_ember_display_cd_heavy"
        app:layout_constraintBottom_toTopOf="@+id/top_base_line"
        app:layout_constraintStart_toStartOf="@+id/left_base_line"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5"/>
    <ImageView
        android:id="@+id/automotive_sign_in_icon"
        android:layout_width="@dimen/automotive_music_icon_size"
        android:layout_height="@dimen/automotive_music_icon_size"
        app:layout_constraintBottom_toBottomOf="@+id/sign_in_title"
        app:layout_constraintEnd_toStartOf="@+id/left_base_line"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/sign_in_title"
        app:srcCompat="@drawable/automotive_sign_in_icon"/>
    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="@dimen/spacing_0dp"
        android:layout_height="@dimen/spacing_0dp"
        android:layout_marginBottom="@dimen/spacer_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/left_base_line"
        app:layout_constraintRight_toRightOf="@+id/right_base_line"
        app:layout_constraintTop_toTopOf="@+id/top_base_line">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="@dimen/text_size_20"
                android:id="@+id/qr_code_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacer_10"
                android:text="@string/dmusic_automotive_log_in_qr_title"
                android:fontFamily="@font/amazon_ember_bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/text_size_18"
                android:id="@+id/qr_code_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dmusic_automotive_log_in_qr"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/qr_code_title"/>
            <ImageView
                android:id="@+id/qr_code_img"
                android:layout_width="@dimen/automotive_music_qr_code_size"
                android:layout_height="@dimen/automotive_music_qr_code_size"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/qr_code_content"
                app:layout_constraintTop_toTopOf="@+id/qr_code_title"/>
            <TextView
                android:textSize="@dimen/text_size_20"
                android:id="@+id/short_code_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_5dp"
                android:text="@string/dmusic_automotive_short_code_title"
                android:fontFamily="@font/amazon_ember_bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/qr_code_img"/>
            <TextView
                android:textSize="@dimen/text_size_18"
                android:id="@+id/short_code_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dmusic_automotive_short_code"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/short_code_title"/>
            <TextView
                android:textSize="@dimen/automotive_shortcode_text_size"
                android:textColor="@color/white"
                android:id="@+id/shortcode_label"
                android:background="@color/primary_glass_2"
                android:padding="@dimen/spacer_20"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_32"
                android:fontFamily="@font/amazon_ember"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/short_code_content"/>
            <TextView
                android:textSize="@dimen/text_size_20"
                android:id="@+id/sign_in_manually_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="85dp"
                android:text="@string/dmusic_automotive_sign_in_manually_title"
                android:fontFamily="@font/amazon_ember_bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/shortcode_label"/>
            <com.amazon.ui.foundations.views.BaseButton
                android:id="@+id/sign_in_manually_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_20"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sign_in_manually_title"/>
            <include
                android:id="@+id/automotive_legal_statement"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="80dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sign_in_manually_button"
                layout="@layout/automotive_legal_statement"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
