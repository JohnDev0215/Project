<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/action_bar_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.amazon.ui.foundations.views.BaseButton
        android:id="@+id/Action_Button_Back"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/Title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textAlignment="center"
        app:layout_constraintBottom_toTopOf="@+id/Subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/Subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textAlignment="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/Title"/>
    <ImageView
        android:id="@+id/Logo_Image"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/spacer_24"
        android:src="@drawable/logo_animation_00034"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/Action_Button_Back"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/feed_button"/>
    <com.amazon.mp3.actionbar.view.ActionBarRightButton
        android:id="@+id/Action_Button_Profile"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/feed_button"
        app:layout_constraintTop_toTopOf="parent"
        app:style="profile"
        style="@style/ActionBarProfileButtonStyle"/>
    <com.amazon.mp3.actionbar.view.ActionBarRightButton
        android:id="@+id/Action_Button_Overflow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:style="overflow"
        style="@style/ActionBarStoreButtonStyle"/>
    <com.amazon.ui.foundations.views.BaseButton
        android:id="@+id/filter_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/standard_padding"
        android:layout_marginBottom="@dimen/standard_padding"
        android:layout_marginEnd="@dimen/large_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.amazon.ui.foundations.views.BaseButton
        android:id="@+id/action_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:textColor="@android:color/white"
        android:layout_gravity="center_vertical"
        android:id="@+id/filter_badge"
        android:background="@drawable/blue_circle"
        android:visibility="gone"
        android:layout_width="@dimen/prime_filter_badge_size"
        android:layout_height="@dimen/prime_filter_badge_size"
        app:layout_constraintBottom_toTopOf="@+id/filter_view"
        app:layout_constraintEnd_toEndOf="@+id/filter_view"
        app:layout_constraintStart_toEndOf="@+id/filter_view"
        app:layout_constraintTop_toTopOf="@+id/filter_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
