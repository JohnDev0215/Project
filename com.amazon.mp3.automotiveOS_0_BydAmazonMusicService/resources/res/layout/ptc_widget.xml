<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingLeft="@dimen/podcast_spacer_huge"
    android:paddingRight="@dimen/podcast_spacer_huge"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/podcast_spacer_base">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/podcast_ptc_image"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ptc_ingress"
            android:scaleType="centerInside"
            android:adjustViewBounds="true"/>
        <com.amazon.podcast.views.EmberTextView
            android:gravity="center"
            android:id="@+id/podcast_ptc_primary_text"
            android:layout_width="wrap_content"
            android:text="@string/podcast_ptc_discover_podcasts"
            android:maxLines="1"
            style="@style/PodcastAppTheme.TextView.Headline4"/>
    </LinearLayout>
    <com.amazon.podcast.views.EmberTextView
        android:gravity="center_horizontal"
        android:id="@+id/podcast_ptc_secondary_text"
        android:paddingLeft="@dimen/podcast_spacer_base"
        android:paddingRight="@dimen/podcast_spacer_base"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/podcast_spacer_milli"
        android:text="@string/podcast_ptc_tell_us"
        android:maxLines="2"
        style="@style/PodcastAppTheme.TextView.Tertiary"/>
    <com.amazon.podcast.views.EmberTextView
        android:gravity="center"
        android:id="@+id/podcast_ptc_button"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/podcast_button_medium"
        android:layout_marginTop="@dimen/podcast_spacer_base"
        android:layout_marginBottom="@dimen/podcast_spacer_epic"
        android:text="@string/podcast_ptc_lets_get_started"
        android:paddingStart="@dimen/podcast_spacer_epic"
        android:paddingEnd="@dimen/podcast_spacer_epic"
        style="@style/PodcastAppTheme.TextView.ButtonMediumGlass"/>
</LinearLayout>
