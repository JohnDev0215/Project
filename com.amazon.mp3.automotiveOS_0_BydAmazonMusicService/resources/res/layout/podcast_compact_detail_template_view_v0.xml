<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/base"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/compact_detail_template_view_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:background="@drawable/color_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <ImageView
        android:background="@drawable/gradient1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <com.google.android.material.appbar.AppBarLayout
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar"
        android:id="@+id/app_bar_layout"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="enterAlwaysCollapsed|scroll"
            app:scrimAnimationDuration="0">
            <com.amazon.podcast.views.ActionBarView
                android:id="@+id/action_bar_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"/>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/app_bar_layout">
        <ScrollView
            android:id="@+id/compact_detail_template_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:id="@+id/compact_detail_template_view"
                android:background="@color/transparent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.amazon.podcast.views.compactDetailTemplate.HeaderViewV0
                    android:id="@+id/compact_detail_template_header_v0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/podcast_spacer_large"
                    android:layout_alignParentTop="true"
                    android:layout_marginStart="@dimen/gutter"
                    android:layout_marginEnd="@dimen/gutter"/>
                <View
                    android:id="@+id/compact_detail_template_divider"
                    android:background="@color/primary_glass_2"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/podcast_divider_height"
                    android:layout_below="@+id/compact_detail_template_header_v0"
                    android:layout_marginStart="@dimen/gutter"
                    android:layout_marginEnd="@dimen/gutter"/>
                <View
                    android:id="@+id/compact_detail_template_description_background"
                    android:background="@color/transparent"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentBottom="true"
                    android:alpha="0"/>
                <com.amazon.podcast.views.ExpandableTextView
                    android:id="@+id/compact_detail_template_description"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/podcast_spacer_large"
                    android:layout_below="@+id/compact_detail_template_divider"
                    android:layout_marginStart="@dimen/gutter"
                    android:layout_marginEnd="@dimen/gutter"
                    style="@style/PodcastAppTheme.TextView.AboutDescriptionText"/>
                <com.amazon.podcast.views.galleryTemplate.VisualShovelerCompactView
                    android:id="@+id/compact_detail_visual_shoveler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/compact_detail_template_description"/>
                <View
                    android:visibility="invisible"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/podcast_spacer_large"
                    android:layout_below="@+id/compact_detail_visual_shoveler"
                    android:layout_alignParentBottom="true"/>
            </RelativeLayout>
        </ScrollView>
        <com.amazon.podcast.views.RibbonNotificationView
            android:layout_gravity="bottom"
            android:id="@+id/podcast_compact_detail_template_ribbon_notification_view"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:foregroundGravity="bottom"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
