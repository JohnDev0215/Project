<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ptc_bottom_sheet_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ptc_bottom_sheet_replacement"
        android:background="@android:color/transparent"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/podcast_trailer_button_height"
        android:layout_marginTop="@dimen/podcast_spacer_mini"
        android:layout_marginBottom="@dimen/podcast_spacer_mini"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ptc_bottom_sheet_animation_layout"
        android:background="@color/podcast_overlay_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/podcast_ptc_bottom_sheet_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/podcast_spacer_large"
            android:layout_marginTop="@dimen/podcast_spacer_medium"
            android:layout_marginRight="@dimen/podcast_spacer_large"
            android:layout_marginBottom="@dimen/podcast_spacer_mini"
            android:layout_below="@+id/ptc_bottom_sheet_replacement">
            <ImageView
                android:id="@+id/podcast_ptc_bottom_sheet_image"
                android:layout_width="@dimen/ptc_bottom_sheet_image_size"
                android:layout_height="@dimen/ptc_bottom_sheet_image_size"
                android:layout_alignParentStart="true"/>
            <RelativeLayout
                android:gravity="start|center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/podcast_spacer_base"
                android:layout_marginEnd="@dimen/podcast_spacer_base"
                android:layout_toEndOf="@+id/podcast_ptc_bottom_sheet_image">
                <com.amazon.podcast.views.EmberTextView
                    android:id="@+id/podcast_ptc_bottom_sheet_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    style="@style/PodcastAppTheme.TextView.Primary"/>
                <com.amazon.podcast.views.EmberTextView
                    android:id="@+id/podcast_ptc_bottom_sheet_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_below="@+id/podcast_ptc_bottom_sheet_title"
                    style="@style/PodcastAppTheme.TextView.TertiaryItalic"/>
            </RelativeLayout>
        </RelativeLayout>
        <com.amazon.podcast.views.ptcPodcastsTemplate.PTCBottomSheetPlayView
            android:id="@+id/ptc_bottom_sheet_play_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/ptc_bottom_sheet_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.amazon.podcast.views.EmberTextView
                    android:id="@+id/podcast_ptc_bottom_sheet_description"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/podcast_spacer_large"
                    android:layout_marginRight="@dimen/podcast_spacer_large"
                    style="@style/PodcastAppTheme.TextView.AboutDescriptionText"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/podcast_ptc_bottom_sheet_category_view"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/podcast_spacer_base"
                    android:layout_marginTop="@dimen/podcast_spacer_base"
                    android:layout_marginRight="@dimen/podcast_spacer_base"
                    app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <com.amazon.podcast.views.detailTemplate.FollowButton
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/ptc_bottom_sheet_follow_button"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/podcast_spacer_epic"
            android:layout_marginLeft="@dimen/podcast_spacer_large"
            android:layout_marginTop="@dimen/podcast_spacer_mini"
            android:layout_marginRight="@dimen/podcast_spacer_large"/>
        <com.amazon.podcast.views.EmberTextView
            android:gravity="center"
            android:id="@+id/ptc_bottom_sheet_dismiss"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/podcast_playback_speed_item_height"
            android:layout_marginTop="@dimen/podcast_spacer_mini"
            android:layout_marginBottom="@dimen/podcast_spacer_mini"
            android:text="@string/podcast_dismiss_label"
            style="@style/PodcastAppTheme.TextView.Primary"/>
        <View
            android:id="@+id/ptc_pop_up_bottom_sheet_bottom_spacer"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/podcast_spacer_medium"
            android:layout_below="@+id/ptc_bottom_sheet_follow_button"/>
    </LinearLayout>
</LinearLayout>
