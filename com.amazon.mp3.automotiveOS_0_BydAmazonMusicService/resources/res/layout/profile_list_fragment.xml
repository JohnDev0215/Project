<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/profile_picker_layout"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/profile_picker_text_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/spacing_54">
            <ImageView
                android:id="@+id/profile_picker_close_button"
                android:paddingRight="@dimen/spacing_24"
                android:visibility="gone"
                android:layout_width="@dimen/spacing_48"
                android:layout_height="@dimen/spacing_48"
                android:src="@drawable/ic_action_cancel"
                android:layout_alignParentBottom="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <TextView
            android:id="@+id/profile_picker_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sample_text"
            android:textAlignment="center"/>
        <TextView
            android:id="@+id/profile_picker_sub_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/spacer_58"
            android:layout_marginTop="@dimen/spacer_8"
            android:layout_marginRight="@dimen/spacer_58"
            android:text="@string/sample_text"
            android:textAlignment="center"
            android:layout_marginHorizontal="@dimen/spacer_58"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/profile_picker_invite_link_view"
        android:layout_below="@+id/profile_picker_text_layout">
        <androidx.recyclerview.widget.RecyclerView
            android:scrollbarStyle="outsideOverlay"
            android:layout_gravity="center"
            android:id="@+id/profile_picker_gridview"
            android:paddingTop="@dimen/spacer_36"
            android:clipToPadding="false"
            android:descendantFocusability="beforeDescendants"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/spacer_16"
            android:layout_marginTop="0dp"
            android:layout_marginRight="@dimen/spacer_16"
            android:listSelector="@drawable/background_selector"
            android:horizontalSpacing="@dimen/spacer_16"
            android:verticalSpacing="@dimen/spacing_30"
            android:stretchMode="columnWidth"
            android:numColumns="@integer/grid_columns_2"
            android:layout_marginHorizontal="@dimen/spacer_16"/>
    </LinearLayout>
    <RelativeLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/profile_picker_invite_link_view"
        android:background="@color/dark_gray_blue_background_100_opacity"
        android:paddingTop="@dimen/spacer_16"
        android:paddingBottom="@dimen/spacer_16"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/spacer_16"
        android:layout_marginRight="@dimen/spacer_16"
        android:layout_marginBottom="@dimen/spacer_24"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="@dimen/spacer_16">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/spacer_16"
            android:text="@string/profile_share_button_text"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/spacer_16"
            android:src="@drawable/arrow_right_24"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</RelativeLayout>
