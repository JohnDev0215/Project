<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:amazonmp3="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true">
    <ScrollView
        android:id="@+id/list_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/card_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.amazon.mp3.card.prime.PrimeCard
                android:id="@+id/similar_playlists"
                android:layout_marginBottom="@dimen/prime_browse_card_margin_bottom"
                amazonmp3:card_layout="linear"
                amazonmp3:headerText="@string/dmusic_similar_playlists_for_you"
                style="@style/NewCardStyle"/>
            <com.amazon.mp3.card.prime.PrimeCard
                android:id="@+id/similar_albums"
                android:layout_marginBottom="@dimen/prime_browse_card_margin_bottom"
                amazonmp3:cardColumns="@integer/grid_tile_num_columns"
                amazonmp3:card_layout="grid"
                amazonmp3:cellSpace="@dimen/prime_card_horiz_padding"
                amazonmp3:headerText="@string/dmusic_similar_albums_for_you"
                style="@style/NewCardStyle"/>
            <com.amazon.mp3.card.prime.PrimeCard
                android:id="@+id/similar_songs"
                android:layout_marginBottom="@dimen/prime_browse_card_margin_bottom"
                amazonmp3:card_layout="linear"
                amazonmp3:headerText="@string/dmusic_similar_songs_for_you"
                style="@style/NewCardStyle"/>
            <com.amazon.mp3.card.Card
                android:id="@+id/similar_stations"
                android:layout_marginBottom="@dimen/prime_browse_card_margin_bottom"
                amazonmp3:cardColumns="@integer/grid_tile_num_columns"
                amazonmp3:card_layout="grid"
                amazonmp3:cellSpace="@dimen/prime_card_horiz_padding"
                amazonmp3:headerText="@string/dmusic_similar_stations_for_you"
                style="@style/NewCardStyle"/>
        </LinearLayout>
    </ScrollView>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/browse_loader_top_margin">
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/loading_spinner"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/dmmviewlibrary_progress_bar_large"/>
    </FrameLayout>
    <include
        android:layout_gravity="center"
        android:id="@+id/empty_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/browse_empty_layout_top_margin"
        layout="@layout/prime_service_error_layout"/>
</FrameLayout>
