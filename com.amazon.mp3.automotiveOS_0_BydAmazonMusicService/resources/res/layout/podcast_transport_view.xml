<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageButton
        android:layout_gravity="center_vertical"
        android:id="@+id/podcast_sleep_timer"
        android:background="@color/transparent"
        android:layout_width="@dimen/podcast_sleep_icon_dimension"
        android:layout_height="@dimen/podcast_sleep_icon_dimension"
        android:src="@drawable/ic_playback_sleeptimer"
        android:contentDescription="@string/podcast_sleep_timer_label"/>
    <com.amazon.podcast.nowplaying.TransportSpacerView
        android:layout_width="@dimen/zero_dp"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
    <ImageButton
        android:layout_gravity="center_vertical"
        android:id="@+id/podcast_rewind"
        android:background="@color/transparent"
        android:layout_width="@dimen/podcast_rewind_icon_dimension"
        android:layout_height="@dimen/podcast_rewind_icon_dimension"
        android:src="@drawable/ic_playback_rewind"/>
    <com.amazon.podcast.nowplaying.TransportSpacerView
        android:layout_width="@dimen/zero_dp"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
    <ImageButton
        android:layout_gravity="center_vertical"
        android:id="@+id/podcast_playpause"
        android:background="@drawable/button_circle"
        android:layout_width="@dimen/podcast_play_pause_icon_dimension"
        android:layout_height="@dimen/podcast_play_pause_icon_dimension"
        android:src="@drawable/ic_other_loader"/>
    <com.amazon.podcast.nowplaying.TransportSpacerView
        android:layout_width="@dimen/zero_dp"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
    <ImageButton
        android:layout_gravity="center_vertical"
        android:id="@+id/podcast_fast_forward"
        android:background="@color/transparent"
        android:layout_width="@dimen/podcast_fast_forward_icon_dimension"
        android:layout_height="@dimen/podcast_fast_forward_icon_dimension"
        android:src="@drawable/ic_playback_fast_forward"/>
    <com.amazon.podcast.nowplaying.TransportSpacerView
        android:layout_width="@dimen/zero_dp"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
    <com.amazon.podcast.views.EmberTextView
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/podcast_speed"
        android:background="@color/transparent"
        android:layout_width="@dimen/podcast_playback_speed_icon_dimension"
        android:layout_height="@dimen/podcast_playback_speed_icon_dimension"
        style="@style/PodcastAppTheme.TextView.OverlayTextStyle"/>
</LinearLayout>
