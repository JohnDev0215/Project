<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/feature_play"
    android:background="@color/transparent"
    android:clickable="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/background_gradient_image_view"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:src="@drawable/feature_play_secondary_glass_gradient"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:layout_width="@dimen/t1r_foreground_border_w"
        android:layout_height="@dimen/t1r_foreground_border_h"
        android:layout_marginTop="@dimen/t1r_foreground_border_top"
        android:src="@drawable/feature_play_thumbnail_outside_border"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <RelativeLayout
        android:id="@+id/foreground_gradient_image_view_relative_layout"
        android:layout_width="@dimen/t1r_foreground_width"
        android:layout_height="@dimen/t1r_foreground_height"
        android:layout_marginTop="@dimen/t1r_foreground_top"
        android:layout_centerHorizontal="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/foreground_gradient_image_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/feature_play_thumbnail_secondary_glass_gradient"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </RelativeLayout>
    <RelativeLayout
        android:gravity="center"
        android:id="@+id/PlayButtonWideScreen"
        android:background="@drawable/primary_glass_2_rounded_corners"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        style="@style/ShowcaseButton">
        <ImageView
            android:id="@+id/podcast_widescreen_ingress_button_image"
            android:layout_width="@dimen/spacer_large"
            android:layout_height="@dimen/spacer_large"
            android:layout_alignTop="@+id/podcast_widescreen_ingress_button_text"
            android:layout_alignBottom="@+id/podcast_widescreen_ingress_button_text"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/spacer_base"
            android:layout_marginEnd="@dimen/spacer_small"
            android:layout_alignParentStart="true"/>
        <TextView
            android:gravity="center"
            android:id="@+id/podcast_widescreen_ingress_button_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/spacer_large"
            android:layout_toEndOf="@+id/podcast_widescreen_ingress_button_image"/>
    </RelativeLayout>
    <ImageButton
        android:layout_gravity="end|bottom"
        android:id="@+id/PlayButton"
        android:background="@drawable/button_circle"
        android:padding="@dimen/spacer_small"
        android:layout_width="@dimen/icon_button_medium"
        android:layout_height="@dimen/icon_button_medium"
        android:layout_marginBottom="@dimen/spacer_large"
        android:src="@drawable/ic_playback_play_mini_player"
        android:scaleType="fitCenter"
        android:layout_marginStart="@dimen/spacer_medium"
        android:layout_marginEnd="@dimen/spacer_large"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <TextView
        android:textSize="@dimen/text_size_t4"
        android:ellipsize="end"
        android:id="@+id/label"
        android:paddingTop="0dp"
        android:paddingBottom="0dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacer_base"
        android:layout_marginBottom="@dimen/spacer_micro"
        android:maxLines="1"
        android:layout_marginStart="@dimen/spacer_medium"
        android:layout_marginEnd="@dimen/t1r_right_text_margin"
        app:layout_constraintBottom_toTopOf="@+id/title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/foreground_gradient_image_view_relative_layout"
        style="@style/FeaturedPlayLabel"/>
    <TextView
        android:textSize="@dimen/text_size_h2"
        android:ellipsize="end"
        android:id="@+id/title"
        android:paddingTop="0dp"
        android:paddingBottom="0dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacer_micro"
        android:maxLines="2"
        android:lineSpacingExtra="@dimen/t1r_title_line_padding"
        android:layout_marginStart="@dimen/spacer_medium"
        android:layout_marginEnd="@dimen/t1r_right_text_margin"
        app:layout_constraintBottom_toTopOf="@+id/primary_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/label"
        style="@style/FeaturedPlayEntityTitle"/>
    <TextView
        android:textSize="@dimen/text_size_t1"
        android:ellipsize="end"
        android:id="@+id/primary_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacer_mini"
        android:maxLines="2"
        android:lineSpacingExtra="0dp"
        android:layout_marginStart="@dimen/spacer_medium"
        android:layout_marginEnd="@dimen/t1r_right_text_margin"
        app:layout_constraintBottom_toTopOf="@+id/secondary_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"
        style="@style/FeaturedPlayPrimary"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/secondary_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacer_mini"
        android:maxLines="1"
        android:layout_marginStart="@dimen/spacer_medium"
        android:layout_marginEnd="@dimen/t1r_right_text_margin"
        app:layout_constraintBottom_toTopOf="@+id/tertiary_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/primary_text"
        style="@style/FeaturedPlaySecondary"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/tertiary_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacer_large"
        android:maxLines="1"
        android:layout_marginStart="@dimen/spacer_medium"
        android:layout_marginEnd="@dimen/t1r_right_text_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/secondary_text"
        style="@style/FeaturedPlayTertiary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
