<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/PersistentPlayerBackground"
    android:background="@drawable/persistent_player_background"
    android:layout_width="match_parent"
    android:layout_height="@dimen/miniplayer_height">
    <ImageButton
        android:id="@+id/PersistentPlayerPrevButton"
        android:background="@drawable/player_active_background"
        android:paddingLeft="@dimen/medium_padding"
        android:paddingRight="@dimen/small_padding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/player_btn_prev"
        android:layout_centerVertical="true"
        android:contentDescription="@string/dmusic_player_previous_button_description"/>
    <RelativeLayout
        android:gravity="center"
        android:id="@+id/PersistentPlayerButtonFrame"
        android:background="@drawable/player_active_background"
        android:layout_width="@dimen/persistent_player_view_group_height"
        android:layout_height="@dimen/persistent_player_view_group_height"
        android:layout_toRightOf="@+id/PersistentPlayerPrevButton"
        android:layout_centerVertical="true">
        <FrameLayout
            android:id="@+id/PersistentPlayerPlayButtonContainer"
            android:background="@drawable/player_active_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <include
                android:padding="@dimen/small_padding"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                layout="@layout/player_btn_circle_play"/>
        </FrameLayout>
        <ProgressBar
            android:id="@+id/progress"
            android:padding="@dimen/small_padding"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </RelativeLayout>
    <ImageButton
        android:id="@+id/PersistentPlayerNextButton"
        android:background="@drawable/player_active_background"
        android:paddingLeft="@dimen/small_padding"
        android:paddingRight="@dimen/medium_padding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/player_btn_next"
        android:scaleType="center"
        android:layout_toRightOf="@+id/PersistentPlayerButtonFrame"
        android:layout_centerVertical="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/PersistentPlayerInvisibleButton"
        android:paddingRight="@dimen/small_padding"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@+id/PersistentPlayerNextButton"
        android:layout_centerVertical="true">
        <com.amazon.mp3.view.FocusedTextView
            android:textAppearance="@style/PersistentPlayerPrimaryText"
            android:id="@+id/PersistentPlayerTextLine1"
            style="@style/PersistentPlayerTextLine"/>
        <com.amazon.mp3.view.FocusedTextView
            android:textAppearance="@style/PersistentPlayerSecondaryText"
            android:id="@+id/PersistentPlayerTextLine2"
            style="@style/PersistentPlayerTextLine"/>
    </LinearLayout>
</RelativeLayout>
