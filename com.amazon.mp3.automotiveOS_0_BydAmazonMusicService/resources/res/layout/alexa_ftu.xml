<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="@dimen/alexa_ftu_width"
    android:layout_height="match_parent">
    <TextView
        android:paddingBottom="@dimen/alexa_ftu_padding_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/alexa_ftu_title"
        style="@style/AlexaFtuTitleTextView"/>
    <include
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/alexa_ftu_play_music"/>
    <Space
        android:layout_width="match_parent"
        android:layout_height="@dimen/alexa_ftu_padding_bottom"/>
    <include
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/alexa_ftu_answer_questions"/>
</LinearLayout>
