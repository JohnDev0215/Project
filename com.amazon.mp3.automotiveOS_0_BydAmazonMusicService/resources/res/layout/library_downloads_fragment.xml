<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ViewStub
        android:id="@+id/HeaderViewStub"
        android:inflatedId="@+id/HeaderViewStub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.amazon.mp3.view.DragDropListView
        android:id="@+id/ListView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/HeaderViewStub"
        style="@style/ListView"/>
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <ImageView
            android:id="@+id/EmptyDownloadImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/empty_active_downloads_placeholder"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:id="@+id/EmptyView"
            android:paddingLeft="@dimen/download_fragment_empty_top_text_padding"
            android:paddingRight="@dimen/download_fragment_empty_top_text_padding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dmusic_library_empty_filter_no_downloads_found"
            android:layout_below="@+id/EmptyDownloadImage"
            android:layout_centerHorizontal="true"
            style="@style/LibraryEmptyHeaderText"/>
        <Button
            android:id="@+id/SeeCompleted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/EmptyView"
            android:layout_centerHorizontal="true"
            android:fontFamily="sans-serif"
            style="@style/DownloadsSeeCompletedLinkText"/>
    </RelativeLayout>
    <include
        android:layout_width="match_parent"
        android:layout_height="@dimen/libary_loading_footer_height"
        android:layout_alignParentBottom="true"
        layout="@layout/library_listview_loading_footer"/>
</RelativeLayout>
