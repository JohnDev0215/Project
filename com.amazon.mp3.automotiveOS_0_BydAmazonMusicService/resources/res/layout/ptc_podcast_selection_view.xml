<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/margin"
    android:paddingEnd="@dimen/margin">
    <RelativeLayout
        android:id="@+id/ptc_podcast_header_buttons"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="@dimen/podcast_button_medium"
        android:layout_marginTop="@dimen/podcast_spacer_small"
        android:layout_marginBottom="@dimen/podcast_spacer_large"
        android:layout_marginStart="@dimen/gutter"
        android:layout_marginEnd="@dimen/gutter">
        <com.amazon.podcast.views.EmberTextView
            android:gravity="center"
            android:id="@+id/podcast_skip_view_button"
            android:visibility="visible"
            android:layout_height="@dimen/podcast_button_medium"
            android:minWidth="@dimen/ptc_podcast_skip"
            android:layout_alignParentStart="true"
            style="@style/PodcastAppTheme.TextView.ButtonMediumGlass"/>
        <com.amazon.podcast.views.EmberTextView
            android:gravity="center"
            android:id="@+id/podcast_done_view_button"
            android:visibility="gone"
            android:layout_height="@dimen/podcast_button_medium"
            android:minWidth="@dimen/ptc_podcast_skip"
            android:layout_alignParentEnd="true"
            style="@style/PodcastAppTheme.TextView.ButtonMediumSolid"/>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ptc_header_circles_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/ptc_header_circle_image1"
                android:visibility="gone"
                android:layout_width="@dimen/ptc_header_circle_diameter"
                android:layout_height="@dimen/ptc_header_circle_diameter"/>
            <ImageView
                android:id="@+id/ptc_header_circle_image2"
                android:visibility="gone"
                android:layout_width="@dimen/ptc_header_circle_diameter"
                android:layout_height="@dimen/ptc_header_circle_diameter"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="-20dp"/>
            <ImageView
                android:id="@+id/ptc_header_circle_image3"
                android:visibility="gone"
                android:layout_width="@dimen/ptc_header_circle_diameter"
                android:layout_height="@dimen/ptc_header_circle_diameter"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="-20dp"/>
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="-20dp">
                <ImageView
                    android:id="@+id/ptc_header_circle_image4"
                    android:visibility="gone"
                    android:layout_width="@dimen/ptc_header_circle_diameter"
                    android:layout_height="@dimen/ptc_header_circle_diameter"/>
                <com.amazon.podcast.views.EmberTextView
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/ptc_podcast_header_image_text"
                    android:background="@drawable/rounded_dark_gray_background"
                    android:visibility="gone"
                    android:layout_width="@dimen/ptc_header_circle_diameter"
                    android:layout_height="@dimen/ptc_header_circle_diameter"
                    style="@style/PodcastAppTheme.TextView.Primary"/>
            </RelativeLayout>
        </LinearLayout>
    </RelativeLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/ptc_podcasts_category_view"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gutter"
        android:layout_marginEnd="@dimen/gutter"/>
</LinearLayout>
