<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:weightSum="1">
        <LinearLayout
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.5">
            <com.amazon.music.views.library.views.ArtworkFrameView
                android:id="@+id/art"
                android:clickable="true"
                android:scaleType="center"
                android:layout_centerVertical="true"
                android:contentDescription="@string/content_description_play_button"
                style="@style/AmazonMusic.FeatureBarkerArtLandscape"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/art"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@+id/art">
                <TextView
                    android:gravity="bottom"
                    android:id="@+id/main_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/AmazonMusic.FeatureBarkerMainText"/>
                <TextView
                    android:id="@+id/sub_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    style="@style/AmazonMusic.FeatureBarkerSubText"/>
            </LinearLayout>
        </LinearLayout>
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="0.5"/>
    </LinearLayout>
</merge>
