<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/leftViews"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/AlbumDetailArtwork"
                android:background="@color/transparent"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:src="@drawable/album_placeholder"
                android:layout_marginStart="@dimen/small_padding"
                android:layout_marginEnd="@dimen/small_padding"/>
            <ImageView
                android:id="@+id/AlbumPrimeIndicator"
                android:visibility="gone"
                android:layout_width="@dimen/medium_prime_sash_size"
                android:layout_height="@dimen/medium_prime_sash_size"
                android:src="@drawable/prime_sash"
                android:scaleType="fitCenter"
                android:layout_alignTop="@+id/AlbumDetailArtwork"
                android:layout_alignStart="@+id/AlbumDetailArtwork"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/AlbumArtAndTextContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/AlbumDetailArtwork"
                android:layout_alignStart="@+id/AlbumDetailArtwork"
                android:layout_alignEnd="@+id/AlbumDetailArtwork">
                <TextView
                    android:textSize="@dimen/text_size_medium"
                    android:textColor="@color/white"
                    android:id="@+id/AlbumName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="2"/>
                <TextView
                    android:textSize="@dimen/text_size_small"
                    android:textColor="@color/grey"
                    android:id="@+id/ArtistName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <com.amazon.mp3.view.BadgeView
                        android:id="@+id/KatanaAlbumDetailBadge"
                        android:layout_marginEnd="@dimen/spacing_4dp"
                        style="@style/AlbumDetailContentEncodingBadge"/>
                    <com.amazon.mp3.view.BadgeView
                        android:id="@+id/ImmersiveAlbumDetailBadge"
                        android:layout_marginEnd="@dimen/spacing_4dp"
                        style="@style/AlbumDetailContentEncodingBadge"/>
                    <com.amazon.mp3.view.BadgeView
                        android:id="@+id/ImmersiveAlbumDetailExtraBadge"
                        style="@style/AlbumDetailContentEncodingBadge"/>
                </LinearLayout>
            </LinearLayout>
            <RelativeLayout
                android:gravity="center"
                android:id="@+id/ArtworkPlayerControlsFragment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/AlbumArtAndTextContainer"
                android:layout_alignEnd="@+id/AlbumDetailArtwork"
                style="@style/DetailPlayerControlsContainer"/>
        </RelativeLayout>
    </ScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ListViewContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingEnd="4dp"
        android:layout_toEndOf="@+id/leftViews">
        <ViewStub
            android:id="@+id/HeaderViewStub"
            android:inflatedId="@+id/HeaderViewStub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.amazon.mp3.view.DragDropListView
            android:id="@+id/ListView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:headerDividersEnabled="false"
            style="@style/ListView"/>
        <TextView
            android:gravity="center"
            android:id="@+id/EmptyView"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/dmusic_playlist_empty"/>
    </LinearLayout>
    <include
        android:layout_width="match_parent"
        android:layout_height="@dimen/libary_loading_footer_height"
        android:layout_alignParentBottom="true"
        layout="@layout/library_listview_loading_footer"/>
</RelativeLayout>
