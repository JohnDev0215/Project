<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="@dimen/dialog_width"
    android:layout_height="wrap_content"
    style="@style/NotificationStyle">
    <ImageView
        android:id="@+id/notification_dialog_image"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dialog_image_size"
        android:scaleType="centerCrop"/>
    <LinearLayout
        android:gravity="bottom"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/dialog_min_height">
        <TextView
            android:id="@+id/notification_dialog_caption"
            android:layout_marginBottom="@dimen/dialog_caption_bottom_margin"
            style="@style/NotificationStyle.DialogCaption"/>
        <RelativeLayout
            android:id="@+id/notification_dialog_text_container"
            android:background="@color/grey_notification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/notification_dialog_header1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dialog_header_margin_top"
                android:layout_alignParentTop="true"
                style="@style/NotificationStyle.DialogHeader.1"/>
            <TextView
                android:id="@+id/notification_dialog_header2"
                android:layout_marginTop="@dimen/dialog_header_margin_top"
                android:layout_below="@+id/notification_dialog_header1"
                android:layout_alignParentLeft="true"
                android:layout_centerHorizontal="true"
                android:layout_alignParentStart="true"
                style="@style/NotificationStyle.DialogHeader.2"/>
            <Button
                android:id="@+id/notification_dialog_button_right"
                android:layout_marginRight="@dimen/dialog_button_margin_right"
                android:layout_below="@+id/notification_dialog_header2"
                android:layout_alignParentRight="true"
                style="@style/NotificationStyle.Button.Dialog"/>
            <Button
                android:id="@+id/notification_dialog_button_left"
                android:layout_marginRight="@dimen/dialog_button_margin_right"
                android:layout_toLeftOf="@+id/notification_dialog_button_right"
                android:layout_below="@+id/notification_dialog_header2"
                style="@style/NotificationStyle.Button.Dialog"/>
        </RelativeLayout>
    </LinearLayout>
</FrameLayout>
