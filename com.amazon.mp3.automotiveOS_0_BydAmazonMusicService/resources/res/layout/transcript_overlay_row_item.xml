<?xml version="1.0" encoding="utf-8"?>
<com.amazon.podcast.views.transcription.TranscriptCaptionContainer xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:gravity="start"
            android:id="@+id/transcript_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/transcript_equalizer"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="center"
                android:paddingEnd="@dimen/spacer_10"/>
            <com.amazon.podcast.views.EmberTextView
                android:id="@+id/transcript_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@+id/transcript_equalizer"
                style="@style/PodcastAppTheme.TextView.Headline4"/>
        </RelativeLayout>
        <com.amazon.podcast.views.EmberTextView
            android:gravity="end"
            android:id="@+id/transcript_timestamp"
            android:layout_width="@dimen/podcast_transcript_timestamp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"
            style="@style/PodcastAppTheme.TextView.TranscriptTimestamp"/>
    </LinearLayout>
</com.amazon.podcast.views.transcription.TranscriptCaptionContainer>
