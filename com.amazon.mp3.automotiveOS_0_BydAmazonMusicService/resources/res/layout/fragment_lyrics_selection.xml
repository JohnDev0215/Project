<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/LyricsListView"
        android:background="@color/transparent"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="1dp"
        android:layout_above="@+id/NextButton"
        android:layout_below="@+id/SelectCounter"
        android:overScrollMode="never"/>
    <TextView
        android:textSize="@dimen/text_size_h4"
        android:textColor="@color/white"
        android:id="@+id/SelectLines"
        android:background="@android:color/transparent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/small_padding"
        android:text="@string/lyric_sharing_select_lyrics"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:backgroundTint="@null"
        android:textFontWeight="@dimen/semi_bold"/>
    <TextView
        android:id="@+id/SelectCounter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8dp"
        android:text="@string/default_no_lines_selected_text"
        android:layout_below="@+id/SelectLines"
        android:layout_centerHorizontal="true"/>
    <com.amazon.ui.foundations.views.BaseButton
        android:id="@+id/NextButton"
        android:visibility="gone"
        android:layout_width="@dimen/lyrics_sharing_next_button_width"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_20"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
    <com.amazon.ui.foundations.views.BaseButton
        android:id="@+id/ExitLyricsSharing"
        android:visibility="gone"
        android:layout_width="@dimen/spacer_40"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacer_8"
        android:layout_marginStart="@dimen/spacer_20"/>
</RelativeLayout>
