<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/notification_padding_left"
    android:paddingEnd="@dimen/notification_padding_left">
    <RelativeLayout
        android:id="@+id/download_notif_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:gravity="start|center_vertical"
            android:id="@+id/imgv_download_icon"
            android:layout_width="@dimen/notification_icon_width"
            android:layout_height="match_parent"
            android:src="@drawable/ic_notification_tray_downloading"
            android:scaleType="center"
            android:layout_alignParentStart="true"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="6dp"
            android:layout_toStartOf="@+id/button_layout"
            android:layout_toEndOf="@+id/imgv_download_icon">
            <TextView
                android:textAppearance="@style/DownloadTitle"
                android:id="@+id/tv_download_title"
                android:paddingTop="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textIsSelectable="false"/>
            <TextView
                android:textAppearance="@style/DownloadProgressStatus"
                android:id="@+id/tv_download_error_msg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textIsSelectable="false"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/button_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:layout_alignParentEnd="true">
            <ImageView
                android:id="@+id/resume_button"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/notification_download_resume"
                android:contentDescription="@string/resume_button"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"/>
            <ImageView
                android:id="@+id/cancel_button"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/notification_download_cancel"
                android:contentDescription="@string/cancel_button"
                android:paddingStart="8dp"
                android:paddingEnd="20dp"/>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
