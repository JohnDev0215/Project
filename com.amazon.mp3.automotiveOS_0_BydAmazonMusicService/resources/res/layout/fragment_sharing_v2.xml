<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/sharing_fragment_v2_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:id="@+id/bar_view"
        android:layout_width="@dimen/bar_view_width"
        android:layout_height="@dimen/bar_view_height"
        android:layout_marginTop="@dimen/bar_view_margin_top"
        app:cardCornerRadius="@dimen/bar_view_radius"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/thumbnail"
        android:layout_width="@dimen/share_sheet2_header_thumbnail_size"
        android:layout_height="@dimen/share_sheet2_header_thumbnail_size"
        android:layout_marginTop="@dimen/spacer_32"
        android:layout_marginStart="@dimen/spacer_20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/text_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/share_header_margin"
        android:layout_marginEnd="@dimen/share_header_margin"
        app:layout_constraintBottom_toBottomOf="@+id/thumbnail"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/thumbnail"
        app:layout_constraintTop_toTopOf="@+id/thumbnail">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:ellipsize="end"
                android:gravity="left"
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"/>
            <com.amazon.ui.foundations.views.BaseButton
                android:textColor="@color/white"
                android:id="@+id/song_tag"
                android:background="@color/primary_glass_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/spacer_4"/>
        </LinearLayout>
        <TextView
            android:ellipsize="end"
            android:gravity="left"
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:orientation="vertical"
        android:id="@+id/nested_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/share_items_container_margin_top"
        android:layout_marginStart="@dimen/spacer_16"
        android:layout_marginEnd="@dimen/spacer_16"
        app:layout_constrainedHeight="true"
        app:layout_constraintHeight_min="@dimen/share_scroller_min_height"
        app:layout_constraintTop_toBottomOf="@+id/thumbnail">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/share_items_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/share_items_container_margin_bottom"/>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
