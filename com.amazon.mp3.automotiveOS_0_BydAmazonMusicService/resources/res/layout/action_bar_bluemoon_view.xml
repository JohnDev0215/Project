<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/large_text_size"
        android:gravity="center_vertical"
        android:id="@+id/title_text"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/library_list_view_item_height"
        android:text="@string/dmusic_library_header_tab"
        android:layout_marginStart="@dimen/standard_padding"
        android:layout_marginEnd="@dimen/standard_padding"
        style="@style/AmazonMusic.EmberRegularText"/>
    <com.amazon.mp3.view.MusicSourceToggle
        android:gravity="center_vertical"
        android:id="@+id/SourceToggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/standard_padding"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
