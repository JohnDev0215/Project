<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:amazonmp3="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@drawable/ripple_background"
    android:layout_width="match_parent"
    android:layout_height="@dimen/song_tile_detail_height">
    <FrameLayout
        android:layout_gravity="center"
        android:layout_width="@dimen/song_tile_art_size"
        android:layout_height="@dimen/song_tile_art_size"
        android:layout_marginRight="@dimen/playlist_tile_art_indent">
        <ImageView
            android:id="@+id/imageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/station_placeholder"/>
        <ImageView
            android:layout_gravity="bottom|left"
            android:id="@+id/PlayIcon"
            android:paddingLeft="4dp"
            android:paddingBottom="4dp"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/station_thumb_outline"
            android:scaleType="center"/>
        <com.amazon.mp3.view.PlayNotificationIcon
            android:layout_gravity="center"
            android:id="@+id/PlaystateIcon"
            android:background="@color/dimmed"
            android:visibility="gone"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="center"
            amazonmp3:useLargeIcons="false"/>
        <com.amazon.mp3.view.FixedWidthAspectImageView
            android:background="@drawable/selector_artwork_mask"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <TextView
        android:gravity="center_vertical"
        android:layout_gravity="center"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_weight="1"
        style="@style/GridTilePrimaryText"/>
    <include
        android:id="@+id/overflow_button_open"
        android:layout_width="@dimen/overflow_button_clickable_size"
        android:layout_height="match_parent"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        layout="@layout/overflow_button"/>
</LinearLayout>
