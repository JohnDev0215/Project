<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/edit_profile_close_button"
        android:layout_width="@dimen/dialog_small_circular_icon_diameter"
        android:layout_height="@dimen/dialog_small_circular_icon_diameter"
        android:layout_marginLeft="@dimen/pill_cell_padding_horizontal"
        android:layout_marginTop="@dimen/pill_cell_padding_vertical"
        android:layout_marginRight="@dimen/pill_cell_padding_horizontal"
        android:src="@drawable/ic_action_cancel"
        android:adjustViewBounds="true"/>
</RelativeLayout>
