<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:paddingTop="@dimen/standard_padding"
    android:paddingBottom="@dimen/standard_padding"
    android:focusableInTouchMode="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true">
    <FrameLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/navigation_back_button"
        android:visibility="gone"
        android:layout_width="@dimen/prime_back_button_size"
        android:layout_height="match_parent">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/back_button_icon"
            android:layout_width="@dimen/prime_filter_icon_size"
            android:layout_height="@dimen/prime_filter_icon_size"
            android:src="@drawable/ic_navigation_goback"
            android:layout_marginStart="@dimen/standard_padding"
            android:layout_marginEnd="@dimen/standard_padding"/>
    </FrameLayout>
    <SearchView
        android:id="@+id/search_view"
        android:layout_width="0dp"
        android:layout_height="@dimen/prime_search_bar_height"
        android:layout_weight="1"
        android:imeOptions="flagNoExtractUi|actionGo"
        android:iconifiedByDefault="false"
        android:paddingStart="@dimen/spacer_16"
        android:paddingEnd="@dimen/medium_padding"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/filter_container_layout"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="@dimen/prime_filter_layout_width"
        android:layout_height="match_parent"
        android:paddingEnd="@dimen/large_padding">
        <FrameLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/filter_view"
            android:background="@drawable/filter_icon_background"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:paddingStart="@dimen/standard_padding"
            android:paddingEnd="@dimen/standard_padding"
            app:layout_constraintDimensionRatio="@dimen/prime_filter_layout_ratio"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/filter_icon"
                android:layout_width="@dimen/prime_filter_icon_size"
                android:layout_height="@dimen/prime_filter_icon_size"
                android:src="@drawable/ic_search_filter_btn"/>
        </FrameLayout>
        <ImageView
            android:textColor="@android:color/white"
            android:layout_gravity="end|top"
            android:id="@+id/filter_badge"
            android:background="@drawable/blue_circle"
            android:visibility="gone"
            android:layout_width="@dimen/prime_filter_badge_size"
            android:layout_height="@dimen/prime_filter_badge_size"
            app:layout_constraintBottom_toTopOf="@+id/filter_view"
            app:layout_constraintEnd_toEndOf="@+id/filter_view"
            app:layout_constraintStart_toEndOf="@+id/filter_view"
            app:layout_constraintTop_toTopOf="@+id/filter_view"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="@dimen/action_bar_secondary_text_size"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/cancel_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="@string/dmusic_prime_stations_playback_error_dialog_cancel_button"
        android:textAllCaps="true"
        android:paddingEnd="@dimen/large_padding"/>
</LinearLayout>
