<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ScrollView
        android:padding="@dimen/dialog_margin_and_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/large_text_size"
                android:textStyle="bold"
                android:textColor="@color/library_swatch_white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dialog_margin_and_padding"
                android:text="@string/try_our_widget_dialog_title"/>
            <TextView
                android:textSize="@dimen/medium_text_size"
                android:textColor="@color/library_swatch_white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dialog_margin_and_padding"
                android:text="@string/try_our_widget_dialog_main_text"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dialog_margin_and_padding"
                android:src="@drawable/widget_message"
                android:contentDescription="@string/try_our_widget_dialog_image_content_description"/>
            <TextView
                android:textSize="@dimen/small_text_size"
                android:textColor="@color/library_swatch_white"
                android:id="@+id/try_our_widget_dialog_second_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dialog_margin_and_padding"/>
            <Button
                android:id="@+id/try_our_widget_dialog_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/try_our_widget_dialog_button"/>
        </LinearLayout>
    </ScrollView>
    <ImageView
        android:id="@+id/try_our_widget_close_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/btn_close"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:contentDescription="@string/try_our_widget_dialog_button"/>
</RelativeLayout>
