<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <Space
        android:id="@+id/top_spacer"
        android:background="@color/background_color"
        android:layout_width="match_parent"
        android:layout_height="@dimen/search_tab_top_spacer_height"/>
    <TextView
        android:textSize="@dimen/listview_item_primary_text_size"
        android:textStyle="bold"
        android:id="@+id/did_you_mean_text_view"
        android:paddingLeft="@dimen/prime_card_horiz_padding"
        android:paddingRight="@dimen/prime_card_horiz_padding"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="@dimen/listview_item_primary_text_size"
        android:id="@+id/auto_correction_text_view"
        android:paddingLeft="@dimen/prime_card_horiz_padding"
        android:paddingRight="@dimen/prime_card_horiz_padding"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="@dimen/listview_item_primary_text_size"
        android:id="@+id/correction_original_text_view"
        android:paddingLeft="@dimen/prime_card_horiz_padding"
        android:paddingRight="@dimen/prime_card_horiz_padding"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
