<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="40dp"
    android:layout_marginEnd="@dimen/podcast_spacer_small">
    <LinearLayout
        android:gravity="center"
        android:id="@+id/podcast_refinement_bar_button_layout"
        android:background="@drawable/button_refinement_selector"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/podcast_spacer_base"
        android:paddingEnd="@dimen/podcast_spacer_base"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/podcast_refinement_bar_item_icon_left"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/podcast_tiny_icon"
            android:tint="@drawable/refinement_color_selector"
            android:layout_marginEnd="@dimen/podcast_spacer_mini"/>
        <com.amazon.podcast.views.EmberTextView
            android:textColor="@drawable/refinement_color_selector"
            android:id="@+id/podcast_refinement_bar_item_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/PodcastAppTheme.TextView.Primary"/>
        <ImageView
            android:id="@+id/podcast_refinement_bar_item_icon_right"
            android:layout_width="@dimen/podcast_tiny_icon"
            android:layout_height="@dimen/podcast_tiny_icon"
            android:scaleType="centerInside"
            android:tint="@drawable/refinement_color_selector"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/podcast_spacer_mini"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
