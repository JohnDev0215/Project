<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/podcast_horizontal_item_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:foreground="@drawable/ripple">
    <TextView
        android:id="@+id/podcast_row_item_index"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:paddingEnd="@dimen/spacer_12"
        app:layout_constraintBottom_toBottomOf="@+id/podcast_row_item_image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/podcast_row_item_image"/>
    <ImageView
        android:id="@+id/podcast_row_item_image"
        android:layout_width="@dimen/artwork_default_dimen"
        android:layout_height="@dimen/artwork_default_dimen"
        app:layout_constraintStart_toEndOf="@+id/podcast_row_item_index"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/podcast_row_item_play_button"
        android:layout_width="@dimen/spacer_24"
        android:layout_height="@dimen/spacer_24"
        android:layout_margin="@dimen/small_spacing"
        android:src="@drawable/podcast_ic_badge_playback"
        app:layout_constraintBottom_toBottomOf="@+id/podcast_row_item_image"
        app:layout_constraintStart_toEndOf="@+id/podcast_row_item_index"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/podcast_row_item_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/podcast_row_item_image"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/podcast_row_item_image"
        app:layout_constraintTop_toTopOf="@+id/podcast_row_item_image">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/title_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:ellipsize="end"
                android:id="@+id/podcast_row_item_primary_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"/>
        </LinearLayout>
        <TextView
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/podcast_row_item_secondary_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
