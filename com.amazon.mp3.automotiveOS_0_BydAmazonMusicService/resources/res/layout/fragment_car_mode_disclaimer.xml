<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/car_mode_disclaimer_car_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_car_blue"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.1"/>
    <TextView
        android:id="@+id/car_mode_disclaimer_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacer_12"
        android:text="@string/dmusic_car_mode_disclaimer_title"
        app:layout_constraintBottom_toTopOf="@+id/car_mode_disclaimer_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/car_mode_disclaimer_car_icon"/>
    <TextView
        android:id="@+id/car_mode_disclaimer_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/spacer_36"
        android:layout_marginTop="@dimen/spacer_12"
        android:layout_marginRight="@dimen/spacer_36"
        android:text="@string/dmusic_car_mode_disclaimer_content"
        android:layout_marginHorizontal="@dimen/spacer_36"
        app:layout_constraintTop_toBottomOf="@+id/car_mode_disclaimer_title"/>
    <com.amazon.ui.foundations.views.BaseButton
        android:id="@+id/presets_ingress_dismiss_button"
        android:layout_width="@dimen/bt_permission_coachmark_button_width"
        android:layout_height="@dimen/spacer_epic"
        android:layout_marginBottom="@dimen/spacer_64"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
