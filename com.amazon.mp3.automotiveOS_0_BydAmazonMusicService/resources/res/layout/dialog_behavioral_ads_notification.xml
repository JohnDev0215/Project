<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/background_view"
        android:background="@drawable/bauhaus_gradient_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="top|center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/dialog_outside_margin"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageButton
            android:layout_gravity="end"
            android:id="@+id/closeButton"
            android:layout_width="@dimen/dialog_close_button_size"
            android:layout_height="@dimen/dialog_close_button_size"
            android:layout_marginBottom="@dimen/dialog_small_border_padding"
            android:src="@drawable/ic_dialog_close_dark"
            style="@style/BauhausCloseButton"/>
        <TextView
            android:textSize="@dimen/dialog_title_text_size_nightwing"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/adsOptOutTitle"
            android:paddingTop="@dimen/dialog_text_top_padding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dmusic_freetier_behavioral_ads_notification_dialog_title"
            android:textAlignment="center"
            style="@style/DialogTitleText"/>
        <TextView
            android:textSize="@dimen/dialog_subtitle_text_size_nightwing"
            android:textColor="@color/pure_white"
            android:gravity="center"
            android:id="@+id/adsOptOutText"
            android:paddingTop="@dimen/dialog_text_top_padding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dialog_subtitle_margin"
            android:layout_marginRight="@dimen/dialog_subtitle_margin"
            android:text="@string/dmusic_freetier_behavioral_ads_notification_dialog_text"
            android:textAlignment="center"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/dialog_text_top_padding"/>
        <Button
            android:id="@+id/dismissButton"
            android:text="@string/dmusic_freetier_behavioral_ads_notification_dismiss"
            android:textAlignment="center"
            style="@style/BauhausSignupButton"/>
    </LinearLayout>
</RelativeLayout>
