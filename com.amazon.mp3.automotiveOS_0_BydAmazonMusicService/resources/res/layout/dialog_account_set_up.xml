<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/background_gradient"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_gravity="start"
            android:orientation="vertical"
            android:padding="@dimen/dialog_outside_margin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/browse_dialog_margins">
            <TextView
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dmusic_account_set_up_dialog_title"
                style="@style/DialogTitleText"/>
            <TextView
                android:paddingTop="@dimen/dialog_text_top_padding"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dmusic_account_set_up_dialog_text"
                style="@style/DialogBodyText"/>
        </LinearLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="@dimen/browse_dialog_margin_bottom"
            android:layout_marginStart="@dimen/browse_dialog_margins"
            android:layout_marginEnd="@dimen/browse_dialog_margins">
            <LinearLayout
                android:orientation="vertical"
                android:paddingBottom="@dimen/dialog_small_border_padding"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true">
                <Button
                    android:id="@+id/account_set_up_dialog_positive_button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/browse_dialog_button_height"
                    android:text="@string/dmusic_account_set_up_dialog_continue_button"
                    style="@style/AccountSetUpDialogPositiveButton"/>
                <Button
                    android:id="@+id/account_set_up_dialog_negative_button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/browse_dialog_button_height"
                    android:layout_marginTop="@dimen/browse_dialog_button_margin_top"
                    android:text="@string/dmusic_account_set_up_dialog_sign_out_button"
                    style="@style/AccountSetUpDialogNegativeButton"/>
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
</ScrollView>
