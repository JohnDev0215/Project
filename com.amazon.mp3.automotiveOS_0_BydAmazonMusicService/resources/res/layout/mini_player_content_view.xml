<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/MiniPlayerArtworkContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/standard_padding">
        <com.amazon.ui.foundations.views.BaseImage
            android:layout_gravity="center"
            android:id="@+id/MiniPlayerArtwork"
            android:layout_width="@dimen/miniplayer_icon_size"
            android:layout_height="@dimen/miniplayer_icon_size"
            android:src="@drawable/placeholder"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/miniPlayerArtworkOverlay"
            android:background="@color/secondary_glass_4"
            android:visibility="gone"
            android:layout_width="@dimen/miniplayer_icon_size"
            android:layout_height="@dimen/miniplayer_icon_size"
            android:scaleType="centerCrop"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/miniPlayerMinimize"
            android:visibility="gone"
            android:layout_width="@dimen/miniplayer_icon_size"
            android:layout_height="@dimen/miniplayer_icon_size"
            android:src="@drawable/ic_chevron_caretdown"
            android:scaleType="center"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/MiniPlayerItemInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/standard_padding">
        <TextView
            android:ellipsize="end"
            android:id="@+id/MiniPlayerTitle"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            style="@style/AmazonMusic.MainText"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:weightSum="4">
            <View
                android:id="@+id/TitlePlaceHolder"
                android:background="@color/dark_grey"
                android:layout_width="0dp"
                android:layout_height="@dimen/t8"
                android:layout_marginBottom="@dimen/spacer_4"
                android:layout_weight="3"/>
        </LinearLayout>
        <View
            android:id="@+id/SubtitlePlaceholder"
            android:background="@color/dark_grey"
            android:layout_width="match_parent"
            android:layout_height="@dimen/t9"
            android:layout_marginBottom="@dimen/spacer_4"/>
        <TextView
            android:textSize="12dp"
            android:ellipsize="end"
            android:id="@+id/MiniPlayerSubtitle"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            style="@style/AmazonMusic.MainText"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/miniPlayerPlayingOnIcon"
                android:visibility="gone"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:src="@drawable/ic_playing_on"
                android:scaleType="center"
                android:layout_marginEnd="@dimen/standard_padding"/>
            <TextView
                android:textSize="@dimen/text_size_11"
                android:textColor="@color/bauhaus_accent"
                android:ellipsize="end"
                android:id="@+id/DeviceNameTextView"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
