<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingTop="@dimen/spacing_6dp"
    android:paddingRight="@dimen/listview_two_lines_section_padding"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/listview_two_lines_section_padding">
    <TextView
        android:textSize="@dimen/browse_primary_text_size"
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:id="@+id/custom_list_view_row_text_view"
        android:padding="@dimen/spacing_0dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_5dp"
        android:maxWidth="@dimen/default_preference_max_width"
        android:layout_marginStart="@dimen/spacing_6dp"
        android:layout_toEndOf="@+id/preference_radio"/>
    <TextView
        android:textSize="@dimen/browse_secondary_text_size"
        android:textColor="@color/dark_grey"
        android:gravity="center_vertical"
        android:id="@+id/custom_list_view_row_subtext_view"
        android:padding="@dimen/spacing_0dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/custom_list_view_row_text_view"
        android:layout_alignStart="@+id/custom_list_view_row_text_view"/>
    <RadioButton
        android:id="@+id/preference_radio"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checkMark="@drawable/abc_btn_radio_material"
        android:layout_alignParentStart="true"
        android:buttonTint="@color/vivace_blue"/>
    <ImageView
        android:id="@+id/info_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_help_smallest"
        android:tint="#798297"
        android:layout_alignTop="@+id/custom_list_view_row_text_view"
        android:layout_alignBottom="@+id/custom_list_view_row_text_view"
        android:layout_marginStart="@dimen/spacing_4dp"
        android:layout_toEndOf="@+id/custom_list_view_row_text_view"/>
</RelativeLayout>
