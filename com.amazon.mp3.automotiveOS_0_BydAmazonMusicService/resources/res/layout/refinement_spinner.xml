<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:background="@color/widget_shadow"
    android:layout_width="match_parent"
    android:layout_height="@dimen/refinement_spinner_height">
    <Spinner
        android:gravity="center"
        android:id="@+id/refinement_spinner"
        android:background="@color/transparent"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/refinement_spinner_height"
        android:popupBackground="@drawable/refinement_spinner_background_color_selector"
        android:dropDownWidth="wrap_content"
        android:dropDownVerticalOffset="@dimen/refinement_spinner_vertical_offset"
        android:spinnerMode="dropdown"
        android:layout_marginStart="@dimen/refinement_spinner_item_side_padding"
        android:layout_marginEnd="@dimen/refinement_spinner_item_side_padding"
        android:accessibilityLiveRegion="polite"
        android:popupElevation="0dp"/>
</RelativeLayout>
