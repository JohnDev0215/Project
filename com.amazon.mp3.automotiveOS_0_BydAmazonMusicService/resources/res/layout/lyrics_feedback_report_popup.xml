<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/bauhaus_spacer_medium"
    android:paddingEnd="@dimen/bauhaus_spacer_medium">
    <TextView
        android:textSize="@dimen/text_t2"
        android:textColor="@color/primary_text_color_disabled"
        android:id="@+id/lyrics_feedback_select_reason_prompt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lyrics_hmd_select_a_reason"
        android:fontFamily="@string/font_amazon_ember_regular"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/bauhaus_spacer_small"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/lyrics_feedback_more_details_prompt"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lyrics_feedback_select_reason_prompt">
        <RadioGroup
            android:orientation="vertical"
            android:id="@+id/lyrics_feedback_radio_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/bauhaus_spacer_medium"/>
    </ScrollView>
    <TextView
        android:textSize="@dimen/text_size_t1"
        android:textColor="@color/pure_white"
        android:id="@+id/lyrics_feedback_more_details_prompt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/bauhaus_spacer_base"
        android:text="@string/lyrics_hmd_prompt_more_details"
        android:fontFamily="@string/font_amazon_ember_regular"
        app:layout_constraintBottom_toTopOf="@+id/lyrics_feedback_text_box"
        app:layout_constraintStart_toStartOf="parent"/>
    <EditText
        android:textSize="@dimen/text_size_t2"
        android:textColor="@color/white"
        android:textColorHint="@color/mid_grey"
        android:gravity="start|top"
        android:id="@+id/lyrics_feedback_text_box"
        android:background="@drawable/rounded_stroke_bg_edittext"
        android:layout_width="match_parent"
        android:layout_height="@dimen/lyrics_feedback_text_box_height"
        android:layout_marginBottom="@dimen/bauhaus_spacer_base"
        android:hint="@string/lyrics_hmd_additional_details"
        android:maxLength="@integer/lyrics_hmd_additional_details_textbox_max_chars"
        android:inputType="textMultiLine"
        android:textCursorDrawable="@drawable/search_view_cursor"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
