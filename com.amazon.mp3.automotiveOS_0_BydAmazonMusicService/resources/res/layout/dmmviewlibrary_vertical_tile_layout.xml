<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:foreground="@drawable/ripple">
    <com.amazon.music.views.library.views.ArtworkFrameView
        android:id="@+id/artwork_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.amazon.music.views.library.views.TransparentGradientImageView
        android:id="@+id/transparent_gradient_image_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/spacer_32"
        app:layout_constraintBottom_toBottomOf="@+id/artwork_frame"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.amazon.ui.foundations.views.BaseButton
        android:id="@+id/live_badge"
        android:paddingBottom="@dimen/spacer_8"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/spacer_8"
        android:paddingEnd="@dimen/spacer_4"
        app:layout_constraintBottom_toBottomOf="@+id/artwork_frame"
        app:layout_constraintStart_toStartOf="@+id/artwork_frame"/>
    <com.amazon.ui.foundations.views.BaseButton
        android:id="@+id/viewer_count"
        android:paddingBottom="@dimen/spacer_8"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/artwork_frame"
        app:layout_constraintStart_toEndOf="@+id/live_badge"/>
    <ImageView
        android:enabled="false"
        android:id="@+id/source_logo"
        android:focusable="false"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="fitStart"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="@+id/artwork_frame"
        app:layout_constraintEnd_toEndOf="@+id/artwork_frame"/>
    <LinearLayout
        android:id="@+id/artist_artwork_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@+id/artwork_frame"
        app:layout_constraintTop_toBottomOf="@+id/artwork_frame">
        <ImageView
            android:id="@+id/artist_artwork"
            android:visibility="gone"
            android:layout_width="@dimen/spacer_40"
            android:layout_height="@dimen/spacer_40"
            android:layout_marginTop="@dimen/spacer_12"
            android:layout_marginEnd="@dimen/spacer_12"/>
    </LinearLayout>
    <TextView
        android:ellipsize="end"
        android:id="@+id/label"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="@+id/artwork_frame"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/artist_artwork_container"
        app:layout_constraintTop_toBottomOf="@+id/artwork_frame"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="@+id/artwork_frame"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/artist_artwork_container"
        app:layout_constraintTop_toBottomOf="@+id/label"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/subtitle"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="@+id/artwork_frame"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/artist_artwork_container"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <com.amazon.music.views.library.views.StarRatingView
        android:id="@+id/star_rating"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@+id/artist_artwork_container"
        app:layout_constraintTop_toBottomOf="@+id/subtitle"/>
    <com.amazon.ui.foundations.views.BaseButton
        android:id="@+id/follow_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/subtitle"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/recommendation_text"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="@+id/artwork_frame"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/artist_artwork_container"
        app:layout_constraintTop_toBottomOf="@+id/follow_button"/>
    <com.amazon.ui.foundations.views.BaseButton
        android:id="@+id/audio_quality_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@+id/artist_artwork_container"
        app:layout_constraintTop_toBottomOf="@+id/recommendation_text"/>
    <com.amazon.ui.foundations.views.BaseButton
        android:id="@+id/immersive_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@+id/audio_quality_badge"
        app:layout_constraintTop_toBottomOf="@+id/recommendation_text"/>
    <com.amazon.ui.foundations.views.BaseButton
        android:id="@+id/immersive_album_extra_badge"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/immersive_badge"
        app:layout_constraintStart_toEndOf="@+id/immersive_badge"/>
    <TextView
        android:id="@+id/all_access_label"
        android:paddingTop="@dimen/spacer_4"
        android:paddingBottom="@dimen/spacer_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:paddingStart="@dimen/spacer_4"
        android:paddingEnd="@dimen/spacer_4"
        app:layout_constraintStart_toEndOf="@+id/artist_artwork_container"
        app:layout_constraintTop_toBottomOf="@+id/recommendation_text"
        app:layout_goneMarginTop="@dimen/spacer_8"/>
</androidx.constraintlayout.widget.ConstraintLayout>
