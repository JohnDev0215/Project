<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tileContainer"
    android:layout_width="match_parent"
    android:layout_height="@dimen/casting_tile_height"
    android:layout_marginTop="@dimen/casting_tile_separator"
    android:foreground="@drawable/ripple">
    <ImageView
        android:layout_gravity="bottom"
        android:id="@+id/imageIcon"
        android:visibility="visible"
        android:layout_width="@dimen/casting_image_default_dimen"
        android:layout_height="@dimen/casting_image_default_dimen"
        android:layout_marginLeft="@dimen/casting_image_left_margin"
        android:layout_marginRight="@dimen/casting_image_right_margin"
        android:src="@drawable/ic_dot"
        android:scaleType="center"
        android:layout_centerVertical="true"/>
    <RelativeLayout
        android:id="@+id/titleGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toLeftOf="@+id/button"
        android:layout_toRightOf="@+id/imageIcon"
        android:layout_centerInParent="true">
        <TextView
            android:textColor="@color/vivace_blue"
            android:ellipsize="end"
            android:layout_gravity="center"
            android:id="@+id/title"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/casting_title_right_margin"
            android:singleLine="true"
            style="@style/AmazonMusic.Casting.TitleText"/>
        <TextView
            android:ellipsize="end"
            android:layout_gravity="center"
            android:id="@+id/subtitle"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/casting_title_right_margin"
            android:singleLine="true"
            android:layout_below="@+id/title"
            style="@style/AmazonMusic.Casting.SubtitleText"/>
    </RelativeLayout>
    <androidx.appcompat.widget.AppCompatButton
        android:enabled="true"
        android:layout_gravity="center_vertical"
        android:id="@+id/button"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/casting_button_left_margin"
        android:layout_marginRight="@dimen/casting_button_right_margin"
        android:layout_alignParentRight="true"
        android:layout_centerInParent="true"
        style="@style/AmazonMusic.Casting.SubtitleText"/>
    <ProgressBar
        android:id="@+id/loading_spinner"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/casting_loading_spinner_top_bottom_margin"
        android:layout_marginBottom="@dimen/casting_loading_spinner_top_bottom_margin"
        android:layout_alignParentRight="true"
        android:progressTint="@color/vivace_blue"
        style="@style/AmazonMusic.ProgressBar"/>
    <com.amazon.ui.foundations.views.Divider
        android:background="@color/white_15"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
