<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/podcast_art"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="centerCrop"
        android:layout_alignParentLeft="true"
        android:layout_alignParentRight="true"/>
    <RelativeLayout
        android:id="@+id/half_screen_transcript_view_layout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="centerCrop"
        android:layout_alignTop="@+id/podcast_art"
        android:layout_alignBottom="@+id/podcast_art"
        android:layout_alignParentLeft="true"
        android:layout_alignParentRight="true">
        <com.amazon.podcast.views.transcription.HalfScreenTranscriptView
            android:id="@+id/half_screen_ranscript_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/transcipt_ingress_layout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/spacer_72"
        android:layout_marginBottom="2dp"
        android:layout_alignBottom="@+id/podcast_art"
        android:layout_alignStart="@+id/podcast_art"
        android:layout_alignEnd="@+id/podcast_art">
        <ImageView
            android:id="@+id/transcript_ingress_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/half_screen_view_background_filter"
            android:background="@color/secondary_glass_4"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:layout_centerVertical="true"/>
        <com.amazon.podcast.views.EmberTextView
            android:gravity="center_horizontal"
            android:id="@+id/transcript_tap_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tap_for_full_screen_or_browse_timeline_to_preview"
            android:maxLines="2"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            style="@style/PodcastAppTheme.TextView.TranscriptSubtitle"/>
        <ImageView
            android:id="@+id/transcript_syncing_loadingview"
            android:visibility="gone"
            android:layout_width="@dimen/podcast_small_icon_button"
            android:layout_height="@dimen/podcast_small_icon_button"
            android:src="@drawable/ic_other_loader"
            android:layout_alignTop="@+id/transcript_tap_text"
            android:layout_alignBottom="@+id/transcript_tap_text"
            android:layout_centerInParent="true"
            android:layout_marginEnd="@dimen/spacer_10"
            android:layout_toStartOf="@+id/transcript_tap_text"/>
    </RelativeLayout>
    <SeekBar
        android:id="@+id/podcast_now_playing_seekbar"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/podcast_large_icon"
        android:layout_marginBottom="@dimen/podcast_seekbar_margin"
        android:layout_alignBottom="@+id/podcast_art"
        android:layout_alignStart="@+id/podcast_art"
        android:layout_alignEnd="@+id/podcast_art"
        style="@style/PodcastAppTheme.NowPlaying.SeekBar"/>
    <com.amazon.podcast.views.EmberTextView
        android:id="@+id/podcast_progress_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/podcast_spacer_mini"
        android:text="00:00"
        android:layout_below="@+id/podcast_art"
        android:layout_alignStart="@+id/podcast_art"
        style="@style/PodcastAppTheme.TextView.LabelInActive"/>
    <com.amazon.podcast.views.EmberTextView
        android:id="@+id/podcast_duration_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/podcast_spacer_mini"
        android:text="-00:00"
        android:layout_below="@+id/podcast_art"
        android:layout_alignEnd="@+id/podcast_art"
        style="@style/PodcastAppTheme.TextView.LabelInActive"/>
    <LinearLayout
        android:id="@+id/podcast_now_playing_marquee_title_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/podcast_spacer_small"
        android:layout_below="@+id/podcast_progress_text"
        android:layout_alignStart="@+id/podcast_art">
        <com.amazon.podcast.views.EmberTextView
            android:ellipsize="marquee"
            android:id="@+id/podcast_now_playing_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:marqueeRepeatLimit="marquee_forever"
            style="@style/PodcastAppTheme.TextView.Headline3"/>
    </LinearLayout>
    <com.amazon.podcast.views.EmberTextView
        android:id="@+id/podcast_now_playing_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/podcast_spacer_mini"
        android:layout_below="@+id/podcast_now_playing_marquee_title_container"
        android:layout_alignStart="@+id/podcast_now_playing_marquee_title_container"
        style="@style/PodcastAppTheme.TextView.Primary"/>
</RelativeLayout>
