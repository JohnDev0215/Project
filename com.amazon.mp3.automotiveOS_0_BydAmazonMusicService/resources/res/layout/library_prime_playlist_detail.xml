<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/background_gradient"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/leftViews"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/PrimeBannerContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/PrimePlaylistDetailImage"
                    android:layout_width="240dp"
                    android:layout_height="135dp"
                    android:layout_marginLeft="@dimen/small_padding"
                    android:layout_marginRight="@dimen/small_padding"
                    android:scaleType="fitStart"/>
            </RelativeLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/DescriptionContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/PrimeBannerContainer"
                android:layout_alignLeft="@+id/PrimeBannerContainer"
                android:layout_alignRight="@+id/PrimeBannerContainer">
                <TextView
                    android:textSize="@dimen/small_text_size"
                    android:textColor="@color/grey"
                    android:gravity="center"
                    android:id="@+id/PrimePlaylistDescription"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textColor="@color/blue_accent"
                    android:gravity="center"
                    android:id="@+id/CuratedByName"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""/>
            </LinearLayout>
            <RelativeLayout
                android:gravity="center"
                android:id="@+id/PrimePlaylistPlayerControlsFragment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/DescriptionContainer"
                android:layout_alignRight="@+id/PrimeBannerContainer"/>
        </RelativeLayout>
    </ScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:paddingRight="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@+id/leftViews">
        <ViewStub
            android:id="@+id/HeaderViewStub"
            android:inflatedId="@+id/HeaderViewStub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.amazon.mp3.view.DragDropListView
            android:id="@+id/ListView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginLeft="@dimen/small_padding"
            android:layout_marginRight="@dimen/small_padding"
            android:layout_weight="1"
            android:headerDividersEnabled="false"
            style="@style/ListView"/>
        <TextView
            android:gravity="center"
            android:id="@+id/EmptyView"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/dmusic_playlist_empty"/>
    </LinearLayout>
    <include
        android:layout_width="match_parent"
        android:layout_height="@dimen/libary_loading_footer_height"
        android:layout_alignParentBottom="true"
        layout="@layout/library_listview_loading_footer"/>
</RelativeLayout>
