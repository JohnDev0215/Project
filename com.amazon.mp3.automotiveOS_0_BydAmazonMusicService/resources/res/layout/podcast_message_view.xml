<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginStart="@dimen/gutter"
    android:layout_marginEnd="@dimen/gutter">
    <com.amazon.podcast.views.ActionBarView
        android:id="@+id/action_bar_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/podcast_message_primary_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/podcast_message_icon"
                android:visibility="gone"
                android:layout_width="@dimen/podcast_icon_small"
                android:layout_height="@dimen/podcast_icon_small"
                android:layout_marginEnd="@dimen/podcast_spacer_small"/>
            <com.amazon.podcast.views.EmberTextView
                android:gravity="center"
                android:id="@+id/podcast_message_view_primary_text"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/PodcastAppTheme.TextView.Primary"/>
        </LinearLayout>
        <com.amazon.podcast.views.EmberTextView
            android:gravity="center"
            android:id="@+id/podcast_message_view_secondary_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/podcast_spacer_small"
            android:layout_below="@+id/podcast_message_primary_group"
            android:layout_centerHorizontal="true"
            style="@style/PodcastAppTheme.TextView.Tertiary"/>
        <com.amazon.podcast.views.EmberTextView
            android:gravity="center"
            android:id="@+id/podcast_message_view_button"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/podcast_button_medium"
            android:layout_marginTop="@dimen/podcast_spacer_small"
            android:layout_below="@+id/podcast_message_view_secondary_text"
            android:layout_centerHorizontal="true"
            android:paddingStart="@dimen/podcast_spacer_epic"
            android:paddingEnd="@dimen/podcast_spacer_epic"
            style="@style/PodcastAppTheme.TextView.ButtonMediumGlass"/>
    </RelativeLayout>
</RelativeLayout>
