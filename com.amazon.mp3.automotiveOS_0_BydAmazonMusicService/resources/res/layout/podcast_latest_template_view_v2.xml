<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/podcast_latest_templates_v2_items_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.google.android.material.appbar.AppBarLayout
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar"
            android:id="@+id/main.appbar"
            android:background="@color/transparent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="0dp"
            app:elevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="0dp"
                app:layout_scrollFlags="scroll"
                app:scrimAnimationDuration="0">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.amazon.podcast.views.ActionBarView
                        android:id="@+id/action_bar_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <com.amazon.podcast.views.EmberTextView
                        android:id="@+id/podcast_feature_single_row_item_label"
                        android:background="@color/primary_glass_1"
                        android:paddingTop="@dimen/podcast_spacer_small"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/gutter_and_margin"
                        android:paddingEnd="@dimen/margin"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/action_bar_view"
                        style="@style/PodcastAppTheme.TextView.Headline4"/>
                    <com.amazon.podcast.views.episodeRowItemsListView.EpisodeRowItemView
                        android:id="@+id/podcast_featured_single_row_episode_item"
                        android:background="@color/primary_glass_1"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/podcast_feature_single_row_item_label"/>
                    <com.amazon.podcast.views.EmberTextView
                        android:id="@+id/latest_template_v2_header_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/podcast_spacer_large"
                        android:paddingEnd="@dimen/margin"
                        android:layout_marginStart="@dimen/gutter_and_margin"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/podcast_featured_single_row_episode_item"
                        style="@style/PodcastAppTheme.TextView.Headline4"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.appbar.CollapsingToolbarLayout>
        </com.google.android.material.appbar.AppBarLayout>
        <com.amazon.podcast.views.episodeRowItemsListView.EpisodeRowItemsListView
            android:id="@+id/podcast_latest_template_v2_episode_row_items_list_view"
            android:background="@color/transparent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/main.appbar"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
        <com.amazon.podcast.views.MessageView
            android:gravity="center"
            android:layout_gravity="top"
            android:id="@+id/podcast_latest_template_v2_message_view"
            android:paddingTop="@dimen/podcast_spacer_epic"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/podcast_latest_templates_v2_items_view"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
