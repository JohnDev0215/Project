<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.amazon.mp3.view.FixedWidthAspectImageView
        android:layout_gravity="center"
        android:id="@+id/ripple1"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/station_ripple"
        android:scaleType="fitCenter"/>
    <com.amazon.mp3.view.FixedWidthAspectImageView
        android:layout_gravity="center"
        android:id="@+id/ripple2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/station_ripple"
        android:scaleType="fitCenter"/>
    <com.amazon.mp3.view.FixedWidthAspectImageView
        android:layout_gravity="center"
        android:id="@+id/ripple3"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/station_ripple"
        android:scaleType="fitCenter"/>
    <com.amazon.mp3.view.FixedWidthAspectImageView
        android:layout_gravity="center"
        android:id="@+id/ripple4"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/station_ripple"
        android:scaleType="fitCenter"/>
    <com.amazon.mp3.view.FixedWidthAspectImageView
        android:layout_gravity="center"
        android:id="@+id/station_wings"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/station_starting_wings"
        android:scaleType="centerInside"/>
    <com.amazon.mp3.view.FixedWidthAspectImageView
        android:layout_gravity="center"
        android:id="@+id/station_dot"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/station_dot"
        android:scaleType="center"/>
</merge>
