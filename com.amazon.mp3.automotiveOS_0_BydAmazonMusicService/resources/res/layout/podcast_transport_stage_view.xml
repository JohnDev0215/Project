<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/podcast_spacer_large"
    android:layout_marginBottom="@dimen/podcast_spacer_base">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/first_row_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageButton
            android:layout_gravity="center_vertical"
            android:id="@+id/podcast_rewind"
            android:background="@color/transparent"
            android:layout_width="@dimen/podcast_stage_rewind_icon_dimension"
            android:layout_height="@dimen/podcast_stage_rewind_icon_dimension"
            android:src="@drawable/ic_playback_rewind"/>
        <ImageButton
            android:layout_gravity="center_vertical"
            android:id="@+id/podcast_playpause"
            android:background="@drawable/button_circle"
            android:layout_width="@dimen/podcast_stage_play_pause_icon_dimension"
            android:layout_height="@dimen/podcast_stage_play_pause_icon_dimension"
            android:layout_marginLeft="@dimen/podcast_spacer_huge2x"
            android:layout_marginRight="@dimen/podcast_spacer_huge2x"
            android:src="@drawable/ic_other_loader"/>
        <ImageButton
            android:layout_gravity="center_vertical"
            android:id="@+id/podcast_fast_forward"
            android:background="@color/transparent"
            android:layout_width="@dimen/podcast_stage_fast_forward_icon_dimension"
            android:layout_height="@dimen/podcast_stage_fast_forward_icon_dimension"
            android:src="@drawable/ic_playback_fast_forward"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/second_row_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/podcast_spacer_huge"
        android:layout_below="@+id/first_row_controls">
        <com.amazon.podcast.views.EmberTextView
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/podcast_speed"
            android:background="@drawable/button_circle"
            android:padding="@dimen/podcast_spacer_mini"
            android:layout_width="@dimen/podcast_playback_speed_icon_dimension"
            android:layout_height="@dimen/podcast_playback_speed_icon_dimension"
            android:layout_marginRight="@dimen/podcast_spacer_base"
            style="@style/PodcastAppTheme.TextView.OverlayTextStyle"/>
        <ImageButton
            android:layout_gravity="center_vertical"
            android:id="@+id/podcast_sleep_timer"
            android:background="@drawable/button_circle"
            android:layout_width="@dimen/podcast_sleep_icon_dimension"
            android:layout_height="@dimen/podcast_sleep_icon_dimension"
            android:layout_marginRight="@dimen/podcast_spacer_base"
            android:src="@drawable/ic_playback_sleeptimer"
            android:contentDescription="@string/podcast_sleep_timer_label"/>
        <ImageButton
            android:layout_gravity="center_vertical"
            android:id="@+id/now_playing_share_button"
            android:background="@drawable/button_circle"
            android:visibility="gone"
            android:layout_width="@dimen/podcast_stage_sharing_icon_dimension"
            android:layout_height="@dimen/podcast_stage_sharing_icon_dimension"
            android:layout_marginRight="@dimen/podcast_spacer_base"
            android:src="@drawable/ic_stage_share"/>
        <ImageButton
            android:layout_gravity="center_vertical"
            android:id="@+id/now_playing_casting_button"
            android:background="@drawable/button_circle"
            android:visibility="visible"
            android:layout_width="@dimen/podcast_stage_casting_icon_dimension"
            android:layout_height="@dimen/podcast_stage_casting_icon_dimension"
            android:layout_marginRight="@dimen/podcast_spacer_base"
            android:src="@drawable/ic_stage_castoff"/>
        <ImageButton
            android:layout_gravity="center_vertical"
            android:id="@+id/now_playing_overflow_button"
            android:background="@drawable/button_circle"
            android:visibility="invisible"
            android:layout_width="@dimen/podcast_stage_overflow_icon_dimension"
            android:layout_height="@dimen/podcast_stage_overflow_icon_dimension"
            android:src="@drawable/ic_stage_overflow"
            android:layout_alignParentEnd="true"/>
    </LinearLayout>
</LinearLayout>
