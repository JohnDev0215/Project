<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center_vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:gravity="start|center_vertical"
        android:id="@+id/notification_bar_icon"
        android:layout_width="@dimen/notification_icon_width"
        android:layout_height="match_parent"
        android:src="@drawable/ic_notification_tray_error"
        android:scaleType="center"
        android:layout_alignParentStart="true"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toEndOf="@+id/notification_bar_icon">
        <TextView
            android:ellipsize="marquee"
            android:id="@+id/notification_bar_title"
            android:fadingEdge="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            style="@style/NotificationTitle"/>
        <TextView
            android:ellipsize="marquee"
            android:id="@+id/notification_bar_text"
            android:fadingEdge="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            style="@style/NotificationText"/>
    </LinearLayout>
</RelativeLayout>
