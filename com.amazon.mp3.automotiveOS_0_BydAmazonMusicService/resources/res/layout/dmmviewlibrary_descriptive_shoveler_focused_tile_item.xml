<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tile_container"
    android:clipToPadding="true"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:layout_gravity="center"
        android:id="@+id/tile_image_card_view"
        android:layout_width="@dimen/artwork_dimen_compact"
        android:layout_height="@dimen/artwork_dimen_compact"
        android:layout_marginLeft="@dimen/spacer_12"
        android:layout_marginTop="@dimen/spacer_12"
        android:layout_marginRight="@dimen/spacer_12"
        android:layout_marginBottom="@dimen/spacer_12"
        app:cardCornerRadius="@dimen/spacer_4"
        app:cardElevation="@dimen/descriptive_shoveler_focused_tile_image_elevation"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/tile_image"
            android:layout_width="@dimen/artwork_dimen_compact"
            android:layout_height="@dimen/artwork_dimen_compact"/>
        <ImageView
            android:id="@+id/tile_image_border"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </androidx.cardview.widget.CardView>
    <TextView
        android:textSize="@dimen/text_size_15"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/primary_text"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/spacer_12"
        android:layout_marginRight="@dimen/spacer_12"
        android:maxLines="2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/tile_image_card_view"
        app:layout_constraintTop_toTopOf="parent"
        style="AmazonMusic.EmberRegularText"/>
</androidx.constraintlayout.widget.ConstraintLayout>
