<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/PlayerCoverViewRoot"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/AlbumArtAndSeekBarContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">
            <com.amazon.mp3.view.AlbumArtAndSeekBarLayout
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/AlbumArtAndSeekBar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
        <com.amazon.mp3.view.player.PlayerMetadataView
            android:id="@+id/player_metadata"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="@+id/NowPlayingPersistentPlayerContainer"
            app:layout_constraintStart_toStartOf="@+id/NowPlayingPersistentPlayerContainer"
            app:layout_constraintTop_toBottomOf="@+id/AlbumArtAndSeekBarContainer"/>
        <FrameLayout
            android:id="@+id/NowPlayingPersistentPlayerContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/player_metadata"/>
        <LinearLayout
            android:id="@+id/ads_upsell_banner"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/NowPlayingPersistentPlayerContainer"
            app:layout_constraintStart_toStartOf="@+id/NowPlayingPersistentPlayerContainer">
            <include layout="@layout/bauhaus_banner"/>
        </LinearLayout>
        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:layout_gravity="center"
            android:id="@+id/toast_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/NowPlayingPersistentPlayerContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.amazon.mp3.view.TooltipView
        android:layout_gravity="end"
        android:id="@+id/TooltipDisplayerContainer"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacer_2"/>
</FrameLayout>
