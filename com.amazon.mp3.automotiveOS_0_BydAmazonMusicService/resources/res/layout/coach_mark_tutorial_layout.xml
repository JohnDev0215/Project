<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/secondary_glass_4"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.amazon.music.explore.views.videoPreview.CoachMarkCircleView
        android:id="@+id/coach_mark_circle_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/coach_mark_tutorial_arrow"
        android:background="@drawable/coach_mark_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/coach_mark_text_container"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/coach_mark_text_container"
        android:background="@color/coach_mark_text_container_background"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <TextView
            android:textSize="@dimen/text_h4"
            android:textColor="@color/primary"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/coach_mark_tutorial_primary_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacer_huge"
            android:layout_marginBottom="@dimen/spacer_base"
            android:text="@string/coach_mark_primary_text"/>
        <TextView
            android:textSize="@dimen/text_t1"
            android:textColor="@color/primary"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/coach_mark_tutorial_secondary_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacer_base"
            android:text="@string/coach_mark_secondary_text"
            android:layout_marginStart="@dimen/spacer_epic"
            android:layout_marginEnd="@dimen/spacer_epic"/>
        <TextView
            android:textSize="@dimen/text_t1"
            android:textColor="@color/primary"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/coach_mark_tutorial_tertiary_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacer_large"
            android:text="@string/coach_mark_tertiary_text"/>
        <com.amazon.ui.foundations.views.BaseButton
            android:layout_gravity="center"
            android:id="@+id/accept_button"
            android:layout_width="144dp"
            android:layout_height="@dimen/spacer_epic"
            android:layout_marginBottom="54dp"/>
    </LinearLayout>
</RelativeLayout>
