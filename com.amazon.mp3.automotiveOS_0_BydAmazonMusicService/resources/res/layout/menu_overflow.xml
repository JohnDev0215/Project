<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/overflow_menu"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/connect_device"
        android:background="@drawable/menu_option"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dmusic_menu_connect_device"
        android:drawablePadding="20dp"
        android:drawableStart="@drawable/ic_casting_inactive"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/settings"
        android:background="@drawable/menu_option"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dmusic_download_goto_music_settings"
        android:drawablePadding="20dp"
        android:drawableStart="@drawable/ic_nav_settings"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/my_profile"
        android:background="@drawable/menu_option"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dmusic_my_profile"
        android:drawablePadding="20dp"
        android:drawableStart="@drawable/user_profile_icon"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/store"
        android:background="@drawable/menu_option"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dmusic_menu_store"
        android:drawablePadding="20dp"
        android:drawableStart="@drawable/ic_store"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/contact_customer_support"
        android:background="@drawable/menu_option"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dmusic_setting_contact_us_title"
        android:drawablePadding="20dp"
        android:drawableStart="@drawable/ic_action_contact_support"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/car_mode_ingress"
        android:background="@drawable/menu_option"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dmusic_settings_car_mode_title"
        android:drawablePadding="20dp"
        android:drawableStart="@drawable/ic_icon_car_overflow_menu"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/playback_test_page"
        android:background="@drawable/menu_option"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dmusic_setting_dev_open_rn_playback_test_page"
        android:drawablePadding="20dp"
        app:drawableStartCompat="@drawable/play_10"/>
</LinearLayout>
