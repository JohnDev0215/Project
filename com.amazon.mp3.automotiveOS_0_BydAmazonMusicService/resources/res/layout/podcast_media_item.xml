<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/podcast_media_item_view"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:foreground="@drawable/ripple"
    android:layout_marginStart="@dimen/podcast_spacer_mini"
    android:layout_marginEnd="@dimen/podcast_spacer_mini">
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/media_item_main_display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/media_item_outline"
                android:background="@drawable/blue_highlight_outline_rounded_corners"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"/>
            <ImageView
                android:id="@+id/media_item_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/media_item_duration_display"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/podcast_spacer_mini"
            android:layout_below="@+id/media_item_main_display"
            android:layout_marginStart="@dimen/podcast_small_item_duration_offset">
            <ImageView
                android:id="@+id/media_item_duration_play_icon"
                android:layout_width="@dimen/podcast_spacer_small"
                android:layout_height="@dimen/podcast_spacer_small"
                android:src="@drawable/ic_play"
                android:scaleType="centerInside"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>
            <com.amazon.podcast.views.EmberTextView
                android:textColor="@color/primary"
                android:id="@+id/media_item_duration_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/podcast_spacer_mini"
                android:layout_toEndOf="@+id/media_item_duration_play_icon"
                style="@style/PodcastAppTheme.TextView.Secondary"/>
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>
