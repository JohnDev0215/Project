<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginLeft="@dimen/podcast_card_outside_left_margin"
    android:layout_marginRight="@dimen/podcast_card_outside_right_margin"
    android:keepScreenOn="true"
    android:importantForAccessibility="no">
    <androidx.cardview.widget.CardView
        android:id="@+id/podcast_card_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        app:cardCornerRadius="@dimen/podcast_corner_radius_large"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/podcast_card_artwork_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:layout_centerVertical="true"/>
        <ImageView
            android:background="@color/secondary_glass_4"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:layout_centerVertical="true"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/podcast_card_now_playing_artwork"
                android:layout_width="@dimen/podcast_card_image_placeholder_dimension"
                android:layout_height="@dimen/podcast_card_image_placeholder_dimension"
                android:src="@drawable/podcast_empty_state_image"
                android:scaleType="centerCrop"
                android:contentDescription="@string/podcast_card_now_playing_artwork"
                android:importantForAccessibility="no"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/podcast_card_now_playing_primary_button"
                android:background="@drawable/accent_rounded_corners"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/podcast_button_medium"
                android:layout_marginTop="@dimen/podcast_spacer_base"
                android:contentDescription="@string/podcast_card_now_playing_primary_button">
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="@dimen/podcast_icon_button_tiny"
                    android:layout_height="@dimen/podcast_icon_button_tiny"
                    android:src="@drawable/ic_play"
                    android:scaleType="centerInside"
                    android:tint="@color/secondary"
                    android:paddingStart="@dimen/podcast_spacer_small"/>
                <com.amazon.podcast.views.EmberTextView
                    android:textColor="@color/secondary"
                    android:layout_gravity="center"
                    android:id="@+id/podcast_card_primary_button_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/podcast_play_episode"
                    android:textAlignment="center"
                    android:layout_marginStart="@dimen/podcast_spacer_mini"
                    android:layout_marginEnd="@dimen/podcast_spacer_base"
                    style="@style/PodcastAppTheme.TextView.Secondary"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/podcast_card_save_button"
                android:background="@color/transparent"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/podcast_button_medium"
                android:layout_marginTop="@dimen/podcast_spacer_micro">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/podcast_card_save_button_icon"
                    android:layout_width="@dimen/podcast_icon_button_tiny"
                    android:layout_height="@dimen/podcast_icon_button_tiny"
                    android:src="@drawable/ic_action_add"
                    android:scaleType="centerInside"
                    android:tint="@color/podcast_accent"
                    android:paddingStart="@dimen/podcast_spacer_small"/>
                <com.amazon.podcast.views.EmberTextView
                    android:textColor="@color/podcast_accent"
                    android:layout_gravity="center"
                    android:id="@+id/podcast_card_save_button_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add Episode to Playlist"
                    android:textAlignment="center"
                    android:layout_marginStart="@dimen/podcast_spacer_mini"
                    android:layout_marginEnd="@dimen/podcast_spacer_base"
                    style="@style/PodcastAppTheme.TextView.Secondary"/>
            </LinearLayout>
            <com.amazon.podcast.views.EmberTextView
                android:textColor="@color/primary"
                android:gravity="center"
                android:id="@+id/podcast_card_follow_button"
                android:background="@drawable/primary_outline_rounded_corners"
                android:paddingLeft="@dimen/podcast_spacer_base"
                android:paddingRight="@dimen/podcast_spacer_base"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/podcast_button_medium"
                android:layout_marginTop="@dimen/podcast_spacer_base"
                android:text="Follow this show"
                android:textAlignment="center"
                style="@style/PodcastAppTheme.TextView.Secondary"/>
            <RelativeLayout
                android:id="@+id/podcast_card_transcript"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/podcast_card_bottom_margin"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/podcast_card_left_margin"
            android:layout_marginEnd="@dimen/podcast_card_right_margin">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/podcast_card_episode_podcast_titles_metadata"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="yes">
                <com.amazon.podcast.views.EmberTextView
                    android:id="@+id/podcast_card_primary_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/podcast_spacer_micro"
                    android:maxLines="2"
                    android:contentDescription="@string/podcast_card_now_playing_title_label"
                    style="@style/PodcastAppTheme.TextView.Headline4"/>
                <com.amazon.podcast.views.EmberTextView
                    android:id="@+id/podcast_card_secondary_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/podcast_spacer_micro"
                    android:maxLines="1"
                    android:contentDescription="@string/podcast_card_now_playing_subtitle_label"
                    style="@style/PodcastAppTheme.TextView.Secondary"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/podcast_card_description_metadata"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/podcast_spacer_huge"
                android:contentDescription="@string/podcast_card_now_playing_card_podcast_description"
                android:nestedScrollingEnabled="false">
                <com.amazon.podcast.views.EmberTextView
                    android:ellipsize="end"
                    android:id="@+id/podcast_card_description_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/podcast_spacer_micro"
                    android:maxLines="@integer/podcast_card_description_max_lines"
                    style="@style/PodcastAppTheme.TextView.Secondary"/>
                <com.amazon.podcast.views.EmberTextView
                    android:textColor="@color/primary"
                    android:id="@+id/podcast_card_description_read_more"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/podcast_read_more"
                    android:maxLines="1"
                    style="@style/PodcastAppTheme.TextView.Secondary"/>
            </LinearLayout>
            <ImageButton
                android:layout_gravity="end"
                android:id="@+id/podcast_card_overflow_button"
                android:background="@color/transparent"
                android:layout_width="@dimen/podcast_icon_button_tiny"
                android:layout_height="@dimen/podcast_icon_button_tiny"
                android:src="@drawable/podcast_ic_action_overflow_horizontal"
                android:tint="@color/white"
                android:layout_marginStart="@dimen/podcast_spacer_micro"/>
        </LinearLayout>
        <include
            android:id="@+id/podcast_card_about"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/podcast_card_about_overlay"/>
        <LinearLayout
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/podcast_card_bottom_margin"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/podcast_card_left_margin"
            android:layout_marginEnd="@dimen/podcast_card_right_margin">
            <ImageButton
                android:layout_gravity="center"
                android:id="@+id/podcast_card_mini_play_button"
                android:background="@drawable/primary_glass_2_rounded_corners"
                android:layout_width="@dimen/podcast_icon_button_tiny"
                android:layout_height="@dimen/podcast_icon_button_tiny"
                android:src="@drawable/ic_play"
                android:scaleType="centerInside"
                android:tint="@color/white"/>
            <com.amazon.podcast.views.EmberTextView
                android:layout_gravity="center"
                android:id="@+id/podcast_card_progress_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/podcast_card_now_playing_listened_duration_label"
                android:importantForAccessibility="no"
                android:layout_marginStart="@dimen/podcast_spacer_mini"
                style="@style/PodcastAppTheme.TextView.Primary"/>
            <com.amazon.podcast.views.EmberTextView
                android:layout_gravity="center"
                android:id="@+id/podcast_card_progress_duration_divider"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" / "
                android:importantForAccessibility="no"
                style="@style/PodcastAppTheme.TextView.Primary"/>
            <com.amazon.podcast.views.EmberTextView
                android:layout_gravity="center"
                android:id="@+id/podcast_card_duration_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/podcast_card_now_playing_total_duration_label"
                android:importantForAccessibility="no"
                style="@style/PodcastAppTheme.TextView.PrimaryItalicized"/>
        </LinearLayout>
        <LinearLayout
            android:background="@drawable/podcast_card_view_border"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
