<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/car_mode_gradient_orange_red"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.amazon.ui.foundations.views.BaseButton
        android:id="@+id/close_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacer_24"
        android:layout_marginEnd="@dimen/spacer_20"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/car_mode_welcome_car_experience_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacer_32"
        android:src="@drawable/car_mode_experience"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/close_button"/>
    <TextView
        android:id="@+id/car_mode_welcome_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/spacer_48"
        android:layout_marginTop="@dimen/spacer_32"
        android:layout_marginRight="@dimen/spacer_48"
        android:text="@string/dmusic_car_mode_welcome_title"
        android:layout_marginHorizontal="@dimen/spacer_48"
        app:layout_constraintTop_toBottomOf="@+id/car_mode_welcome_car_experience_image"/>
    <TextView
        android:id="@+id/car_mode_introduction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/spacer_48"
        android:layout_marginTop="@dimen/spacer_16"
        android:layout_marginRight="@dimen/spacer_48"
        android:text="@string/dmusic_car_mode_welcome_introduction"
        android:layout_marginHorizontal="@dimen/spacer_48"
        app:layout_constraintTop_toBottomOf="@+id/car_mode_welcome_title"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/presets_ingress_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/spacer_48"
        android:layout_marginRight="@dimen/spacer_48"
        android:layout_marginBottom="@dimen/spacer_32"
        android:layout_marginHorizontal="@dimen/spacer_48"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <com.amazon.ui.foundations.views.BaseButton
            android:id="@+id/onboarding_start_button"
            android:layout_width="@dimen/car_mode_onboarding_button_width"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacer_20"/>
        <com.amazon.ui.foundations.views.BaseButton
            android:id="@+id/welcome_dismiss_button"
            android:layout_width="@dimen/car_mode_onboarding_button_width"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
