<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <com.amazon.ui.foundations.views.BaseButton
        android:id="@+id/lyrics_feedback_close_button"
        android:layout_width="@dimen/tiny_icon_button"
        android:layout_height="@dimen/tiny_icon_button"
        android:layout_marginTop="@dimen/medium_padding"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/text_h4"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@+id/lyrics_feedback_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/medium_padding"
        android:text="@string/dmusic_context_report"
        android:fontFamily="@string/font_sharp_grotesk_semi_bold"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:id="@+id/lyrics_feedback_report_popup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/bauhaus_spacer_medium"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/lyrics_feedback_action_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lyrics_feedback_title"
        layout="@layout/lyrics_feedback_report_popup"/>
    <include
        android:id="@+id/lyrics_feedback_message_dialog"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/bauhaus_spacer_medium"
        app:layout_constraintBottom_toTopOf="@+id/lyrics_feedback_action_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lyrics_feedback_title"
        layout="@layout/lyrics_feedback_message_dialog"/>
    <com.amazon.music.views.library.views.BauhausLoadingView
        android:id="@+id/lyrics_feedback_loading_widget"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.amazon.ui.foundations.views.BaseButton
        android:id="@+id/lyrics_feedback_action_button"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_medium"
        android:layout_marginBottom="@dimen/standard_padding"
        android:layout_marginStart="@dimen/medium_padding"
        android:layout_marginEnd="@dimen/medium_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
