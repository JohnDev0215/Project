<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ViewStub
        android:id="@+id/HeaderViewStub"
        android:inflatedId="@+id/HeaderViewStub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <GridView
        android:id="@+id/ListView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/HeaderViewStub"
        style="@style/PrimeGrid"/>
    <include
        android:layout_width="match_parent"
        android:layout_height="@dimen/libary_loading_footer_height"
        android:layout_alignParentBottom="true"
        layout="@layout/library_listview_loading_footer"/>
</RelativeLayout>
