<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/download_notif_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:gravity="start|center_vertical"
            android:id="@+id/imgv_download_icon"
            android:layout_width="@dimen/notification_icon_width"
            android:layout_height="match_parent"
            android:src="@drawable/ic_notification_tray_downloading"
            android:scaleType="center"
            android:layout_alignParentStart="true"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_toStartOf="@+id/button_layout"
            android:layout_toEndOf="@+id/imgv_download_icon">
            <TextView
                android:textAppearance="@style/DownloadTitle"
                android:id="@+id/tv_download_title"
                android:paddingTop="@dimen/notification_text_padding_top"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/download_completed_notif_title"
                android:singleLine="true"
                android:textIsSelectable="false"/>
            <TextView
                android:textAppearance="@style/DownloadProgressStatus"
                android:id="@+id/tv_download_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/download_completed_notif_message"
                android:textIsSelectable="false"/>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
