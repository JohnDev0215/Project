<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:src="@drawable/splash_header_bg"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/pre_auth_splash_main"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/backgroundView"
            android:paddingLeft="@dimen/spacer_medium"
            android:paddingRight="@dimen/spacer_medium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:id="@+id/splash_title"
                android:layout_marginTop="220dp"
                android:text="@string/pre_auth_splash_title_t2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/SplashTitle"/>
            <TextView
                android:id="@+id/splash_title_description"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/pre_auth_splash_body_t2"
                android:layout_marginEnd="@dimen/spacer_medium"
                app:layout_constraintEnd_toStartOf="@+id/splash_title_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/splash_title"
                style="@style/SplashRegularText"/>
            <com.google.android.material.button.MaterialButton
                android:textColor="@color/black"
                android:id="@+id/splash_title_button"
                android:tag="title"
                android:paddingTop="@dimen/spacer_mini"
                android:paddingBottom="@dimen/spacer_mini"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="0dp"
                android:text="@string/pre_auth_splash_short_cta_t2"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:onClick="signInOnInteraction"
                android:textAllCaps="false"
                app:backgroundTint="@color/bauhaus_accent_primary_glass_1"
                app:cornerRadius="@dimen/spacer_medium"
                app:layout_constraintBottom_toBottomOf="@+id/splash_title_description"
                app:layout_constraintEnd_toEndOf="parent"/>
            <TextView
                android:gravity="center"
                android:id="@+id/splash_music_title"
                android:layout_marginTop="@dimen/spacer_epic"
                android:text="@string/pre_auth_splash_music_headline_t2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/splash_title_button"
                style="@style/SplashTitle"/>
            <com.google.android.material.button.MaterialButton
                android:textColor="@color/black"
                android:id="@+id/splash_music_button"
                android:tag="music"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacer_large"
                android:text="@string/pre_auth_splash_long_cta_t2"
                android:onClick="signInOnInteraction"
                android:textAllCaps="false"
                app:backgroundTint="@color/bauhaus_accent_primary_glass_1"
                app:cornerRadius="@dimen/spacer_medium"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/splash_music_title"/>
            <ImageView
                android:id="@+id/splash_music_image"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="@dimen/spacer_huge"
                android:src="@drawable/pre_auth_splash_music_subsection"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/splash_music_button"/>
            <ImageView
                android:layout_width="@dimen/spacer_medium"
                android:layout_height="@dimen/spacer_medium"
                android:src="@drawable/ic_other_song"
                android:layout_marginEnd="@dimen/spacer_micro"
                app:layout_constraintBottom_toBottomOf="@+id/splash_music_subsection_text1"
                app:layout_constraintEnd_toStartOf="@+id/splash_music_subsection_text1"
                app:layout_constraintTop_toTopOf="@+id/splash_music_subsection_text1"/>
            <TextView
                android:id="@+id/splash_music_subsection_text1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacer_large"
                android:text="@string/pre_auth_splash_music_bullet1_t2"
                android:fontFamily="@font/amazon_ember"
                android:layout_marginStart="@dimen/spacer_large"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/splash_music_image"
                style="@style/SplashRegularText3"/>
            <ImageView
                android:layout_width="@dimen/spacer_medium"
                android:layout_height="@dimen/spacer_medium"
                android:src="@drawable/ic_splash_playlist"
                android:layout_marginEnd="@dimen/spacer_micro"
                app:layout_constraintBottom_toBottomOf="@+id/splash_music_subsection_text2"
                app:layout_constraintEnd_toStartOf="@+id/splash_music_subsection_text2"
                app:layout_constraintTop_toTopOf="@+id/splash_music_subsection_text2"/>
            <TextView
                android:id="@+id/splash_music_subsection_text2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacer_large"
                android:text="@string/pre_auth_splash_music_bullet2_t2"
                android:layout_marginStart="@dimen/spacer_large"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/splash_music_subsection_text1"
                style="@style/SplashRegularText3"/>
            <ImageView
                android:layout_width="@dimen/spacer_medium"
                android:layout_height="@dimen/spacer_medium"
                android:src="@drawable/ic_microphone"
                android:layout_marginEnd="@dimen/spacer_micro"
                app:layout_constraintBottom_toBottomOf="@+id/splash_music_subsection_text3"
                app:layout_constraintEnd_toStartOf="@+id/splash_music_subsection_text3"
                app:layout_constraintTop_toTopOf="@+id/splash_music_subsection_text3"/>
            <TextView
                android:id="@+id/splash_music_subsection_text3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacer_large"
                android:text="@string/pre_auth_splash_music_bullet3_t2"
                android:layout_marginStart="@dimen/spacer_large"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/splash_music_subsection_text2"
                style="@style/SplashRegularText3"/>
            <TextView
                android:gravity="center"
                android:id="@+id/splash_podcast"
                android:layout_marginTop="@dimen/spacer_epic"
                android:text="@string/pre_auth_splash_podcast_headline_t2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/splash_music_subsection_text3"
                style="@style/SplashTitle"/>
            <ImageView
                android:id="@+id/splash_podcast_image"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="@dimen/spacer_large"
                android:src="@drawable/pre_auth_splash_podcast"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/splash_podcast"/>
            <TextView
                android:gravity="center"
                android:id="@+id/splash_live"
                android:layout_marginTop="@dimen/spacer_epic"
                android:text="@string/pre_auth_splash_live_headline_t2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/splash_podcast_image"
                style="@style/SplashTitle"/>
            <TextView
                android:gravity="center"
                android:id="@+id/splash_live_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/pre_auth_splash_live_subheadline_t2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/splash_live"
                style="@style/SplashRegularText"/>
            <com.google.android.material.button.MaterialButton
                android:textColor="@color/black"
                android:id="@+id/splash_live_button"
                android:tag="live"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacer_large"
                android:text="@string/pre_auth_splash_long_cta_t2"
                android:onClick="signInOnInteraction"
                android:textAllCaps="false"
                app:backgroundTint="@color/bauhaus_accent_primary_glass_1"
                app:cornerRadius="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/splash_live_description"/>
            <ImageView
                android:id="@+id/splash_live_barker"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="@dimen/spacer_huge"
                android:src="@drawable/pre_auth_splash_live_music"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/splash_live_button"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/splash_signin_container"
                android:background="@drawable/splash_signin_bg"
                android:paddingTop="@dimen/spacer_huge"
                android:paddingBottom="@dimen/spacer_huge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacer_epic"
                android:layout_marginBottom="@dimen/spacer_huge"
                android:onClick="signInOnInteraction"
                android:paddingStart="@dimen/spacer_base"
                android:paddingEnd="@dimen/spacer_medium"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/splash_live_barker">
                <TextView
                    android:gravity="center"
                    android:id="@+id/splash_signin_title"
                    android:text="@string/pre_auth_splash_signin_headline_t2"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/SplashTitle"/>
                <TextView
                    android:gravity="center"
                    android:id="@+id/splash_signin_description"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacer_micro"
                    android:text="@string/pre_auth_splash_signin_subheadline_t2"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/splash_signin_title"
                    style="@style/SplashRegularText"/>
                <View
                    android:id="@+id/splash_signin_divider"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="@dimen/spacer_huge"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/splash_signin_description"/>
                <TextView
                    android:id="@+id/splash_signin_text1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacer_large"
                    android:text="@string/pre_auth_splash_signin_bullet1_t2"
                    android:drawablePadding="@dimen/spacer_micro"
                    android:layout_marginStart="@dimen/spacer_large"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/splash_signin_divider"
                    style="@style/SplashRegularText3"/>
                <ImageView
                    android:layout_width="@dimen/spacer_medium"
                    android:layout_height="@dimen/spacer_medium"
                    android:src="@drawable/ic_checkmark"
                    android:layout_marginEnd="@dimen/spacer_micro"
                    app:layout_constraintBottom_toBottomOf="@+id/splash_signin_text1"
                    app:layout_constraintEnd_toStartOf="@+id/splash_signin_text1"
                    app:layout_constraintTop_toTopOf="@+id/splash_signin_text1"/>
                <TextView
                    android:id="@+id/splash_signin_text2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacer_mini"
                    android:text="@string/pre_auth_splash_signin_bullet2_t2"
                    android:drawablePadding="@dimen/spacer_micro"
                    android:layout_marginStart="@dimen/spacer_large"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/splash_signin_text1"
                    style="@style/SplashRegularText3"/>
                <ImageView
                    android:layout_width="@dimen/spacer_medium"
                    android:layout_height="@dimen/spacer_medium"
                    android:src="@drawable/ic_checkmark"
                    android:layout_marginEnd="@dimen/spacer_micro"
                    app:layout_constraintBottom_toBottomOf="@+id/splash_signin_text2"
                    app:layout_constraintEnd_toStartOf="@+id/splash_signin_text2"
                    app:layout_constraintTop_toTopOf="@+id/splash_signin_text2"/>
                <TextView
                    android:id="@+id/splash_signin_text3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacer_mini"
                    android:text="@string/pre_auth_splash_signin_bullet3_t2"
                    android:drawablePadding="@dimen/spacer_micro"
                    android:layout_marginStart="@dimen/spacer_large"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/splash_signin_text2"
                    style="@style/SplashRegularText3"/>
                <ImageView
                    android:layout_width="@dimen/spacer_medium"
                    android:layout_height="@dimen/spacer_medium"
                    android:src="@drawable/ic_checkmark"
                    android:layout_marginEnd="@dimen/spacer_micro"
                    app:layout_constraintBottom_toBottomOf="@+id/splash_signin_text3"
                    app:layout_constraintEnd_toStartOf="@+id/splash_signin_text3"
                    app:layout_constraintTop_toTopOf="@+id/splash_signin_text3"/>
                <TextView
                    android:id="@+id/splash_signin_text4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacer_mini"
                    android:text="@string/pre_auth_splash_signin_bullet4_t2"
                    android:drawablePadding="@dimen/spacer_micro"
                    android:layout_marginStart="@dimen/spacer_large"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/splash_signin_text3"
                    style="@style/SplashRegularText3"/>
                <ImageView
                    android:layout_width="@dimen/spacer_medium"
                    android:layout_height="@dimen/spacer_medium"
                    android:src="@drawable/ic_checkmark"
                    android:layout_marginEnd="@dimen/spacer_micro"
                    app:layout_constraintBottom_toBottomOf="@+id/splash_signin_text4"
                    app:layout_constraintEnd_toStartOf="@+id/splash_signin_text4"
                    app:layout_constraintTop_toTopOf="@+id/splash_signin_text4"/>
                <com.google.android.material.button.MaterialButton
                    android:textColor="@color/black"
                    android:id="@+id/splash_signin_button"
                    android:tag="signin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacer_large"
                    android:text="@string/pre_auth_splash_long_cta_t2"
                    android:onClick="signInOnInteraction"
                    android:textAllCaps="false"
                    app:backgroundTint="@color/bauhaus_accent_primary_glass_1"
                    app:cornerRadius="20dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/splash_signin_text4"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
