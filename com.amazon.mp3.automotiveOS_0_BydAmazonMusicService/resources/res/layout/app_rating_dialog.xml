<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/source_toggle_row_color"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_gravity="start"
        android:orientation="vertical"
        android:padding="@dimen/dialog_outside_margin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dmusic_rating_prompt_title"
            style="@style/DialogTitleText"/>
        <TextView
            android:id="@+id/body"
            android:paddingTop="@dimen/dialog_text_top_padding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dmusic_rating_prompt_text"
            style="@style/DialogBodyText"/>
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="@dimen/dialog_small_border_padding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:gravity="end|center_vertical"
                android:id="@+id/app_rating_rate_button"
                android:background="@drawable/source_toggle_row_color"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dialog_vertical_button_height"
                android:text="@string/dmusic_rating_prompt_rate_button"
                android:paddingEnd="@dimen/dialog_button_right_margin"
                style="@style/DialogButtonText"/>
            <Button
                android:gravity="end|center_vertical"
                android:id="@+id/app_rating_not_now_button"
                android:background="@drawable/source_toggle_row_color"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dialog_vertical_button_height"
                android:text="@string/dmusic_rating_prompt_not_now_button"
                android:paddingEnd="@dimen/dialog_button_right_margin"
                style="@style/DialogButtonText"/>
            <Button
                android:gravity="end|center_vertical"
                android:id="@+id/app_rating_dismiss_button"
                android:background="@drawable/source_toggle_row_color"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dialog_vertical_button_height"
                android:text="@string/dmusic_rating_prompt_dismiss_button"
                android:paddingEnd="@dimen/dialog_button_right_margin"
                style="@style/DialogButtonText"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
