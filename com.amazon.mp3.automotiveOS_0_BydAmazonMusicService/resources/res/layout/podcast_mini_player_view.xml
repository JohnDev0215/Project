<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:contentDescription="@string/podcast_mini_player_label">
    <ImageView
        android:id="@+id/mini_player_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:layout_alignTop="@+id/top_padding"
        android:layout_alignBottom="@+id/bottom_padding"
        android:layout_centerVertical="true"/>
    <ImageView
        android:id="@+id/mini_player_background_filter"
        android:background="@color/secondary_glass_3"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:layout_alignTop="@+id/top_padding"
        android:layout_alignBottom="@+id/bottom_padding"
        android:layout_centerVertical="true"/>
    <ImageView
        android:id="@+id/mini_player_background_gradient"
        android:background="@drawable/gradient1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:layout_alignTop="@+id/top_padding"
        android:layout_alignBottom="@+id/bottom_padding"
        android:layout_centerVertical="true"/>
    <View
        android:id="@+id/top_padding"
        android:layout_width="match_parent"
        android:layout_height="@dimen/podcast_spacer_base"
        android:layout_alignParentTop="true"/>
    <ImageView
        android:id="@+id/mini_player_artwork"
        android:layout_width="@dimen/podcast_medium_icon_button"
        android:layout_height="@dimen/podcast_medium_icon_button"
        android:layout_below="@+id/top_padding"
        android:layout_marginStart="@dimen/podcast_spacer_base"
        android:layout_marginEnd="@dimen/podcast_spacer_base"
        android:layout_alignParentStart="true"/>
    <ImageView
        android:id="@+id/mini_player_artwork_overlay"
        android:visibility="gone"
        android:layout_width="@dimen/podcast_medium_icon_button"
        android:layout_height="@dimen/podcast_medium_icon_button"
        android:src="@drawable/mini_player_artwork_rounded_corner"
        android:layout_below="@+id/top_padding"
        android:layout_marginStart="@dimen/podcast_spacer_base"
        android:layout_marginEnd="@dimen/podcast_spacer_base"
        android:layout_alignParentStart="true"/>
    <ImageView
        android:id="@+id/mini_player_minimize"
        android:visibility="gone"
        android:layout_width="@dimen/podcast_medium_icon_button"
        android:layout_height="@dimen/podcast_medium_icon_button"
        android:src="@drawable/ic_chevron_caretdown"
        android:scaleType="center"
        android:layout_below="@+id/top_padding"
        android:layout_marginStart="@dimen/podcast_spacer_base"
        android:layout_marginEnd="@dimen/podcast_spacer_base"
        android:layout_alignParentStart="true"/>
    <ProgressBar
        android:id="@+id/mini_player_progress_bar"
        android:layout_alignTop="@+id/mini_player_background"
        style="@style/PodcastAppTheme.NowPlaying.ProgressBarHorizontal"/>
    <View
        android:id="@+id/bottom_padding"
        android:layout_width="match_parent"
        android:layout_height="@dimen/podcast_spacer_base"
        android:layout_below="@+id/mini_player_artwork"/>
    <ImageButton
        android:id="@+id/mini_player_play_pause_button"
        android:background="@color/transparent"
        android:layout_width="@dimen/podcast_small_icon_button"
        android:layout_height="@dimen/podcast_small_icon_button"
        android:src="@drawable/ic_playback_play_mini_player"
        android:layout_alignTop="@+id/mini_player_artwork"
        android:layout_alignBottom="@+id/mini_player_artwork"
        android:layout_marginEnd="@dimen/podcast_spacer_mini"
        android:layout_toStartOf="@+id/mini_player_ff_button"/>
    <ImageButton
        android:id="@+id/mini_player_ff_button"
        android:background="@color/transparent"
        android:layout_width="@dimen/podcast_small_icon_button"
        android:layout_height="@dimen/podcast_small_icon_button"
        android:src="@drawable/ic_playback_fast_forward_mini_player"
        android:layout_alignTop="@+id/mini_player_artwork"
        android:layout_alignBottom="@+id/mini_player_artwork"
        android:layout_marginEnd="@dimen/podcast_spacer_base"
        android:layout_alignParentEnd="true"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/podcast_about_art_dimension"
        android:layout_alignTop="@+id/mini_player_artwork"
        android:layout_alignBottom="@+id/mini_player_artwork"
        android:layout_marginEnd="@dimen/podcast_spacer_base"
        android:layout_toStartOf="@+id/mini_player_play_pause_button"
        android:layout_toEndOf="@+id/mini_player_artwork">
        <com.amazon.podcast.views.EmberTextView
            android:ellipsize="marquee"
            android:gravity="center_vertical"
            android:id="@+id/mini_player_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/podcast_spacer_nano"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:marqueeRepeatLimit="marquee_forever"
            style="@style/PodcastAppTheme.TextView.Primary"/>
        <com.amazon.podcast.views.EmberTextView
            android:gravity="center_vertical"
            android:id="@+id/mini_player_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/podcast_spacer_nano"
            android:maxLines="1"
            style="@style/PodcastAppTheme.TextView.Secondary"/>
        <com.amazon.podcast.views.EmberTextView
            android:textStyle="bold"
            android:textColor="@color/blue_accent"
            android:gravity="center_vertical"
            android:id="@+id/mini_player_casting_device_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            style="@style/PodcastAppTheme.TextView.CastingDeviceName"/>
    </LinearLayout>
</RelativeLayout>
