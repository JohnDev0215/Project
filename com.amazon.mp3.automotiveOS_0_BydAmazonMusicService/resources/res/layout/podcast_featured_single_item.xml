<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/primary_glass_1"
    android:paddingBottom="@dimen/podcast_spacer_large"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="@drawable/ripple"
    android:paddingStart="@dimen/margin"
    android:paddingEnd="@dimen/margin">
    <com.amazon.podcast.views.EmberTextView
        android:layout_gravity="start"
        android:id="@+id/podcast_detail_template_featured_single_item_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/podcast_spacer_base"
        android:layout_marginBottom="@dimen/podcast_spacer_small"
        android:layout_marginStart="@dimen/gutter"
        android:layout_marginEnd="@dimen/gutter"
        style="@style/PodcastAppTheme.TextView.Headline4"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/podcast_detail_template_featured_single_item_label"
        android:layout_marginStart="@dimen/gutter">
        <RelativeLayout
            android:id="@+id/podcast_detail_template_featured_single_item_image_groups"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true">
            <ImageView
                android:id="@+id/podcast_detail_template_featured_single_item_image"
                android:layout_width="@dimen/podcast_featured_single_item_image_dimension"
                android:layout_height="@dimen/podcast_featured_single_item_image_dimension"
                android:layout_alignParentStart="true"/>
            <ImageView
                android:id="@+id/podcast_detail_template_featured_single_item_image_overlay"
                android:visibility="invisible"
                android:layout_width="@dimen/podcast_featured_single_item_image_dimension"
                android:layout_height="@dimen/podcast_featured_single_item_image_dimension"
                android:src="@drawable/podcast_detail_template_play_image_overlay"
                android:layout_alignTop="@+id/podcast_detail_template_featured_single_item_image"
                android:layout_alignStart="@+id/podcast_detail_template_featured_single_item_image"/>
            <ImageView
                android:id="@+id/podcast_detail_template_featured_single_item_image_equalizer"
                android:visibility="gone"
                android:layout_width="@dimen/podcast_featured_single_item_image_dimension"
                android:layout_height="@dimen/podcast_featured_single_item_image_dimension"
                android:src="@drawable/podcast_equalizer_primary"
                android:scaleType="center"
                android:layout_alignTop="@+id/podcast_detail_template_featured_single_item_image"
                android:layout_alignStart="@+id/podcast_detail_template_featured_single_item_image"/>
            <ProgressBar
                android:id="@+id/podcast_detail_template_featured_single_item_horizontal_progress_bar"
                android:visibility="invisible"
                android:layout_width="@dimen/podcast_featured_single_item_image_dimension"
                android:layout_height="@dimen/podcast_spacer_micro"
                android:indeterminate="false"
                android:progressDrawable="@drawable/detail_page_horizontal_progressbar_view"
                android:layout_alignBottom="@+id/podcast_detail_template_featured_single_item_image"
                style="?android:attr/progressBarStyleHorizontal"/>
            <ImageView
                android:id="@+id/podcast_detail_template_featured_single_item_small_icon"
                android:visibility="visible"
                android:layout_width="@dimen/podcast_spacer_large"
                android:layout_height="@dimen/podcast_spacer_large"
                android:layout_marginBottom="@dimen/podcast_spacer_micro"
                android:src="@drawable/ic_badge_playback"
                android:layout_alignBottom="@+id/podcast_detail_template_featured_single_item_image"
                android:layout_marginStart="@dimen/podcast_spacer_micro"/>
            <ImageView
                android:id="@+id/podcast_detail_template_featured_single_item_center_large_icon"
                android:visibility="invisible"
                android:layout_width="@dimen/podcast_detail_template_center_large_icon_dimension"
                android:layout_height="@dimen/podcast_detail_template_center_large_icon_dimension"
                android:src="@drawable/ic_play"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:gravity="start|center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/podcast_spacer_base"
            android:layout_marginEnd="@dimen/podcast_spacer_mini"
            android:layout_toStartOf="@+id/podcast_feature_single_item_download"
            android:layout_toEndOf="@+id/podcast_detail_template_featured_single_item_image_groups">
            <com.amazon.podcast.views.EmberTextView
                android:id="@+id/podcast_detail_template_featured_single_item_primary_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                style="@style/PodcastAppTheme.TextView.Primary"/>
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/podcast_spacer_nano"
                android:layout_below="@+id/podcast_detail_template_featured_single_item_primary_text">
                <com.amazon.podcast.views.EmberTextView
                    android:id="@+id/podcast_detail_template_featured_single_item_secondary_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    style="@style/PodcastAppTheme.TextView.TertiaryItalic"/>
                <com.amazon.podcast.views.EmberTextView
                    android:id="@+id/podcast_detail_template_featured_single_item_secondary_following_text"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_toEndOf="@+id/podcast_detail_template_featured_single_item_secondary_text"
                    style="@style/PodcastAppTheme.TextView.TertiaryItalic"/>
            </RelativeLayout>
        </RelativeLayout>
        <com.amazon.podcast.views.DownloadButtonSmall
            android:id="@+id/podcast_feature_single_item_download"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/podcast_feature_single_item_overflow"/>
        <ImageView
            android:id="@+id/podcast_feature_single_item_overflow"
            android:padding="@dimen/podcast_featured_single_item_icon_padding"
            android:layout_width="@dimen/podcast_featured_single_item_icon_dimension"
            android:layout_height="@dimen/podcast_featured_single_item_icon_dimension"
            android:src="@drawable/ic_more"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/gutter"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</RelativeLayout>
