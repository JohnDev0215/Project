<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/equalizer_band_label_spacing">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/divider"
            android:adjustViewBounds="true"/>
        <com.amazon.mp3.view.VerticalSeekBar
            android:layout_gravity="center"
            android:id="@+id/eq_slider"
            android:paddingTop="@dimen/equalizer_band_padding_tb"
            android:paddingBottom="@dimen/equalizer_band_padding_tb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:progress="@integer/equalizer_band_default_value"
            android:progressDrawable="@android:color/transparent"
            android:thumb="@drawable/thumb_image"
            android:paddingStart="@dimen/equalizer_band_padding_lr"
            android:paddingEnd="@dimen/equalizer_band_padding_lr"
            android:thumbTint="@color/white"/>
    </FrameLayout>
    <TextView
        android:textSize="@dimen/equalizer_hz_text_size"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/eq_band_hz_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/equalizer_hz_placeholder_text"
        android:includeFontPadding="false"/>
</LinearLayout>
