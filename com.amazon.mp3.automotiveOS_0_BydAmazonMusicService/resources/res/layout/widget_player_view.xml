<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/widget_base_background"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/AlbumArtFrame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true">
        <ImageView
            android:id="@+id/AlbumArt"
            android:layout_width="@dimen/player_album_art_width"
            android:layout_height="@dimen/player_album_art_height"
            android:src="@drawable/widget_player_placeholder"/>
    </FrameLayout>
    <RelativeLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/widget_container_height"
        android:layout_toRightOf="@+id/AlbumArtFrame"
        android:layout_centerInParent="true">
        <LinearLayout
            android:orientation="vertical"
            android:paddingLeft="@dimen/medium_padding"
            android:paddingRight="@dimen/medium_padding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/MusicLogo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/widget_logo_margin_left"
                android:layout_marginTop="@dimen/widget_logo_margin_top"
                android:src="@drawable/widget_player_logo"/>
            <TextView
                android:textSize="9sp"
                android:textColor="@color/widget_base_color"
                android:ellipsize="end"
                android:id="@+id/ArtistInfo"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scrollHorizontally="false"
                android:singleLine="true"
                android:marqueeRepeatLimit="marquee_forever"
                android:textAllCaps="true"/>
            <TextView
                android:textSize="@dimen/widget_song_info_text"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:id="@+id/SongInfo"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scrollHorizontally="false"
                android:singleLine="true"
                android:marqueeRepeatLimit="marquee_forever"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/playerControlsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/player_controls_margin_bottom"
            android:layout_alignParentBottom="true">
            <include layout="@layout/widget_player_controls"/>
        </FrameLayout>
    </RelativeLayout>
    <ImageView
        android:id="@+id/SongProgress"
        android:background="@color/widget_base_color"
        android:layout_width="match_parent"
        android:layout_height="@dimen/song_progress_height"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
