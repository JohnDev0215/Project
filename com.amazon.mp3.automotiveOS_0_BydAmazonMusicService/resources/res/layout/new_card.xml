<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/medium_text_size"
            android:textColor="@color/library_swatch_white"
            android:id="@+id/header"
            android:paddingTop="@dimen/prime_search_card_header_padding_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_4dp"
            android:paddingEnd="@dimen/prime_card_horiz_padding"
            android:layout_toStartOf="@+id/see_more"
            android:layout_alignParentStart="true"/>
        <TextView
            android:id="@+id/see_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dmusic_prime_search_result_see_all"
            android:layout_centerVertical="true"
            android:contentDescription="@string/see_all_link_content_description"
            android:layout_alignParentEnd="true"
            style="@style/AmazonMusic.SeeMoreText"/>
    </RelativeLayout>
    <TextView
        android:textSize="@dimen/small_text_size"
        android:textColor="?android:attr/textColorSecondary"
        android:id="@+id/subheader"
        android:paddingBottom="@dimen/spacing_16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/header_container"/>
    <Space
        android:id="@+id/empty_footer_placeholder"
        android:layout_width="match_parent"
        android:layout_height="@dimen/prime_search_card_empty_footer_height"
        android:layout_below="@+id/content"/>
</merge>
