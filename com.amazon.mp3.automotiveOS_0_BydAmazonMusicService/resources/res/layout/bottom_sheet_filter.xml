<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/filter_dialog"
    android:padding="@dimen/screen_margin"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@+id/clear_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dmusic_playlist_btn_clear_description"
        android:maxLines="1"
        android:textAllCaps="true"
        app:layout_constraintBottom_toBottomOf="@+id/dismiss_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/dismiss_button"
        style="@style/AmazonMusic.PillCellText"/>
    <FrameLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/dismiss_button"
        android:background="@drawable/pill_shape"
        android:paddingTop="@dimen/spacing_8dp"
        android:paddingBottom="@dimen/spacing_8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_24dp"
        android:foreground="@drawable/ripple_pill_shape"
        android:paddingStart="@dimen/spacing_8dp"
        android:paddingEnd="@dimen/spacing_8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/dimiss_button_view"
            android:layout_width="@dimen/prime_filter_icon_size"
            android:layout_height="@dimen/prime_filter_icon_size"
            android:src="@drawable/ic_action_cancel"/>
    </FrameLayout>
    <TextView
        android:textSize="@dimen/action_bar_title_text_size"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@+id/title_text"
        android:paddingBottom="@dimen/screen_margin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dmusic_prime_search_bottom_sheet_filter_title"
        android:maxLines="1"
        app:layout_constraintBottom_toTopOf="@+id/catalog_text"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:id="@+id/catalog_toggle_section"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/apply_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_text"/>
    <TextView
        android:textSize="@dimen/dialog_title_text_size"
        android:textColor="@color/white"
        android:id="@+id/catalog_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8dp"
        android:layout_marginBottom="@dimen/spacing_24dp"
        android:text="@string/dmusic_prime_search_bottom_sheet_catalog_search_title"
        android:maxLines="1"
        app:layout_constraintBottom_toTopOf="@+id/apply_button"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/AmazonMusic.MainText"/>
    <ToggleButton
        android:id="@+id/catalog_button"
        android:background="@drawable/toggle_btn_selector"
        android:layout_width="@dimen/prime_filter_icon_size"
        android:layout_height="@dimen/prime_filter_icon_size"
        app:layout_constraintBottom_toBottomOf="@+id/catalog_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/catalog_text"/>
    <FrameLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/apply_button"
        android:background="@drawable/pill_shape"
        android:paddingTop="@dimen/spacing_4dp"
        android:paddingBottom="@dimen/spacing_4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16dp"
        android:foreground="@drawable/ripple_pill_shape"
        android:backgroundTint="@color/blue_accent_60"
        android:backgroundTintMode="src_over"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textColor="@color/black"
            android:layout_gravity="center"
            android:id="@+id/search_text"
            android:paddingLeft="@dimen/pill_cell_padding_horizontal"
            android:paddingTop="@dimen/pill_cell_padding_vertical"
            android:paddingRight="@dimen/pill_cell_padding_horizontal"
            android:paddingBottom="@dimen/pill_cell_padding_vertical"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dmusic_prime_search_apply_text"
            style="@style/AmazonMusic.MainText"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
