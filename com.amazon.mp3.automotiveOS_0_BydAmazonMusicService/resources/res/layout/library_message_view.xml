<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@null"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/spacer_large"
    android:layout_centerInParent="true"
    android:layout_marginStart="@dimen/gutter"
    android:layout_marginEnd="@dimen/gutter">
    <RelativeLayout
        android:background="@null"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/message_primary_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/message_view_icon"
                android:visibility="gone"
                android:layout_width="@dimen/icon_small"
                android:layout_height="@dimen/icon_small"
                android:layout_marginEnd="@dimen/spacer_small"/>
            <com.amazon.music.curate.skyfire.views.EmberTextView
                android:gravity="center"
                android:id="@+id/message_view_primary_text"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/PrimaryText"/>
        </LinearLayout>
        <com.amazon.music.curate.skyfire.views.EmberTextView
            android:gravity="center"
            android:id="@+id/message_view_secondary_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacer_small"
            android:layout_below="@+id/message_primary_group"
            android:layout_centerHorizontal="true"
            style="@style/TertiaryText"/>
        <com.amazon.music.curate.skyfire.views.EmberTextView
            android:gravity="center"
            android:id="@+id/message_view_explore_button"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_medium"
            android:layout_marginTop="@dimen/spacer_small"
            android:layout_below="@+id/message_view_secondary_text"
            android:layout_centerHorizontal="true"
            android:paddingStart="@dimen/spacer_epic"
            android:paddingEnd="@dimen/spacer_epic"
            android:layout_marginStart="@dimen/gutter"
            android:layout_marginEnd="@dimen/gutter"
            style="@style/CurateTheme.TextView.ButtonMediumGlass"/>
    </RelativeLayout>
</RelativeLayout>
