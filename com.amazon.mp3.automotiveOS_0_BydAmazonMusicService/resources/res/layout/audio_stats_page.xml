<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/primo_blue"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="@dimen/spacing_24dp"
        android:paddingBottom="@dimen/spacing_24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/spacing_24dp"
        android:paddingEnd="@dimen/spacing_24dp">
        <TextView
            android:textAppearance="@style/NerdStatsDialogTitleText"
            android:gravity="center_vertical"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_8dp"
            android:text="@string/dmusic_audio_stats_title"/>
        <include
            android:id="@+id/preferences_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            layout="@layout/katana_recycler_view_widget"/>
        <View
            android:id="@+id/separatorTop"
            android:background="@color/dark_grey"
            android:layout_width="match_parent"
            android:layout_height="@dimen/audio_stats_widget_border"
            android:layout_marginTop="@dimen/spacing_8dp"
            android:layout_alignParentTop="true"
            android:layout_centerVertical="true"/>
        <TextView
            android:textAppearance="@style/NerdStatsDialogText"
            android:textColorLink="@color/vivace_blue"
            android:gravity="center_vertical"
            android:id="@+id/tv_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_20dp"
            android:text="@string/dmusic_audio_stats_hd_quality_message"/>
        <Button
            android:textSize="@dimen/text_size_small"
            android:textColor="@color/black"
            android:id="@+id/update_streaming_quality_button"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:text="@string/dmusic_audio_stats_update_streaming_quality_button"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textAllCaps="false"
            android:fontFamily="sans-serif"
            android:paddingStart="@dimen/spacing_24dp"
            android:paddingEnd="@dimen/spacing_24dp"
            android:backgroundTint="@color/audio_stats_btn_light_vivace"
            android:letterSpacing="0"/>
        <View
            android:id="@+id/separatorMiddle"
            android:background="@color/dark_grey"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/audio_stats_widget_border"
            android:layout_marginTop="@dimen/spacing_20dp"
            android:layout_alignParentTop="true"
            android:layout_centerVertical="true"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/immersiveContent"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8dp">
            <com.amazon.mp3.view.BadgeView
                android:text="@string/ivy_immersive_audio_badge"
                android:singleLine="true"
                android:contentDescription="@string/immersive_badge_description"
                style="@style/NerdStatsContentEncodingBadge"/>
            <TextView
                android:textSize="12sp"
                android:textColorLink="@color/vivace_blue"
                android:id="@+id/immersive_badge_nerd_stat_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/immersive_badge_nerd_stat_description"
                android:layout_marginStart="@dimen/spacing_4dp"/>
        </LinearLayout>
        <View
            android:id="@+id/separatorBottom"
            android:background="@color/dark_grey"
            android:layout_width="match_parent"
            android:layout_height="@dimen/audio_stats_widget_border"
            android:layout_marginTop="@dimen/spacing_20dp"
            android:layout_alignParentTop="true"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="@dimen/text_size_small"
            android:textColor="@color/vivace_blue"
            android:layout_gravity="end"
            android:id="@+id/got_it_button"
            android:background="@color/transparent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_20dp"
            android:text="@string/dmusic_got_it_button_text"/>
    </LinearLayout>
</ScrollView>
