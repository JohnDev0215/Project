<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/hint_view_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/grant_sdcard_permission_main_page_tab_margin_bottom"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        app:tabBackground="@drawable/tab_selector"
        app:tabIndicatorHeight="0dp"
        app:tabPaddingEnd="@dimen/grant_sdcard_permission_main_page_tab_padding"
        app:tabPaddingStart="@dimen/grant_sdcard_permission_main_page_tab_padding"/>
    <Button
        android:textAppearance="@style/TextAppearance.Medium"
        android:textSize="@dimen/grant_sdcard_permission_main_page_button_text_size"
        android:textColor="@color/grant_sdcard_permission_button_grey"
        android:id="@+id/skip_button"
        android:background="@color/transparent"
        android:layout_width="@dimen/grant_sdcard_permission_main_page_button_width"
        android:layout_height="@dimen/grant_sdcard_permission_main_page_button_height"
        android:layout_marginBottom="@dimen/grant_sdcard_permission_main_page_button_margin_bottom"
        android:text="@string/sdcard_storage_permission_activity_skip"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/grant_sdcard_permission_main_page_button_margin_start"
        android:layout_alignParentStart="true"/>
    <Button
        android:textAppearance="@style/TextAppearance.Medium"
        android:textSize="@dimen/grant_sdcard_permission_main_page_button_text_size"
        android:textColor="@color/grant_sdcard_permission_button_blue"
        android:id="@+id/next_button"
        android:background="@color/transparent"
        android:layout_width="@dimen/grant_sdcard_permission_main_page_button_width"
        android:layout_height="@dimen/grant_sdcard_permission_main_page_button_height"
        android:layout_marginBottom="@dimen/grant_sdcard_permission_main_page_button_margin_bottom"
        android:text="@string/sdcard_storage_permission_activity_next"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="@dimen/grant_sdcard_permission_main_page_button_margin_end"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
