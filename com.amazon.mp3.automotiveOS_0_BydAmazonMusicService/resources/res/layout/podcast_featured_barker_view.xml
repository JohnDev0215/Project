<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/featured_barker"
    android:paddingTop="@dimen/podcast_spacer_large"
    android:paddingBottom="@dimen/podcast_spacer_large"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="@drawable/ripple"
    android:paddingStart="@dimen/gutter"
    android:paddingEnd="@dimen/gutter"
    android:layout_marginStart="@dimen/margin"
    android:layout_marginEnd="@dimen/margin">
    <FrameLayout
        android:id="@+id/featured_barker_item"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/featured_barker_image_view"
            android:background="@drawable/primary_glass_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"/>
        <RelativeLayout
            android:layout_gravity="bottom"
            android:id="@+id/featured_horizontal_item"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/podcast_spacer_small"
            android:layout_marginBottom="@dimen/podcast_spacer_small"
            android:layout_marginStart="@dimen/podcast_spacer_small"
            android:layout_marginEnd="@dimen/podcast_spacer_small">
            <ImageView
                android:id="@+id/featured_horizontal_item_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>
            <RelativeLayout
                android:gravity="start|center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/podcast_spacer_base"
                android:layout_toEndOf="@+id/featured_horizontal_item_image">
                <com.amazon.podcast.views.EmberTextView
                    android:id="@+id/featured_horizontal_item_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/PodcastAppTheme.TextView.Label"/>
                <com.amazon.podcast.views.EmberTextView
                    android:ellipsize="end"
                    android:id="@+id/featured_horizontal_item_primary_text"
                    android:paddingTop="@dimen/podcast_spacer_nano"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:layout_below="@+id/featured_horizontal_item_label"
                    style="@style/PodcastAppTheme.TextView.Primary"/>
                <com.amazon.podcast.views.EmberTextView
                    android:id="@+id/featured_horizontal_item_secondary_text"
                    android:paddingTop="@dimen/podcast_spacer_nano"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:layout_below="@+id/featured_horizontal_item_primary_text"
                    style="@style/PodcastAppTheme.TextView.Tertiary"/>
            </RelativeLayout>
        </RelativeLayout>
    </FrameLayout>
</RelativeLayout>
