<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.amazon.podcast.views.EmberTextView
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/ptc_header_title"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/podcast_spacer_base"
        style="@style/PodcastAppTheme.TextView.Headline2"/>
    <com.amazon.podcast.views.EmberTextView
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/ptc_header_subtitle"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/podcast_spacer_huge"
        style="@style/PodcastAppTheme.TextView.Secondary"/>
</LinearLayout>
