<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:background="@color/refresh_base"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <ImageView
        android:id="@+id/logo_animation_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"/>
    <ImageView
        android:id="@+id/subscription_badge"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/logo_animation_flag_margin"
        android:layout_below="@+id/logo_animation_iv"
        android:layout_alignRight="@+id/logo_animation_iv"/>
    <ProgressBar
        android:id="@+id/progress_bar_thin"
        android:background="@drawable/inner_circle_progress_bar"
        android:layout_width="@dimen/circle_progress_bar_diameter"
        android:layout_height="@dimen/circle_progress_bar_diameter"
        android:layout_marginTop="32dp"
        android:progressDrawable="@drawable/circle_progress_bar"
        android:layout_below="@+id/logo_animation_iv"
        android:layout_centerHorizontal="true"
        style="?android:attr/progressBarStyleHorizontal"/>
    <TextView
        android:textSize="16dp"
        android:id="@+id/progress_welcome_text"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="@string/dmusic_welcome"
        android:layout_alignBottom="@+id/loading_video_view"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="12dp"
        android:id="@+id/progress_loading_message"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12dp"
        android:layout_below="@+id/progress_bar_thin"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
