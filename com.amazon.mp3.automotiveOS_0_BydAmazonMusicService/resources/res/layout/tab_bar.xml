                style="@style/tab_bar_text"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/tab_bar_tab_three"
            style="@style/tab_bar_tab">
            <ImageView
                android:id="@+id/tab_bar_image_three"
                style="@style/tab_bar_image"/>
            <TextView
                android:id="@+id/tab_bar_text_three"
                style="@style/tab_bar_text"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/tab_bar_tab_four"
            style="@style/tab_bar_tab">
            <ImageView
                android:id="@+id/tab_bar_image_four"
                style="@style/tab_bar_image"/>
            <TextView
                android:id="@+id/tab_bar_text_four"
                style="@style/tab_bar_text"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/tab_bar_tab_five"
            style="@style/tab_bar_tab">
            <ImageView
                android:id="@+id/tab_bar_image_five"
                style="@style/tab_bar_image"/>
            <TextView
                android:id="@+id/tab_bar_text_five"
                style="@style/tab_bar_text"/>
        </LinearLayout>
    </LinearLayout>
</merge>
