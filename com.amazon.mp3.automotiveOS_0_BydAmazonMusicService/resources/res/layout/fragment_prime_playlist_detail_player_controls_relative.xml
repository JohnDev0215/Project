<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include layout="@layout/cta_detail_page_button"/>
    <include layout="@layout/cta_detail_page_follow_button"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ButtonContainer"
        android:layout_width="match_parent"
        android:layout_height="@dimen/detail_player_height">
        <ImageView
            android:id="@+id/PlayButton"
            android:background="@drawable/ripple_background_no_mask"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_play_all"
            android:layout_weight="1"
            android:contentDescription="@string/play_all_content_description"
            style="@style/PlayerControlsButtonStyle"/>
        <ImageView
            android:id="@+id/ShuffleButton"
            android:background="@drawable/ripple_background_no_mask"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_shuffle_all"
            android:layout_weight="1"
            android:contentDescription="@string/turn_on_shuffle_content_description"
            style="@style/PlayerControlsButtonStyle"/>
        <ImageView
            android:id="@+id/StationFromAnythingButton"
            android:background="@drawable/ripple_background_no_mask"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_station_from_anything"
            android:layout_weight="1"
            android:contentDescription="@string/start_station_from_anything"
            style="@style/PlayerControlsButtonStyle"/>
        <ImageView
            android:id="@+id/ShareButton"
            android:background="@drawable/ripple_background_no_mask"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_action_share_toolbar"
            android:layout_weight="1"
            android:contentDescription="@string/dmusic_context_share_playlist"
            style="@style/PlayerControlsButtonStyle"/>
        <FrameLayout
            android:id="@+id/DownloadViews"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/PlayerControlsButtonStyle">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/DownloadButton"
                android:background="@drawable/ripple_background_no_mask"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_download"
                android:contentDescription="@string/download_all_content_description"/>
            <com.amazon.mp3.view.DownloadProgressBadgeView
                android:layout_gravity="center"
                android:id="@+id/DownloadProgress"
                android:padding="@dimen/player_controls_tap_target_spacing"
                android:visibility="gone"
                android:layout_width="@dimen/button_bar_download_circular_progress_bar_width"
                android:layout_height="@dimen/button_bar_download_circular_progress_bar_width"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/RefreshDownloadButton"
                android:background="@drawable/ripple_background_no_mask"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_download_fresh"
                android:contentDescription="@string/download_all_content_description"/>
        </FrameLayout>
        <ImageView
            android:id="@+id/DeleteButton"
            android:background="@drawable/ripple_background_no_mask"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_delete"
            android:layout_weight="1"
            android:contentDescription="@string/remove_all_content_description"
            style="@style/PlayerControlsButtonStyle"/>
        <ImageView
            android:id="@+id/AddOrFollowButton"
            android:background="@drawable/ripple_background_no_mask"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:src="@drawable/add_to_library_button"
            android:layout_weight="1"
            style="@style/PlayerControlsButtonStyle"/>
    </LinearLayout>
</LinearLayout>
