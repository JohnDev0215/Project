<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:amazonmp3="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/search_row_background"
    android:layout_width="match_parent"
    android:layout_height="@dimen/playlist_tile_detail_height"
    android:minHeight="@dimen/playlist_tile_detail_height">
    <com.amazon.music.views.library.views.FixedAspectImageView
        android:id="@+id/imageView"
        android:layout_width="@dimen/playlist_tile_art_size"
        android:layout_height="@dimen/playlist_tile_art_size"
        android:src="@drawable/playlist_placeholder"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/playlist_tile_art_indent"
        android:layout_alignParentStart="true"/>
    <com.amazon.mp3.view.PlayNotificationIcon
        android:layout_gravity="center"
        android:id="@+id/PlaystateIcon"
        android:background="@color/dimmed"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="center"
        android:layout_alignTop="@+id/imageView"
        android:layout_alignBottom="@+id/imageView"
        android:layout_alignStart="@+id/imageView"
        android:layout_alignEnd="@+id/imageView"
        amazonmp3:useLargeIcons="true"/>
    <include
        android:id="@+id/overflow_button_open"
        android:layout_width="@dimen/overflow_button_clickable_size"
        android:layout_height="@dimen/overflow_button_clickable_size"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"
        layout="@layout/overflow_button"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@+id/overflow_button_open"
        android:layout_toEndOf="@+id/imageView">
        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/PlaylistTilePrimaryText"/>
        <TextView
            android:ellipsize="end"
            android:id="@+id/description"
            android:paddingTop="@dimen/playlist_tile_description_spacing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            style="@style/SecondaryText"/>
    </LinearLayout>
</RelativeLayout>
