<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/ingress_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacer_mini">
        <ImageView
            android:id="@+id/ingress_header_icon"
            style="@style/SwipeablePages.IngressButton.TextIcon"/>
        <TextView
            android:id="@+id/ingress_header_text"
            android:fontFamily="@font/amazon_ember_it"
            android:layout_toEndOf="@+id/ingress_header_icon"
            style="@style/SwipeablePages.IngressButton.Text"/>
    </RelativeLayout>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/ingress_icon"
        android:layout_width="@dimen/spacer_medium"
        android:layout_height="@dimen/spacer_medium"
        android:src="@drawable/ic_chevron_caret_up"/>
</LinearLayout>
