<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/PrimeBannerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.amazon.mp3.view.PrimePlaylistBannerImageView
            android:id="@+id/PrimePlaylistDetailImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/playlist_placeholder_detail"/>
    </RelativeLayout>
    <RelativeLayout
        android:gravity="center"
        android:id="@+id/PrimePlaylistPlayerControlsFragment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/DescriptionContainer"
        android:padding="@dimen/medium_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/small_text_size"
            android:textColor="@color/grey"
            android:gravity="center"
            android:id="@+id/PrimePlaylistDescription"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="@dimen/browse_secondary_text_line_spacing"/>
        <TextView
            android:textColor="@color/blue_accent"
            android:gravity="center"
            android:id="@+id/CuratedByName"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""/>
    </LinearLayout>
    <View
        android:layout_marginStart="@dimen/divider_left_padding"
        android:layout_marginEnd="@dimen/divider_right_padding"
        style="@style/HorizontalSeparator"/>
</LinearLayout>
