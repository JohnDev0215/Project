<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:id="@+id/clearAllButton"
        android:padding="@dimen/margin_padding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dmusic_language_preference_button_clear_all"
        android:layout_alignParentStart="true"/>
    <TextView
        android:id="@+id/doneButton"
        android:padding="@dimen/margin_padding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dmusic_language_preference_button_done"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="@dimen/title_text_size"
        android:textColor="@color/white"
        android:id="@+id/musicPreferenceTitle"
        android:paddingTop="@dimen/title_padding_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dmusic_language_preference_title"
        android:layout_below="@+id/doneButton"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:id="@+id/musicPreferenceSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dmusic_language_preference_subtitle"
        android:layout_below="@+id/musicPreferenceTitle"
        android:layout_centerHorizontal="true"/>
    <ProgressBar
        android:id="@+id/loading_spinner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        style="@style/Widget.AmazonMP3.ProgressBar.Large"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/languagePreferenceList"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/musicPreferenceSubtitle"/>
</RelativeLayout>
