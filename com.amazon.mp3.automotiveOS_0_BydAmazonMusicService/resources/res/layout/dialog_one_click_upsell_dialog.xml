<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:padding="@dimen/dialog_outside_margin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/DialogTitleText"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/pure_white"
                    android:textColorLink="#4eb1ff"
                    android:id="@+id/message"
                    android:paddingTop="@dimen/dialog_text_top_padding"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <LinearLayout
                    android:layout_gravity="end"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/browse_dialog_margins"
                    android:layout_marginBottom="4dp">
                    <Button
                        android:layout_gravity="center_vertical"
                        android:id="@+id/cancel"
                        android:paddingLeft="@dimen/dialog_button_right_margin"
                        android:paddingRight="@dimen/dialog_button_right_margin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAllCaps="true"
                        android:layout_marginEnd="@dimen/dialog_button_right_margin"
                        style="@style/DialogSecondaryButton"/>
                    <Button
                        android:textColor="@color/pure_white"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/action"
                        android:paddingLeft="@dimen/dialog_button_right_margin"
                        android:paddingRight="@dimen/dialog_button_right_margin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAllCaps="true"
                        style="@style/DialogPrimaryButton"/>
                </LinearLayout>
            </LinearLayout>
            <com.amazon.mp3.view.SpannableTextView
                android:textSize="11sp"
                android:textColor="@color/pure_white"
                android:textColorLink="#4eb1ff"
                android:id="@+id/legal"
                android:padding="@dimen/dialog_text_top_padding"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </LinearLayout>
    </RelativeLayout>
</ScrollView>
