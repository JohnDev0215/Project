<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/artist_detail_header_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/label_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.amazon.music.views.library.views.PageHeaderHeadlineTextView
        android:id="@+id/header_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/label_text"/>
    <TextView
        android:id="@+id/follower_count_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_text"/>
    <com.amazon.ui.foundations.views.BaseButton
        android:id="@+id/play_icon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/content_description_play_all_button"/>
    <com.amazon.ui.foundations.views.BaseButton
        android:id="@+id/shuffle_icon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/content_description_shuffle_button"/>
    <com.amazon.ui.foundations.views.BaseButton
        android:id="@+id/station_icon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/content_description_play_station_button"
        app:layout_constraintStart_toEndOf="@+id/shuffle_icon"
        app:layout_constraintTop_toTopOf="@+id/shuffle_icon"/>
    <com.amazon.ui.foundations.views.BaseButton
        android:id="@+id/overflow_icon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/content_description_overflow_button"
        app:layout_constraintStart_toEndOf="@+id/station_icon"
        app:layout_constraintTop_toTopOf="@+id/station_icon"/>
    <com.amazon.ui.foundations.views.BaseButton
        android:id="@+id/large_follow_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/play_icon"/>
    <com.amazon.ui.foundations.views.BaseButton
        android:id="@+id/large_station_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/dmusic_detail_page_start_station"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/follower_count_text"/>
    <com.amazon.ui.foundations.views.BaseButton
        android:id="@+id/follow_icon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <com.amazon.ui.foundations.views.BaseButton
        android:id="@+id/share_icon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@+id/follow_icon"
        app:layout_constraintTop_toTopOf="@+id/follow_icon"/>
</androidx.constraintlayout.widget.ConstraintLayout>
