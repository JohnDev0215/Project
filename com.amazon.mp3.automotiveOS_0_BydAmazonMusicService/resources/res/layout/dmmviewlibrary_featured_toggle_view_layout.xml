<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_root"
    android:background="@drawable/featured_toggle_background"
    android:paddingLeft="@dimen/spacer_base"
    android:paddingTop="@dimen/spacer_small"
    android:paddingRight="@dimen/spacer_base"
    android:paddingBottom="@dimen/spacer_small"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/spacer_base"
    android:paddingVertical="@dimen/spacer_small">
    <RelativeLayout
        android:id="@+id/artwork_container"
        android:layout_width="@dimen/spacing_40"
        android:layout_height="@dimen/spacing_40"
        android:layout_marginRight="@dimen/spacer_small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/primary_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.amazon.ui.foundations.views.BaseImage
            android:id="@+id/primary_image"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"/>
        <com.amazon.ui.foundations.views.BaseImage
            android:id="@+id/secondary_image"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/label_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/primary_text"
        app:layout_constraintEnd_toStartOf="@+id/toggle_button"
        app:layout_constraintStart_toStartOf="@+id/primary_text">
        <com.amazon.music.views.library.views.CommentaryIndicatorView
            android:id="@+id/commentary_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/spacer_mini"/>
        <TextView
            android:ellipsize="end"
            android:id="@+id/label_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_weight="1"/>
    </LinearLayout>
    <TextView
        android:ellipsize="end"
        android:id="@+id/primary_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacer_micro"
        android:layout_marginBottom="@dimen/spacer_micro"
        android:maxLines="1"
        android:layout_marginVertical="@dimen/spacer_micro"
        app:layout_constraintEnd_toStartOf="@+id/toggle_button"
        app:layout_constraintStart_toEndOf="@+id/artwork_container"
        app:layout_constraintTop_toBottomOf="@+id/label_container"/>
    <com.amazon.ui.foundations.views.BaseButton
        android:id="@+id/toggle_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/spacer_small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/primary_text"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
