<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:layout_gravity="center"
    android:id="@+id/Container"
    android:layout_width="match_parent"
    android:layout_height="@dimen/library_list_view_item_height_2_lines"
    android:layout_marginStart="@dimen/divider_left_padding"
    android:layout_marginEnd="@dimen/divider_right_padding">
    <TextView
        android:textSize="@dimen/medium_text_size"
        android:textColor="@color/prime_blue"
        android:id="@+id/ShowHideTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/standard_padding"/>
    <ImageView
        android:id="@+id/ImageView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/prime_expand"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@+id/ShowHideTextView"/>
</RelativeLayout>
