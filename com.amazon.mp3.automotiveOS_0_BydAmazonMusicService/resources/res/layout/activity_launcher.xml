<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/refresh_base"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <TextureView
        android:id="@+id/loading_video_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/logo_animation_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"/>
    <ImageView
        android:id="@+id/subscription_badge"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/logo_animation_flag_margin"
        android:layout_below="@+id/logo_animation_iv"
        android:layout_alignEnd="@+id/logo_animation_iv"/>
    <ProgressBar
        android:id="@+id/loading_spinner"
        android:background="@drawable/inner_circle_progress_bar"
        android:layout_width="@dimen/circle_progress_bar_diameter"
        android:layout_height="@dimen/circle_progress_bar_diameter"
        android:layout_marginTop="32dp"
        android:progressDrawable="@drawable/semi_circle_progress_bar"
        android:layout_below="@+id/logo_animation_iv"
        android:layout_centerHorizontal="true"
        style="?android:attr/progressBarStyleHorizontal"/>
</RelativeLayout>
