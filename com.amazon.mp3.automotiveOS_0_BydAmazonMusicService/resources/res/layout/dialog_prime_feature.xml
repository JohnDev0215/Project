<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/prime_dialog_background"
    android:padding="@dimen/browse_dialog_padding"
    android:layout_width="match_parent"
    android:layout_height="@dimen/browse_dialog_height"
    android:layout_marginLeft="@dimen/screen_margin"
    android:layout_marginRight="@dimen/screen_margin">
    <ImageView
        android:gravity="bottom"
        android:layout_gravity="bottom"
        android:id="@+id/dialog_image_background"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="centerCrop"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/browse_dialog_margins"
        android:layout_marginRight="@dimen/browse_dialog_margins"
        android:layout_marginBottom="@dimen/browse_dialog_margin_bottom">
        <TextView
            android:gravity="bottom|center_horizontal"
            android:id="@+id/dialog_prime_feature_title"
            android:layout_width="match_parent"
            android:layout_height="@dimen/browse_dialog_title_height"
            style="@style/PrimeDialogTitle"/>
        <TextView
            android:gravity="bottom|center_horizontal"
            android:id="@+id/dialog_prime_feature_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/browse_dialog_message_margin_top"
            style="@style/PrimeDialogMessage"/>
        <Button
            android:id="@+id/dialog_prime_feature_positive_btn"
            android:layout_width="match_parent"
            android:layout_height="@dimen/browse_dialog_button_height"
            android:layout_marginTop="@dimen/browse_dialog_button_margin_top"
            style="@style/PrimeDialogPositiveButton"/>
        <Button
            android:gravity="bottom|center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/dialog_prime_feature_negative_btn"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/browse_dialog_button_height"
            style="@style/PrimeDialogNegativeButton"/>
    </LinearLayout>
</FrameLayout>
