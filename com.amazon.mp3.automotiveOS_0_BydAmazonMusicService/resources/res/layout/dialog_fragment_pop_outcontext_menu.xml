<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/root_container"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <Space
        android:id="@+id/height_space"
        android:layout_width="match_parent"
        android:layout_height="@dimen/pop_out_context_menu_max_height"
        android:layout_marginBottom="@dimen/bauhaus_spacer_large"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_guideline"
        app:layout_constraintVertical_bias="0"/>
    <ImageView
        android:id="@+id/blurred_background_image_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="@+id/card_container"
        app:layout_constraintEnd_toEndOf="@+id/card_container"
        app:layout_constraintStart_toStartOf="@+id/card_container"
        app:layout_constraintTop_toTopOf="@+id/card_container"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/card_container"
        android:background="@color/pressed"
        android:visibility="invisible"
        android:layout_width="@dimen/pop_out_context_menu_width"
        android:layout_height="0dp"
        android:layout_marginEnd="@dimen/bauhaus_spacer_small"
        app:layout_constraintBottom_toBottomOf="@+id/height_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_guideline"
        app:layout_constraintVertical_bias="0"
        app:layout_goneMarginEnd="@dimen/bauhaus_spacer_small">
        <FrameLayout
            android:id="@+id/menu_container"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </androidx.cardview.widget.CardView>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/top_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="?attr/actionBarSize"/>
</androidx.constraintlayout.widget.ConstraintLayout>
