<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ViewStub
        android:id="@+id/PlaylistHeaderViewStub"
        android:inflatedId="@+id/PlaylistHeaderViewStub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <RelativeLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/standard_padding"
        android:layout_marginStart="@dimen/detail_view_image_text_padding">
        <TextView
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/TitleTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/library_album_detail_album_name_width"
            android:singleLine="true"
            android:layout_toStartOf="@+id/AddAllButton"
            style="@style/DetailViewContentName"/>
        <ImageButton
            android:id="@+id/AddAllButton"
            android:background="@null"
            android:layout_width="@dimen/song_tile_add_button_size"
            android:layout_height="@dimen/song_tile_add_button_size"
            android:src="@drawable/playlist_btn_add"
            android:minWidth="@dimen/minimum_button_width"
            android:contentDescription="@string/add_all_content_description"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</LinearLayout>
