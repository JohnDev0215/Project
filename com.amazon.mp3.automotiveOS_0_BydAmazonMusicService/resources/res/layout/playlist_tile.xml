<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:amazonmp3="http://schemas.android.com/apk/res-auto"
    android:id="@+id/view_root"
    android:background="@drawable/selector_item_background_color"
    android:paddingTop="@dimen/spacing_16dp"
    android:paddingBottom="@dimen/spacing_16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/AlbumArtworkFrame"
        android:layout_width="@dimen/playlist_tile_art_size"
        android:layout_height="@dimen/playlist_tile_art_size"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/playlist_tile_art_indent"
        android:layout_marginEnd="@dimen/playlist_tile_art_indent">
        <com.amazon.music.views.library.views.FixedAspectImageView
            android:id="@+id/imageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/playlist_placeholder"/>
        <com.amazon.mp3.view.PlayNotificationIcon
            android:layout_gravity="center"
            android:id="@+id/PlaystateIcon"
            android:background="@color/dimmed"
            android:visibility="gone"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="center"
            amazonmp3:useLargeIcons="true"/>
        <ImageView
            android:background="@drawable/selector_artwork_mask"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <include
        android:id="@+id/overflow_button_open"
        android:layout_width="@dimen/overflow_button_clickable_size"
        android:layout_height="@dimen/overflow_button_clickable_size"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/screen_margin"
        android:layout_alignParentEnd="true"
        layout="@layout/overflow_button"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@+id/overflow_button_open"
        android:layout_toEndOf="@+id/AlbumArtworkFrame">
        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/PlaylistTilePrimaryText"/>
        <TextView
            android:id="@+id/description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/PlaylistSecondaryText"/>
        <TextView
            android:textStyle="italic"
            android:id="@+id/reason"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/PlaylistSecondaryText"/>
    </LinearLayout>
</RelativeLayout>
