<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/feature_play"
    android:background="@color/transparent"
    android:clickable="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/background_gradient_image_view"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:src="@drawable/feature_play_secondary_glass_gradient"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:layout_width="@dimen/podcast_feature_play_foreground_image_border_width"
        android:layout_height="@dimen/podcast_feature_play_foreground_image_border_height"
        android:layout_marginTop="@dimen/podcast_feature_play_foreground_border_margin_top"
        android:src="@drawable/feature_play_thumbnail_outside_border"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <RelativeLayout
        android:id="@+id/foreground_gradient_image_view_relative_layout"
        android:layout_width="@dimen/podcast_feature_play_foreground_image_width"
        android:layout_height="@dimen/podcast_feature_play_foreground_image_height"
        android:layout_marginTop="@dimen/podcast_feature_play_foreground_margin_top"
        android:layout_centerHorizontal="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/foreground_gradient_image_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/feature_play_thumbnail_secondary_glass_gradient"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </RelativeLayout>
    <com.amazon.podcast.views.galleryTemplate.IngressPlayButton
        android:id="@+id/PlayButtonWideScreen"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <ImageButton
        android:layout_gravity="end|bottom"
        android:id="@+id/PlayButton"
        android:background="@drawable/button_circle"
        android:padding="@dimen/podcast_spacer_small"
        android:layout_width="@dimen/podcast_icon_button_medium"
        android:layout_height="@dimen/podcast_icon_button_medium"
        android:layout_marginLeft="@dimen/podcast_spacer_medium"
        android:layout_marginRight="@dimen/podcast_spacer_large"
        android:layout_marginBottom="@dimen/podcast_spacer_large"
        android:src="@drawable/ic_playback_play_mini_player"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <com.amazon.podcast.views.EmberTextView
        android:textSize="@dimen/podcast_text_size_t4"
        android:ellipsize="end"
        android:id="@+id/label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/podcast_spacer_base"
        android:layout_marginBottom="@dimen/podcast_spacer_micro"
        android:maxLines="1"
        android:layout_marginStart="@dimen/podcast_spacer_medium"
        android:layout_marginEnd="@dimen/podcast_feature_play_right_text_margin"
        app:layout_constraintBottom_toTopOf="@+id/title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/foreground_gradient_image_view_relative_layout"
        style="@style/PodcastAppTheme.TextView.Label"/>
    <com.amazon.podcast.views.EmberTextView
        android:textSize="@dimen/podcast_text_size_h2"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/podcast_spacer_micro"
        android:maxLines="2"
        android:lineSpacingExtra="@dimen/podcast_feature_play_title_line_space_padding"
        android:layout_marginStart="@dimen/podcast_spacer_medium"
        android:layout_marginEnd="@dimen/podcast_feature_play_right_text_margin"
        app:layout_constraintBottom_toTopOf="@+id/primary_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/label"
        style="@style/PodcastAppTheme.TextView.PodcastEntityTitle"/>
    <com.amazon.podcast.views.EmberTextView
        android:textSize="@dimen/podcast_text_size_t1"
        android:id="@+id/primary_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/podcast_spacer_mini"
        android:maxLines="2"
        android:lineSpacingExtra="0dp"
        android:layout_marginStart="@dimen/podcast_spacer_medium"
        android:layout_marginEnd="@dimen/podcast_feature_play_right_text_margin"
        app:layout_constraintBottom_toTopOf="@+id/secondary_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"
        style="@style/PodcastAppTheme.TextView.Primary"/>
    <com.amazon.podcast.views.EmberTextView
        android:id="@+id/secondary_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/podcast_spacer_mini"
        android:maxLines="1"
        android:layout_marginStart="@dimen/podcast_spacer_medium"
        android:layout_marginEnd="@dimen/podcast_feature_play_right_text_margin"
        app:layout_constraintBottom_toTopOf="@+id/tertiary_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/primary_text"
        style="@style/PodcastAppTheme.TextView.Secondary"/>
    <com.amazon.podcast.views.EmberTextView
        android:id="@+id/tertiary_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/podcast_spacer_large"
        android:maxLines="1"
        android:layout_marginStart="@dimen/podcast_spacer_medium"
        android:layout_marginEnd="@dimen/podcast_feature_play_right_text_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/secondary_text"
        style="@style/PodcastAppTheme.TextView.Tertiary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
