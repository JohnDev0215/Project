<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/filter_dialog"
    android:padding="@dimen/screen_margin"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@+id/clear_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dmusic_playlist_btn_clear_description"
        android:maxLines="1"
        android:textAllCaps="true"
        app:layout_constraintBottom_toBottomOf="@+id/dismiss_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/dismiss_button"
        style="@style/AmazonMusic.PillCellText"/>
    <FrameLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/dismiss_button"
        android:background="@drawable/pill_shape"
        android:paddingTop="@dimen/spacing_8dp"
        android:paddingBottom="@dimen/spacing_8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacer_24"
        android:foreground="@drawable/ripple_pill_shape"
        android:paddingStart="@dimen/spacing_8dp"
        android:paddingEnd="@dimen/spacing_8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/dimiss_button_view"
            android:layout_width="@dimen/prime_filter_icon_size"
            android:layout_height="@dimen/prime_filter_icon_size"
            android:src="@drawable/ic_action_cancel"/>
    </FrameLayout>
    <FrameLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/back_button"
        android:background="@drawable/pill_shape"
        android:paddingTop="@dimen/spacing_8dp"
        android:paddingBottom="@dimen/spacing_8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:foreground="@drawable/ripple_pill_shape"
        android:paddingStart="@dimen/spacing_8dp"
        android:paddingEnd="@dimen/spacing_8dp"
        app:layout_constraintBottom_toBottomOf="@+id/detail_title_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/back_button_view"
            android:layout_width="@dimen/prime_filter_icon_size"
            android:layout_height="@dimen/prime_filter_icon_size"
            android:src="@drawable/ic_navigation_goback"/>
    </FrameLayout>
    <TextView
        android:textSize="@dimen/action_bar_title_text_size"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@+id/title_text"
        android:paddingBottom="@dimen/screen_margin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/dmusic_prime_search_bottom_sheet_filter_title"
        android:maxLines="1"
        app:layout_constraintBottom_toTopOf="@+id/filter_category_container"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="@dimen/action_bar_title_text_size"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/detail_title_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/dmusic_prime_search_bottom_sheet_filter_title"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/filter_selection_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/screen_margin"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/detail_title_text"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/filter_category_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
