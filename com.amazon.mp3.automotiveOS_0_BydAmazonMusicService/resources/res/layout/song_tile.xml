<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:amazonmp3="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/selector_item_background_color"
    android:paddingTop="@dimen/song_title_top_margin"
    android:paddingBottom="@dimen/song_title_bottom_margin"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false">
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/AlbumArtworkFrame"
        android:layout_width="@dimen/song_tile_art_size"
        android:layout_height="@dimen/song_tile_art_size"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/song_tile_art_indent"
        android:layout_marginEnd="@dimen/song_tile_text_indent"
        android:layout_alignParentStart="true">
        <com.amazon.music.views.library.views.FixedAspectImageView
            android:id="@+id/AlbumArtwork"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/song_placeholder"
            android:adjustViewBounds="true"/>
        <ImageView
            android:enabled="false"
            android:layout_gravity="start|bottom"
            android:id="@+id/artwork_badge"
            android:paddingBottom="4dp"
            android:focusable="false"
            android:visibility="gone"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/station_thumb_outline"
            android:scaleType="center"
            android:paddingStart="4dp"/>
        <View
            android:background="@drawable/selector_artwork_mask"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.amazon.mp3.view.PlayNotificationIcon
            android:layout_gravity="center"
            android:id="@+id/PlaystateIcon"
            android:background="@color/dimmed"
            android:visibility="gone"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="center"
            amazonmp3:useLargeIcons="false"/>
    </FrameLayout>
    <RelativeLayout
        android:id="@+id/TrackTitleContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignWithParentIfMissing="true"
        android:layout_toStartOf="@+id/RightViews"
        android:layout_toEndOf="@+id/AlbumArtworkFrame">
        <TextView
            android:id="@+id/TrackTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:drawablePadding="@dimen/song_tile_title_padding"
            style="@style/PrimaryText"/>
        <TextView
            android:id="@+id/ArtistName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_below="@+id/TrackTitle"
            android:layout_alignWithParentIfMissing="true"
            style="@style/SecondaryText"/>
        <TextView
            android:id="@+id/recommendation_reason"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_below="@+id/ArtistName"
            android:layout_alignWithParentIfMissing="true"
            style="@style/ReasonText"/>
        <com.amazon.mp3.view.BadgeView
            android:id="@+id/ContentEncodingBadge"
            android:layout_below="@+id/recommendation_reason"
            android:layout_alignWithParentIfMissing="true"
            android:layout_marginEnd="@dimen/spacing_4dp"
            style="@style/ContentEncodingBadge"/>
        <com.amazon.mp3.view.BadgeView
            android:id="@+id/ImmersiveBadge"
            android:layout_below="@+id/recommendation_reason"
            android:layout_alignWithParentIfMissing="true"
            android:layout_toEndOf="@+id/ContentEncodingBadge"
            style="@style/ContentEncodingBadge"/>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/RightViews"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_alignWithParentIfMissing="true"
        android:layout_toStartOf="@+id/overflow_button_open">
        <include
            android:id="@+id/add_button_holder"
            android:layout_width="@dimen/song_tile_add_button_size"
            android:layout_height="match_parent"
            layout="@layout/add_button"/>
        <ImageView
            android:id="@+id/missing_sd_card"
            android:visibility="gone"
            android:layout_width="@dimen/song_tile_add_button_size"
            android:layout_height="@dimen/song_tile_add_button_size"
            android:src="@drawable/sd_card_missing"
            android:scaleType="center"
            android:contentDescription="@string/sd_card_not_found_dialog_title"/>
        <ImageView
            android:id="@+id/add_done_icon"
            android:visibility="gone"
            android:layout_width="@dimen/song_tile_add_button_size"
            android:layout_height="@dimen/song_tile_add_button_size"
            android:src="@drawable/ic_cloud_done"
            android:scaleType="center"
            android:cropToPadding="false"
            android:alpha="0"/>
    </FrameLayout>
    <include
        android:id="@+id/overflow_button_open"
        android:layout_width="@dimen/overflow_button_clickable_size"
        android:layout_height="match_parent"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"
        layout="@layout/overflow_button"/>
</RelativeLayout>
