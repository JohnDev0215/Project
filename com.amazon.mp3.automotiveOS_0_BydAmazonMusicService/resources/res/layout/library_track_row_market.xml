<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/TrackRowContainer"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/SectionHeaderContainer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:gravity="start|center_vertical"
            android:id="@+id/SectionHeader"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/listview_section_header_height"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/library_detail_padding"
            style="@style/LibraryListItemSecondaryText"/>
        <View
            android:background="@color/divider"
            android:layout_width="match_parent"
            android:layout_height="@dimen/default_divider_height"
            android:layout_below="@+id/SectionHeader"/>
    </RelativeLayout>
    <RelativeLayout
        android:background="@drawable/selector_item_background_color"
        android:layout_width="match_parent"
        android:layout_height="@dimen/library_list_view_item_height_3_lines">
        <include layout="@layout/artwork"/>
        <ImageView
            android:id="@+id/LeftRowBadge"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/deluxe_booklet_icn"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/listview_image_right_margin"
            android:layout_toEndOf="@+id/AlbumArtworkFrame"/>
        <RelativeLayout
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/TrackAndArtistTextContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:minHeight="@dimen/listview_row_min_height"
            android:paddingStart="@dimen/standard_padding"
            android:layout_toStartOf="@+id/BadgeContainer"
            android:layout_toEndOf="@+id/LeftRowBadge">
            <FrameLayout
                android:id="@+id/PlaylistTrackCountFrame"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/library_prime_track_number_min_width"
                android:layout_alignBottom="@+id/TrackTitle"
                android:paddingEnd="@dimen/standard_padding">
                <TextView
                    android:layout_gravity="end"
                    android:id="@+id/PlaylistTrackCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/LibraryListItemPrimaryTextDim"/>
            </FrameLayout>
            <TextView
                android:id="@+id/TrackTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:drawablePadding="@dimen/small_padding"
                android:paddingEnd="@dimen/standard_padding"
                android:layout_toEndOf="@+id/PlaylistTrackCountFrame"
                style="@style/PrimaryText"/>
            <TextView
                android:id="@+id/ArtistName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/listview_item_secondary_text_padding_top"
                android:singleLine="true"
                android:layout_below="@+id/TrackTitle"
                android:layout_toEndOf="@+id/PlaylistTrackCountFrame"
                style="@style/SecondaryText"/>
            <RelativeLayout
                android:id="@+id/BadgeList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/ArtistName"
                android:layout_alignStart="@+id/TrackTitle">
                <com.amazon.mp3.view.BadgeView
                    android:id="@+id/KatanaBadge"
                    android:layout_marginEnd="@dimen/spacing_4dp"
                    style="@style/ContentEncodingBadge"/>
                <com.amazon.mp3.view.BadgeView
                    android:id="@+id/ImmersiveBadge"
                    android:layout_marginEnd="@dimen/spacing_4dp"
                    android:layout_toEndOf="@+id/KatanaBadge"
                    style="@style/ContentEncodingBadge"/>
            </RelativeLayout>
            <com.amazon.mp3.view.TrackPopularityBar
                android:id="@+id/PopularityBar"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/spacing_8dp"
                android:layout_marginTop="@dimen/spacing_8dp"
                android:layout_below="@+id/BadgeList"
                android:layout_alignWithParentIfMissing="true"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/BadgeContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignWithParentIfMissing="true"
            android:layout_toStartOf="@+id/overflow_button_open">
            <TextView
                android:gravity="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/Duration"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/download_circular_progress_bar_width"
                android:singleLine="true"
                android:paddingStart="@dimen/listview_horizontal_padding"
                android:paddingEnd="@dimen/listview_horizontal_padding"
                style="@style/LibraryListItemSecondaryText"/>
            <com.amazon.mp3.view.DownloadButtonView
                android:layout_gravity="center"
                android:id="@+id/DownloadButton"
                android:layout_width="@dimen/song_tile_download_button_size"
                android:layout_height="@dimen/song_tile_download_button_size"
                android:src="@drawable/ic_download"
                android:scaleType="center"
                android:contentDescription="@string/download_track_content_description"/>
            <FrameLayout
                android:layout_gravity="center_vertical"
                android:id="@+id/RightViews"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.amazon.mp3.view.DownloadProgressBadgeView
                    android:gravity="center_vertical"
                    android:id="@+id/DownloadProgress"
                    android:padding="@dimen/track_row_download_tap_target_spacing"
                    android:visibility="gone"
                    android:layout_width="@dimen/track_row_download_circular_progress_bar_width"
                    android:layout_height="@dimen/track_row_download_circular_progress_bar_width"/>
                <ImageView
                    android:id="@+id/PrimeAddButton"
                    android:layout_width="@dimen/song_tile_add_button_size"
                    android:layout_height="@dimen/song_tile_add_button_size"
                    android:src="@drawable/add_to_library_button"
                    android:scaleType="center"
                    android:contentDescription="@string/add_to_library_content_description"/>
                <ImageView
                    android:id="@+id/add_done_icon"
                    android:visibility="gone"
                    android:layout_width="@dimen/song_tile_add_button_size"
                    android:layout_height="@dimen/song_tile_add_button_size"
                    android:src="@drawable/ic_cloud_done"
                    android:scaleType="center"
                    android:cropToPadding="false"
                    android:alpha="0"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/missing_sd_card"
                    android:visibility="gone"
                    android:layout_width="@dimen/song_tile_add_button_size"
                    android:layout_height="@dimen/song_tile_add_button_size"
                    android:src="@drawable/sd_card_missing"
                    android:scaleType="center"
                    android:contentDescription="@string/sd_card_not_found_dialog_title"/>
                <ImageView
                    android:gravity="center_vertical"
                    android:id="@+id/AddIcon"
                    android:visibility="gone"
                    android:layout_width="@dimen/song_tile_add_button_size"
                    android:layout_height="@dimen/song_tile_add_button_size"
                    android:src="@drawable/playlist_btn_add"
                    android:scaleType="center"
                    android:contentDescription="@string/dmusic_playlist_add_to_title"/>
                <include
                    android:layout_gravity="center"
                    android:id="@+id/station_icon_in_right_views"
                    android:visibility="gone"
                    android:layout_width="@dimen/overflow_button_clickable_size"
                    android:layout_height="@dimen/overflow_button_clickable_size"
                    layout="@layout/track_row_station_icon"/>
            </FrameLayout>
        </LinearLayout>
        <include
            android:layout_width="@dimen/overflow_button_clickable_size"
            android:layout_height="@dimen/overflow_button_clickable_size"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/screen_margin"
            android:layout_alignParentEnd="true"
            layout="@layout/overflow_button"/>
        <include
            android:id="@+id/station_icon"
            android:visibility="gone"
            android:layout_width="@dimen/overflow_button_clickable_size"
            android:layout_height="@dimen/overflow_button_clickable_size"
            android:layout_centerVertical="true"
            android:paddingStart="@dimen/spacing_4dp"
            android:paddingEnd="@dimen/spacing_4dp"
            android:layout_marginEnd="@dimen/screen_margin"
            android:layout_alignParentEnd="true"
            layout="@layout/track_row_station_icon"/>
    </RelativeLayout>
</merge>
