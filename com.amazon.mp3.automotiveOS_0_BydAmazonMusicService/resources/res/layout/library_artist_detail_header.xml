<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:amazonmp3="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.amazon.mp3.view.FixedWidthAspectImageView
        android:id="@+id/ArtistDetailImage"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/artist_placeholder_detail"
        amazonmp3:heightScalingFactor="@dimen/scale_factor_16_by_9"/>
    <RelativeLayout
        android:gravity="center"
        android:id="@+id/DetailPlayerControlsFragment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/DetailPlayerControlsContainer"/>
</LinearLayout>
