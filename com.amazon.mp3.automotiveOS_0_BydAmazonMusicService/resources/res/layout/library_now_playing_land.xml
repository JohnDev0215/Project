<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/PlayerCoverViewRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/audioVideoToggleView"
        android:paddingTop="@dimen/spacing_8dp"
        android:paddingBottom="@dimen/spacing_8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_2dp"
        android:paddingStart="@dimen/spacing_8dp"
        android:paddingEnd="@dimen/spacing_8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/NowPlayingPersistentPlayerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.amazon.mp3.view.BauhausSeekBarWidget
        android:id="@+id/PlayerCoverViewSeekBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/NowPlayingPersistentPlayerContainer"
        app:layout_constraintEnd_toEndOf="@+id/NowPlayingPersistentPlayerContainer"
        app:layout_constraintStart_toStartOf="@+id/NowPlayingPersistentPlayerContainer"
        style="@style/NowPlayingSeekBar"/>
    <View
        android:id="@+id/half_screen_view"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent="0.5"/>
    <com.amazon.mp3.view.player.PlayerMetadataView
        android:id="@+id/player_metadata"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/PlayerCoverViewSeekBar"
        app:layout_constraintEnd_toEndOf="@+id/half_screen_view"
        app:layout_constraintStart_toStartOf="@+id/NowPlayingPersistentPlayerContainer"/>
    <FrameLayout
        android:id="@+id/artwork_section_layout"
        android:visibility="gone"
        android:layout_width="@dimen/now_playing_album_art_cover"
        android:layout_height="@dimen/now_playing_album_art_cover"
        app:layout_constraintBottom_toTopOf="@+id/player_metadata"
        app:layout_constraintStart_toStartOf="@+id/NowPlayingPersistentPlayerContainer">
        <com.amazon.ui.foundations.views.BaseImage
            android:id="@+id/PlayerCoverViewAlbumArt"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:scaleType="centerInside"
            android:contentDescription="@string/dmusic_cover_album_art"/>
        <com.amazon.ui.foundations.views.BaseImage
            android:id="@+id/swap_art"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:scaleType="centerInside"
            android:contentDescription="@string/dmusic_cover_album_art"/>
    </FrameLayout>
    <com.amazon.mp3.playback.view.lyrics.LyricsTextViewContainer
        android:gravity="center"
        android:id="@+id/LyricsViewContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/PlayerCoverViewSeekBar"
        app:layout_constraintEnd_toEndOf="@+id/NowPlayingPersistentPlayerContainer"
        app:layout_constraintStart_toEndOf="@+id/half_screen_view"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:id="@+id/ads_upsell_banner"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/NowPlayingPersistentPlayerContainer"
        app:layout_constraintStart_toStartOf="@+id/NowPlayingPersistentPlayerContainer"
        app:layout_constraintTop_toTopOf="parent">
        <include layout="@layout/bauhaus_banner"/>
    </LinearLayout>
    <com.amazon.mp3.view.TooltipView
        android:id="@+id/TooltipDisplayerContainer"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacer_2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/bauhausNowPlayingNonBlockingView"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:cacheColorHint="@color/transparent"
        app:layout_constraintBottom_toTopOf="@+id/PlayerCoverViewSeekBar"
        app:layout_constraintEnd_toEndOf="@+id/NowPlayingPersistentPlayerContainer"
        app:layout_constraintStart_toEndOf="@+id/half_screen_view"
        app:layout_constraintTop_toTopOf="parent">
        <com.amazon.mp3.view.MessagingDialog
            android:id="@+id/messagingDialog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/toast_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/PlayerCoverViewSeekBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
