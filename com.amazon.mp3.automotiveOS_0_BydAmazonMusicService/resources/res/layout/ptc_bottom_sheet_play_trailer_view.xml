<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/ptc_bottom_sheet_playbutton_layout"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/podcast_spacer_mini"
    android:layout_marginBottom="@dimen/podcast_spacer_mini"
    android:layout_marginStart="@dimen/podcast_spacer_large"
    android:layout_marginEnd="@dimen/podcast_spacer_large">
    <RelativeLayout
        android:id="@+id/ptc_trailer_play_button_layout"
        android:background="@drawable/primary_glass_2_rounded_corners"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/podcast_trailer_button_height"
        android:minWidth="@dimen/podcast_spacer_huge"
        android:layout_centerInParent="true">
        <ImageView
            android:id="@+id/ptc_trailer_button_image"
            android:layout_width="@dimen/podcast_trailer_button_image_dimension"
            android:layout_height="@dimen/podcast_trailer_button_image_dimension"
            android:src="@drawable/ic_playinline"
            android:layout_alignTop="@+id/ptc_trailer_button_text"
            android:layout_alignBottom="@+id/ptc_trailer_button_text"
            android:layout_marginStart="@dimen/podcast_trailer_button_image_margin"
            android:layout_marginEnd="@dimen/podcast_trailer_button_image_margin"
            android:layout_alignParentStart="true"/>
        <ImageView
            android:id="@+id/ptc_trailer_pause_button"
            android:background="@color/transparent"
            android:padding="@dimen/podcast_spacer_micro"
            android:visibility="gone"
            android:layout_width="@dimen/podcast_spacer_large"
            android:layout_height="@dimen/podcast_spacer_large"
            android:src="@drawable/ic_playback_pause_mini_player"
            android:layout_centerInParent="true"/>
        <com.amazon.podcast.views.EmberTextView
            android:id="@+id/ptc_trailer_button_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/podcast_trailer_button_text_margin_end"
            android:layout_toEndOf="@+id/ptc_trailer_button_image"
            style="@style/PodcastAppTheme.TextView.Primary"/>
    </RelativeLayout>
    <RelativeLayout
        android:orientation="vertical"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignEnd="@+id/ptc_trailer_play_button_layout">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ptc_trailer_seek_bar_layout"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/podcast_spacer_mini"
            android:layout_marginBottom="@dimen/podcast_spacer_mini"
            android:layout_marginStart="@dimen/podcast_spacer_mini">
            <SeekBar
                android:id="@+id/podcast_ptc_bottomsheet_seekbar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/podcast_medium_icon"
                style="@style/PodcastAppTheme.PTCTrailer.SeekBar"/>
            <RelativeLayout
                android:id="@+id/ptc_trailer_timestamps_layout"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.amazon.podcast.views.EmberTextView
                    android:id="@+id/podcast_progress_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/podcast_spacer_mini"
                    android:text="00:00"
                    android:layout_alignParentLeft="true"
                    style="@style/PodcastAppTheme.TextView.LabelInActive"/>
                <com.amazon.podcast.views.EmberTextView
                    android:id="@+id/podcast_duration_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/podcast_spacer_mini"
                    android:text="20:00"
                    android:layout_alignParentRight="true"
                    style="@style/PodcastAppTheme.TextView.LabelInActive"/>
            </RelativeLayout>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
