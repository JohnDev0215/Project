<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/primo_blue"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="end"
            android:id="@+id/icon_dismiss"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dialog_small_border_padding"
            android:src="@drawable/close_normal"
            android:layout_marginEnd="@dimen/dialog_button_right_margin"/>
        <LinearLayout
            android:layout_gravity="start"
            android:orientation="vertical"
            android:paddingLeft="@dimen/dialog_outside_margin"
            android:paddingTop="@dimen/dialog_small_border_padding"
            android:paddingRight="@dimen/dialog_outside_margin"
            android:paddingBottom="@dimen/dialog_outside_margin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textStyle="bold"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dmusic_redownload_offline_title"
                style="@style/DialogTitleText"/>
            <TextView
                android:id="@+id/tv_message"
                android:paddingTop="@dimen/dialog_text_top_padding"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dmusic_redownload_offline_message"
                style="@style/DialogBodyText"/>
        </LinearLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/dialog_outside_margin"
            android:layout_marginRight="@dimen/dialog_outside_margin"
            android:layout_marginBottom="@dimen/dialog_outside_margin">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true">
                <CheckBox
                    android:textColor="@color/dialog_text"
                    android:id="@+id/cb_redownload"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/dmusic_checkbox_message"
                    android:buttonTint="@color/vivace_blue"/>
                <Button
                    android:textColor="@color/pure_white"
                    android:id="@+id/primary_button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/browse_dialog_button_height"
                    android:layout_marginTop="@dimen/browse_dialog_margins"
                    android:text="@string/dmusic_continue_button"
                    style="@style/PrimaryButton"/>
                <Button
                    android:id="@+id/secondary_button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/browse_dialog_button_height"
                    android:layout_marginTop="@dimen/spacing_8dp"
                    android:text="@string/dmusic_remove_unavailable_downloads_button"
                    style="@style/DialogSecondaryButton"/>
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
</ScrollView>
