<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/transparent"
    android:paddingTop="@dimen/podcast_spacer_small"
    android:paddingBottom="@dimen/podcast_spacer_small"
    android:layout_width="match_parent"
    android:layout_height="@dimen/podcast_large_list_item_height"
    android:foreground="@drawable/ripple">
    <com.amazon.podcast.views.EmberTextView
        android:textSize="@dimen/podcast_refinement_option_primary_text"
        android:id="@+id/podcast_refinement_option_primary_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="2"
        app:layout_constraintBottom_toTopOf="@+id/podcast_refinement_option_tertiary_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/PodcastAppTheme.TextView.Primary"/>
    <com.amazon.podcast.views.EmberTextView
        android:id="@+id/podcast_refinement_option_tertiary_text"
        android:paddingTop="@dimen/podcast_spacer_micro"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/podcast_default_label"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/podcast_refinement_option_primary_text"
        app:layout_constraintTop_toBottomOf="@+id/podcast_refinement_option_primary_text"
        style="@style/PodcastAppTheme.TextView.Tertiary"/>
    <ImageView
        android:id="@+id/podcast_refinement_option_check_box"
        android:visibility="visible"
        android:layout_width="@dimen/podcast_small_icon"
        android:layout_height="@dimen/podcast_small_icon"
        android:src="@drawable/ic_action_radiouncheck"
        android:layout_marginStart="@dimen/podcast_spacer_base"
        android:layout_marginEnd="@dimen/podcast_spacer_small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
