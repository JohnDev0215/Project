<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/secondary_glass_1"
    android:paddingTop="@dimen/spacer_huge"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/primary_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintBottom_toTopOf="@+id/secondary_header"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/secondary_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacer_mini"
        android:maxLines="1"
        app:layout_constraintBottom_toTopOf="@+id/item_container"
        app:layout_constraintTop_toBottomOf="@+id/primary_header"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/item_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacer_mini"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/secondary_header"/>
</androidx.constraintlayout.widget.ConstraintLayout>
