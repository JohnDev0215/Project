<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/PresetFullPlayerView"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/car_mode_nps_background"
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"/>
    <ImageView
        android:id="@+id/PresetFullPlayerGradient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/gradient1"/>
    <ImageView
        android:id="@+id/PresetFullPlayerGlassBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@color/secondary_glass_1"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/car_mode_header_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacer_base"
            android:layout_marginStart="@dimen/spacer_base"
            android:layout_marginEnd="@dimen/spacer_base"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.amazon.ui.foundations.views.BaseButton
                android:id="@+id/car_mode_nps_exit_button"
                android:focusable="true"
                android:visibility="visible"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.amazon.ui.foundations.views.BaseButton
                android:id="@+id/car_mode_nps_alexa_button"
                android:background="@drawable/ripple_background_no_mask"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_microphone"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.cardview.widget.CardView
            android:id="@+id/car_mode_nps_artwork_card"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginLeft="@dimen/spacer_48"
            android:layout_marginTop="@dimen/spacer_12"
            android:layout_marginRight="@dimen/spacer_48"
            android:layout_marginBottom="@dimen/spacer_12"
            android:layout_marginHorizontal="@dimen/spacer_48"
            android:layout_marginVertical="@dimen/spacer_12"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="@dimen/spacer_8"
            app:layout_constraintBottom_toTopOf="@+id/car_mode_player_content"
            app:layout_constraintDimensionRatio="W,1:1"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/car_mode_header_buttons">
            <ImageView
                android:id="@+id/car_mode_nps_artwork"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"/>
        </androidx.cardview.widget.CardView>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/car_mode_player_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacer_medium"
            android:layout_marginStart="@dimen/spacer_24"
            android:layout_marginEnd="@dimen/spacer_12"
            app:layout_constraintBottom_toTopOf="@+id/car_mode_nps_progress_bar"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/car_mode_nps_artwork_card">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/PresetFullPlayerContentCurrent"
                android:layout_width="@dimen/spacing_0dp"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/car_mode_nps_like_button"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:ellipsize="end"
                    android:gravity="start"
                    android:id="@+id/car_mode_nps_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:lines="2"/>
                <TextView
                    android:ellipsize="end"
                    android:gravity="start"
                    android:id="@+id/car_mode_nps_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacer_12"
                    android:maxLines="1"/>
            </LinearLayout>
            <com.amazon.ui.foundations.views.BaseButton
                android:id="@+id/car_mode_nps_like_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_action_like"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <ProgressBar
            android:id="@+id/car_mode_nps_progress_bar"
            android:background="@color/car_mode_now_playing_seekbar_background_color"
            android:layout_width="match_parent"
            android:layout_height="@dimen/spacer_4"
            android:layout_marginLeft="@dimen/spacing_24"
            android:layout_marginRight="@dimen/spacing_24"
            android:layout_marginBottom="@dimen/spacer_huge"
            android:layout_marginHorizontal="@dimen/spacing_24"
            app:layout_constraintBottom_toTopOf="@+id/car_mode_prev_current_next_buttons"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            style="?android:attr/progressBarStyleHorizontal"/>
        <TextView
            android:id="@+id/car_mode_nps_progress_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacer_8"
            android:layout_marginStart="@dimen/spacing_24"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/car_mode_nps_progress_bar"/>
        <TextView
            android:id="@+id/car_mode_nps_remaining_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacer_8"
            android:layout_marginEnd="@dimen/spacing_24"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/car_mode_nps_progress_bar"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/car_mode_prev_current_next_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacer_8"
            android:layout_marginStart="@dimen/spacer_base"
            android:layout_marginEnd="@dimen/spacer_base"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent">
            <com.amazon.ui.foundations.views.BaseButton
                android:id="@+id/car_mode_nps_prev_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacer_giant_epic"
                app:layout_constraintBottom_toTopOf="@+id/car_mode_nps_repeat_button"
                app:layout_constraintRight_toLeftOf="@+id/car_mode_nps_play_button"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.amazon.ui.foundations.views.BaseButton
                android:id="@+id/car_mode_nps_play_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacer_10"
                app:layout_constraintBottom_toTopOf="@+id/car_mode_nps_repeat_button"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.amazon.ui.foundations.views.BaseButton
                android:id="@+id/car_mode_nps_next_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacer_giant_epic"
                app:layout_constraintBottom_toTopOf="@+id/car_mode_nps_repeat_button"
                app:layout_constraintLeft_toRightOf="@+id/car_mode_nps_play_button"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.amazon.ui.foundations.views.BaseButton
                android:id="@+id/car_mode_nps_rewind_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacer_giant_epic"
                app:layout_constraintBottom_toTopOf="@+id/car_mode_nps_repeat_button"
                app:layout_constraintRight_toLeftOf="@+id/car_mode_nps_play_button"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.amazon.ui.foundations.views.BaseButton
                android:id="@+id/car_mode_nps_forward_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacer_giant_epic"
                app:layout_constraintBottom_toTopOf="@+id/car_mode_nps_repeat_button"
                app:layout_constraintLeft_toRightOf="@+id/car_mode_nps_play_button"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.amazon.ui.foundations.views.BaseButton
                android:id="@+id/car_mode_nps_repeat_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacer_giant_epic"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/car_mode_nps_play_button"/>
            <com.amazon.ui.foundations.views.BaseButton
                android:id="@+id/car_mode_nps_play_queue_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toRightOf="@+id/car_mode_nps_shuffle_button"
                app:layout_constraintRight_toLeftOf="@+id/car_mode_nps_repeat_button"/>
            <TextView
                android:id="@+id/car_mode_nps_playback_speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/car_mode_nps_prev_button"
                app:layout_constraintLeft_toRightOf="@+id/car_mode_nps_prev_button"
                app:layout_constraintRight_toLeftOf="@+id/car_mode_nps_next_button"
                app:layout_constraintTop_toTopOf="@+id/car_mode_nps_next_button"/>
            <com.amazon.ui.foundations.views.BaseButton
                android:id="@+id/car_mode_nps_podcast_episode_list_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/car_mode_nps_playback_speed"/>
            <com.amazon.ui.foundations.views.BaseButton
                android:id="@+id/car_mode_nps_shuffle_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacer_giant_epic"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toRightOf="@+id/car_mode_nps_play_button"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
