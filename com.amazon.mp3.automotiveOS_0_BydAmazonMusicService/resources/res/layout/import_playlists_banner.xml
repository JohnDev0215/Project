<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/feature_banner"
    android:layout_width="match_parent"
    android:layout_height="@dimen/browse_banner_height"
    android:layout_margin="@dimen/spacing_4dp"
    style="@style/NowPlayingAdsUpsellBanner">
    <RelativeLayout
        android:id="@+id/import_playlists_link_area"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@+id/import_playlists_close_area">
        <TextView
            android:textColor="@color/black"
            android:gravity="center"
            android:id="@+id/feature_banner_message"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/dmusic_library_import_playlists"
            android:layout_alignParentTop="true"
            android:layout_toStartOf="@+id/feature_banner_icon"
            android:layout_alignParentStart="true"/>
        <ImageView
            android:id="@+id/feature_banner_icon"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/ic_chevron_right"
            android:tint="@color/black"
            android:layout_marginEnd="@dimen/spacing_8dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/import_playlists_close_area"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:paddingEnd="@dimen/spacing_10dp">
        <ImageButton
            android:id="@+id/import_playlists_close_button"
            android:clickable="true"
            android:layout_width="@dimen/upsell_dialog_close_button_size"
            android:layout_height="@dimen/upsell_dialog_close_button_size"
            android:src="@drawable/ic_dialog_close_dark"
            android:scaleType="fitCenter"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/spacing_8dp"
            android:layout_alignParentStart="true"
            style="@style/BauhausBlackCloseButton"/>
    </RelativeLayout>
</RelativeLayout>
