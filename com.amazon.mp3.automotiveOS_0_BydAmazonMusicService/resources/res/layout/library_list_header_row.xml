<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/HeaderView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.amazon.mp3.view.MusicSourceToggle
        android:id="@+id/SourceToggle"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/source_toggle_height"
        android:layout_marginTop="@dimen/source_toggle_top_spacing"
        android:layout_marginEnd="@dimen/screen_margin"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="@dimen/large_text_size"
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:id="@+id/HeaderTitle"
        android:layout_width="match_parent"
        android:layout_height="@dimen/library_list_view_item_height"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_toStartOf="@+id/SourceToggle"
        style="@style/AmazonMusic.EmberRegularText"/>
</RelativeLayout>
