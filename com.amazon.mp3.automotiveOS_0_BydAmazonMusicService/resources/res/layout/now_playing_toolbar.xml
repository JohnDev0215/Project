<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/action_bar_height">
    <androidx.appcompat.widget.Toolbar xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/action_bar_height"
        android:layout_alignParentTop="true"
        app:contentInsetStart="@dimen/spacing_0dp"
        app:contentInsetStartWithNavigation="@dimen/spacing_0dp"
        app:popupTheme="@style/Theme.AmazonMP3.ActionBar.OverflowMenu"
        app:theme="@style/Theme.AmazonMP3.TransparentActionBar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/toolbar_inner_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.amazon.ui.foundations.views.BaseButton
                android:id="@+id/StageBackButton"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageButton
                android:layout_gravity="end"
                android:id="@+id/MoreOptions"
                android:background="@drawable/ripple_background_no_mask"
                android:padding="@dimen/small_padding"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/action_bar_overflow_open"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageButton
                android:layout_gravity="end"
                android:id="@+id/PersistentPlayerShareButton"
                android:background="@drawable/ripple_background_no_mask"
                android:padding="@dimen/small_padding"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_action_share_toolbar"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/MoreOptions"
                app:layout_constraintTop_toTopOf="parent"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/audioVideoToggleView"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:paddingStart="@dimen/spacing_16dp"
                android:paddingEnd="@dimen/spacing_16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.amazon.mp3.casting.CastingImageButton
                android:layout_gravity="end"
                android:id="@+id/CastingButton"
                android:background="@drawable/ripple_background_no_mask"
                android:padding="@dimen/small_padding"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_other_speaker"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/PersistentPlayerShareButton"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.amazon.ui.foundations.views.BaseButton
                android:id="@+id/iv_alexa"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.amazon.mp3.view.player.PlayerMetadataView
                android:layout_gravity="end"
                android:id="@+id/player_metadata"
                android:visibility="gone"
                android:layout_width="@dimen/stage_player_metadata_frame_width"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacer_6"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.appcompat.widget.Toolbar>
</RelativeLayout>
