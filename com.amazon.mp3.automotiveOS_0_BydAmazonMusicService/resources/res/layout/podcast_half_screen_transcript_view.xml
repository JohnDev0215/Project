<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/secondary_glass_4"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="top"
        android:id="@+id/half_screen_transcription_background"
        android:background="@color/secondary_glass_3_5"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:foreground="@drawable/ic_transcript_view_gradient"
        android:scaleType="centerCrop"/>
    <RelativeLayout
        android:id="@+id/half_screen_transcription_header"
        android:background="@color/secondary_glass_5"
        android:layout_width="match_parent"
        android:layout_height="@dimen/spacing_50">
        <ImageView
            android:background="@color/secondary_glass_4"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <TextView
            android:textSize="@dimen/text_size_11"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/transcript_badging"
            android:background="@drawable/content_badge_background"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auto_transcription"
            android:maxLines="1"
            android:layout_centerVertical="true"
            android:paddingStart="@dimen/spacer_4"
            android:paddingEnd="@dimen/spacer_4"
            android:layout_marginStart="@dimen/spacer_36"/>
        <TextView
            android:textSize="@dimen/text_size_11"
            android:textColor="@color/white"
            android:layout_gravity="center"
            android:id="@+id/scroll_time"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@+id/transcript_badging"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/spacer_10"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/close_transcript"
            android:layout_width="@dimen/spacing_20"
            android:layout_height="@dimen/spacing_20"
            android:src="@drawable/ic_podcast_action_cancel"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/spacer_10"
            android:layout_marginEnd="@dimen/spacer_10"
            android:layout_alignParentEnd="true"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/full_screen_expand_button"
            android:layout_width="@dimen/spacing_20"
            android:layout_height="@dimen/spacing_20"
            android:src="@drawable/ic_other_expand"
            android:layout_toLeftOf="@+id/close_transcript"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/center_caret_layout"
        android:layout_width="@dimen/spacer_36"
        android:layout_height="match_parent"
        android:layout_below="@+id/half_screen_transcription_header">
        <ImageView
            android:id="@+id/center_caret"
            android:layout_width="@dimen/nav_button_padding"
            android:layout_height="@dimen/nav_button_padding"
            android:src="@drawable/ic_transcript_indicator"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"/>
    </RelativeLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/trancript_recyclerview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/half_screen_transcription_header"
        android:layout_marginEnd="@dimen/spacing_20"
        android:layout_toEndOf="@+id/center_caret_layout"/>
</RelativeLayout>
