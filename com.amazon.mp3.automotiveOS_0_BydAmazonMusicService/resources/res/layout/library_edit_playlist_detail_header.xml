<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="0dp"
        android:layout_height="0dp"/>
    <ViewStub
        android:id="@+id/PlaylistHeaderViewStub"
        android:inflatedId="@+id/PlaylistHeaderViewStub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingTop="@dimen/standard_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:id="@+id/HeaderButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/minimum_button_width"
            android:minHeight="@dimen/library_edit_playlist_button_height"
            android:text="@string/dmusic_button_cancel"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:contentDescription="@string/playlist_detail_edit_cancel_content_description"
            android:layout_marginStart="@dimen/small_padding"
            app:layout_constraintBottom_toBottomOf="@+id/DoneButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/DoneButton"
            style="@style/Widget.AmazonMP3.Button.Done"/>
        <TextView
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/PlaylistNameTextView"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/library_edit_playlist_name_edittext_height"
            android:maxLines="2"
            android:layout_marginStart="@dimen/small_padding"
            android:layout_marginEnd="@dimen/small_padding"
            app:layout_constraintBottom_toTopOf="@+id/TrackCount"
            app:layout_constraintEnd_toStartOf="@+id/DoneButton"
            app:layout_constraintStart_toEndOf="@+id/HeaderButton"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0"
            style="@style/DetailViewContentName"/>
        <EditText
            android:textColor="@color/library_swatch_grey"
            android:id="@+id/PlaylistName"
            android:background="@drawable/rounded_background_edittext"
            android:nextFocusLeft="@+id/PlaylistName"
            android:nextFocusUp="@+id/PlaylistName"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:minHeight="@dimen/library_edit_playlist_name_edittext_height"
            android:inputType="text"
            android:layout_marginStart="@dimen/small_padding"
            android:layout_marginEnd="@dimen/small_padding"
            app:layout_constraintBottom_toTopOf="@+id/TrackCount"
            app:layout_constraintEnd_toStartOf="@+id/DoneButton"
            app:layout_constraintStart_toEndOf="@+id/HeaderButton"
            app:layout_constraintTop_toTopOf="parent"/>
        <Button
            android:id="@+id/DoneButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/minimum_button_width"
            android:minHeight="@dimen/library_edit_playlist_button_height"
            android:text="@string/dmusic_button_done"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_marginEnd="@dimen/small_padding"
            app:layout_constraintBottom_toTopOf="@+id/TrackCount"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Widget.AmazonMP3.Button.Done"/>
        <TextView
            android:gravity="center"
            android:id="@+id/TrackCount"
            android:paddingTop="@dimen/tiny_padding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/small_padding"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/ListItem.Secondary"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
