<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/playback_placeholder_background"
        android:background="@color/bauhaus_base"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <FrameLayout
        android:id="@+id/playback_view_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/playback_background_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
        <View
            android:background="@drawable/gradient_1_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.Guideline
                android:orientation="horizontal"
                android:id="@+id/playback_horizontal_guideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="0.18"/>
            <TextView
                android:id="@+id/playback_caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/playback_horizontal_margin"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/playback_horizontal_guideline"
                app:layout_constraintVertical_bias="0"
                style="@style/Playback.Caption"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:gravity="bottom"
            android:orientation="vertical"
            android:id="@+id/pause_playback_area"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:weightSum="2">
            <RelativeLayout
                android:id="@+id/playback_swipeable_area"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>
        </LinearLayout>
        <com.amazon.music.skyfire.ui.widgets.views.IconButtonView
            android:id="@+id/playback_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/playback_horizontal_margin"
            android:layout_marginTop="@dimen/spacer_small"
            app:iconButtonSize="@dimen/playback_icon_button_size"/>
        <RelativeLayout
            android:id="@+id/playback_paused_overlay"
            android:background="@color/secondary_glass_4"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0">
            <com.amazon.music.skyfire.ui.widgets.views.IconButtonView
                android:id="@+id/playback_paused_overlay_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                app:iconButtonSize="@dimen/playback_paused_button_size"
                app:imageSrc="@drawable/player_btn_play"/>
        </RelativeLayout>
        <LinearLayout
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingBottom="@dimen/spacer_medium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/playback_horizontal_margin"
            android:layout_marginRight="@dimen/playback_horizontal_margin"
            android:layout_marginHorizontal="@dimen/playback_horizontal_margin">
            <TextView
                android:id="@+id/playback_overline_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacer_micro"
                style="@style/Playback.OverlineText"/>
            <TextView
                android:id="@+id/playback_secondary_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Playback.SecondaryText"/>
            <include
                android:id="@+id/playback_progress_bar_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/playback_progress_bar"/>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                android:id="@+id/playback_action_buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </FrameLayout>
</merge>
