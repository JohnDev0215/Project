<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="@dimen/spacer_large"
    android:paddingBottom="@dimen/spacer_large"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:gravity="center"
        android:id="@+id/label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/action_bar_height"
        android:maxLines="1"
        app:layout_constraintBottom_toTopOf="@+id/headline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:gravity="center"
        android:id="@+id/headline"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacer_micro"
        android:maxLines="2"
        app:layout_constraintBottom_toTopOf="@+id/primary_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/label"/>
    <TextView
        android:gravity="center"
        android:id="@+id/primary_text"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacer_micro"
        android:maxLines="2"
        app:layout_constraintBottom_toTopOf="@+id/secondary_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headline"/>
    <TextView
        android:gravity="center"
        android:id="@+id/secondary_text"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacer_mini"
        android:maxLines="1"
        app:layout_constraintBottom_toTopOf="@+id/thumbnail"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/primary_text"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/thumbnail"
        android:visibility="gone"
        android:layout_width="@dimen/event_header_thumbnail_width"
        android:layout_height="@dimen/event_header_thumbnail_height"
        android:layout_marginTop="@dimen/spacer_medium"
        android:elevation="4dp"
        app:layout_constraintBottom_toTopOf="@+id/counter_days"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/secondary_text"/>
    <TextView
        android:id="@+id/counter_days"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacer_medium"
        android:maxLines="1"
        app:layout_constraintBottom_toTopOf="@+id/label_days"
        app:layout_constraintEnd_toStartOf="@+id/counter_hours"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/thumbnail"/>
    <TextView
        android:id="@+id/counter_hours"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/spacer_large"
        app:layout_constraintBottom_toBottomOf="@+id/counter_days"
        app:layout_constraintEnd_toStartOf="@+id/counter_minutes"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/counter_days"
        app:layout_constraintTop_toTopOf="@+id/counter_days"/>
    <TextView
        android:id="@+id/counter_minutes"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/spacer_large"
        app:layout_constraintBottom_toBottomOf="@+id/counter_days"
        app:layout_constraintEnd_toStartOf="@+id/counter_seconds"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/counter_hours"
        app:layout_constraintTop_toTopOf="@+id/counter_days"/>
    <TextView
        android:id="@+id/counter_seconds"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/spacer_large"
        app:layout_constraintBottom_toBottomOf="@+id/counter_days"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/counter_minutes"
        app:layout_constraintTop_toTopOf="@+id/counter_days"/>
    <TextView
        android:id="@+id/label_days"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacer_micro"
        android:maxLines="1"
        app:layout_constraintBottom_toTopOf="@+id/primary_button"
        app:layout_constraintEnd_toEndOf="@+id/counter_days"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/counter_days"
        app:layout_constraintTop_toBottomOf="@+id/counter_days"/>
    <TextView
        android:id="@+id/label_hours"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="@+id/label_days"
        app:layout_constraintEnd_toEndOf="@+id/counter_hours"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/counter_hours"
        app:layout_constraintTop_toTopOf="@+id/label_days"/>
    <TextView
        android:id="@+id/label_minutes"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="@+id/label_days"
        app:layout_constraintEnd_toEndOf="@+id/counter_minutes"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/counter_minutes"
        app:layout_constraintTop_toTopOf="@+id/label_days"/>
    <TextView
        android:id="@+id/label_seconds"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="@+id/label_days"
        app:layout_constraintEnd_toEndOf="@+id/counter_seconds"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/counter_seconds"
        app:layout_constraintTop_toTopOf="@+id/label_days"/>
    <com.amazon.ui.foundations.views.BaseButton
        android:id="@+id/primary_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacer_large"
        app:layout_constraintBottom_toTopOf="@+id/secondary_button"
        app:layout_constraintEnd_toEndOf="@+id/thumbnail"
        app:layout_constraintStart_toStartOf="@+id/thumbnail"
        app:layout_constraintTop_toBottomOf="@+id/label_days"/>
    <com.amazon.ui.foundations.views.BaseButton
        android:id="@+id/secondary_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacer_small"
        app:layout_constraintBottom_toTopOf="@+id/button_container"
        app:layout_constraintEnd_toEndOf="@+id/thumbnail"
        app:layout_constraintStart_toStartOf="@+id/thumbnail"
        app:layout_constraintTop_toBottomOf="@+id/primary_button"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/button_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacer_large"
        android:layout_marginStart="@dimen/spacer_mini"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/secondary_button"/>
</androidx.constraintlayout.widget.ConstraintLayout>
