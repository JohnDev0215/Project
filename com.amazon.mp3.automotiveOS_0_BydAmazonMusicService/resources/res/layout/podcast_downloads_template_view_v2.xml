<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <HorizontalScrollView
        android:id="@+id/podcast_downloads_template_v2_refinement_bar"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/podcast_spacer_base"
        android:layout_marginBottom="@dimen/podcast_spacer_base"
        android:paddingStart="@dimen/gutter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin">
            <com.amazon.podcast.views.refinements.RefinementBarItemView
                android:id="@+id/podcast_downloads_template_v2_refinement_sort"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <com.amazon.podcast.views.refinements.RefinementBarItemView
                android:id="@+id/podcast_downloads_template_v2_refinement_unplayed"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </HorizontalScrollView>
    <com.amazon.podcast.views.LoadingView
        android:id="@+id/podcast_downloads_template_v2_loading_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.amazon.podcast.views.MessageView
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/podcast_downloads_template_v2_message_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.amazon.podcast.views.episodeRowItemsListView.EpisodeRowItemsListView
        android:id="@+id/podcast_downloads_template_v2_episode_row_items_list_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/podcast_downloads_template_v2_refinement_bar"/>
</RelativeLayout>
