<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="@dimen/action_bar_height"
    android:paddingEnd="@dimen/margin"
    android:layout_marginEnd="@dimen/gutter">
    <ImageButton
        android:id="@+id/action_bar_back"
        android:background="@color/transparent"
        android:layout_width="@dimen/action_bar_button"
        android:layout_height="@dimen/action_bar_button"
        android:foreground="@drawable/ripple"
        android:src="@drawable/ic_navigation_goback"
        android:scaleType="center"
        android:contentDescription="@string/back_button_label"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/action_bar_placeholder_button"
        android:layout_width="@dimen/action_bar_button"
        android:layout_height="@dimen/action_bar_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.amazon.music.curate.skyfire.views.EmberTextView
        android:gravity="center"
        android:id="@+id/action_bar_header"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/action_bar_placeholder_button"
        app:layout_constraintStart_toEndOf="@+id/action_bar_back"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/CurateTheme.TextView.Headline4"/>
    <ImageView
        android:id="@+id/action_bar_mini_header"
        android:visibility="gone"
        android:layout_width="@dimen/icon_button_size_medium"
        android:layout_height="@dimen/icon_button_size_medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/action_bar_placeholder_button"
        app:layout_constraintStart_toEndOf="@+id/action_bar_back"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
