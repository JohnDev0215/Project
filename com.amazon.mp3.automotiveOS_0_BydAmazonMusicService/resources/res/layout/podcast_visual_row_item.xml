<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/podcast_spacer_large"
    android:foreground="@drawable/ripple"
    android:paddingStart="@dimen/margin"
    android:paddingEnd="@dimen/margin">
    <ImageView
        android:id="@+id/podcast_visual_row_item_image"
        android:layout_width="@dimen/podcast_visual_row_item_image_dimension"
        android:layout_height="@dimen/podcast_visual_row_item_image_dimension"
        android:layout_marginStart="@dimen/gutter"
        android:layout_marginEnd="@dimen/gutter"
        app:layout_constraintBottom_toBottomOf="@+id/podcast_visual_row_item_image_overlay"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/podcast_visual_row_item_image_overlay"/>
    <ImageView
        android:id="@+id/podcast_visual_row_item_image_overlay"
        android:visibility="invisible"
        android:layout_width="@dimen/podcast_visual_row_item_image_dimension"
        android:layout_height="@dimen/podcast_visual_row_item_image_dimension"
        android:layout_marginTop="@dimen/podcast_spacer_micro"
        android:src="@drawable/podcast_visual_row_item_artwork_overlay_rounded_corner"
        android:layout_marginStart="@dimen/gutter"
        android:layout_marginEnd="@dimen/gutter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/podcast_visual_row_item_image_equalizer"
        android:visibility="invisible"
        android:layout_width="@dimen/podcast_visual_row_item_image_dimension"
        android:layout_height="@dimen/podcast_visual_row_item_image_dimension"
        android:src="@drawable/podcast_equalizer_primary"
        android:scaleType="center"
        app:layout_constraintStart_toStartOf="@+id/podcast_visual_row_item_image"
        app:layout_constraintTop_toTopOf="@+id/podcast_visual_row_item_image"/>
    <ProgressBar
        android:id="@+id/podcast_visual_row_item_horizontal_progress_bar"
        android:visibility="invisible"
        android:layout_width="@dimen/podcast_visual_row_item_image_dimension"
        android:layout_height="@dimen/podcast_spacer_micro"
        android:indeterminate="false"
        android:progressDrawable="@drawable/detail_page_horizontal_progressbar_view"
        app:layout_constraintBottom_toBottomOf="@+id/podcast_visual_row_item_image"
        app:layout_constraintStart_toStartOf="@+id/podcast_visual_row_item_image"
        style="?android:attr/progressBarStyleHorizontal"/>
    <ImageView
        android:id="@+id/podcast_visual_row_item_small_icon"
        android:padding="@dimen/podcast_spacer_micro"
        android:visibility="invisible"
        android:layout_width="@dimen/podcast_spacer_huge"
        android:layout_height="@dimen/podcast_spacer_huge"
        android:src="@drawable/ic_badge_playback"
        android:layout_marginStart="@dimen/gutter"
        android:layout_marginEnd="@dimen/gutter"
        app:layout_constraintBottom_toBottomOf="@+id/podcast_visual_row_item_image"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/podcast_visual_row_item_center_large_icon"
        android:visibility="invisible"
        android:layout_width="@dimen/podcast_detail_template_center_large_icon_dimension"
        android:layout_height="@dimen/podcast_detail_template_center_large_icon_dimension"
        android:src="@drawable/ic_play"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        app:layout_constraintBottom_toBottomOf="@+id/podcast_visual_row_item_image"
        app:layout_constraintLeft_toLeftOf="@+id/podcast_visual_row_item_image"
        app:layout_constraintRight_toRightOf="@+id/podcast_visual_row_item_image"
        app:layout_constraintTop_toTopOf="@+id/podcast_visual_row_item_image"/>
    <com.amazon.podcast.views.DownloadButtonSmall
        android:id="@+id/podcast_visual_row_item_download"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/podcast_visual_row_item_text"
        app:layout_constraintEnd_toStartOf="@+id/podcast_visual_row_item_overflow_button"
        app:layout_constraintTop_toTopOf="@+id/podcast_visual_row_item_text"/>
    <ImageView
        android:id="@+id/podcast_visual_row_item_overflow_button"
        android:padding="@dimen/podcast_visual_row_item_icon_padding"
        android:layout_width="@dimen/podcast_visual_row_item_icon_dimension"
        android:layout_height="@dimen/podcast_visual_row_item_icon_dimension"
        android:src="@drawable/ic_more"
        android:layout_marginEnd="@dimen/gutter"
        app:layout_constraintBottom_toBottomOf="@+id/podcast_visual_row_item_download"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/podcast_visual_row_item_download"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/podcast_visual_row_item_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/podcast_spacer_base"
        android:layout_marginEnd="@dimen/podcast_spacer_mini"
        app:layout_constraintBottom_toBottomOf="@+id/podcast_visual_row_item_image_overlay"
        app:layout_constraintEnd_toStartOf="@+id/podcast_visual_row_item_download"
        app:layout_constraintStart_toEndOf="@+id/podcast_visual_row_item_image_overlay"
        app:layout_constraintTop_toTopOf="@+id/podcast_visual_row_item_image_overlay">
        <com.amazon.podcast.views.EmberTextView
            android:gravity="start|center_vertical"
            android:id="@+id/podcast_visual_row_item_primary_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            style="@style/PodcastAppTheme.TextView.Primary"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/podcast_download_icon"
                android:background="@drawable/download_icon_background"
                android:padding="@dimen/podcast_spacer_nano"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_other_arrowdown_black"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/podcast_spacer_micro"/>
            <com.amazon.podcast.views.EmberTextView
                android:id="@+id/podcast_visual_row_item_secondary_text"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/podcast_spacer_nano"
                android:maxLines="1"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@+id/podcast_download_icon"
                style="@style/PodcastAppTheme.TextView.Secondary"/>
        </RelativeLayout>
    </LinearLayout>
    <com.amazon.podcast.views.EmberTextView
        android:id="@+id/podcast_visual_row_item_tertiary_text"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/podcast_spacer_base"
        android:maxLines="1"
        app:layout_constraintStart_toStartOf="@+id/podcast_visual_row_item_image_overlay"
        app:layout_constraintTop_toBottomOf="@+id/podcast_visual_row_item_image_overlay"
        style="@style/PodcastAppTheme.TextView.TertiaryItalic"/>
    <com.amazon.podcast.views.EmberTextView
        android:id="@+id/podcast_visual_row_item_tertiary_following_text"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/podcast_spacer_base"
        android:maxLines="1"
        app:layout_constraintStart_toEndOf="@+id/podcast_visual_row_item_tertiary_text"
        app:layout_constraintTop_toBottomOf="@+id/podcast_visual_row_item_image"
        style="@style/PodcastAppTheme.TextView.TertiaryItalic"/>
    <com.amazon.podcast.views.EmberTextView
        android:id="@+id/podcast_visual_row_item_description"
        android:paddingBottom="@dimen/podcast_spacer_large"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/podcast_spacer_nano"
        android:maxLines="2"
        android:layout_marginStart="@dimen/gutter"
        app:layout_constraintEnd_toStartOf="@+id/podcast_visual_row_item_caretright"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/podcast_visual_row_item_tertiary_text"
        style="@style/PodcastAppTheme.TextView.VisualRowItemDescriptionText"/>
    <ImageView
        android:id="@+id/podcast_visual_row_item_caretright"
        android:paddingBottom="@dimen/podcast_spacer_medium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_chevron_caretright"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/podcast_visual_row_item_overflow_button"/>
</androidx.constraintlayout.widget.ConstraintLayout>
