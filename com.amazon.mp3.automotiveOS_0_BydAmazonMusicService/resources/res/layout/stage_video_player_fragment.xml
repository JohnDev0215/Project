<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/VideoPlaybackSurfaceLayout"
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentBottom="true"/>
    <FrameLayout
        android:id="@+id/VideoBackgroundOverlay"
        android:background="@color/secondary_glass_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/VideoPlaybackSurfaceLayout"
        android:layout_alignBottom="@+id/VideoPlaybackSurfaceLayout"/>
    <com.amazon.ui.foundations.views.BaseButton
        android:id="@+id/LandscapeVideoHeaderClose"
        android:visibility="gone"
        android:layout_width="@dimen/spacer_40"
        android:layout_height="@dimen/spacer_40"
        android:layout_marginTop="@dimen/spacer_6"
        android:src="@drawable/ic_chevron_caretdown"
        android:layout_alignParentTop="true"
        android:layout_marginStart="@dimen/stage_landscape_like_button_start_margin"
        android:layout_alignParentStart="true"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/LandscapeAudioVideoToggleView"
        android:paddingTop="@dimen/spacing_6dp"
        android:paddingBottom="@dimen/spacing_8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:paddingStart="@dimen/spacing_16dp"
        android:paddingEnd="@dimen/spacing_16dp"/>
    <com.amazon.mp3.view.player.PlayerMetadataView
        android:id="@+id/LandscapeVideoMetadataView"
        android:visibility="gone"
        android:layout_width="@dimen/stage_player_metadata_frame_width"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacer_6"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"/>
    <com.amazon.ui.foundations.views.BaseButton
        android:id="@+id/PortraitVideoPlayerToggleCaptions"
        android:visibility="gone"
        android:layout_width="@dimen/spacer_40"
        android:layout_height="@dimen/spacer_40"
        android:layout_marginTop="@dimen/spacer_16"
        android:layout_alignTop="@+id/VideoPlaybackSurfaceLayout"
        android:layout_marginStart="@dimen/spacer_16"
        android:layout_alignParentStart="true"/>
    <com.amazon.ui.foundations.views.BaseButton
        android:id="@+id/PortraitVideoPlayerExpandContract"
        android:visibility="gone"
        android:layout_width="@dimen/small_icon_button"
        android:layout_height="@dimen/small_icon_button"
        android:layout_marginTop="@dimen/spacer_16"
        android:layout_alignTop="@+id/VideoPlaybackSurfaceLayout"
        android:layout_marginEnd="@dimen/spacer_16"
        android:layout_alignParentEnd="true"/>
    <com.amazon.mp3.view.BauhausSeekBarWidget
        android:id="@+id/LandscapeSeekBar"
        android:background="@drawable/now_playing_seek_bar_gradient_background"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/LandscapePlaybackControlsAndBottomButtons"
        android:layout_marginStart="@dimen/stage_landscape_like_button_start_margin"
        android:layout_marginEnd="@dimen/stage_landscape_like_button_start_margin"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:translationZ="@dimen/now_playing_seekbar_height"
        style="@style/NowPlayingSeekBar"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/LandscapePlaybackControlsAndBottomButtons"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacer_8"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true">
        <com.amazon.mp3.view.stage.StageLandscapeControlsView
            android:id="@+id/LandscapePlaybackControlsView"
            android:visibility="visible"
            android:layout_width="@dimen/stage_landscape_buttons_layout_width"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ProgressBar
                android:id="@+id/LandscapeVideoProgress"
                android:visibility="gone"
                android:layout_width="@dimen/spacer_64"
                android:layout_height="@dimen/spacer_64"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </com.amazon.mp3.view.stage.StageLandscapeControlsView>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/LandscapeControlTipAndBottomButtons"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/stage_landscape_like_button_start_margin"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/ControlTip"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dmusic_stage_control_tip"
                android:layout_marginEnd="@dimen/spacer_12"/>
            <com.amazon.mp3.view.stage.StageBottomButtonsView
                android:id="@+id/BottomButtons"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.amazon.mp3.playback.view.VideoPreviewWindow
        android:id="@+id/VideoPreviewWindow"
        android:visibility="gone"
        android:layout_width="@dimen/videopreview_image_width"
        android:layout_height="match_parent"/>
</RelativeLayout>
