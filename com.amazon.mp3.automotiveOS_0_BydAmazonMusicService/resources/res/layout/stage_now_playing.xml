<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/PlayerCoverViewRoot"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/StageAlbumArtContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/stage_controls"
            app:layout_constraintTop_toTopOf="parent">
            <FrameLayout
                android:layout_gravity="center"
                android:id="@+id/StageAlbumArtDropShadow"
                android:background="@drawable/stage_drop_shadow_patch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacer_10">
                <com.amazon.ui.foundations.views.BaseImage
                    android:layout_gravity="center"
                    android:id="@+id/PlayerCoverViewAlbumArt"
                    android:layout_width="@dimen/stage_artwork_image_width"
                    android:layout_height="@dimen/stage_artwork_image_height"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/dmusic_cover_album_art"/>
                <com.amazon.ui.foundations.views.BaseImage
                    android:layout_gravity="center"
                    android:id="@+id/swap_art"
                    android:visibility="gone"
                    android:layout_width="@dimen/stage_artwork_image_width"
                    android:layout_height="@dimen/stage_artwork_image_height"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/dmusic_cover_album_art"/>
            </FrameLayout>
            <include layout="@layout/station_pulse"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/bauhausNowPlayingNonBlockingView"
            android:background="@drawable/portrait_lyrics_window_background"
            android:paddingLeft="@dimen/spacer_12"
            android:paddingTop="@dimen/spacer_8"
            android:paddingRight="@dimen/spacer_12"
            android:paddingBottom="@dimen/spacer_24"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/spacer_20"
            android:layout_marginRight="@dimen/spacer_20"
            android:cacheColorHint="@color/transparent"
            android:elevation="@dimen/bauhaus_nonblocking_upsell_elevation"
            app:layout_constraintBottom_toTopOf="@+id/stage_controls">
            <com.amazon.mp3.view.MessagingDialog
                android:id="@+id/messagingDialog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/OverlayContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/stage_controls"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/stage_controls_layout_bottom_margin"
            app:layout_constraintBottom_toBottomOf="@+id/PlayerCoverViewRoot">
            <com.amazon.mp3.view.stage.StageOverlayButtonsLayout
                android:id="@+id/stage_overlay_button_layout"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/spacer_28"
                android:layout_marginTop="@dimen/stage_overlay_button_layout_margin"
                app:layout_constraintStart_toStartOf="@+id/stage_player_metadata_container"
                app:layout_constraintTop_toTopOf="parent"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/stage_player_metadata_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/stage_overlay_button_layout_margin"
                android:layout_marginStart="@dimen/stage_controls_layout_start_margin"
                android:layout_marginEnd="@dimen/spacing_12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/stage_overlay_button_layout">
                <com.amazon.mp3.view.player.PlayerMetadataView
                    android:layout_gravity="start"
                    android:id="@+id/player_metadata"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <com.amazon.ui.foundations.views.BaseButton
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/StageLikeButton"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@+id/stage_player_metadata_container"
                app:layout_constraintStart_toStartOf="@+id/stage_player_metadata_container">
                <com.amazon.mp3.playback.view.VideoPreviewWindow
                    android:id="@+id/StageVideoPreviewWindow"
                    android:layout_width="@dimen/videopreview_image_width"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="@dimen/stage_video_preview_window_bottom_margin"/>
            </RelativeLayout>
            <com.amazon.mp3.view.BauhausSeekBarWidget
                android:id="@+id/stage_seekbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/stage_overlay_button_layout_margin"
                android:layout_marginStart="@dimen/spacing_14dp"
                android:layout_marginEnd="@dimen/spacing_14dp"
                android:translationZ="@dimen/now_playing_seekbar_height"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/stage_player_metadata_container"
                style="@style/NowPlayingSeekBar"/>
            <com.amazon.mp3.view.stage.StagePortraitPlaybackControlsView
                android:id="@+id/stage_portrait_controls"
                android:layout_width="@dimen/stage_portrait_buttons_layout_width"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/stage_portrait_playback_buttons_layout_top_margin"
                app:layout_constraintBottom_toTopOf="@+id/stage_bottom_buttons_view"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/stage_seekbar"/>
            <com.amazon.mp3.view.stage.StageBottomButtonsView
                android:id="@+id/stage_bottom_buttons_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/stage_portrait_bottom_buttons_layout_top_margin"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/stage_portrait_controls"/>
            <com.amazon.mp3.view.BauhausRibbon
                android:id="@+id/upsell_bauhaus_ribbon"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_40dp"
                app:layout_constraintEnd_toEndOf="@+id/stage_seekbar"
                app:layout_constraintStart_toStartOf="@+id/stage_seekbar"
                app:layout_constraintTop_toBottomOf="@+id/stage_portrait_controls"/>
            <ProgressBar
                android:id="@android:id/progress"
                android:visibility="invisible"
                android:layout_width="@dimen/stage_playback_progress_size"
                android:layout_height="@dimen/stage_playback_progress_size"
                app:layout_constraintBottom_toBottomOf="@+id/stage_portrait_controls"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="@+id/stage_portrait_controls"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:layout_gravity="center"
            android:id="@+id/toast_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/NowPlayingPersistentPlayerContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.amazon.mp3.view.TooltipView
        android:layout_gravity="end"
        android:id="@+id/TooltipDisplayerContainer"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacer_2"/>
</FrameLayout>
