<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/background_gradient"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/EmptySmartPlaylistsViewRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/PersistentPlayerContainer"
        android:layout_alignParentTop="true">
        <FrameLayout
            android:id="@+id/HeaderBarContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <RelativeLayout
            android:orientation="vertical"
            android:paddingTop="@dimen/subheader_padding_top"
            android:paddingBottom="@dimen/subheader_padding_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/subheader_padding_left"
            android:paddingEnd="@dimen/subheader_padding_right">
            <TextView
                android:id="@+id/PlaylistName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_toStartOf="@+id/HeaderButton"
                android:layout_alignParentStart="true"
                style="@style/TrackItemPrimaryText"/>
            <TextView
                android:id="@+id/TrackCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/PlaylistName"
                android:layout_toStartOf="@+id/HeaderButton"
                android:layout_alignParentStart="true"
                style="@style/TrackItemSecondaryText"/>
        </RelativeLayout>
        <ScrollView
            android:id="@+id/EmptyLatestPurchases"
            android:paddingTop="@dimen/spacing_16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/spacing_16dp"
            android:paddingEnd="@dimen/spacing_16dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/EmptyLatestPurchasesDesc"
                    android:paddingBottom="@dimen/spacing_12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dmusic_library_empty_smart_purchase_desc"/>
                <Button
                    android:id="@+id/ShopStoreButton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/headerbar_library_height"
                    android:layout_marginBottom="@dimen/spacing_12dp"
                    android:text="@string/dmusic_library_empty_shop"
                    style="@style/PrimaryButton"/>
            </LinearLayout>
        </ScrollView>
        <ScrollView
            android:id="@+id/EmptyLatestUploads"
            android:paddingTop="@dimen/spacing_16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/spacing_16dp"
            android:paddingEnd="@dimen/spacing_16dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/EmptyLatestUploadsDesc"
                    android:paddingBottom="@dimen/spacing_12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dmusic_library_empty_smart_uploaded_desc"/>
                <TextView
                    android:textColor="@color/activity_link_color"
                    android:id="@+id/EmptyLatestUploadsLearnMore"
                    android:background="@drawable/outline_box"
                    android:paddingBottom="@dimen/spacing_12dp"
                    android:focusable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dmusic_library_empty_smart_uploaded_learn_more"/>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/PersistentPlayerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
