<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/primo_blue"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="@dimen/spacing_12dp"
        android:paddingBottom="@dimen/spacing_12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/spacing_12dp"
        android:paddingEnd="@dimen/spacing_12dp">
        <TextView
            android:textAppearance="@style/DialogTitleText"
            android:gravity="center_vertical"
            android:id="@+id/pushalertTitle"
            android:background="@android:drawable/list_selector_background"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_12dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/networkPreferenceContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12dp"
            android:layout_marginBottom="@dimen/spacing_12dp">
            <CheckBox
                android:textColor="@color/dialog_text"
                android:id="@+id/cb_dmusic_subscription_music_promo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/dmusic_subscription_music_promo"
                android:buttonTint="@color/vivace_blue"/>
            <CheckBox
                android:textColor="@color/dialog_text"
                android:id="@+id/cb_dmusic_subscription_music_social"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/dmusic_subscription_music_social"
                android:buttonTint="@color/vivace_blue"/>
            <CheckBox
                android:textColor="@color/dialog_text"
                android:id="@+id/cb_dmusic_subscription_music_merch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/dmusic_subscription_music_merch"
                android:buttonTint="@color/vivace_blue"/>
            <CheckBox
                android:textColor="@color/dialog_text"
                android:id="@+id/cb_dmusic_subscription_music_live_stream"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/dmusic_subscription_music_live_stream"
                android:buttonTint="@color/vivace_blue"/>
            <CheckBox
                android:textColor="@color/dialog_text"
                android:id="@+id/cb_dmusic_subscription_music_podcast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/dmusic_subscription_music_podcast"
                android:buttonTint="@color/vivace_blue"/>
            <CheckBox
                android:textColor="@color/dialog_text"
                android:id="@+id/cb_dmusic_subscription_music_video"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/dmusic_subscription_music_video"
                android:buttonTint="@color/vivace_blue"/>
        </LinearLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/spacing_8dp"
            android:layout_marginEnd="@dimen/spacing_12dp">
            <Button
                android:textSize="@dimen/text_size_small"
                android:textColor="@color/vivace_blue"
                android:gravity="center"
                android:id="@+id/save"
                android:background="@color/transparent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/spacing_12dp"
                android:layout_alignParentEnd="true"/>
            <Button
                android:textSize="@dimen/text_size_small"
                android:textColor="@color/vivace_blue"
                android:gravity="center"
                android:id="@+id/cancel"
                android:background="@color/transparent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignWithParentIfMissing="true"
                android:layout_toStartOf="@+id/save"/>
        </RelativeLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
