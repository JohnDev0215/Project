<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/car_mode_blur_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"/>
        <ImageView
            android:id="@+id/car_mode_shadow_gradient_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/gradient1"/>
        <ImageView
            android:id="@+id/car_mode_shadow_secondary_glass_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@color/secondary_glass_1"/>
        <com.amazon.ui.foundations.views.BaseButton
            android:id="@+id/car_mode_close_button"
            android:focusable="true"
            android:visibility="visible"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacer_base"
            android:layout_marginStart="@dimen/spacer_base"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.amazon.ui.foundations.views.BaseButton
            android:id="@+id/car_mode_alexa_button"
            android:focusable="true"
            android:visibility="visible"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacer_base"
            android:layout_marginEnd="@dimen/spacer_base"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/car_mode_list"
            android:layout_width="match_parent"
            android:layout_height="@dimen/spacing_0dp"
            android:layout_marginTop="@dimen/spacer_20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/car_mode_close_button"/>
        <com.amazon.mp3.auto.carmode.view.CarModeMiniPlayerView
            android:id="@+id/car_mode_mini_player"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.amazon.mp3.auto.carmode.view.CarModeEmbeddedDialog
        android:id="@+id/car_mode_on_error_dialog"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/bauhaus_spacer_epic"
        android:layout_marginRight="@dimen/bauhaus_spacer_epic"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:layout_marginHorizontal="@dimen/bauhaus_spacer_epic"/>
    <ProgressBar
        android:id="@+id/loading_spinner"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        style="@style/dmmviewlibrary_progress_bar_large"/>
</RelativeLayout>
