<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/feature_play"
    android:background="@color/transparent"
    android:clickable="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/background_gradient_image_view"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/foreground_gradient_image_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            android:layout_weight="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </LinearLayout>
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:src="@drawable/feature_play_secondary_glass_gradient"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageButton
        android:id="@+id/PlayButton"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/text_views_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/t1r_top_margin_wide"
        android:layout_marginStart="@dimen/spacer_giant"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent="0.6">
        <TextView
            android:textSize="@dimen/text_size_t4"
            android:ellipsize="end"
            android:id="@+id/label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacer_micro"
            android:maxLines="1"
            android:layout_weight="2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/FeaturedPlayLabel"/>
        <TextView
            android:textSize="@dimen/text_size_h2"
            android:ellipsize="end"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacer_micro"
            android:maxLines="2"
            android:layout_weight="2"
            android:lineSpacingExtra="@dimen/t1r_title_line_padding"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/label"
            style="@style/FeaturedPlayEntityTitle"/>
        <TextView
            android:textSize="@dimen/text_size_t1"
            android:ellipsize="end"
            android:id="@+id/primary_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacer_micro"
            android:maxLines="2"
            android:layout_weight="2"
            app:layout_constraintTop_toBottomOf="@+id/title"
            style="@style/FeaturedPlayPrimary"/>
        <TextView
            android:ellipsize="end"
            android:id="@+id/secondary_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacer_mini"
            android:maxLines="1"
            android:layout_weight="2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/primary_text"
            style="@style/FeaturedPlaySecondary"/>
        <TextView
            android:ellipsize="end"
            android:id="@+id/tertiary_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacer_mini"
            android:maxLines="1"
            android:layout_weight="2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/secondary_text"
            style="@style/FeaturedPlayTertiary"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <RelativeLayout
        android:gravity="center"
        android:id="@+id/PlayButtonWideScreen"
        android:background="@drawable/primary_glass_2_rounded_corners"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/spacer_epic"
        android:layout_marginTop="@dimen/spacer_large"
        android:layout_marginBottom="@dimen/t1r_bottom_wide"
        android:layout_marginStart="@dimen/spacer_giant"
        android:layout_marginEnd="@dimen/spacer_large"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_views_layout"
        style="@style/ShowcaseButton">
        <ImageView
            android:id="@+id/widescreen_ingress_button_image"
            android:layout_width="@dimen/spacer_large"
            android:layout_height="@dimen/spacer_large"
            android:layout_alignTop="@+id/widescreen_ingress_button_text"
            android:layout_alignBottom="@+id/widescreen_ingress_button_text"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/spacer_base"
            android:layout_marginEnd="@dimen/spacer_small"
            android:layout_alignParentStart="true"/>
        <TextView
            android:gravity="center"
            android:id="@+id/widescreen_ingress_button_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/spacer_large"
            android:layout_toEndOf="@+id/widescreen_ingress_button_image"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
