<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:orientation="vertical"
        android:background="@color/artwork_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_gravity="top"
            android:id="@+id/now_playing_about_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
        <ImageView
            android:background="@color/secondary_glass_4"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="@dimen/gutter">
            <com.amazon.podcast.nowplaying.MiniPlayerView
                android:id="@+id/mini_player_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/now_playing_about_view_tab_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/podcast_spacer_large"
                android:layout_below="@+id/mini_player_view"
                app:tabPaddingEnd="@dimen/podcast_tab_padding"
                app:tabPaddingStart="@dimen/podcast_tab_padding"
                style="@style/PodcastAppTheme.Tabs"/>
            <androidx.viewpager.widget.ViewPager
                android:id="@+id/now_playing_about_view_view_pager"
                android:paddingLeft="@dimen/margin"
                android:paddingRight="@dimen/margin"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/gutter"
                android:layout_marginRight="@dimen/gutter"
                android:layout_below="@+id/now_playing_about_view_tab_layout"/>
        </RelativeLayout>
    </RelativeLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
