<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.amazon.mp3.view.GradientBackgroundView
        android:layout_width="match_parent"
        android:layout_height="@dimen/gradient_background_height"/>
    <TextView
        android:id="@+id/UnknownCountryTitleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gradient_background_height"
        android:text="@string/dmusic_unknown_country_title"
        android:layout_alignParentTop="true"
        style="@style/UnknownCountryTitle"/>
    <TextView
        android:id="@+id/UnknownCountryText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="@string/dmusic_unknown_country_desc"
        android:layout_below="@+id/UnknownCountryTitleText"
        style="@style/UnknownCountryDesc"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:layout_below="@+id/UnknownCountryText">
        <Button
            android:theme="@style/DefaultButton"
            android:id="@+id/sign_out"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dmusic_unknown_country_sign_out"/>
    </LinearLayout>
</RelativeLayout>
