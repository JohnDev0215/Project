<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="horizontal"
    android:background="@null"
    android:paddingBottom="@dimen/spacer_base"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/peek_image"
        android:layout_width="@dimen/peek_menu_icon_size"
        android:layout_height="@dimen/peek_menu_icon_size"/>
    <TextView
        android:textSize="@dimen/text_t3"
        android:textColor="@color/primary"
        android:id="@+id/peek_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/spacer_mini"/>
</LinearLayout>
