<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="@dimen/song_tile_detail_height"
    android:baselineAligned="false">
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/ArtworkFrame"
        android:layout_width="@dimen/song_tile_art_size"
        android:layout_height="@dimen/song_tile_art_size"
        android:layout_marginRight="@dimen/song_tile_text_indent"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true">
        <ImageView
            android:id="@+id/Artwork"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/playlist_placeholder"
            android:adjustViewBounds="true"
            android:maxWidth="@dimen/song_tile_art_size"
            android:maxHeight="@dimen/song_tile_art_size"/>
    </FrameLayout>
    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/song_title_top_margin"
        android:layout_marginRight="@dimen/overflow_button_clickable_size"
        android:layout_marginBottom="@dimen/song_title_bottom_margin"
        android:singleLine="true"
        android:layout_toRightOf="@+id/ArtworkFrame"
        android:layout_alignRight="@+id/add_button_holder"
        android:layout_alignWithParentIfMissing="true"
        style="@style/PrimaryText"/>
    <TextView
        android:id="@+id/counts"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginRight="@dimen/overflow_button_clickable_size"
        android:singleLine="true"
        android:layout_toRightOf="@+id/ArtworkFrame"
        android:layout_below="@+id/title"
        android:layout_alignRight="@+id/add_button_holder"
        android:layout_alignWithParentIfMissing="true"
        style="@style/SecondaryText"/>
    <include
        android:id="@+id/overflow_button_open"
        android:layout_width="@dimen/overflow_button_clickable_size"
        android:layout_height="@dimen/overflow_button_clickable_size"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        layout="@layout/overflow_button"/>
</RelativeLayout>
