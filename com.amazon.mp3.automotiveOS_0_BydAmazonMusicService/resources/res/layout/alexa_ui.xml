<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/alexa_background_gradient_layer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true">
    <View
        android:id="@+id/chrome_border"
        android:background="@drawable/chrome_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="bottom|center_horizontal"
        android:orientation="vertical"
        android:id="@+id/content_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/chrome"
        android:layout_alignWithParentIfMissing="true">
        <ImageView
            android:id="@+id/iv_alexa"
            android:background="@drawable/ic_alexa"
            android:layout_width="@dimen/alexa_icon_width"
            android:layout_height="@dimen/alexa_icon_height"
            android:layout_marginBottom="@dimen/alexa_icon_margin_bottom"
            android:contentDescription="@string/dmusic_alexa_icon"/>
        <com.amazon.music.voice.ui.widget.SmoothResizeFrameLayout
            android:id="@+id/body_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/body_inner_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@+id/hints_container"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/alexa_static_chrome_size"
                    android:layout_marginEnd="@dimen/alexa_static_chrome_size">
                    <TextView
                        android:id="@+id/tv_hint_prefix"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/alexa_hint_prefix_bottom_margin"
                        android:text="@string/alexa_hint_prefix"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/hints_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/alexa_hints_list_bottom_margin"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/error_message_container"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/error_inner_container"
                        android:visibility="visible"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <View
                            android:id="@+id/left_error_spacer"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="7"/>
                        <TextView
                            android:id="@+id/tv_message"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/alexa_permission_reason"
                            android:layout_weight="26"
                            style="@style/AlexaMessageTextView"/>
                        <View
                            android:id="@+id/right_error_spacer"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="7"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:orientation="horizontal"
                        android:id="@+id/buttons_container"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacer_12"
                        android:layout_marginBottom="@dimen/spacer_48">
                        <com.amazon.ui.foundations.views.BaseButton
                            android:id="@+id/btn_negative"
                            android:layout_width="@dimen/alexa_buttons_width"
                            android:layout_height="wrap_content"
                            android:minWidth="@dimen/alexa_buttons_min_width"
                            android:layout_marginEnd="@dimen/alexa_buttons_anchor_size"/>
                        <com.amazon.ui.foundations.views.BaseButton
                            android:id="@+id/btn_positive"
                            android:layout_width="@dimen/alexa_buttons_width"
                            android:layout_height="wrap_content"
                            android:minWidth="@dimen/alexa_buttons_min_width"/>
                    </LinearLayout>
                    <View
                        android:background="@color/alexa_static_error_chrome_color"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/alexa_static_chrome_size"/>
                </LinearLayout>
            </LinearLayout>
        </com.amazon.music.voice.ui.widget.SmoothResizeFrameLayout>
    </LinearLayout>
    <com.amazon.music.voice.ui.widget.ChromeView
        android:id="@+id/chrome"
        android:layout_width="match_parent"
        android:layout_height="@dimen/alexa_chrome_total_height"
        android:layout_alignParentBottom="true"
        app:chrome1="@drawable/voice_ui_chrome_glow"
        app:chrome2="@drawable/voice_ui_chrome_glow"
        app:chrome4="@drawable/voice_ui_chrome_glow"
        app:chrome5="@drawable/voice_ui_chrome_glow"
        app:chromeHeight="@dimen/alexa_chrome_height"
        app:chromeMiddle="@drawable/voice_ui_chrome_glow"
        app:colour="@color/alexa_chrome_color"/>
</RelativeLayout>
