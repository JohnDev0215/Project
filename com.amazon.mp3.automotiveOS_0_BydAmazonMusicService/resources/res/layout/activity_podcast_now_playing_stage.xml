<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:background="@drawable/now_playing_top_gradient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true"/>
    <View
        android:background="@drawable/now_playing_bottom_gradient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentBottom="true"/>
    <ImageView
        android:layout_gravity="top"
        android:id="@+id/now_playing_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:foreground="@drawable/now_playing_background_gradient"
        android:scaleType="centerCrop"/>
    <ImageView
        android:background="@color/secondary_glass_3"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:paddingLeft="@dimen/gutter_and_margin"
            android:paddingTop="@dimen/podcast_spacer_milli"
            android:paddingRight="@dimen/gutter_and_margin"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true">
            <RelativeLayout
                android:id="@+id/top_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/cancel_button"
                    android:background="@drawable/button_circle"
                    android:padding="@dimen/podcast_spacer_mini"
                    android:layout_width="@dimen/podcast_stage_header_bar_height"
                    android:layout_height="@dimen/podcast_stage_header_bar_height"
                    android:src="@drawable/ic_chevron_caretdown"
                    android:contentDescription="@string/podcast_back_button_label"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/close_button"
                    android:background="@drawable/button_circle"
                    android:padding="@dimen/podcast_spacer_mini"
                    android:visibility="gone"
                    android:layout_width="@dimen/podcast_stage_header_bar_height"
                    android:layout_height="@dimen/podcast_stage_header_bar_height"
                    android:src="@drawable/ic_podcast_action_cancel"
                    android:contentDescription="@string/podcast_cancel_button"/>
                <View
                    android:layout_gravity="center"
                    android:id="@+id/podcast_art_placeholder"
                    android:background="@color/transparent"
                    android:layout_width="@dimen/podcast_stage_header_bar_height"
                    android:layout_height="@dimen/podcast_stage_header_bar_height"
                    android:src="@color/transparent"
                    android:scaleType="centerCrop"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
            <com.amazon.podcast.nowplayingstage.MetadataView
                android:id="@+id/now_playing_metadata"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/top_bar"
                android:layout_centerHorizontal="true"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/transport_area"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/now_playing_metadata"
                android:layout_alignParentBottom="true">
                <com.amazon.podcast.nowplayingstage.TransportView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/now_playing_transport"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </RelativeLayout>
        <com.amazon.podcast.views.RibbonNotificationView
            android:id="@+id/now_playing_notification_ribbon"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:elevation="10dp"/>
    </RelativeLayout>
    <View
        android:id="@+id/podcast_now_playing_filter"
        android:background="@color/secondary"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/podcast_playback_speed_bottom_sheet"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:behavior_hideable="true"
        app:behavior_peekHeight="@dimen/zero_dp"
        app:layout_behavior="@string/bottom_sheet_behavior">
        <com.amazon.podcast.nowplayingstage.PlaybackSpeedSelectionView
            android:id="@+id/podcast_now_playing_playback_speed_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/podcast_sleep_timer_duration_bottom_sheet"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:behavior_hideable="true"
        app:behavior_peekHeight="@dimen/zero_dp"
        app:layout_behavior="@string/bottom_sheet_behavior">
        <com.amazon.podcast.nowplayingstage.SleepTimerSelectionView
            android:id="@+id/podcast_now_playing_sleep_timer_duration_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/podcast_full_screen_transcription_bottom_sheet"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:behavior_hideable="true"
        app:behavior_peekHeight="@dimen/zero_dp"
        app:layout_behavior="@string/bottom_sheet_behavior">
        <com.amazon.podcast.views.transcription.FullScreenTranscriptView
            android:id="@+id/podcast_full_screen_transcription_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
