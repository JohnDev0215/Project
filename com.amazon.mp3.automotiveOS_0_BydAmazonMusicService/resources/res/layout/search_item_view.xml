<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@drawable/search_row_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:layout_width="0dp"
        android:layout_height="@dimen/divider_height"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/prime_search_divider"/>
    <ImageView
        android:id="@+id/AlbumArtwork"
        android:layout_width="@dimen/song_tile_art_size"
        android:layout_height="@dimen/song_tile_art_size"
        android:src="@drawable/song_placeholder"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="@+id/track_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/track_container"/>
    <ImageView
        android:enabled="false"
        android:id="@+id/artwork_badge"
        android:paddingBottom="@dimen/song_tile_title_padding"
        android:focusable="false"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/station_thumb_outline"
        android:scaleType="center"
        android:paddingStart="@dimen/song_tile_title_padding"
        app:layout_constraintBottom_toBottomOf="@+id/AlbumArtwork"
        app:layout_constraintStart_toStartOf="@+id/AlbumArtwork"/>
    <com.amazon.mp3.view.PlayNotificationIcon
        android:id="@+id/PlayNotificationIcon"
        android:background="@color/dimmed"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="@dimen/song_tile_art_size"
        android:layout_height="@dimen/song_tile_art_size"
        android:scaleType="center"
        app:layout_constraintBottom_toBottomOf="@+id/track_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/track_container"
        app:useLargeIcons="false"/>
    <ImageView
        android:id="@+id/DimAlbumArtOverlay"
        android:background="@color/dimmed"
        android:visibility="gone"
        android:layout_width="@dimen/song_tile_art_size"
        android:layout_height="@dimen/song_tile_art_size"
        app:layout_constraintBottom_toBottomOf="@+id/track_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/track_container"/>
    <ImageView
        android:id="@+id/PlaystateIcon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/mp3_icon_songplaying_paused"
        app:layout_constraintBottom_toBottomOf="@+id/AlbumArtwork"
        app:layout_constraintEnd_toEndOf="@+id/AlbumArtwork"
        app:layout_constraintStart_toStartOf="@+id/AlbumArtwork"
        app:layout_constraintTop_toTopOf="@+id/AlbumArtwork"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/track_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="@dimen/spacing_8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/add_button_holder"
        app:layout_constraintStart_toEndOf="@+id/AlbumArtwork"
        app:layout_constraintTop_toTopOf="@+id/prime_search_divider">
        <TextView
            android:textColor="@color/blue_accent"
            android:id="@+id/labelTitle"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/LabelText"/>
        <TextView
            android:id="@+id/TrackTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            style="@style/PrimaryText"/>
        <TextView
            android:ellipsize="marquee"
            android:id="@+id/ArtistName"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            style="@style/SecondaryText"/>
        <TextView
            android:id="@+id/recommendation_reason"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            style="@style/ReasonText"/>
    </LinearLayout>
    <com.amazon.mp3.view.BadgeView
        android:id="@+id/ContentEncodingBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_4dp"
        app:layout_constraintStart_toStartOf="@+id/track_container"
        app:layout_constraintTop_toBottomOf="@+id/track_container"
        style="@style/ContentEncodingBadge"/>
    <com.amazon.mp3.view.BadgeView
        android:id="@+id/ImmersiveBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@+id/ContentEncodingBadge"
        app:layout_constraintTop_toBottomOf="@+id/track_container"
        style="@style/ContentEncodingBadge"/>
    <include
        android:id="@+id/add_button_holder"
        android:layout_width="@dimen/overflow_button_clickable_size"
        android:layout_height="@dimen/overflow_button_clickable_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/overflow_button_open"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/add_button"/>
    <ImageView
        android:id="@+id/missing_sd_card"
        android:visibility="gone"
        android:layout_width="@dimen/song_tile_add_button_size"
        android:layout_height="@dimen/song_tile_add_button_size"
        android:src="@drawable/sd_card_missing"
        android:scaleType="center"
        android:contentDescription="@string/sd_card_not_found_dialog_title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/overflow_button_open"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/add_done_icon"
        android:visibility="gone"
        android:layout_width="@dimen/song_tile_add_button_size"
        android:layout_height="@dimen/song_tile_add_button_size"
        android:src="@drawable/ic_cloud_done"
        android:scaleType="fitCenter"
        android:cropToPadding="false"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/overflow_button_open"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageButton
        android:id="@+id/add_suggested_song_button"
        android:background="@drawable/playlist_btn_add"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="@dimen/song_tile_add_button_size"
        android:layout_height="@dimen/song_tile_add_button_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/overflow_button_open"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:id="@+id/overflow_button_open"
        android:layout_width="@dimen/overflow_button_clickable_size"
        android:layout_height="@dimen/overflow_button_clickable_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/overflow_button"/>
    <include
        android:id="@+id/music_unlimited_logo"
        android:layout_width="@dimen/tile_music_unlimited_logo_width"
        android:layout_height="@dimen/tile_music_unlimited_logo_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/music_unlimited_logo"/>
</androidx.constraintlayout.widget.ConstraintLayout>
