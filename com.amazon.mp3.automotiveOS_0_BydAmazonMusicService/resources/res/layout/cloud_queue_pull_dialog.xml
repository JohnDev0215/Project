<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacer_medium"
        android:text="@string/cloudqueue_pull_dialog_title"
        app:layout_constraintBottom_toTopOf="@+id/description"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <TextView
        android:gravity="center_horizontal"
        android:id="@+id/description"
        android:paddingLeft="@dimen/spacer_medium"
        android:paddingRight="@dimen/spacer_medium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/cloudqueue_pull_dialog_description"
        android:textAlignment="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/move_stream_checkbox_text"
        android:paddingLeft="@dimen/spacer_mini"
        android:paddingRight="@dimen/spacer_mini"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacer_mini"
        android:text="@string/cloudqueue_pull_dialog_always_move_stream_checkbox"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/description"/>
    <CheckBox
        android:id="@+id/move_stream_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:button="@null"
        android:drawableStart="@drawable/settings_checkbox"
        app:layout_constraintBottom_toBottomOf="@+id/move_stream_checkbox_text"
        app:layout_constraintRight_toLeftOf="@+id/move_stream_checkbox_text"
        app:layout_constraintTop_toTopOf="@+id/move_stream_checkbox_text"/>
    <com.amazon.ui.foundations.views.BaseButton
        android:id="@+id/play_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacer_medium"
        android:layout_marginStart="@dimen/spacer_medium"
        android:layout_marginEnd="@dimen/spacer_medium"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/move_stream_checkbox_text"/>
    <com.amazon.ui.foundations.views.BaseButton
        android:id="@+id/cancel_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacer_medium"
        android:layout_marginEnd="@dimen/spacer_medium"
        app:layout_constraintBottom_toTopOf="@+id/title"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
