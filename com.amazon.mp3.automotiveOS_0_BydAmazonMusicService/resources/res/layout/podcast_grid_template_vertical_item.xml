<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:clickable="true"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/podcast_spacer_large"
    android:layout_marginStart="@dimen/gutter">
    <ImageView
        android:id="@+id/grid_template_vertical_item_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <ImageButton
        android:id="@+id/grid_template_vertical_item_play_button"
        android:background="@drawable/vertical_item_circle_button_background"
        android:visibility="invisible"
        android:layout_width="@dimen/podcast_spacer_epic"
        android:layout_height="@dimen/podcast_spacer_epic"
        android:layout_margin="@dimen/podcast_spacer_mini"
        android:src="@drawable/ic_play"
        android:adjustViewBounds="true"
        android:layout_alignBottom="@+id/grid_template_vertical_item_image"/>
    <ProgressBar
        android:id="@+id/grid_template_vertical_item_horizontal_progress_bar"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/podcast_spacer_micro"
        android:indeterminate="false"
        android:progressDrawable="@drawable/vertical_item_horizontal_progressbar_view"
        android:layout_alignBottom="@+id/grid_template_vertical_item_image"
        style="?android:attr/progressBarStyleHorizontal"/>
    <com.amazon.podcast.views.EmberTextView
        android:id="@+id/grid_template_vertical_item_primary_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/podcast_spacer_small"
        android:maxLines="2"
        android:layout_below="@+id/grid_template_vertical_item_image"
        style="@style/PodcastAppTheme.TextView.Primary"/>
    <com.amazon.podcast.views.EmberTextView
        android:id="@+id/grid_template_vertical_item_secondary_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/podcast_spacer_nano"
        android:maxLines="1"
        android:layout_below="@+id/grid_template_vertical_item_primary_text"
        style="@style/PodcastAppTheme.TextView.Secondary"/>
</RelativeLayout>
