<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:amazonmp3="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/search_row_background"
    android:layout_width="match_parent"
    android:layout_height="@dimen/playlist_tile_detail_height"
    android:minHeight="@dimen/playlist_tile_detail_height">
    <FrameLayout
        android:id="@+id/AlbumArtworkFrame"
        android:layout_width="@dimen/playlist_tile_art_size"
        android:layout_height="@dimen/playlist_tile_art_size"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/playlist_tile_art_indent"
        android:layout_alignParentStart="true">
        <ImageView
            android:id="@+id/artwork"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/album_placeholder"/>
        <com.amazon.mp3.view.PlayNotificationIcon
            android:layout_gravity="center"
            android:id="@+id/PlaystateIcon"
            android:background="@color/dimmed"
            android:visibility="gone"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="center"
            amazonmp3:useLargeIcons="true"/>
    </FrameLayout>
    <include
        android:id="@+id/overflow_button_open"
        android:layout_width="@dimen/overflow_button_clickable_size"
        android:layout_height="@dimen/overflow_button_clickable_size"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/screen_margin"
        android:layout_alignParentEnd="true"
        layout="@layout/overflow_button"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@+id/overflow_button_open"
        android:layout_toEndOf="@+id/AlbumArtworkFrame">
        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/PlaylistTilePrimaryText"/>
        <TextView
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/subtitle"
            android:paddingTop="@dimen/playlist_tile_description_spacing"
            android:paddingBottom="@dimen/playlist_tile_description_spacing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            style="@style/SecondaryText"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/badge_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.amazon.mp3.view.BadgeView
                android:id="@+id/ContentEncodingBadgeTile"
                android:layout_marginEnd="@dimen/spacing_4dp"
                style="@style/ContentEncodingBadge"/>
            <com.amazon.mp3.view.BadgeView
                android:id="@+id/ImmersiveBadgeTile"
                style="@style/ContentEncodingBadge"/>
            <com.amazon.mp3.view.BadgeView
                android:id="@+id/ImmersiveExtraBadgeTile"
                style="@style/ContentEncodingBadge"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
