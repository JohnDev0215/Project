<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/margin"
    android:paddingEnd="@dimen/margin">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/podcast_spacer_small"
        android:layout_marginBottom="@dimen/podcast_spacer_large"
        android:layout_marginStart="@dimen/gutter"
        android:layout_marginEnd="@dimen/gutter">
        <com.amazon.podcast.views.EmberTextView
            android:gravity="center"
            android:id="@+id/podcast_ptc_categories_leading_button"
            android:layout_height="@dimen/podcast_button_medium"
            android:minWidth="@dimen/ptc_podcast_skip"
            android:layout_alignParentStart="true"
            style="@style/PodcastAppTheme.TextView.ButtonMediumGlass"/>
        <com.amazon.podcast.views.EmberTextView
            android:gravity="center"
            android:id="@+id/podcast_ptc_categories_trailing_button"
            android:layout_height="@dimen/podcast_button_medium"
            android:minWidth="@dimen/ptc_podcast_skip"
            android:layout_alignParentEnd="true"
            style="@style/PodcastAppTheme.TextView.ButtonMediumSolid"/>
    </RelativeLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gutter"
        android:layout_marginEnd="@dimen/gutter">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.amazon.podcast.views.EmberTextView
                android:gravity="center"
                android:id="@+id/podcast_ptc_categories_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/PodcastAppTheme.TextView.Headline2"/>
            <com.amazon.podcast.views.EmberTextView
                android:gravity="center"
                android:id="@+id/podcast_ptc_categories_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/podcast_spacer_base"
                style="@style/PodcastAppTheme.TextView.Secondary"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/podcast_ptc_pill_listing_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/podcast_spacer_epic"
                android:nestedScrollingEnabled="false"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
