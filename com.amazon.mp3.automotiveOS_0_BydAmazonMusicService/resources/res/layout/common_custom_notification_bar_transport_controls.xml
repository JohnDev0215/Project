<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/TextContainer"
        android:paddingLeft="@dimen/spacing_12dp"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_toLeftOf="@+id/WidgetPlayerPrevButton"
        android:layout_alignParentLeft="true">
        <TextView
            android:textSize="@dimen/notification_tray_title_text_size"
            android:textColor="@color/notification_tray_title_color"
            android:ellipsize="end"
            android:id="@+id/notification_bar_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <TextView
            android:textSize="@dimen/notification_tray_subtitle_text_size"
            android:textColor="@color/notification_tray_subtitle_color"
            android:ellipsize="end"
            android:id="@+id/notification_bar_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
    </LinearLayout>
    <ImageButton
        android:id="@+id/WidgetPlayerPrevButton"
        android:background="@null"
        android:paddingLeft="@dimen/medium_padding"
        android:paddingRight="@dimen/medium_padding"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/notification_bar_button_size"
        android:src="@drawable/player_btn_prev_tray"
        android:layout_toLeftOf="@+id/WidgetPlayerButtonFrame"
        android:layout_centerVertical="true"
        android:contentDescription="@string/dmusic_player_previous_button_description"/>
    <RelativeLayout
        android:id="@+id/WidgetPlayerButtonFrame"
        android:background="@null"
        android:paddingRight="@dimen/medium_padding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toLeftOf="@+id/WidgetPlayerNextButton"
        android:layout_centerVertical="true">
        <ImageButton
            android:id="@+id/WidgetPlayerPlayButton"
            android:background="@null"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/notification_bar_button_size"
            android:src="@drawable/player_btn_play_tray"
            android:contentDescription="@string/dmusic_player_btn_play_description"/>
        <ImageButton
            android:id="@+id/WidgetPlayerPauseButton"
            android:background="@null"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/notification_bar_button_size"
            android:src="@drawable/player_btn_pause_tray"
            android:contentDescription="@string/dmusic_player_btn_pause_description"/>
        <ProgressBar
            android:id="@+id/WidgetPlayerProgressBar"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignLeft="@+id/WidgetPlayerPlayButton"
            android:layout_alignTop="@+id/WidgetPlayerPlayButton"
            android:layout_alignRight="@+id/WidgetPlayerPlayButton"
            android:layout_alignBottom="@+id/WidgetPlayerPlayButton"/>
    </RelativeLayout>
    <ImageButton
        android:id="@+id/WidgetPlayerNextButton"
        android:background="@null"
        android:paddingRight="@dimen/medium_padding"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/notification_bar_button_size"
        android:src="@drawable/player_btn_next_tray"
        android:layout_toLeftOf="@+id/WidgetPlayerCancelButton"
        android:layout_centerVertical="true"
        android:contentDescription="@string/dmusic_player_btn_next_description"/>
    <ImageButton
        android:id="@+id/WidgetPlayerCancelButton"
        android:background="@null"
        android:padding="@dimen/notification_bar_cancel_button_padding"
        android:layout_width="@dimen/notification_bar_button_size"
        android:layout_height="@dimen/notification_bar_button_size"
        android:src="@drawable/cancel_btn_notification_tray"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:contentDescription="@string/dmusic_button_cancel"
        android:alpha="0.35"/>
</RelativeLayout>
