<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/car_mode_mini_player_overlay"
        android:layout_width="@dimen/spacing_0dp"
        android:layout_height="@dimen/spacing_0dp"
        android:src="@drawable/car_mode_mini_player_gradient_overlay"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacer_micro"
        android:src="@drawable/car_mode_mini_player_drag_handle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.amazon.ui.foundations.views.BaseImage
        android:id="@+id/car_mode_mini_player_artwork"
        android:layout_width="@dimen/car_mode_mini_player_artwork_size"
        android:layout_height="@dimen/car_mode_mini_player_artwork_size"
        android:layout_margin="@dimen/spacer_medium"
        android:src="@drawable/placeholder"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/car_mode_mini_player_info"
        android:layout_width="@dimen/spacing_0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/spacer_12"
        android:layout_marginRight="@dimen/spacer_12"
        android:layout_marginHorizontal="@dimen/spacer_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/car_mode_mini_player_controls"
        app:layout_constraintStart_toEndOf="@+id/car_mode_mini_player_artwork"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/text_size_28"
            android:textColor="@color/white"
            android:ellipsize="marquee"
            android:id="@+id/car_mode_mini_player_title"
            android:fadingEdge="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:marqueeRepeatLimit="1"
            android:textAllCaps="true"
            android:fontFamily="@font/amazon_ember_display_cd_heavy"/>
        <TextView
            android:textSize="@dimen/text_size_medium"
            android:textColor="@color/primary"
            android:ellipsize="end"
            android:id="@+id/car_mode_mini_player_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:alpha="@dimen/opacity_sixty_percent"
            android:fontFamily="@font/amazon_ember_bold"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/car_mode_mini_player_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/car_mode_mini_player_info"
        app:layout_constraintTop_toTopOf="parent">
        <com.amazon.ui.foundations.views.BaseButton
            android:id="@+id/car_mode_mini_player_play_button"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/next_forward_button_barrier"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/next_forward_button_barrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="left"
            app:constraint_referenced_ids="car_mode_mini_player_next_button, car_mode_mini_player_forward_button"/>
        <com.amazon.ui.foundations.views.BaseButton
            android:id="@+id/car_mode_mini_player_next_button"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacer_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.amazon.ui.foundations.views.BaseButton
            android:id="@+id/car_mode_mini_player_forward_button"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacer_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ProgressBar
            android:id="@+id/car_mode_mini_player_loading_spinner"
            android:visibility="gone"
            android:layout_width="@dimen/spacer_40"
            android:layout_height="@dimen/spacer_40"
            android:layout_marginLeft="@dimen/spacer_4"
            android:layout_marginRight="@dimen/spacer_4"
            android:layout_marginHorizontal="@dimen/spacer_4"
            app:layout_constraintBottom_toBottomOf="@+id/car_mode_mini_player_play_button"
            app:layout_constraintEnd_toStartOf="@+id/next_forward_button_barrier"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/car_mode_mini_player_play_button"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
