<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/experience_visual_shoveler_view"
    android:paddingTop="@dimen/podcast_spacer_large"
    android:paddingBottom="@dimen/podcast_spacer_large"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/experience_visual_shoveler_header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/gutter_and_margin"
        android:paddingEnd="@dimen/gutter_and_margin">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/experience_visual_shoveler_primary_button"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/podcast_button_small"
            android:layout_centerInParent="true"
            android:paddingStart="@dimen/podcast_spacer_mini"
            android:paddingEnd="@dimen/podcast_spacer_base"
            android:layout_alignParentEnd="true"
            style="@style/PodcastAppTheme.TextView.ButtonSmallGlass">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/experience_visual_shoveler_primary_button_icon"
                android:visibility="gone"
                android:layout_width="@dimen/podcast_spacer_small"
                android:layout_height="@dimen/podcast_spacer_small"
                android:src="@drawable/ic_play"
                android:scaleType="centerInside"/>
            <com.amazon.podcast.views.EmberTextView
                android:id="@+id/experience_visual_shoveler_primary_button_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/podcast_spacer_mini"
                style="@style/PodcastAppTheme.TextAppearance.T3.ButtonSmall"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/podcast_card_episode_podcast_titles_metadata"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="yes"
            android:layout_toStartOf="@+id/experience_visual_shoveler_primary_button"
            android:layout_alignParentStart="true">
            <com.amazon.podcast.views.EmberTextView
                android:id="@+id/experience_visual_shoveler_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/podcast_spacer_micro"
                android:maxLines="2"
                style="@style/PodcastAppTheme.TextView.Headline4"/>
            <com.amazon.podcast.views.EmberTextView
                android:id="@+id/experience_visual_shoveler_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                style="@style/PodcastAppTheme.TextView.Secondary"/>
        </LinearLayout>
    </RelativeLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/experience_visual_shoveler_recycler_view"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/podcast_spacer_huge"
        android:layout_below="@+id/experience_visual_shoveler_header_layout"
        android:paddingStart="@dimen/podcast_spacer_small"
        android:paddingEnd="@dimen/podcast_spacer_small"/>
</RelativeLayout>
