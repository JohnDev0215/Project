<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/download_notif_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:gravity="center"
            android:id="@+id/imgv_download_icon"
            android:layout_width="@dimen/notification_icon_width"
            android:layout_height="match_parent"
            android:src="@drawable/ic_notification_tray_downloading"
            android:scaleType="center"
            android:layout_alignParentLeft="true"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="6dp"
            android:layout_toLeftOf="@+id/button_layout"
            android:layout_toRightOf="@+id/imgv_download_icon"
            android:layout_centerVertical="true">
            <TextView
                android:textAppearance="@style/DownloadTitle"
                android:id="@+id/tv_download_title"
                android:paddingTop="@dimen/notification_text_padding_top"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textIsSelectable="false"/>
            <ProgressBar
                android:id="@+id/progress_bar"
                android:paddingTop="@dimen/progress_bar_padding"
                android:paddingBottom="@dimen/progress_bar_padding"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="?android:attr/progressBarStyleHorizontal"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textAppearance="@style/DownloadProgressStatus"
                    android:id="@+id/tv_progress_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/downloading_text"
                    android:textIsSelectable="false"/>
                <TextView
                    android:textAppearance="@style/DownloadProgressPercent"
                    android:id="@+id/tv_progress_percent"
                    android:paddingLeft="@dimen/notification_percent_left_padding"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textIsSelectable="false"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/button_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true">
            <ImageView
                android:id="@+id/resume_button"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/notification_download_resume"
                android:contentDescription="@string/resume_button"/>
            <ImageView
                android:id="@+id/pause_button"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/notification_download_pause"
                android:contentDescription="@string/pause_button"/>
            <ProgressBar
                android:id="@+id/download_notification_progressbar"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <ImageView
                android:id="@+id/cancel_button"
                android:paddingLeft="8dp"
                android:paddingRight="20dp"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/notification_download_cancel"
                android:contentDescription="@string/cancel_button"/>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
