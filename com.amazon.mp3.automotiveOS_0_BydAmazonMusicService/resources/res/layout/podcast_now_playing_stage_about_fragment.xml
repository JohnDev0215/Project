<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="now_playing_about_frag"
    android:scrollbars="none"
    android:fadingEdgeLength="150dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/podcast_spacer_epic"
    android:requiresFadingEdge="vertical">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.amazon.podcast.views.EmberTextView
            android:id="@+id/description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/PodcastAppTheme.TextView.AboutOverlayDescriptionText"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
