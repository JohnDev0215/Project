<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="end"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:layout_marginEnd="@dimen/equalizer_db_text_margin_right">
    <TextView
        android:textSize="@dimen/equalizer_db_text_size"
        android:textColor="@color/white"
        android:id="@+id/equalizer_db_max_label"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:text="@string/equalizer_db_max_placeholder_text"
        android:layout_weight="1"/>
    <TextView
        android:textSize="@dimen/equalizer_db_text_size"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/equalizer_db_0_label"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:text="@string/equalizer_db_0_text"
        android:layout_weight="1"/>
    <TextView
        android:textSize="@dimen/equalizer_db_text_size"
        android:textColor="@color/white"
        android:gravity="bottom"
        android:id="@+id/equalizer_db_min_label"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:text="@string/equalizer_db_min_placeholder_text"
        android:layout_weight="1"/>
    <androidx.legacy.widget.Space
        android:layout_width="match_parent"
        android:layout_height="@dimen/equalizer_band_label_spacing"/>
    <androidx.legacy.widget.Space
        android:layout_width="match_parent"
        android:layout_height="@dimen/equalizer_hz_text_size"/>
</LinearLayout>
