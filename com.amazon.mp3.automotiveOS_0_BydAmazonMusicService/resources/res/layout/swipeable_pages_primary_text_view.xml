<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/swipeable_pages_clickable_text_container"
    style="@style/SwipeablePages.TextContainer">
    <TextView
        android:id="@+id/swipeable_pages_partitioned_clickable_text"
        style="@style/SwipeablePages.Text.PrimaryText.Partitioned"/>
    <LinearLayout
        android:id="@+id/swipeable_pages_clickable_text_link_container"
        android:layout_below="@+id/swipeable_pages_partitioned_clickable_text"
        style="@style/SwipeablePages.LinearLayout.ClickableTextLink">
        <TextView
            android:id="@+id/swipeable_pages_clickable_text"
            style="@style/SwipeablePages.Text.PrimaryText"/>
        <ImageButton
            android:id="@+id/swipeable_pages_clickable_text_link"
            style="@style/Link.Primary"/>
    </LinearLayout>
</RelativeLayout>
