<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/BackgroundImageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <com.amazon.mp3.playback.view.MiniPlayerViewWithProgressBar
        android:id="@+id/mini_player_with_progress_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.amazon.mp3.playback.view.lyrics.LyricsListViewContainer
        android:id="@+id/LyricsListViewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/LyricsListView"
            android:background="@color/transparent"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"/>
    </com.amazon.mp3.playback.view.lyrics.LyricsListViewContainer>
    <com.amazon.ui.foundations.views.BaseButton
        android:id="@+id/ShareLyrics"
        android:visibility="gone"
        android:layout_width="@dimen/lyrics_sharing_share_button_width"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/small_padding"
        android:layout_above="@+id/mini_player_with_progress_bar"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="@dimen/text_size_h4"
        android:textColor="@color/white"
        android:id="@+id/SelectLines"
        android:background="@android:color/transparent"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/small_padding"
        android:text="@string/lyric_sharing_select_lyrics"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:backgroundTint="@null"
        android:textFontWeight="@dimen/semi_bold"/>
    <TextView
        android:id="@+id/SelectCounter"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8dp"
        android:text="@string/default_no_lines_selected_text"
        android:layout_below="@+id/SelectLines"
        android:layout_centerHorizontal="true"
        android:textFontWeight="@dimen/semi_bold"/>
    <Button
        android:textColor="@color/white"
        android:id="@+id/Next"
        android:background="@drawable/next_button_bg"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_20"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:backgroundTint="@color/grey"/>
    <com.amazon.ui.foundations.views.BaseButton
        android:id="@+id/ExitLyricsFullScreen"
        android:visibility="gone"
        android:layout_width="@dimen/small_icon_button"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/spacer_20"
        android:layout_marginTop="@dimen/small_padding"
        android:src="@drawable/exit_button_icon"
        android:backgroundTint="@color/transparent"/>
    <com.amazon.ui.foundations.views.BaseButton
        android:id="@+id/lyrics_feedback_button"
        android:visibility="invisible"
        android:layout_width="@dimen/small_icon_button"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/small_padding"
        android:layout_marginBottom="@dimen/standard_padding"
        android:layout_marginEnd="@dimen/spacer_20"/>
</RelativeLayout>
