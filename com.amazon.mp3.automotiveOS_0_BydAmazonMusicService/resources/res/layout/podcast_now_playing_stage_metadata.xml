<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/podcast_art_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/podcast_artwork_size">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/podcast_art"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="centerCrop"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/overlay_container"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/overlay_button_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/podcast_spacer_medium"
        android:layout_below="@+id/overlay_container">
        <com.amazon.podcast.views.EmberTextView
            android:gravity="center"
            android:id="@+id/about_overlay_button"
            android:paddingLeft="@dimen/podcast_spacer_base"
            android:paddingRight="@dimen/podcast_spacer_base"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/podcast_button_small"
            android:text="@string/podcast_about_view_tab_label"
            style="@style/PodcastAppTheme.TextView.ButtonSmallGlassUnpressed"/>
        <com.amazon.podcast.views.EmberTextView
            android:gravity="center"
            android:id="@+id/transcript_overlay_button"
            android:paddingLeft="@dimen/podcast_spacer_base"
            android:paddingRight="@dimen/podcast_spacer_base"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/podcast_button_small"
            android:text="@string/podcast_transcript"
            android:layout_marginStart="@dimen/podcast_spacer_small"
            style="@style/PodcastAppTheme.TextView.ButtonSmallGlassUnpressed"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/podcast_now_playing_marquee_title_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/podcast_spacer_small"
        android:layout_below="@+id/overlay_button_layout"
        android:layout_alignStart="@+id/overlay_button_layout">
        <com.amazon.podcast.views.FadingEdgeTextView
            android:ellipsize="marquee"
            android:id="@+id/podcast_now_playing_title"
            android:fadingEdgeLength="@dimen/podcast_spacer_base"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:marqueeRepeatLimit="marquee_forever"
            android:requiresFadingEdge="horizontal"
            style="@style/PodcastAppTheme.TextView.Headline4"/>
    </LinearLayout>
    <com.amazon.podcast.views.EmberTextView
        android:id="@+id/podcast_now_playing_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/podcast_spacer_mini"
        android:layout_below="@+id/podcast_now_playing_marquee_title_container"
        android:layout_alignStart="@+id/podcast_now_playing_marquee_title_container"
        style="@style/PodcastAppTheme.TextView.Primary"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/podcast_spacer_epic"
        android:layout_below="@+id/podcast_now_playing_subtitle"
        android:layout_alignStart="@+id/podcast_now_playing_subtitle">
        <SeekBar
            android:layout_gravity="center"
            android:id="@+id/podcast_now_playing_seekbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            style="@style/PodcastAppTheme.NowPlaying.SeekBar"/>
        <com.amazon.podcast.views.EmberTextView
            android:id="@+id/podcast_progress_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:layout_alignParentBottom="true"
            android:layout_alignStart="@+id/podcast_now_playing_seekbar"
            style="@style/PodcastAppTheme.TextView.LabelInActive"/>
        <com.amazon.podcast.views.EmberTextView
            android:id="@+id/podcast_duration_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-00:00"
            android:layout_alignParentBottom="true"
            android:layout_alignEnd="@+id/podcast_now_playing_seekbar"
            style="@style/PodcastAppTheme.TextView.LabelInActive"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/expanded_metadata_controls"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/podcast_spacer_base"
        android:layout_below="@+id/overlay_container"
        android:layout_alignParentBottom="true"
        android:layout_alignStart="@+id/overlay_container"
        android:layout_alignEnd="@+id/overlay_container">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/expanded_title_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@+id/expanded_playpause"
            android:layout_alignParentLeft="true">
            <com.amazon.podcast.views.FadingEdgeTextView
                android:ellipsize="marquee"
                android:id="@+id/expanded_title"
                android:fadingEdgeLength="@dimen/podcast_spacer_base"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scrollHorizontally="true"
                android:singleLine="true"
                android:marqueeRepeatLimit="marquee_forever"
                android:requiresFadingEdge="horizontal"
                style="@style/PodcastAppTheme.TextView.Headline4"/>
            <com.amazon.podcast.views.EmberTextView
                android:id="@+id/expanded_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/podcast_spacer_mini"
                android:layout_below="@+id/expanded_title"
                android:layout_alignStart="@+id/expanded_title"
                style="@style/PodcastAppTheme.TextView.Primary"/>
        </LinearLayout>
        <ImageButton
            android:layout_gravity="center_vertical"
            android:id="@+id/expanded_playpause"
            android:background="@drawable/button_circle"
            android:padding="@dimen/podcast_spacer_small"
            android:layout_width="@dimen/podcast_medium_icon_button"
            android:layout_height="@dimen/podcast_medium_icon_button"
            android:src="@drawable/ic_other_loader"
            android:scaleType="fitCenter"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</RelativeLayout>
