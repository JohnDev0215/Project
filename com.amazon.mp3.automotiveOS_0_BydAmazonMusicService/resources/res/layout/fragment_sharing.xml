<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/thumbnail"
        android:layout_width="@dimen/share_header_thumbnail_size"
        android:layout_height="@dimen/share_header_thumbnail_size"
        android:layout_marginTop="@dimen/share_header_margin"
        app:layout_constraintBottom_toTopOf="@+id/label"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:gravity="center"
        android:id="@+id/label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/share_header_imargin"
        android:layout_marginStart="@dimen/share_header_margin"
        android:layout_marginEnd="@dimen/share_header_margin"
        app:layout_constraintBottom_toTopOf="@+id/title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/thumbnail"/>
    <TextView
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/share_header_margin"
        android:layout_marginEnd="@dimen/share_header_margin"
        app:layout_constraintBottom_toTopOf="@+id/subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/label"/>
    <TextView
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/share_header_imargin"
        android:layout_marginBottom="@dimen/share_header_margin"
        android:maxLines="1"
        android:layout_marginStart="@dimen/share_header_margin"
        android:layout_marginEnd="@dimen/share_header_margin"
        app:layout_constraintBottom_toTopOf="@+id/scroll_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/dismiss_button"
        app:layout_constraintHeight_min="@dimen/share_scroller_min_height"
        app:layout_constraintTop_toBottomOf="@+id/subtitle">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/item_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </androidx.core.widget.NestedScrollView>
    <TextView
        android:gravity="center"
        android:id="@+id/dismiss_button"
        android:background="@drawable/selector_default"
        android:layout_width="match_parent"
        android:layout_height="@dimen/share_dismiss_button_height"
        android:text="@string/dmusic_generic_dismiss"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_min="@dimen/share_scroller_min_height"
        app:layout_constraintTop_toBottomOf="@+id/scroll_view"/>
    <View
        android:id="@+id/divider"
        android:background="@color/share_divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/share_divider_height"
        android:layout_marginStart="@dimen/share_item_padding"
        android:layout_marginEnd="@dimen/share_item_padding"
        app:layout_constraintTop_toTopOf="@+id/dismiss_button"/>
</androidx.constraintlayout.widget.ConstraintLayout>
