<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:background="@drawable/selector_item_background_color"
        android:paddingBottom="@dimen/tile_bottom_padding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/AlbumArtworkFrame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true">
            <com.amazon.mp3.view.BadgeableView
                android:id="@+id/cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <ImageView
                android:id="@+id/AlbumPrimeIndicator"
                android:visibility="gone"
                android:layout_width="@dimen/medium_prime_sash_size"
                android:layout_height="@dimen/medium_prime_sash_size"
                android:src="@drawable/prime_sash"
                android:scaleType="fitCenter"/>
            <View
                android:id="@+id/AlbumArtTouchOverlay"
                android:background="@drawable/selector_artwork_mask"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <ImageView
                android:id="@+id/DimAlbumArtOverlay"
                android:background="@color/dimmed"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/PlaystateIcon"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/mp3_icon_songplaying_paused"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/OverflowButtonContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/AlbumArtworkFrame"
            android:layout_alignParentRight="true">
            <include layout="@layout/overflow_button"/>
        </FrameLayout>
        <View
            android:id="@+id/button_offset"
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"/>
        <TextView
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/AlbumItemTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/tile_text_indent"
            android:layout_marginTop="@dimen/tile_primary_text_top_margin"
            android:singleLine="true"
            android:layout_toLeftOf="@+id/button_offset"
            android:layout_below="@+id/AlbumArtworkFrame"
            android:layout_alignParentLeft="true"
            style="@style/TilePrimaryText"/>
        <TextView
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/AlbumItemCreator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/tile_text_indent"
            android:layout_marginTop="@dimen/tile_secondary_text_top_margin"
            android:singleLine="true"
            android:layout_toLeftOf="@+id/button_offset"
            android:layout_below="@+id/AlbumItemTitle"
            android:layout_alignParentLeft="true"
            style="@style/TileSecondaryText"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/tile_text_indent"
            android:layout_marginTop="@dimen/tile_secondary_text_top_margin"
            android:layout_toLeftOf="@+id/button_offset"
            android:layout_below="@+id/AlbumItemCreator"
            android:layout_alignParentLeft="true">
            <com.amazon.mp3.view.BadgeView
                android:id="@+id/KatanaBadge"
                android:layout_marginRight="@dimen/spacing_4dp"
                style="@style/ContentEncodingBadge"/>
            <com.amazon.mp3.view.BadgeView
                android:id="@+id/ImmersiveBadge"
                android:layout_marginRight="@dimen/spacing_4dp"
                style="@style/ContentEncodingBadge"/>
        </LinearLayout>
        <com.amazon.mp3.view.DownloadProgressBadgeView
            android:id="@+id/DownloadProgress"
            android:visibility="gone"
            android:layout_width="@dimen/download_circular_progress_bar_width"
            android:layout_height="@dimen/download_circular_progress_bar_width"
            android:layout_margin="@dimen/standard_padding"
            android:layout_marginRight="@dimen/listview_horizontal_padding"
            android:layout_below="@+id/AlbumArtworkFrame"
            android:layout_alignParentRight="true"/>
        <ImageButton
            android:id="@+id/AddAllButton"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tiny_padding"
            android:src="@drawable/playlist_btn_add"
            android:minWidth="@dimen/minimum_button_width"
            android:layout_below="@+id/AlbumArtworkFrame"
            android:layout_alignParentRight="true"
            android:contentDescription="@string/add_all_content_description"/>
    </RelativeLayout>
</FrameLayout>
