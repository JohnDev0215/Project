<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="left"
    android:orientation="vertical"
    android:background="@drawable/source_toggle_row_color"
    android:padding="@dimen/dialog_outside_margin"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="@style/DialogTitleText"
        android:gravity="center_vertical"
        android:id="@+id/StreamingNetworkPrefTitle"
        android:background="@android:drawable/list_selector_background"
        android:paddingBottom="@dimen/dialog_text_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dmusic_setting_audio_streaming_network_title"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textAppearance="@style/DialogBodyText"
                android:gravity="center_vertical"
                android:id="@+id/StreamingNetworkPrefHeader"
                android:background="@android:drawable/list_selector_background"
                android:paddingBottom="@dimen/dialog_text_padding"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4dp"
                android:text="@string/dmusic_setting_audio_streaming_network_item_header"/>
            <CheckedTextView
                android:textAppearance="@style/SDCardDialogButtonText"
                android:gravity="center_vertical"
                android:id="@+id/StreamingNetworkPrefAll"
                android:background="@drawable/source_toggle_row_color"
                android:paddingBottom="@dimen/dialog_small_border_padding"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dialog_radio_button_row_height"
                android:checkMark="@drawable/abc_btn_radio_material"
                android:text="@string/dmusic_setting_streaming_network_item_all"
                android:checkMarkTint="@color/vivace_blue"
                style="@style/SDCardDialogButton"/>
            <CheckedTextView
                android:textAppearance="@style/SDCardDialogButtonText"
                android:gravity="center_vertical"
                android:id="@+id/StreamingNetworkPrefWifiOnly"
                android:background="@drawable/source_toggle_row_color"
                android:paddingBottom="@dimen/dialog_small_border_padding"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dialog_radio_button_row_height"
                android:checkMark="@drawable/abc_btn_radio_material"
                android:text="@string/dmusic_setting_streaming_network_item_wifi_only"
                android:checkMarkTint="@color/vivace_blue"
                style="@style/SDCardDialogButton"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
