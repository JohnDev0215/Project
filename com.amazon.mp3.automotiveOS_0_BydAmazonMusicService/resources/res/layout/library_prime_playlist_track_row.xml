<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/TrackRowContainer"
    android:background="@drawable/selector_item_background_color"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/library_list_view_item_height_2_lines">
        <RelativeLayout
            android:id="@+id/AlbumArtworkFrame"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/default_listview_art_size"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/screen_margin">
            <androidx.cardview.widget.CardView xmlns:card_view="http://schemas.android.com/apk/res-auto"
                android:id="@+id/AlbumArtworkView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                card_view:cardCornerRadius="@dimen/default_corner_radius_cardview"
                card_view:cardElevation="@dimen/default_card_elevation_cardview">
                <com.amazon.music.views.library.views.FixedAspectImageView
                    android:id="@+id/AlbumArtwork"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/default_listview_art_size"
                    android:src="@drawable/placeholder_sm"
                    android:scaleType="centerCrop"/>
            </androidx.cardview.widget.CardView>
            <com.amazon.mp3.view.TextSashImageView
                android:id="@+id/NewSash"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/AlbumArtworkView"
                android:layout_alignBottom="@+id/AlbumArtworkView"
                android:layout_alignStart="@+id/AlbumArtworkView"
                android:layout_alignEnd="@+id/AlbumArtworkView"/>
            <View
                android:background="@drawable/selector_artwork_mask"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/AlbumArtworkView"
                android:layout_alignBottom="@+id/AlbumArtworkView"
                android:layout_alignStart="@+id/AlbumArtworkView"
                android:layout_alignEnd="@+id/AlbumArtworkView"/>
            <ImageView
                android:id="@+id/DimAlbumArtOverlay"
                android:background="@color/dimmed"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/AlbumArtworkView"
                android:layout_alignBottom="@+id/AlbumArtworkView"
                android:layout_alignStart="@+id/AlbumArtworkView"
                android:layout_alignEnd="@+id/AlbumArtworkView"/>
            <ImageView
                android:id="@+id/PlaystateIcon"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/mp3_icon_songplaying_paused"
                android:layout_alignTop="@+id/AlbumArtworkView"
                android:layout_alignBottom="@+id/AlbumArtworkView"
                android:layout_centerInParent="true"
                android:layout_alignStart="@+id/AlbumArtworkView"
                android:layout_alignEnd="@+id/AlbumArtworkView"/>
        </RelativeLayout>
        <RelativeLayout
            android:gravity="center_vertical"
            android:id="@+id/TrackAndArtistTextContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/standard_padding"
            android:layout_toStartOf="@+id/RightViews"
            android:layout_toEndOf="@+id/AlbumArtworkFrame">
            <FrameLayout
                android:id="@+id/TrackCountFrame"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/library_group_track_number_min_width"
                android:drawablePadding="@dimen/small_padding"
                android:layout_alignBottom="@+id/TrackTitle"
                android:paddingEnd="@dimen/standard_padding">
                <TextView
                    android:layout_gravity="end"
                    android:id="@+id/TrackCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/LibraryListItemPrimaryTextDim"/>
            </FrameLayout>
            <TextView
                android:id="@+id/TrackTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:drawablePadding="@dimen/small_padding"
                android:layout_alignWithParentIfMissing="true"
                android:paddingEnd="@dimen/standard_padding"
                android:layout_toEndOf="@+id/TrackCountFrame"
                style="@style/LibraryListItemPrimaryText"/>
            <TextView
                android:id="@+id/ArtistName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_below="@+id/TrackTitle"
                android:layout_alignStart="@+id/TrackTitle"
                style="@style/LibraryListItemSecondaryText"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/TrackAndArtistTextContainer"
            android:paddingStart="@dimen/library_group_track_number_min_width"
            android:layout_alignStart="@+id/TrackAndArtistTextContainer">
            <com.amazon.mp3.view.BadgeView
                android:id="@+id/KatanaBadge"
                android:layout_marginEnd="@dimen/spacing_4dp"
                style="@style/ContentEncodingBadge"/>
            <com.amazon.mp3.view.BadgeView
                android:id="@+id/ImmersiveBadge"
                android:layout_marginEnd="@dimen/spacing_4dp"
                android:layout_toEndOf="@+id/KatanaBadge"
                style="@style/ContentEncodingBadge"/>
        </RelativeLayout>
        <FrameLayout
            android:id="@+id/RightViews"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/overflow_button_open">
            <ImageView
                android:id="@+id/AddToLibraryButton"
                android:visibility="visible"
                android:layout_width="@dimen/song_tile_add_button_size"
                android:layout_height="@dimen/song_tile_add_button_size"
                android:src="@drawable/add_to_library_button"
                android:scaleType="center"
                android:contentDescription="@string/add_to_library_content_description"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/add_done_icon"
                android:visibility="gone"
                android:layout_width="@dimen/song_tile_add_button_size"
                android:layout_height="@dimen/song_tile_add_button_size"
                android:src="@drawable/ic_cloud_done"
                android:scaleType="center"
                android:cropToPadding="false"
                android:alpha="0"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/missing_sd_card"
                android:visibility="gone"
                android:layout_width="@dimen/song_tile_add_button_size"
                android:layout_height="@dimen/song_tile_add_button_size"
                android:src="@drawable/sd_card_missing"
                android:scaleType="center"
                android:contentDescription="@string/sd_card_not_found_dialog_title"/>
            <include
                android:id="@+id/station_icon_in_right_views"
                android:visibility="gone"
                android:layout_width="@dimen/overflow_button_clickable_size"
                android:layout_height="@dimen/overflow_button_clickable_size"
                layout="@layout/track_row_station_icon"/>
        </FrameLayout>
        <include
            android:layout_width="@dimen/overflow_button_clickable_size"
            android:layout_height="@dimen/overflow_button_clickable_size"
            android:layout_alignTop="@+id/TrackAndArtistTextContainer"
            android:layout_marginEnd="@dimen/screen_margin"
            android:layout_alignParentEnd="true"
            layout="@layout/overflow_button"/>
        <include
            android:id="@+id/station_icon"
            android:visibility="gone"
            android:layout_width="@dimen/overflow_button_clickable_size"
            android:layout_height="@dimen/overflow_button_clickable_size"
            android:paddingStart="@dimen/spacing_4dp"
            android:paddingEnd="@dimen/spacing_4dp"
            android:layout_marginEnd="@dimen/screen_margin"
            android:layout_alignParentEnd="true"
            layout="@layout/track_row_station_icon"/>
    </RelativeLayout>
</LinearLayout>
