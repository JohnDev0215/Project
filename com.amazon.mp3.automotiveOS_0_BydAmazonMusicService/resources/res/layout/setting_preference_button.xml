<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingTop="@dimen/spacing_4dp"
    android:paddingBottom="@dimen/spacer_4"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/text_size_medium"
        android:textColor="@color/bauhaus_primary"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@android:id/title"
        android:background="@drawable/button_circle"
        android:layout_width="match_parent"
        android:layout_height="@dimen/spacing_40dp"
        android:layout_margin="@dimen/spacing_14dp"
        android:fontFamily="@font/amazon_ember_bold"
        android:textAlignment="center"
        android:layout_marginStart="@dimen/spacing_14dp"
        style="@style/PreferenceSummary"/>
    <TextView
        android:layout_gravity="center"
        android:id="@android:id/summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/PreferenceSummary"/>
</LinearLayout>
