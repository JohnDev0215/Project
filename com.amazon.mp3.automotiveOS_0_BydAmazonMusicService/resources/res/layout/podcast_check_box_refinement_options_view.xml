<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/podcast_refinement_layout"
    android:background="@color/podcast_overlay_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:orientation="vertical"
        android:id="@+id/podcast_overlay_refinement_container_top_stroke"
        android:background="@color/primary_glass_3"
        android:layout_width="match_parent"
        android:layout_height="@dimen/podcast_divider_height"
        android:layout_alignParentTop="true"/>
    <RelativeLayout
        android:id="@+id/podcast_refinement_options_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/podcast_overlay_refinement_container_top_stroke"
        android:paddingStart="@dimen/gutter"
        android:paddingEnd="@dimen/gutter"
        android:layout_marginStart="@dimen/margin"
        android:layout_marginEnd="@dimen/margin">
        <com.amazon.podcast.views.EmberTextView
            android:id="@+id/podcast_refinement_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/podcast_spacer_medium"
            android:text="Title"
            style="@style/PodcastAppTheme.TextView.Headline4"/>
        <com.amazon.podcast.views.EmberTextView
            android:gravity="center"
            android:id="@+id/podcast_refinement_reset_button"
            android:layout_height="@dimen/podcast_button_small"
            android:text="@string/podcast_reset_label"
            android:layout_alignTop="@+id/podcast_refinement_title"
            android:layout_alignBottom="@+id/podcast_refinement_title"
            android:layout_marginStart="@dimen/podcast_spacer_base"
            android:layout_alignParentEnd="true"
            style="@style/PodcastAppTheme.TextView.ButtonSmallGlass"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/podcast_refinement_items_recycler_view"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/podcast_spacer_medium"
            android:layout_below="@+id/podcast_refinement_title"/>
        <com.google.android.material.button.MaterialButton
            android:gravity="center"
            android:id="@+id/podcast_refinement_positive_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/podcast_apply_label"
            android:layout_below="@+id/podcast_refinement_items_recycler_view"
            android:layout_centerInParent="true"
            app:rippleColor="@color/primary_glass_4"
            style="@style/PodcastAppTheme.ButtonSolid"/>
    </RelativeLayout>
    <com.amazon.podcast.views.EmberTextView
        android:gravity="center"
        android:id="@+id/podcast_refinement_dismiss"
        android:layout_width="match_parent"
        android:layout_height="@dimen/podcast_playback_speed_item_height"
        android:layout_marginTop="@dimen/podcast_spacer_small"
        android:text="@string/podcast_dismiss_label"
        android:layout_below="@+id/podcast_refinement_options_container"
        style="@style/PodcastAppTheme.TextView.Primary"/>
    <View
        android:id="@+id/podcast_pop_up_refinement_bottom_spacer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/podcast_spacer_medium"
        android:layout_below="@+id/podcast_refinement_options_container"/>
</RelativeLayout>
