<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/profile_setting_background_black"
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/profile_setting_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"/>
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@+id/nav_bar_top"
        android:layout_width="match_parent"
        android:layout_height="@dimen/spacing_54">
        <ImageView
            android:id="@+id/button_back"
            android:padding="@dimen/spacer_10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_navigation_goback"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"/>
        <TextView
            android:gravity="center"
            android:id="@+id/header_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sample_text"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/music_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:layout_below="@+id/nav_bar_top">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacer_10">
            <androidx.recyclerview.widget.RecyclerView
                android:gravity="center"
                android:id="@+id/recycler_view_profile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="20dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/edit_profile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/manage_profile_button_text"
                android:drawablePadding="20dp"
                android:scaleX="0.6"
                android:scaleY="0.6"
                android:drawableStart="@drawable/ic_action_edit"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/profile_menu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="25dp"
        android:layout_marginRight="25dp"
        android:layout_below="@+id/music_container">
        <LinearLayout
            android:orientation="vertical"
            android:padding="@dimen/spacer_8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:gravity="center_vertical"
                android:id="@+id/car_mode_ingress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_car_mode_title"
                android:drawablePadding="20dp"
                android:drawableStart="@drawable/icon_car"/>
            <View
                android:background="@color/black_red_100"
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacer_1"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:padding="@dimen/spacer_8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:gravity="center_vertical"
                android:id="@+id/toggle_off"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_offline_mode_toggle_text"
                android:drawablePadding="20dp"
                android:drawableStart="@drawable/ic_action_toggleoff"/>
            <View
                android:background="@color/black_red_100"
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacer_1"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:padding="@dimen/spacer_8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:gravity="center_vertical"
                android:id="@+id/connect_device"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_connect_device"
                android:drawablePadding="20dp"
                android:drawableStart="@drawable/ic_casting_inactive"/>
            <View
                android:background="@color/black_red_100"
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacer_1"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:padding="@dimen/spacer_8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:gravity="center_vertical"
                android:id="@+id/my_profile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/my_profile"
                android:drawablePadding="20dp"
                android:drawableStart="@drawable/user_icon_profile"/>
            <View
                android:background="@color/black_red_100"
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacer_1"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:padding="@dimen/spacer_8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:gravity="center_vertical"
                android:id="@+id/settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/download_goto_music_settings"
                android:drawablePadding="20dp"
                android:drawableStart="@drawable/nav_settings"/>
            <View
                android:background="@color/black_red_100"
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacer_1"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:padding="@dimen/spacer_8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:gravity="center_vertical"
                android:id="@+id/store"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/account_and_subscription"
                android:drawablePadding="20dp"
                android:drawableStart="@drawable/account_subscription"/>
            <View
                android:background="@color/black_red_100"
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacer_1"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:padding="@dimen/spacer_8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:gravity="center_vertical"
                android:id="@+id/contact_customer_support"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_help_and_feedback_title"
                android:drawablePadding="20dp"
                android:drawableStart="@drawable/account_support_question_mark"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
