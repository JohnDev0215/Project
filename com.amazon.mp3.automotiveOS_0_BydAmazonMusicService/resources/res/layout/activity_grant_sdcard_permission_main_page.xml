<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/hint_main_page"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/hint_main_page_image_view"
            android:layout_width="@dimen/grant_sdcard_permission_pager_item_image_view_width"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/grant_sdcard_permission_main_page_image_margin_top"
            android:src="@drawable/hint_main"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textAppearance="@style/TextAppearance.Medium"
            android:textSize="@dimen/grant_sdcard_permission_main_page_title_text_size"
            android:textColor="@color/white"
            android:gravity="center_horizontal"
            android:id="@+id/hint_main_page_title"
            android:layout_width="@dimen/grant_sdcard_permission_main_page_title_width"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/grant_sdcard_permission_main_page_title_margin_top"
            android:text="@string/sdcard_storage_permission_activity_hint_main_page_title"
            android:layout_below="@+id/hint_main_page_image_view"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textAppearance="@style/TextAppearance.Medium"
            android:textSize="@dimen/grant_sdcard_permission_main_page_text_size"
            android:textColor="@color/white"
            android:gravity="center_horizontal"
            android:layout_width="@dimen/grant_sdcard_permission_main_page_text_width"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/grant_sdcard_permission_main_page_text_margin_top"
            android:text="@string/sdcard_storage_permission_activity_hint_main_page_content"
            android:layout_below="@+id/hint_main_page_title"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <Button
        android:textAppearance="@style/TextAppearance.Medium"
        android:textSize="@dimen/grant_sdcard_permission_main_page_button_text_size"
        android:textColor="@color/grant_sdcard_permission_button_blue"
        android:id="@+id/cancel_button"
        android:background="@color/transparent"
        android:layout_width="@dimen/grant_sdcard_permission_main_page_button_width"
        android:layout_height="@dimen/grant_sdcard_permission_main_page_button_height"
        android:layout_marginBottom="@dimen/grant_sdcard_permission_main_page_button_margin_bottom"
        android:text="@string/sdcard_storage_permission_activity_cancel"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/grant_sdcard_permission_main_page_button_margin_start"
        android:layout_alignParentStart="true"/>
    <Button
        android:textAppearance="@style/TextAppearance.Medium"
        android:textSize="@dimen/grant_sdcard_permission_main_page_button_text_size"
        android:textColor="@color/grant_sdcard_permission_button_blue"
        android:id="@+id/confirm_button"
        android:background="@color/transparent"
        android:layout_width="@dimen/grant_sdcard_permission_main_page_button_width"
        android:layout_height="@dimen/grant_sdcard_permission_main_page_button_height"
        android:layout_marginBottom="@dimen/grant_sdcard_permission_main_page_button_margin_bottom"
        android:text="@string/sdcard_storage_permission_activity_confirm"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="@dimen/grant_sdcard_permission_main_page_button_margin_end"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
