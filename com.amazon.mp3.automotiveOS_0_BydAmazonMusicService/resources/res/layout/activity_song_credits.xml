<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/song_credits_title_text_size"
        android:textColor="@color/grey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/song_credits_title_layout_margin"
        android:text="@string/song_credits"/>
    <TextView
        android:textSize="@dimen/songwriter_title_text_size"
        android:textColor="@color/dark_grey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/songwriter_title_margin_bottom"
        android:text="@string/songwriter_title"
        android:layout_marginStart="@dimen/songwriter_title_margin_left"
        android:layout_marginEnd="@dimen/songwriter_title_margin_right"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/songwriter_content_margin_left"
        android:layout_marginEnd="@dimen/songwriter_content_margin_right">
        <HorizontalScrollView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/songwriter_content_text_size"
                android:textColor="@color/white"
                android:id="@+id/songwriters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/songwriter_text_default"/>
        </HorizontalScrollView>
    </ScrollView>
</LinearLayout>
