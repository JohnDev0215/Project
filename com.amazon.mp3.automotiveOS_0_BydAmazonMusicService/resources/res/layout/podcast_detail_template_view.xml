<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/base"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/detail_template_view_v2_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:background="@drawable/color_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <ImageView
        android:background="@drawable/gradient1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <com.google.android.material.appbar.AppBarLayout
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar"
        android:id="@+id/app_bar_layout"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/main.collapsing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="enterAlwaysCollapsed|scroll"
            app:scrimAnimationDuration="0">
            <com.amazon.podcast.views.ActionBarView
                android:id="@+id/action_bar_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"/>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/details_page_view_v2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/app_bar_layout">
        <com.google.android.material.appbar.AppBarLayout
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar"
            android:id="@+id/main.appbar"
            android:background="@color/transparent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:elevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="?attr/actionBarSize"
                app:layout_scrollFlags="exitUntilCollapsed|scroll"
                app:scrimAnimationDuration="0">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.amazon.podcast.views.podcastDetailTemplate.HeaderView
                        android:id="@+id/detail_template_view_v2_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:layout_marginStart="@dimen/gutter_and_margin"
                        android:layout_marginEnd="@dimen/gutter_and_margin"/>
                    <RelativeLayout
                        android:id="@+id/featured_episode"
                        android:background="@drawable/primary_glass_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/detail_template_view_v2_header">
                        <com.amazon.podcast.views.EmberTextView
                            android:id="@+id/podcast_feature_single_row_item_label"
                            android:paddingTop="@dimen/podcast_spacer_small"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/gutter_and_margin"
                            android:layout_marginEnd="@dimen/gutter_and_margin"
                            style="@style/PodcastAppTheme.TextView.Headline4"/>
                        <com.amazon.podcast.views.episodeRowItemsListView.EpisodeRowItemView
                            android:id="@+id/podcast_featured_single_row_episode_item"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/podcast_feature_single_row_item_label"/>
                    </RelativeLayout>
                    <HorizontalScrollView
                        android:id="@+id/podcast_detail_template_v2_refinement_horizontal_scroll_view"
                        android:scrollbars="none"
                        android:clipToPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/podcast_spacer_base"
                        android:layout_marginBottom="@dimen/podcast_spacer_base"
                        android:layout_below="@+id/featured_episode"
                        android:layout_marginStart="@dimen/gutter_and_margin">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <com.amazon.podcast.views.refinements.RefinementBarItemView
                                android:id="@+id/podcast_detail_template_v2_refinement_sort"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                            <com.amazon.podcast.views.refinements.RefinementBarItemView
                                android:id="@+id/podcast_detail_template_v2_refinement_download"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                            <com.amazon.podcast.views.refinements.RefinementBarItemView
                                android:id="@+id/podcast_detail_template_v2_refinement_unplayed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                            <com.amazon.podcast.views.refinements.RefinementBarItemView
                                android:id="@+id/podcast_detail_template_v2_refinement_seasons"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </HorizontalScrollView>
                </RelativeLayout>
            </com.google.android.material.appbar.CollapsingToolbarLayout>
        </com.google.android.material.appbar.AppBarLayout>
        <com.amazon.podcast.views.episodeRowItemsListView.EpisodeRowItemsListView
            android:id="@+id/podcast_detail_template_v2_episode_row_items_list_view"
            android:background="@color/transparent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
        <com.amazon.podcast.views.RibbonNotificationView
            android:layout_gravity="bottom"
            android:id="@+id/podcast_detail_template_ribbon_notification_view"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:foregroundGravity="bottom"/>
        <com.amazon.podcast.views.EmberTextView
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/podcast_detail_template_v2_message_view"
            android:visibility="gone"
            android:layout_width="@dimen/podcast_dialog_width"
            android:layout_height="wrap_content"
            android:text="@string/podcast_sort_filter_empty_message"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"
            style="@style/PodcastAppTheme.TextView.Headline4"/>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <com.amazon.podcast.views.LoadingView
        android:id="@+id/podcast_detail_template_v2_loading_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
