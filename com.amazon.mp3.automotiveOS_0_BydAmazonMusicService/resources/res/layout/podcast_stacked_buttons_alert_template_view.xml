<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@color/secondary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/podcast_stacked_alert_view_root"
        android:layout_width="@dimen/podcast_dialog_width"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:paddingStart="@dimen/gutter"
        android:paddingEnd="@dimen/gutter">
        <ImageButton
            android:id="@+id/podcast_stacked_alert_view_close"
            android:background="@drawable/button_circle"
            android:layout_width="@dimen/podcast_spacer_epic"
            android:layout_height="@dimen/podcast_spacer_epic"
            android:src="@drawable/ic_podcast_action_cancel"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/podcast_stacked_alert_view_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            android:layout_below="@+id/podcast_stacked_alert_view_close"
            android:layout_centerHorizontal="true"/>
        <com.amazon.podcast.views.EmberTextView
            android:id="@+id/podcast_stacked_alert_view_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/podcast_stacked_alert_view_image"
            android:layout_centerHorizontal="true"
            style="@style/PodcastAppTheme.TextView.Headline4"/>
        <com.amazon.podcast.views.EmberTextView
            android:gravity="center"
            android:id="@+id/podcast_stacked_alert_view_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/podcast_spacer_base"
            android:layout_below="@+id/podcast_stacked_alert_view_title"
            android:layout_centerHorizontal="true"
            style="@style/PodcastAppTheme.TextView.Primary"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/podcast_spacer_small"
            android:layout_below="@+id/podcast_stacked_alert_view_subtitle">
            <com.amazon.podcast.views.EmberTextView
                android:gravity="center"
                android:id="@+id/podcast_stacked_alert_view_positive_button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/podcast_button_medium"
                android:layout_marginBottom="@dimen/podcast_spacer_small"
                android:layout_weight="1"
                style="@style/PodcastAppTheme.TextView.ButtonMediumSolid"/>
            <com.amazon.podcast.views.EmberTextView
                android:gravity="center"
                android:id="@+id/podcast_stacked_alert_view_negative_button"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="@dimen/podcast_button_medium"
                android:layout_marginBottom="@dimen/podcast_spacer_mini"
                android:layout_weight="1"
                style="@style/PodcastAppTheme.TextView.ButtonMediumGlass"/>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
