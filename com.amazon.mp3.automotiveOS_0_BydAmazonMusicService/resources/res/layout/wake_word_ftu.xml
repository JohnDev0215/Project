<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:background="@drawable/wake_word_ftu_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="@dimen/wake_word_splash_screen_title_text_size"
            android:textStyle="bold"
            android:id="@+id/title_tv"
            android:layout_marginBottom="@dimen/wake_word_splash_screen_margin_bottom"
            android:text="@string/wake_word_splash_title"
            style="@style/WakeWordFTUText"/>
        <TextView
            android:textSize="@dimen/wake_word_splash_screen_title_footer_text_size"
            android:id="@+id/title_footer_tv"
            android:layout_marginBottom="@dimen/wake_word_splash_screen_large_margin_bottom"
            android:text="@string/wake_word_splash_title_footer"
            style="@style/WakeWordFTUText"/>
        <TextView
            android:textSize="@dimen/wake_word_splash_screen_hints_title_text_size"
            android:textStyle="italic"
            android:id="@+id/hint_one_title_tv"
            android:layout_marginBottom="@dimen/wake_word_splash_screen_hints_margin_bottom"
            android:text="@string/wake_word_splash_hint_one_title"
            style="@style/WakeWordFTUText"/>
        <RelativeLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/wake_word_splash_screen_hints_margin_bottom">
            <include
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                layout="@layout/white_chat_bubble"/>
            <TextView
                android:textSize="@dimen/wake_word_splash_screen_hints_example_text_size"
                android:textStyle="italic"
                android:textColor="@color/wake_word_splash_screen_hints_example_text_color"
                android:id="@+id/hint_one_example_tv"
                android:padding="@dimen/wake_word_splash_screen_hints_example_padding"
                android:layout_width="@dimen/wake_word_splash_screen_hints_example_width"
                android:text="@string/wake_word_splash_hint_one_example"
                android:layout_centerInParent="true"
                style="@style/WakeWordFTUText"/>
        </RelativeLayout>
        <TextView
            android:textSize="@dimen/wake_word_splash_screen_hints_title_text_size"
            android:textStyle="italic"
            android:id="@+id/hint_two_tv"
            android:layout_marginBottom="@dimen/wake_word_splash_screen_hints_margin_bottom"
            android:text="@string/wake_word_splash_hint_two_title"
            style="@style/WakeWordFTUText"/>
        <RelativeLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/wake_word_splash_screen_large_margin_bottom">
            <include
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                layout="@layout/white_chat_bubble"/>
            <TextView
                android:textSize="@dimen/wake_word_splash_screen_hints_example_text_size"
                android:textStyle="italic"
                android:textColor="@color/wake_word_splash_screen_hints_example_text_color"
                android:id="@+id/hint_two_example_tv"
                android:padding="@dimen/wake_word_splash_screen_hints_example_padding"
                android:layout_width="@dimen/wake_word_splash_screen_hints_example_width"
                android:text="@string/wake_word_splash_hint_two_example"
                android:layout_centerInParent="true"
                style="@style/WakeWordFTUText"/>
        </RelativeLayout>
        <androidx.appcompat.widget.AppCompatButton
            android:textSize="@dimen/wake_word_splash_screen_button_text_size"
            android:textColor="@color/pure_white"
            android:layout_gravity="center"
            android:id="@+id/btn_wakeword_ftu_positive"
            android:background="@drawable/wake_word_positive_button_background"
            android:layout_width="@dimen/wake_word_splash_screen_width"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/wake_word_splash_screen_positive_button_margin_bottom"
            android:textAllCaps="false"
            android:textAlignment="gravity"/>
        <androidx.appcompat.widget.AppCompatButton
            android:textSize="@dimen/wake_word_splash_screen_button_text_size"
            android:textColor="@color/pure_white"
            android:id="@+id/btn_wakeword_ftu_negative"
            android:layout_width="@dimen/wake_word_splash_screen_width"
            android:layout_height="wrap_content"
            android:text="@string/wake_word_splash_negative_button_no_thanks"
            android:textAllCaps="false"
            android:backgroundTint="@color/wake_word_splash_screen_negative_button_background"
            app:backgroundTint="@color/wake_word_splash_screen_negative_button_background"
            style="?android:attr/borderlessButtonStyle"/>
    </LinearLayout>
</ScrollView>
