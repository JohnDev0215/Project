<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="start|center_vertical"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/star_one"
        android:layout_width="@dimen/spacer_12"
        android:layout_height="@dimen/spacer_12"
        android:layout_marginTop="@dimen/spacer_2"
        android:layout_marginBottom="@dimen/spacer_2"
        android:layout_marginEnd="@dimen/spacer_1"/>
    <ImageView
        android:id="@+id/star_two"
        android:layout_width="@dimen/spacer_12"
        android:layout_height="@dimen/spacer_12"
        android:layout_marginTop="@dimen/spacer_2"
        android:layout_marginBottom="@dimen/spacer_2"
        android:layout_marginStart="@dimen/spacer_1"
        android:layout_marginEnd="@dimen/spacer_1"/>
    <ImageView
        android:id="@+id/star_three"
        android:layout_width="@dimen/spacer_12"
        android:layout_height="@dimen/spacer_12"
        android:layout_marginTop="@dimen/spacer_2"
        android:layout_marginBottom="@dimen/spacer_2"
        android:layout_marginStart="@dimen/spacer_1"
        android:layout_marginEnd="@dimen/spacer_1"/>
    <ImageView
        android:id="@+id/star_four"
        android:layout_width="@dimen/spacer_12"
        android:layout_height="@dimen/spacer_12"
        android:layout_marginTop="@dimen/spacer_2"
        android:layout_marginBottom="@dimen/spacer_2"
        android:layout_marginStart="@dimen/spacer_1"
        android:layout_marginEnd="@dimen/spacer_1"/>
    <ImageView
        android:id="@+id/star_five"
        android:layout_width="@dimen/spacer_12"
        android:layout_height="@dimen/spacer_12"
        android:layout_marginTop="@dimen/spacer_2"
        android:layout_marginBottom="@dimen/spacer_2"
        android:layout_marginStart="@dimen/spacer_1"/>
    <TextView
        android:id="@+id/count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacer_2"
        android:layout_marginBottom="@dimen/spacer_2"
        android:layout_marginStart="@dimen/spacer_4"/>
</LinearLayout>
