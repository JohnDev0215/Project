<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/thumbnail_navigator"
    android:paddingTop="@dimen/podcast_spacer_large"
    android:paddingBottom="@dimen/podcast_spacer_large"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/thumbnail_navigator_header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/podcast_spacer_large"
        android:paddingStart="@dimen/margin"
        android:paddingEnd="@dimen/margin">
        <com.amazon.podcast.views.EmberTextView
            android:id="@+id/thumbnail_navigator_header_text_view"
            android:layout_marginStart="@dimen/gutter"
            android:layout_alignParentStart="true"
            style="@style/PodcastAppTheme.TextView.Headline4"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/thumbnail_navigator_recycler_view_container"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/thumbnail_navigator_header_layout">
        <androidx.recyclerview.widget.RecyclerView
            android:layout_gravity="center_horizontal"
            android:id="@+id/thumbnail_navigator_recycler_view"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/gutter"
            android:layout_marginEnd="@dimen/gutter"
            android:layout_alignParentStart="true"/>
    </RelativeLayout>
</RelativeLayout>
