<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/details_summary_part"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/podcast_detail_template_header_image"
        android:layout_width="@dimen/podcast_detail_template_header_image_dimension"
        android:layout_height="@dimen/podcast_detail_template_header_image_dimension"
        android:layout_centerHorizontal="true"/>
    <com.amazon.podcast.views.EmberTextView
        android:id="@+id/podcast_detail_template_header_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/podcast_spacer_small"
        android:layout_below="@+id/podcast_detail_template_header_image"
        android:layout_centerHorizontal="true"
        style="@style/PodcastAppTheme.TextView.Label"/>
    <com.amazon.podcast.views.EmberTextView
        android:textSize="@dimen/podcast_text_size_h3"
        android:gravity="center"
        android:id="@+id/podcast_detail_template_header_primary_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/podcast_spacer_micro"
        android:maxLines="3"
        android:layout_below="@+id/podcast_detail_template_header_label"
        android:layout_centerHorizontal="true"
        style="@style/PodcastAppTheme.TextView.PodcastEntityTitle"/>
    <com.amazon.podcast.views.EmberTextView
        android:id="@+id/podcast_detail_template_header_secondary_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/podcast_spacer_mini"
        android:maxLines="1"
        android:layout_below="@+id/podcast_detail_template_header_primary_text"
        android:layout_centerHorizontal="true"
        style="@style/PodcastAppTheme.TextView.Primary"/>
    <RelativeLayout
        android:id="@+id/podcast_serial_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/podcast_spacer_large"
        android:layout_marginBottom="@dimen/podcast_spacer_large"
        android:layout_below="@+id/podcast_detail_template_header_secondary_text"
        android:layout_centerHorizontal="true">
        <ImageButton
            android:id="@+id/podcast_more_information_button"
            android:background="@drawable/button_circle"
            android:visibility="gone"
            android:layout_width="@dimen/podcast_spacer_epic"
            android:layout_height="@dimen/podcast_spacer_epic"
            android:src="@drawable/ic_alerts_information"
            android:adjustViewBounds="true"/>
        <com.amazon.podcast.views.detailTemplate.FollowButton
            android:id="@+id/podcast_detail_template_header_follow_button"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/podcast_spacer_small"
            android:layout_marginRight="@dimen/podcast_spacer_small"
            android:layout_toEndOf="@+id/podcast_more_information_button"/>
        <ImageButton
            android:id="@+id/podcast_share_button"
            android:background="@drawable/button_circle"
            android:visibility="gone"
            android:layout_width="@dimen/podcast_spacer_epic"
            android:layout_height="@dimen/podcast_spacer_epic"
            android:src="@drawable/ic_share"
            android:adjustViewBounds="true"
            android:layout_toEndOf="@+id/podcast_detail_template_header_follow_button"/>
    </RelativeLayout>
    <com.amazon.podcast.views.EmberTextView
        android:id="@+id/podcast_detail_template_header_upsell_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/podcast_spacer_mini"
        android:layout_below="@+id/podcast_serial_actions"
        android:layout_centerHorizontal="true"
        style="@style/PodcastAppTheme.TextView.UpsellText"/>
    <com.amazon.podcast.views.LargeUpsellButton
        android:id="@+id/podcast_detail_template_header_upsell_button"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/podcast_spacer_medium"
        android:layout_marginRight="@dimen/podcast_spacer_medium"
        android:layout_marginBottom="@dimen/podcast_spacer_large"
        android:layout_below="@+id/podcast_detail_template_header_upsell_text"
        android:layout_marginHorizontal="@dimen/podcast_spacer_medium"/>
</RelativeLayout>
