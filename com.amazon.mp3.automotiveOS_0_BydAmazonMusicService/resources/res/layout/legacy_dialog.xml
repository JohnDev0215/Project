<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/backgroundView"
            android:background="@color/legacy_dialog_default_background_color"
            android:padding="@dimen/legacy_dialog_layout_padding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:weightSum="2">
            <TextView
                android:textSize="@dimen/legacy_dialog_headline_text_size"
                android:textStyle="bold"
                android:textColor="@color/pure_white"
                android:id="@+id/headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="@dimen/legacy_dialog_byline_text_size"
                android:textColor="@color/pure_white"
                android:textColorLink="@color/legacy_dialog_link_color"
                android:id="@+id/byline"
                android:paddingTop="@dimen/legacy_dialog_text_view_padding"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:layout_gravity="end"
                android:orientation="horizontal"
                android:id="@+id/buttonRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/legacy_dialog_view_margin">
                <Button
                    android:textColor="@color/black"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/secondaryButton"
                    android:paddingLeft="@dimen/legacy_dialog_button_padding"
                    android:paddingRight="@dimen/legacy_dialog_button_padding"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:maxHeight="@dimen/legacy_dialog_button_max_height"
                    android:minHeight="@dimen/legacy_dialog_button_min_height"
                    android:layout_weight="1"
                    android:textAllCaps="true"
                    android:layout_marginEnd="@dimen/legacy_dialog_button_padding"
                    style="@style/LegacyButtonBase"/>
                <Button
                    android:textColor="@color/white"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/primaryButton"
                    android:paddingLeft="@dimen/legacy_dialog_button_padding"
                    android:paddingRight="@dimen/legacy_dialog_button_padding"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:maxHeight="@dimen/legacy_dialog_button_max_height"
                    android:minHeight="@dimen/legacy_dialog_button_min_height"
                    android:layout_weight="1"
                    android:textAllCaps="true"
                    style="@style/LegacyButtonBase"/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/legacy_dialog_comfort_text_size"
                android:textColor="@color/pure_white"
                android:layout_gravity="end"
                android:id="@+id/comfortText"
                android:paddingBottom="@dimen/legacy_dialog_text_view_padding"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/legacy_dialog_comfort_text_margin"/>
            <View
                android:id="@+id/dividingLine"
                android:background="@color/legacy_dialog_dividing_line_color"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/legacy_dialog_dividing_line_width"/>
            <TextView
                android:textSize="@dimen/legacy_dialog_trailing_text_size"
                android:textColor="@color/pure_white"
                android:textColorLink="@color/legacy_dialog_link_color"
                android:id="@+id/trailingText"
                android:paddingTop="@dimen/legacy_dialog_view_margin"
                android:paddingBottom="@dimen/legacy_dialog_trailing_text_bottom_padding"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <include layout="@layout/blank_loading_spinner"/>
    </RelativeLayout>
</ScrollView>
