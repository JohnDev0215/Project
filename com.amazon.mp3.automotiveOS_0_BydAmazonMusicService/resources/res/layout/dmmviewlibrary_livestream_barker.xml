<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/livestream_barker"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.amazon.ui.foundations.views.BaseImage
        android:id="@+id/background_image"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/live_content"
        android:layout_width="match_parent"
        android:layout_height="@dimen/spacer_32"
        app:layout_constraintBottom_toBottomOf="@+id/background_image"
        app:layout_constraintLeft_toLeftOf="@+id/background_image">
        <com.amazon.music.views.library.views.TransparentGradientImageView
            android:id="@+id/transparent_gradient_image_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.amazon.ui.foundations.views.BaseButton
            android:id="@+id/barker_live_badge"
            android:paddingLeft="@dimen/spacer_8"
            android:paddingRight="@dimen/spacer_4"
            android:paddingBottom="@dimen/spacer_8"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/live_content"
            app:layout_constraintLeft_toLeftOf="@+id/live_content"/>
        <com.amazon.ui.foundations.views.BaseButton
            android:id="@+id/barker_viewer_count"
            android:paddingBottom="@dimen/spacer_8"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/live_content"
            app:layout_constraintLeft_toRightOf="@+id/barker_live_badge"/>
        <ImageView
            android:enabled="false"
            android:id="@+id/barker_source_logo"
            android:focusable="false"
            android:visibility="gone"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="fitStart"
            android:adjustViewBounds="true"
            app:layout_constraintBottom_toBottomOf="@+id/live_content"
            app:layout_constraintRight_toRightOf="@+id/live_content"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacer_12"
        app:layout_constraintTop_toBottomOf="@+id/background_image">
        <ImageView
            android:id="@+id/barker_artist_artwork"
            android:layout_width="@dimen/spacer_40"
            android:layout_height="@dimen/spacer_40"
            android:layout_marginRight="@dimen/spacer_12"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/primary_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacer_2"/>
            <TextView
                android:id="@+id/secondary_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacer_2"/>
            <TextView
                android:id="@+id/tertiary_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:id="@+id/disabled_mask"
        android:background="@color/black"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.6"/>
</androidx.constraintlayout.widget.ConstraintLayout>
