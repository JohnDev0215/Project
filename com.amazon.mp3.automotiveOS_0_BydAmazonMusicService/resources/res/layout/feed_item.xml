<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/feed_item"
    android:paddingLeft="@dimen/listview_row_padding_left"
    android:paddingTop="@dimen/listview_row_padding_top"
    android:paddingRight="@dimen/listview_row_padding_right"
    android:paddingBottom="@dimen/listview_row_padding_bottom"
    android:clickable="true"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/cardview_side_margin"
    android:layout_marginTop="@dimen/cardview_top_margin"
    android:layout_marginRight="@dimen/cardview_side_margin"
    android:layout_marginBottom="@dimen/cardview_bottom_margin"
    android:foreground="?attr/selectableItemBackground"
    android:baselineAligned="false"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="@dimen/cardview_corner_radius"
    app:cardElevation="1dp">
    <RelativeLayout
        android:id="@+id/feed_item"
        android:background="@color/transparent"
        android:paddingLeft="@dimen/cardview_content_padding"
        android:paddingTop="@dimen/cardview_content_padding"
        android:paddingRight="@dimen/cardview_content_padding"
        android:paddingBottom="@dimen/cardview_content_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/main_image"
            android:layout_width="@dimen/main_image_width"
            android:layout_height="@dimen/main_image_height"
            android:layout_marginRight="@dimen/cardview_content_padding"
            android:layout_centerVertical="true"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/cardview_content_padding"
            android:layout_toLeftOf="@+id/right_container"
            android:layout_toRightOf="@+id/main_image"
            android:layout_centerVertical="true">
            <TextView
                android:textSize="@dimen/feed_item_date_text_size"
                android:textColor="@color/bright_blue"
                android:id="@+id/time_ago"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_alignParentTop="true"
                android:textAllCaps="true"/>
            <TextView
                android:textSize="@dimen/feed_item_text_size"
                android:textColor="@color/white"
                android:id="@+id/tag"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="@dimen/feed_item_text_size"
                android:textColor="@color/grey"
                android:ellipsize="end"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:singleLine="false"
                android:layout_centerVertical="true"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/right_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true">
            <ImageView
                android:id="@+id/action_icon"
                android:background="@android:color/transparent"
                android:paddingRight="@dimen/standard_padding"
                android:layout_width="@dimen/action_icon_width"
                android:layout_height="@dimen/action_icon_height"
                android:src="@drawable/right_arrow_1"
                android:layout_centerVertical="true"/>
        </FrameLayout>
    </RelativeLayout>
</androidx.cardview.widget.CardView>
