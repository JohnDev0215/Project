<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/merch_slot"
    android:clickable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/background_images"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.amazon.music.views.library.views.TransparentGradientImageView
            android:id="@+id/background_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/artistImageContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.amazon.music.views.library.views.TransparentGradientImageView
                android:id="@+id/tv_background_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <com.amazon.music.views.library.views.TransparentGradientImageView
                android:id="@+id/hero_image_background"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <com.amazon.music.views.library.views.TransparentGradientImageView
                android:id="@+id/hero_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.amazon.music.views.library.views.TransparentGradientImageView
            android:id="@+id/tv_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/text_elements"
        android:paddingBottom="@dimen/feature_play_text_elements_padding_bottom"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/feature_play_text_elements_margin_start"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:ellipsize="end"
            android:id="@+id/label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="@integer/feature_play_label_max_lines"/>
        <TextView
            android:ellipsize="end"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="@integer/feature_play_title_max_lines"/>
        <TextView
            android:ellipsize="end"
            android:id="@+id/primary_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/feature_play_text_elements_primary_text_margin_top"
            android:maxLines="@integer/feature_play_primary_text_max_lines"/>
        <TextView
            android:ellipsize="end"
            android:id="@+id/secondary_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacer_8"
            android:maxLines="@integer/feature_play_secondary_text_max_lines"/>
        <TextView
            android:ellipsize="end"
            android:id="@+id/tertiary_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/small_spacing"
            android:maxLines="@integer/feature_play_tertiary_text_max_lines"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/buttons"
        android:paddingBottom="@dimen/feature_play_text_elements_padding_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <LinearLayout
            android:layout_gravity="end|bottom"
            android:id="@+id/play_equalizer"
            android:background="@drawable/dmmviewlibrary_equalizer_container_circle"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.amazon.music.views.library.views.PlayNotificationIcon
                android:layout_gravity="center"
                android:id="@+id/PlaystateIcon"
                android:visibility="visible"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tint="@android:color/black"
                android:layout_marginStart="@dimen/spacer_12"/>
            <TextView
                android:textSize="@dimen/text_size_15"
                android:layout_gravity="center_vertical"
                android:id="@+id/internal_storage_state"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/spacer_12"
                android:layout_marginRight="@dimen/spacer_12"/>
        </LinearLayout>
        <com.amazon.ui.foundations.views.BaseButton
            android:id="@+id/PlayIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
