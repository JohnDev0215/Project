<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_menu_drawer"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/dynamicBackgroundImage"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <RelativeLayout
        android:id="@+id/casting_header_container"
        android:background="@drawable/casting_toolbar_header_background"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="@dimen/casting_toolbar_header_height"
        android:layout_alignParentTop="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/casting_header_textview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/casting_toolbar_header_side_margin"
            android:layout_marginRight="@dimen/casting_toolbar_header_side_margin"
            android:maxLines="1"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            style="@style/AmazonMusic.Casting.TitleText"/>
    </RelativeLayout>
    <com.waze.sdk.WazeNavigationBar
        android:id="@+id/wazeNavBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        style="@style/WazeNavBarBlack"/>
    <FrameLayout
        android:orientation="vertical"
        android:id="@+id/music_screen_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_bar_and_mini_player_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/wazeNavBar"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/bottom_bar_and_mini_player_container"
        android:background="@drawable/bottom_nav_background"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/bottom_bar_horizontal_margin"
        android:layout_marginRight="@dimen/bottom_bar_horizontal_margin"
        android:layout_marginBottom="@dimen/bottom_bar_bottom_margin"
        android:elevation="@dimen/bottom_bar_elevation"
        app:layout_constraintBottom_toTopOf="@+id/persistent_banner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ProgressBar
            android:id="@+id/miniplayer_progress_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/miniplayer_progress_bar_height"
            style="?android:attr/progressBarStyleHorizontal"/>
        <FrameLayout
            android:id="@+id/mini_player_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.amazon.mp3.view.TooltipView
                android:layout_gravity="end"
                android:id="@+id/TooltipDisplayerContainer"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacer_2"/>
        </FrameLayout>
        <RelativeLayout
            android:id="@+id/podcast_mini_player_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <View
        android:id="@+id/bottom_bar_nav_top_mask"
        android:background="@drawable/bottom_nav_top_mask_gradient"
        android:layout_width="0dp"
        android:layout_height="@dimen/bottom_bar_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/bottom_bar_and_mini_player_container"/>
    <View
        android:id="@+id/bottom_bar_bottom_mask"
        android:background="@drawable/bottom_nav_background_gradient"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/persistent_banner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bottom_bar_nav_top_mask"/>
    <com.amazon.music.views.library.views.PersistentBannerView
        android:id="@+id/persistent_banner"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:paddingLeft="@dimen/spacing_0dp"
        android:paddingRight="@dimen/spacing_0dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/action_bar_height"
        android:layout_alignParentTop="true"
        android:paddingStart="@dimen/spacing_0dp"
        android:paddingEnd="@dimen/spacing_0dp"
        android:contentInsetStart="@dimen/spacing_0dp"
        android:contentInsetLeft="@dimen/spacing_0dp"
        app:contentInsetLeft="@dimen/spacing_0dp"
        app:contentInsetStart="@dimen/spacing_0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/casting_header_container"
        app:popupTheme="@style/Theme.AmazonMP3.ActionBar.OverflowMenu"
        app:theme="@style/Theme.AmazonMP3.ActionBar"/>
    <include
        android:id="@+id/dynmsg_feature_banner_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/bottom_bar_and_mini_player_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        layout="@layout/bauhaus_ribbon"/>
    <include
        android:id="@+id/loading_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/blank_loading_activity"/>
    <include
        android:id="@+id/car_mode_fab_container"
        android:visibility="gone"
        layout="@layout/car_mode_floating_action_button"/>
    <include
        android:id="@+id/in_app_survey_fab_container"
        android:visibility="visible"
        layout="@layout/in_app_survey_floating_action_button"/>
</androidx.constraintlayout.widget.ConstraintLayout>
