<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ba_backgroundView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.amazon.ui.foundations.views.BaseButton
            android:layout_gravity="center"
            android:id="@+id/ba_closeButton"
            android:layout_width="@dimen/dialog_button_layout_height"
            android:layout_height="@dimen/dialog_button_layout_height"
            android:layout_marginLeft="@dimen/bauhaus_spacer_base"
            android:layout_marginRight="@dimen/bauhaus_spacer_base"
            android:src="@drawable/ic_dialog_close_dark"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toTopOf="@+id/ba_headline"
            app:layout_constraintRight_toRightOf="parent"/>
        <TextView
            android:gravity="center"
            android:id="@+id/ba_headline"
            android:paddingTop="@dimen/bauhaus_spacer_base"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/bauhaus_spacer_base"
            android:layout_marginRight="@dimen/bauhaus_spacer_base"
            android:textAlignment="center"
            app:layout_constraintBottom_toTopOf="@+id/ba_body"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/ba_body"
            android:paddingTop="@dimen/bauhaus_spacer_base"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/bauhaus_spacer_base"
            android:layout_marginRight="@dimen/bauhaus_spacer_base"
            android:textAlignment="center"
            app:layout_constraintBottom_toTopOf="@+id/view"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ba_headline"/>
        <View
            android:id="@+id/view"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bauhaus_spacer_small"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ba_body"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:id="@+id/buttonRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/bauhaus_spacer_base"
            android:layout_marginRight="@dimen/bauhaus_spacer_base"
            app:layout_constraintTop_toBottomOf="@+id/view">
            <com.amazon.ui.foundations.views.BaseButton
                android:id="@+id/ba_primaryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintLeft_toLeftOf="@+id/buttonRow"
                app:layout_constraintRight_toRightOf="@+id/buttonRow"
                app:layout_constraintTop_toTopOf="@+id/buttonRow"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
