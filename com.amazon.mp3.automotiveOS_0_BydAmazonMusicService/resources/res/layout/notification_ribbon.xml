<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/blue_notification"
    android:layout_width="match_parent"
    android:layout_height="@dimen/ribbon_height">
    <TextView
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/ribbon_header"
        android:paddingLeft="@dimen/ribbon_space_between_elements"
        android:paddingRight="@dimen/ribbon_space_between_elements"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:maxLines="2"
        android:layout_toLeftOf="@+id/ribbon_action_2"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"/>
    <ImageView
        android:id="@+id/ribbon_action_2"
        android:layout_width="@dimen/ribbon_button_size"
        android:layout_height="@dimen/ribbon_button_size"
        android:src="@drawable/ic_clear_white_24dp"
        android:scaleType="center"
        android:layout_toLeftOf="@+id/ribbon_separator"
        android:layout_centerVertical="true"
        android:layout_alignWithParentIfMissing="true"/>
    <ImageView
        android:id="@+id/ribbon_separator"
        android:visibility="gone"
        android:layout_width="@dimen/ribbon_separator_width"
        android:layout_height="@dimen/ribbon_separator_height"
        android:layout_toLeftOf="@+id/ribbon_action_1"
        android:layout_centerVertical="true"/>
    <ImageView
        android:id="@+id/ribbon_action_1"
        android:visibility="gone"
        android:layout_width="@dimen/ribbon_button_size"
        android:layout_height="@dimen/ribbon_button_size"
        android:src="@drawable/ic_arrow_forward_white_24dp"
        android:scaleType="center"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
</RelativeLayout>
