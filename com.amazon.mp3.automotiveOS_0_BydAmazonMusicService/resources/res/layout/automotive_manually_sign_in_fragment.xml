<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/left_base_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.13"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/right_base_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.91"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/top_base_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.09"/>
    <TextView
        android:textSize="@dimen/spacer_40"
        android:id="@+id/sign_in_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dmusic_automotive_sign_in_title"
        android:fontFamily="@font/amazon_ember_display_cd_heavy"
        app:layout_constraintBottom_toTopOf="@+id/top_base_line"
        app:layout_constraintStart_toStartOf="@+id/left_base_line"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5"/>
    <ImageView
        android:id="@+id/automotive_sign_in_icon"
        android:layout_width="@dimen/automotive_music_icon_size"
        android:layout_height="@dimen/automotive_music_icon_size"
        app:layout_constraintBottom_toBottomOf="@+id/sign_in_title"
        app:layout_constraintEnd_toStartOf="@+id/left_base_line"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/sign_in_title"
        app:srcCompat="@drawable/automotive_sign_in_icon"/>
    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="@dimen/spacing_0dp"
        android:layout_height="@dimen/spacing_0dp"
        android:layout_marginBottom="@dimen/spacer_10"
        android:fillViewport="true"
        android:isScrollContainer="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/left_base_line"
        app:layout_constraintRight_toRightOf="@+id/right_base_line"
        app:layout_constraintTop_toTopOf="@+id/top_base_line">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraint_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/right_guideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="0.54"/>
            <RelativeLayout
                android:id="@+id/password_back_button"
                android:background="@drawable/gray_circle"
                android:layout_width="@dimen/spacer_40"
                android:layout_height="@dimen/spacer_40"
                android:layout_marginTop="@dimen/spacer_48"
                android:layout_centerHorizontal="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@+id/action_goback_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_action_goback"
                    android:scaleType="center"
                    android:layout_centerInParent="true"/>
            </RelativeLayout>
            <TextView
                android:textSize="@dimen/text_size_18"
                android:id="@+id/sign_in_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacer_36"
                android:text="@string/dmusic_automotive_music_sign_in"
                android:fontFamily="@font/amazon_ember_bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/password_back_button"/>
            <EditText
                android:textSize="@dimen/automotive_input_text_size"
                android:textColor="@color/white"
                android:id="@+id/username_input_box"
                android:background="@drawable/input_box_border"
                android:paddingLeft="@dimen/spacing_20"
                android:paddingTop="@dimen/spacer_10"
                android:paddingRight="@dimen/spacing_20"
                android:paddingBottom="@dimen/spacer_10"
                android:layout_width="@dimen/spacing_0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_14dp"
                android:hint="@string/dmusic_automotive_sign_in_username_hint"
                android:inputType="textEmailAddress"
                android:fontFamily="@font/amazon_ember"
                android:paddingHorizontal="@dimen/spacing_20"
                android:paddingVertical="@dimen/spacer_10"
                app:layout_constraintEnd_toStartOf="@+id/right_guideline"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sign_in_label"/>
            <EditText
                android:textSize="@dimen/automotive_input_text_size"
                android:textColor="@color/white"
                android:id="@+id/password_input_box"
                android:background="@drawable/input_box_border"
                android:paddingLeft="@dimen/spacing_20"
                android:paddingTop="@dimen/spacer_10"
                android:paddingRight="@dimen/spacing_20"
                android:paddingBottom="@dimen/spacer_10"
                android:layout_width="@dimen/spacing_0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacer_28"
                android:hint="@string/dmusic_automotive_sign_in_password_hint"
                android:inputType="textPassword"
                android:fontFamily="@font/amazon_ember"
                android:paddingHorizontal="@dimen/spacing_20"
                android:paddingVertical="@dimen/spacer_10"
                app:layout_constraintEnd_toStartOf="@+id/right_guideline"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/username_input_box"/>
            <com.amazon.ui.foundations.views.BaseButton
                android:id="@+id/sign_in_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_30dp"
                app:layout_constraintEnd_toStartOf="@+id/right_guideline"
                app:layout_constraintTop_toBottomOf="@+id/password_input_box"/>
            <include
                android:id="@+id/automotive_legal_statement"
                android:layout_width="@dimen/spacing_0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_50"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                layout="@layout/automotive_legal_statement"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
