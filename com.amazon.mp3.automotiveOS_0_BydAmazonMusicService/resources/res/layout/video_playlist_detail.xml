<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/loading_indicator"
        android:visibility="gone"
        layout="@layout/blank_loading_activity"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.amazon.music.views.library.views.FixedAspectImageView
                android:id="@+id/video_playlist_artwork"
                android:layout_width="match_parent"
                android:layout_height="300dp"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/playback_buttons_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_padding"
                android:layout_marginBottom="@dimen/margin_padding"
                android:layout_below="@+id/video_playlist_artwork">
                <ImageView
                    android:id="@+id/play_pause_button"
                    android:background="@drawable/ripple_background_no_mask"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_play_all"
                    android:contentDescription="@string/play_all_content_description"
                    style="@style/PlayerControlsButtonStyle"/>
                <ImageView
                    android:id="@+id/shuffle_button"
                    android:background="@drawable/ripple_background_no_mask"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_shuffle_all"
                    android:contentDescription="@string/turn_on_shuffle_content_description"
                    android:layout_marginStart="@dimen/player_controls_horizontal_spacing"
                    style="@style/PlayerControlsButtonStyle"/>
            </LinearLayout>
            <TextView
                android:gravity="center"
                android:id="@+id/playlist_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/playback_buttons_container"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/playlist_tracks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/playlist_description"/>
        </RelativeLayout>
    </androidx.core.widget.NestedScrollView>
</RelativeLayout>
