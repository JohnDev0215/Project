<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/start_guideline"
        android:layout_width="@dimen/spacer_1"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.2"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/end_guideline"
        android:layout_width="@dimen/spacer_1"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.8"/>
    <ImageView
        android:id="@+id/item_icon"
        android:layout_width="@dimen/spacer_36"
        android:layout_height="@dimen/spacer_36"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/start_guideline"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/automotive_input_text_size"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/item_content"
        android:layout_width="@dimen/spacing_0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:fontFamily="@font/amazon_ember"
        android:layout_marginStart="@dimen/spacer_36"
        android:layout_marginEnd="@dimen/spacer_36"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/item_icon"
        app:layout_constraintRight_toLeftOf="@+id/item_set_toggle"
        app:layout_constraintStart_toEndOf="@+id/item_icon"
        app:layout_constraintTop_toTopOf="parent"/>
    <ToggleButton
        android:id="@+id/item_set_toggle"
        android:background="@drawable/ic_toggle_selector"
        android:layout_width="@dimen/spacer_48"
        android:layout_height="@dimen/spacer_48"
        android:textOn="@null"
        android:textOff="@null"
        android:layout_marginStart="@dimen/spacer_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/end_guideline"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
