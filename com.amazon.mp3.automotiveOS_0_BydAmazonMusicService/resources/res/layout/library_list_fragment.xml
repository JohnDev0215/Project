<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/background_gradient"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/feature_banner">
        <ViewStub
            android:id="@+id/HeaderViewStub"
            android:inflatedId="@+id/HeaderViewStub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.amazon.mp3.view.DragDropListView
            android:id="@+id/ListView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:headerDividersEnabled="false"
            style="@style/ListView"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/EmptyView"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/xlarge_padding"
                android:src="@drawable/empty_playlist_placeholder"/>
            <TextView
                android:gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dmusic_playlist_empty"/>
        </LinearLayout>
    </LinearLayout>
    <include
        android:layout_width="match_parent"
        android:layout_height="@dimen/libary_loading_footer_height"
        android:layout_above="@+id/feature_banner"
        android:layout_alignParentBottom="true"
        layout="@layout/library_listview_loading_footer"/>
    <include
        android:id="@+id/feature_banner"
        android:layout_width="match_parent"
        android:layout_height="@dimen/browse_banner_height"
        android:layout_alignParentBottom="true"
        layout="@layout/feature_banner"/>
    <com.amazon.mp3.view.BauhausRibbon
        android:id="@+id/bauhaus_ribbon"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/bauhaus_spacer_small"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/bauhaus_spacer_mini"
        android:layout_marginEnd="@dimen/bauhaus_spacer_mini"/>
</RelativeLayout>
