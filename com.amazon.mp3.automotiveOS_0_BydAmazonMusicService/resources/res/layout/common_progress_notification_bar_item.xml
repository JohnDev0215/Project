<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center_vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:gravity="center"
        android:id="@+id/notification_bar_icon"
        android:layout_width="@dimen/notification_icon_width"
        android:layout_height="match_parent"
        android:src="@drawable/ic_notification_tray_loading"
        android:scaleType="center"
        android:layout_alignParentLeft="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toRightOf="@+id/notification_bar_icon">
        <TextView
            android:ellipsize="marquee"
            android:id="@+id/notification_bar_title"
            android:fadingEdge="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            style="@style/NotificationTitle"/>
        <ProgressBar
            android:id="@+id/notification_progress_bar"
            android:paddingRight="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:indeterminate="false"
            style="?android:attr/progressBarStyleHorizontal"/>
        <TextView
            android:ellipsize="marquee"
            android:id="@+id/notification_progress_text"
            android:fadingEdge="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            style="@style/NotificationText"/>
    </LinearLayout>
</RelativeLayout>
