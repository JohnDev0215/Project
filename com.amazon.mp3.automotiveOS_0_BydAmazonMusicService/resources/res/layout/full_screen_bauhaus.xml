<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/backgroundView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.amazon.ui.foundations.views.BaseButton
            android:layout_gravity="center"
            android:id="@+id/closeButton"
            android:layout_width="@dimen/dialog_button_layout_height"
            android:layout_height="@dimen/dialog_button_layout_height"
            android:src="@drawable/ic_dialog_close_dark"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toTopOf="@+id/musicLogo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/musicLogo"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/musicLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/music_unlimited_logo_white"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toTopOf="@+id/headline"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/headline"
            android:paddingTop="@dimen/dialog_textview_padding"
            android:paddingBottom="@dimen/dialog_textview_padding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:layout_marginStart="@dimen/dialog_bottom_margin"
            android:layout_marginEnd="@dimen/dialog_bottom_margin"
            app:layout_constraintBottom_toTopOf="@+id/byline"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/musicLogo"/>
        <TextView
            android:gravity="center"
            android:id="@+id/byline"
            android:paddingBottom="@dimen/dialog_textview_padding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:layout_marginStart="@dimen/dialog_byline_margin"
            android:layout_marginEnd="@dimen/dialog_byline_margin"
            app:layout_constraintBottom_toTopOf="@+id/comfortText"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/headline"/>
        <TextView
            android:gravity="center"
            android:id="@+id/comfortText"
            android:paddingBottom="@dimen/dialog_comfort_text_margin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            app:layout_constraintBottom_toTopOf="@+id/primaryButtonWrapper"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/byline"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/primaryButtonWrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dialog_bottom_margin"
            android:layout_marginEnd="@dimen/dialog_bottom_margin"
            app:layout_constraintBottom_toTopOf="@+id/secondaryButtonWrapper"
            app:layout_constraintTop_toBottomOf="@+id/comfortText">
            <com.amazon.ui.foundations.views.BaseButton
                android:id="@+id/primaryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dialog_bottom_margin"
                android:layout_marginEnd="@dimen/dialog_bottom_margin"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:gravity="center"
            android:id="@+id/secondaryButtonWrapper"
            android:paddingTop="@dimen/bauhaus_spacer_small"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/dialog_bottom_margin"
            android:paddingEnd="@dimen/dialog_bottom_margin"
            app:layout_constraintBottom_toTopOf="@+id/trialingText"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/primaryButtonWrapper">
            <ImageView
                android:id="@+id/secondaryButtonStationOutline"
                android:visibility="gone"
                android:layout_width="@dimen/bauhaus_spacer_huge"
                android:layout_height="@dimen/bauhaus_spacer_huge"
                android:src="@drawable/station_outline"
                android:scaleType="center"
                android:adjustViewBounds="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/secondaryButton"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.amazon.music.inappmessaging.ui.widget.WrapWidthCenteredTextView
                android:textColor="#ffffff"
                android:gravity="center_horizontal"
                android:id="@+id/secondaryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:id="@+id/trialingText"
            android:paddingTop="@dimen/dialog_textview_padding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dialog_bottom_margin"
            android:layout_marginEnd="@dimen/dialog_bottom_margin"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/secondaryButtonWrapper"/>
        <include layout="@layout/blank_loading_spinner"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
