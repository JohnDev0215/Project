<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:background="#000000"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:alpha="@dimen/diagnostics_background_alpha"
            app:layout_constraintBottom_toBottomOf="@+id/horizontalMidpointGuideline"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="1"/>
        <ScrollView
            android:id="@+id/diagnosticsScrollView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="8dp"
            android:layout_marginHorizontal="8dp"
            android:layout_marginVertical="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/horizontalMidpointGuideline"
            app:layout_constraintEnd_toStartOf="@+id/diagnosticsScrollUpButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"
                android:layout_marginHorizontal="8dp">
                <TextView
                    android:textSize="@dimen/diagnostics_text_size"
                    android:id="@+id/deliveryProtocolDiagnosticTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/diagnostics_scrollview_vertical_margin"
                    android:layout_marginBottom="@dimen/diagnostics_scrollview_vertical_margin"
                    android:layout_marginVertical="@dimen/diagnostics_scrollview_vertical_margin"/>
                <TextView
                    android:textSize="@dimen/diagnostics_text_size"
                    android:id="@+id/videoStreamDiagnosticTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/diagnostics_scrollview_vertical_margin"
                    android:layout_marginBottom="@dimen/diagnostics_scrollview_vertical_margin"
                    android:layout_marginVertical="@dimen/diagnostics_scrollview_vertical_margin"/>
                <TextView
                    android:textSize="@dimen/diagnostics_text_size"
                    android:id="@+id/audioStreamDiagnosticTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/diagnostics_scrollview_vertical_margin"
                    android:layout_marginBottom="@dimen/diagnostics_scrollview_vertical_margin"
                    android:layout_marginVertical="@dimen/diagnostics_scrollview_vertical_margin"/>
                <TextView
                    android:textSize="@dimen/diagnostics_text_size"
                    android:id="@+id/bufferingCountDiagnosticTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/diagnostics_scrollview_vertical_margin"
                    android:layout_marginBottom="@dimen/diagnostics_scrollview_vertical_margin"
                    android:layout_marginVertical="@dimen/diagnostics_scrollview_vertical_margin"/>
                <TextView
                    android:textSize="@dimen/diagnostics_text_size"
                    android:id="@+id/javaHeapStatsDiagnosticTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/diagnostics_scrollview_vertical_margin"
                    android:layout_marginBottom="@dimen/diagnostics_scrollview_vertical_margin"
                    android:layout_marginVertical="@dimen/diagnostics_scrollview_vertical_margin"/>
                <TextView
                    android:textSize="@dimen/diagnostics_text_size"
                    android:id="@+id/nativeHeapStatsDiagnosticTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/diagnostics_scrollview_vertical_margin"
                    android:layout_marginBottom="@dimen/diagnostics_scrollview_vertical_margin"
                    android:layout_marginVertical="@dimen/diagnostics_scrollview_vertical_margin"/>
                <TextView
                    android:textSize="@dimen/diagnostics_text_size"
                    android:id="@+id/droppedFramesDiagnosticTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/diagnostics_scrollview_vertical_margin"
                    android:layout_marginBottom="@dimen/diagnostics_scrollview_vertical_margin"
                    android:layout_marginVertical="@dimen/diagnostics_scrollview_vertical_margin"/>
                <TextView
                    android:textSize="@dimen/diagnostics_text_size"
                    android:id="@+id/rendererDrmSchemeDiagnosticTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/diagnostics_scrollview_vertical_margin"
                    android:layout_marginBottom="@dimen/diagnostics_scrollview_vertical_margin"
                    android:layout_marginVertical="@dimen/diagnostics_scrollview_vertical_margin"/>
                <TextView
                    android:textSize="@dimen/diagnostics_text_size"
                    android:id="@+id/deviceProfileNameDiagnosticTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/diagnostics_scrollview_vertical_margin"
                    android:layout_marginBottom="@dimen/diagnostics_scrollview_vertical_margin"
                    android:layout_marginVertical="@dimen/diagnostics_scrollview_vertical_margin"/>
                <TextView
                    android:textSize="@dimen/diagnostics_text_size"
                    android:id="@+id/deviceModelNameDiagnosticTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/diagnostics_scrollview_vertical_margin"
                    android:layout_marginBottom="@dimen/diagnostics_scrollview_vertical_margin"
                    android:layout_marginVertical="@dimen/diagnostics_scrollview_vertical_margin"/>
                <TextView
                    android:textSize="@dimen/diagnostics_text_size"
                    android:id="@+id/sessionTypeDiagnosticTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/diagnostics_scrollview_vertical_margin"
                    android:layout_marginBottom="@dimen/diagnostics_scrollview_vertical_margin"
                    android:layout_marginVertical="@dimen/diagnostics_scrollview_vertical_margin"/>
                <TextView
                    android:textSize="@dimen/diagnostics_text_size"
                    android:id="@+id/cdnInfoDiagnosticTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/diagnostics_scrollview_vertical_margin"
                    android:layout_marginBottom="@dimen/diagnostics_scrollview_vertical_margin"
                    android:layout_marginVertical="@dimen/diagnostics_scrollview_vertical_margin"/>
                <TextView
                    android:textSize="@dimen/diagnostics_text_size"
                    android:id="@+id/contentTypeDiagnosticTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/diagnostics_scrollview_vertical_margin"
                    android:layout_marginBottom="@dimen/diagnostics_scrollview_vertical_margin"
                    android:layout_marginVertical="@dimen/diagnostics_scrollview_vertical_margin"/>
                <TextView
                    android:textSize="@dimen/diagnostics_text_size"
                    android:id="@+id/heuristicInfoDiagnosticTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/diagnostics_scrollview_vertical_margin"
                    android:layout_marginBottom="@dimen/diagnostics_scrollview_vertical_margin"
                    android:layout_marginVertical="@dimen/diagnostics_scrollview_vertical_margin"/>
                <TextView
                    android:textSize="@dimen/diagnostics_text_size"
                    android:id="@+id/manifestUrlDiagnosticTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/diagnostics_scrollview_vertical_margin"
                    android:layout_marginBottom="@dimen/diagnostics_scrollview_vertical_margin"
                    android:layout_marginVertical="@dimen/diagnostics_scrollview_vertical_margin"/>
            </LinearLayout>
        </ScrollView>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/horizontalMidpointGuideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.5"/>
        <ImageButton
            android:id="@+id/diagnosticsScrollUpButton"
            android:background="@null"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/diagnostics_button_margin"
            android:layout_marginRight="@dimen/diagnostics_button_margin"
            android:layout_marginBottom="@dimen/diagnostics_button_margin"
            android:src="@drawable/diagnostics_arrow_up"
            android:minWidth="@dimen/min_diagnostics_button_width"
            android:minHeight="@dimen/min_diagnostics_button_height"
            android:contentDescription="@string/scroll_up_diagnostics_button"
            android:alpha="@dimen/diagnostics_button_alpha"
            android:layout_marginHorizontal="@dimen/diagnostics_button_margin"
            app:layout_constraintBottom_toTopOf="@+id/diagnosticScrollDownButton"
            app:layout_constraintEnd_toStartOf="@+id/diagnosticsDLogButton"
            app:layout_constraintStart_toEndOf="@+id/diagnosticsScrollView"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <ImageButton
            android:id="@+id/diagnosticScrollDownButton"
            android:background="@null"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/diagnostics_button_margin"
            android:src="@drawable/diagnostics_arrow_down"
            android:minWidth="@dimen/min_diagnostics_button_width"
            android:minHeight="@dimen/min_diagnostics_button_height"
            android:contentDescription="@string/scroll_down_diagnostics_button"
            android:alpha="@dimen/diagnostics_button_alpha"
            android:layout_marginEnd="@dimen/diagnostics_button_margin"
            app:layout_constraintBottom_toTopOf="@+id/horizontalMidpointGuideline"
            app:layout_constraintEnd_toStartOf="@+id/diagnosticsCopyButton"
            app:layout_constraintStart_toEndOf="@+id/diagnosticsScrollView"
            app:layout_constraintStart_toStartOf="@+id/diagnosticsScrollUpButton"
            app:layout_constraintTop_toBottomOf="@+id/diagnosticsScrollUpButton"
            app:layout_constraintVertical_chainStyle="packed"/>
        <Button
            android:id="@+id/diagnosticsDLogButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/diagnostics_d_log_button_text"
            android:radius="@dimen/diagnostics_button_radius"
            android:alpha="@dimen/diagnostics_button_alpha"
            android:layout_marginEnd="@dimen/diagnostics_button_margin"
            app:layout_constraintBottom_toBottomOf="@+id/diagnosticsScrollUpButton"
            app:layout_constraintEnd_toEndOf="parent"
            style="@style/Widget.AppCompat.Button.Colored"/>
        <Button
            android:id="@+id/diagnosticsCopyButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/diagnostics_copy_button_text"
            android:radius="@dimen/diagnostics_button_radius"
            android:alpha="@dimen/diagnostics_button_alpha"
            android:layout_marginEnd="@dimen/diagnostics_button_margin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/diagnosticScrollDownButton"
            style="@style/Widget.AppCompat.Button.Colored"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
