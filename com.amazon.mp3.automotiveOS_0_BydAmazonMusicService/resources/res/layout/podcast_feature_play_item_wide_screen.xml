<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/feature_play"
    android:background="@color/transparent"
    android:clickable="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/background_gradient_image_view"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/foreground_gradient_image_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            android:layout_weight="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </LinearLayout>
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:src="@drawable/feature_play_secondary_glass_gradient"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageButton
        android:id="@+id/PlayButton"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/text_views_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/podcast_feature_play_label_margin_top_wide_screen"
        android:layout_marginStart="@dimen/podcast_spacer_giant"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent="0.6">
        <LinearLayout
            android:id="@+id/label_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/podcast_spacer_micro"
            app:layout_constraintBottom_toTopOf="@+id/title_layout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.amazon.podcast.views.EmberTextView
                android:textSize="@dimen/podcast_text_size_t4"
                android:ellipsize="end"
                android:id="@+id/label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_weight="2"
                style="@style/PodcastAppTheme.TextView.Label"/>
        </LinearLayout>
        <com.amazon.podcast.views.EmberTextView
            android:textSize="@dimen/podcast_text_size_h2"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/podcast_spacer_micro"
            android:maxLines="2"
            android:layout_weight="2"
            android:lineSpacingExtra="@dimen/podcast_feature_play_title_line_space_padding"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/label_layout"
            style="@style/PodcastAppTheme.TextView.PodcastEntityTitle"/>
        <com.amazon.podcast.views.EmberTextView
            android:textSize="@dimen/podcast_text_size_t1"
            android:id="@+id/primary_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/podcast_spacer_micro"
            android:maxLines="2"
            android:layout_weight="2"
            app:layout_constraintTop_toBottomOf="@+id/title"
            style="@style/PodcastAppTheme.TextView.Primary"/>
        <com.amazon.podcast.views.EmberTextView
            android:id="@+id/secondary_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/podcast_spacer_mini"
            android:maxLines="1"
            android:layout_weight="2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/primary_text"
            style="@style/PodcastAppTheme.TextView.Secondary"/>
        <com.amazon.podcast.views.EmberTextView
            android:id="@+id/tertiary_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/podcast_spacer_mini"
            android:maxLines="1"
            android:layout_weight="2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/secondary_text"
            style="@style/PodcastAppTheme.TextView.Tertiary"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.amazon.podcast.views.galleryTemplate.IngressPlayButton
        android:id="@+id/PlayButtonWideScreen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/podcast_spacer_giant"
        android:layout_marginTop="@dimen/podcast_spacer_large"
        android:layout_marginRight="@dimen/podcast_spacer_large"
        android:layout_marginBottom="@dimen/podcast_feature_play_label_margin_bottom_wide_screen"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_views_layout"
        style="@style/ShowcaseButton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
