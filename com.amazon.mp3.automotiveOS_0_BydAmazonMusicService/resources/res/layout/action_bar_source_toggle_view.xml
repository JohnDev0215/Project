<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/SourceToggleContainer"
        android:background="@drawable/ripple_background_no_mask"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_alignWithParentIfMissing="true"
        android:paddingStart="@dimen/spacer_16"
        android:layout_toStartOf="@+id/Action_Button_Overflow"
        android:layout_alignParentStart="true">
        <TextView
            android:textSize="@dimen/action_bar_title_text_size"
            android:textColor="@drawable/source_toggle_text_color"
            android:id="@+id/SourceToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/AmazonMusic.EmberRegularText"/>
        <ImageView
            android:id="@+id/SourceToggleIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/arrow_drop_down_btn"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/SourceToggle"/>
    </RelativeLayout>
    <include
        android:visibility="gone"
        android:layout_width="@dimen/spacer_48"
        android:layout_height="wrap_content"
        android:layout_toStartOf="@+id/Action_Button_Profile"
        layout="@layout/feed_button"
        style="@style/ActionBarSearchButtonStyle"/>
    <com.amazon.mp3.actionbar.view.ActionBarRightButton
        android:id="@+id/Action_Button_Profile"
        android:layout_toStartOf="@+id/Action_Button_Overflow"
        app:style="profile"
        style="@style/ActionBarSearchButtonStyle"/>
    <com.amazon.mp3.actionbar.view.ActionBarRightButton
        android:id="@+id/Action_Button_Overflow"
        android:layout_alignParentEnd="true"
        app:style="overflow"
        style="@style/ActionBarOverflowButtonStyle"/>
</RelativeLayout>
