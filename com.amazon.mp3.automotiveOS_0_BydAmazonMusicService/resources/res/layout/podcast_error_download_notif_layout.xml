<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingLeft="@dimen/podcast_download_notification_padding_left"
    android:paddingRight="@dimen/podcast_download_notification_padding_left"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/podcast_download_notif_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:gravity="start|center_vertical"
            android:id="@+id/podcast_imgv_download_icon"
            android:layout_width="@dimen/podcast_download_notification_icon_width"
            android:layout_height="match_parent"
            android:src="@drawable/podcast_ic_notification_tray_downloading"
            android:scaleType="center"
            android:layout_alignParentStart="true"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/podcast_download_notification_text_groups_margin_left"
            android:layout_marginEnd="@dimen/podcast_download_notification_text_groups_margin_right"
            android:layout_toStartOf="@+id/podcast_button_layout"
            android:layout_toEndOf="@+id/podcast_imgv_download_icon">
            <TextView
                android:textAppearance="@style/PodcastDownloadNotificationTitle"
                android:id="@+id/podcast_download_title"
                android:paddingTop="@dimen/podcast_download_notification_text_padding_top"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textIsSelectable="false"/>
            <TextView
                android:textAppearance="@style/PodcastDownloadNotificationProgressStatus"
                android:id="@+id/podcast_download_error_msg"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textIsSelectable="false"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/podcast_button_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/podcast_download_notification_button_layout_margin_left"
            android:layout_alignParentEnd="true">
            <ImageView
                android:id="@+id/podcast_resume_button"
                android:paddingLeft="@dimen/podcast_download_notification_button_margin"
                android:paddingRight="@dimen/podcast_download_notification_button_margin"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/podcast_notification_download_resume"
                android:contentDescription="@string/podcast_resume_button"/>
            <ImageView
                android:id="@+id/podcast_cancel_button"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/podcast_notification_download_cancel"
                android:contentDescription="@string/podcast_cancel_button"
                android:paddingStart="@dimen/podcast_download_notification_button_margin"
                android:paddingEnd="@dimen/podcast_download_notification_last_button_margin_right"/>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
