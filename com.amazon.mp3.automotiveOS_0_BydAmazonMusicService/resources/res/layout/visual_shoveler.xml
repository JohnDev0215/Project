<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/visual_shoveler_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/visual_shoveler_header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin">
        <com.amazon.music.curate.skyfire.views.EmberTextView
            android:gravity="center"
            android:id="@+id/visual_shoveler_see_all_button"
            android:layout_height="@dimen/button_small"
            android:layout_alignParentTop="true"
            android:layout_marginEnd="@dimen/gutter"
            android:layout_alignParentEnd="true"
            style="@style/CurateTheme.TextView.ButtonSmallGlass"/>
        <com.amazon.music.curate.skyfire.views.EmberTextView
            android:gravity="center"
            android:id="@+id/visual_shoveler_new_playlist_button"
            android:layout_height="@dimen/button_small"
            android:layout_alignParentTop="true"
            android:layout_marginEnd="@dimen/gutter"
            android:layout_toStartOf="@+id/visual_shoveler_see_all_button"
            android:layout_alignParentEnd="true"
            style="@style/CurateTheme.TextView.ButtonSmallGlass"/>
        <ImageView
            android:id="@+id/visual_shoveler_new_playlist_icon"
            android:layout_width="@dimen/button_small"
            android:layout_height="@dimen/button_small"
            android:src="@drawable/add_to_library_button"
            android:scaleType="center"
            android:layout_alignParentTop="true"
            android:layout_toStartOf="@+id/visual_shoveler_see_all_button"
            style="@style/CurateTheme.TextView.ButtonSmallGlass"/>
        <com.amazon.music.curate.skyfire.views.EmberTextView
            android:id="@+id/visual_shoveler_header"
            android:layout_marginStart="@dimen/margin"
            android:layout_toStartOf="@+id/visual_shoveler_see_all_button"
            android:layout_alignParentStart="true"
            style="@style/CurateTheme.TextView.Headline4"/>
    </RelativeLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/visual_shoveler_recycler_view"
        android:background="@null"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/visual_shoveler_header_layout"
        android:layout_marginStart="@dimen/margin"/>
</RelativeLayout>
