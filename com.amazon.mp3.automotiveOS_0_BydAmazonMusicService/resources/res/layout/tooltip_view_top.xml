<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tooltip_text"
        android:background="@drawable/tooltip_top"
        android:padding="@dimen/podcast_spacer_small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/podcast_spacer_base"
        style="@style/PodcastAppTheme.TextView.Primary"/>
</LinearLayout>
