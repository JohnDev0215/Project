<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="top"
        android:id="@+id/now_playing_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <ImageView
        android:background="@color/secondary_glass_3"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <RelativeLayout
            android:paddingLeft="@dimen/margin"
            android:paddingTop="@dimen/podcast_spacer_milli"
            android:paddingRight="@dimen/margin"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/gutter"
            android:layout_marginRight="@dimen/gutter"
            android:layout_centerInParent="true">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/cancel_button"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/podcast_now_playing_header_bar_height"
                android:src="@drawable/ic_chevron_caretdown"
                android:contentDescription="@string/podcast_back_button_label"/>
            <ImageButton
                android:layout_gravity="center_vertical"
                android:id="@+id/now_playing_overflow_button"
                android:background="@color/transparent"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/podcast_overflow_icon_dimension"
                android:src="@drawable/podcast_ic_action_overflow"
                android:layout_alignTop="@+id/cancel_button"
                android:layout_alignBottom="@+id/cancel_button"
                android:layout_alignParentEnd="true"/>
            <ImageButton
                android:layout_gravity="center_vertical"
                android:id="@+id/now_playing_casting_button"
                android:background="@color/transparent"
                android:visibility="visible"
                android:layout_width="@dimen/podcast_casting_icon_dimension"
                android:layout_height="@dimen/podcast_casting_icon_dimension"
                android:src="@drawable/ic_playback_castoff"
                android:layout_alignTop="@+id/cancel_button"
                android:layout_toStartOf="@+id/now_playing_share_button"/>
            <ImageButton
                android:layout_gravity="center_vertical"
                android:id="@+id/now_playing_share_button"
                android:background="@color/transparent"
                android:visibility="gone"
                android:layout_width="@dimen/podcast_sharing_icon_dimension"
                android:layout_height="@dimen/podcast_sharing_icon_dimension"
                android:src="@drawable/ic_share"
                android:layout_alignTop="@+id/cancel_button"
                android:layout_toStartOf="@+id/now_playing_overflow_button"/>
            <com.amazon.podcast.nowplaying.MetadataView
                android:id="@+id/now_playing_metadata"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/cancel_button"
                android:layout_centerHorizontal="true"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/transport_area"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/now_playing_metadata"
                android:layout_alignParentBottom="true">
                <com.amazon.podcast.nowplaying.TransportView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/now_playing_transport"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toTopOf="@+id/about_button"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.amazon.podcast.views.EmberTextView
                    android:gravity="center"
                    android:id="@+id/about_button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/podcast_now_playing_about_pull_tab_height"
                    android:text="@string/podcast_about_view_button"
                    app:layout_constraintBottom_toBottomOf="parent"
                    style="@style/PodcastAppTheme.TextView.PrimaryItalicized"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <ImageButton
                android:layout_gravity="center_vertical"
                android:id="@+id/now_playing_alexa_button"
                android:background="@color/transparent"
                android:visibility="invisible"
                android:layout_width="@dimen/podcast_alexa_icon_dimension"
                android:layout_height="@dimen/podcast_alexa_icon_dimension"
                android:src="@drawable/ic_navigation_alexa_white"
                android:layout_alignBottom="@+id/transport_area"
                android:layout_alignEnd="@+id/now_playing_metadata"/>
        </RelativeLayout>
        <com.amazon.podcast.views.RibbonNotificationView
            android:id="@+id/now_playing_notification_ribbon"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:elevation="10dp"/>
    </RelativeLayout>
    <View
        android:id="@+id/podcast_now_playing_filter"
        android:background="@color/secondary"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/about_bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:behavior_hideable="false"
        app:behavior_peekHeight="@dimen/zero_dp"
        app:layout_behavior="@string/bottom_sheet_behavior">
        <com.amazon.podcast.nowplaying.AboutView
            android:id="@+id/now_playing_about_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/podcast_playback_speed_bottom_sheet"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:behavior_hideable="true"
        app:behavior_peekHeight="@dimen/zero_dp"
        app:layout_behavior="@string/bottom_sheet_behavior">
        <com.amazon.podcast.nowplaying.PlaybackSpeedSelectionView
            android:id="@+id/podcast_now_playing_playback_speed_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/podcast_sleep_timer_duration_bottom_sheet"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:behavior_hideable="true"
        app:behavior_peekHeight="@dimen/zero_dp"
        app:layout_behavior="@string/bottom_sheet_behavior">
        <com.amazon.podcast.nowplaying.SleepTimerSelectionView
            android:id="@+id/podcast_now_playing_sleep_timer_duration_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/podcast_full_screen_transcription_bottom_sheet"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:behavior_hideable="true"
        app:behavior_peekHeight="@dimen/zero_dp"
        app:layout_behavior="@string/bottom_sheet_behavior">
        <com.amazon.podcast.views.transcription.FullScreenTranscriptView
            android:id="@+id/podcast_full_screen_transcription_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
