<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <Button
        android:textSize="@dimen/text_size_small"
        android:id="@+id/ContinueButton"
        android:background="@color/vivace_blue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:text="@string/dmusic_button_continue"
        android:layout_centerInParent="true"
        style="@style/SsoWelcomeButton"/>
    <TextView
        android:textSize="@dimen/text_size_small"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/WelcomeUserDescText"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="@dimen/loading_screen_spacing"
        android:layout_above="@+id/ContinueButton"
        style="@style/EmptyLibraryBodyText"/>
    <TextView
        android:textSize="24sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/WelcomeUserText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="@dimen/loading_screen_spacing"
        android:text="@string/dmusic_welcome"
        android:layout_above="@+id/WelcomeUserDescText"
        style="@style/EmptyLibraryBodyText"/>
    <ImageView
        android:id="@+id/SSO_SignIn_Img"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/loading_screen_spacing"
        android:src="@drawable/logo_loading"
        android:layout_above="@+id/WelcomeUserText"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/ssoLegalText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="@dimen/spacing_16dp"
        android:layout_marginRight="16dp"
        android:text="@string/dmusic_sso_continue_legal_text"
        android:layout_below="@+id/ContinueButton"
        style="@style/EmptyLibraryBodyText"/>
    <Button
        android:id="@+id/WrongUserText"
        android:background="@android:color/transparent"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="@dimen/loading_screen_spacing"
        android:layout_marginRight="16dp"
        android:text="@string/dmusic_sso_wrong_user"
        android:layout_below="@+id/ssoLegalText"
        android:layout_centerHorizontal="true"
        style="@style/SsoWelcomeButton"/>
</RelativeLayout>
