<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="start"
    android:orientation="vertical"
    android:padding="@dimen/dialog_outside_margin"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="@style/DialogTitleText"
        android:gravity="center_vertical"
        android:background="@android:drawable/list_selector_background"
        android:paddingBottom="@dimen/dialog_text_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dmusic_setting_download_location_title"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/loading_spinner"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/dmmviewlibrary_progress_bar"/>
    <ScrollView
        android:id="@+id/content_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textAppearance="@style/DialogBodyText"
                android:gravity="center_vertical"
                android:background="@android:drawable/list_selector_background"
                android:paddingBottom="@dimen/dialog_text_padding"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4dp"
                android:text="@string/dmusic_setting_download_location_item_header"/>
            <CheckedTextView
                android:textAppearance="@style/SDCardDialogButtonText"
                android:gravity="center_vertical"
                android:id="@+id/DownloadLocationInternal"
                android:background="@drawable/source_toggle_row_color"
                android:paddingBottom="@dimen/dialog_small_border_padding"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dialog_radio_button_row_height"
                android:checkMark="@drawable/abc_btn_radio_material"
                android:text="@string/dmusic_setting_download_location_internal"
                android:checkMarkTint="@color/vivace_blue"
                style="@style/SDCardDialogButton"/>
            <CheckedTextView
                android:textAppearance="@style/SDCardDialogButtonText"
                android:gravity="center_vertical"
                android:id="@+id/DownloadLocationExternal"
                android:background="@drawable/source_toggle_row_color"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dialog_radio_button_row_height"
                android:checkMark="@drawable/abc_btn_radio_material"
                android:text="@string/dmusic_setting_download_location_external"
                android:checkMarkTint="@color/vivace_blue"
                style="@style/SDCardDialogButton"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
