<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/call_to_action"
    android:layout_width="match_parent"
    android:layout_height="90dp">
    <TextView
        android:id="@+id/call_to_action_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacer_small"
        android:layout_marginBottom="@dimen/spacer_small"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        style="@style/AppTheme.TextAppearance.Primary"/>
    <Button
        android:id="@+id/call_to_action_button"
        android:layout_width="match_parent"
        android:layout_below="@+id/call_to_action_title"
        android:layout_marginStart="@dimen/spacer_base"
        android:layout_marginEnd="@dimen/spacer_base"
        style="@style/GlassMediumButton"/>
</RelativeLayout>
