<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/backgroundView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/backgroundGradient"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/background_gradient_engagement"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contentView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/left_base_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.05"/>
        <TextView
            android:id="@+id/subhead"
            android:background="@drawable/rounded_edge_with_border"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/bauhaus_spacer_mini"
            android:textAlignment="textStart"
            app:layout_constraintBottom_toTopOf="@+id/headline"
            app:layout_constraintStart_toStartOf="@+id/left_base_line"/>
        <TextView
            android:id="@+id/headline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/bauhaus_spacer_medium"
            android:layout_marginBottom="@dimen/bauhaus_spacer_mini"
            android:textAlignment="textStart"
            app:layout_constraintBottom_toTopOf="@+id/byline"
            app:layout_constraintEnd_toEndOf="@+id/right_base_line"
            app:layout_constraintStart_toStartOf="@+id/left_base_line"/>
        <TextView
            android:id="@+id/byline"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/bauhaus_spacer_small"
            android:textAlignment="textStart"
            app:layout_constraintBottom_toTopOf="@+id/copy"
            app:layout_constraintEnd_toEndOf="@+id/right_base_line"
            app:layout_constraintStart_toStartOf="@+id/left_base_line"/>
        <TextView
            android:id="@+id/copy"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/bauhaus_spacer_small"
            android:textAlignment="textStart"
            app:layout_constraintBottom_toTopOf="@+id/primaryButton"
            app:layout_constraintEnd_toEndOf="@+id/right_base_line"
            app:layout_constraintStart_toStartOf="@+id/left_base_line"/>
        <TextView
            android:gravity="center"
            android:id="@+id/primaryButton"
            android:background="@drawable/rounded_edges"
            android:paddingTop="@dimen/bauhaus_spacer_small"
            android:paddingBottom="@dimen/bauhaus_spacer_small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/bauhaus_spacer_base"
            android:layout_marginBottom="@dimen/bauhaus_spacer_small"
            android:textAlignment="center"
            app:layout_constraintBottom_toTopOf="@+id/secondaryButton"
            app:layout_constraintEnd_toEndOf="@+id/right_base_line"
            app:layout_constraintStart_toStartOf="@+id/left_base_line"/>
        <TextView
            android:gravity="center"
            android:id="@+id/secondaryButton"
            android:paddingBottom="@dimen/bauhaus_spacer_base"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            app:layout_constraintBottom_toTopOf="@+id/termsOfUseText"
            app:layout_constraintEnd_toEndOf="@+id/right_base_line"
            app:layout_constraintStart_toStartOf="@+id/left_base_line"/>
        <TextView
            android:id="@+id/termsOfUseText"
            android:paddingBottom="@dimen/bauhaus_spacer_base"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="@+id/right_base_line"
            app:layout_constraintStart_toStartOf="@+id/left_base_line"
            app:layout_constraintTop_toBottomOf="@+id/secondaryButton"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/right_base_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.95"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.amazon.ui.foundations.views.BaseButton
        android:layout_gravity="center"
        android:id="@+id/closeButton"
        android:layout_width="@dimen/dialog_button_layout_height"
        android:layout_height="@dimen/dialog_button_layout_height"
        android:layout_marginTop="@dimen/bauhaus_spacer_giant"
        android:layout_marginRight="@dimen/bauhaus_spacer_small"
        android:layout_marginBottom="@dimen/bauhaus_spacer_small"
        android:src="@drawable/ic_dialog_close_dark"
        android:scaleType="fitXY"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/backgroundImage"/>
</androidx.constraintlayout.widget.ConstraintLayout>
