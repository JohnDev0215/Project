<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/ShowAllButtonContainer"
        android:background="@drawable/button_outline"
        android:padding="@dimen/spacing_12"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/spacing_24dp"
        android:layout_marginBottom="@dimen/spacing_24">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/CaretDownIcon"
            android:background="@android:color/transparent"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_chevron_caretdown"
            android:contentDescription="@string/expand_track_list_button_text"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/CaretUpIcon"
            android:background="@android:color/transparent"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_chevron_caretup"
            android:contentDescription="@string/compress_track_list_button_text"/>
        <TextView
            android:textSize="@dimen/follow_text_size"
            android:textColor="@android:color/white"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/MainButtonTextView"
            android:background="@android:color/transparent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/expand_track_list_button_text"
            android:maxLines="1"
            android:layout_marginStart="@dimen/spacing_4dp"
            android:layout_marginEnd="@dimen/spacing_4dp"/>
    </LinearLayout>
</LinearLayout>
