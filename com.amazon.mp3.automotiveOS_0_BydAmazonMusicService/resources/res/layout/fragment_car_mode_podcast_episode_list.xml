<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.amazon.ui.foundations.views.BaseButton
            android:id="@+id/car_mode_podcast_episode_list_close_button"
            android:focusable="true"
            android:visibility="visible"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacer_base"
            android:layout_marginStart="@dimen/spacer_base"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.amazon.ui.foundations.views.BaseButton
            android:id="@+id/car_mode_podcast_episode_list_alexa_button"
            android:focusable="true"
            android:visibility="visible"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacer_base"
            android:layout_marginEnd="@dimen/spacer_base"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/car_mode_podcast_episode_list_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/spacer_16"
            android:maxLines="1"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/car_mode_podcast_episode_list_close_button"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/car_mode_podcast_episode_list"
            android:layout_width="match_parent"
            android:layout_height="@dimen/spacing_0dp"
            android:layout_marginTop="@dimen/spacer_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/car_mode_podcast_episode_list_title"
            app:layout_constraintVertical_chainStyle="packed"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.amazon.mp3.auto.carmode.view.CarModeEmbeddedDialog
        android:id="@+id/car_mode_on_error_dialog"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/bauhaus_spacer_epic"
        android:layout_marginRight="@dimen/bauhaus_spacer_epic"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:layout_marginHorizontal="@dimen/bauhaus_spacer_epic"/>
    <ProgressBar
        android:id="@+id/loading_spinner"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        style="@style/Widget.AmazonMP3.ProgressBar.Large"/>
</RelativeLayout>
