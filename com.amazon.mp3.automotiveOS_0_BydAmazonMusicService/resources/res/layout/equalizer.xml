<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/toolbar"
        layout="@layout/toolbar"/>
    <androidx.appcompat.widget.AppCompatCheckBox
        android:id="@+id/equalizer_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/equalizer_knob_text_spacing_start"
        android:text="@string/equalizer_action_bar_title"
        android:layout_marginStart="@dimen/equalizer_band_and_db_container_margin_left"
        android:buttonTint="@color/equalizer_knob_progress_end_color"/>
    <com.amazon.mp3.view.SlidingTabBar
        android:id="@+id/slidingTabBar"
        android:background="@color/background_dark_blue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:minHeight="@dimen/prime_tab_bar_height"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="@integer/equalizer_band_and_knob_layout_orientation"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_gravity="center|clip_horizontal"
            android:orientation="horizontal"
            android:id="@+id/equalizer_band_and_db_container"
            android:layout_width="@dimen/equalizer_band_and_db_container_width"
            android:layout_height="wrap_content"
            android:layout_weight="@integer/equalizer_band_and_db_container_layout_weight"
            android:layout_marginStart="@dimen/equalizer_band_and_db_container_margin_left"
            android:layout_marginEnd="@dimen/equalizer_band_and_db_container_margin_right">
            <include
                android:id="@+id/equalizer_amp_labels"
                layout="@layout/equalizer_amp_labels"/>
            <LinearLayout
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:id="@+id/equalizer_band_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="center|clip_horizontal"
            android:orientation="@integer/equalizer_knob_container_orientation"
            android:id="@+id/knob_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/equalizer_knob_container_margin_top"
            android:layout_marginEnd="@dimen/equalizer_knob_container_margin_right">
            <LinearLayout
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.amazon.mp3.view.Knob
                    android:id="@+id/bass_boost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="@dimen/equalizer_knob_text_size"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/equalizer_knob_text_spacing_top"
                    android:layout_marginBottom="@dimen/equalizer_knob_text_spacing_bottom"
                    android:text="@string/equalizer_bass_text"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/equalizer_knob_spacing"
                android:layout_marginEnd="@dimen/equalizer_knob_spacing">
                <com.amazon.mp3.view.Knob
                    android:id="@+id/volume_control"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="@dimen/equalizer_knob_text_size"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/equalizer_knob_text_spacing_top"
                    android:layout_marginBottom="@dimen/equalizer_knob_text_spacing_bottom"
                    android:text="@string/equalizer_volume_text"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.amazon.mp3.view.Knob
                    android:id="@+id/treble"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="@dimen/equalizer_knob_text_size"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/equalizer_knob_text_spacing_top"
                    android:layout_marginBottom="@dimen/equalizer_knob_text_spacing_bottom"
                    android:text="@string/equalizer_treble_text"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
