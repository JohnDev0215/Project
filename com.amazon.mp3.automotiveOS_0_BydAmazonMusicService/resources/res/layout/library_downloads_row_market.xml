<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="@dimen/library_list_view_item_height_3_lines"
    android:baselineAligned="false">
    <ImageView
        android:id="@+id/DownloadArtwork"
        android:layout_width="@dimen/default_listview_art_size"
        android:layout_height="@dimen/default_listview_art_size"
        android:layout_centerVertical="true"
        style="@style/LibraryListItemAlbumArt"/>
    <ImageView
        android:id="@+id/AlbumPrimeIndicator"
        android:visibility="gone"
        android:layout_width="@dimen/small_prime_sash_size"
        android:layout_height="@dimen/small_prime_sash_size"
        android:src="@drawable/prime_sash"
        android:scaleType="fitCenter"
        android:layout_alignTop="@+id/DownloadArtwork"
        android:layout_alignStart="@+id/DownloadArtwork"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@+id/RightViews"
        android:layout_toEndOf="@+id/DownloadArtwork">
        <TextView
            android:id="@+id/DownloadName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            style="@style/LibraryListItemPrimaryText"/>
        <TextView
            android:id="@+id/Counts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            style="@style/LibraryListItemSecondaryText"/>
        <TextView
            android:id="@+id/Queued"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            style="@style/LibraryListItemSecondaryText"/>
        <ProgressBar
            android:id="@+id/DownloadProgress"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="9dp"
            android:layout_marginBottom="6dp"
            android:progressDrawable="@drawable/custom_progress_horizontal"
            style="?android:attr/progressBarStyleHorizontal"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/RightViews"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true">
        <ImageButton
            android:id="@+id/PauseButton"
            android:background="@null"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tiny_padding"
            android:src="@drawable/download_btn_pause"
            android:minWidth="@dimen/minimum_button_width"/>
        <ProgressBar
            android:id="@+id/ActionProgress"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tiny_padding"
            android:minWidth="@dimen/minimum_button_width"/>
    </FrameLayout>
</RelativeLayout>
