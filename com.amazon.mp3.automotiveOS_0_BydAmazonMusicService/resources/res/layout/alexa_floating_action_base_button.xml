<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/alexa_fab"
    android:layout_width="@dimen/fab_btn_width_car_mode"
    android:layout_height="@dimen/fab_btn_height_car_mode"
    android:elevation="8dp">
    <com.amazon.ui.foundations.views.BaseButton
        android:id="@+id/alexa_button"
        android:background="@drawable/ripple_background_no_mask"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_alexa_bauhaus"
        android:layout_marginStart="@dimen/spacer_small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
