<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ptc_grid_item_widget"
    android:background="@color/transparent"
    android:padding="@dimen/podcast_spacer_mini"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/ptc_podcast_image_border"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"/>
    <ImageView
        android:id="@+id/ptc_single_podcast_image"
        android:background="@drawable/ptc_podcast_image_border_transparent"
        android:visibility="visible"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/ic_empty_state_image"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"/>
    <ImageButton
        android:layout_gravity="center"
        android:id="@+id/ptc_podcast_follow_icon"
        android:visibility="invisible"
        android:layout_width="@dimen/podcast_spacer_large"
        android:layout_height="@dimen/podcast_spacer_large"
        android:src="@drawable/ic_following"/>
    <ImageButton
        android:layout_gravity="end|bottom"
        android:id="@+id/ptc_podcast_about_button"
        android:background="#00000000"
        android:visibility="invisible"
        android:clickable="true"
        android:layout_width="@dimen/podcast_spacer_large"
        android:layout_height="@dimen/podcast_spacer_large"
        android:src="@drawable/ic_alerts_information"/>
</FrameLayout>
