<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/secondary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:background="@drawable/gradient1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/podcast_card_now_playing_view_Pager2"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/podcast_card_outside_bottom_spacer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/podcast_card_now_playing_header_layout"/>
    <RelativeLayout
        android:id="@+id/podcast_card_now_playing_large_device_left_preview_gradient"
        android:background="@drawable/card_left_preview_gradient"
        android:visibility="gone"
        android:layout_width="@dimen/gutter"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/podcast_card_outside_bottom_spacer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/podcast_card_now_playing_header_layout"/>
    <RelativeLayout
        android:id="@+id/podcast_card_now_playing_large_device_right_preview_gradient"
        android:background="@drawable/card_right_preview_gradient"
        android:visibility="gone"
        android:layout_width="@dimen/gutter"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/podcast_card_outside_bottom_spacer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/podcast_card_now_playing_header_layout"/>
    <RelativeLayout
        android:id="@+id/podcast_card_now_playing_left_preview_button"
        android:background="@color/transparent"
        android:layout_width="@dimen/gutter"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/podcast_card_outside_bottom_spacer"
        android:contentDescription="@string/podcast_card_now_playing_left_preview_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/podcast_card_now_playing_header_layout"/>
    <RelativeLayout
        android:id="@+id/podcast_card_now_playing_right_preview_button"
        android:background="@color/transparent"
        android:layout_width="@dimen/gutter"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/podcast_card_outside_bottom_spacer"
        android:contentDescription="@string/podcast_card_now_playing_right_preview_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/podcast_card_now_playing_header_layout"/>
    <RelativeLayout
        android:id="@+id/podcast_card_now_playing_view_loading_screen"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.amazon.podcast.views.LoadingView
            android:id="@+id/podcast_card_now_playing_template_loading_view"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/podcast_card_now_playing_header_layout"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="@dimen/podcast_spacer_epic"
        android:layout_alignParentTop="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageButton
            android:id="@+id/podcast_card_now_playing_screen_dismiss_button"
            android:background="@color/transparent"
            android:layout_width="@dimen/podcast_tiny_icon_button"
            android:layout_height="@dimen/podcast_tiny_icon_button"
            android:src="@drawable/ic_podcast_action_cancel"
            android:layout_centerVertical="true"
            android:contentDescription="@string/podcast_card_now_playing_screen_dismiss_button"
            android:layout_marginStart="@dimen/gutter"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
