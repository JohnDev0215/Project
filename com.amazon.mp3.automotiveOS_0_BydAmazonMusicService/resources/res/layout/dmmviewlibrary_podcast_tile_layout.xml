<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/podcast_vertical_item_view"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/spacer_24"
    android:foreground="@drawable/ripple"
    android:layout_marginEnd="@dimen/podcast_gutter">
    <ImageView
        android:id="@+id/vertical_item_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <ImageButton
        android:id="@+id/vertical_item_play_button"
        android:background="@drawable/podcast_circle_button_background"
        android:layout_width="@dimen/spacer_48"
        android:layout_height="@dimen/spacer_48"
        android:layout_margin="@dimen/spacer_8"
        android:src="@drawable/podcast_ic_play"
        android:adjustViewBounds="true"
        android:layout_alignBottom="@+id/vertical_item_image"/>
    <ProgressBar
        android:id="@+id/vertical_item_horizontal_progress_bar"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/spacer_4"
        android:indeterminate="false"
        android:progressDrawable="@drawable/podcast_episode_progress_bar"
        android:layout_alignBottom="@+id/vertical_item_image"
        style="?android:attr/progressBarStyleHorizontal"/>
    <TextView
        android:id="@+id/vertical_item_label"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_below="@+id/vertical_item_image"/>
    <TextView
        android:id="@+id/vertical_item_primary_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:layout_below="@+id/vertical_item_label"/>
    <TextView
        android:id="@+id/vertical_item_secondary_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_below="@+id/vertical_item_primary_text"/>
</RelativeLayout>
