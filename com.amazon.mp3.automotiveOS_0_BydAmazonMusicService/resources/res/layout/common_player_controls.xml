<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.amazon.ui.foundations.views.BaseButton
        android:id="@+id/PersistentPlayerJumpBack"
        android:background="@drawable/ripple_background_no_mask"
        android:padding="@dimen/small_padding"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:src="@drawable/ic_playback_jumpback10"
        android:contentDescription="@string/dmusic_player_jump_back_button_description"/>
    <Space
        android:background="@color/transparent"
        android:layout_width="@dimen/now_playing_controls_spacing"
        android:layout_height="match_parent"/>
    <ImageButton
        android:id="@+id/PersistentPlayerPrevButton"
        android:background="@drawable/ripple_background_no_mask"
        android:padding="@dimen/small_padding"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:src="@drawable/player_btn_prev"
        android:contentDescription="@string/dmusic_player_previous_button_description"/>
    <Space
        android:background="@color/transparent"
        android:layout_width="@dimen/now_playing_controls_spacing"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:layout_width="@dimen/persistent_player_view_group_height"
        android:layout_height="@dimen/persistent_player_view_group_height">
        <ProgressBar
            android:id="@+id/progress"
            android:padding="@dimen/small_padding"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:id="@+id/PersistentPlayerPlayButtonContainer"
            android:background="@drawable/player_active_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <include
                android:padding="@dimen/small_padding"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                layout="@layout/player_btn_circle_play"/>
        </FrameLayout>
    </FrameLayout>
    <Space
        android:background="@color/transparent"
        android:layout_width="@dimen/now_playing_controls_spacing"
        android:layout_height="match_parent"/>
    <ImageButton
        android:id="@+id/PersistentPlayerNextButton"
        android:background="@drawable/ripple_background_no_mask"
        android:padding="@dimen/small_padding"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:src="@drawable/player_btn_next"
        android:contentDescription="@string/dmusic_player_btn_next_description"/>
    <Space
        android:background="@color/transparent"
        android:layout_width="@dimen/now_playing_controls_spacing"
        android:layout_height="match_parent"/>
    <com.amazon.ui.foundations.views.BaseButton
        android:id="@+id/PersistentPlayerJumpForward"
        android:background="@drawable/ripple_background_no_mask"
        android:padding="@dimen/small_padding"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:src="@drawable/ic_playback_jumpforward10"
        android:contentDescription="@string/dmusic_player_jump_forward_button_description"/>
</LinearLayout>
