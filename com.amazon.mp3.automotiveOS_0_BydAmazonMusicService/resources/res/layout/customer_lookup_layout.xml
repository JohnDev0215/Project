<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/customer_lookup"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/search_bar_level"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <android.widget.EditText
            android:textColor="@color/white"
            android:textColorHint="@color/light_grey"
            android:id="@+id/customer_search_bar"
            android:background="@drawable/pill_shape"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="0dp"
            android:layout_height="@dimen/spacer_36"
            android:hint="@string/customer_lookup_hint"
            android:drawablePadding="@dimen/spacer_10"
            android:completionThreshold="3"
            android:layout_weight="1"
            android:inputType="text"
            android:drawableStart="@drawable/search_pressed"
            android:drawableEnd="@drawable/cancel_btn"
            android:paddingStart="@dimen/spacer_10"
            android:paddingEnd="@dimen/text_1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/profile_search_cancel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="parent"/>
        <com.amazon.ui.foundations.views.BaseButton
            android:textSize="@dimen/dialog_small_text_size"
            android:textStyle="bold"
            android:id="@+id/profile_search_cancel"
            android:paddingTop="@dimen/spacer_4"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/customer_search_bar"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="@dimen/dialog_title_text_size"
        android:layout_gravity="center"
        android:id="@+id/no_results_text"
        android:paddingTop="@dimen/spacing_12"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@string/font_amazon_ember_regular"/>
    <TextView
        android:textSize="@dimen/text_size_15"
        android:layout_gravity="center"
        android:id="@+id/no_results_query"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@string/font_amazon_ember_regular"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/profile_results"
        android:paddingTop="@dimen/spacer_6"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/profile_suggestions"
        android:paddingTop="@dimen/spacer_6"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"/>
</LinearLayout>
