<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/detail_header_section_margin">
    <TextView
        android:id="@+id/header_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/play_equalizer"
        android:background="@layout/dmmviewlibrary_equalizer_container_oval"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacer_24"
        android:layout_marginBottom="@dimen/spacer_24"
        android:layout_weight="1"
        android:top="@dimen/spacer_24"
        android:bottom="@dimen/spacer_24"
        android:paddingStart="@dimen/spacer_16"
        android:paddingEnd="@dimen/spacer_12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_text">
        <com.amazon.music.views.library.views.PlayNotificationIcon
            android:gravity="start"
            android:id="@+id/PlaystateIcon"
            android:visibility="visible"
            android:clickable="false"
            android:layout_width="@dimen/spacer_24"
            android:layout_height="@dimen/spacer_24"
            android:layout_marginTop="@dimen/spacer_12"
            android:layout_marginBottom="@dimen/spacer_12"
            android:tint="@android:color/white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/header_text"/>
        <TextView
            android:textSize="@dimen/text_size_15"
            android:gravity="start"
            android:id="@+id/internal_storage_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacer_12"
            android:layout_marginEnd="@dimen/spacer_12"/>
    </LinearLayout>
    <com.amazon.ui.foundations.views.BaseButton
        android:id="@+id/large_station_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/dmusic_detail_page_start_station"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_text"/>
</androidx.constraintlayout.widget.ConstraintLayout>
