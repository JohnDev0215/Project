<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/coach_mark_large_circle"
        android:background="@drawable/coach_mark_large_circle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/coach_mark_medium_circle"
        android:background="@drawable/coach_mark_medium_circle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/coach_mark_small_circle"
        android:background="@drawable/coach_mark_small_circle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</FrameLayout>
