<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/customer_profile_edit_privacy_fragment"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:id="@+id/customer_profile_edit_privacy_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/customer_profile_edit_privacy_follow_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/customer_profile_edit_privacy_text"/>
    <ToggleButton
        android:id="@+id/customer_profile_edit_follow_privacy_toggle_button"
        android:background="@drawable/ic_toggle_selector"
        android:layout_width="18dp"
        android:layout_height="14dp"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:textOn="@null"
        android:textOff="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/customer_profile_edit_privacy_follow_text"
        app:layout_constraintTop_toBottomOf="@+id/customer_profile_edit_privacy_text"/>
    <TextView
        android:id="@+id/customer_profile_edit_follow_privacy_supplemental_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/customer_profile_edit_privacy_follow_text"/>
    <TextView
        android:id="@+id/customer_profile_edit_community_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/customer_profile_edit_follow_privacy_supplemental_text"/>
    <TextView
        android:id="@+id/customer_profile_edit_community_listening_activity_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/customer_profile_edit_community_text"/>
    <ToggleButton
        android:id="@+id/customer_profile_edit_listening_activity_community_toggle_button"
        android:background="@drawable/ic_toggle_selector"
        android:layout_width="18dp"
        android:layout_height="14dp"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:textOn="@null"
        android:textOff="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/customer_profile_edit_community_listening_activity_text"
        app:layout_constraintTop_toBottomOf="@+id/customer_profile_edit_community_text"/>
    <TextView
        android:id="@+id/customer_profile_edit_listening_activity_community_privacy_supplemental_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/customer_profile_edit_community_listening_activity_text"/>
    <TextView
        android:id="@+id/customer_profile_edit_community_contacts_discovery_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/customer_profile_edit_listening_activity_community_privacy_supplemental_text"/>
    <ToggleButton
        android:id="@+id/customer_profile_edit_contacts_discovery_community_toggle_button"
        android:background="@drawable/ic_toggle_selector"
        android:layout_width="18dp"
        android:layout_height="14dp"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:textOn="@null"
        android:textOff="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/customer_profile_edit_community_contacts_discovery_text"
        app:layout_constraintTop_toBottomOf="@+id/customer_profile_edit_listening_activity_community_privacy_supplemental_text"/>
    <TextView
        android:id="@+id/customer_profile_edit_contacts_discovery_community_supplemental_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/customer_profile_edit_community_contacts_discovery_text"/>
</androidx.constraintlayout.widget.ConstraintLayout>
