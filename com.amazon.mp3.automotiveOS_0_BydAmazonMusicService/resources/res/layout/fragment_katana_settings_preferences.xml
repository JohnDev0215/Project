<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/primo_blue"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="@dimen/spacing_12dp"
        android:paddingBottom="@dimen/spacing_12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/spacing_12dp"
        android:paddingEnd="@dimen/spacing_12dp">
        <TextView
            android:textAppearance="@style/DialogTitleText"
            android:gravity="center_vertical"
            android:id="@+id/alertTitle"
            android:background="@android:drawable/list_selector_background"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_12dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/summary_header"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16dp">
            <TextView
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold"
                android:textColor="@color/vivace_blue"
                android:gravity="center_vertical"
                android:id="@+id/wifiTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dmusic_multi_bitrate_wifi_title"
                android:layout_marginStart="@dimen/spacing_12dp"/>
            <TextView
                android:textAppearance="@style/DialogBodyText"
                android:gravity="center_vertical"
                android:id="@+id/wifiSummary"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4dp"
                android:text="@string/dmusic_multi_bitrate_wifi_message"/>
            <include
                android:id="@+id/preferences_container_wifi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8dp"
                layout="@layout/katana_recycler_view_widget"/>
            <TextView
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold"
                android:textColor="@color/vivace_blue"
                android:gravity="center_vertical"
                android:id="@+id/mobileDataTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16dp"
                android:text="@string/dmusic_multi_bitrate_mobile_data_title"
                android:layout_marginStart="@dimen/spacing_12dp"/>
        </LinearLayout>
        <include
            android:id="@+id/preferences_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8dp"
            layout="@layout/katana_recycler_view_widget"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/networkPreferenceContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12dp"
            android:layout_marginBottom="@dimen/spacing_12dp">
            <CheckBox
                android:textColor="@color/dialog_text"
                android:id="@+id/cb_download_on_wifi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/dmusic_setting_downloads_wifi_only_pref"
                android:buttonTint="@color/vivace_blue"/>
            <com.amazon.mp3.view.SpannableTextView
                android:id="@+id/tv_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12dp"
                style="@style/DialogBodyText"/>
        </LinearLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/spacing_8dp"
            android:layout_marginEnd="@dimen/spacing_12dp">
            <Button
                android:textSize="@dimen/text_size_small"
                android:textColor="@color/vivace_blue"
                android:gravity="center"
                android:id="@+id/save"
                android:background="@color/transparent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/spacing_12dp"
                android:layout_alignParentEnd="true"/>
            <Button
                android:textSize="@dimen/text_size_small"
                android:textColor="@color/vivace_blue"
                android:gravity="center"
                android:id="@+id/cancel"
                android:background="@color/transparent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignWithParentIfMissing="true"
                android:layout_toStartOf="@+id/save"/>
        </RelativeLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
