<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:id="@+id/error_view"
    android:background="@color/bauhaus_base"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/error_view_primary_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacer_small"
            style="@style/AppTheme.TextAppearance.Primary"/>
        <TextView
            android:id="@+id/error_view_secondary_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/AppTheme.TextAppearance.Secondary"/>
        <TextView
            android:id="@+id/error_view_button"
            android:visibility="gone"
            android:layout_marginTop="@dimen/spacer_small"
            style="@style/PillNavigatorWidgetItem"/>
    </LinearLayout>
</RelativeLayout>
