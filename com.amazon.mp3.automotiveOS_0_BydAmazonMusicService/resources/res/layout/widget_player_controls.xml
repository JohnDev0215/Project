<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="horizontal"
    android:id="@+id/PlayerControls"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
    <ImageView
        android:id="@+id/WidgetPrevButton"
        android:visibility="gone"
        android:layout_width="@dimen/player_button_width"
        android:layout_height="@dimen/player_button_width"
        android:src="@drawable/widget_player_prev"/>
    <ImageView
        android:id="@+id/PrevButtonDisabled"
        android:clickable="false"
        android:layout_width="@dimen/player_button_width"
        android:layout_height="@dimen/player_button_width"
        android:src="@drawable/widget_player_prev_disabled"/>
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/PlayPauseButton"
            android:visibility="gone"
            android:layout_width="@dimen/player_button_width"
            android:layout_height="@dimen/player_button_width"
            android:src="@drawable/widget_player_play"/>
        <ImageView
            android:id="@+id/PlayPauseButtonDisabled"
            android:clickable="false"
            android:layout_width="@dimen/player_button_width"
            android:layout_height="@dimen/player_button_width"
            android:src="@drawable/widget_player_play_disabled"/>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/progress"
            android:visibility="gone"
            android:layout_width="@dimen/player_button_width"
            android:layout_height="@dimen/player_button_width"
            style="@style/dmmviewlibrary_progress_bar_small"/>
    </FrameLayout>
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
    <ImageView
        android:id="@+id/WidgetNextButton"
        android:visibility="gone"
        android:layout_width="@dimen/player_button_width"
        android:layout_height="@dimen/player_button_width"
        android:src="@drawable/widget_player_next"/>
    <ImageView
        android:id="@+id/NextButtonDisabled"
        android:clickable="false"
        android:layout_width="@dimen/player_button_width"
        android:layout_height="@dimen/player_button_width"
        android:src="@drawable/widget_player_next_disabled"/>
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
    <ImageView
        android:id="@+id/WidgetAlexaButton"
        android:visibility="invisible"
        android:layout_width="@dimen/player_button_width"
        android:layout_height="@dimen/player_button_width"
        android:src="@drawable/widget_player_alexa"/>
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
</LinearLayout>
