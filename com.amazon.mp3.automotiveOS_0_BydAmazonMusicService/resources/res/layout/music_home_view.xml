<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/music_home_view_root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:orientation="vertical"
        android:id="@+id/music_screen_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_bar_and_mini_player_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/bottom_bar_and_mini_player_container"
        android:background="@drawable/bottom_nav_background"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/bottom_bar_horizontal_margin"
        android:layout_marginRight="@dimen/bottom_bar_horizontal_margin"
        android:layout_marginBottom="@dimen/bottom_bar_bottom_margin"
        android:elevation="@dimen/bottom_bar_elevation"
        app:layout_constraintBottom_toTopOf="@+id/persistent_banner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/music_screen_container">
        <ProgressBar
            android:id="@+id/miniplayer_progress_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/miniplayer_progress_bar_height"
            style="?android:attr/progressBarStyleHorizontal"/>
        <FrameLayout
            android:id="@+id/mini_player_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.amazon.mp3.view.TooltipView
                android:layout_gravity="end"
                android:id="@+id/TooltipDisplayerContainer"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacer_2"/>
        </FrameLayout>
        <com.amazon.podcast.nowplaying.MiniPlayerView
            android:id="@+id/podcast_mini_player"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <View
        android:id="@+id/bottom_bar_nav_top_mask"
        android:background="@drawable/bottom_nav_top_mask_gradient"
        android:layout_width="0dp"
        android:layout_height="@dimen/bottom_bar_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/bottom_bar_and_mini_player_container"/>
    <View
        android:id="@+id/bottom_bar_bottom_mask"
        android:background="@drawable/bottom_nav_background_gradient"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/persistent_banner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bottom_bar_nav_top_mask"/>
    <com.amazon.music.views.library.views.PersistentBannerView
        android:id="@+id/persistent_banner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
