<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:paddingTop="@dimen/medium_padding"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ViewStub
        android:id="@+id/PlaylistHeaderViewStub"
        android:inflatedId="@+id/PlaylistHeaderViewStub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ImageView
        android:id="@+id/AlbumDetailArtwork"
        android:background="@color/transparent"
        android:layout_width="@dimen/album_detail_artwork_size"
        android:layout_height="@dimen/album_detail_artwork_size"
        android:layout_marginBottom="@dimen/library_detail_padding"
        android:src="@drawable/album_placeholder"
        android:layout_marginStart="@dimen/library_detail_padding"
        android:layout_marginEnd="@dimen/library_detail_padding"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_alignTop="@+id/AlbumDetailArtwork"
        android:layout_alignBottom="@+id/AlbumDetailArtwork"
        android:layout_toEndOf="@+id/AlbumDetailArtwork">
        <TextView
            android:ellipsize="end"
            android:id="@+id/AlbumName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/large_padding"
            android:singleLine="true"
            style="@style/PrimaryText"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/grey"
            android:id="@+id/ArtistName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12dp"
            android:singleLine="true"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.amazon.mp3.view.BadgeView
                android:id="@+id/KatanaAlbumDetailBadge"
                android:layout_marginRight="@dimen/spacing_4dp"
                android:layout_marginEnd="@dimen/spacing_4dp"
                style="@style/ContentEncodingBadge"/>
            <com.amazon.mp3.view.BadgeView
                android:id="@+id/ImmersiveAlbumDetailBadge"
                android:layout_marginRight="@dimen/spacing_4dp"
                android:layout_marginEnd="@dimen/spacing_4dp"
                style="@style/ContentEncodingBadge"/>
            <com.amazon.mp3.view.BadgeView
                android:id="@+id/ImmersiveAlbumDetailExtraBadge"
                style="@style/ContentEncodingBadge"/>
        </LinearLayout>
    </LinearLayout>
    <RelativeLayout
        android:gravity="center"
        android:id="@+id/DetailPlayerControlsFragment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/AlbumDetailArtwork"/>
</RelativeLayout>
