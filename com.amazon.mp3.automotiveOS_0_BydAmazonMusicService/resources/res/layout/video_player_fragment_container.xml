<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/VideoPlaybackSurfaceLayout"
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>
    <FrameLayout
        android:id="@+id/VideoBackgroundOverlay"
        android:background="@color/secondary_glass_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/VideoPlaybackSurfaceLayout"
        android:layout_alignBottom="@+id/VideoPlaybackSurfaceLayout"/>
    <ImageView
        android:id="@+id/VideoHeaderClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacer_12"
        android:src="@drawable/ic_chevron_caretdown"
        android:layout_alignParentTop="true"
        android:layout_marginStart="@dimen/video_player_base_margin"
        android:layout_marginEnd="@dimen/video_player_base_margin"
        android:layout_alignParentStart="true"/>
    <com.amazon.mp3.view.player.PlayerMetadataView
        android:id="@+id/VideoMetadataView"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/VideoPlayerCoverViewSeekBar"
        android:layout_alignStart="@+id/VideoPlayerCoverViewSeekBar"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/audioVideoToggleView"
        android:paddingTop="@dimen/spacing_6dp"
        android:paddingBottom="@dimen/spacing_8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_2dp"
        android:paddingStart="@dimen/spacing_16dp"
        android:paddingEnd="@dimen/spacing_16dp"
        android:layout_toEndOf="@+id/VideoHeaderClose"/>
    <ImageView
        android:id="@+id/VideoHeaderOverflow"
        android:layout_width="@dimen/spacer_48"
        android:layout_height="@dimen/spacer_48"
        android:src="@drawable/overflow_normal"
        android:scaleType="center"
        android:layout_alignParentTop="true"
        android:paddingStart="@dimen/spacer_4"
        android:layout_alignParentEnd="true"/>
    <ImageView
        android:id="@+id/VideoPlayerToggleCaptions"
        android:padding="@dimen/spacer_10"
        android:visibility="invisible"
        android:layout_width="@dimen/small_icon_button"
        android:layout_height="@dimen/small_icon_button"
        android:layout_marginTop="@dimen/spacer_8"
        android:layout_marginStart="@dimen/spacer_8"
        android:layout_alignParentStart="true"/>
    <ImageButton
        android:id="@+id/VideoPlayerShareButton"
        android:background="@drawable/ripple_background_no_mask"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/spacer_48"
        android:src="@drawable/ic_action_share_toolbar"/>
    <ImageView
        android:id="@+id/VideoPlayerExpandContract"
        android:background="@drawable/ripple_background_no_mask"
        android:padding="@dimen/spacing_10dp"
        android:visibility="invisible"
        android:layout_width="@dimen/small_icon_button"
        android:layout_height="@dimen/spacer_48"
        android:src="@drawable/ic_other_expand"/>
    <com.amazon.mp3.view.BauhausSeekBarWidget
        android:id="@+id/VideoPlayerCoverViewSeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        style="@style/NowPlayingSeekBar"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/controlsContainer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/bottom_spacing"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true">
        <com.amazon.ui.foundations.views.BaseButton
            android:id="@+id/iv_share"
            android:layout_width="@dimen/small_icon_button"
            android:layout_height="@dimen/small_icon_button"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/VideoPersistentPlayerContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.amazon.mp3.playback.view.PlayQueueButton
            android:id="@+id/PersistentPlayerPlayQueueButton"
            android:background="@drawable/ripple_background_no_mask"
            android:layout_width="@dimen/small_icon_button"
            android:layout_height="@dimen/small_icon_button"
            android:src="@drawable/ic_queue"
            android:contentDescription="@string/dmusic_player_play_queue_button_description"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/iv_alexa"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.amazon.ui.foundations.views.BaseButton
            android:id="@+id/iv_alexa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/StageLandscapeVideoControlTipAndBottomButtons"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/stage_video_landscape_buttons_bottom_margin"
        android:layout_above="@+id/StageLandscapeVideoSeekBar"
        android:layout_marginEnd="@dimen/stage_controls_layout_start_margin"
        android:layout_alignParentEnd="true">
        <TextView
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/stage_control_tip"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dmusic_stage_control_tip"
            android:layout_marginEnd="@dimen/spacer_12"/>
        <com.amazon.mp3.view.stage.StageBottomButtonsView
            android:id="@+id/StageLandscapeVideoBottomButtons"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <com.amazon.mp3.view.BauhausSeekBarWidget
        android:id="@+id/StageLandscapeVideoSeekBar"
        android:background="@drawable/now_playing_seek_bar_gradient_background"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/stage_landscape_controls_layout_bottom_margin"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/spacing_16dp"
        android:layout_marginEnd="@dimen/spacing_16dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:translationZ="@dimen/now_playing_seekbar_height"
        style="@style/NowPlayingSeekBar"/>
    <com.amazon.mp3.playback.view.VideoPreviewWindow
        android:id="@+id/VideoPreviewWindow"
        android:visibility="gone"
        android:layout_width="@dimen/videopreview_image_width"
        android:layout_height="match_parent"/>
    <Space
        android:id="@+id/bottom_spacing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
