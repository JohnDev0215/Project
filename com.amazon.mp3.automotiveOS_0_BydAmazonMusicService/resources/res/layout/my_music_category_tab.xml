<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/my_music_category_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@+id/my_music_category_row_item"
        android:background="@drawable/nav_item_background"
        android:layout_width="match_parent"
        android:layout_height="@dimen/prime_categories_tab_height"
        android:layout_marginTop="@dimen/spacer_2"
        android:layout_marginBottom="@dimen/spacer_2"
        android:layout_marginVertical="@dimen/spacer_2"
        style="@style/AmazonMusic.MainText">
        <TextView
            android:id="@+id/my_music_category_row_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/nav_button_padding"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:contentDescription="@string/content_description_button_descriptor"
            android:layout_marginStart="@dimen/nav_button_padding"
            android:layout_alignParentStart="true"
            style="@style/AmazonMusic.MainText"/>
        <ImageView
            android:id="@+id/my_music_category_row_nav_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/nav_button_padding"
            android:src="@drawable/ic_chevron_right"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/nav_button_padding"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</LinearLayout>
