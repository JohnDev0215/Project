<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:orientation="vertical"
        android:background="@color/artwork_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_gravity="top"
            android:id="@+id/now_playing_full_screen_transcription_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
        <ImageView
            android:layout_gravity="top"
            android:background="@drawable/transcript_gradient"
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:scaleType="centerCrop"
            android:rotation="180"/>
        <ImageView
            android:background="@drawable/transcript_gradient"
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:scaleType="centerCrop"
            android:layout_alignParentBottom="true"/>
        <ImageView
            android:background="@color/secondary_glass_4"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/badging_layout">
            <com.amazon.podcast.nowplaying.MiniPlayerView
                android:id="@+id/mini_player_view_full_screen_transcription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <RelativeLayout
                android:id="@+id/center_caret_layout"
                android:layout_width="@dimen/spacer_36"
                android:layout_height="match_parent"
                android:layout_below="@+id/mini_player_view_full_screen_transcription">
                <ImageView
                    android:id="@+id/center_caret"
                    android:layout_width="@dimen/nav_button_padding"
                    android:layout_height="@dimen/nav_button_padding"
                    android:src="@drawable/ic_transcript_indicator"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:layout_gravity="center_vertical"
                android:id="@+id/podcast_full_trancript_recyclerview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/center_caret_layout"
                android:layout_below="@+id/mini_player_view_full_screen_transcription"
                android:layout_marginEnd="@dimen/spacer_10"
                style="@style/TranscriptViewScrollbar"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/badging_layout"
            android:background="@color/black"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_alignParentBottom="true">
            <com.amazon.podcast.views.EmberTextView
                android:textSize="@dimen/text_size_11"
                android:id="@+id/full_screen_transcript_current_playing_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12:13"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/spacer_20"
                style="@style/PodcastAppTheme.TextView.FullScreenTranscriptTime"/>
            <com.amazon.podcast.views.EmberTextView
                android:id="@+id/full_screen_transcript_scroll_time"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/spacer_20"
                style="@style/PodcastAppTheme.TextView.FullScreenTranscriptScrollingTime"/>
            <com.amazon.podcast.views.EmberTextView
                android:ellipsize="end"
                android:id="@+id/transcript_badging"
                android:background="@drawable/content_badge_background"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auto_transcription"
                android:maxLines="1"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"
                android:paddingStart="@dimen/spacer_4"
                android:paddingEnd="@dimen/spacer_4"
                style="@style/PodcastAppTheme.TextView.FullScreenTranscriptTime"/>
            <ImageView
                android:id="@+id/full_screen_transcript_syncing_loadingview"
                android:visibility="gone"
                android:layout_width="@dimen/podcast_micro_icon_button"
                android:layout_height="@dimen/podcast_micro_icon_button"
                android:src="@drawable/ic_other_loader"
                android:layout_toLeftOf="@+id/transcript_badging"
                android:layout_alignTop="@+id/transcript_tap_text"
                android:layout_alignBottom="@+id/transcript_tap_text"
                android:layout_centerInParent="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/spacer_10"
                android:layout_toStartOf="@+id/transcript_tap_text"/>
            <com.amazon.podcast.views.EmberTextView
                android:id="@+id/full_screen_transcription_playback_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/spacer_20"
                android:layout_alignParentEnd="true"
                style="@style/PodcastAppTheme.TextView.FullScreenTranscriptTime"/>
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>
