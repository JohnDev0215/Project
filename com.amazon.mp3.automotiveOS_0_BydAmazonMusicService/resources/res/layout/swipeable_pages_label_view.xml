<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/swipeable_pages_label_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    style="@style/SwipeablePages.TextContainer">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/swipeable_pages_label_icons"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/icon_small"
        android:layout_centerVertical="true"/>
    <TextView
        android:id="@+id/swipeable_pages_label"
        android:layout_toRightOf="@+id/swipeable_pages_label_icons"
        style="@style/SwipeablePages.Text.Label"/>
</RelativeLayout>
