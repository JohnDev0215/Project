<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/ImageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        android:contentDescription="@null"/>
    <ProgressBar
        android:id="@+id/ProgressBar"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        style="@style/DefaultProgressBarHorizontal"/>
    <com.amazon.mp3.view.DownloadProgressBadgeView
        android:id="@+id/DownloadProgress"
        android:visibility="gone"
        android:layout_width="@dimen/download_circular_progress_bar_width"
        android:layout_height="@dimen/download_circular_progress_bar_width"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"/>
    <ImageView
        android:id="@+id/BadgeView"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:contentDescription="@null"/>
    <TextView
        android:textColor="@color/library_swatch_white"
        android:id="@+id/StatusTextView"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dmusic_download_state_waiting"
        android:layout_above="@+id/ProgressBar"
        android:layout_centerHorizontal="true"/>
</merge>
