<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="top"
        android:id="@+id/podcast_now_playing_sleep_timer_background"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <ImageView
        android:background="@color/secondary_glass_3"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/margin"
        android:paddingEnd="@dimen/margin"
        android:layout_marginStart="@dimen/gutter"
        android:layout_marginEnd="@dimen/gutter">
        <com.amazon.podcast.views.EmberTextView
            android:id="@+id/podcast_sleep_timer_title"
            android:layout_width="match_parent"
            android:layout_height="@dimen/podcast_spacer_giant_epic"
            android:text="@string/podcast_playback_sleep_timer_selection_title"
            android:layout_above="@+id/podcast_sleep_timer_active_turn_off"
            style="@style/PodcastAppTheme.TextView.OverlayTextStyle"/>
        <com.amazon.podcast.views.EmberTextView
            android:gravity="center_vertical"
            android:id="@+id/podcast_sleep_timer_active_turn_off"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/podcast_sleep_timer_duration_item_height"
            android:text="@string/podcast_playback_sleep_timer_active_turn_off"
            android:layout_above="@+id/podcast_sleep_timer_active_turn_off_divider"
            android:contentDescription="@string/podcast_playback_sleep_timer_active_turn_off"
            android:layout_alignStart="@+id/podcast_sleep_timer_options"
            style="@style/PodcastAppTheme.TextView.Primary"/>
        <View
            android:id="@+id/podcast_sleep_timer_active_turn_off_divider"
            android:background="@color/primary_glass_2"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/podcast_divider_height"
            android:layout_above="@+id/podcast_sleep_timer_options"/>
        <com.amazon.podcast.views.WrappedListView
            android:id="@+id/podcast_sleep_timer_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/podcast_sleep_timer_divider"/>
        <View
            android:id="@+id/podcast_sleep_timer_divider"
            android:background="@color/primary_glass_2"
            android:layout_width="match_parent"
            android:layout_height="@dimen/podcast_divider_height"
            android:layout_above="@+id/podcast_sleep_timer_end_of_episode"/>
        <com.amazon.podcast.views.EmberTextView
            android:gravity="center_vertical"
            android:id="@+id/podcast_sleep_timer_end_of_episode"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="@dimen/podcast_sleep_timer_duration_item_height"
            android:text="@string/podcast_playback_sleep_timer_end_of_episode"
            android:layout_above="@+id/podcast_sleep_timer_end_of_episode_divider"
            android:contentDescription="@string/podcast_playback_sleep_timer_end_of_episode"
            android:layout_alignStart="@+id/podcast_sleep_timer_options"
            style="@style/PodcastAppTheme.TextView.Primary"/>
        <View
            android:id="@+id/podcast_sleep_timer_end_of_episode_divider"
            android:background="@color/primary_glass_2"
            android:layout_width="match_parent"
            android:layout_height="@dimen/podcast_divider_height"
            android:layout_above="@+id/podcast_sleep_timer_dismiss"/>
        <com.amazon.podcast.views.EmberTextView
            android:gravity="center"
            android:id="@+id/podcast_sleep_timer_dismiss"
            android:layout_width="match_parent"
            android:layout_height="@dimen/podcast_playback_speed_item_height"
            android:text="@string/podcast_dismiss_label"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:contentDescription="@string/podcast_dismiss_label"
            style="@style/PodcastAppTheme.TextView.Primary"/>
    </RelativeLayout>
</RelativeLayout>
