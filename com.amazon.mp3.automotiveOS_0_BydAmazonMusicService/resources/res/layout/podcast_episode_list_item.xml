<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/podcast_spacer_small"
    android:layout_marginBottom="@dimen/podcast_spacer_small"
    android:foreground="@drawable/ripple">
    <ImageView
        android:id="@+id/podcast_episode_list_item_image"
        android:layout_width="@dimen/podcast_list_item_image_dimension"
        android:layout_height="@dimen/podcast_list_item_image_dimension"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/podcast_episode_list_item_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/podcast_spacer_base"
        android:layout_marginEnd="@dimen/podcast_spacer_base"
        app:layout_constraintBottom_toBottomOf="@+id/podcast_episode_list_item_image"
        app:layout_constraintEnd_toStartOf="@+id/podcast_list_item_play_button"
        app:layout_constraintStart_toEndOf="@+id/podcast_episode_list_item_image"
        app:layout_constraintTop_toTopOf="@+id/podcast_episode_list_item_image">
        <com.amazon.podcast.views.EmberTextView
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/podcast_list_item_primary_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            style="@style/PodcastAppTheme.TextView.Primary"/>
        <com.amazon.podcast.views.EmberTextView
            android:ellipsize="end"
            android:id="@+id/podcast_list_item_secondary_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/podcast_spacer_nano"
            android:maxLines="1"
            style="@style/PodcastAppTheme.TextView.Secondary"/>
    </LinearLayout>
    <ImageButton
        android:id="@+id/podcast_list_item_play_button"
        android:background="@color/transparent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_playinline"
        android:layout_marginStart="@dimen/podcast_spacer_nano"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
