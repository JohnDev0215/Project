<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/AlbumArtContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.amazon.ui.foundations.views.BaseImage
                android:id="@+id/PlayerCoverViewAlbumArt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scaleType="centerCrop"
                android:contentDescription="@string/dmusic_cover_album_art"/>
            <com.amazon.ui.foundations.views.BaseImage
                android:id="@+id/swap_art"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scaleType="centerCrop"
                android:contentDescription="@string/dmusic_cover_album_art"/>
            <include layout="@layout/station_pulse"/>
        </FrameLayout>
        <com.amazon.mp3.playback.view.lyrics.LyricsTextViewContainer
            android:gravity="center"
            android:id="@+id/LyricsViewContainer"
            android:background="@drawable/portrait_lyrics_window_background"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="@dimen/spacer_72"
            android:layout_alignBottom="@+id/AlbumArtContainer"/>
        <LinearLayout
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:id="@+id/bauhausNowPlayingNonBlockingView"
            android:background="@drawable/portrait_lyrics_window_background"
            android:paddingLeft="@dimen/spacer_12"
            android:paddingTop="@dimen/spacer_8"
            android:paddingRight="@dimen/spacer_12"
            android:paddingBottom="@dimen/spacer_24"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:cacheColorHint="@color/transparent"
            android:layout_alignBottom="@+id/AlbumArtContainer">
            <com.amazon.mp3.view.MessagingDialog
                android:id="@+id/messagingDialog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </RelativeLayout>
    <com.amazon.mp3.view.BauhausSeekBarWidget
        android:layout_gravity="bottom"
        android:id="@+id/PlayerCoverViewSeekBar"
        android:background="@drawable/now_playing_seek_bar_gradient_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:translationZ="@dimen/now_playing_seekbar_height"
        style="@style/NowPlayingSeekBar"/>
</merge>
