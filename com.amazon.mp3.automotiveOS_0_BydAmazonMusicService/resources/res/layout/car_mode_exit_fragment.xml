<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacer_epic"
        android:layout_marginStart="@dimen/spacer_epic"
        android:layout_marginEnd="@dimen/spacer_epic"
        app:layout_constraintBottom_toTopOf="@+id/preset_exit_title"
        app:layout_constraintStart_toStartOf="parent">
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/ic_car_mode_fab"
            android:visibility="visible"
            android:layout_width="@dimen/spacer_epic"
            android:layout_height="@dimen/spacer_epic"
            android:src="@drawable/ic_icon_car_white"
            android:backgroundTint="@color/grey_accent"
            app:fabCustomSize="@dimen/spacer_epic"/>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <TextView
        android:textSize="@dimen/car_mode_exit_disclaimer_text_size"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@+id/preset_exit_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dmusic_car_mode_first_time_exit_text"
        android:layout_marginStart="@dimen/spacer_epic"
        android:layout_marginEnd="@dimen/spacer_epic"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.35"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/presets_exit_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacer_epic"
        android:layout_marginBottom="@dimen/spacer_epic"
        android:layout_marginStart="@dimen/spacer_epic"
        android:layout_marginEnd="@dimen/spacer_epic"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/preset_exit_title">
        <com.amazon.ui.foundations.views.BaseButton
            android:id="@+id/presets_exit_cancel_button"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/spacer_epic"
            android:layout_marginEnd="@dimen/spacer_epic"/>
        <com.amazon.ui.foundations.views.BaseButton
            android:id="@+id/presets_exit_accept_button"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/spacer_epic"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
