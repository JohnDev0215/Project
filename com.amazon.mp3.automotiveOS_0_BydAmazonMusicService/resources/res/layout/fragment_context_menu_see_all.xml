<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/title_background"
        android:background="@color/pressed"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/playlists_container"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/recycler_background"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_background"/>
    <ImageView
        android:id="@+id/action_button_back"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/bauhaus_spacer_base"
        android:layout_marginRight="@dimen/bauhaus_spacer_base"
        android:src="@drawable/ic_action_goback"
        android:layout_marginHorizontal="@dimen/bauhaus_spacer_base"
        app:layout_constraintBottom_toBottomOf="@+id/title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title"/>
    <TextView
        android:textSize="@dimen/action_bar_title_text_size"
        android:textStyle="bold"
        android:textColor="@color/pure_white"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/bauhaus_spacer_base"
        android:layout_marginRight="@dimen/bauhaus_spacer_base"
        android:text="@string/dmusic_context_add_to_playlist"
        android:maxLines="1"
        android:layout_marginHorizontal="@dimen/bauhaus_spacer_base"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/playlists_container"
        android:fadingEdgeLength="@dimen/bauhaus_spacer_epic"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/bauhaus_spacer_base"
        android:layout_marginTop="@dimen/bauhaus_spacer_large"
        android:layout_marginRight="@dimen/bauhaus_spacer_base"
        android:requiresFadingEdge="vertical"
        android:layout_marginHorizontal="@dimen/bauhaus_spacer_base"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"
        app:layout_constraintWidth_default="spread"/>
</androidx.constraintlayout.widget.ConstraintLayout>
