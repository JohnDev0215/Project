<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="top"
        android:id="@+id/now_playing_playback_speed_background"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <ImageView
        android:background="@color/secondary_glass_3"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/margin"
        android:paddingEnd="@dimen/margin"
        android:layout_marginStart="@dimen/gutter"
        android:layout_marginEnd="@dimen/gutter">
        <com.amazon.podcast.views.EmberTextView
            android:gravity="center_vertical"
            android:id="@+id/playback_speed_title"
            android:layout_width="match_parent"
            android:layout_height="@dimen/podcast_playback_speed_item_height"
            android:text="@string/podcast_playback_speed_selection_title"
            android:layout_alignParentTop="true"
            style="@style/PodcastAppTheme.TextView.OverlayTextStyle"/>
        <com.amazon.podcast.views.WrappedListView
            android:id="@+id/playback_speed_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/playback_speed_divider"
            android:layout_below="@+id/playback_speed_title"/>
        <View
            android:id="@+id/playback_speed_divider"
            android:background="@color/primary_glass_2"
            android:layout_width="match_parent"
            android:layout_height="@dimen/podcast_divider_height"
            android:layout_above="@+id/dismiss"/>
        <com.amazon.podcast.views.EmberTextView
            android:gravity="center"
            android:id="@+id/dismiss"
            android:layout_width="match_parent"
            android:layout_height="@dimen/podcast_playback_speed_item_height"
            android:text="@string/podcast_dismiss_label"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            style="@style/PodcastAppTheme.TextView.Primary"/>
    </RelativeLayout>
</RelativeLayout>
