<?xml version="1.0" encoding="utf-8"?>
<com.amazon.podcast.views.transcription.TranscriptCaptionContainer xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center_vertical"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/half_screen_transcript_equalizer"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/podcast_transcript_equalizer_primary"
            android:scaleType="center"
            android:paddingEnd="@dimen/spacer_10"/>
        <ImageView
            android:id="@+id/refresh_half_screen_transcript_equalizer"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/refresh_podcast_transcript_equalizer_primary"
            android:scaleType="center"
            android:paddingEnd="@dimen/spacer_10"
            android:layout_toEndOf="@+id/half_screen_transcript_equalizer"/>
        <com.amazon.podcast.views.EmberTextView
            android:id="@+id/transcript_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.25"
            android:layout_toEndOf="@+id/refresh_half_screen_transcript_equalizer"
            style="@style/PodcastAppTheme.TextView.TranscriptCaptionText"/>
    </RelativeLayout>
</com.amazon.podcast.views.transcription.TranscriptCaptionContainer>
