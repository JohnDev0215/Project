<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/margin"
    android:paddingEnd="@dimen/margin">
    <RelativeLayout
        android:id="@+id/ptc_episodes_header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/podcast_spacer_large"
        android:layout_marginBottom="@dimen/podcast_spacer_large"
        android:layout_alignParentTop="true"
        android:layout_marginStart="@dimen/gutter"
        android:layout_marginEnd="@dimen/gutter"
        app:layout_constraintBottom_toTopOf="@+id/ptc_episodes_scroll"
        app:layout_constraintTop_toTopOf="parent">
        <ImageButton
            android:id="@+id/ptc_episodes_cancel_button"
            android:background="@drawable/button_circle"
            android:padding="@dimen/podcast_spacer_mini"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_podcast_action_cancel"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/ptc_episodes_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/podcast_spacer_base"
        android:layout_marginStart="@dimen/gutter"
        android:layout_marginEnd="@dimen/gutter"
        app:layout_constraintBottom_toTopOf="@+id/podcast_ptc_episodes_footer"
        app:layout_constraintTop_toBottomOf="@+id/ptc_episodes_header_layout">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.amazon.podcast.views.EmberTextView
                android:gravity="start"
                android:id="@+id/podcast_ptc_episodes_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/PodcastAppTheme.TextView.Headline2"/>
            <com.amazon.podcast.views.EmberTextView
                android:gravity="start"
                android:id="@+id/podcast_ptc_episodes_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/podcast_spacer_base"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/podcast_ptc_episodes_title"
                style="@style/PodcastAppTheme.TextView.Secondary"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/podcast_ptc_episodes_recycler_view"
                android:background="@color/transparent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/podcast_spacer_huge"
                android:nestedScrollingEnabled="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/podcast_ptc_episodes_subtitle"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.amazon.podcast.views.EmberTextView
        android:gravity="center"
        android:id="@+id/podcast_ptc_episodes_footer"
        android:layout_width="0dp"
        android:layout_height="@dimen/podcast_button_medium"
        android:layout_marginBottom="@dimen/podcast_spacer_epic"
        android:text="@string/podcast_ptc_lets_get_started"
        android:layout_marginStart="@dimen/gutter"
        android:layout_marginEnd="@dimen/gutter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/PodcastAppTheme.TextView.ButtonMediumSolid"/>
</androidx.constraintlayout.widget.ConstraintLayout>
