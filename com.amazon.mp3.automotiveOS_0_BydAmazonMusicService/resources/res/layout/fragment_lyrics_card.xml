<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/lyrics_card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginLeft="@dimen/spacer_48"
    android:layout_marginRight="@dimen/spacer_48"
    android:foreground="@drawable/lyrics_share_card_border"
    android:layout_centerHorizontal="true"
    android:layout_centerVertical="true"
    app:cardCornerRadius="@dimen/lyrics_card_corner_radius_20">
    <ImageView
        android:id="@+id/card_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/spacer_16"
        android:layout_marginRight="@dimen/spacer_16"
        android:layout_marginBottom="@dimen/spacer_20">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacer_20">
            <ImageView
                android:id="@+id/album_art"
                android:layout_width="@dimen/spacer_40"
                android:layout_height="@dimen/spacer_40"
                android:layout_marginRight="@dimen/spacer_10"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:ellipsize="end"
                    android:id="@+id/track_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:fontFamily="@string/font_sharp_grotesk_semi_bold"/>
                <TextView
                    android:textColor="@color/white"
                    android:ellipsize="end"
                    android:id="@+id/artist_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true">
            <TextView
                android:textSize="@dimen/spacer_20"
                android:textStyle="italic"
                android:textColor="@color/white"
                android:id="@+id/lyrics_line_one"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacer_24"
                android:shadowColor="@color/text_shadow"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:textAlignment="center"
                android:breakStrategy="balanced"
                android:textFontWeight="@dimen/semi_bold"/>
            <TextView
                android:textSize="@dimen/spacer_20"
                android:textStyle="italic"
                android:textColor="@color/white"
                android:id="@+id/lyrics_line_two"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacer_24"
                android:shadowColor="@color/text_shadow"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:textAlignment="center"
                android:breakStrategy="balanced"
                android:textFontWeight="@dimen/semi_bold"/>
            <TextView
                android:textSize="@dimen/spacer_20"
                android:textStyle="italic"
                android:textColor="@color/white"
                android:id="@+id/lyrics_line_three"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:shadowColor="@color/text_shadow"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:textAlignment="center"
                android:breakStrategy="balanced"
                android:textFontWeight="@dimen/semi_bold"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/logo_image"
            android:background="@drawable/amazon_music_logo_white"
            android:layout_width="@dimen/size_100"
            android:layout_height="@dimen/spacer_20"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
</androidx.cardview.widget.CardView>
