<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tile_container"
    android:background="@color/white_04"
    android:padding="@dimen/margin_padding"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/divider"
    android:foreground="@drawable/ripple">
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/deviceTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/margin_padding"
        android:layout_alignParentStart="true"
        style="@style/AmazonMusic.MainText"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/nativeTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/deviceTextView"
        android:paddingStart="@dimen/margin_padding"
        android:layout_alignParentStart="true"
        style="@style/AmazonMusic.LightText"/>
    <ImageView
        android:id="@+id/thumup"
        android:visibility="visible"
        android:layout_width="@dimen/tile_icon_thumb_up_dimension"
        android:layout_height="@dimen/tile_icon_thumb_up_dimension"
        android:src="@drawable/ic_thumb_pref_inactive"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/icon_padding"
        android:layout_alignParentEnd="true"/>
    <ImageView
        android:id="@+id/thumbupHighlighted"
        android:visibility="gone"
        android:layout_width="@dimen/tile_icon_thumb_up_dimension"
        android:layout_height="@dimen/tile_icon_thumb_up_dimension"
        android:src="@drawable/ic_thumb_pref_active"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/icon_padding"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
