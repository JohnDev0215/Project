<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/AlbumArtwork"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_marginLeft="@dimen/small_padding"
        android:layout_marginEnd="@dimen/small_padding"/>
    <RelativeLayout
        android:gravity="center"
        android:id="@+id/ArtworkPlayerControlsFragment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/AlbumArtwork"
        android:layout_alignEnd="@+id/AlbumArtwork"
        style="@style/DetailPlayerControlsContainer"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingEnd="4dp"
        android:layout_toEndOf="@+id/AlbumArtwork">
        <ViewStub
            android:id="@+id/HeaderViewStub"
            android:inflatedId="@+id/HeaderViewStub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.amazon.mp3.view.DragDropListView
            android:id="@+id/ListView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:headerDividersEnabled="false"
            style="@style/ListView"/>
        <TextView
            android:gravity="center"
            android:id="@+id/EmptyView"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/dmusic_playlist_empty"/>
    </LinearLayout>
    <include
        android:layout_width="match_parent"
        android:layout_height="@dimen/libary_loading_footer_height"
        android:layout_alignParentBottom="true"
        layout="@layout/library_listview_loading_footer"/>
</RelativeLayout>
