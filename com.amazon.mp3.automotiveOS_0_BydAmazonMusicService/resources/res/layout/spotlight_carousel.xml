<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/spotlight_carousel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/spotlight_carousel_static_slide_image"
        android:background="@drawable/spotlight_carousel_rounded_image"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="centerCrop"/>
    <ImageView
        android:id="@+id/spotlight_carousel_overlay"
        android:background="@drawable/spotlight_carousel_rounded_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.amazon.music.skyfire.ui.widgets.views.spotlightCarousel.SpotlightCarouselViewPager
        android:id="@+id/spotlight_carousel_view_pager"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ImageButton
        android:id="@+id/spotlight_carousel_left_navigation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/spotlight_carousel_navigation_button_horizontal_padding"
        android:layout_alignParentStart="true"
        style="@style/SpotlightCarouselNavigationItem"/>
    <ImageButton
        android:id="@+id/spotlight_carousel_right_navigation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingEnd="@dimen/spotlight_carousel_navigation_button_horizontal_padding"
        android:layout_alignParentEnd="true"
        style="@style/SpotlightCarouselNavigationItem"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/spotlight_carousel_page_indicator"
        android:paddingBottom="@dimen/spotlight_carousel_pagination_bottom_padding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
