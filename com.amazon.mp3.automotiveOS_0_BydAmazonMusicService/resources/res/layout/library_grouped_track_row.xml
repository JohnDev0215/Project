<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="right"
    android:background="@drawable/selector_item_background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_centerVertical="true">
    <FrameLayout
        android:id="@+id/AlbumArtworkFrame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/screen_margin"
        android:layout_centerVertical="true"
        style="@style/LibraryListItemAlbumArt">
        <ImageView
            android:id="@+id/AlbumArtwork"
            android:layout_width="@dimen/default_listview_art_size"
            android:layout_height="@dimen/default_listview_art_size"
            android:src="@drawable/placeholder_sm"/>
        <View
            android:id="@+id/AlbumArtTouchOverlay"
            android:background="@drawable/selector_artwork_mask"
            android:layout_width="@dimen/default_listview_art_size"
            android:layout_height="@dimen/default_listview_art_size"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/PlaystateIcon"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/mp3_icon_songplaying_paused"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/TrackCountPlayStateFrame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@+id/AlbumArtworkFrame"
        android:layout_centerVertical="true">
        <LinearLayout
            android:layout_gravity="right"
            android:orientation="vertical"
            android:id="@+id/TrackCountLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/Textlayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toLeftOf="@+id/BadgeContainer"
        android:layout_toRightOf="@+id/TrackCountPlayStateFrame"
        android:layout_centerVertical="true">
        <LinearLayout
            android:gravity="left"
            android:orientation="horizontal"
            android:id="@+id/PrimaryTextlayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:ellipsize="end"
                android:id="@+id/PrimaryTitleTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:drawablePadding="@dimen/small_padding"
                style="@style/LibraryListItemPrimaryText"/>
        </LinearLayout>
        <TextView
            android:ellipsize="end"
            android:id="@+id/SecondaryTitleTextView"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            style="@style/LibraryListItemSecondaryText"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.amazon.mp3.view.BadgeView
                android:id="@+id/KatanaBadge"
                android:layout_marginRight="@dimen/spacing_4dp"
                style="@style/ContentEncodingBadge"/>
            <com.amazon.mp3.view.BadgeView
                android:id="@+id/ImmersiveBadge"
                android:layout_marginRight="@dimen/spacing_4dp"
                style="@style/ContentEncodingBadge"/>
            <com.amazon.mp3.view.BadgeView
                android:id="@+id/LyricsView"
                android:text="@string/dmusic_lyrics_listview_badge"
                android:contentDescription="@string/dmusic_lyrics_listview_badge"
                style="@style/ContentEncodingBadge"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/BadgeContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toLeftOf="@+id/overflow_button_open"
        android:layout_centerVertical="true">
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/Duration"
            android:paddingLeft="@dimen/listview_horizontal_padding"
            android:paddingRight="@dimen/listview_horizontal_padding"
            android:layout_width="@dimen/library_duration_width"
            android:layout_height="@dimen/download_circular_progress_bar_width"
            android:singleLine="true"
            style="@style/LibraryListItemSecondaryText"/>
        <com.amazon.mp3.view.DownloadProgressBadgeView
            android:id="@+id/DownloadProgress"
            android:visibility="gone"
            android:layout_width="@dimen/download_circular_progress_bar_width"
            android:layout_height="@dimen/download_circular_progress_bar_width"
            android:layout_marginLeft="@dimen/standard_padding"/>
        <ImageView
            android:id="@+id/missing_sd_card"
            android:visibility="gone"
            android:layout_width="@dimen/download_circular_progress_bar_width"
            android:layout_height="@dimen/download_circular_progress_bar_width"
            android:layout_marginLeft="@dimen/standard_padding"
            android:src="@drawable/sd_card_missing"
            android:scaleType="center"
            android:contentDescription="@string/sd_card_not_found_dialog_title"/>
        <include
            android:layout_gravity="center"
            android:id="@+id/station_icon"
            android:visibility="gone"
            android:layout_width="@dimen/overflow_button_clickable_size"
            android:layout_height="@dimen/overflow_button_clickable_size"
            layout="@layout/track_row_station_icon"/>
    </LinearLayout>
    <include
        android:id="@+id/overflow_button_open"
        android:layout_width="@dimen/overflow_button_clickable_size"
        android:layout_height="@dimen/overflow_button_clickable_size"
        android:layout_marginRight="@dimen/screen_margin"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        layout="@layout/overflow_button"/>
</RelativeLayout>
