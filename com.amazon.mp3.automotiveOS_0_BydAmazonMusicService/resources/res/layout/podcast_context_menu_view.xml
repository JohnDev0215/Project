<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/podcast_context_menu_layout"
    android:background="@color/podcast_overlay_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:orientation="vertical"
        android:id="@+id/podcast_overlay_context_menu_container_top_stroke"
        android:background="@color/primary_glass_3"
        android:layout_width="match_parent"
        android:layout_height="@dimen/podcast_divider_height"
        android:layout_alignParentTop="true"/>
    <RelativeLayout
        android:id="@+id/podcast_context_menu_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/podcast_overlay_context_menu_container_top_stroke"
        android:paddingStart="@dimen/gutter"
        android:paddingEnd="@dimen/gutter"
        android:layout_marginStart="@dimen/margin"
        android:layout_marginEnd="@dimen/margin">
        <ImageView
            android:id="@+id/podcast_context_menu_image"
            android:visibility="gone"
            android:layout_width="@dimen/podcast_horizontal_row_item_image_dimension"
            android:layout_height="@dimen/podcast_horizontal_row_item_image_dimension"
            android:layout_marginTop="@dimen/podcast_spacer_medium"
            android:layout_alignParentStart="true"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/podcast_context_menu_text"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/podcast_context_menu_image"
            android:layout_alignBottom="@+id/podcast_context_menu_image"
            android:layout_marginStart="@dimen/podcast_spacer_base"
            android:layout_toEndOf="@+id/podcast_context_menu_image">
            <com.amazon.podcast.views.EmberTextView
                android:ellipsize="end"
                android:id="@+id/podcast_context_menu_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                style="@style/PodcastAppTheme.TextView.Primary"/>
            <com.amazon.podcast.views.EmberTextView
                android:ellipsize="end"
                android:id="@+id/podcast_context_menu_sub_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                style="@style/PodcastAppTheme.TextView.Secondary"/>
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/podcast_context_menu_items_recycler_view"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/podcast_spacer_medium"
            android:layout_below="@+id/podcast_context_menu_image"/>
    </RelativeLayout>
    <com.amazon.podcast.views.EmberTextView
        android:gravity="center"
        android:id="@+id/podcast_context_menu_dismiss"
        android:layout_width="match_parent"
        android:layout_height="@dimen/podcast_playback_speed_item_height"
        android:layout_marginTop="@dimen/podcast_spacer_small"
        android:text="@string/podcast_dismiss_label"
        android:layout_below="@+id/podcast_context_menu_container"
        style="@style/PodcastAppTheme.TextView.Primary"/>
    <View
        android:id="@+id/podcast_pop_up_context_menu_bottom_spacer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/podcast_spacer_medium"
        android:layout_below="@+id/podcast_context_menu_container"/>
</RelativeLayout>
