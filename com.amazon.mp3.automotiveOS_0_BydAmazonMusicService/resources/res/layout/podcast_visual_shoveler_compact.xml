<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/visual_shoveler_compact_view"
    android:paddingTop="@dimen/podcast_spacer_large"
    android:paddingBottom="@dimen/podcast_spacer_large"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/visual_shoveler_compact_header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/podcast_spacer_large"
        android:paddingStart="@dimen/margin"
        android:paddingEnd="@dimen/margin">
        <com.amazon.podcast.views.EmberTextView
            android:gravity="center"
            android:id="@+id/visual_shoveler_see_all_button"
            android:layout_height="@dimen/podcast_button_small"
            android:layout_alignParentTop="true"
            android:layout_marginStart="@dimen/podcast_spacer_base"
            android:layout_marginEnd="@dimen/gutter"
            android:layout_alignParentEnd="true"
            style="@style/PodcastAppTheme.TextView.ButtonSmallGlass"/>
        <com.amazon.podcast.views.EmberTextView
            android:id="@+id/visual_shoveler_compact_header"
            android:maxLines="2"
            android:layout_marginStart="@dimen/gutter"
            android:layout_toStartOf="@+id/visual_shoveler_see_all_button"
            android:layout_alignParentStart="true"
            style="@style/PodcastAppTheme.TextView.Headline4"/>
    </RelativeLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/visual_shoveler_compact_recycler_view"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_below="@+id/visual_shoveler_compact_header_layout"
        android:layout_marginStart="@dimen/margin"/>
</RelativeLayout>
