<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/messaging_dialog_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.amazon.ui.foundations.views.BaseButton
        android:id="@+id/bauhausNowPlayingNonBlockingButton"
        android:paddingTop="@dimen/spacer_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/closeButton"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/bauhausNowPlayingNonBlockingTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bauhausNowPlayingNonBlockingHeader"/>
    <TextView
        android:id="@+id/bauhausNowPlayingNonBlockingHeader"
        android:paddingTop="@dimen/spacer_16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.amazon.ui.foundations.views.BaseButton
        android:id="@+id/closeButton"
        android:paddingTop="@dimen/spacer_16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
