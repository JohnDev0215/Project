<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/edit_main_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/base_edit_tool"
        android:background="?attr/img_edit_tool_bg"
        android:paddingLeft="@dimen/image_edit_tool_horizontal_padding"
        android:paddingRight="@dimen/image_edit_tool_horizontal_padding"
        android:layout_width="match_parent"
        android:layout_height="@dimen/image_edit_tool_size">
        <ImageView
            android:id="@+id/btn_cancel"
            android:layout_width="@dimen/dp_36"
            android:layout_height="@dimen/dp_36"
            android:src="@drawable/icon_cancel"/>
        <View
            android:id="@+id/line_left"
            android:background="?attr/line_color"
            android:visibility="gone"
            android:layout_width="@dimen/dp_1"
            android:layout_height="@dimen/dp_24"
            android:layout_marginLeft="@dimen/dp_10"
            android:layout_marginRight="@dimen/dp_10"/>
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/edit_fun_group"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <androidx.recyclerview.widget.RecyclerView
                android:layout_gravity="center"
                android:id="@+id/recycler_edit_items"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_72"/>
        </FrameLayout>
        <View
            android:id="@+id/line_right"
            android:background="?attr/line_color"
            android:visibility="gone"
            android:layout_width="@dimen/dp_1"
            android:layout_height="@dimen/dp_24"
            android:layout_marginLeft="@dimen/dp_10"
            android:layout_marginRight="@dimen/dp_10"/>
        <ImageView
            android:id="@+id/btn_sure"
            android:layout_width="@dimen/dp_36"
            android:layout_height="@dimen/dp_36"
            android:src="@drawable/icon_edit_sure"/>
    </LinearLayout>
</LinearLayout>
