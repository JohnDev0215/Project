<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.byd.view.TabGroup
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/tab_group"
        android:background="?attr/tab_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tab_size">
        <com.byd.view.TabItemLinearContainer
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/tab_image"
            android:background="?attr/tab_selected_bg"
            android:layout_width="@dimen/dp_96"
            android:layout_height="match_parent">
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/anim_image"
                android:layout_width="@dimen/dp_36"
                android:layout_height="@dimen/dp_36"
                app:lottie_autoPlay="true"
                app:lottie_loop="false"/>
            <com.byd.view.TabItem
                android:id="@+id/tab_text_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:text="@string/tab_image"
                app:textColor="@color/tab_text_color"
                app:textSize="@dimen/tab_text_size"/>
        </com.byd.view.TabItemLinearContainer>
        <com.byd.view.TabItemLinearContainer
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/tab_album"
            android:background="?attr/tab_selected_bg"
            android:layout_width="@dimen/dp_96"
            android:layout_height="match_parent">
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/anim_album"
                android:layout_width="@dimen/dp_36"
                android:layout_height="@dimen/dp_36"
                app:lottie_autoPlay="true"
                app:lottie_loop="false"/>
            <com.byd.view.TabItem
                android:id="@+id/tab_text_album"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:text="@string/tab_album"
                app:textColor="@color/tab_text_color"
                app:textSize="@dimen/tab_text_size"/>
        </com.byd.view.TabItemLinearContainer>
    </com.byd.view.TabGroup>
    <View
        android:id="@+id/tab_shadow"
        android:background="?attr/tab_shadow"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_36"
        android:layout_below="@+id/tab_group"/>
    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tab_group"
        android:layout_alignParentBottom="true"/>
    <FrameLayout
        android:id="@+id/content_second_level"
        android:background="?attr/bg_content"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:longClickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tab_group"
        android:layout_alignParentBottom="true"/>
    <FrameLayout
        android:id="@+id/content_second_full_level"
        android:background="?attr/bg_content"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:longClickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</RelativeLayout>
