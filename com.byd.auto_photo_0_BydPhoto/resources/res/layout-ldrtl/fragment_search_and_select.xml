<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="@dimen/search_or_tool_bar_height_photo3"
    android:layoutDirection="ltr">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/layout_select"
        android:paddingTop="@dimen/dp_5"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/content_padding"
        android:paddingEnd="@dimen/content_padding">
        <TextView
            android:textSize="@dimen/search_item_text_size"
            android:textColor="@color/color_for_press"
            android:gravity="center_vertical"
            android:id="@+id/btn_cancel_select_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel"
            android:drawablePadding="@dimen/dp_3"/>
        <TextView
            android:textSize="@dimen/search_item_text_size"
            android:textColor="?attr/text_color_press"
            android:gravity="center_vertical"
            android:id="@+id/tv_current_select_num"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_18"
            android:text="@string/cancel"/>
        <Space
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/search_item_text_size"
            android:textColor="@color/color_for_press"
            android:id="@+id/btn_select_all"
            android:layout_width="@dimen/tool_item_size"
            android:layout_height="@dimen/tool_item_size"/>
        <TextView
            android:textSize="@dimen/search_item_text_size"
            android:textColor="@color/color_for_press"
            android:id="@+id/btn_share"
            android:visibility="gone"
            android:layout_width="@dimen/tool_item_size"
            android:layout_height="@dimen/tool_item_size"
            android:layout_marginStart="@dimen/search_item_margin"/>
        <TextView
            android:textSize="@dimen/search_item_text_size"
            android:textColor="@color/color_for_press"
            android:id="@+id/btn_delete"
            android:layout_width="@dimen/tool_item_size"
            android:layout_height="@dimen/tool_item_size"
            android:layout_marginStart="@dimen/search_item_margin"/>
        <TextView
            android:textSize="@dimen/search_item_text_size"
            android:textColor="@color/color_for_press"
            android:id="@+id/btn_rename"
            android:layout_width="@dimen/tool_item_size"
            android:layout_height="@dimen/tool_item_size"
            android:layout_marginStart="@dimen/search_item_margin"/>
        <TextView
            android:textSize="@dimen/search_item_text_size"
            android:textColor="@color/color_for_press"
            android:id="@+id/btn_move"
            android:visibility="gone"
            android:layout_width="@dimen/tool_item_size"
            android:layout_height="@dimen/tool_item_size"
            android:layout_marginStart="@dimen/search_item_margin"/>
        <TextView
            android:textSize="@dimen/search_item_text_size"
            android:textColor="@color/color_for_press"
            android:id="@+id/btn_copy"
            android:visibility="gone"
            android:layout_width="@dimen/tool_item_size"
            android:layout_height="@dimen/tool_item_size"/>
        <TextView
            android:textSize="@dimen/search_item_text_size"
            android:textColor="@color/color_for_press"
            android:id="@+id/btn_select_cancel"
            android:layout_width="@dimen/tool_item_size"
            android:layout_height="@dimen/tool_item_size"
            android:layout_marginStart="@dimen/search_item_margin"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/layout_search"
        android:visibility="gone"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/content_padding"
        android:paddingEnd="@dimen/content_padding">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/search_input_container"
                android:background="?attr/bg_search_input"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_36"
                android:layout_marginTop="@dimen/dp_3"
                android:layout_weight="1"
                android:layoutDirection="rtl"
                android:layout_marginStart="@dimen/search_page_input_margin_left"
                android:layout_marginEnd="@dimen/search_page_input_margin_right">
                <ImageView
                    android:id="@+id/iv_search_icon"
                    android:layout_width="@dimen/dp_36"
                    android:layout_height="@dimen/dp_36"
                    android:src="?attr/icon_search"
                    android:layout_marginStart="@dimen/dp_6"/>
                <EditText
                    android:textSize="@dimen/sp_12"
                    android:textColor="?attr/search_input_text_color"
                    android:textColorHighlight="?attr/text_color_press"
                    android:textColorHint="?attr/search_hint_text_color"
                    android:gravity="center_vertical"
                    android:id="@+id/et_search_word"
                    android:background="@null"
                    android:paddingTop="@dimen/dp_3"
                    android:paddingBottom="@dimen/dp_3"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:hint="@string/search_tips"
                    android:singleLine="true"
                    android:layout_weight="1"
                    android:inputType="textCapSentences"
                    android:imeOptions="actionSearch"
                    android:textSelectHandleLeft="@drawable/text_select_handle_left_material"
                    android:textSelectHandleRight="@drawable/text_select_handle_right_material"
                    android:textSelectHandle="@drawable/text_select_handle_middle_material"
                    android:textCursorDrawable="@drawable/color_photo3_cursor"
                    android:paddingStart="@dimen/dp_5"
                    android:paddingEnd="@dimen/dp_5"
                    android:importantForAutofill="no"/>
                <ProgressBar
                    android:id="@+id/progress_search"
                    android:visibility="gone"
                    android:layout_width="@dimen/dp_18"
                    android:layout_height="@dimen/dp_18"
                    android:indeterminateDrawable="@drawable/progress_search_drawable"
                    android:layout_marginEnd="@dimen/dp_10"/>
                <ImageView
                    android:id="@+id/view_cancel_search"
                    android:visibility="gone"
                    android:layout_width="@dimen/dp_36"
                    android:layout_height="@dimen/dp_36"
                    android:src="?attr/icon_clear_input"/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/color_for_press"
                android:gravity="center"
                android:id="@+id/btn_to_select"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/sort"
                android:layout_marginStart="@dimen/dp_15"
                android:layout_marginEnd="@dimen/dp_20"/>
            <TextView
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_to_search_mode"
                android:layout_width="@dimen/dp_36"
                android:layout_height="@dimen/dp_36"
                android:drawableStart="?attr/icon_search"/>
            <TextView
                android:layout_gravity="center_vertical"
                android:id="@+id/btn_about"
                android:layout_width="@dimen/dp_36"
                android:layout_height="@dimen/dp_36"
                android:drawableStart="@drawable/icon_detail"
                android:layout_marginStart="@dimen/dp_24"/>
        </LinearLayout>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/view_exit_search_mode"
            android:visibility="gone"
            android:layout_width="@dimen/dp_36"
            android:layout_height="@dimen/dp_36"
            android:src="?attr/icon_back"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/layout_title"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/content_padding"
        android:paddingEnd="@dimen/content_padding">
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/color_for_press"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/tv_title_back"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_36"
            android:text="返回"
            android:lines="1"
            android:drawableStart="?attr/icon_back"
            android:layout_marginStart="@dimen/dp_m_6"/>
        <Space
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/text_color_secondary_ui3"
            android:gravity="center"
            android:id="@+id/btn_title_to_select"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/sort"
            android:drawablePadding="@dimen/dp_5"/>
    </LinearLayout>
</FrameLayout>
