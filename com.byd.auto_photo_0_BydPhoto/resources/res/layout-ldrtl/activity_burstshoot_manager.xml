<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:layout_gravity="center_vertical"
            android:id="@+id/recycler_big_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_small_size"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <RelativeLayout
        android:id="@+id/burst_footer_view"
        android:background="?attr/img_edit_tool_bg"
        android:paddingLeft="@dimen/burst_manager_tool_horizontal_padding"
        android:paddingRight="@dimen/burst_manager_tool_horizontal_padding"
        android:layout_width="match_parent"
        android:layout_height="@dimen/image_edit_tool_size"
        android:layout_marginTop="@dimen/dp_20"
        android:layoutDirection="ltr">
        <TextView
            android:id="@+id/btn_cancel"
            android:background="@drawable/icon_cancel"
            android:layout_width="@dimen/dp_36"
            android:layout_height="@dimen/dp_36"
            android:layout_centerVertical="true"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <TextView
                android:textSize="@dimen/sp_15"
                android:textColor="?attr/text_color"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/selected"/>
            <TextView
                android:textSize="@dimen/sp_15"
                android:textColor="#ff00aceb"
                android:id="@+id/tv_select_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@string/font_family"/>
            <TextView
                android:textSize="@dimen/sp_15"
                android:textColor="?attr/text_color"
                android:id="@+id/tv_pieces"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pieces"/>
        </LinearLayout>
        <TextView
            android:enabled="false"
            android:id="@+id/btn_save"
            android:background="@drawable/icon_edit_sure"
            android:layout_width="@dimen/dp_36"
            android:layout_height="@dimen/dp_36"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</LinearLayout>
