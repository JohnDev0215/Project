<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.byd.view.ColorPickerView
        android:id="@+id/iv_color_picker_view"
        android:layout_width="150dp"
        android:layout_height="150dp"/>
    <TextView
        android:textSize="20sp"
        android:textColor="#ffffffff"
        android:id="@+id/tv_red_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="R"
        android:layout_marginStart="5dp"
        android:layout_toEndOf="@+id/iv_color_picker_view"/>
    <TextView
        android:textSize="20sp"
        android:textColor="#ffffffff"
        android:id="@+id/tv_red"
        android:background="#ff121212"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:text="0"
        android:layout_alignBottom="@+id/tv_red_tips"
        android:paddingStart="5dp"
        android:layout_marginStart="5dp"
        android:layout_toEndOf="@+id/tv_red_tips"/>
    <TextView
        android:textSize="20sp"
        android:textColor="#ffffffff"
        android:id="@+id/tv_green_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="G"
        android:layout_below="@+id/tv_red_tips"
        android:layout_toEndOf="@+id/iv_color_picker_view"
        android:layout_alignStart="@+id/tv_red_tips"/>
    <TextView
        android:textSize="20sp"
        android:textColor="#ffffffff"
        android:id="@+id/tv_green"
        android:background="#ff121212"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:text="0"
        android:layout_alignBottom="@+id/tv_green_tips"
        android:paddingStart="5dp"
        android:layout_marginStart="5dp"
        android:layout_toEndOf="@+id/tv_green_tips"/>
    <TextView
        android:textSize="20sp"
        android:textColor="#ffffffff"
        android:id="@+id/tv_blue_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="B"
        android:layout_below="@+id/tv_green_tips"
        android:layout_toEndOf="@+id/iv_color_picker_view"
        android:layout_alignStart="@+id/tv_red_tips"/>
    <TextView
        android:textSize="20sp"
        android:textColor="#ffffffff"
        android:id="@+id/tv_blue"
        android:background="#ff121212"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:text="0"
        android:layout_alignBottom="@+id/tv_blue_tips"
        android:paddingStart="5dp"
        android:layout_marginStart="5dp"
        android:layout_toEndOf="@+id/tv_blue_tips"/>
    <View
        android:id="@+id/view_effect"
        android:background="#ff000000"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_below="@+id/tv_blue_tips"
        android:layout_alignBottom="@+id/iv_color_picker_view"
        android:layout_marginStart="5dp"
        android:layout_toEndOf="@+id/iv_color_picker_view"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
