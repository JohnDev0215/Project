<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/bg_share_to_other_dev"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_54">
        <TextView
            android:textSize="@dimen/sp_15"
            android:textColor="?attr/text_color"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_more_dev_share"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/view_close"
            android:layout_width="@dimen/dp_36"
            android:layout_height="@dimen/dp_36"
            android:src="@drawable/icon_cancel"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/dp_12"
            android:layout_alignParentStart="true"/>
    </RelativeLayout>
    <com.byd.share.DragToShareContainer
        android:id="@+id/drag_share_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/dev_ivi"
            android:background="@drawable/bg_dev_screen"
            android:layout_width="@dimen/share_screen_width"
            android:layout_height="@dimen/share_screen_height"
            android:layout_marginTop="@dimen/dp_54">
            <com.byd.view.XRoundCornerImageView
                android:layout_gravity="center"
                android:layout_width="@dimen/share_screen_img_width"
                android:layout_height="@dimen/share_screen_img_height"
                android:scaleType="centerCrop"
                app:radius="3dp"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_ivi_disable"
                android:visibility="gone"
                android:layout_width="@dimen/dp_36"
                android:layout_height="@dimen/dp_36"/>
        </FrameLayout>
        <FrameLayout
            android:layout_gravity="right"
            android:id="@+id/dev_fse"
            android:background="@drawable/bg_dev_screen"
            android:layout_width="@dimen/share_screen_width"
            android:layout_height="@dimen/share_screen_height"
            android:layout_marginTop="@dimen/dp_54"
            android:layout_marginRight="@dimen/dp_60">
            <com.byd.view.XRoundCornerImageView
                android:layout_gravity="center"
                android:layout_width="@dimen/share_screen_img_width"
                android:layout_height="@dimen/share_screen_img_height"
                android:scaleType="centerCrop"
                app:radius="3dp"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_fse_disable"
                android:visibility="gone"
                android:layout_width="@dimen/dp_36"
                android:layout_height="@dimen/dp_36"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/dev_left_rse"
            android:background="@drawable/bg_dev_screen"
            android:layout_width="@dimen/share_screen_width"
            android:layout_height="@dimen/share_screen_height"
            android:layout_marginLeft="@dimen/dp_45"
            android:layout_marginTop="@dimen/dp_156">
            <com.byd.view.XRoundCornerImageView
                android:layout_gravity="center"
                android:layout_width="@dimen/share_screen_img_width"
                android:layout_height="@dimen/share_screen_img_height"
                android:scaleType="centerCrop"
                app:radius="3dp"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_left_rse_disable"
                android:visibility="gone"
                android:layout_width="@dimen/dp_36"
                android:layout_height="@dimen/dp_36"/>
        </FrameLayout>
        <FrameLayout
            android:layout_gravity="right"
            android:id="@+id/dev_right_rse"
            android:background="@drawable/bg_dev_screen"
            android:layout_width="@dimen/share_screen_width"
            android:layout_height="@dimen/share_screen_height"
            android:layout_marginTop="@dimen/dp_156"
            android:layout_marginRight="@dimen/dp_45">
            <com.byd.view.XRoundCornerImageView
                android:layout_gravity="center"
                android:layout_width="@dimen/share_screen_img_width"
                android:layout_height="@dimen/share_screen_img_height"
                android:scaleType="centerCrop"
                app:radius="3dp"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_right_rse_disable"
                android:visibility="gone"
                android:layout_width="@dimen/dp_36"
                android:layout_height="@dimen/dp_36"/>
        </FrameLayout>
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/dev_tv"
            android:background="@drawable/bg_dev_screen"
            android:layout_width="@dimen/share_screen_width"
            android:layout_height="@dimen/share_screen_height"
            android:layout_marginTop="@dimen/dp_176">
            <com.byd.view.XRoundCornerImageView
                android:layout_gravity="center"
                android:layout_width="@dimen/share_screen_img_width"
                android:layout_height="@dimen/share_screen_img_height"
                android:scaleType="centerCrop"
                app:radius="3dp"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_tv_disable"
                android:visibility="gone"
                android:layout_width="@dimen/dp_36"
                android:layout_height="@dimen/dp_36"/>
        </FrameLayout>
        <com.byd.view.XRoundCornerImageView
            android:layout_gravity="center"
            android:id="@+id/view_drag_image"
            android:layout_width="@dimen/share_screen_img_width"
            android:layout_height="@dimen/share_screen_img_height"
            android:scaleType="centerCrop"
            app:radius="3dp"/>
    </com.byd.share.DragToShareContainer>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="?attr/text_color"
        android:id="@+id/tv_tips_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_12"
        android:text="@string/tips_more_dev_share"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
    <RelativeLayout
        android:id="@+id/container_guide"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:longClickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_width="@dimen/dp_135"
            android:layout_height="@dimen/dp_135"
            android:layout_marginTop="@dimen/dp_80"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="@dimen/sp_13"
            android:id="@+id/tv_share_more_dev_guide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_180"
            android:text="@string/share_more_dev_guide"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@+id/btn_guide_read"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dialog_button_height"
            android:layout_marginBottom="@dimen/dp_40"
            android:minWidth="@dimen/dialog_button_width"
            android:text="@string/get_it"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
</RelativeLayout>
