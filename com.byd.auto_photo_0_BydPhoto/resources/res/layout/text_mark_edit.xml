<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="?attr/add_text_window_bg"
    android:padding="10dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <EditText
        android:textSize="@dimen/add_text_et_text_size"
        android:textColor="#ffff0000"
        android:textColorHighlight="?attr/text_select_color"
        android:textColorHint="?attr/search_hint_text_color"
        android:gravity="top|left"
        android:id="@+id/et_text"
        android:background="?attr/add_text_input_bg"
        android:padding="@dimen/dp_10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/watermark_edittext_top_margin"
        android:cursorVisible="true"
        android:maxLines="2"
        android:layout_alignParentTop="true"
        android:textSelectHandleLeft="@drawable/text_select_handle_left_material"
        android:textSelectHandleRight="@drawable/text_select_handle_right_material"
        android:textSelectHandle="@drawable/text_select_handle_middle_material"
        android:textCursorDrawable="@drawable/color_photo3_cursor"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/add_text_btn_size"
        android:layout_marginBottom="@dimen/dp_17"
        android:layout_alignParentBottom="true">
        <ImageView
            android:id="@+id/btn_text_edit_cancel"
            android:layout_width="@dimen/add_text_btn_size"
            android:layout_height="@dimen/add_text_btn_size"
            android:src="@drawable/icon_cancel"/>
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_paint_color"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"/>
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/btn_text_edit_sure"
            android:layout_width="@dimen/add_text_btn_size"
            android:layout_height="@dimen/add_text_btn_size"
            android:src="@drawable/icon_edit_sure"/>
    </LinearLayout>
</RelativeLayout>
