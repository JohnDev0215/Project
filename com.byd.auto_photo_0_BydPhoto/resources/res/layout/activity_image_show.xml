<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/image_show_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">
    <com.byd.view.XScaleImageViewPager
        android:id="@+id/m_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/pager_super_much_loading"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/full_show_title_container"
        android:background="@drawable/shadow_top"
        android:layout_width="match_parent"
        android:layout_height="@dimen/full_title_height"
        android:paddingStart="@dimen/title_content_padding"
        android:paddingEnd="@dimen/title_content_padding">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_45">
            <ImageView
                android:id="@+id/iv_full_show_close"
                android:layout_width="@dimen/dp_36"
                android:layout_height="@dimen/dp_36"
                android:src="@drawable/icon_back_night"/>
            <TextView
                android:textSize="@dimen/sp_15"
                android:textColor="@color/text_color_night"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/tv_full_show_title"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:lines="1"
                android:layout_weight="1"
                android:fontFamily="@string/font_family"/>
            <TextView
                android:textSize="@dimen/image_show_item_text_size"
                android:textColor="#d9dae1eb"
                android:gravity="center"
                android:id="@+id/btn_back"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_29"
                android:minWidth="@dimen/dp_79"
                android:layout_marginEnd="@dimen/dp_8"/>
        </LinearLayout>
    </FrameLayout>
    <HorizontalScrollView
        android:id="@+id/img_show_tool_layout"
        android:background="@drawable/shadow_bottom"
        android:paddingBottom="@dimen/dp_15"
        android:layout_width="match_parent"
        android:layout_height="@dimen/footer_tools_height"
        android:layout_alignParentBottom="true"
        android:paddingStart="@dimen/dp_30"
        android:paddingEnd="@dimen/dp_30">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <Space
                android:id="@+id/space_set_wallpaper"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="1dp"/>
            <TextView
                android:textSize="@dimen/image_show_item_text_size"
                android:gravity="center"
                android:id="@+id/btn_set_wall_paper"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/image_show_func_item_min_width"
                android:text="@string/set_wall_paper"
                android:drawablePadding="@dimen/image_show_item_drawable_padding"/>
            <Space
                android:id="@+id/space_rename"
                android:layout_width="@dimen/image_show_item_spacing"
                android:layout_height="1dp"/>
            <TextView
                android:textSize="@dimen/image_show_item_text_size"
                android:gravity="center"
                android:id="@+id/btn_rename"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/image_show_func_item_min_width"
                android:text="@string/rename"
                android:drawablePadding="@dimen/image_show_item_drawable_padding"/>
            <Space
                android:id="@+id/space_edit"
                android:layout_width="@dimen/image_show_item_spacing"
                android:layout_height="1dp"/>
            <TextView
                android:textSize="@dimen/image_show_item_text_size"
                android:gravity="center"
                android:id="@+id/btn_edit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/image_show_func_item_min_width"
                android:text="@string/edit"
                android:drawablePadding="@dimen/image_show_item_drawable_padding"/>
            <Space
                android:layout_width="@dimen/image_show_item_spacing"
                android:layout_height="1dp"/>
            <TextView
                android:textSize="@dimen/image_show_item_text_size"
                android:gravity="center"
                android:id="@+id/btn_collect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/image_show_func_item_min_width"
                android:text="@string/collect"
                android:drawablePadding="@dimen/image_show_item_drawable_padding"/>
            <Space
                android:id="@+id/space_expand"
                android:visibility="gone"
                android:layout_width="@dimen/image_show_item_spacing"
                android:layout_height="1dp"/>
            <TextView
                android:textSize="@dimen/image_show_item_text_size"
                android:id="@+id/btn_expand"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/expand"
                android:drawablePadding="@dimen/image_show_item_drawable_padding"/>
            <Space
                android:id="@+id/spacing_share"
                android:visibility="gone"
                android:layout_width="@dimen/image_show_item_spacing"
                android:layout_height="1dp"/>
            <TextView
                android:textSize="@dimen/image_show_item_text_size"
                android:gravity="center"
                android:id="@+id/btn_share"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/image_show_func_item_min_width"
                android:text="@string/share"
                android:drawablePadding="@dimen/image_show_item_drawable_padding"/>
            <Space
                android:layout_width="@dimen/image_show_item_spacing"
                android:layout_height="1dp"/>
            <TextView
                android:textSize="@dimen/image_show_item_text_size"
                android:gravity="center"
                android:id="@+id/btn_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/image_show_func_item_min_width"
                android:text="@string/detail"
                android:drawablePadding="@dimen/image_show_item_drawable_padding"/>
            <Space
                android:layout_width="@dimen/image_show_item_spacing"
                android:layout_height="1dp"/>
            <TextView
                android:textSize="@dimen/image_show_item_text_size"
                android:gravity="center"
                android:id="@+id/btn_delete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/image_show_func_item_min_width"
                android:text="@string/delete"
                android:drawablePadding="@dimen/image_show_item_drawable_padding"/>
        </LinearLayout>
    </HorizontalScrollView>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_indicator"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_60"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
