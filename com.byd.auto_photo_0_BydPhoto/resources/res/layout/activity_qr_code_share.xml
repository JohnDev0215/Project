<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingBottom="@dimen/dp_20"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">
    <RelativeLayout
        android:id="@+id/container_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dialog_title_height">
        <TextView
            android:textSize="@dimen/dialog_title_text_size"
            android:gravity="center"
            android:id="@+id/tv_dialog_title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="提示"/>
        <ImageView
            android:id="@+id/iv_dialog_title_close"
            android:layout_width="@dimen/dp_36"
            android:layout_height="@dimen/dp_36"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/dp_12"/>
    </RelativeLayout>
    <View
        android:id="@+id/line_below_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0_5"
        android:layout_marginBottom="@dimen/dp_16_5"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/container_qr_code"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/dp_36"
                android:layout_marginEnd="@dimen/dp_30">
                <com.byd.view.XRoundCornerImageView
                    android:id="@+id/iv_qr_code"
                    android:layout_width="@dimen/dp_94"
                    android:layout_height="@dimen/dp_94"
                    app:radius="@dimen/dp_4"
                    app:round_bg_color="#ffffffff"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp_18">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="@dimen/sp_13"
                            android:textColor="#dae1eb"
                            android:gravity="center"
                            android:background="@drawable/bg_serial_number"
                            android:layout_width="@dimen/dp_20"
                            android:layout_height="@dimen/dp_20"
                            android:text="1"/>
                        <TextView
                            android:textSize="@dimen/sp_13"
                            android:textColor="?attr/text_color"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/qr_code_tips_1"
                            android:layout_marginStart="@dimen/dp_9"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_12">
                        <TextView
                            android:textSize="@dimen/sp_13"
                            android:textColor="#dae1eb"
                            android:gravity="center"
                            android:background="@drawable/bg_serial_number"
                            android:layout_width="@dimen/dp_20"
                            android:layout_height="@dimen/dp_20"
                            android:text="2"/>
                        <TextView
                            android:textSize="@dimen/sp_13"
                            android:textColor="?attr/text_color"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/qr_code_tips_2"
                            android:layout_marginStart="@dimen/dp_9"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_12">
                        <TextView
                            android:textSize="@dimen/sp_13"
                            android:textColor="#dae1eb"
                            android:gravity="center"
                            android:background="@drawable/bg_serial_number"
                            android:layout_width="@dimen/dp_20"
                            android:layout_height="@dimen/dp_20"
                            android:text="3"/>
                        <TextView
                            android:textSize="@dimen/sp_13"
                            android:textColor="?attr/text_color"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/qr_code_tips_3"
                            android:layout_marginStart="@dimen/dp_9"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/sp_12"
                android:id="@+id/qr_share_tips_extras"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_20"
                android:text="@string/qr_code_tips_extras"/>
            <TextView
                android:textSize="@dimen/sp_13"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/btn_to_hotpot"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_36"
                android:text="@string/show_hotpot_info"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/container_wifi_info"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_73_5"
                android:layout_marginStart="@dimen/dp_18"
                android:layout_marginEnd="@dimen/dp_18">
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/dp_10"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="?attr/text_color"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/wifi_name"/>
                    <TextView
                        android:textSize="@dimen/sp_15"
                        android:textColor="?attr/text_color"
                        android:id="@+id/tv_wifi_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_3"
                        android:text="--"/>
                </LinearLayout>
                <View
                    android:layout_width="@dimen/dp_0_5"
                    android:layout_height="@dimen/dp_39"/>
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/dp_10"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="?attr/text_color"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/wifi_psw"/>
                    <TextView
                        android:textSize="@dimen/sp_15"
                        android:textColor="?attr/text_color"
                        android:id="@+id/tv_wifi_psw"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_3"
                        android:text="--"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/container_wifi_disconnect"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:layout_width="@dimen/dp_193_5"
                android:layout_height="@dimen/dp_129">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <ProgressBar
                    android:layout_gravity="center"
                    android:id="@+id/progress_check_net"
                    android:visibility="gone"
                    android:layout_width="@dimen/dp_120"
                    android:layout_height="@dimen/dp_120"/>
            </FrameLayout>
            <TextView
                android:textSize="@dimen/sp_13"
                android:textColor="?attr/text_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wifi_disconnect_tips"
                android:paddingStart="@dimen/alert_text_padding"
                android:paddingEnd="@dimen/alert_text_padding"/>
            <View
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <TextView
                android:textSize="@dimen/sp_13"
                android:gravity="center"
                android:id="@+id/btn_refresh"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_36"
                android:text="@string/refresh"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
