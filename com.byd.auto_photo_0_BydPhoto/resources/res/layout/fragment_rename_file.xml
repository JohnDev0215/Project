<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingTop="@dimen/dp_5"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:background="@drawable/drawable_rename_et_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_30"
        android:layout_marginStart="@dimen/dp_20"
        android:layout_marginEnd="@dimen/dp_20">
        <EditText
            android:textSize="@dimen/sp_14"
            android:textColor="?attr/text_color_in_theme"
            android:textColorHighlight="?attr/text_select_color"
            android:textColorHint="?attr/search_hint_text_color"
            android:gravity="center_vertical"
            android:id="@+id/et_name"
            android:background="#00000000"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:cursorVisible="true"
            android:singleLine="true"
            android:textSelectHandleLeft="@drawable/text_select_handle_left_material"
            android:textSelectHandleRight="@drawable/text_select_handle_right_material"
            android:textSelectHandle="@drawable/text_select_handle_middle_material"
            android:textCursorDrawable="@drawable/color_photo3_cursor"
            android:paddingStart="@dimen/dp_13"
            android:paddingEnd="@dimen/dp_36"
            android:importantForAutofill="no"/>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/iv_clear_input"
            android:layout_width="@dimen/dp_36"
            android:layout_height="@dimen/dp_36"
            android:src="?attr/icon_clear_input"/>
    </FrameLayout>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="#ffff0000"
        android:id="@+id/tv_conflict_tips"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_5"
        android:text="@string/name_exist"
        android:layout_marginStart="@dimen/dp_20"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="?attr/text_hint_color"
        android:id="@+id/tv_name_len_tips"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:layout_marginStart="@dimen/dp_20"/>
</LinearLayout>
