<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/item_media_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <com.byd.view.XRoundCornerImageView
            android:id="@+id/item_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/icon_loading_def"
            android:scaleType="centerCrop"
            app:radius="0dp"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/item_play_tips"
            android:visibility="gone"
            android:layout_width="@dimen/media_grid_item_play_size"
            android:layout_height="@dimen/media_grid_item_play_size"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="#ffffffff"
            android:layout_gravity="bottom"
            android:id="@+id/item_burstshoot_tips"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_1"
            android:layout_marginStart="@dimen/dp_1"/>
        <TextView
            android:textSize="@dimen/media_grid_duration_text_size"
            android:textColor="#ffffffff"
            android:layout_gravity="bottom"
            android:id="@+id/item_video_duration"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_1"
            android:fontFamily="@string/font_family"
            android:layout_marginStart="@dimen/dp_1"/>
        <ImageView
            android:id="@+id/item_selected"
            android:visibility="gone"
            android:layout_width="@dimen/item_media_select_icon_size"
            android:layout_height="@dimen/item_media_select_icon_size"
            android:layout_marginTop="@dimen/dp_5"
            android:layout_marginStart="@dimen/dp_5"/>
        <ImageView
            android:id="@+id/item_file_type"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_5"
            android:layout_marginStart="@dimen/dp_5"/>
    </FrameLayout>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="?attr/text_color"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/item_name"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_media_name_height"
        android:layout_marginTop="@dimen/dp_2"
        android:lines="1"
        android:fontFamily="@string/font_family"/>
</LinearLayout>
