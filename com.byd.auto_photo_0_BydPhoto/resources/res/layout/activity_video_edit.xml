<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <com.byd.view.VideoPreview
            android:layout_gravity="center"
            android:id="@+id/video_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.byd.view.VideoEditCropZoneView
            android:layout_gravity="center"
            android:id="@+id/video_crop_zone_view"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/btn_play"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/icon_video_play_big"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="130dp">
        <CheckBox
            android:layout_gravity="bottom"
            android:id="@+id/ch_play_or_pause"
            android:background="#55ff0000"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="20dp"/>
        <com.byd.view.VideoEditTimeLineController
            android:layout_gravity="center_vertical"
            android:id="@+id/video_edit_time_line_controller"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/container_adjust_seek"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="202dp"
        android:layout_marginEnd="202dp">
        <com.byd.view.PositiveAndNegativeSeekBar
            android:id="@+id/seek_video_edit_adjust"
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_weight="1"
            app:bar_radius="@dimen/dp_2"
            app:is_vertical="false"
            app:max="100"/>
        <TextView
            android:textColor="#ffffffff"
            android:id="@+id/tv_video_edit_adjust_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="72dp">
        <TextView
            android:id="@+id/btn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel"/>
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/container_menu_main"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <CheckedTextView
                    android:id="@+id/item_video_clip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/video_edit_clip"
                    android:layout_marginEnd="24dp"/>
                <CheckedTextView
                    android:id="@+id/item_video_adjust"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/video_edit_adjust"
                    android:layout_marginEnd="24dp"/>
                <CheckedTextView
                    android:id="@+id/item_video_filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter"
                    android:layout_marginEnd="24dp"/>
                <CheckedTextView
                    android:id="@+id/item_video_crop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/crop"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/container_menu_adjust"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:id="@+id/item_adjust_reset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/reset"
                    android:layout_marginEnd="24dp"/>
                <CheckedTextView
                    android:id="@+id/item_adjust_contrast"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/video_edit_contrast"
                    android:layout_marginEnd="24dp"/>
                <CheckedTextView
                    android:id="@+id/item_adjust_brightness"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/video_edit_brightness"
                    android:layout_marginEnd="24dp"/>
                <CheckedTextView
                    android:id="@+id/item_adjust_saturation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/video_edit_saturation"/>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_filter"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/btn_export"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/video_edit_export"/>
            <TextView
                android:id="@+id/btn_sure"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sure"/>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
