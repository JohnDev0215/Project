<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.byd.view.XImageView
        android:id="@+id/item_thumb"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:clickable="true"
        android:longClickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <pl.droidsonroids.gif.GifImageView
        android:id="@+id/item_gif"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <TextView
        android:layout_gravity="center"
        android:id="@+id/item_play_video"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:visibility="gone"
        android:clickable="true"
        android:longClickable="true"
        android:layout_width="@dimen/dp_90"
        android:layout_height="@dimen/dp_90"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="#ff222222"
        android:id="@+id/item_burstshoot_num"
        android:background="#55eeeeee"
        android:padding="@dimen/dp_5"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawablePadding="@dimen/dp_10"
        android:fontFamily="plagiata"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/item_load_progress"
        android:visibility="gone"
        android:layout_width="@dimen/dp_120"
        android:layout_height="@dimen/dp_120"
        android:indeterminateDrawable="@drawable/progress_drawable"/>
</FrameLayout>
