<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_36"
        android:layout_marginTop="@dimen/dp_7_5"
        android:paddingStart="@dimen/dp_10"
        android:paddingEnd="@dimen/dp_10">
        <ImageView
            android:id="@+id/view_back"
            android:layout_width="@dimen/dp_36"
            android:layout_height="@dimen/dp_36"
            android:src="?attr/icon_back"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/dp_11"/>
        <TextView
            android:textSize="@dimen/sp_15"
            android:textColor="?attr/text_color"
            android:id="@+id/view_title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/version_declare"
            android:layout_toRightOf="@+id/view_back"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <ImageView
        android:id="@+id/iv_app_icon"
        android:layout_width="@dimen/dp_54"
        android:layout_height="@dimen/dp_54"
        android:layout_marginTop="@dimen/about_app_icon_top_margin"
        android:src="?attr/icon_app_about"/>
    <TextView
        android:textSize="@dimen/sp_15"
        android:textColor="?attr/text_color"
        android:gravity="center"
        android:id="@+id/tv_app_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_20"
        android:text="@string/app_name"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="?attr/copy_right_text_color"
        android:gravity="center"
        android:id="@+id/tv_app_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="v1.0"/>
    <RelativeLayout
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/sp_13"
            android:textColor="@color/color_for_dialog_sure_ui3"
            android:gravity="center"
            android:id="@+id/btn_to_check_update"
            android:background="?attr/sure_btn_bg"
            android:paddingTop="@dimen/dp_7"
            android:paddingBottom="@dimen/dp_7"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_36"
            android:layout_marginTop="@dimen/dp_30"
            android:minWidth="@dimen/dp_120"
            android:paddingStart="@dimen/dp_10"
            android:paddingEnd="@dimen/dp_10"/>
        <ImageView
            android:id="@+id/iv_new_version_tips"
            android:visibility="gone"
            android:layout_width="@dimen/dp_5"
            android:layout_height="@dimen/dp_5"
            android:layout_marginTop="@dimen/dp_m_5"
            android:src="@drawable/icon_new_version_tips"
            android:layout_alignTop="@+id/btn_to_check_update"
            android:layout_marginStart="@dimen/dp_m_2"
            android:layout_alignEnd="@+id/btn_to_check_update"/>
    </RelativeLayout>
    <Space
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_8">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_2">
            <TextView
                android:textSize="@dimen/sp_12"
                android:textColor="?attr/copy_right_text_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tips_icp"/>
            <TextView
                android:textSize="@dimen/sp_12"
                android:textColor="?attr/copy_right_text_color"
                android:id="@+id/tv_icp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tips_icp_byd"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/sp_12"
                android:textColor="?attr/copy_right_text_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/icp_url_search"/>
            <TextView
                android:textSize="@dimen/sp_12"
                android:textColor="?attr/copy_right_text_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/icp_url"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="?attr/copy_right_text_color"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_copyright"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_46"
        android:text="@string/copyright"/>
</LinearLayout>
