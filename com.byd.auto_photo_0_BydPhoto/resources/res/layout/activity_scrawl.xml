<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/image_edit_scrawl_tool_size"
            android:layout_weight="1">
            <FrameLayout
                android:id="@+id/scrawl_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/color_select_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_80">
                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textColor="?attr/text_color"
                    android:id="@+id/tv_color_tips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/color"
                    android:layout_marginEnd="@dimen/dp_20"/>
                <com.byd.view.ColorSelectBar
                    android:id="@+id/seek_color"
                    android:layout_width="@dimen/dp_400"
                    android:layout_height="@dimen/dp_12"/>
                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"/>
            </LinearLayout>
        </LinearLayout>
        <View
            android:layout_width="@dimen/dp_180"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_styles"
        android:layout_width="@dimen/image_edit_scrawl_tool_size"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dp_30"
        android:layout_marginBottom="@dimen/dp_20"
        android:layout_centerVertical="true"/>
</RelativeLayout>
