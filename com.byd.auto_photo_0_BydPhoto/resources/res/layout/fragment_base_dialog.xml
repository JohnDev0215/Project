<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="?attr/dialog_bg_res"
    android:paddingBottom="@dimen/dp_20"
    android:layout_width="@dimen/dialog_min_width"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/container_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dialog_title_height">
        <TextView
            android:textSize="@dimen/dialog_title_text_size"
            android:textColor="?attr/text_color"
            android:gravity="center"
            android:id="@+id/tv_dialog_title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="提示"/>
        <ImageView
            android:id="@+id/iv_dialog_title_close"
            android:visibility="gone"
            android:layout_width="@dimen/dp_36"
            android:layout_height="@dimen/dp_36"
            android:src="@drawable/icon_close_1"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/dp_12"/>
    </RelativeLayout>
    <View
        android:id="@+id/line_below_title"
        android:background="?attr/line_color"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0_5"
        android:layout_marginBottom="@dimen/dp_16_5"/>
    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <View
        android:id="@+id/line_above_buttons"
        android:background="?attr/line_color"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0_5"
        android:layout_marginTop="@dimen/dp_10"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/button_group"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dialog_button_height"
        android:layoutDirection="ltr">
        <TextView
            android:textSize="@dimen/dialog_button_text_size"
            android:textColor="@color/color_for_dialog_sure_ui3"
            android:gravity="center"
            android:id="@+id/btn_sure"
            android:background="?attr/sure_btn_bg"
            android:layout_width="@dimen/dialog_button_width"
            android:layout_height="match_parent"
            android:text="@string/sure"/>
        <View
            android:id="@+id/line_between_buttons"
            android:layout_width="@dimen/dp_36"
            android:layout_height="match_parent"/>
        <TextView
            android:textSize="@dimen/dialog_button_text_size"
            android:textColor="?attr/cancel_btn_text_color"
            android:gravity="center"
            android:id="@+id/btn_cancel"
            android:background="?attr/cancel_btn_bg"
            android:layout_width="@dimen/dialog_button_width"
            android:layout_height="match_parent"
            android:text="@string/cancel"/>
    </LinearLayout>
</LinearLayout>
