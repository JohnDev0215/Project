<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:paddingBottom="@dimen/dp_20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/detail_content_padding_ui3"
        android:paddingEnd="@dimen/detail_content_padding_ui3">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/detail_item_height">
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="?attr/detail_tips_text_color"
                android:id="@+id/tips_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/detail_names_width"
                android:text="@string/file_name_ui3"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="?attr/text_color"
                android:gravity="right"
                android:id="@+id/tv_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/tips_name"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <View
            android:background="?attr/line_color"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_0_5"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/detail_item_height">
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="?attr/detail_tips_text_color"
                android:id="@+id/tips_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/detail_names_width"
                android:text="@string/file_time_ui3"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="?attr/text_color"
                android:gravity="right"
                android:id="@+id/tv_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/tips_time"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <View
            android:background="?attr/line_color"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_0_5"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/item_detail_addr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/detail_item_height">
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="?attr/detail_tips_text_color"
                    android:id="@+id/tips_addr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/detail_names_width"
                    android:text="@string/file_address_ui3"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="?attr/text_color"
                    android:gravity="right"
                    android:id="@+id/tv_addr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/tips_addr"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
            <View
                android:background="?attr/line_color"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_0_5"/>
        </LinearLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/detail_item_height">
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="?attr/detail_tips_text_color"
                android:id="@+id/tips_file_len"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/detail_names_width"
                android:text="@string/file_len_ui3"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="?attr/text_color"
                android:gravity="right"
                android:id="@+id/tv_file_len"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/tips_file_len"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <View
            android:background="?attr/line_color"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_0_5"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/detail_item_height">
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="?attr/detail_tips_text_color"
                android:id="@+id/tips_file_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/detail_names_width"
                android:text="@string/file_size_ui3"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="?attr/text_color"
                android:gravity="right"
                android:id="@+id/tv_file_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/tips_file_size"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <View
            android:background="?attr/line_color"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_0_5"/>
        <RelativeLayout
            android:paddingTop="@dimen/dp_12_5"
            android:paddingBottom="@dimen/dp_12_5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/detail_item_height">
            <TextView
                android:textSize="@dimen/sp_15"
                android:textColor="?attr/detail_tips_text_color"
                android:id="@+id/tips_path"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/detail_names_width"
                android:text="@string/file_path_ui3"
                android:paddingEnd="@dimen/dp_3"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="?attr/text_color"
                android:gravity="right"
                android:id="@+id/tv_path"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:lineSpacingExtra="@dimen/dp_5"
                android:layout_toEndOf="@+id/tips_path"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <View
            android:background="?attr/line_color"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_0_5"/>
    </LinearLayout>
</ScrollView>
