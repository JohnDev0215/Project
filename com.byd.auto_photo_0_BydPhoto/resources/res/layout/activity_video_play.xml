<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/video_main_container"
    android:background="#00000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">
    <com.byd.view.XVideoView
        android:id="@+id/video_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"/>
    <ImageView
        android:id="@+id/video_thumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"/>
    <ImageView
        android:id="@+id/iv_video_play_big"
        android:layout_width="@dimen/dp_90"
        android:layout_height="@dimen/dp_90"
        android:src="@drawable/icon_video_pause_big"
        android:layout_centerInParent="true"/>
    <ImageView
        android:id="@+id/view_bright_tips"
        android:visibility="gone"
        android:layout_width="@dimen/dp_30"
        android:layout_height="@dimen/dp_30"
        android:src="@drawable/icon_light"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/dp_30"/>
    <ImageView
        android:id="@+id/view_volume_tips"
        android:visibility="gone"
        android:layout_width="@dimen/dp_30"
        android:layout_height="@dimen/dp_30"
        android:src="@drawable/icon_volume"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/dp_30"
        android:layout_alignParentEnd="true"/>
    <RelativeLayout
        android:id="@+id/layout_control_tips"
        android:background="#4d000000"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:visibility="gone"
        android:clickable="true"
        android:longClickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/dp_40">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_slide_up"
                android:maxWidth="@dimen/dp_30"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                android:src="@drawable/icon_slide_hand"
                android:maxWidth="@dimen/dp_55"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                android:src="@drawable/icon_slide_up"
                android:maxWidth="@dimen/dp_30"
                android:rotation="180"/>
            <TextView
                android:textSize="@dimen/sp_15"
                android:textColor="#ffffffff"
                android:id="@+id/tv_slide_left_tips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_30"
                android:maxWidth="@dimen/dp_240"
                android:text="@string/slide_left_tips"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp_40"
            android:layout_alignParentEnd="true">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_slide_up"
                android:maxWidth="@dimen/dp_30"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                android:src="@drawable/icon_slide_hand"
                android:maxWidth="@dimen/dp_55"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                android:src="@drawable/icon_slide_up"
                android:maxWidth="@dimen/dp_30"
                android:rotation="180"/>
            <TextView
                android:textSize="@dimen/sp_15"
                android:textColor="#ffffffff"
                android:id="@+id/tv_slide_right_tips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_30"
                android:maxWidth="@dimen/dp_240"
                android:text="@string/slide_right_tips"/>
        </LinearLayout>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/full_title_container"
        android:background="@drawable/shadow_top"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/full_title_height"
        android:paddingStart="@dimen/title_content_padding"
        android:paddingEnd="@dimen/title_content_padding">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_45">
            <ImageView
                android:id="@+id/iv_full_close"
                android:layout_width="@dimen/dp_36"
                android:layout_height="@dimen/dp_36"
                android:src="@drawable/icon_back_in_full"/>
            <TextView
                android:textSize="@dimen/sp_15"
                android:textColor="#ffffffff"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/tv_full_title"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:lines="1"
                android:fontFamily="@string/font_family"/>
        </LinearLayout>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/layout_tools"
        android:background="@drawable/shadow_bottom"
        android:paddingBottom="@dimen/dp_19_5"
        android:layout_width="match_parent"
        android:layout_height="@dimen/footer_tools_height"
        android:layout_alignParentBottom="true">
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="bottom|center_horizontal"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_42">
            <ImageView
                android:id="@+id/btn_pre"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <CheckBox
                android:id="@+id/btn_play_or_pause"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:button="@null"
                android:drawableStart="@drawable/video_play_or_pause_drawable_ui3"
                android:layout_marginEnd="@dimen/dp_12"/>
            <ImageView
                android:id="@+id/btn_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_player_next_ui3"
                android:layout_marginEnd="@dimen/dp_18"/>
            <SeekBar
                android:id="@+id/seek_video_progress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxHeight="@dimen/dp_4_5"
                android:minHeight="@dimen/dp_4"
                android:thumbOffset="@dimen/dp_10"
                android:layout_weight="1"
                android:splitTrack="false"/>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/dp_113">
                <TextView
                    android:textSize="@dimen/sp_13"
                    android:textColor="@android:color/white"
                    android:id="@+id/tv_current_pos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00:00"/>
                <TextView
                    android:textSize="@dimen/sp_13"
                    android:textColor="@android:color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="/"/>
                <TextView
                    android:textSize="@dimen/sp_13"
                    android:textColor="@android:color/white"
                    android:id="@+id/tv_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00:00"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</RelativeLayout>
