<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">
    <com.byd.view.TabGroup
        android:orientation="vertical"
        android:id="@+id/tab_group"
        android:background="?attr/tab_bg"
        android:paddingTop="@dimen/dp_21"
        android:paddingRight="@dimen/dp_9"
        android:layout_width="@dimen/tab_size"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true">
        <com.byd.view.TabItemLinearContainer
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/tab_image"
            android:background="?attr/tab_selected_bg"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_48"
            android:paddingStart="@dimen/dp_20">
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/anim_image"
                android:layout_width="@dimen/dp_36"
                android:layout_height="@dimen/dp_36"
                app:lottie_autoPlay="true"
                app:lottie_imageAssetsFolder="images/"
                app:lottie_loop="false"/>
            <com.byd.view.TabItem
                android:id="@+id/tab_text_image"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:text="@string/tab_image"
                app:textColor="@color/tab_text_color"
                app:textGravity="center_vertical"
                app:textSize="@dimen/tab_text_size"/>
        </com.byd.view.TabItemLinearContainer>
        <com.byd.view.TabItemLinearContainer
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/tab_album"
            android:background="?attr/tab_selected_bg"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_48"
            android:paddingStart="@dimen/dp_20">
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/anim_album"
                android:layout_width="@dimen/dp_36"
                android:layout_height="@dimen/dp_36"
                app:lottie_autoPlay="true"
                app:lottie_imageAssetsFolder="images/"
                app:lottie_loop="false"/>
            <com.byd.view.TabItem
                android:id="@+id/tab_text_album"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:text="@string/tab_album"
                app:textColor="@color/tab_text_color"
                app:textGravity="center_vertical"
                app:textSize="@dimen/tab_text_size"/>
        </com.byd.view.TabItemLinearContainer>
    </com.byd.view.TabGroup>
    <View
        android:id="@+id/tab_shadow"
        android:background="?attr/tab_shadow"
        android:layout_width="@dimen/dp_57"
        android:layout_height="match_parent"
        android:layout_toEndOf="@+id/tab_group"/>
    <FrameLayout
        android:id="@+id/content"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_toEndOf="@+id/tab_group"
        android:layout_alignParentEnd="true"/>
    <FrameLayout
        android:id="@+id/content_second_level"
        android:background="?attr/bg_content"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:longClickable="true"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_toEndOf="@+id/tab_group"
        android:layout_alignParentEnd="true"/>
    <FrameLayout
        android:id="@+id/content_second_full_level"
        android:background="?attr/bg_content"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:longClickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</RelativeLayout>
