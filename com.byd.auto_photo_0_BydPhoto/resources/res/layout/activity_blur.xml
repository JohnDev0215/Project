<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.byd.view.OverlayImageView
        android:id="@+id/iv_image"
        android:layout_width="@dimen/dp_530"
        android:layout_height="@dimen/dp_298"
        android:layout_centerInParent="true"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/tool_blur_radius"
        android:layout_width="@dimen/dp_540"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:layout_marginBottom="@dimen/dp_10"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="@dimen/sp_15"
            android:textColor="?attr/text_color_press"
            android:id="@+id/tv_seek_blur_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/dp_20"
            android:text="@string/blur"
            android:layout_marginStart="@dimen/dp_30"
            android:layout_marginEnd="@dimen/dp_35"/>
        <SeekBar
            android:id="@+id/seek_blur"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxHeight="@dimen/dp_3"
            android:max="25"
            android:progressDrawable="?attr/progress_drawable"
            android:minHeight="@dimen/dp_2"
            android:thumb="@drawable/seek_edit_thumb_drawable"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dp_m_30"
            android:layout_marginEnd="@dimen/dp_m_30"
            android:splitTrack="true"/>
        <View
            android:layout_width="@dimen/dp_30"
            android:layout_height="@dimen/dp_1"
            android:layout_marginStart="@dimen/dp_30"/>
    </LinearLayout>
</RelativeLayout>
