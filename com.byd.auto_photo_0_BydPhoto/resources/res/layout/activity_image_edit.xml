<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/edit_tool_bar"
        android:background="?attr/img_edit_tool_bg"
        android:paddingLeft="@dimen/image_edit_tool_horizontal_padding"
        android:paddingRight="@dimen/image_edit_tool_horizontal_padding"
        android:layout_width="match_parent"
        android:layout_height="@dimen/image_edit_tool_size">
        <ImageView
            android:id="@+id/btn_cancel"
            android:layout_width="@dimen/dp_36"
            android:layout_height="@dimen/dp_36"
            android:src="@drawable/icon_cancel"/>
        <View
            android:background="?attr/line_color"
            android:layout_width="@dimen/dp_1"
            android:layout_height="@dimen/dp_24"
            android:layout_marginLeft="@dimen/dp_10"
            android:layout_marginRight="@dimen/dp_10"/>
        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="@dimen/image_edit_tool_text_size"
                    android:textColor="?attr/text_color"
                    android:gravity="center"
                    android:id="@+id/btn_rotate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/dp_36"
                    android:text="@string/rotate"
                    android:drawablePadding="@dimen/dp_3"/>
                <Space
                    android:layout_width="@dimen/image_edit_tool_item_margin"
                    android:layout_height="1dp"/>
                <TextView
                    android:textSize="@dimen/image_edit_tool_text_size"
                    android:textColor="?attr/text_color"
                    android:gravity="center"
                    android:id="@+id/btn_crop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/dp_36"
                    android:text="@string/crop"
                    android:drawablePadding="@dimen/dp_3"/>
                <Space
                    android:layout_width="@dimen/image_edit_tool_item_margin"
                    android:layout_height="1dp"/>
                <TextView
                    android:textSize="@dimen/image_edit_tool_text_size"
                    android:textColor="?attr/text_color"
                    android:gravity="center"
                    android:id="@+id/btn_filter"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/dp_36"
                    android:text="@string/filter"
                    android:drawablePadding="@dimen/dp_3"/>
                <Space
                    android:id="@+id/spacing_filter"
                    android:visibility="gone"
                    android:layout_width="@dimen/image_edit_tool_item_margin"
                    android:layout_height="1dp"/>
                <TextView
                    android:textSize="@dimen/image_edit_tool_text_size"
                    android:textColor="?attr/text_color"
                    android:gravity="center"
                    android:id="@+id/btn_scrawl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/dp_36"
                    android:text="@string/scrawl"
                    android:drawablePadding="@dimen/dp_3"/>
                <Space
                    android:layout_width="@dimen/image_edit_tool_item_margin"
                    android:layout_height="1dp"/>
                <TextView
                    android:textSize="@dimen/image_edit_tool_text_size"
                    android:textColor="?attr/text_color"
                    android:gravity="center"
                    android:id="@+id/btn_water_mark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/dp_36"
                    android:text="@string/water_mark"
                    android:drawablePadding="@dimen/dp_3"/>
                <Space
                    android:layout_width="@dimen/image_edit_tool_item_margin"
                    android:layout_height="1dp"/>
                <TextView
                    android:textSize="@dimen/image_edit_tool_text_size"
                    android:textColor="?attr/text_color"
                    android:gravity="center"
                    android:id="@+id/btn_water_mark_word"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/dp_36"
                    android:text="@string/water_mark_word"
                    android:drawablePadding="@dimen/dp_3"/>
                <Space
                    android:layout_width="@dimen/image_edit_tool_item_margin"
                    android:layout_height="1dp"/>
                <TextView
                    android:textSize="@dimen/image_edit_tool_text_size"
                    android:textColor="?attr/text_color"
                    android:gravity="center"
                    android:id="@+id/btn_masc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/dp_36"
                    android:text="@string/masc"
                    android:drawablePadding="@dimen/dp_3"/>
                <Space
                    android:layout_width="@dimen/image_edit_tool_item_margin"
                    android:layout_height="1dp"/>
                <TextView
                    android:textSize="@dimen/image_edit_tool_text_size"
                    android:textColor="?attr/text_color"
                    android:gravity="center"
                    android:id="@+id/btn_blur"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/dp_36"
                    android:text="@string/blur"
                    android:drawablePadding="@dimen/dp_3"/>
            </LinearLayout>
        </HorizontalScrollView>
        <View
            android:background="?attr/line_color"
            android:layout_width="@dimen/dp_1"
            android:layout_height="@dimen/dp_24"
            android:layout_marginLeft="@dimen/dp_10"
            android:layout_marginRight="@dimen/dp_10"/>
        <ImageView
            android:id="@+id/btn_save"
            android:layout_width="@dimen/dp_36"
            android:layout_height="@dimen/dp_36"
            android:src="@drawable/icon_edit_sure"/>
    </LinearLayout>
</LinearLayout>
