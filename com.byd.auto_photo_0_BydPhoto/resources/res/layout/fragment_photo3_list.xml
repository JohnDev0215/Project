<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <fragment
        android:name="com.byd.fragment.SearchAndSelectFragment"
        android:id="@+id/fragment_header"
        android:tag="search_land"
        android:layout_width="match_parent"
        android:layout_height="@dimen/search_or_tool_bar_height_photo3"
        android:layout_marginTop="@dimen/dp_7_5"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_search_result_tips"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_18"
        android:layout_marginBottom="@dimen/dp_14"
        android:layout_marginStart="@dimen/search_page_result_margin_left"
        android:layout_marginEnd="@dimen/content_padding">
        <TextView
            android:textSize="@dimen/sp_12"
            android:textColor="?attr/search_input_text_color"
            android:id="@+id/tv_search_result_num_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="123个文件"
            android:fontFamily="@string/font_family"/>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_7"
        android:layout_weight="1"
        android:paddingStart="@dimen/content_padding"
        android:paddingEnd="@dimen/content_padding">
        <com.byd.view.AnimViewSwitcher
            android:id="@+id/switcher"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.recyclerview.widget.RecyclerView
                android:scrollbarSize="@dimen/dp_2"
                android:scrollbarThumbVertical="@drawable/scrollbar_vertical_thumb"
                android:scrollbarTrackVertical="@drawable/scrollbar_vertical_track"
                android:id="@+id/photo_list"
                android:scrollbars="vertical"
                android:fadingEdge="none"
                android:fadingEdgeLength="0dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never"/>
            <androidx.recyclerview.widget.RecyclerView
                android:scrollbarSize="@dimen/dp_2"
                android:scrollbarThumbVertical="@drawable/scrollbar_vertical_thumb"
                android:scrollbarTrackVertical="@drawable/scrollbar_vertical_track"
                android:id="@+id/photo_list_month"
                android:visibility="gone"
                android:scrollbars="vertical"
                android:fadingEdge="none"
                android:fadingEdgeLength="0dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never"/>
            <androidx.recyclerview.widget.RecyclerView
                android:scrollbarSize="@dimen/dp_2"
                android:scrollbarThumbVertical="@drawable/scrollbar_vertical_thumb"
                android:scrollbarTrackVertical="@drawable/scrollbar_vertical_track"
                android:id="@+id/photo_list_year"
                android:visibility="gone"
                android:scrollbars="vertical"
                android:fadingEdge="none"
                android:fadingEdgeLength="0dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never"/>
        </com.byd.view.AnimViewSwitcher>
        <TextView
            android:textSize="@dimen/sp_13"
            android:textColor="#565d65"
            android:gravity="center_horizontal"
            android:layout_gravity="center"
            android:id="@+id/tv_empty"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/search_not_found"
            android:drawableTop="?attr/empty_drawable"
            android:drawablePadding="@dimen/dp_9"/>
        <include
            android:id="@+id/history_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/search_page_result_margin_left"
            android:layout_marginEnd="@dimen/search_page_input_margin_right"
            layout="@layout/history_kw_layout"/>
    </FrameLayout>
</LinearLayout>
