<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:background="?android:attr/selectableItemBackground"
    android:paddingRight="?android:attr/scrollbarSize"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="15dp"
    android:layout_marginTop="6dp"
    android:layout_marginRight="6dp"
    android:layout_marginBottom="6dp"
    android:minHeight="?android:attr/listPreferredItemHeight"
    android:layout_weight="1"
    android:paddingEnd="?android:attr/scrollbarSize"
    android:layout_marginStart="15dp"
    android:layout_marginEnd="6dp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textSize="@dimen/byd_config_settings_title_text_size"
            android:textColor="@color/byd_colorPrimaryDark"
            android:ellipsize="marquee"
            android:id="@android:id/title"
            android:fadingEdge="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:singleLine="true"
            android:layout_marginStart="5dp"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="@dimen/byd_config_settings_summary_margin_top"
            android:layout_marginStart="5dp">
            <TextView
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textSize="@dimen/byd_config_settings_summary_text_size"
                android:textColor="@color/byd_colorPrimaryDark"
                android:id="@android:id/summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <com.android.inputmethod.dictionarypack.DictionaryDownloadProgressBar
                android:gravity="center"
                android:id="@+id/dictionary_line_progress_bar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                style="@android:style/Widget.Holo.ProgressBar.Horizontal"/>
        </FrameLayout>
    </LinearLayout>
    <com.android.inputmethod.dictionarypack.ButtonSwitcher
        android:id="@+id/wordlist_button_switcher"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="13dp"
        android:layout_weight="0"
        android:layout_marginStart="13dp">
        <Button
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:layout_gravity="center"
            android:id="@+id/dict_install_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/install_dict"
            android:singleLine="true"/>
        <Button
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:layout_gravity="center"
            android:id="@+id/dict_cancel_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel_download_dict"
            android:singleLine="true"/>
        <Button
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:layout_gravity="center"
            android:id="@+id/dict_delete_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/delete_dict"
            android:singleLine="true"/>
    </com.android.inputmethod.dictionarypack.ButtonSwitcher>
</LinearLayout>
