<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/activity_layout"
    android:background="@drawable/full_screen_bg"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/all_sub_layout"
        android:background="@drawable/settings_shape_dialog_bg"
        android:layout_width="@dimen/dp_560"
        android:layout_height="@dimen/dp_554">
        <TextView
            android:layout_gravity="center"
            android:id="@+id/dialog_title"
            android:text="@string/all_sub_type_title"
            style="@style/dialog_title_text"/>
        <TextView style="@style/dialog_title_divider"/>
        <androidx.recyclerview.widget.RecyclerView
            android:layout_gravity="center"
            android:id="@+id/subtype_recyclerview"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_358"
            style="@style/scroll_bar_style_fading"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_28">
            <Button
                android:id="@+id/confirm"
                android:text="@string/user_dict_settings_add_dialog_confirm"
                android:layout_centerHorizontal="true"
                android:layout_marginEnd="@dimen/dp_80"
                android:layout_alignParentEnd="true"
                style="@style/actionBtn"/>
            <Button
                android:id="@+id/cancel"
                android:text="@string/cancel"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="@dimen/dp_80"
                android:layout_alignParentStart="true"
                style="@style/actionBtn_cancel"/>
        </RelativeLayout>
    </LinearLayout>
</FrameLayout>
