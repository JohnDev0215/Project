<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:id="@+id/press_delay_layout"
    android:background="@drawable/settings_shape_dialog_bg"
    android:visibility="gone"
    android:layout_width="@dimen/dp_560"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_71"
        android:layoutDirection="rtl">
        <ImageView
            android:id="@+id/delay_close"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:src="@drawable/icon_public_close_48"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp_16"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:id="@+id/dialog_title"
            android:text="@string/prefs_key_longpress_timeout_settings"
            style="@style/dialog_title_text"/>
    </RelativeLayout>
    <TextView style="@style/dialog_title_divider"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_100"
        android:layout_marginTop="@dimen/dp_28">
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/normal_text_color"
            android:gravity="center"
            android:id="@+id/delay_time_show"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"/>
        <SeekBar
            android:layout_gravity="center_horizontal"
            android:id="@+id/delay_seek_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_40"
            android:layout_marginBottom="@dimen/dp_20"
            android:progressDrawable="@drawable/seekbar_track"
            android:thumb="@drawable/seek_thumb"
            android:thumbOffset="@dimen/dp_10"
            android:layout_alignParentBottom="true"
            android:paddingStart="@dimen/dp_48"
            android:paddingEnd="@dimen/dp_48"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_104">
        <Button
            android:layout_gravity="center_vertical"
            android:id="@+id/delay_cancel"
            android:text="@string/cancel"
            android:layout_marginStart="@dimen/dp_48"
            style="@style/actionBtn_cancel"/>
        <Button
            android:layout_gravity="center_vertical"
            android:id="@+id/delay_default"
            android:text="@string/button_default"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_16"
            style="@style/actionBtn_cancel"/>
        <Button
            android:layout_gravity="center_vertical"
            android:id="@+id/delay_confirm"
            android:text="@string/user_dict_settings_add_dialog_confirm"
            android:layout_marginEnd="@dimen/dp_48"
            style="@style/actionBtn"/>
    </LinearLayout>
</LinearLayout>
