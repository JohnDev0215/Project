<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:latin="http://schemas.android.com/apk/res/com.android.inputmethod.latin">
    <switch>
        <case latin:keyboardLayoutSetElement="emojiRecents">
            <Key
                latin:additionalMoreKeys="{"
                latin:keyHintLabel="{"
                latin:keySpec="["
                latin:keyStyle="hasShiftedLetterHintStyle"/>
            <Key
                latin:additionalMoreKeys="}"
                latin:keyHintLabel="}"
                latin:keySpec="]"
                latin:keyStyle="hasShiftedLetterHintStyle"/>
            <Key
                latin:additionalMoreKeys="\\|"
                latin:keyHintLabel="|"
                latin:keySpec="\\"
                latin:keyStyle="hasShiftedLetterHintStyle"/>
        </case>
        <default>
            <Key latin:keySpec="{"/>
            <Key latin:keySpec="}"/>
            <Key latin:keySpec="|"/>
        </default>
    </switch>
</merge>
