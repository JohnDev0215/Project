<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:latin="http://schemas.android.com/apk/res/com.android.inputmethod.latin">
    <include latin:keyboardLayout="@xml/key_styles_common"/>
    <Row latin:keyWidth="7%p">
        <include latin:keyboardLayout="@xml/rowkeys_pcqwerty1"/>
        <Key
            latin:keyStyle="deleteKeyStyle"
            latin:keyWidth="fillRight"/>
    </Row>
    <Row latin:keyWidth="7%p">
        <Key
            latin:keyStyle="tabKeyStyle"
            latin:keyWidth="9%p"/>
        <include latin:keyboardLayout="@xml/rowkeys_pcqwerty2"/>
    </Row>
    <Row latin:keyWidth="7%p">
        <Spacer latin:keyWidth="10%p"/>
        <include latin:keyboardLayout="@xml/rowkeys_pcqwerty3"/>
        <Key
            latin:keyStyle="enterKeyStyle"
            latin:keyWidth="fillRight"/>
    </Row>
    <Row latin:keyWidth="7%p">
        <Key
            latin:keyStyle="shiftKeyStyle"
            latin:keyWidth="15%p"/>
        <include latin:keyboardLayout="@xml/rowkeys_pcqwerty4"/>
        <Key
            latin:keyStyle="shiftKeyStyle"
            latin:keyWidth="fillRight"
            latin:keyXPos="-15%p"/>
    </Row>
    <include latin:keyboardLayout="@xml/row_pcqwerty5"/>
</merge>
