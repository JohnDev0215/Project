<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:latin="http://schemas.android.com/apk/res/com.android.inputmethod.latin">
    <include latin:keyboardLayout="@xml/key_styles_common"/>
    <include latin:keyboardLayout="@xml/key_styles_number"/>
    <Row>
        <Key
            latin:backgroundType="functional"
            latin:keySpec="-"
            latin:keyStyle="numSymbolKeyStyle"
            latin:keyWidth="10%p"/>
        <Key
            latin:backgroundType="functional"
            latin:keySpec="+"
            latin:keyStyle="numSymbolKeyStyle"
            latin:keyWidth="10%p"/>
        <Key
            latin:backgroundType="functional"
            latin:keyLabelFlags="autoXScale|followKeyLabelRatio"
            latin:keySpec="!string/label_pause_key|,"
            latin:keyStyle="numSymbolKeyStyle"
            latin:keyWidth="10%p"/>
        <Key
            latin:keyStyle="num1KeyStyle"
            latin:keyXPos="31%p"/>
        <Key latin:keyStyle="num2KeyStyle"/>
        <Key latin:keyStyle="num3KeyStyle"/>
        <Key
            latin:keyStyle="deleteKeyStyle"
            latin:keyWidth="fillRight"
            latin:keyXPos="-14%p"/>
    </Row>
    <Row>
        <Key
            latin:backgroundType="functional"
            latin:keySpec=","
            latin:keyStyle="numSymbolKeyStyle"
            latin:keyWidth="10%p"/>
        <Key
            latin:backgroundType="functional"
            latin:keySpec="."
            latin:keyStyle="numSymbolKeyStyle"
            latin:keyWidth="10%p"/>
        <Key
            latin:backgroundType="functional"
            latin:keyLabelFlags="autoXScale|followKeyLabelRatio"
            latin:keySpec="!string/label_wait_key|;"
            latin:keyStyle="numSymbolKeyStyle"
            latin:keyWidth="10%p"/>
        <Key
            latin:keyStyle="num4KeyStyle"
            latin:keyXPos="31%p"/>
        <Key latin:keyStyle="num5KeyStyle"/>
        <Key latin:keyStyle="num6KeyStyle"/>
        <Key
            latin:keyStyle="enterKeyStyle"
            latin:keyWidth="fillRight"
            latin:keyXPos="-14%p"/>
    </Row>
    <Row>
        <Key
            latin:backgroundType="functional"
            latin:keySpec="("
            latin:keyStyle="numSymbolKeyStyle"
            latin:keyWidth="10%p"/>
        <Key
            latin:backgroundType="functional"
            latin:keySpec=")"
            latin:keyStyle="numSymbolKeyStyle"
            latin:keyWidth="10%p"/>
        <Key
            latin:backgroundType="functional"
            latin:keySpec="N"
            latin:keyStyle="numSymbolKeyStyle"
            latin:keyWidth="10%p"/>
        <Key
            latin:keyStyle="num7KeyStyle"
            latin:keyXPos="31%p"/>
        <Key latin:keyStyle="num8KeyStyle"/>
        <Key latin:keyStyle="num9KeyStyle"/>
        <Spacer/>
    </Row>
    <Row>
        <Key
            latin:keyStyle="tabletNumSpaceKeyStyle"
            latin:keyWidth="30%p"/>
        <Key
            latin:keySpec="＊|*"
            latin:keyStyle="numSymbolKeyStyle"
            latin:keyXPos="31%p"/>
        <Key
            latin:keyHintLabel="+"
            latin:keyStyle="num0KeyStyle"/>
        <Key
            latin:keySpec="#"
            latin:keyStyle="numSymbolKeyStyle"/>
    </Row>
</merge>
