<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="fill_horizontal"
    android:orientation="vertical"
    android:id="@id/dropdown_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ListView
        android:id="@id/dropdown_body_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dropdown_vertical_margin"
        android:layout_marginBottom="@dimen/dropdown_vertical_margin"
        android:layout_weight="1"/>
    <View
        android:id="@id/dropdown_body_footer_divider"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_height"
        style="@style/HorizontalDivider"/>
    <FrameLayout
        android:id="@id/dropdown_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
