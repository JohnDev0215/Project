    <uses-permission android:name="android.Manifest.permission.NETWORK_SETTINGS"/>
    <uses-permission android:name="android.permission.DUMP"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.WRITE_MEDIA_STORAGE"/>
    <uses-permission android:name="android.permission.READ_MEDIA_STORAGE"/>
    <uses-permission android:name="android.permission.SYSTEM_OVERLAY_WINDOW"/>
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.FLASHLIGHT"/>
    <application
        android:theme="@style/AppTheme"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:name="com.byd.logtools.application.BydLogApplication"
        android:exported="true"
        android:supportsRtl="true"
        android:extractNativeLibs="false"
        android:resizeableActivity="false"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory">
        <activity
            android:name="com.byd.logtools.activity.LogToolsActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"/>
        <activity
            android:label="@string/upload_log_ic"
            android:icon="@drawable/com_byd_bydlogtool"
            android:name="com.byd.logtools.activity.FaultUploadActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"/>
        <activity
            android:name="com.byd.logtools.activity.ConfigurationLogActivity"
            android:launchMode="singleTask"/>
        <activity
            android:name="com.byd.logtools.activity.LogLevelConfigActivity"
            android:launchMode="singleTask"/>
        <activity
            android:name="com.byd.logtools.activity.SaveLogActivity"
            android:launchMode="singleTask"/>
        <activity
            android:name="com.byd.logtools.activity.SaveCurrentLogActivity"
            android:launchMode="singleTask"/>
        <activity
            android:name="com.byd.logtools.activity.ClearLogActivity"
            android:launchMode="singleTask"/>
        <service
            android:name="com.byd.logtools.logservice.BYDLogService"
            android:permission="android.permission.ACCESS_LOG_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.DROPBOX_ENTRY_ADDED"/>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.CMD_SAVE_ALL_LOG"/>
                <action android:name="android.intent.action.USB_SAVE_ALL_LOG"/>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"/>
                <action android:name="android.hardware.usb.action.USB_DEVICE_DETACHED"/>
            </intent-filter>
        </service>
        <receiver android:name="com.byd.logtools.broadcast.BydLogReceiver"/>
        <receiver android:name="com.byd.logtools.broadcast.UsbCheckReceiver">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"/>
                <action android:name="android.hardware.usb.action.USB_DEVICE_DETACHED"/>
            </intent-filter>
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.MEDIA_MOUNTED"/>
                <action android:name="android.intent.action.MEDIA_EJECT"/>
                <data android:scheme="file"/>
            </intent-filter>
        </receiver>
        <service android:name="com.byd.logtools.apkinstall.ApkInstallService"/>
        <activity
            android:name="com.byd.logtools.apkinstall.ui.ApkInstallActivity"
            android:launchMode="singleTask"/>
        <service
            android:name="com.byd.logtools.auth.AuthService"
            android:exported="true"
            android:configChanges="layoutDirection|uiMode"/>
        <activity
            android:name="com.byd.logtools.apkinstall.ui.PasswordActivity"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize|stateVisible"/>
