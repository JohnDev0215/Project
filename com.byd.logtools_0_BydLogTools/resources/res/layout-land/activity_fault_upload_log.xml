<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/ll_linera"
    android:background="@drawable/bg_h"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RadioGroup
        android:orientation="vertical"
        android:id="@+id/rg_fault_upload_log"
        android:background="@drawable/img_1menu_bg_h"
        android:layout_width="@dimen/dp_249"
        android:layout_height="@dimen/dp_591"
        android:layout_marginTop="@dimen/dp_60"
        android:layout_marginBottom="@dimen/dp_60">
        <RadioButton
            android:gravity="center"
            android:id="@+id/rb_current_log"
            android:background="@drawable/log_radio_button_background_h"
            android:paddingTop="@dimen/dp_10"
            android:layout_width="@dimen/dp_208"
            android:layout_height="@dimen/dp_64"
            android:checked="true"
            android:text="@string/logtools_current_log_string"
            android:drawableStart="@drawable/current_log_radio_button_selector"
            android:paddingStart="@dimen/dp_40"
            style="@style/MainButtonStyle"/>
        <RadioButton
            android:gravity="center"
            android:id="@+id/rb_history_log"
            android:background="@drawable/log_radio_button_background_h"
            android:paddingTop="@dimen/dp_10"
            android:layout_width="@dimen/dp_208"
            android:layout_height="@dimen/dp_64"
            android:text="@string/logtools_history_log_string"
            android:drawableStart="@drawable/history_log_radio_button_selector"
            android:paddingStart="@dimen/dp_40"
            style="@style/MainButtonStyle"/>
    </RadioGroup>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/frameLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dp_60"
        android:layout_marginBottom="@dimen/dp_60">
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/current_log_title_color"
            android:layout_gravity="center_horizontal"
            android:id="@+id/fault_upload_log_title"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_22"
            android:layout_marginTop="@dimen/dp_32"
            android:text="@string/logtools_history_log_select_title"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/history_log_message_color"
            android:layout_gravity="center_horizontal"
            android:id="@+id/fault_upload_log_message"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_25"
            android:layout_marginTop="@dimen/dp_6"
            android:text="@string/logtools_history_log_select_message"/>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/ll_current_log"
            android:background="@drawable/card_bg"
            android:visibility="visible"
            android:layout_width="@dimen/dp_188"
            android:layout_height="@dimen/dp_205"
            android:layout_marginTop="@dimen/dp_154"
            android:layout_marginBottom="@dimen/dp_100">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/iv_dilink"
                android:background="@drawable/dilink"
                android:layout_width="@dimen/dp_150"
                android:layout_height="@dimen/dp_180"/>
        </LinearLayout>
        <ListView
            android:id="@+id/history_log_list_view"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_340"
            android:layout_marginTop="@dimen/dp_34"/>
        <Button
            android:textSize="@dimen/sp_18"
            android:textColor="@color/white"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/fault_upload_log_button"
            android:background="@drawable/dialog_button_bg_selector"
            android:layout_width="@dimen/dp_176"
            android:layout_height="@dimen/dp_48"
            android:layout_marginTop="@dimen/dp_27"
            android:layout_marginBottom="@dimen/dp_60"
            android:text="@string/logtools_confirm_upload_string"/>
    </LinearLayout>
</LinearLayout>
