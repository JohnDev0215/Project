<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/ll_linera"
    android:background="@drawable/bg_h"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RadioGroup
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/rg_fault_upload_log"
        android:background="@drawable/img_1menu_bg_v"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_102"
        android:layout_marginTop="@dimen/dp_70">
        <RadioButton
            android:gravity="center"
            android:id="@+id/rb_current_log"
            android:background="@drawable/log_radio_button_background_v"
            android:paddingTop="@dimen/dp_15"
            android:layout_width="@dimen/dp_128"
            android:layout_height="@dimen/dp_100"
            android:checked="true"
            android:text="@string/logtools_current_log_string"
            android:drawableTop="@drawable/current_log_radio_button_selector"
            style="@style/MainButtonStyle"/>
        <RadioButton
            android:gravity="center"
            android:id="@+id/rb_history_log"
            android:background="@drawable/log_radio_button_background_v"
            android:paddingTop="@dimen/dp_15"
            android:layout_width="@dimen/dp_128"
            android:layout_height="@dimen/dp_100"
            android:text="@string/logtools_history_log_string"
            android:drawableTop="@drawable/history_log_radio_button_selector"
            style="@style/MainButtonStyle"/>
    </RadioGroup>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="@color/current_log_title_color"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/fault_upload_log_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_22"
        android:layout_marginTop="@dimen/dp_110"
        android:text="@string/logtools_fault_upload_type_string"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="@color/dialog_message_text_color"
        android:layout_gravity="center_horizontal"
        android:id="@+id/fault_upload_log_message"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_25"
        android:layout_marginTop="6dp"
        android:text="@string/logtools_history_log_select_message"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/ll_current_log"
        android:background="@drawable/card_bg"
        android:visibility="visible"
        android:layout_width="@dimen/dp_188"
        android:layout_height="@dimen/dp_205"
        android:layout_marginTop="@dimen/dp_232"
        android:layout_marginBottom="@dimen/dp_200">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/iv_dilink"
            android:background="@drawable/dilink"
            android:layout_width="@dimen/dp_150"
            android:layout_height="@dimen/dp_180"/>
    </LinearLayout>
    <ListView
        android:id="@+id/history_log_list_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_430"
        android:layout_marginTop="@dimen/dp_44"/>
    <Button
        android:textSize="@dimen/sp_18"
        android:textColor="@color/dialog_button_exit_text_color"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/fault_upload_log_button"
        android:background="@drawable/dialog_button_bg_selector"
        android:layout_width="@dimen/dp_176"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_297"
        android:layout_marginBottom="@dimen/dp_126"
        android:text="@string/logtools_confirm_upload_string"/>
</LinearLayout>
