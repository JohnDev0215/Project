<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_bg_outside"
    android:background="@color/bg_color_dialog_outside"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_bg"
        android:background="@drawable/bg_qrcode_dialog"
        android:layout_width="@dimen/dp_560"
        android:layout_height="@dimen/dp_424"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <RelativeLayout
            android:id="@+id/rl_title_dialog"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_71"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/iv_back"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                android:layout_marginLeft="@dimen/dp_16"
                android:src="@drawable/icon_qrcode_close"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/text_color_main_dilink_pagers"
                android:gravity="center"
                android:id="@+id/tv_title"
                android:layout_width="@dimen/dp_512"
                android:layout_height="@dimen/dp_29"
                android:layout_centerInParent="true"
                android:textDirection="locale"/>
        </RelativeLayout>
        <View
            android:id="@+id/v_line_dialog"
            android:background="@color/bg_color_line"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            app:layout_constraintTop_toBottomOf="@+id/rl_title_dialog"/>
        <ImageView
            android:id="@+id/iv_qrcode"
            android:background="@drawable/bg_qrcode"
            android:padding="@dimen/dp_9"
            android:layout_width="@dimen/dp_180"
            android:layout_height="@dimen/dp_180"
            android:layout_marginTop="@dimen/dp_78"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_line_dialog"/>
        <ImageView
            android:id="@+id/iv_qrcode_state"
            android:background="@drawable/bg_qrcode_state"
            android:visibility="gone"
            android:layout_width="@dimen/dp_180"
            android:layout_height="@dimen/dp_180"
            android:layout_marginTop="@dimen/dp_50"
            android:src="@drawable/icon_qrcode_succeed"
            android:scaleType="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_line_dialog"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/text_color_main_dilink_pagers"
            android:id="@+id/tv_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_13"
            android:text="@string/qrcode_tip"
            android:textDirection="locale"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_line_dialog"/>
        <TextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/text_color_qrcode_left_time"
            android:id="@+id/tv_left_time"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_6"
            android:text="@string/qrcode_time"
            android:textDirection="locale"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_tips"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/text_color_main_dilink_pagers"
            android:gravity="center"
            android:id="@+id/tv_result"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_49"
            android:text="@string/qrcode_tip"
            android:textDirection="locale"
            android:paddingHorizontal="@dimen/dp_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/layout_scan_type"
            android:background="@drawable/bg_segment_button_group"
            android:padding="@dimen/dp_2"
            android:layout_width="@dimen/dp_362"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_277"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_line_dialog">
            <TextView
                android:gravity="center"
                android:id="@+id/tv_we_chat"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:minHeight="@dimen/dp_40"
                android:text="@string/qrcode_scan_type_wechat"
                android:layout_weight="1"
                android:textDirection="locale"
                style="@style/SegmentBtnSelected"/>
            <TextView
                android:gravity="center"
                android:id="@+id/tv_vds"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:minHeight="@dimen/dp_40"
                android:text="@string/qrcode_scan_type_vds"
                android:layout_weight="1"
                android:textDirection="locale"
                android:layout_marginStart="@dimen/dp_2"
                style="@style/SegmentBtnUnselected"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
