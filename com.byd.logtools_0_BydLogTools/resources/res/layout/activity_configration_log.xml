<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_h"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:background="@drawable/underline"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_80"
        android:layout_marginTop="@dimen/dp_60">
        <TextView
            android:textSize="@dimen/sp_30"
            android:textColor="@color/config_log_text_color"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/config_title"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@drawable/underline"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_60">
        <TextView
            android:textSize="@dimen/sp_26"
            android:textColor="@color/config_log_text_color"
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:text="@string/switch_properties"
            android:layout_weight="7"
            android:layout_marginStart="@dimen/dp_20"/>
        <TextView
            android:textSize="@dimen/sp_26"
            android:textColor="@color/config_log_text_color"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:text="@string/service_config_value"
            android:layout_weight="3"/>
        <TextView
            android:textSize="@dimen/sp_26"
            android:textColor="@color/config_log_text_color"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_width="@dimen/dp_150"
            android:layout_height="match_parent"
            android:text="@string/local_config_value"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@drawable/underline"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_60">
        <TextView
            android:textSize="@dimen/sp_26"
            android:textColor="@color/config_log_text_color"
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:text="@string/save_crashlog_switch"
            android:layout_weight="7"
            android:layout_marginStart="@dimen/dp_20"/>
        <TextView
            android:textSize="@dimen/sp_26"
            android:textColor="@color/config_log_text_color"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/save_crashlog_service_value"
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:text="@string/switch_open"
            android:layout_weight="3"
            android:layout_marginEnd="@dimen/dp_20"/>
        <Switch
            android:layout_gravity="center_vertical"
            android:id="@+id/save_crashlog_switch"
            android:layout_width="@dimen/dp_100"
            android:layout_height="wrap_content"
            android:textOn="@string/switch_open"
            android:textOff="@string/switch_close"
            android:thumb="@drawable/switch_thumb"
            android:switchTextAppearance="@style/SwitchTextAppearance"
            android:track="@drawable/switch_track"
            android:layout_marginEnd="@dimen/dp_30"
            android:showText="true"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@drawable/underline"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_60">
        <TextView
            android:textSize="@dimen/sp_26"
            android:textColor="@color/config_log_text_color"
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:text="@string/upload_crashinfo_switch"
            android:layout_weight="7"
            android:layout_marginStart="@dimen/dp_20"/>
        <TextView
            android:textSize="@dimen/sp_26"
            android:textColor="@color/config_log_text_color"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/upload_crashlog_service_value"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/switch_open"
            android:layout_weight="3"
            android:layout_marginEnd="@dimen/dp_20"/>
        <Switch
            android:layout_gravity="center_vertical"
            android:id="@+id/upload_crashinfo_switch"
            android:layout_width="@dimen/dp_100"
            android:layout_height="wrap_content"
            android:textOn="@string/switch_open"
            android:textOff="@string/switch_close"
            android:thumb="@drawable/switch_thumb"
            android:switchTextAppearance="@style/SwitchTextAppearance"
            android:track="@drawable/switch_track"
            android:layout_marginEnd="@dimen/dp_30"
            android:showText="true"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@drawable/underline"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_60">
        <TextView
            android:textSize="@dimen/sp_26"
            android:textColor="@color/config_log_text_color"
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:text="@string/auto_savelog_switch"
            android:layout_weight="7"
            android:layout_marginStart="@dimen/dp_20"/>
        <TextView
            android:textSize="@dimen/sp_26"
            android:textColor="@color/config_log_text_color"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/auto_savelog_service_value"
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:text="@string/switch_open"
            android:layout_weight="3"
            android:layout_marginEnd="@dimen/dp_20"/>
        <Switch
            android:layout_gravity="center_vertical"
            android:id="@+id/auto_savelog_switch"
            android:layout_width="@dimen/dp_100"
            android:layout_height="wrap_content"
            android:textOn="@string/switch_open"
            android:textOff="@string/switch_close"
            android:thumb="@drawable/switch_thumb"
            android:switchTextAppearance="@style/SwitchTextAppearance"
            android:track="@drawable/switch_track"
            android:layout_marginEnd="@dimen/dp_30"
            android:showText="true"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@drawable/underline"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_60">
        <TextView
            android:textSize="@dimen/sp_26"
            android:textColor="@color/config_log_text_color"
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:text="@string/upload_realtimelog_switch"
            android:layout_weight="7"
            android:layout_marginStart="@dimen/dp_20"/>
        <TextView
            android:textSize="@dimen/sp_26"
            android:textColor="@color/config_log_text_color"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/upload_realtimelog_service_value"
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:text="@string/switch_open"
            android:layout_weight="3"
            android:layout_marginEnd="@dimen/dp_20"/>
        <Switch
            android:layout_gravity="center_vertical"
            android:id="@+id/upload_realtimelog_switch"
            android:layout_width="@dimen/dp_100"
            android:layout_height="wrap_content"
            android:textOn="@string/switch_open"
            android:textOff="@string/switch_close"
            android:thumb="@drawable/switch_thumb"
            android:switchTextAppearance="@style/SwitchTextAppearance"
            android:track="@drawable/switch_track"
            android:layout_marginEnd="@dimen/dp_30"
            android:showText="true"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@drawable/underline"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_60">
        <TextView
            android:textSize="@dimen/sp_26"
            android:textColor="@color/config_log_text_color"
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:text="@string/upload_recoverylog_switch"
            android:layout_weight="7"
            android:layout_marginStart="@dimen/dp_20"/>
        <TextView
            android:textSize="@dimen/sp_26"
            android:textColor="@color/config_log_text_color"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/upload_recoverylog_service_value"
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:text="@string/switch_open"
            android:layout_weight="3"
            android:layout_marginEnd="@dimen/dp_20"/>
        <Switch
            android:layout_gravity="center_vertical"
            android:id="@+id/upload_recoverylog_switch"
            android:layout_width="@dimen/dp_100"
            android:layout_height="wrap_content"
            android:textOn="@string/switch_open"
            android:textOff="@string/switch_close"
            android:thumb="@drawable/switch_thumb"
            android:switchTextAppearance="@style/SwitchTextAppearance"
            android:track="@drawable/switch_track"
            android:layout_marginEnd="@dimen/dp_30"
            android:showText="true"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@drawable/underline"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_60">
        <TextView
            android:textSize="@dimen/sp_26"
            android:textColor="@color/config_log_text_color"
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:text="@string/upload_ota_log_switch"
            android:layout_weight="7"
            android:layout_marginStart="@dimen/dp_20"/>
        <TextView
            android:textSize="@dimen/sp_26"
            android:textColor="@color/config_log_text_color"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/upload_otalog_service_value"
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:text="@string/switch_open"
            android:layout_weight="3"
            android:layout_marginEnd="@dimen/dp_20"/>
        <Switch
            android:layout_gravity="center_vertical"
            android:id="@+id/upload_ota_log_switch"
            android:layout_width="@dimen/dp_100"
            android:layout_height="wrap_content"
            android:textOn="@string/switch_open"
            android:textOff="@string/switch_close"
            android:thumb="@drawable/switch_thumb"
            android:switchTextAppearance="@style/SwitchTextAppearance"
            android:track="@drawable/switch_track"
            android:layout_marginEnd="@dimen/dp_30"
            android:showText="true"/>
    </LinearLayout>
</LinearLayout>
