<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_h"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_50"
        android:layout_marginTop="@dimen/dp_60"
        android:layout_marginStart="@dimen/dp_20">
        <TextView
            android:textSize="@dimen/sp_30"
            android:textColor="@color/config_log_text_color"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/log_level_title"/>
        <TextView
            android:textSize="@dimen/sp_26"
            android:textStyle="bold"
            android:textColor="@color/config_log_text_color"
            android:gravity="center_vertical"
            android:id="@+id/tv_current_log_level"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/log_level_unknown"
            android:layout_marginStart="@dimen/dp_10"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_40"
        android:layout_marginStart="@dimen/dp_15">
        <RadioGroup
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/radioGroup"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RadioButton
                android:textSize="@dimen/sp_25"
                android:textColor="@color/config_log_text_color"
                android:id="@+id/radio_verbose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/log_level_verbose"/>
            <RadioButton
                android:textSize="@dimen/sp_25"
                android:textColor="@color/config_log_text_color"
                android:id="@+id/radio_debug"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/log_level_debug"
                android:layout_marginStart="@dimen/dp_35"/>
            <RadioButton
                android:textSize="@dimen/sp_25"
                android:textColor="@color/config_log_text_color"
                android:id="@+id/radio_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/log_level_info"
                android:layout_marginStart="@dimen/dp_35"/>
            <RadioButton
                android:textSize="@dimen/sp_25"
                android:textColor="@color/config_log_text_color"
                android:id="@+id/radio_warn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/log_level_warn"
                android:layout_marginStart="@dimen/dp_35"/>
            <RadioButton
                android:textSize="@dimen/sp_25"
                android:textColor="@color/config_log_text_color"
                android:id="@+id/radio_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/log_level_error"
                android:layout_marginStart="@dimen/dp_35"/>
        </RadioGroup>
    </LinearLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_70"
        android:layout_marginTop="@dimen/dp_30"
        android:layout_marginStart="@dimen/dp_20">
        <TextView
            android:textSize="@dimen/sp_30"
            android:textColor="@color/config_log_text_color"
            android:id="@+id/qnx_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/log_qnx_level_title"/>
        <TextView
            android:textSize="@dimen/sp_22"
            android:textColor="@color/config_log_text_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/log_qnx_level_message"
            android:layout_below="@+id/qnx_title"/>
        <TextView
            android:textSize="@dimen/sp_26"
            android:textStyle="bold"
            android:textColor="@color/config_log_text_color"
            android:id="@+id/tv_qnx_current_log_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/log_level_unknown"
            android:layout_toRightOf="@+id/qnx_title"
            android:layout_marginStart="@dimen/dp_10"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_40"
        android:layout_marginStart="@dimen/dp_15">
        <RadioGroup
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/qnx_radioGroup"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RadioButton
                android:textSize="@dimen/sp_25"
                android:textColor="@color/config_log_text_color"
                android:id="@+id/qnx_radio_verbose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/log_level_verbose"/>
            <RadioButton
                android:textSize="@dimen/sp_25"
                android:textColor="@color/config_log_text_color"
                android:id="@+id/qnx_radio_debug"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/log_level_debug"
                android:layout_marginStart="@dimen/dp_35"/>
            <RadioButton
                android:textSize="@dimen/sp_25"
                android:textColor="@color/config_log_text_color"
                android:id="@+id/qnx_radio_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/log_level_info"
                android:layout_marginStart="@dimen/dp_35"/>
            <RadioButton
                android:textSize="@dimen/sp_25"
                android:textColor="@color/config_log_text_color"
                android:id="@+id/qnx_radio_warn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/log_level_warn"
                android:layout_marginStart="@dimen/dp_35"/>
            <RadioButton
                android:textSize="@dimen/sp_25"
                android:textColor="@color/config_log_text_color"
                android:id="@+id/qnx_radio_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/log_level_error"
                android:layout_marginStart="@dimen/dp_35"/>
        </RadioGroup>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_50"
        android:layout_marginTop="@dimen/dp_30"
        android:layout_marginStart="@dimen/dp_20">
        <TextView
            android:textSize="@dimen/sp_30"
            android:textColor="@color/config_log_text_color"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/log_boschVehicleHal_level_title"/>
        <TextView
            android:textSize="@dimen/sp_26"
            android:textStyle="bold"
            android:textColor="@color/config_log_text_color"
            android:gravity="center_vertical"
            android:id="@+id/tv_boschVehicleHal_log_level"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/log_level_unknown"
            android:layout_marginStart="@dimen/dp_10"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_40"
        android:layout_marginStart="@dimen/dp_15">
        <RadioGroup
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/boschVehicleHal_radioGroup"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RadioButton
                android:textSize="@dimen/sp_25"
                android:textColor="@color/config_log_text_color"
                android:id="@+id/boschVehicleHal_radio_debug"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/log_level_debug"/>
            <RadioButton
                android:textSize="@dimen/sp_25"
                android:textColor="@color/config_log_text_color"
                android:id="@+id/boschVehicleHal_radio_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/log_level_info"
                android:layout_marginStart="@dimen/dp_35"/>
        </RadioGroup>
    </LinearLayout>
</LinearLayout>
