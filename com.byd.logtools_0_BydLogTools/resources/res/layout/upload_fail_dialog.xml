<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@drawable/dialog_bg_shape"
    android:layout_width="@dimen/dp_560"
    android:layout_height="@dimen/dp_312">
    <ImageView
        android:id="@+id/iv_upload_result"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_64"
        android:src="@drawable/upload_fail"
        android:contentDescription="@null"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="@color/dialog_title_text_color"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/upload_result_title"
        android:layout_width="@dimen/dp_264"
        android:layout_height="@dimen/dp_29"
        android:layout_marginTop="@dimen/dp_13"
        android:text="@string/logtools_upload_fail"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="@color/dialog_message_text_color"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/upload_result_message"
        android:layout_width="@dimen/dp_560"
        android:layout_height="@dimen/dp_25"
        android:layout_marginTop="@dimen/dp_2"
        android:text="@string/logtools_network_signal_poor"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_104"
        android:layout_marginTop="@dimen/dp_3">
        <Button
            android:textSize="@dimen/sp_18"
            android:textColor="@color/dialog_button_upload_text_color"
            android:id="@+id/btn_confirm"
            android:background="@drawable/dialog_button_bg_selector"
            android:layout_width="@dimen/dp_176"
            android:layout_height="@dimen/dp_48"
            android:text="@string/logtools_upload_again"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/dp_80"/>
        <Button
            android:textSize="@dimen/sp_18"
            android:textColor="@color/dialog_button_exit_text_color"
            android:id="@+id/btn_cancel"
            android:background="@drawable/dialog_exit_button_bg"
            android:layout_width="@dimen/dp_176"
            android:layout_height="@dimen/dp_48"
            android:text="@string/logtools_upload_exit"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp_80"/>
    </RelativeLayout>
</LinearLayout>
