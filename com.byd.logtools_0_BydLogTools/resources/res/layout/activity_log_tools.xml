<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/bg_h"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/sp_22"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_60"
        android:text="@string/app_name"
        android:layout_centerHorizontal="true"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_30"
        android:layout_below="@+id/title">
        <RelativeLayout
            android:orientation="horizontal"
            android:id="@+id/rl_save_log"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:clickable="true"
            android:layout_width="@dimen/dp_180"
            android:layout_height="wrap_content"
            android:onClick="onClick">
            <ImageView
                android:id="@+id/iv_save_log"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="@dimen/dp_60"
                android:layout_height="@dimen/dp_60"
                android:src="@drawable/save_ic"
                android:layout_centerHorizontal="true"
                android:contentDescription="@null"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/save_all_log_ic"
                android:layout_below="@+id/iv_save_log"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:orientation="horizontal"
            android:id="@+id/rl_save_current_log"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:clickable="true"
            android:layout_width="@dimen/dp_180"
            android:layout_height="wrap_content"
            android:onClick="onClick">
            <ImageView
                android:id="@+id/iv_save_current_log"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="@dimen/dp_60"
                android:layout_height="@dimen/dp_60"
                android:src="@drawable/save_ic"
                android:layout_centerHorizontal="true"
                android:contentDescription="@null"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/save_current_log_ic"
                android:layout_below="@+id/iv_save_current_log"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:orientation="horizontal"
            android:id="@+id/rl_clear_log"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:clickable="true"
            android:layout_width="@dimen/dp_180"
            android:layout_height="wrap_content"
            android:onClick="onClick">
            <ImageView
                android:id="@+id/iv_clear_log"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="@dimen/dp_60"
                android:layout_height="@dimen/dp_60"
                android:src="@drawable/ic_clear_log"
                android:layout_centerHorizontal="true"
                android:contentDescription="@null"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/clear_log_ic"
                android:layout_below="@+id/iv_clear_log"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:orientation="horizontal"
            android:id="@+id/rl_fault_upload"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:visibility="visible"
            android:clickable="true"
            android:layout_width="@dimen/dp_180"
            android:layout_height="wrap_content"
            android:onClick="onClick">
            <ImageView
                android:id="@+id/iv_fault_upload"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="@dimen/dp_60"
                android:layout_height="@dimen/dp_60"
                android:src="@drawable/com_byd_bydlogtool"
                android:layout_centerHorizontal="true"
                android:contentDescription="@null"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/upload_log_ic"
                android:layout_below="@+id/iv_fault_upload"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
    </LinearLayout>
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/rl_configuration_log"
        android:focusable="true"
        android:focusableInTouchMode="false"
        android:visibility="visible"
        android:clickable="true"
        android:layout_width="@dimen/dp_180"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:onClick="onClick">
        <ImageView
            android:id="@+id/iv_configuration_log"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="@dimen/dp_60"
            android:layout_height="@dimen/dp_60"
            android:src="@drawable/setting_ic"
            android:layout_centerHorizontal="true"
            android:contentDescription="@null"/>
        <TextView
            android:textSize="@dimen/sp_20"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_log_level_ic"
            android:layout_below="@+id/iv_configuration_log"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
</RelativeLayout>
