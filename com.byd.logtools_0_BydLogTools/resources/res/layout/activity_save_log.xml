<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/container"
    android:background="@drawable/bg_h"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/sp_22"
        android:textColor="@color/config_log_text_color"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_60"
        android:text="@string/app_name"
        android:layout_alignParentTop="true"/>
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="@color/config_log_text_color"
        android:id="@+id/save_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:text="@string/str_save_all_log"
        android:layout_below="@+id/title"
        android:layout_marginStart="@dimen/dp_20"/>
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="@color/config_log_text_color"
        android:id="@+id/details_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_5"
        android:text="@string/str_save_details"
        android:layout_below="@+id/save_tv"
        android:layout_marginStart="@dimen/dp_20"/>
    <com.byd.logtools.tools.BydCircleTextView
        android:id="@+id/save_progress"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</RelativeLayout>
