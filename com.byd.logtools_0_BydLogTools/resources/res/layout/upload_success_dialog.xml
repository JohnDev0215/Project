<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@drawable/dialog_bg_shape"
    android:layout_width="@dimen/dp_560"
    android:layout_height="@dimen/dp_312">
    <ImageView
        android:id="@+id/iv_upload_result"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_64"
        android:src="@drawable/upload_success"
        android:contentDescription="@null"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="@color/dialog_title_text_color"
        android:gravity="center"
        android:id="@+id/upload_result_title"
        android:layout_width="@dimen/dp_560"
        android:layout_height="@dimen/dp_29"
        android:layout_marginTop="@dimen/dp_16"
        android:text="@string/logtools_upload_success"/>
    <Button
        android:textSize="@dimen/sp_18"
        android:textColor="@color/dialog_button_upload_text_color"
        android:gravity="center"
        android:id="@+id/btn_confirm"
        android:background="@drawable/dialog_button_bg_selector"
        android:layout_width="@dimen/dp_176"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_55"
        android:layout_marginBottom="@dimen/dp_28"
        android:text="@string/logtools_upload_exit"/>
</LinearLayout>
