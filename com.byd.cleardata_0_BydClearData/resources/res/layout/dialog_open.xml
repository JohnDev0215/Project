<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="@color/text_main"
        android:id="@+id/tv_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:text="@string/select_open_mode"
        android:layout_marginStart="@dimen/dp_51"/>
    <androidx.recyclerview.widget.RecyclerView
        android:layout_gravity="center_horizontal"
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_240"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginBottom="@dimen/dp_16"
        android:layout_below="@+id/tv_desc"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="@dimen/dp_36"
        android:layout_marginEnd="@dimen/dp_36"/>
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="@color/text_main"
        android:layout_gravity="center"
        android:id="@+id/tv_empty"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_112"
        android:text="@string/no_app_available"/>
    <androidx.appcompat.widget.AppCompatCheckBox
        android:gravity="center_vertical"
        android:id="@+id/rb_check"
        android:background="@drawable/selector_radiobutton"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_40"
        android:button="@null"
        android:layout_below="@+id/recyclerView"
        android:layout_alignStart="@+id/tv_desc"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="@color/text_main"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_6"
        android:text="@string/always_open_mode"
        android:layout_alignTop="@+id/rb_check"
        android:layout_toEndOf="@+id/rb_check"/>
</merge>
