<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ly_clear_cache"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/icon_cache"
        android:background="@color/text_tip"
        android:layout_width="@dimen/dp_22"
        android:layout_height="@dimen/dp_22"
        android:layout_marginTop="@dimen/dp_58"
        android:layout_marginStart="@dimen/dp_58"/>
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="@color/text_tip"
        android:id="@+id/tv_clear_data"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_58"
        android:text="@string/default_clear_cache"
        android:layout_toRightOf="@+id/icon_cache"
        android:layout_marginStart="@dimen/dp_40"/>
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="@color/text_tip"
        android:id="@+id/tv_current_cache"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_58"
        android:text="@string/default_clear_cache"
        android:layout_toRightOf="@+id/icon_cache"
        android:layout_marginStart="@dimen/dp_200"/>
    <android.widget.Button
        android:textSize="@dimen/sp_20"
        android:textColor="@color/text_sizeView"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/bt_clear_cache"
        android:background="@drawable/bg_button_default_selector"
        android:layout_width="@dimen/dp_176"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_150"
        android:text="@string/str_clear_cache"
        android:textAllCaps="false"
        android:layout_marginStart="@dimen/dp_58"/>
</RelativeLayout>
