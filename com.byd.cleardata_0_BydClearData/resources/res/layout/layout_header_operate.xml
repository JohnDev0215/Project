<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ly_operate"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.byd.cleardata.ui.view.TextImageView
        android:id="@+id/tv_cancel"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_18"
        android:minWidth="@dimen/dp_84"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/dp_28"
        app:image_height="@dimen/dp_40"
        app:image_width="@dimen/dp_40"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:src="@drawable/icon_public_close_s_40"
        app:text="@string/cancel"
        app:textColor="@color/color_text_selector"
        app:textSize="@dimen/sp_18"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="@color/color_highlight"
        android:id="@+id/tv_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_2"
        android:text="@string/file_count"
        android:layout_marginStart="@dimen/dp_17"
        app:layout_constraintBottom_toBottomOf="@+id/tv_cancel"
        app:layout_constraintStart_toEndOf="@+id/tv_cancel"
        app:layout_constraintTop_toTopOf="@+id/tv_cancel"/>
    <com.byd.cleardata.ui.view.TextImageView
        android:id="@+id/tv_more"
        android:visibility="gone"
        android:layout_width="@dimen/dp_84"
        android:layout_height="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_18"
        android:layout_alignTop="@+id/tv_cancel"
        android:layout_marginEnd="@dimen/dp_32"
        android:layout_alignParentEnd="true"
        app:image_height="@dimen/dp_40"
        app:image_width="@dimen/dp_40"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:src="@drawable/icon_public_more_40"
        app:text="@string/more"
        app:textColor="@color/color_text_selector"
        app:textSize="@dimen/sp_18"/>
    <com.byd.cleardata.ui.view.TextImageView
        android:id="@+id/tv_delete"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_18"
        android:minWidth="@dimen/dp_84"
        android:layout_marginEnd="@dimen/dp_32"
        app:image_height="@dimen/dp_40"
        app:image_width="@dimen/dp_40"
        app:layout_constraintEnd_toStartOf="@+id/tv_more"
        app:layout_constraintTop_toTopOf="@+id/tv_more"
        app:src="@drawable/icon_public_delete_s_40"
        app:text="@string/delete"
        app:textColor="@color/color_text_selector"
        app:textSize="@dimen/sp_18"/>
    <com.byd.cleardata.ui.view.TextImageView
        android:id="@+id/tv_copy"
        android:visibility="invisible"
        android:layout_width="@dimen/dp_84"
        android:layout_height="@dimen/dp_40"
        android:layout_marginEnd="@dimen/dp_32"
        app:image_height="@dimen/dp_40"
        app:image_width="@dimen/dp_40"
        app:layout_constraintEnd_toStartOf="@+id/tv_delete"
        app:layout_constraintTop_toTopOf="@+id/tv_delete"
        app:src="@drawable/icon_public_copy_40"
        app:text="@string/copy"
        app:textColor="@color/color_text_selector"
        app:textSize="@dimen/sp_18"/>
    <androidx.appcompat.widget.AppCompatCheckBox
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/cb_select_all"
        android:background="@drawable/selector_checkbox"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_40"
        android:button="@null"
        app:layout_constraintEnd_toStartOf="@+id/tv_select"
        app:layout_constraintTop_toTopOf="@+id/tv_delete"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="@color/text_main"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_select"
        android:paddingBottom="@dimen/dp_2"
        android:layout_width="@dimen/dp_40"
        android:layout_height="wrap_content"
        android:text="@string/all"
        android:layout_marginEnd="@dimen/dp_32"
        app:layout_constraintBottom_toBottomOf="@+id/tv_delete"
        app:layout_constraintEnd_toStartOf="@+id/tv_delete"
        app:layout_constraintTop_toTopOf="@+id/tv_delete"/>
</androidx.constraintlayout.widget.ConstraintLayout>
