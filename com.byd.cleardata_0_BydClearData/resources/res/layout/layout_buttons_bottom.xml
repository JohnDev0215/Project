<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline"
        android:layout_width="@dimen/dp_1"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="@color/text_button_highlight"
        android:gravity="center"
        android:id="@+id/btn_paste"
        android:background="@drawable/bg_button_default"
        android:layout_width="@dimen/dp_176"
        android:layout_height="@dimen/dp_48"
        android:text="@string/paste"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/dp_49"
        android:layout_toStartOf="@+id/guideline"
        android:stateListAnimator="@animator/pressed_state_list"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="@color/text_button"
        android:gravity="center"
        android:id="@+id/btn_paste_cancel"
        android:background="@drawable/bg_button_normal"
        android:layout_width="@dimen/dp_176"
        android:layout_height="@dimen/dp_48"
        android:text="@string/cancel"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/dp_49"
        android:layout_toEndOf="@+id/guideline"
        android:stateListAnimator="@animator/pressed_state_list"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/guideline"/>
</merge>
