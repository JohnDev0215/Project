<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:id="@+id/ly_edit"
        android:background="@drawable/bg_edit"
        android:layout_width="@dimen/dp_464"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_44"
        android:layout_centerHorizontal="true">
        <EditText
            android:textSize="@dimen/sp_18"
            android:textColor="@color/text_main"
            android:textColorHighlight="@color/edittext_highlight"
            android:textColorHint="@color/text_tip"
            android:gravity="start|center_vertical"
            android:id="@+id/edit"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/folder_hint"
            android:lines="1"
            android:singleLine="true"
            android:maxLength="@integer/newname_text_max_length"
            android:layout_centerVertical="true"
            android:inputType="textNoSuggestions"
            android:imeOptions="actionDone"
            android:textAlignment="viewStart"
            android:layoutDirection="locale"
            android:layout_marginStart="@dimen/dp_20"
            android:layout_toStartOf="@+id/iv_delete"/>
        <ImageView
            android:id="@+id/iv_delete"
            android:visibility="invisible"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:src="@drawable/icon_public_clear_48"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp_8"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/text_warning"
        android:id="@+id/tv_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_9"
        android:layout_below="@+id/ly_edit"
        android:layout_marginStart="@dimen/dp_67"/>
</merge>
