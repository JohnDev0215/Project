<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bg_audio_screen"
    android:background="@drawable/bg_main_activity"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rl_content_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/fl_clock_widget"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_720"
            android:layout_centerInParent="true">
            <LinearLayout
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.byd.autoservice.function.PowerClock
                    android:id="@+id/clock_audio_screen"
                    android:layout_width="@dimen/dp_384"
                    android:layout_height="@dimen/dp_384"/>
            </LinearLayout>
        </FrameLayout>
        <ImageView
            android:id="@+id/iv_animation_audio_screen"
            android:layout_width="@dimen/dp_640"
            android:layout_height="@dimen/dp_720"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
