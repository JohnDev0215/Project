<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/dialog_bg"
    android:layout_width="@dimen/dp_560"
    android:layout_height="@dimen/dp_312">
    <TextView
        android:textSize="@dimen/sp_25"
        android:textColor="@color/dicare_remind_reset_color"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/restart_alert_content"
        android:layout_width="@dimen/dp_464"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_50"
        android:text="@string/restart_efect"/>
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="@color/dicare_remind_reset_color"
        android:layout_gravity="center_horizontal"
        android:id="@+id/restart_time_key"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_30"
        android:text="@string/restart_time"/>
    <Button
        android:textSize="@dimen/sp_20"
        android:textColor="@color/white"
        android:layout_gravity="center_horizontal"
        android:id="@+id/restart_Confirm"
        android:background="@drawable/dialog_button_bg_selector"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_50"
        android:layout_marginBottom="@dimen/dp_20"
        android:text="@string/restart_now"/>
</LinearLayout>
