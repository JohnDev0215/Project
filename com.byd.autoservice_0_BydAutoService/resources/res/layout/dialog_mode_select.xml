<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/mode_select_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:background="@drawable/img_mode_bg"
        android:layout_width="@dimen/dp_656"
        android:layout_height="@dimen/dp_150"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <RelativeLayout
            android:id="@+id/localmusic_layout"
            android:layout_width="@dimen/dp_88"
            android:layout_height="@dimen/dp_123"
            android:layout_marginLeft="@dimen/dp_30"
            android:layout_marginTop="@dimen/dp_14"
            android:layout_marginBottom="@dimen/dp_13">
            <ImageView
                android:id="@+id/localmusic_select"
                android:background="@drawable/selector_mode_selected_bg"
                android:layout_width="@dimen/dp_88"
                android:layout_height="@dimen/dp_88"/>
            <ImageView
                android:id="@+id/localmusic_mode"
                android:background="@drawable/icon_light_public_bendi"
                android:layout_width="@dimen/dp_72"
                android:layout_height="@dimen/dp_72"
                android:layout_marginLeft="@dimen/dp_8"
                android:layout_marginTop="@dimen/dp_8"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/mode_text_color_select"
                android:gravity="center_horizontal"
                android:id="@+id/localmusic_tx"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_30"
                android:layout_marginTop="@dimen/dp_16"
                android:text="@string/mode_local_music"
                android:layout_below="@+id/localmusic_mode"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/usb_layout"
            android:visibility="gone"
            android:layout_width="@dimen/dp_88"
            android:layout_height="@dimen/dp_123"
            android:layout_marginLeft="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_14"
            android:layout_toRightOf="@+id/localmusic_layout">
            <ImageView
                android:id="@+id/usb_select"
                android:background="@drawable/selector_mode_selected_bg"
                android:visibility="gone"
                android:layout_width="@dimen/dp_88"
                android:layout_height="@dimen/dp_88"/>
            <ImageView
                android:id="@+id/usb_mode"
                android:background="@drawable/icon_light_public_usbmusic"
                android:layout_width="@dimen/dp_72"
                android:layout_height="@dimen/dp_72"
                android:layout_marginLeft="@dimen/dp_8"
                android:layout_marginTop="@dimen/dp_8"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/mode_text_color_normal"
                android:gravity="center_horizontal"
                android:id="@+id/usb_tx"
                android:layout_width="@dimen/dp_80"
                android:layout_height="@dimen/dp_30"
                android:layout_marginTop="@dimen/dp_16"
                android:text="@string/mode_usb_video"
                android:layout_below="@+id/usb_mode"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/lanya_layout"
            android:layout_width="@dimen/dp_88"
            android:layout_height="@dimen/dp_123"
            android:layout_marginLeft="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_14"
            android:layout_toRightOf="@+id/usb_layout">
            <ImageView
                android:id="@+id/lanya_select"
                android:background="@drawable/selector_mode_selected_bg"
                android:visibility="gone"
                android:layout_width="@dimen/dp_88"
                android:layout_height="@dimen/dp_88"/>
            <ImageView
                android:id="@+id/lanya_mode"
                android:background="@drawable/icon_light_public_lanya"
                android:layout_width="@dimen/dp_72"
                android:layout_height="@dimen/dp_72"
                android:layout_marginLeft="@dimen/dp_8"
                android:layout_marginTop="@dimen/dp_8"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/mode_text_color_normal"
                android:gravity="center_horizontal"
                android:id="@+id/lanya_tx"
                android:layout_width="@dimen/dp_80"
                android:layout_height="@dimen/dp_30"
                android:layout_marginTop="@dimen/dp_16"
                android:text="@string/mode_bt_music"
                android:layout_below="@+id/lanya_mode"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/shouyj_layout"
            android:layout_width="@dimen/dp_88"
            android:layout_height="@dimen/dp_123"
            android:layout_marginLeft="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_14"
            android:layout_toRightOf="@+id/lanya_layout">
            <ImageView
                android:id="@+id/shouyj_select"
                android:background="@drawable/selector_mode_selected_bg"
                android:visibility="gone"
                android:layout_width="@dimen/dp_88"
                android:layout_height="@dimen/dp_88"/>
            <ImageView
                android:id="@+id/shouyj_mode"
                android:background="@drawable/icon_light_public_shouyj"
                android:layout_width="@dimen/dp_72"
                android:layout_height="@dimen/dp_72"
                android:layout_marginLeft="@dimen/dp_8"
                android:layout_marginTop="@dimen/dp_8"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/mode_text_color_normal"
                android:gravity="center_horizontal"
                android:id="@+id/shouyj_tx"
                android:layout_width="@dimen/dp_80"
                android:layout_height="@dimen/dp_30"
                android:layout_marginTop="@dimen/dp_16"
                android:text="@string/mode_fm_music"
                android:layout_below="@+id/shouyj_mode"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/usbmudic_layout"
            android:layout_width="@dimen/dp_88"
            android:layout_height="@dimen/dp_123"
            android:layout_marginLeft="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_14"
            android:layout_toRightOf="@+id/shouyj_layout">
            <ImageView
                android:id="@+id/usbmudic_select"
                android:background="@drawable/selector_mode_selected_bg"
                android:visibility="gone"
                android:layout_width="@dimen/dp_88"
                android:layout_height="@dimen/dp_88"/>
            <ImageView
                android:id="@+id/usbmudic_mode"
                android:background="@drawable/icon_light_public_usb"
                android:layout_width="@dimen/dp_72"
                android:layout_height="@dimen/dp_72"
                android:layout_marginLeft="@dimen/dp_8"
                android:layout_marginTop="@dimen/dp_8"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="@color/mode_text_color_normal"
                android:gravity="center_horizontal"
                android:id="@+id/usbmudic_tx"
                android:layout_width="@dimen/dp_80"
                android:layout_height="@dimen/dp_30"
                android:layout_marginTop="@dimen/dp_16"
                android:text="@string/mode_usb_music"
                android:layout_below="@+id/usbmudic_mode"/>
        </RelativeLayout>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
