<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dp_91"
        android:layout_marginBottom="@dimen/dp_110"
        android:layout_marginEnd="@dimen/dp_11">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioGroup
                android:orientation="vertical"
                android:id="@+id/defined_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_48"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <RadioButton
                    android:textSize="@dimen/sp_18"
                    android:textColor="@color/text_title"
                    android:id="@+id/rotate_btn_play_pause"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_18"
                    android:checked="true"
                    android:text="@string/radio_button_play_pause"/>
                <RadioButton
                    android:textSize="@dimen/sp_18"
                    android:textColor="@color/text_title"
                    android:id="@+id/radio_btn_source"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_18"
                    android:text="@string/radio_button_source"/>
                <RadioButton
                    android:textSize="@dimen/sp_18"
                    android:textColor="@color/text_title"
                    android:id="@+id/radio_btn_navi_home"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_18"
                    android:checked="true"
                    android:text="@string/radio_button_navi_home"/>
                <RadioButton
                    android:textSize="@dimen/sp_18"
                    android:textColor="@color/text_title"
                    android:id="@+id/rotate_btn"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_18"
                    android:checked="true"
                    android:text="@string/radio_button_rotate"/>
                <RadioButton
                    android:textSize="@dimen/sp_18"
                    android:textColor="@color/text_title"
                    android:id="@+id/radio_btn"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_18"
                    android:text="@string/radio_button_radio"/>
                <RadioButton
                    android:textSize="@dimen/sp_18"
                    android:textColor="@color/text_title"
                    android:id="@+id/music_btn"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_18"
                    android:text="@string/radio_button_music"/>
                <RadioButton
                    android:textSize="@dimen/sp_18"
                    android:textColor="@color/text_title"
                    android:id="@+id/ac_btn"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_18"
                    android:text="@string/radio_button_ac"/>
            </RadioGroup>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
