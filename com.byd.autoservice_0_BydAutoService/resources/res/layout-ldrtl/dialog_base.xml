<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_user"
        android:background="@drawable/bg_dialog"
        android:layout_width="@dimen/dp_560"
        android:layout_height="@dimen/dp_312"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/text_title"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_16"
            android:text="@string/dialog_title_user"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/dilaog_line"
            android:background="@color/divider"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:layout_marginTop="@dimen/dp_71"
            app:layout_constraintTop_toTopOf="parent"/>
        <include layout="@layout/dialog_user_radio"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/guide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.5"/>
        <androidx.appcompat.widget.AppCompatButton
            android:textSize="@dimen/sp_18"
            android:textColor="@color/selector_text_button"
            android:gravity="center"
            android:id="@+id/btn_cancel"
            android:background="@drawable/bg_button_normal"
            android:layout_width="@dimen/dp_176"
            android:layout_height="@dimen/dp_48"
            android:layout_marginBottom="@dimen/dp_32"
            android:text="@string/cancel"
            android:layout_marginEnd="@dimen/dp_20"
            android:stateListAnimator="@drawable/anim_btn_scale"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/guide"/>
        <androidx.appcompat.widget.AppCompatButton
            android:textSize="@dimen/sp_18"
            android:textColor="@color/selector_text_button_ok"
            android:gravity="center"
            android:id="@+id/btn_ok"
            android:background="@drawable/bg_button_default"
            android:layout_width="@dimen/dp_176"
            android:layout_height="@dimen/dp_48"
            android:layout_marginBottom="@dimen/dp_32"
            android:text="@string/btn_comfirm"
            android:layout_marginStart="@dimen/dp_20"
            android:stateListAnimator="@drawable/anim_btn_scale"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/guide"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
