<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_frame_denza"
    android:layout_width="@dimen/dp_564"
    android:layout_height="match_parent">
    <include layout="@layout/layout_header_denza"/>
    <com.byd.sing.view.CustomScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_380"
        android:layout_marginTop="@dimen/dp_113"
        android:fadeScrollbars="false"
        android:layout_marginStart="@dimen/dp_48"
        android:layout_marginEnd="@dimen/dp_48"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/text_main_denza"
            android:id="@+id/tv_notice"
            android:layout_width="@dimen/dp_464"
            android:layout_height="wrap_content"
            android:text="@string/notice"
            android:paddingEnd="@dimen/dp_10"/>
    </com.byd.sing.view.CustomScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
