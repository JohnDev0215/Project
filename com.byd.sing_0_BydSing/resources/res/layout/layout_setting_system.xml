<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_frame"
    android:layout_width="@dimen/dp_564"
    android:layout_height="match_parent">
    <include layout="@layout/layout_header"/>
    <Switch
        android:id="@+id/sc_system"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_102"
        android:thumb="@drawable/shape_circle_switch_thumb"
        android:track="@drawable/selector_switch_track"
        android:switchMinWidth="@dimen/dp_64"
        android:layout_marginStart="@dimen/dp_48"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="@color/text_setting_item"
        android:id="@+id/tv_system"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_98"
        android:maxWidth="@dimen/dp_400"
        android:text="@string/system_recovery"
        android:layout_marginStart="@dimen/dp_128"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/text_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4"
        android:maxWidth="@dimen/dp_400"
        android:text="@string/system_recovery_suffix"
        android:layout_marginStart="@dimen/dp_128"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_system"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_start"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_187"
        android:layout_marginStart="@dimen/dp_128"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/text_setting_item"
            android:id="@+id/tv_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/start_app_now"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/text_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4"
        android:maxWidth="@dimen/dp_400"
        android:text="@string/start_app_now_tip"
        app:layout_constraintStart_toStartOf="@+id/tv_system"
        app:layout_constraintTop_toBottomOf="@+id/ll_start"/>
    <Switch
        android:id="@+id/sc_start_app"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_44"
        android:thumb="@drawable/shape_circle_switch_thumb"
        android:track="@drawable/selector_switch_track"
        android:switchMinWidth="@dimen/dp_64"
        app:layout_constraintEnd_toEndOf="@+id/sc_system"
        app:layout_constraintTop_toBottomOf="@+id/sc_system"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/high_light"
        android:gravity="center"
        android:id="@+id/tv_about"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_31"
        android:maxWidth="@dimen/dp_400"
        android:text="@string/about"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
