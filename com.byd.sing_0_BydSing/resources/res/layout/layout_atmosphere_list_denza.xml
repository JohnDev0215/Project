<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/dp_72">
    <ImageView
        android:id="@+id/iv_1"
        android:layout_width="@dimen/dp_72"
        android:layout_height="@dimen/dp_72"
        android:src="@drawable/selector_bg_cheer_denza"/>
    <ImageView
        android:id="@+id/iv_2"
        android:layout_width="@dimen/dp_72"
        android:layout_height="@dimen/dp_72"
        android:src="@drawable/selector_bg_flower_denza"
        android:layout_marginStart="@dimen/dp_24"/>
    <ImageView
        android:id="@+id/iv_3"
        android:layout_width="@dimen/dp_72"
        android:layout_height="@dimen/dp_72"
        android:src="@drawable/selector_bg_applause_denza"
        android:layout_marginStart="@dimen/dp_24"/>
    <ImageView
        android:id="@+id/iv_4"
        android:layout_width="@dimen/dp_72"
        android:layout_height="@dimen/dp_72"
        android:src="@drawable/selector_bg_kiss_denza"
        android:layout_marginStart="@dimen/dp_24"/>
</LinearLayout>
