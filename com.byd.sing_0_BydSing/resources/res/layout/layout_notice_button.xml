<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_frame"
    android:layout_width="@dimen/dp_564"
    android:layout_height="match_parent">
    <include layout="@layout/layout_header"/>
    <com.byd.sing.view.CustomScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_320"
        android:layout_marginTop="@dimen/dp_113"
        android:fadeScrollbars="false"
        android:layout_marginStart="@dimen/dp_48"
        android:layout_marginEnd="@dimen/dp_48"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/text_main"
            android:id="@+id/tv_notice"
            android:layout_width="@dimen/dp_464"
            android:layout_height="wrap_content"
            android:text="@string/notice"
            android:paddingEnd="@dimen/dp_10"/>
    </com.byd.sing.view.CustomScrollView>
    <Button
        android:enabled="false"
        android:textSize="@dimen/sp_18"
        android:textColor="@color/color_button_text"
        android:id="@+id/btn_agree"
        android:background="@drawable/bg_button"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_48"
        android:layout_marginBottom="@dimen/dp_28"
        android:minWidth="@dimen/dp_176"
        android:text="@string/btn_read_agree"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
