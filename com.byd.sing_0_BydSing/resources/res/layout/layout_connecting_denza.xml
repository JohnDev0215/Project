<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_frame_denza"
    android:layout_width="@dimen/dp_564"
    android:layout_height="match_parent">
    <include layout="@layout/layout_header_denza"/>
    <ImageView
        android:id="@+id/iv_ktv"
        android:layout_width="@dimen/dp_490"
        android:layout_height="@dimen/dp_235"
        android:layout_marginTop="@dimen/dp_126"
        android:src="@drawable/img_ktv_usb_plugin_denza"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="@color/text_connecting_tip_denza"
        android:gravity="center"
        android:id="@+id/tv_plugin_usb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_410"
        android:text="@string/plugin_usb"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
