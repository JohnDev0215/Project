<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/dp_40">
    <com.byd.sing.view.LineTextView
        android:id="@+id/tv_name_zh"
        android:layout_width="@dimen/dp_106"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:text_color="@color/text_setting_item_denza"
        app:text_size="@dimen/sp_20"/>
    <TextView
        android:textColor="@color/text_setting_item_denza"
        android:id="@+id/tv_name"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="@dimen/dp_160"
        android:minWidth="@dimen/dp_106"
        android:layout_centerVertical="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:text_size="@dimen/sp_14"/>
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="@color/text_setting_item_denza"
        android:gravity="end"
        android:id="@+id/tv_value"
        android:layout_width="@dimen/dp_45"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/dp_137"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <SeekBar
        android:id="@+id/sb_value"
        android:layout_width="@dimen/dp_304"
        android:layout_height="@dimen/dp_40"
        android:progressDrawable="@drawable/seekbar_track_denza"
        android:thumb="@drawable/seekbar_thumb_denza"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@+id/tv_value"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_value"
        app:layout_constraintTop_toTopOf="parent"/>
</RelativeLayout>
